From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <simone.primarosa@gmail.com>
Date: Sat, 7 Nov 2026 12:00:00 +01:00
Subject: [PATCH] fix: guard terminated reason nil dereference in check pods status

The interLink virtual kubelet crashes with a nil pointer dereference while holding the pods lock, crash-looping the virtual node and dropping managed workloads whenever a pod containing un-offloaded containers reports a container failure. In checkPodsStatus, interLink rewrites State.Terminated.Reason across every in-cluster container status when any remotely reported container terminates with an error; containers not offloaded to the remote provider remain in Waiting or Running states without an initialized Terminated struct, causing a nil pointer dereference when applying the failed reason.

Add a nil check on State.Terminated before modifying container termination reasons, updating only statuses that have actually transitioned to terminated. Un-offloaded waiting and running containers retain their active states without panic, and the provider's lock is safely released.

Upstream status: pending PR.
---
diff --git a/pkg/virtualkubelet/execute.go b/pkg/virtualkubelet/execute.go
index de49f90..b3590df 100644
--- a/pkg/virtualkubelet/execute.go
+++ b/pkg/virtualkubelet/execute.go
@@ -1593,8 +1593,11 @@ func checkPodsStatus(ctx context.Context, p *Provider, pod *v1.Pod, token string
 					} else {
 						podRefInCluster.Status.Reason = failedReasonInit
 					}
-					// override all the ContainerStatuses to set Reason to failedReason or failedReasonInit
+					// override the terminated ContainerStatuses to set Reason to failedReason or failedReasonInit
 					for i := range podRefInCluster.Status.ContainerStatuses {
+						if podRefInCluster.Status.ContainerStatuses[i].State.Terminated == nil {
+							continue
+						}
 						if podErrored {
 							podRefInCluster.Status.ContainerStatuses[i].State.Terminated.Reason = failedReason
 						} else {
diff --git a/pkg/virtualkubelet/execute_terminated_reason_test.go b/pkg/virtualkubelet/execute_terminated_reason_test.go
new file mode 100644
index 0000000..b17f0b8
--- /dev/null
+++ b/pkg/virtualkubelet/execute_terminated_reason_test.go
@@ -0,0 +1,80 @@
+package virtualkubelet
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	types "github.com/interlink-hq/interlink/pkg/interlink"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	k8sTypes "k8s.io/apimachinery/pkg/types"
+)
+
+func waitingStatus(name string) v1.ContainerStatus {
+	return v1.ContainerStatus{
+		Name:  name,
+		State: v1.ContainerState{Waiting: &v1.ContainerStateWaiting{Reason: "ContainerCreating"}},
+	}
+}
+
+func terminatedStatus(name string, exitCode int32) v1.ContainerStatus {
+	return v1.ContainerStatus{
+		Name:  name,
+		State: v1.ContainerState{Terminated: &v1.ContainerStateTerminated{ExitCode: exitCode}},
+	}
+}
+
+func statusTestPod(containers ...string) *v1.Pod {
+	pod := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "status-pod", Namespace: testNamespace, UID: k8sTypes.UID("status-uid")},
+	}
+	for _, name := range containers {
+		pod.Spec.Containers = append(pod.Spec.Containers, v1.Container{Name: name, Image: "busybox"})
+	}
+	return pod
+}
+
+// TestCheckPodsStatusFailedPodWithNonTerminatedContainer reproduces a nil
+// dereference: when the pod fails, checkPodsStatus rewrote the Terminated
+// reason of every container status, including statuses that were never
+// terminated because the plugin did not report them.
+func TestCheckPodsStatusFailedPodWithNonTerminatedContainer(t *testing.T) {
+	ctx := context.Background()
+
+	pod := statusTestPod("main", "local-sidecar")
+	pod.Status.ContainerStatuses = []v1.ContainerStatus{waitingStatus("main"), waitingStatus("local-sidecar")}
+
+	remote := []types.PodStatus{{
+		PodName:      pod.Name,
+		PodNamespace: pod.Namespace,
+		PodUID:       string(pod.UID),
+		Containers:   []v1.ContainerStatus{terminatedStatus("main", 1)},
+	}}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		require.NoError(t, json.NewEncoder(w).Encode(remote))
+	}))
+	defer server.Close()
+	serverURL, err := url.Parse(server.URL)
+	require.NoError(t, err)
+
+	p := &Provider{pods: map[string]*v1.Pod{string(pod.UID): pod}}
+	config := Config{InterlinkURL: "http://" + serverURL.Hostname(), InterlinkPort: serverURL.Port()}
+
+	require.NotPanics(t, func() {
+		_, err = checkPodsStatus(ctx, p, pod, "", config)
+	})
+	require.NoError(t, err)
+
+	assert.Equal(t, v1.PodFailed, pod.Status.Phase)
+	assert.Equal(t, "Error: 1", pod.Status.Reason)
+	require.NotNil(t, pod.Status.ContainerStatuses[0].State.Terminated)
+	assert.Equal(t, "Error: 1", pod.Status.ContainerStatuses[0].State.Terminated.Reason)
+	assert.Nil(t, pod.Status.ContainerStatuses[1].State.Terminated)
+	assert.NotNil(t, pod.Status.ContainerStatuses[1].State.Waiting)
+}
