+// trackedContainerStatus returns the entry of statuses that records remote, so
+// callers update the status of the container the remote status names. A name
+// that belongs to specs but has no entry yet is appended; a name outside specs
+// gets a detached copy, so updates to it never reach the pod status.
+func trackedContainerStatus(statuses *[]v1.ContainerStatus, specs []v1.Container, remote v1.ContainerStatus) *v1.ContainerStatus {
+	for i := range *statuses {
+		if (*statuses)[i].Name == remote.Name {
+			(*statuses)[i] = remote
+			return &(*statuses)[i]
+		}
+	}
+	for _, spec := range specs {
+		if spec.Name == remote.Name {
+			*statuses = append(*statuses, remote)
+			return &(*statuses)[len(*statuses)-1]
+		}
+	}
+	return &remote
+}
