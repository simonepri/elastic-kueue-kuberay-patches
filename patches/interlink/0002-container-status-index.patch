index 0000000..9d569ec
--- /dev/null
+++ b/pkg/virtualkubelet/execute_container_status_test.go
@@ -0,0 +1,96 @@
+package virtualkubelet
+
+import (
+	"context"
+	"testing"
+
+	types "github.com/interlink-hq/interlink/pkg/interlink"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func runningStatus(name string) v1.ContainerStatus {
+	return v1.ContainerStatus{
+		Name:  name,
+		State: v1.ContainerState{Running: &v1.ContainerStateRunning{StartedAt: metav1.Now()}},
+	}
+}
+
+// TestHandleContainersUpdateUnknownContainer covers remote statuses whose name
+// matches no in-cluster status: the update must never land on another
+// container's entry, and names outside the pod spec must not be added.
+func TestHandleContainersUpdateUnknownContainer(t *testing.T) {
+	ctx := context.Background()
+
+	t.Run("running status for a name outside the spec leaves other containers untouched", func(t *testing.T) {
+		pod := statusTestPod("main")
+		pod.Status.ContainerStatuses = []v1.ContainerStatus{waitingStatus("main")}
+		remote := types.PodStatus{PodName: pod.Name, Containers: []v1.ContainerStatus{runningStatus("plugin-helper")}}
+
+		_, _, _, podRunning := handleContainersUpdate(ctx, remote, pod, false, false, 0, 0)
+
+		assert.True(t, podRunning)
+		require.Len(t, pod.Status.ContainerStatuses, 1)
+		assert.Equal(t, "main", pod.Status.ContainerStatuses[0].Name)
+		assert.False(t, pod.Status.ContainerStatuses[0].Ready)
+		assert.Nil(t, pod.Status.ContainerStatuses[0].State.Running)
+		assert.NotNil(t, pod.Status.ContainerStatuses[0].State.Waiting)
+	})
+
+	t.Run("terminated status for a name outside the spec does not panic", func(t *testing.T) {
+		pod := statusTestPod("main")
+		pod.Status.ContainerStatuses = []v1.ContainerStatus{waitingStatus("main")}
+		remote := types.PodStatus{PodName: pod.Name, Containers: []v1.ContainerStatus{terminatedStatus("plugin-helper", 2)}}
+
+		var terminated int
+		var podErrored bool
+		require.NotPanics(t, func() {
+			terminated, podErrored, _, _ = handleContainersUpdate(ctx, remote, pod, false, false, 0, 0)
+		})
+
+		assert.Equal(t, 1, terminated)
+		assert.True(t, podErrored)
+		require.Len(t, pod.Status.ContainerStatuses, 1)
+		assert.NotNil(t, pod.Status.ContainerStatuses[0].State.Waiting)
+		assert.Nil(t, pod.Status.ContainerStatuses[0].State.Terminated)
+	})
+
+	t.Run("spec container without a status entry is appended and updated in place", func(t *testing.T) {
+		pod := statusTestPod("main", "worker")
+		pod.Status.ContainerStatuses = []v1.ContainerStatus{waitingStatus("main")}
+		remote := types.PodStatus{PodName: pod.Name, Containers: []v1.ContainerStatus{runningStatus("worker")}}
+
+		handleContainersUpdate(ctx, remote, pod, false, false, 0, 0)
+
+		require.Len(t, pod.Status.ContainerStatuses, 2)
+		assert.False(t, pod.Status.ContainerStatuses[0].Ready)
+		assert.NotNil(t, pod.Status.ContainerStatuses[0].State.Waiting)
+		assert.Equal(t, "worker", pod.Status.ContainerStatuses[1].Name)
+		assert.True(t, pod.Status.ContainerStatuses[1].Ready)
+		assert.NotNil(t, pod.Status.ContainerStatuses[1].State.Running)
+	})
+}
+
+// TestHandleInitContainersUpdateUnknownContainer applies the same invariant to
+// init container statuses.
+func TestHandleInitContainersUpdateUnknownContainer(t *testing.T) {
+	ctx := context.Background()
+
+	pod := statusTestPod("main")
+	pod.Spec.InitContainers = []v1.Container{{Name: "init", Image: "busybox"}}
+	pod.Status.InitContainerStatuses = []v1.ContainerStatus{waitingStatus("init")}
+	remote := types.PodStatus{PodName: pod.Name, InitContainers: []v1.ContainerStatus{terminatedStatus("plugin-init", 3)}}
+
+	var podErrored bool
+	require.NotPanics(t, func() {
+		_, _, podErrored, _, _ = handleInitContainersUpdate(ctx, remote, pod, 1)
+	})
+
+	assert.True(t, podErrored)
+	require.Len(t, pod.Status.InitContainerStatuses, 1)
+	assert.Equal(t, "init", pod.Status.InitContainerStatuses[0].Name)
+	assert.NotNil(t, pod.Status.InitContainerStatuses[0].State.Waiting)
+	assert.Nil(t, pod.Status.InitContainerStatuses[0].State.Terminated)
+}
