From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <simone.primarosa@gmail.com>
Date: Sat, 7 Nov 2026 12:00:00 +01:00
Subject: [PATCH] feat: forward image pull secrets to plugin in create request

Offloaded pods fail to pull container images from private container registries on remote compute nodes because registry authentication credentials are not forwarded to the interLink execution plugin. Upstream interLink includes only volume-mounted Secrets in PodCreateRequests, omitting the registry credentials defined in spec.imagePullSecrets; without these credentials, plugins running on remote providers cannot authenticate with private image registries unless they duplicate Kubernetes API access out-of-band.

Extract all referenced dockerconfigjson and dockercfg Secrets declared in spec.imagePullSecrets and forward them in PodCreateRequests.Secrets. Mirror upstream kubelet behavior by deduplicating secrets by name and gracefully logging warnings without failing pod creation if a secret is absent, unreadable, or of an unsupported type.

Upstream status: pending PR.
---
diff --git a/pkg/virtualkubelet/execute.go b/pkg/virtualkubelet/execute.go
index 2d1a53a..d7c69ae 100644
--- a/pkg/virtualkubelet/execute.go
+++ b/pkg/virtualkubelet/execute.go
@@ -14,6 +14,7 @@ import (
 	"net/url"
 	"os"
 	"regexp"
+	"slices"
 	"sort"
 	"strconv"
 	"strings"
@@ -1045,6 +1046,28 @@ func remoteExecutionHandleVolumes(ctx context.Context, p *Provider, pod *v1.Pod,
 	return nil
 }
 
+// remoteExecutionHandleImagePullSecrets adds the registry credential Secrets named in the pod's
+// imagePullSecrets to the request, as the kubelet supplies them to its image puller. Like the kubelet,
+// it skips a Secret it cannot read or that holds no registry credentials with a warning, so the pull
+// proceeds without it.
+func remoteExecutionHandleImagePullSecrets(ctx context.Context, p *Provider, pod *v1.Pod, req *types.PodCreateRequests) {
+	for _, ref := range pod.Spec.ImagePullSecrets {
+		if ref.Name == "" || slices.ContainsFunc(req.Secrets, func(s v1.Secret) bool { return s.Name == ref.Name }) {
+			continue
+		}
+		scrt, err := p.clientSet.CoreV1().Secrets(pod.Namespace).Get(ctx, ref.Name, metav1.GetOptions{})
+		if err != nil {
+			log.G(ctx).Warningf("unable to retrieve pull secret %s/%s for pod %s, the image pull may not succeed: %v", pod.Namespace, ref.Name, pod.Name, err)
+			continue
+		}
+		if scrt.Type != v1.SecretTypeDockerConfigJson && scrt.Type != v1.SecretTypeDockercfg {
+			log.G(ctx).Warningf("ignoring pull secret %s/%s for pod %s: type %s holds no registry credentials", pod.Namespace, ref.Name, pod.Name, scrt.Type)
+			continue
+		}
+		req.Secrets = append(req.Secrets, *scrt)
+	}
+}
+
 func resolveEnvRefs(
 	ctx context.Context,
 	p *Provider,
@@ -1280,6 +1303,8 @@ func RemoteExecution(ctx context.Context, config Config, p *Provider, pod *v1.Po
 			return err
 		}
 
+		remoteExecutionHandleImagePullSecrets(ctx, p, podToOffload, &req)
+
 		addKubernetesServicesEnvVars(ctx, config, podToOffload)
 
 		for i := range podToOffload.Spec.InitContainers {
diff --git a/pkg/virtualkubelet/execute_image_pull_secrets_test.go b/pkg/virtualkubelet/execute_image_pull_secrets_test.go
new file mode 100644
index 0000000..6bc1e11
--- /dev/null
+++ b/pkg/virtualkubelet/execute_image_pull_secrets_test.go
@@ -0,0 +1,55 @@
+package virtualkubelet
+
+import (
+	"context"
+	"testing"
+
+	types "github.com/interlink-hq/interlink/pkg/interlink"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes/fake"
+)
+
+func pullSecret(name string, secretType v1.SecretType) *v1.Secret {
+	return &v1.Secret{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "ns"},
+		Type:       secretType,
+		Data:       map[string][]byte{v1.DockerConfigJsonKey: []byte(`{"auths":{}}`)},
+	}
+}
+
+func TestRemoteExecutionHandleImagePullSecrets(t *testing.T) {
+	client := fake.NewSimpleClientset(
+		pullSecret("regcred", v1.SecretTypeDockerConfigJson),
+		pullSecret("legacy", v1.SecretTypeDockercfg),
+		pullSecret("opaque", v1.SecretTypeOpaque),
+		pullSecret("mounted", v1.SecretTypeDockerConfigJson),
+	)
+	p := &Provider{clientSet: client}
+	pod := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "pod", Namespace: "ns"},
+		Spec: v1.PodSpec{ImagePullSecrets: []v1.LocalObjectReference{
+			{Name: "regcred"}, {Name: "missing"}, {Name: "opaque"}, {Name: "legacy"}, {Name: "mounted"}, {Name: ""},
+		}},
+	}
+	req := &types.PodCreateRequests{Secrets: []v1.Secret{*pullSecret("mounted", v1.SecretTypeDockerConfigJson)}}
+
+	remoteExecutionHandleImagePullSecrets(context.Background(), p, pod, req)
+
+	var names []string
+	for _, s := range req.Secrets {
+		names = append(names, s.Name)
+	}
+	want := []string{"mounted", "regcred", "legacy"}
+	if len(names) != len(want) {
+		t.Fatalf("request secrets = %v, want %v", names, want)
+	}
+	for i := range want {
+		if names[i] != want[i] {
+			t.Fatalf("request secrets = %v, want %v", names, want)
+		}
+	}
+	if got := string(req.Secrets[1].Data[v1.DockerConfigJsonKey]); got != `{"auths":{}}` {
+		t.Fatalf("regcred data = %q, want the secret's dockerconfigjson", got)
+	}
+}
