From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <simone.primarosa@gmail.com>
Date: Sat, 7 Nov 2026 12:00:00 +01:00
Subject: [PATCH] feat: resolve downward api env fieldrefs for node topology labels

Offloaded containers fail to retrieve Kubernetes node topology and placement labels, causing applications that rely on Downward API environment variables for rack, zone, or region awareness to receive empty strings. Upstream interLink resolves environment variable field references with an ad-hoc parser that only recognizes a small hard-coded set of paths, dropping subscripted metadata.labels and metadata.annotations as well as standard spec and status IP field paths.

Align with upstream commit #594 by using downwardAPISubscriptRE to resolve subscripted label and annotation references, and mapping status.podIPs and status.hostIPs alongside podIP and hostIP. Unsupported field paths are logged and preserved unresolved rather than replaced with empty strings, matching standard kubelet behavior.
---
diff --git a/pkg/virtualkubelet/execute.go b/pkg/virtualkubelet/execute.go
index d7c69ae..d34e1e1 100644
--- a/pkg/virtualkubelet/execute.go
+++ b/pkg/virtualkubelet/execute.go
@@ -860,7 +860,19 @@ func formatDownwardAPIMetadataMap(data map[string]string) string {
 	return b.String()
 }
 
+// downwardAPISubscriptRE matches the metadata.labels['<KEY>'] and
+// metadata.annotations['<KEY>'] field paths, which select a single label or annotation.
+var downwardAPISubscriptRE = regexp.MustCompile(`^metadata\.(labels|annotations)\[['"]?(.+?)['"]?\]$`)
+
 func resolveDownwardAPIFieldPath(pod *v1.Pod, fieldPath string) (string, bool) {
+	if matches := downwardAPISubscriptRE.FindStringSubmatch(fieldPath); matches != nil {
+		// Like the kubelet, a missing label or annotation resolves to an empty value.
+		if matches[1] == "labels" {
+			return pod.Labels[matches[2]], true
+		}
+		return pod.Annotations[matches[2]], true
+	}
+
 	switch fieldPath {
 	case "metadata.name":
 		return pod.Name, true
@@ -876,9 +888,11 @@ func resolveDownwardAPIFieldPath(pod *v1.Pod, fieldPath string) (string, bool) {
 		return pod.Spec.NodeName, true
 	case "spec.serviceAccountName":
 		return pod.Spec.ServiceAccountName, true
-	case "status.podIP":
+	// The virtual kubelet reports a single pod and host IP (see PodPhase), so the
+	// IP lists hold just that one.
+	case "status.podIP", "status.podIPs":
 		return pod.Status.PodIP, true
-	case "status.hostIP":
+	case "status.hostIP", "status.hostIPs":
 		return pod.Status.HostIP, true
 	default:
 		return "", false
@@ -1074,41 +1088,20 @@ func resolveEnvRefs(
 	pod *v1.Pod,
 	container *v1.Container,
 ) {
-	var annotationFieldRefRE = regexp.MustCompile(`^metadata\.annotations\[['"]?(.+?)['"]?\]$`)
-
 	for i, env := range container.Env {
 		if env.ValueFrom == nil {
 			continue
 		}
 
 		if fr := env.ValueFrom.FieldRef; fr != nil {
-
-			var resolved string
-			switch fr.FieldPath {
-			case "status.podIP":
-				resolved = pod.Status.PodIP
-			case "metadata.name":
-				resolved = pod.Name
-			case "metadata.namespace":
-				resolved = pod.Namespace
-			case "metadata.uid":
-				resolved = string(pod.UID)
-
-			default:
-				if matches := annotationFieldRefRE.FindStringSubmatch(fr.FieldPath); len(matches) == 2 {
-					annKey := matches[1]
-					val, ok := pod.Annotations[annKey]
-					if !ok {
-						continue
-					}
-					resolved = val
-				}
+			resolved, ok := resolveDownwardAPIFieldPath(pod, fr.FieldPath)
+			if !ok {
+				log.G(ctx).Warningf("in pod %s unsupported FieldPath %s for env var %q in InterLink, skipping", pod.Name, fr.FieldPath, env.Name)
+				continue
 			}
-
 			container.Env[i].Value = resolved
 			container.Env[i].ValueFrom = nil
 			continue
-
 		}
 
 		if sk := env.ValueFrom.SecretKeyRef; sk != nil {
diff --git a/pkg/virtualkubelet/execute_env_fieldref_test.go b/pkg/virtualkubelet/execute_env_fieldref_test.go
new file mode 100644
index 0000000..31e7032
--- /dev/null
+++ b/pkg/virtualkubelet/execute_env_fieldref_test.go
@@ -0,0 +1,77 @@
+package virtualkubelet
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func fieldRefEnv(name, path string) v1.EnvVar {
+	return v1.EnvVar{Name: name, ValueFrom: &v1.EnvVarSource{FieldRef: &v1.ObjectFieldSelector{FieldPath: path}}}
+}
+
+func TestResolveEnvRefs_FieldRefs(t *testing.T) {
+	pod := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:        "worker",
+			Namespace:   "team",
+			UID:         "uid-1",
+			Labels:      map[string]string{"topology.kubernetes.io/region": "eu-west-1"},
+			Annotations: map[string]string{"example.com/owner": "data"},
+		},
+		Spec: v1.PodSpec{
+			NodeName:           "virtual-node-a",
+			ServiceAccountName: "runner",
+		},
+		Status: v1.PodStatus{
+			PodIP:  "10.0.0.5",
+			HostIP: "10.0.0.1",
+		},
+	}
+	container := &v1.Container{Env: []v1.EnvVar{
+		fieldRefEnv("POD_NAME", "metadata.name"),
+		fieldRefEnv("POD_NAMESPACE", "metadata.namespace"),
+		fieldRefEnv("POD_UID", "metadata.uid"),
+		fieldRefEnv("REGION", "metadata.labels['topology.kubernetes.io/region']"),
+		fieldRefEnv("ZONE", "metadata.labels['topology.kubernetes.io/zone']"),
+		fieldRefEnv("OWNER", "metadata.annotations['example.com/owner']"),
+		fieldRefEnv("MISSING_ANN", "metadata.annotations['absent']"),
+		fieldRefEnv("NODE", "spec.nodeName"),
+		fieldRefEnv("SA", "spec.serviceAccountName"),
+		fieldRefEnv("HOST_IP", "status.hostIP"),
+		fieldRefEnv("HOST_IPS", "status.hostIPs"),
+		fieldRefEnv("POD_IP", "status.podIP"),
+		fieldRefEnv("POD_IPS", "status.podIPs"),
+		fieldRefEnv("UNSUPPORTED", "spec.unsupported"),
+	}}
+
+	resolveEnvRefs(context.Background(), nil, pod, container)
+
+	want := map[string]string{
+		"POD_NAME":      "worker",
+		"POD_NAMESPACE": "team",
+		"POD_UID":       "uid-1",
+		"REGION":        "eu-west-1",
+		"ZONE":          "", // missing label resolves to empty string
+		"OWNER":         "data",
+		"MISSING_ANN":   "", // missing annotation resolves to empty string
+		"NODE":          "virtual-node-a",
+		"SA":            "runner",
+		"HOST_IP":       "10.0.0.1",
+		"HOST_IPS":      "10.0.0.1",
+		"POD_IP":        "10.0.0.5",
+		"POD_IPS":       "10.0.0.5",
+	}
+	for _, env := range container.Env {
+		if env.Name == "UNSUPPORTED" {
+			assert.NotNil(t, env.ValueFrom, "unsupported fieldRef must stay unresolved")
+			assert.Empty(t, env.Value)
+			continue
+		}
+		assert.Nil(t, env.ValueFrom, env.Name)
+		assert.Equal(t, want[env.Name], env.Value, env.Name)
+	}
+}
