+package virtualkubelet
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	types "github.com/interlink-hq/interlink/pkg/interlink"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	v1 "k8s.io/api/core/v1"
+)
+
+// TestCheckPodsStatusPodIP covers the pod IP the plugin reports: it replaces
+// the node's placeholder address when present and leaves it alone when absent.
+func TestCheckPodsStatusPodIP(t *testing.T) {
+	cases := []struct {
+		name       string
+		podIP      string
+		podIPs     []string
+		wantPodIP  string
+		wantHostIP string
+		wantPodIPs []string
+	}{
+		{"plugin reports an address", "203.0.113.7", []string{"203.0.113.7"}, "203.0.113.7", "203.0.113.7", []string{"203.0.113.7"}},
+		{"plugin reports only the list", "", []string{"203.0.113.8"}, "203.0.113.8", "203.0.113.8", []string{"203.0.113.8"}},
+		{"plugin reports no address", "", nil, "10.0.0.1", "10.0.0.1", []string{"10.0.0.1"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			pod := statusTestPod("main")
+			pod.Status.ContainerStatuses = []v1.ContainerStatus{waitingStatus("main")}
+			pod.Status.PodIP = "10.0.0.1"
+			pod.Status.HostIP = "10.0.0.1"
+			pod.Status.PodIPs = []v1.PodIP{{IP: "10.0.0.1"}}
+
+			remote := []types.PodStatus{{
+				PodName:      pod.Name,
+				PodNamespace: pod.Namespace,
+				PodUID:       string(pod.UID),
+				PodIP:        tc.podIP,
+				PodIPs:       tc.podIPs,
+				Containers:   []v1.ContainerStatus{runningStatus("main")},
+			}}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				require.NoError(t, json.NewEncoder(w).Encode(remote))
+			}))
+			defer server.Close()
+			serverURL, err := url.Parse(server.URL)
+			require.NoError(t, err)
+
+			p := &Provider{pods: map[string]*v1.Pod{string(pod.UID): pod}}
+			config := Config{InterlinkURL: "http://" + serverURL.Hostname(), InterlinkPort: serverURL.Port()}
+
+			_, err = checkPodsStatus(context.Background(), p, pod, "", config)
+			require.NoError(t, err)
+
+			assert.Equal(t, tc.wantPodIP, pod.Status.PodIP)
+			assert.Equal(t, tc.wantHostIP, pod.Status.HostIP)
+			var got []string
+			for _, ip := range pod.Status.PodIPs {
+				got = append(got, ip.IP)
+			}
+			assert.Equal(t, tc.wantPodIPs, got)
+		})
+	}
+}
