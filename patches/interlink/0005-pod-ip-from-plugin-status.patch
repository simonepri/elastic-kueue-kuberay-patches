Report the pod IP the plugin returns in its status response.

The plugin's /status response was decoded into types.PodStatus, which has no
IP fields, so the virtual kubelet set status.podIP and status.hostIP of every
pod from its own configured PodIP. Pods on remote VMs therefore reported the
node's placeholder address instead of their VM's address. PodStatus now
carries optional podIP and podIPs fields, and checkPodsStatus copies them to
the pod's podIP, podIPs, and hostIP when present; when the plugin omits them
(for example before the VM's address is known) the configured placeholder
stays.

Upstream status: not yet reported to interlink-hq/interLink.

diff --git a/pkg/interlink/types.go b/pkg/interlink/types.go
index 5356d7c..1748285 100644
--- a/pkg/interlink/types.go
+++ b/pkg/interlink/types.go
@@ -42,6 +42,10 @@ type PodStatus struct {
 	PodNamespace string `json:"namespace"`
 	// JobID is the remote system's job identifier (e.g., SLURM job ID, container ID)
 	JobID string `json:"JID"`
+	// PodIP is the IP address of the remote workload, when the plugin knows it
+	PodIP string `json:"podIP,omitempty"`
+	// PodIPs lists all IP addresses of the remote workload, when the plugin knows them
+	PodIPs []string `json:"podIPs,omitempty"`
 	// Containers holds the status of all regular containers in the pod
 	Containers []v1.ContainerStatus `json:"containers"`
 	// InitContainers holds the status of all init containers in the pod
diff --git a/pkg/virtualkubelet/execute.go b/pkg/virtualkubelet/execute.go
index 61d17b0..b24d49d 100644
--- a/pkg/virtualkubelet/execute.go
+++ b/pkg/virtualkubelet/execute.go
@@ -1573,6 +1573,25 @@ func checkPodsStatus(ctx context.Context, p *Provider, pod *v1.Pod, token string
 			// path) do not observe a partially-updated pod status.
 			p.podsMu.Lock()
 
+			// the plugin reports the address of the remote workload when it knows it;
+			// otherwise keep the node's configured placeholder address
+			if podRemoteStatus.PodIP != "" {
+				podRefInCluster.Status.PodIP = podRemoteStatus.PodIP
+				podRefInCluster.Status.HostIP = podRemoteStatus.PodIP
+				podRefInCluster.Status.PodIPs = []v1.PodIP{{IP: podRemoteStatus.PodIP}}
+			}
+			if len(podRemoteStatus.PodIPs) > 0 {
+				podIPs := make([]v1.PodIP, 0, len(podRemoteStatus.PodIPs))
+				for _, ip := range podRemoteStatus.PodIPs {
+					podIPs = append(podIPs, v1.PodIP{IP: ip})
+				}
+				podRefInCluster.Status.PodIPs = podIPs
+				if podRemoteStatus.PodIP == "" {
+					podRefInCluster.Status.PodIP = podRemoteStatus.PodIPs[0]
+					podRefInCluster.Status.HostIP = podRemoteStatus.PodIPs[0]
+				}
+			}
+
 			// if there are init containers, we need to check them first
 			if nInitContainersInPod > 0 {
 				podWaitingForInitContainers, podInit, podInitErrored, failedReasonInit, counterOfTerminatedInitContainers = handleInitContainersUpdate(ctx, podRemoteStatus, podRefInCluster, nInitContainersInPod)
