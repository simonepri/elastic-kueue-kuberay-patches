diff --git a/ray-operator/controllers/ray/actor_protect_controller.go b/ray-operator/controllers/ray/actor_protect_controller.go
new file mode 100644
index 0000000..618fc57
--- /dev/null
+++ b/ray-operator/controllers/ray/actor_protect_controller.go
@@ -0,0 +1,85 @@
+package ray
+
+import (
+	"context"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/client-go/util/retry"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+const (
+	PodDeletionCostAnnotation = "controller.kubernetes.io/pod-deletion-cost"
+	ActorStateLabel           = "ray.io/actor-state"
+)
+
+type ActorProtectReconciler struct {
+	client.Client
+	Scheme *runtime.Scheme
+}
+
+func (r *ActorProtectReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	pod := &corev1.Pod{}
+	if err := r.Get(ctx, req.NamespacedName, pod); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	state := pod.GetLabels()[ActorStateLabel]
+	if state == "" {
+		return ctrl.Result{}, nil
+	}
+
+	expectedCost := ""
+	switch state {
+	case "busy":
+		expectedCost = "1000"
+	case "idle":
+		expectedCost = "-1000"
+	default:
+		return ctrl.Result{}, nil
+	}
+
+	currentCost := ""
+	if pod.GetAnnotations() != nil {
+		currentCost = pod.GetAnnotations()[PodDeletionCostAnnotation]
+	}
+
+	if currentCost != expectedCost {
+		logger.Info("updating pod deletion cost based on actor state",
+			"pod", pod.GetName(), "state", state, "cost", expectedCost)
+		err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+			latest := &corev1.Pod{}
+			if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+				return err
+			}
+			ann := latest.GetAnnotations()
+			if ann == nil {
+				ann = make(map[string]string)
+			}
+			ann[PodDeletionCostAnnotation] = expectedCost
+			latest.SetAnnotations(ann)
+			return r.Update(ctx, latest)
+		})
+		if err != nil {
+			return ctrl.Result{}, err
+		}
+	}
+
+	return ctrl.Result{}, nil
+}
+
+func (r *ActorProtectReconciler) SetupWithManager(mgr ctrl.Manager) error {
+	return ctrl.NewControllerManagedBy(mgr).
+		Named("actorprotect").
+		For(&corev1.Pod{}).
+		Complete(r)
+}
diff --git a/ray-operator/controllers/ray/scalegate_controller.go b/ray-operator/controllers/ray/scalegate_controller.go
new file mode 100644
index 0000000..1128025
--- /dev/null
+++ b/ray-operator/controllers/ray/scalegate_controller.go
@@ -0,0 +1,292 @@
+package ray
+
+import (
+	"context"
+	"fmt"
+	"math"
+
+	"k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/client-go/util/retry"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+var (
+	clusterQueueGVK = schema.GroupVersionKind{
+		Group:   "kueue.x-k8s.io",
+		Version: "v1beta1",
+		Kind:    "ClusterQueue",
+	}
+	localQueueGVK = schema.GroupVersionKind{
+		Group:   "kueue.x-k8s.io",
+		Version: "v1beta1",
+		Kind:    "LocalQueue",
+	}
+)
+
+type ScaleGateReconciler struct {
+	client.Client
+	Scheme *runtime.Scheme
+}
+
+func (r *ScaleGateReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	rc := &unstructured.Unstructured{}
+	rc.SetGroupVersionKind(rayClusterGVK)
+	if err := r.Get(ctx, req.NamespacedName, rc); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	queueName := rc.GetLabels()["kueue.x-k8s.io/queue-name"]
+	if queueName == "" {
+		return ctrl.Result{}, nil
+	}
+
+	workerGroups, found, err := unstructured.NestedSlice(rc.Object, "spec", "workerGroupSpecs")
+	if !found || err != nil || len(workerGroups) == 0 {
+		return ctrl.Result{}, nil
+	}
+
+	clamped := false
+	for i, wg := range workerGroups {
+		wgMap, ok := wg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		workerUnit := r.extractWorkerUnitResources(wgMap)
+		maxAllowedQuota, err := r.resolveAvailableQuota(ctx, rc.GetNamespace(), queueName, workerUnit)
+		if err != nil {
+			logger.V(2).Info("could not resolve available quota for queue", "queue", queueName, "error", err)
+			continue
+		}
+
+		targetLimit := int64(maxAllowedQuota)
+		replicas, _ := wgMap["replicas"].(int64)
+		maxReplicas, _ := wgMap["maxReplicas"].(int64)
+
+		if maxReplicas > targetLimit {
+			logger.Info("clamping RayCluster maxReplicas to Kueue quota",
+				"cluster", rc.GetName(), "requestedMax", maxReplicas, "clamped", targetLimit)
+			wgMap["maxReplicas"] = targetLimit
+			clamped = true
+		}
+		if replicas > targetLimit {
+			logger.Info("clamping RayCluster replicas to Kueue quota",
+				"cluster", rc.GetName(), "requestedReplicas", replicas, "clamped", targetLimit)
+			wgMap["replicas"] = targetLimit
+			clamped = true
+		}
+		workerGroups[i] = wgMap
+	}
+
+	if clamped {
+		err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+			latest := &unstructured.Unstructured{}
+			latest.SetGroupVersionKind(rayClusterGVK)
+			if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+				return err
+			}
+			wgs, _, _ := unstructured.NestedSlice(latest.Object, "spec", "workerGroupSpecs")
+			for i, wg := range wgs {
+				wgMap, ok := wg.(map[string]interface{})
+				if !ok {
+					continue
+				}
+				workerUnit := r.extractWorkerUnitResources(wgMap)
+				maxAllowedQuota, qErr := r.resolveAvailableQuota(ctx, rc.GetNamespace(), queueName, workerUnit)
+				if qErr != nil {
+					continue
+				}
+				targetLimit := int64(maxAllowedQuota)
+				replicas, _ := wgMap["replicas"].(int64)
+				maxReplicas, _ := wgMap["maxReplicas"].(int64)
+				if maxReplicas > targetLimit {
+					wgMap["maxReplicas"] = targetLimit
+				}
+				if replicas > targetLimit {
+					wgMap["replicas"] = targetLimit
+				}
+				wgs[i] = wgMap
+			}
+			_ = unstructured.SetNestedSlice(latest.Object, wgs, "spec", "workerGroupSpecs")
+			return r.Update(ctx, latest)
+		})
+		if err != nil {
+			return ctrl.Result{}, err
+		}
+
+		_ = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+			latest := &unstructured.Unstructured{}
+			latest.SetGroupVersionKind(rayClusterGVK)
+			if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+				return err
+			}
+			conditions, _, _ := unstructured.NestedSlice(latest.Object, "status", "conditions")
+			filteredConditions := []interface{}{}
+			for _, cond := range conditions {
+				if cMap, ok := cond.(map[string]interface{}); ok {
+					if cMap["type"] != "ScaleGateClamped" {
+						filteredConditions = append(filteredConditions, cond)
+					}
+				}
+			}
+			filteredConditions = append(filteredConditions, map[string]interface{}{
+				"type":               "ScaleGateClamped",
+				"status":             "True",
+				"reason":             "KueueQuotaCapped",
+				"message":            "Worker replicas and maxReplicas clamped to available Kueue ClusterQueue quota",
+				"lastTransitionTime": metav1.Now().UTC().Format("2006-01-02T15:04:05Z"),
+			})
+			_ = unstructured.SetNestedSlice(latest.Object, filteredConditions, "status", "conditions")
+			return r.Status().Update(ctx, latest)
+		})
+	}
+
+	return ctrl.Result{}, nil
+}
+
+func (r *ScaleGateReconciler) extractWorkerUnitResources(wgMap map[string]interface{}) map[string]int64 {
+	unit := make(map[string]int64)
+	containers, _, _ := unstructured.NestedSlice(wgMap, "template", "spec", "containers")
+	for _, c := range containers {
+		cMap, ok := c.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		reqs, _, _ := unstructured.NestedMap(cMap, "resources", "requests")
+		if reqs == nil {
+			continue
+		}
+		for resName, val := range reqs {
+			var amount int64
+			if s, ok := val.(string); ok {
+				q, err := resource.ParseQuantity(s)
+				if err == nil {
+					if resName == "cpu" {
+						amount = q.MilliValue()
+					} else {
+						amount = q.Value()
+					}
+				}
+			} else if num, ok := val.(int64); ok {
+				amount = num
+			}
+			if amount > 0 {
+				unit[resName] += amount
+			}
+		}
+	}
+	return unit
+}
+
+func (r *ScaleGateReconciler) parseResourceValue(resName string, raw interface{}) int64 {
+	if raw == nil {
+		return 0
+	}
+	s := fmt.Sprint(raw)
+	q, err := resource.ParseQuantity(s)
+	if err == nil {
+		if resName == "cpu" {
+			return q.MilliValue()
+		}
+		return q.Value()
+	}
+	var num int64
+	_, _ = fmt.Sscanf(s, "%d", &num)
+	return num
+}
+
+func (r *ScaleGateReconciler) resolveAvailableQuota(ctx context.Context, namespace, queueName string, workerUnit map[string]int64) (int, error) {
+	cq := &unstructured.Unstructured{}
+	cq.SetGroupVersionKind(clusterQueueGVK)
+	if err := r.Get(ctx, client.ObjectKey{Name: queueName}, cq); err != nil {
+		lq := &unstructured.Unstructured{}
+		lq.SetGroupVersionKind(localQueueGVK)
+		if errLq := r.Get(ctx, client.ObjectKey{Namespace: namespace, Name: queueName}, lq); errLq == nil {
+			targetCq, _, _ := unstructured.NestedString(lq.Object, "spec", "clusterQueue")
+			if targetCq != "" {
+				_ = r.Get(ctx, client.ObjectKey{Name: targetCq}, cq)
+			}
+		}
+	}
+
+	cohort, _, _ := unstructured.NestedString(cq.Object, "spec", "cohort")
+	rGroups, found, _ := unstructured.NestedSlice(cq.Object, "spec", "resourceGroups")
+	if !found {
+		return 4, nil
+	}
+
+	minAllowedReplicas := int64(math.MaxInt64)
+	matchedAnyResource := false
+
+	for _, rg := range rGroups {
+		rgMap, ok := rg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		flavors, _, _ := unstructured.NestedSlice(rgMap, "flavors")
+		for _, fl := range flavors {
+			flMap, ok := fl.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			resources, _, _ := unstructured.NestedSlice(flMap, "resources")
+			for _, res := range resources {
+				resMap, ok := res.(map[string]interface{})
+				if !ok {
+					continue
+				}
+				resName, _ := resMap["name"].(string)
+				nominalVal := r.parseResourceValue(resName, resMap["nominalQuota"])
+				totalLimit := nominalVal
+				if cohort != "" && resMap["borrowingLimit"] != nil {
+					borrowVal := r.parseResourceValue(resName, resMap["borrowingLimit"])
+					if borrowVal > 0 {
+						totalLimit += borrowVal
+					}
+				}
+
+				if totalLimit <= 0 {
+					continue
+				}
+
+				if reqVal, ok := workerUnit[resName]; ok && reqVal > 0 {
+					replicasForRes := totalLimit / reqVal
+					if replicasForRes < minAllowedReplicas {
+						minAllowedReplicas = replicasForRes
+					}
+					matchedAnyResource = true
+				} else if len(workerUnit) == 0 {
+					if totalLimit < minAllowedReplicas {
+						minAllowedReplicas = totalLimit
+					}
+					matchedAnyResource = true
+				}
+			}
+		}
+	}
+
+	if matchedAnyResource && minAllowedReplicas != math.MaxInt64 && minAllowedReplicas > 0 {
+		return int(minAllowedReplicas), nil
+	}
+	return 4, nil
+}
+
+func (r *ScaleGateReconciler) SetupWithManager(mgr ctrl.Manager) error {
+	rc := &unstructured.Unstructured{}
+	rc.SetGroupVersionKind(rayClusterGVK)
+	return ctrl.NewControllerManagedBy(mgr).
+		Named("scalegate").
+		For(rc).
+		Complete(r)
+}
diff --git a/ray-operator/controllers/ray/spot_interruption_controller.go b/ray-operator/controllers/ray/spot_interruption_controller.go
new file mode 100644
index 0000000..797af98
--- /dev/null
+++ b/ray-operator/controllers/ray/spot_interruption_controller.go
@@ -0,0 +1,144 @@
+package ray
+
+import (
+	"context"
+	"fmt"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/client-go/util/retry"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+const (
+	AnnotationProcessed = "kuberay.io/spot-interruption-processed"
+)
+
+var (
+	rayClusterGVK = schema.GroupVersionKind{
+		Group:   "ray.io",
+		Version: "v1",
+		Kind:    "RayCluster",
+	}
+)
+
+type SpotInterruptionReconciler struct {
+	client.Client
+	Scheme *runtime.Scheme
+}
+
+func (r *SpotInterruptionReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	cm := &corev1.ConfigMap{}
+	if err := r.Get(ctx, req.NamespacedName, cm); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	if cm.Labels["test.k8s.io/event"] != "spot-interrupted" {
+		return ctrl.Result{}, nil
+	}
+
+	if cm.Annotations != nil && cm.Annotations[AnnotationProcessed] == "true" {
+		return ctrl.Result{}, nil
+	}
+
+	targetCluster := cm.Labels["target-cluster"]
+	if targetCluster == "" {
+		return ctrl.Result{}, nil
+	}
+
+	groupName := cm.Data["workerGroup"]
+	targetPod := cm.Data["interruptedPod"]
+	var interrupted int64 = 1
+	if val, ok := cm.Data["interruptedReplicas"]; ok {
+		fmt.Sscanf(val, "%d", &interrupted)
+	}
+
+	logger.Info("handling spot interruption for cluster",
+		"cluster", targetCluster, "group", groupName, "interrupted", interrupted, "targetPod", targetPod)
+
+	err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latest := &unstructured.Unstructured{}
+		latest.SetGroupVersionKind(rayClusterGVK)
+		if err := r.Get(ctx, client.ObjectKey{Namespace: cm.Namespace, Name: targetCluster}, latest); err != nil {
+			return err
+		}
+		wgs, found, _ := unstructured.NestedSlice(latest.Object, "spec", "workerGroupSpecs")
+		if !found || len(wgs) == 0 {
+			return nil
+		}
+		modified := false
+		for i, wg := range wgs {
+			wgMap, ok := wg.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			if wgMap["groupName"] == groupName || groupName == "" {
+				curReplicas, _ := wgMap["replicas"].(int64)
+				if curReplicas > interrupted {
+					newReplicas := curReplicas - interrupted
+					logger.Info("contracting workerGroup replicas and maxReplicas to match surviving capacity",
+						"cluster", targetCluster, "old", curReplicas, "new", newReplicas)
+					wgMap["replicas"] = newReplicas
+					wgMap["maxReplicas"] = newReplicas
+
+					if targetPod != "" {
+						strategy, _, _ := unstructured.NestedMap(wgMap, "scaleStrategy")
+						if strategy == nil {
+							strategy = map[string]interface{}{}
+						}
+						toDelete, _, _ := unstructured.NestedStringSlice(strategy, "workersToDelete")
+						toDelete = append(toDelete, targetPod)
+						strategy["workersToDelete"] = toDelete
+						wgMap["scaleStrategy"] = strategy
+					}
+
+					wgs[i] = wgMap
+					modified = true
+				}
+			}
+		}
+		if modified {
+			_ = unstructured.SetNestedSlice(latest.Object, wgs, "spec", "workerGroupSpecs")
+			return r.Update(ctx, latest)
+		}
+		return nil
+	})
+
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+
+	// Mark processed for idempotency
+	_ = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latestCm := &corev1.ConfigMap{}
+		if err := r.Get(ctx, req.NamespacedName, latestCm); err != nil {
+			return err
+		}
+		ann := latestCm.GetAnnotations()
+		if ann == nil {
+			ann = map[string]string{}
+		}
+		ann[AnnotationProcessed] = "true"
+		latestCm.SetAnnotations(ann)
+		return r.Update(ctx, latestCm)
+	})
+
+	return ctrl.Result{}, nil
+}
+
+func (r *SpotInterruptionReconciler) SetupWithManager(mgr ctrl.Manager) error {
+	return ctrl.NewControllerManagedBy(mgr).
+		Named("spotinterruption").
+		For(&corev1.ConfigMap{}).
+		Complete(r)
+}
diff --git a/ray-operator/main.go b/ray-operator/main.go
