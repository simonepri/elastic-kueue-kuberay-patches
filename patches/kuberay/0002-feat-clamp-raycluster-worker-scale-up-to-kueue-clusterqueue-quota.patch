+// ScaleGate writes only maxReplicas. On every path, each RayCluster it writes carries the replicas and
+// workersToDelete the Ray autoscaler wrote, and it writes nothing when maxReplicas needs no clamp.
+func TestScaleGateWritesOnlyMaxReplicas(t *testing.T) {
+	gpuQueue := func(gpus string) *unstructured.Unstructured {
+		return sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{
+			{name: "on-demand", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", gpus)}},
+		}))
+	}
+	tests := []struct {
+		name                               string
+		queue                              *unstructured.Unstructured
+		replicas, minReplicas, maxReplicas int64
+		admitted                           int64
+		wantMaxReplicas                    int64
+		wantClamped                        bool
+	}{
+		{name: "quota bound clamps maxReplicas below replicas", queue: gpuQueue("8"), replicas: 16, minReplicas: 1, maxReplicas: 32, wantMaxReplicas: 8, wantClamped: true},
+		{name: "minReplicas floor clamps maxReplicas below replicas", queue: gpuQueue("4"), replicas: 10, minReplicas: 6, maxReplicas: 10, wantMaxReplicas: 6, wantClamped: true},
+		{name: "admitted count floor clamps maxReplicas below replicas", queue: gpuQueue("2"), replicas: 60, minReplicas: 1, maxReplicas: 100, admitted: 50, wantMaxReplicas: 50, wantClamped: true},
+		{name: "replicas above the bound with maxReplicas within it is not a clamp", queue: gpuQueue("8"), replicas: 16, minReplicas: 1, maxReplicas: 8, wantMaxReplicas: 8},
+		{name: "quota above maxReplicas does not raise it", queue: gpuQueue("16"), replicas: 2, minReplicas: 1, maxReplicas: 4, wantMaxReplicas: 4},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			objs := []client.Object{tc.queue, sgRayCluster("team-queue", tc.replicas, tc.minReplicas, tc.maxReplicas)}
+			if tc.admitted > 0 {
+				objs = append(objs, sgAdmittedWorkload(tc.admitted))
+			}
+			recorder := &sgWriteRecorder{}
+			got, clamped := sgReconcileWith(t, recorder.funcs(), objs...)
+
+			if replicas, _, maxReplicas := sgWorkerCounts(t, got); replicas != tc.replicas || maxReplicas != tc.wantMaxReplicas {
+				t.Errorf("worker group = replicas %d, max %d; want %d, %d", replicas, maxReplicas, tc.replicas, tc.wantMaxReplicas)
+			}
+			if !reflect.DeepEqual(sgWorkersToDeleteOf(got), sgWorkersToDelete()) {
+				t.Errorf("workersToDelete = %v; want %v", sgWorkersToDeleteOf(got), sgWorkersToDelete())
+			}
+			if clamped != tc.wantClamped {
+				t.Errorf("ScaleGateClamped condition set = %v; want %v", clamped, tc.wantClamped)
+			}
+			if tc.wantClamped && len(recorder.written) == 0 {
+				t.Errorf("ScaleGate wrote nothing; want the clamped maxReplicas")
+			}
+			if !tc.wantClamped && len(recorder.written) != 0 {
+				t.Errorf("ScaleGate wrote %d RayCluster updates; want none", len(recorder.written))
+			}
+			for _, written := range recorder.written {
+				if replicas, _, _ := sgWorkerCounts(t, written); replicas != tc.replicas {
+					t.Errorf("ScaleGate wrote replicas %d; want %d, the value it read", replicas, tc.replicas)
+				}
+				if !reflect.DeepEqual(sgWorkersToDeleteOf(written), sgWorkersToDelete()) {
+					t.Errorf("ScaleGate wrote workersToDelete %v; want %v, the value it read", sgWorkersToDeleteOf(written), sgWorkersToDelete())
+				}
+			}
+		})
+	}
+}
