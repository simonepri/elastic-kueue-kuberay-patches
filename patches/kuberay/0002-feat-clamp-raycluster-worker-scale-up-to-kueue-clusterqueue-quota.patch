+func TestScaleGateHeadPodQuotaDeduction(t *testing.T) {
+	// Nominal quota is 10 CPU. Head requests 2 CPU, worker requests 2 CPU.
+	// Without head deduction: 10 / 2 = 5 workers.
+	// With head deduction: (10 - 2) / 2 = 4 workers.
+	cq := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "10")},
+	}}))
+	rc := sgRayClusterWithHead("team-queue", "2", "2", 1, 1, 10)
+	got, clamped := sgReconcile(t, rc, cq)
+	if !clamped {
+		t.Fatalf("expected ScaleGateClamped condition")
+	}
+	_, _, maxReplicas := sgWorkerCounts(t, got)
+	if maxReplicas != 4 {
+		t.Fatalf("expected maxReplicas clamped to 4 after head pod deduction, got %d", maxReplicas)
+	}
+}
