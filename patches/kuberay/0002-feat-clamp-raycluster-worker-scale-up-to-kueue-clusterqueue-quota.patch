+// With Kueue's flavor split, a worker group may run on every flavor of a resource group at once.
+func TestClusterQueueQuotaMaxWorkersFlavorSplit(t *testing.T) {
+	unit := map[string]int64{"nvidia.com/gpu": 1}
+	group := func(limits ...int64) clusterQueueQuota {
+		var fls []flavorQuota
+		for i, lim := range limits {
+			fls = append(fls, flavorQuota{name: fmt.Sprintf("f%d", i), limits: map[string]int64{"nvidia.com/gpu": lim}})
+		}
+		return clusterQueueQuota{groups: []resourceGroupQuota{{covered: map[string]bool{"nvidia.com/gpu": true}, flavors: fls}}}
+	}
+	tests := []struct {
+		name        string
+		quota       clusterQueueQuota
+		flavorSplit bool
+		want        int64
+		wantBound   bool
+	}{
+		{name: "the largest flavor without the split", quota: group(8, 4), want: 8, wantBound: true},
+		{name: "the sum of the flavors with the split", quota: group(8, 4), flavorSplit: true, want: 12, wantBound: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, bound := tc.quota.maxWorkers(unit, nil, nil, tc.flavorSplit)
+			if bound != tc.wantBound || (bound && got != tc.want) {
+				t.Errorf("maxWorkers = %d, %v; want %d, %v", got, bound, tc.want, tc.wantBound)
+			}
+		})
+	}
+}
