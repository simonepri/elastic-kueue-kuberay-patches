+
+// Tests for the ScaleGate quota bound: flavor and resource group combination, cohort borrowing, Kueue admission,
+// the minReplicas floor that keeps the clamped spec valid, and the rule that maxReplicas is the only field ScaleGate
+// writes.
+
+type sgFlavor struct {
+	name      string
+	resources []map[string]interface{}
+}
+
+func sgResource(name string, nominal interface{}, borrowingLimit ...interface{}) map[string]interface{} {
+	res := map[string]interface{}{"name": name, "nominalQuota": nominal}
+	if len(borrowingLimit) > 0 {
+		res["borrowingLimit"] = borrowingLimit[0]
+	}
+	return res
+}
+
+func sgResourceGroups(groups ...[]sgFlavor) []interface{} {
+	out := []interface{}{}
+	for _, flavors := range groups {
+		covered := []interface{}{}
+		seen := map[string]bool{}
+		fls := []interface{}{}
+		for _, fl := range flavors {
+			resources := []interface{}{}
+			for _, res := range fl.resources {
+				resources = append(resources, res)
+				if name := res["name"].(string); !seen[name] {
+					seen[name] = true
+					covered = append(covered, name)
+				}
+			}
+			fls = append(fls, map[string]interface{}{"name": fl.name, "resources": resources})
+		}
+		out = append(out, map[string]interface{}{"coveredResources": covered, "flavors": fls})
+	}
+	return out
+}
+
+func sgKueueObject(kind, name, namespace string, spec map[string]interface{}) *unstructured.Unstructured {
+	obj := &unstructured.Unstructured{Object: map[string]interface{}{"spec": spec}}
+	obj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: kind})
+	obj.SetName(name)
+	obj.SetNamespace(namespace)
+	return obj
+}
+
+func sgClusterQueue(name, cohort string, groups []interface{}) *unstructured.Unstructured {
+	spec := map[string]interface{}{"resourceGroups": groups}
+	if cohort != "" {
+		spec["cohortName"] = cohort
+	}
+	return sgKueueObject("ClusterQueue", name, "", spec)
+}
+
+func sgLocalQueue(name, namespace, clusterQueue string) *unstructured.Unstructured {
+	spec := map[string]interface{}{"clusterQueue": clusterQueue}
+	return sgKueueObject("LocalQueue", name, namespace, spec)
+}
+
+func sgRayCluster(queue string, replicas, minReplicas, maxReplicas int64) *rayv1.RayCluster {
+	rep := int32(replicas)
+	minRep := int32(minReplicas)
+	maxRep := int32(maxReplicas)
+	rc := &rayv1.RayCluster{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "gang",
+			Namespace: "default",
+			UID:       types.UID("raycluster-uid"),
+			Labels:    map[string]string{"kueue.x-k8s.io/queue-name": queue},
+		},
+		Spec: rayv1.RayClusterSpec{
+			WorkerGroupSpecs: []rayv1.WorkerGroupSpec{
+				{
+					GroupName:   "gpu-workers",
+					Replicas:    &rep,
+					MinReplicas: &minRep,
+					MaxReplicas: &maxRep,
+					ScaleStrategy: rayv1.ScaleStrategy{
+						WorkersToDelete: sgWorkersToDelete(),
+					},
+					Template: corev1.PodTemplateSpec{
+						Spec: corev1.PodSpec{
+							Containers: []corev1.Container{
+								{
+									Name: "ray-worker",
+									Resources: corev1.ResourceRequirements{
+										Requests: corev1.ResourceList{
+											corev1.ResourceCPU: resource.MustParse("4"),
+											"nvidia.com/gpu":   resource.MustParse("1"),
+										},
+									},
+								},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+	return rc
+}
+
+func sgAdmittedWorkload(count int64) *unstructured.Unstructured {
+	wl := sgKueueObject("Workload", "raycluster-gang", "default", map[string]interface{}{
+		"podSets": []interface{}{
+			map[string]interface{}{"name": "head", "count": int64(1)},
+			map[string]interface{}{"name": "gpu-workers", "count": count},
+		},
+	})
+	wl.Object["status"] = map[string]interface{}{"admission": map[string]interface{}{
+		"clusterQueue": "team-queue",
+		"podSetAssignments": []interface{}{
+			map[string]interface{}{"name": "head", "count": int64(1)},
+			map[string]interface{}{"name": "gpu-workers", "count": count},
+		},
+	}}
+	wl.SetOwnerReferences([]metav1.OwnerReference{{APIVersion: "ray.io/v1", Kind: "RayCluster", Name: "gang", UID: "raycluster-uid"}})
+	return wl
+}
+
+// sgWorkersToDelete returns the pods the Ray autoscaler asked the operator to delete from the test worker group.
+func sgWorkersToDelete() []string {
+	return []string{"gang-gpu-workers-aaaaa", "gang-gpu-workers-bbbbb"}
+}
+
+func sgReconcile(t *testing.T, objs ...client.Object) (*rayv1.RayCluster, bool) {
+	t.Helper()
+	return sgReconcileWith(t, interceptor.Funcs{}, objs...)
+}
+
+// sgReconcileWith reconciles the RayCluster "gang" against a fake client that routes calls through funcs, and returns
+// the stored RayCluster and whether it carries the ScaleGateClamped condition.
+func sgReconcileWith(t *testing.T, funcs interceptor.Funcs, objs ...client.Object) (*rayv1.RayCluster, bool) {
+	t.Helper()
+	mapper := meta.NewDefaultRESTMapper(nil)
+	for _, kind := range []string{"ClusterQueue", "Cohort"} {
+		mapper.Add(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: kind}, meta.RESTScopeRoot)
+	}
+	for _, kind := range []string{"LocalQueue", "Workload"} {
+		mapper.Add(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: kind}, meta.RESTScopeNamespace)
+	}
+	scheme := runtime.NewScheme()
+	if err := rayv1.AddToScheme(scheme); err != nil {
+		t.Fatalf("AddToScheme: %v", err)
+	}
+	allObjs := append([]client.Object{}, objs...)
+	var hasLQ bool
+	for _, obj := range objs {
+		if u, ok := obj.(*unstructured.Unstructured); ok && u.GetKind() == "LocalQueue" {
+			hasLQ = true
+			break
+		}
+	}
+	if !hasLQ {
+		for _, obj := range objs {
+			if u, ok := obj.(*unstructured.Unstructured); ok && u.GetKind() == "ClusterQueue" {
+				allObjs = append(allObjs, sgLocalQueue(u.GetName(), "default", u.GetName()))
+			}
+		}
+	}
+
+	fakeClient := clientFake.NewClientBuilder().
+		WithScheme(scheme).
+		WithStatusSubresource(&rayv1.RayCluster{}).
+		WithRESTMapper(mapper).
+		WithInterceptorFuncs(funcs).
+		WithObjects(allObjs...).
+		Build()
+	r := &ScaleGateReconciler{Client: fakeClient}
+	key := types.NamespacedName{Namespace: "default", Name: "gang"}
+	if _, err := r.Reconcile(context.Background(), ctrl.Request{NamespacedName: key}); err != nil {
+		t.Fatalf("Reconcile returned an error: %v", err)
+	}
+	got := &rayv1.RayCluster{}
+	if err := fakeClient.Get(context.Background(), key, got); err != nil {
+		t.Fatalf("Get RayCluster: %v", err)
+	}
+	cond := meta.FindStatusCondition(got.Status.Conditions, "ScaleGateClamped")
+	clamped := cond != nil && cond.Status == metav1.ConditionTrue
+	return got, clamped
+}
+
+func sgWorkerGroup(rc *rayv1.RayCluster) rayv1.WorkerGroupSpec {
+	return rc.Spec.WorkerGroupSpecs[0]
+}
+
+// sgWorkersToDeleteOf returns the workersToDelete list of the test worker group.
+func sgWorkersToDeleteOf(rc *rayv1.RayCluster) []string {
+	return sgWorkerGroup(rc).ScaleStrategy.WorkersToDelete
+}
+
+func sgWorkerCounts(t *testing.T, rc *rayv1.RayCluster) (replicas, minReplicas, maxReplicas int64) {
+	t.Helper()
+	wg := sgWorkerGroup(rc)
+	if wg.Replicas != nil {
+		replicas = int64(*wg.Replicas)
+	}
+	if wg.MinReplicas != nil {
+		minReplicas = int64(*wg.MinReplicas)
+	}
+	if wg.MaxReplicas != nil {
+		maxReplicas = int64(*wg.MaxReplicas)
+	}
+	return replicas, minReplicas, maxReplicas
+}
+
+// A fixed-size gang admitted on a flavor that has no nominal GPUs and borrows from the cohort without a
+// borrowingLimit keeps its size, even though another flavor of the ClusterQueue holds only 2 GPUs.
+func TestScaleGateKeepsAdmittedGangOnBorrowOnlyFlavor(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "shared", sgResourceGroups([]sgFlavor{
