+func TestScaleGateUserEditWhileClamped(t *testing.T) {
+	// User sets maxReplicas = 10.
+	// Initial quota fits 2 workers -> clamped to 2.
+	// User edits maxReplicas from 2 to 6 (still clamped since 6 > 2).
+	// ScaleGate should record the new user original as 6, not overwrite with 10.
+	// When quota grows to 20, maxReplicas should be restored to 6, not 10.
+	cq := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "8"), sgResource("nvidia.com/gpu", "2")},
+	}}))
+	rc := sgRayCluster("team-queue", 1, 1, 10)
+	got, clamped := sgReconcile(t, rc, cq)
+	if !clamped {
+		t.Fatalf("expected ScaleGateClamped condition")
+	}
+	_, _, maxReplicas := sgWorkerCounts(t, got)
+	if maxReplicas != 2 {
+		t.Fatalf("expected maxReplicas clamped to 2, got %d", maxReplicas)
+	}
+
+	// User edits maxReplicas on the object to 6 while still clamped
+	max6 := int32(6)
+	got.Spec.WorkerGroupSpecs[0].MaxReplicas = &max6
+
+	// Reconcile with same quota (fits 2)
+	gotEdited, clampedEdited := sgReconcile(t, got, cq)
+	if !clampedEdited {
+		t.Fatalf("expected ScaleGateClamped condition after user edit")
+	}
+	_, _, maxReplicasEdited := sgWorkerCounts(t, gotEdited)
+	if maxReplicasEdited != 2 {
+		t.Fatalf("expected maxReplicas to remain clamped to 2, got %d", maxReplicasEdited)
+	}
+
+	// Now quota grows to fit 20 workers. Restored value should be 6, not 10!
+	cqHuge := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "100"), sgResource("nvidia.com/gpu", "25")},
+	}}))
+	gotRestored, clampedRestored := sgReconcile(t, gotEdited, cqHuge)
+	if clampedRestored {
+		t.Fatalf("expected ScaleGateClamped condition to be False when quota is abundant")
+	}
+	_, _, maxReplicasRestored := sgWorkerCounts(t, gotRestored)
+	if maxReplicasRestored != 6 {
+		t.Fatalf("expected maxReplicas restored to user-edited 6, got %d", maxReplicasRestored)
+	}
+}
