+func TestScaleGateRestoresMaxReplicasOnQuotaGrowth(t *testing.T) {
+	// User configures maxReplicas = 10.
+	// Initial quota fits 2 workers -> clamped to 2.
+	// Quota grows to 6 workers -> restored to 6.
+	// Quota grows to 20 workers -> restored to user's original 10 (not 20).
+	cq := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "8"), sgResource("nvidia.com/gpu", "2")},
+	}}))
+	rc := sgRayCluster("team-queue", 1, 1, 10)
+	got, clamped := sgReconcile(t, rc, cq)
+	if !clamped {
+		t.Fatalf("expected ScaleGateClamped condition")
+	}
+	_, _, maxReplicas := sgWorkerCounts(t, got)
+	if maxReplicas != 2 {
+		t.Fatalf("expected maxReplicas clamped to 2, got %d", maxReplicas)
+	}
+
+	// Now reconcile with larger quota
+	cqLarger := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "24"), sgResource("nvidia.com/gpu", "6")},
+	}}))
+	got2, clamped2 := sgReconcile(t, got, cqLarger)
+	if !clamped2 {
+		t.Fatalf("expected ScaleGateClamped condition at 6")
+	}
+	_, _, maxReplicas2 := sgWorkerCounts(t, got2)
+	if maxReplicas2 != 6 {
+		t.Fatalf("expected maxReplicas raised to 6, got %d", maxReplicas2)
+	}
+
+	// Now reconcile with quota exceeding user's original maxReplicas of 10
+	cqHuge := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "100"), sgResource("nvidia.com/gpu", "25")},
+	}}))
+	got3, clamped3 := sgReconcile(t, got2, cqHuge)
+	if clamped3 {
+		t.Fatalf("expected ScaleGateClamped condition to be False when within quota")
+	}
+	_, _, maxReplicas3 := sgWorkerCounts(t, got3)
+	if maxReplicas3 != 10 {
+		t.Fatalf("expected maxReplicas restored to original 10, got %d", maxReplicas3)
+	}
+}
