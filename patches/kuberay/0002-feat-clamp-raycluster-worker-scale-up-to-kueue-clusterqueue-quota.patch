+// When the Ray autoscaler writes between ScaleGate's read and its write, the write conflicts, and ScaleGate retries
+// on the new version and keeps what the autoscaler wrote.
+func TestScaleGateKeepsAutoscalerWriteOnConflict(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{
+		{name: "on-demand", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "8")}},
+	}))
+	autoscalerWrote := false
+	funcs := interceptor.Funcs{
+		Update: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.UpdateOption) error {
+			if !autoscalerWrote {
+				autoscalerWrote = true
+				latest := &rayv1.RayCluster{}
+				if err := c.Get(ctx, client.ObjectKeyFromObject(obj), latest); err != nil {
+					return err
+				}
+				rep24 := int32(24)
+				latest.Spec.WorkerGroupSpecs[0].Replicas = &rep24
+				latest.Spec.WorkerGroupSpecs[0].ScaleStrategy.WorkersToDelete = []string{"gang-gpu-workers-ccccc"}
+				if err := c.Update(ctx, latest); err != nil {
+					return err
+				}
+			}
+			return c.Update(ctx, obj, opts...)
+		},
+	}
+	got, clamped := sgReconcileWith(t, funcs, queue, sgRayCluster("team-queue", 16, 1, 32))
+	if !autoscalerWrote {
+		t.Fatalf("the autoscaler write never happened, so the test checked nothing")
+	}
+	if replicas, _, maxReplicas := sgWorkerCounts(t, got); replicas != 24 || maxReplicas != 8 {
+		t.Errorf("worker group = replicas %d, max %d; want 24 (the autoscaler's write), 8", replicas, maxReplicas)
+	}
+	if want := []string{"gang-gpu-workers-ccccc"}; !reflect.DeepEqual(sgWorkersToDeleteOf(got), want) {
+		t.Errorf("workersToDelete = %v; want %v (the autoscaler's write)", sgWorkersToDeleteOf(got), want)
+	}
+	if !clamped {
+		t.Errorf("ScaleGateClamped condition missing after clamping")
+	}
+}
