+// admittedWorkerCounts sums split pod set entries (<group>, <group>--2, ...) belonging to the same worker group.
+func TestScaleGateAdmittedWorkerCounts(t *testing.T) {
+	rc := sgRayCluster("team-queue", 16, 1, 32)
+	tests := []struct {
+		name        string
+		podSets     []map[string]interface{}
+		assignments []map[string]interface{}
+		wantCounts  map[string]int64
+	}{
+		{
+			name: "no suffix",
+			podSets: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(8)},
+			},
+			assignments: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(8)},
+			},
+			wantCounts: map[string]int64{"head": 1, "gpu-workers": 8},
+		},
+		{
+			name: "two entries 8+4 giving 12",
+			podSets: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(8)},
+				{
+					"name":  "gpu-workers--2",
+					"count": int64(4),
+					"template": map[string]interface{}{
+						"metadata": map[string]interface{}{
+							"annotations": map[string]interface{}{
+								"kueue.x-k8s.io/flavor-split-of": "gpu-workers",
+							},
+						},
+					},
+				},
+			},
+			assignments: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(8)},
+				{"name": "gpu-workers--2", "count": int64(4)},
+			},
+			wantCounts: map[string]int64{"head": 1, "gpu-workers": 12},
+		},
+		{
+			name: "two entries 8+4 giving 12 without annotation fallback to name",
+			podSets: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(8)},
+				{"name": "gpu-workers--2", "count": int64(4)},
+			},
+			assignments: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(8)},
+				{"name": "gpu-workers--2", "count": int64(4)},
+			},
+			wantCounts: map[string]int64{"head": 1, "gpu-workers": 12},
+		},
+		{
+			name: "an entry at 0",
+			podSets: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(0)},
+			},
+			assignments: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "gpu-workers", "count": int64(0)},
+			},
+			wantCounts: map[string]int64{"head": 1, "gpu-workers": 0},
+		},
+		{
+			name: "trailing digits when base is not a podset in workload",
+			podSets: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "standalone--2", "count": int64(5)},
+			},
+			assignments: []map[string]interface{}{
+				{"name": "head", "count": int64(1)},
+				{"name": "standalone--2", "count": int64(5)},
+			},
+			wantCounts: map[string]int64{"head": 1, "standalone--2": 5},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			podSets := make([]interface{}, len(tc.podSets))
+			for i, ps := range tc.podSets {
+				entry := map[string]interface{}{"name": ps["name"], "count": ps["count"]}
+				if tmpl, ok := ps["template"]; ok {
+					entry["template"] = tmpl
+				}
+				podSets[i] = entry
+			}
+			podSetAssignments := make([]interface{}, len(tc.assignments))
+			for i, a := range tc.assignments {
+				podSetAssignments[i] = map[string]interface{}{"name": a["name"], "count": a["count"]}
+			}
+			wl := sgKueueObject("Workload", "raycluster-gang", "default", map[string]interface{}{
+				"podSets": podSets,
+			})
+			wl.Object["status"] = map[string]interface{}{"admission": map[string]interface{}{
+				"clusterQueue":      "team-queue",
+				"podSetAssignments": podSetAssignments,
+			}}
+			wl.SetOwnerReferences([]metav1.OwnerReference{{APIVersion: "ray.io/v1", Kind: "RayCluster", Name: "gang", UID: "raycluster-uid"}})
+
+			mapper := meta.NewDefaultRESTMapper(nil)
+			mapper.Add(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: "Workload"}, meta.RESTScopeNamespace)
+			scheme := runtime.NewScheme()
+			if err := rayv1.AddToScheme(scheme); err != nil {
+				t.Fatalf("AddToScheme: %v", err)
+			}
+			fakeClient := clientFake.NewClientBuilder().
+				WithScheme(scheme).
+				WithRESTMapper(mapper).
+				WithObjects(rc, wl).
+				Build()
+			r := &ScaleGateReconciler{Client: fakeClient}
+
+			got, _, err := r.admittedWorkerCounts(context.Background(), rc)
+			if err != nil {
+				t.Fatalf("admittedWorkerCounts: %v", err)
+			}
+			if !reflect.DeepEqual(got, tc.wantCounts) {
+				t.Errorf("admittedWorkerCounts = %v; want %v", got, tc.wantCounts)
+			}
+		})
+	}
+}
