+func TestScaleGateNonSplitHeadCheckAcrossAllResources(t *testing.T) {
+	// Probe from F60:
+	// Flavor A: 2 CPU, 4Gi memory
+	// Flavor B: 4 CPU, 512Mi memory
+	// Flavor C: 500m CPU, 4Gi memory
+	// Head: 1 CPU, 2Gi memory
+	// Worker: 1 CPU, 1Gi memory
+	// Neither B (not enough memory) nor C (not enough CPU) can hold head.
+	// Therefore A must hold head and has 1 CPU, 2Gi left -> fits 1 worker.
+	cq := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{
+		{name: "flavor-a", resources: []map[string]interface{}{sgResource("cpu", "2"), sgResource("memory", "4Gi")}},
+		{name: "flavor-b", resources: []map[string]interface{}{sgResource("cpu", "4"), sgResource("memory", "512Mi")}},
+		{name: "flavor-c", resources: []map[string]interface{}{sgResource("cpu", "500m"), sgResource("memory", "4Gi")}},
+	}))
+	q, err := buildClusterQueueQuota(cq, nil)
+	if err != nil {
+		t.Fatalf("buildClusterQueueQuota: %v", err)
+	}
+	workerUnit := map[string]int64{"cpu": 1000, "memory": 1024 * 1024 * 1024, "pods": 1}
+	headUnit := map[string]int64{"cpu": 1000, "memory": 2 * 1024 * 1024 * 1024, "pods": 1}
+	bound, ok := q.maxWorkers(workerUnit, headUnit, nil, false)
+	if !ok || bound != 1 {
+		t.Fatalf("expected bound = 1 worker, got %d (ok=%v)", bound, ok)
+	}
+}
