+	wl.SetOwnerReferences([]metav1.OwnerReference{{APIVersion: "ray.io/v1", Kind: "RayCluster", Name: "gang", UID: "raycluster-uid"}})
+	got, _ := sgReconcile(t, queue, rc, wl)
+	if replicas, _, maxReplicas := sgWorkerCounts(t, got); replicas != 16 || maxReplicas != 12 {
+		t.Errorf("worker group = replicas %d, max %d; want 16, 12 (the admitted count from 8+4)", replicas, maxReplicas)
+	}
+}
+
+func sgRayClusterWithHead(queue string, headCPU string, workerCPU string, replicas, minReplicas, maxReplicas int64) *rayv1.RayCluster {
+	rc := sgRayCluster(queue, replicas, minReplicas, maxReplicas)
+	if headCPU != "" {
+		rc.Spec.HeadGroupSpec = rayv1.HeadGroupSpec{
+			Template: corev1.PodTemplateSpec{
+				Spec: corev1.PodSpec{
+					Containers: []corev1.Container{
+						{
+							Name: "ray-head",
+							Resources: corev1.ResourceRequirements{
+								Requests: corev1.ResourceList{
+									corev1.ResourceCPU: resource.MustParse(headCPU),
+								},
+							},
+						},
+					},
+				},
+			},
+		}
+	}
+	if workerCPU != "" {
+		rc.Spec.WorkerGroupSpecs[0].Template.Spec.Containers[0].Resources.Requests[corev1.ResourceCPU] = resource.MustParse(workerCPU)
+	}
+	return rc
+}
