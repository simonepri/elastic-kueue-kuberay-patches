+func TestScaleGateHeadDeductionMultiFlavorProbe(t *testing.T) {
+	// Probe from F58: two 2-CPU flavors, 500m head, 1-CPU workers.
+	// In split mode (flavorSplit = true): total = 4 CPU - 0.5 CPU = 3.5 CPU -> 3 workers.
+	// Without split mode (flavorSplit = false):
+	// - Before admission: flavor A can hold 2 workers (while flavor B holds 500m head) -> 2 workers.
+	// - After admission with head on flavor A: flavor B holds 2 workers -> 2 workers.
+	cq := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{
+		{name: "flavor-a", resources: []map[string]interface{}{sgResource("cpu", "2000m")}},
+		{name: "flavor-b", resources: []map[string]interface{}{sgResource("cpu", "2000m")}},
+	}))
+	rc := sgRayClusterWithHead("team-queue", "500m", "1000m", 1, 1, 10)
+
+	// Without split mode before admission:
+	got, clamped := sgReconcile(t, rc, cq)
+	if !clamped {
+		t.Fatalf("expected ScaleGateClamped condition")
+	}
+	_, _, maxReplicas := sgWorkerCounts(t, got)
+	if maxReplicas != 2 {
+		t.Fatalf("expected maxReplicas = 2 without flavor split, got %d", maxReplicas)
+	}
+
+	// Test maxWorkers directly
+	q, err := buildClusterQueueQuota(cq, nil)
+	if err != nil {
+		t.Fatalf("buildClusterQueueQuota: %v", err)
+	}
+	workerUnit := map[string]int64{"cpu": 1000, "pods": 1}
+	headUnit := map[string]int64{"cpu": 500, "pods": 1}
+
+	splitBound, ok := q.maxWorkers(workerUnit, headUnit, nil, true)
+	if !ok || splitBound != 3 {
+		t.Fatalf("expected split mode bound = 3, got %d (ok=%v)", splitBound, ok)
+	}
+
+	noSplitBound, ok := q.maxWorkers(workerUnit, headUnit, nil, false)
+	if !ok || noSplitBound != 2 {
+		t.Fatalf("expected non-split mode bound = 2, got %d (ok=%v)", noSplitBound, ok)
+	}
+
+	// Admitted on flavor-a:
+	headFlavors := map[string]string{"cpu": "flavor-a"}
+	admittedBound, ok := q.maxWorkers(workerUnit, headUnit, headFlavors, false)
+	if !ok || admittedBound != 2 {
+		t.Fatalf("expected admitted non-split bound = 2, got %d (ok=%v)", admittedBound, ok)
+	}
+}
