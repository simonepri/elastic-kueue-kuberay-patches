+// sgWriteRecorder records a copy of every RayCluster the reconciler sends to the API server, by Update or by
+// status Update.
+type sgWriteRecorder struct {
+	written []*rayv1.RayCluster
+}
+
+func (w *sgWriteRecorder) record(obj client.Object) {
+	if rc, ok := obj.(*rayv1.RayCluster); ok {
+		w.written = append(w.written, rc.DeepCopy())
+	}
+}
+
+func (w *sgWriteRecorder) funcs() interceptor.Funcs {
+	return interceptor.Funcs{
+		Update: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.UpdateOption) error {
+			w.record(obj)
+			return c.Update(ctx, obj, opts...)
+		},
+		SubResourceUpdate: func(ctx context.Context, c client.Client, subResource string, obj client.Object, opts ...client.SubResourceUpdateOption) error {
+			w.record(obj)
+			return c.SubResource(subResource).Update(ctx, obj, opts...)
+		},
+	}
+}
