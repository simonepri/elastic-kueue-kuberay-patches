+func TestScaleGateQueueResolutionThroughLocalQueue(t *testing.T) {
+	// LocalQueue "team-queue" points to ClusterQueue "real-cluster-queue" (fits 2 workers).
+	// An unrelated ClusterQueue named "team-queue" exists (fits 10 workers).
+	// ScaleGate must resolve through LocalQueue and clamp to 2, not 10.
+	lq := sgLocalQueue("team-queue", "default", "real-cluster-queue")
+	cqReal := sgClusterQueue("real-cluster-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "8"), sgResource("nvidia.com/gpu", "2")},
+	}}))
+	cqUnrelated := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "40"), sgResource("nvidia.com/gpu", "10")},
+	}}))
+	rc := sgRayCluster("team-queue", 1, 1, 10)
+	got, clamped := sgReconcile(t, rc, lq, cqReal, cqUnrelated)
+	if !clamped {
+		t.Fatalf("expected ScaleGateClamped condition")
+	}
+	_, _, maxReplicas := sgWorkerCounts(t, got)
+	if maxReplicas != 2 {
+		t.Fatalf("expected maxReplicas clamped to 2 from real-cluster-queue, got %d", maxReplicas)
+	}
+}
