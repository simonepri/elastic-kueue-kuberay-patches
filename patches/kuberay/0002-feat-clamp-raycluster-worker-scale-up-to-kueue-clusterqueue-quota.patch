+package ray
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/meta"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/discovery"
+	"k8s.io/client-go/rest"
+	"k8s.io/client-go/util/retry"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/builder"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/handler"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+	"sigs.k8s.io/controller-runtime/pkg/predicate"
+
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+)
+
+// +kubebuilder:rbac:groups=kueue.x-k8s.io,resources=clusterqueues;localqueues;cohorts;workloads,verbs=get;list;watch
+
+// unlimitedQuota marks a quota that this ClusterQueue alone does not bound.
+const unlimitedQuota = int64(math.MaxInt64)
+
+// scaleLimitsAnnotation stores the user's un-clamped maxReplicas and the last clamped value per worker group.
+const scaleLimitsAnnotation = "scalegate.kuberay.io/scale-limits"
+
+type workerScaleLimit struct {
+	Original int64 `json:"original"`
+	Clamped  int64 `json:"clamped"`
+}
+
+// flavorSplitEnv names the operator environment variable that, set to true, makes ScaleGate bound a worker group by
+// the sum of its flavors in a resource group rather than the largest one. Set it when Kueue runs with the
+// ElasticJobsViaWorkloadSlicesFlavorSplit gate, which lets one worker group span flavors through split pod sets.
+const flavorSplitEnv = "SCALEGATE_FLAVOR_SPLIT"
+
+// kueueVersions lists the Kueue API versions ScaleGate reads, newest first.
+var kueueVersions = []string{"v1beta2", "v1beta1"}
+
+// ScaleGateReconciler caps the maxReplicas of each worker group of a Kueue-queued RayCluster at the most workers its
+// ClusterQueue could ever hold, so the Ray autoscaler cannot request pods Kueue can never admit. It writes nothing
+// else: the Ray autoscaler is the only writer of replicas and workersToDelete, and the operator already limits the
+// pods it creates to maxReplicas.
+type ScaleGateReconciler struct {
+	client.Client
+	Scheme *runtime.Scheme
+	// FlavorSplit sums the flavors of a resource group in the bound, as Kueue may split a worker group across them.
+	FlavorSplit bool
+}
+
+// flavorQuota maps each resource a flavor offers to the most of it one ClusterQueue can use on that flavor.
+type flavorQuota struct {
+	name   string
+	limits map[string]int64
+}
+
+// resourceGroupQuota is one ClusterQueue resource group: a set of resources and the flavors that offer them.
+type resourceGroupQuota struct {
+	covered map[string]bool
+	flavors []flavorQuota
+}
+
+// clusterQueueQuota is the most of each resource a ClusterQueue can use, per resource group and flavor.
+type clusterQueueQuota struct {
+	groups []resourceGroupQuota
+}
+
+// maxWorkers returns how many workers needing unit fit in the quota after reserving otherRequests
+// (e.g. head pod requests), and false when the quota does not bound them.
+func (q clusterQueueQuota) maxWorkers(unit map[string]int64, headUnit map[string]int64, headFlavors map[string]string, flavorSplit bool) (int64, bool) {
+	bound := unlimitedQuota
+	for _, group := range q.groups {
+		var needed []string
+		for res, amount := range unit {
+			if amount > 0 && group.covered[res] {
+				needed = append(needed, res)
+			}
+		}
+		if len(needed) == 0 {
+			continue
+		}
+
+		if flavorSplit {
+			best := unlimitedQuota
+			for _, res := range needed {
+				resTotal := int64(0)
+				for _, flavor := range group.flavors {
+					limit, ok := flavor.limits[res]
+					if !ok {
+						continue
+					}
+					resTotal += limit
+				}
+				headReq := headUnit[res]
+				available := resTotal - headReq
+				if available <= 0 {
+					best = 0
+				} else {
+					best = min(best, available/unit[res])
+				}
+			}
+			bound = min(bound, best)
+		} else {
+			best := int64(0)
+			for _, flavor := range group.flavors {
+				deductHead := false
+				if len(headFlavors) > 0 {
+					for _, hf := range headFlavors {
+						if flavor.name == hf {
+							deductHead = true
+							break
+						}
+					}
+				} else {
+					canAnotherHoldHead := false
+					for _, other := range group.flavors {
+						if other.name == flavor.name {
+							continue
+						}
+						holdsAll := true
+						for hRes, hReq := range headUnit {
+							if hReq > 0 && group.covered[hRes] && other.limits[hRes] < hReq {
+								holdsAll = false
+								break
+							}
+						}
+						if holdsAll {
+							canAnotherHoldHead = true
+							break
+						}
+					}
+					if !canAnotherHoldHead {
+						deductHead = true
+					}
+				}
+
+				fit := unlimitedQuota
+				for _, res := range needed {
+					limit, ok := flavor.limits[res]
+					if !ok {
+						fit = 0
+						break
+					}
+					headReq := int64(0)
+					if deductHead {
+						headReq = headUnit[res]
+					}
+					available := limit - headReq
+					if available <= 0 {
+						fit = 0
+						break
+					}
+					fit = min(fit, available/unit[res])
+				}
+				best = max(best, fit)
+			}
+			bound = min(bound, best)
+		}
+	}
+	if bound == unlimitedQuota {
+		return 0, false
+	}
+	return bound, true
+}
+
+// maxReplicasCeiling returns the highest maxReplicas ScaleGate leaves a worker group with under a quota bound. The
+// ceiling never drops below the count Kueue admitted for the group, since Kueue's admission is the authority on what
+// fits, nor below minReplicas, since a smaller maxReplicas makes the operator reject the spec.
+func maxReplicasCeiling(quotaBound int64, admitted int64, minReplicas int64) int64 {
+	return max(quotaBound, admitted, minReplicas)
+}
+
+func getScaleLimits(rc *rayv1.RayCluster) map[string]workerScaleLimit {
+	if rc.Annotations == nil || rc.Annotations[scaleLimitsAnnotation] == "" {
+		return make(map[string]workerScaleLimit)
+	}
+	var res map[string]workerScaleLimit
+	if err := json.Unmarshal([]byte(rc.Annotations[scaleLimitsAnnotation]), &res); err != nil {
+		return make(map[string]workerScaleLimit)
+	}
+	return res
+}
+
+func setScaleLimits(rc *rayv1.RayCluster, limits map[string]workerScaleLimit) {
+	if rc.Annotations == nil {
+		rc.Annotations = make(map[string]string)
+	}
+	if len(limits) == 0 {
+		delete(rc.Annotations, scaleLimitsAnnotation)
+	} else {
+		data, _ := json.Marshal(limits)
+		rc.Annotations[scaleLimitsAnnotation] = string(data)
+	}
+}
+
+// extractPodUnitResources returns the resources one pod requests, in millicores for cpu and whole units
+// for every other resource, plus one "pods", which Kueue counts per pod when a ClusterQueue covers it.
+func extractPodUnitResources(podSpec *corev1.PodSpec) map[string]int64 {
+	unit := map[string]int64{"pods": 1}
+	if podSpec == nil {
+		return unit
+	}
+	for _, c := range podSpec.Containers {
+		for resName, q := range c.Resources.Requests {
+			name := string(resName)
+			var amount int64
+			if name == "cpu" {
+				amount = q.MilliValue()
+			} else {
+				amount = q.Value()
+			}
+			if amount > 0 {
+				unit[name] += amount
+			}
+		}
+	}
+	return unit
+}
+
+func (r *ScaleGateReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	rc := &rayv1.RayCluster{}
+	if err := r.Get(ctx, req.NamespacedName, rc); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	queueName := rc.Labels["kueue.x-k8s.io/queue-name"]
+	if queueName == "" {
+		return ctrl.Result{}, nil
+	}
+	if len(rc.Spec.WorkerGroupSpecs) == 0 {
+		return ctrl.Result{}, nil
+	}
+
+	quota, err := r.resolveQuota(ctx, rc.Namespace, queueName)
+	if err != nil {
+		logger.Info("could not resolve Kueue quota for queue", "queue", queueName, "error", err)
+		return ctrl.Result{}, nil
+	}
+	admitted, headFlavors, err := r.admittedWorkerCounts(ctx, rc)
+	if err != nil {
+		logger.Info("could not read the Kueue admission of the RayCluster", "cluster", rc.Name, "error", err)
+		return ctrl.Result{}, nil
+	}
+
+	headUnit := extractPodUnitResources(&rc.Spec.HeadGroupSpec.Template.Spec)
+	anyClamped := false
+
+	cond := meta.FindStatusCondition(rc.Status.Conditions, "ScaleGateClamped")
+	hadClampedCondition := cond != nil && cond.Status == metav1.ConditionTrue
+
+	err = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latest := &rayv1.RayCluster{}
+		if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+			return err
+		}
+		limitsMap := getScaleLimits(latest)
+		limitsChanged := false
+		changed := false
+		anyClamped = false
+
+		for i := range latest.Spec.WorkerGroupSpecs {
+			wg := &latest.Spec.WorkerGroupSpecs[i]
+			groupName := wg.GroupName
+			var currMax int64
+			if wg.MaxReplicas != nil {
+				currMax = int64(*wg.MaxReplicas)
+			}
+			numOfHosts := int64(wg.NumOfHosts)
+			if numOfHosts <= 0 {
+				numOfHosts = 1
+			}
+
+			stored, hasStored := limitsMap[groupName]
+			var origMax int64
+			if !hasStored {
+				origMax = currMax
+			} else if currMax != stored.Clamped {
+				origMax = currMax
+			} else {
+				origMax = stored.Original
+			}
+
+			boundInPods, ok := quota.maxWorkers(extractPodUnitResources(&wg.Template.Spec), headUnit, headFlavors, r.FlavorSplit)
+			if !ok {
+				if hasStored {
+					delete(limitsMap, groupName)
+					limitsChanged = true
+					if currMax != origMax {
+						target32 := int32(origMax)
+						wg.MaxReplicas = &target32
+						changed = true
+					}
+				}
+				continue
+			}
+
+			boundInReplicas := boundInPods / numOfHosts
+			admittedInReplicas := admitted[strings.ToLower(groupName)] / numOfHosts
+			var minReplicas int64
+			if wg.MinReplicas != nil {
+				minReplicas = int64(*wg.MinReplicas)
+			}
+			ceiling := maxReplicasCeiling(boundInReplicas, admittedInReplicas, minReplicas)
+
+			if origMax > ceiling {
+				anyClamped = true
+				targetMax := ceiling
+				if !hasStored || stored.Original != origMax || stored.Clamped != targetMax {
+					limitsMap[groupName] = workerScaleLimit{Original: origMax, Clamped: targetMax}
+					limitsChanged = true
+				}
+				if currMax != targetMax {
+					logger.Info("clamping RayCluster maxReplicas to Kueue quota",
+						"cluster", latest.Name, "group", groupName, "requestedMax", origMax, "clamped", targetMax)
+					target32 := int32(targetMax)
+					wg.MaxReplicas = &target32
+					changed = true
+				}
+			} else {
+				targetMax := origMax
+				if hasStored {
+					delete(limitsMap, groupName)
+					limitsChanged = true
+				}
+				if currMax != targetMax {
+					logger.Info("restoring RayCluster maxReplicas from Kueue quota growth",
+						"cluster", latest.Name, "group", groupName, "restoredMax", targetMax)
+					target32 := int32(targetMax)
+					wg.MaxReplicas = &target32
+					changed = true
+				}
+			}
+		}
+
+		if limitsChanged {
+			setScaleLimits(latest, limitsMap)
+			changed = true
+		}
+		if !changed {
+			return nil
+		}
+		return r.Update(ctx, latest)
+	})
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+
+	if anyClamped || hadClampedCondition {
+		_ = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+			latest := &rayv1.RayCluster{}
+			if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+				return err
+			}
+			status := metav1.ConditionFalse
+			reason := "QuotaUnbounded"
+			message := "Worker maxReplicas is within available Kueue ClusterQueue quota"
+			if anyClamped {
+				status = metav1.ConditionTrue
+				reason = "KueueQuotaCapped"
+				message = "Worker maxReplicas clamped to available Kueue ClusterQueue quota"
+			}
+			currCond := meta.FindStatusCondition(latest.Status.Conditions, "ScaleGateClamped")
+			if currCond != nil && currCond.Status == status && currCond.Reason == reason && currCond.Message == message {
+				return nil
+			}
+			meta.SetStatusCondition(&latest.Status.Conditions, metav1.Condition{
+				Type:    "ScaleGateClamped",
+				Status:  status,
+				Reason:  reason,
+				Message: message,
+			})
+			if err := r.Status().Update(ctx, latest); err != nil {
+				logger.Info("could not update ScaleGateClamped condition", "cluster", latest.Name, "error", err)
+				return err
+			}
+			return nil
+		})
+	}
+
+	if anyClamped {
+		return ctrl.Result{RequeueAfter: 30 * time.Second}, nil
+	}
+	return ctrl.Result{}, nil
+}
+
+// parseResourceValue returns a quantity in millicores for cpu and in whole units for every other resource.
+func parseResourceValue(resName string, raw interface{}) int64 {
+	if raw == nil {
+		return 0
+	}
+	q, err := resource.ParseQuantity(fmt.Sprint(raw))
+	if err != nil {
+		return 0
+	}
+	if resName == "cpu" {
+		return q.MilliValue()
+	}
+	return q.Value()
+}
+
+// getKueueObject reads a Kueue object at the newest API version the cluster serves.
+func (r *ScaleGateReconciler) getKueueObject(ctx context.Context, kind string, key client.ObjectKey) (*unstructured.Unstructured, error) {
+	var lastErr error
+	for _, v := range kueueVersions {
+		obj := &unstructured.Unstructured{}
+		obj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: v, Kind: kind})
+		if lastErr = r.Get(ctx, key, obj); lastErr == nil {
+			return obj, nil
+		}
+		if !meta.IsNoMatchError(lastErr) {
+			return nil, lastErr
+		}
+	}
+	return nil, lastErr
+}
+
+// listKueueObjects lists Kueue objects at the newest API version the cluster serves.
+func (r *ScaleGateReconciler) listKueueObjects(ctx context.Context, kind string, opts ...client.ListOption) ([]unstructured.Unstructured, error) {
+	var lastErr error
+	for _, v := range kueueVersions {
+		list := &unstructured.UnstructuredList{}
+		list.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: v, Kind: kind + "List"})
+		if lastErr = r.List(ctx, list, opts...); lastErr == nil {
+			return list.Items, nil
+		}
+		if !meta.IsNoMatchError(lastErr) {
+			return nil, lastErr
+		}
+	}
+	return nil, lastErr
+}
+
+// resolveClusterQueue returns the ClusterQueue that queueName names through a LocalQueue.
+func (r *ScaleGateReconciler) resolveClusterQueue(ctx context.Context, namespace, queueName string) (*unstructured.Unstructured, error) {
+	lq, err := r.getKueueObject(ctx, "LocalQueue", client.ObjectKey{Namespace: namespace, Name: queueName})
+	if err != nil {
+		return nil, fmt.Errorf("local queue %s not found in namespace %s: %w", queueName, namespace, err)
+	}
+	target, _, _ := unstructured.NestedString(lq.Object, "spec", "clusterQueue")
+	if target == "" {
+		return nil, fmt.Errorf("local queue %s/%s names no cluster queue", namespace, queueName)
+	}
+	return r.getKueueObject(ctx, "ClusterQueue", client.ObjectKey{Name: target})
+}
+
+// resolveQuota returns the most of each resource the ClusterQueue behind queueName can use on each flavor.
+func (r *ScaleGateReconciler) resolveQuota(ctx context.Context, namespace, queueName string) (clusterQueueQuota, error) {
+	cq, err := r.resolveClusterQueue(ctx, namespace, queueName)
+	if err != nil {
+		return clusterQueueQuota{}, err
+	}
+	var supply map[string]map[string]int64
+	if cohort := cohortOf(cq); cohort != "" {
+		clusterQueues, err := r.listKueueObjects(ctx, "ClusterQueue")
+		if err != nil {
+			return clusterQueueQuota{}, err
+		}
+		cohorts, err := r.listKueueObjects(ctx, "Cohort")
+		if err != nil && !meta.IsNoMatchError(err) {
+			return clusterQueueQuota{}, err
+		}
+		supply = cohortTreeSupply(cohort, clusterQueues, cohorts)
+	}
+	return buildClusterQueueQuota(cq, supply)
+}
+
+// cohortOf returns the cohort a ClusterQueue belongs to, or "" when it cannot borrow.
+func cohortOf(cq *unstructured.Unstructured) string {
+	if cohort, _, _ := unstructured.NestedString(cq.Object, "spec", "cohortName"); cohort != "" {
+		return cohort
+	}
+	cohort, _, _ := unstructured.NestedString(cq.Object, "spec", "cohort")
+	return cohort
+}
+
+// cohortTreeSupply sums the nominal quota per flavor and resource of every ClusterQueue and Cohort in the cohort
+// tree that contains cohort. Nothing in the tree can use more than that sum, so it bounds borrowing from above
+// however the cohorts nest, ignoring the lending and borrowing limits that may lower the real ceiling.
+func cohortTreeSupply(cohort string, clusterQueues, cohorts []unstructured.Unstructured) map[string]map[string]int64 {
+	parents := map[string]string{}
+	for i := range cohorts {
+		parent, _, _ := unstructured.NestedString(cohorts[i].Object, "spec", "parentName")
+		if parent == "" {
+			parent, _, _ = unstructured.NestedString(cohorts[i].Object, "spec", "parent")
+		}
+		parents[cohorts[i].GetName()] = parent
+	}
+	root := func(name string) string {
+		seen := map[string]bool{}
+		for parents[name] != "" && !seen[name] {
+			seen[name] = true
+			name = parents[name]
+		}
+		return name
+	}
+	treeRoot := root(cohort)
+
+	supply := map[string]map[string]int64{}
+	add := func(obj *unstructured.Unstructured) {
+		rGroups, _, _ := unstructured.NestedSlice(obj.Object, "spec", "resourceGroups")
+		forEachFlavorResource(rGroups, func(flavor, res string, resMap map[string]interface{}) {
+			if supply[flavor] == nil {
+				supply[flavor] = map[string]int64{}
+			}
+			supply[flavor][res] += parseResourceValue(res, resMap["nominalQuota"])
+		})
+	}
+	for i := range clusterQueues {
+		if c := cohortOf(&clusterQueues[i]); c != "" && root(c) == treeRoot {
+			add(&clusterQueues[i])
+		}
+	}
+	for i := range cohorts {
+		if root(cohorts[i].GetName()) == treeRoot {
+			add(&cohorts[i])
+		}
+	}
+	return supply
+}
+
+// forEachFlavorResource calls fn for every resource of every flavor in rGroups, a spec.resourceGroups list.
+func forEachFlavorResource(rGroups []interface{}, fn func(flavor, res string, resMap map[string]interface{})) {
+	for _, rg := range rGroups {
+		rgMap, ok := rg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		flavors, _, _ := unstructured.NestedSlice(rgMap, "flavors")
+		for _, fl := range flavors {
+			flMap, ok := fl.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			flavorName, _ := flMap["name"].(string)
+			resources, _, _ := unstructured.NestedSlice(flMap, "resources")
+			for _, res := range resources {
+				if resMap, ok := res.(map[string]interface{}); ok {
+					resName, _ := resMap["name"].(string)
+					fn(flavorName, resName, resMap)
+				}
+			}
+		}
+	}
+}
+
+// buildClusterQueueQuota computes the most of each resource the ClusterQueue can use on each flavor: its nominal
+// quota without a cohort, and with one the cohort tree's supply, lowered to nominal plus borrowingLimit when the
+// ClusterQueue sets a borrowingLimit. A missing borrowingLimit means unlimited borrowing in Kueue, so only the
+// supply of the cohort tree bounds it.
+func buildClusterQueueQuota(cq *unstructured.Unstructured, supply map[string]map[string]int64) (clusterQueueQuota, error) {
+	rGroups, found, _ := unstructured.NestedSlice(cq.Object, "spec", "resourceGroups")
+	if !found || len(rGroups) == 0 {
+		return clusterQueueQuota{}, fmt.Errorf("no resource groups found in cluster queue %s", cq.GetName())
+	}
+	hasCohort := cohortOf(cq) != ""
+	quota := clusterQueueQuota{}
+	for _, rg := range rGroups {
+		rgMap, ok := rg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		group := resourceGroupQuota{covered: map[string]bool{}}
+		covered, _, _ := unstructured.NestedStringSlice(rgMap, "coveredResources")
+		for _, res := range covered {
+			group.covered[res] = true
+		}
+		flavorIndex := map[string]int{}
+		forEachFlavorResource([]interface{}{rgMap}, func(flavor, res string, resMap map[string]interface{}) {
+			idx, ok := flavorIndex[flavor]
+			if !ok {
+				idx = len(group.flavors)
+				flavorIndex[flavor] = idx
+				group.flavors = append(group.flavors, flavorQuota{name: flavor, limits: map[string]int64{}})
+			}
+			group.covered[res] = true
+			nominal := parseResourceValue(res, resMap["nominalQuota"])
+			limit := nominal
+			if hasCohort {
+				limit = max(supply[flavor][res], nominal)
+				if resMap["borrowingLimit"] != nil {
+					limit = min(limit, nominal+parseResourceValue(res, resMap["borrowingLimit"]))
+				}
+			}
+			group.flavors[idx].limits[res] = limit
+		})
+		quota.groups = append(quota.groups, group)
+	}
+	return quota, nil
+}
+
+// admittedWorkerCounts returns, by lowercased base pod set name, the pod counts Kueue admitted for the Workload of the
+// RayCluster or of the RayJob that owns it; the map is empty when that Workload is not admitted. If a worker group's
+// pod set is split into multiple entries (<group>, <group>--2, ...), the counts are summed.
+func (r *ScaleGateReconciler) admittedWorkerCounts(ctx context.Context, rc *rayv1.RayCluster) (map[string]int64, map[string]string, error) {
+	owners := map[types.UID]bool{rc.UID: true}
+	for _, ref := range rc.OwnerReferences {
+		if ref.Kind == "RayJob" {
+			owners[ref.UID] = true
+		}
+	}
+	workloads, err := r.listKueueObjects(ctx, "Workload", client.InNamespace(rc.Namespace))
+	if err != nil {
+		return nil, nil, err
+	}
+	counts := map[string]int64{}
+	headFlavors := map[string]string{}
+	for i := range workloads {
+		wl := &workloads[i]
+		owned := false
+		for _, ref := range wl.GetOwnerReferences() {
+			owned = owned || owners[ref.UID]
+		}
+		if !owned {
+			continue
+		}
+		assignments, found, _ := unstructured.NestedSlice(wl.Object, "status", "admission", "podSetAssignments")
+		if !found {
+			continue
+		}
+		specCounts := map[string]int64{}
+		podSetBases := map[string]string{}
+		podSetNames := map[string]bool{}
+		podSets, _, _ := unstructured.NestedSlice(wl.Object, "spec", "podSets")
+		for _, ps := range podSets {
+			if psMap, ok := ps.(map[string]interface{}); ok {
+				name, _ := psMap["name"].(string)
+				lowerName := strings.ToLower(name)
+				specCounts[lowerName], _ = getInt64(psMap["count"])
+				podSetNames[lowerName] = true
+				if base, found, _ := unstructured.NestedString(psMap, "template", "metadata", "annotations", "kueue.x-k8s.io/flavor-split-of"); found && base != "" {
+					podSetBases[lowerName] = strings.ToLower(base)
+				}
+			}
+		}
+		wlCounts := map[string]int64{}
+		for _, a := range assignments {
+			aMap, ok := a.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			name, _ := aMap["name"].(string)
+			lowerName := strings.ToLower(name)
+			if lowerName == "head" {
+				if fls, found, _ := unstructured.NestedStringMap(aMap, "flavors"); found {
+					for res, fl := range fls {
+						headFlavors[res] = fl
+					}
+				}
+			}
+			base := resolvePodSetBase(lowerName, podSetBases, podSetNames)
+			count, ok := getInt64(aMap["count"])
+			if !ok {
+				count = specCounts[lowerName]
+			}
+			wlCounts[base] += count
+		}
+		for base, count := range wlCounts {
+			counts[base] = max(counts[base], count)
+		}
+	}
+	return counts, headFlavors, nil
+}
+
+// resolvePodSetBase resolves the base pod set name of a potentially split pod set entry.
+// The kueue.x-k8s.io/flavor-split-of annotation on the Workload's PodSet template is authoritative.
+// If only the name is available, a trailing --<digits> is stripped only when the stripped name
+// is another PodSet in the same Workload.
+func resolvePodSetBase(name string, podSetBases map[string]string, podSetNames map[string]bool) string {
+	if base, ok := podSetBases[name]; ok && base != "" {
+		return base
+	}
+	if idx := strings.LastIndex(name, "--"); idx != -1 {
+		suffix := name[idx+2:]
+		if len(suffix) > 0 && isAllDigits(suffix) {
+			candidate := name[:idx]
+			if podSetNames[candidate] {
+				return candidate
+			}
+		}
+	}
+	return name
+}
+
+func isAllDigits(s string) bool {
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func getInt64(val interface{}) (int64, bool) {
+	switch v := val.(type) {
+	case int64:
+		return v, true
+	case int32:
+		return int64(v), true
+	case int:
+		return int64(v), true
+	case float64:
+		return int64(v), true
+	default:
+		return 0, false
+	}
+}
+
+// kueueAPIAvailable returns true if the kueue.x-k8s.io/v1beta2 API (ClusterQueue, LocalQueue, Workload) is
+// available in the cluster. Used to avoid registering watches on Kueue CRDs when Kueue is not installed,
+// which would cause manager startup to time out waiting for the CRD cache to sync.
+func kueueAPIAvailable(restConfig *rest.Config) bool {
+	if restConfig == nil {
+		return false
+	}
+	discoveryClient, err := discovery.NewDiscoveryClientForConfig(restConfig)
+	if err != nil || discoveryClient == nil {
+		return false
+	}
+	_, resources, err := discoveryClient.ServerGroupsAndResources()
+	if err != nil {
+		return false
+	}
+	for _, r := range resources {
+		if r.GroupVersion == "kueue.x-k8s.io/v1beta2" {
+			return true
+		}
+	}
+	return false
+}
+
+func (r *ScaleGateReconciler) SetupWithManager(mgr ctrl.Manager) error {
+	if enabled, err := strconv.ParseBool(os.Getenv(flavorSplitEnv)); err == nil && enabled {
+		r.FlavorSplit = true
+	}
+	bld := ctrl.NewControllerManagedBy(mgr).
+		Named("scalegate").
+		For(&rayv1.RayCluster{}, builder.WithPredicates(predicate.GenerationChangedPredicate{}))
+
+	if !kueueAPIAvailable(mgr.GetConfig()) {
+		mgr.GetLogger().WithName("scalegate").Info("kueue.x-k8s.io/v1beta2 API not found; skipping Kueue watches (ScaleGate will only reconcile RayClusters directly)")
+		return bld.Complete(r)
+	}
+
+	cqObj := &unstructured.Unstructured{}
+	cqObj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: "ClusterQueue"})
+	bld.Watches(cqObj, handler.EnqueueRequestsFromMapFunc(func(ctx context.Context, obj client.Object) []ctrl.Request {
+		cqName := obj.GetName()
+		lqList := &unstructured.UnstructuredList{}
+		lqList.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: "LocalQueueList"})
+		if err := r.List(ctx, lqList); err != nil {
+			return nil
+		}
+		targetQueues := map[string]bool{}
+		for _, lq := range lqList.Items {
+			target, _, _ := unstructured.NestedString(lq.Object, "spec", "clusterQueue")
+			if target == cqName {
+				targetQueues[lq.GetNamespace()+"/"+lq.GetName()] = true
+			}
+		}
+		rcList := &rayv1.RayClusterList{}
+		if err := r.List(ctx, rcList); err != nil {
+			return nil
+		}
+		var reqs []ctrl.Request
+		for _, item := range rcList.Items {
+			qName := item.Labels["kueue.x-k8s.io/queue-name"]
+			if qName != "" && targetQueues[item.Namespace+"/"+qName] {
+				reqs = append(reqs, ctrl.Request{NamespacedName: types.NamespacedName{
+					Namespace: item.Namespace,
+					Name:      item.Name,
+				}})
+			}
+		}
+		return reqs
+	}), builder.WithPredicates(predicate.GenerationChangedPredicate{}))
+
+	lqObj := &unstructured.Unstructured{}
+	lqObj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: "LocalQueue"})
+	bld.Watches(lqObj, handler.EnqueueRequestsFromMapFunc(func(ctx context.Context, obj client.Object) []ctrl.Request {
+		rcList := &rayv1.RayClusterList{}
+		if err := r.List(ctx, rcList, client.InNamespace(obj.GetNamespace())); err != nil {
+			return nil
+		}
+		var reqs []ctrl.Request
+		for _, item := range rcList.Items {
+			if item.Labels["kueue.x-k8s.io/queue-name"] == obj.GetName() {
+				reqs = append(reqs, ctrl.Request{NamespacedName: types.NamespacedName{
+					Namespace: item.Namespace,
+					Name:      item.Name,
+				}})
+			}
+		}
+		return reqs
+	}), builder.WithPredicates(predicate.GenerationChangedPredicate{}))
+
+	wlObj := &unstructured.Unstructured{}
+	wlObj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: "Workload"})
+	bld.Watches(wlObj, handler.EnqueueRequestsFromMapFunc(func(ctx context.Context, obj client.Object) []ctrl.Request {
+		for _, ref := range obj.GetOwnerReferences() {
+			if ref.Kind == "RayCluster" {
+				return []ctrl.Request{{NamespacedName: types.NamespacedName{
+					Namespace: obj.GetNamespace(),
+					Name:      ref.Name,
+				}}}
+			}
+		}
+		return nil
+	}))
+
+	return bld.Complete(r)
+}
