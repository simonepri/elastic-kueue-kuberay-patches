+func TestScaleGateMultiHostWorkerGroup(t *testing.T) {
+	// Worker group has numOfHosts: 2.
+	// Each worker pod requests 2 CPU.
+	// ClusterQueue has 8 CPU.
+	// Available quota in pods = 8 / 2 = 4 pods.
+	// In multi-host groups, 1 replica = 2 pods.
+	// Available quota in replicas = 4 / 2 = 2 replicas.
+	// Configured maxReplicas: 5.
+	// Must clamp maxReplicas to 2 replicas (not 4 pods).
+	cq := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{{
+		name:      "default",
+		resources: []map[string]interface{}{sgResource("cpu", "8")},
+	}}))
+	rc := sgRayCluster("team-queue", 1, 1, 5)
+	rc.Spec.WorkerGroupSpecs[0].NumOfHosts = 2
+	rc.Spec.WorkerGroupSpecs[0].Template.Spec.Containers[0].Resources.Requests[corev1.ResourceCPU] = resource.MustParse("2")
+
+	got, clamped := sgReconcile(t, rc, cq)
+	if !clamped {
+		t.Fatalf("expected ScaleGateClamped condition")
+	}
+	_, _, maxReplicas := sgWorkerCounts(t, got)
+	if maxReplicas != 2 {
+		t.Fatalf("expected maxReplicas clamped to 2 replicas (4 pods / 2 hosts), got %d", maxReplicas)
+	}
+}
