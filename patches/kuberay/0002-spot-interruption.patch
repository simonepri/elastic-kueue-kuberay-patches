+++ b/ray-operator/controllers/ray/spot_interruption_controller.go
@@ -0,0 +1,366 @@
+package ray
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/resource"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/client-go/util/retry"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+const (
+	AnnotationProcessed = "kuberay.io/spot-interruption-processed"
+	// SpotInterruptionEventLabel marks a ConfigMap as a spot interruption notice when set to SpotInterruptionEventValue.
+	SpotInterruptionEventLabel = "test.k8s.io/event"
+	SpotInterruptionEventValue = "spot-interrupted"
+	// SpotInterruptionNoticesEnv opts the operator into watching interruption notices when set to "true".
+	SpotInterruptionNoticesEnv = "KUBERAY_SPOT_INTERRUPTION_NOTICES"
+)
+
+var (
+	rayClusterGVK = schema.GroupVersionKind{
+		Group:   "ray.io",
+		Version: "v1",
+		Kind:    "RayCluster",
+	}
+	workloadGVK = schema.GroupVersionKind{
+		Group:   "kueue.x-k8s.io",
+		Version: "v1beta2",
+		Kind:    "Workload",
+	}
+)
+
+type SpotInterruptionReconciler struct {
+	client.Client
+	Scheme *runtime.Scheme
+}
+
+func getInt64(val interface{}) (int64, bool) {
+	switch v := val.(type) {
+	case int64:
+		return v, true
+	case int32:
+		return int64(v), true
+	case int:
+		return int64(v), true
+	case float64:
+		return int64(v), true
+	default:
+		return 0, false
+	}
+}
+
+func (r *SpotInterruptionReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	cm := &corev1.ConfigMap{}
+	if err := r.Get(ctx, req.NamespacedName, cm); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	if cm.Labels[SpotInterruptionEventLabel] != SpotInterruptionEventValue {
+		return ctrl.Result{}, nil
+	}
+
+	if cm.Annotations != nil && cm.Annotations[AnnotationProcessed] == "true" {
+		return ctrl.Result{}, nil
+	}
+
+	targetCluster := cm.Labels["target-cluster"]
+	if targetCluster == "" {
+		return ctrl.Result{}, nil
+	}
+
+	groupName := cm.Data["workerGroup"]
+	targetPod := cm.Data["interruptedPod"]
+	var interrupted int64 = 1
+	if val, ok := cm.Data["interruptedReplicas"]; ok {
+		fmt.Sscanf(val, "%d", &interrupted)
+	}
+
+	logger.Info("handling spot interruption for cluster",
+		"cluster", targetCluster, "group", groupName, "interrupted", interrupted, "targetPod", targetPod)
+
+	latest := &unstructured.Unstructured{}
+	latest.SetGroupVersionKind(rayClusterGVK)
+	if err := r.Get(ctx, client.ObjectKey{Namespace: cm.Namespace, Name: targetCluster}, latest); err != nil {
+		return ctrl.Result{}, err
+	}
+	targetClusterUID := string(latest.GetUID())
+
+	type groupCounts struct {
+		oldCount int64
+		newCount int64
+	}
+	contractedGroups := make(map[string]groupCounts)
+
+	wgs, found, _ := unstructured.NestedSlice(latest.Object, "spec", "workerGroupSpecs")
+	if !found || len(wgs) == 0 {
+		return ctrl.Result{}, nil
+	}
+
+	for _, wg := range wgs {
+		wgMap, ok := wg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		curGroupName, _ := wgMap["groupName"].(string)
+		if curGroupName == groupName || groupName == "" {
+			curReplicas, ok := getInt64(wgMap["replicas"])
+			if !ok {
+				continue
+			}
+			minReplicas, _ := getInt64(wgMap["minReplicas"])
+			effectiveMin := minReplicas
+			if effectiveMin <= 0 {
+				effectiveMin = 1
+			}
+			if curReplicas > effectiveMin {
+				newReplicas := curReplicas - interrupted
+				if newReplicas < effectiveMin {
+					newReplicas = effectiveMin
+				}
+				if newReplicas < curReplicas {
+					contractedGroups[curGroupName] = groupCounts{
+						oldCount: curReplicas,
+						newCount: newReplicas,
+					}
+				}
+			}
+		}
+	}
+
+	if len(contractedGroups) == 0 {
+		// Nothing to contract
+		return ctrl.Result{}, nil
+	}
+
+	// Step 1: Update Kueue Workload FIRST so that when RayCluster is updated,
+	// Kueue workload slicing recognizes the partial preemption condition and does not replace the slice.
+	if targetClusterUID != "" {
+		wlList := &unstructured.UnstructuredList{}
+		wlList.SetGroupVersionKind(schema.GroupVersionKind{
+			Group:   "kueue.x-k8s.io",
+			Version: "v1beta2",
+			Kind:    "WorkloadList",
+		})
+
+		if err := r.List(ctx, wlList, client.InNamespace(cm.Namespace)); err != nil {
+			logger.Error(err, "failed to list workloads for spot admission sync", "namespace", cm.Namespace)
+		} else {
+			for _, item := range wlList.Items {
+				// Skip replaced / finished workload slices
+				conditions, _, _ := unstructured.NestedSlice(item.Object, "status", "conditions")
+				isFinished := false
+				for _, c := range conditions {
+					if cMap, ok := c.(map[string]interface{}); ok {
+						if cMap["type"] == "Finished" && cMap["status"] == "True" {
+							isFinished = true
+							break
+						}
+					}
+				}
+				if isFinished {
+					continue
+				}
+
+				matched := false
+				if item.GetLabels()["kueue.x-k8s.io/job-uid"] == targetClusterUID {
+					matched = true
+				} else {
+					for _, owner := range item.GetOwnerReferences() {
+						if string(owner.UID) == targetClusterUID {
+							matched = true
+							break
+						}
+					}
+				}
+				if !matched {
+					continue
+				}
+
+				workloadName := item.GetName()
+				_ = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+					currentWl := &unstructured.Unstructured{}
+					currentWl.SetGroupVersionKind(workloadGVK)
+					if err := r.Get(ctx, client.ObjectKey{Namespace: cm.Namespace, Name: workloadName}, currentWl); err != nil {
+						return err
+					}
+
+					admission, found, _ := unstructured.NestedMap(currentWl.Object, "status", "admission")
+					if !found || admission == nil {
+						return nil
+					}
+
+					psas, found, _ := unstructured.NestedSlice(admission, "podSetAssignments")
+					if !found || len(psas) == 0 {
+						return nil
+					}
+
+					wlModified := false
+					for pi, psaRaw := range psas {
+						psa, ok := psaRaw.(map[string]interface{})
+						if !ok {
+							continue
+						}
+						psaName, _ := psa["name"].(string)
+
+						for cGroupName, counts := range contractedGroups {
+							if strings.EqualFold(psaName, cGroupName) {
+								curCount, ok := getInt64(psa["count"])
+								if !ok || curCount <= 0 {
+									curCount = counts.oldCount
+								}
+								newCount := counts.newCount
+
+								if curCount > newCount {
+									logger.Info("contracting workload admission podSetAssignment count and quota",
+										"workload", workloadName, "podSet", psaName, "old", curCount, "new", newCount)
+
+									// Scale resourceUsage proportionally
+									ru, ruFound, _ := unstructured.NestedMap(psa, "resourceUsage")
+									if ruFound && ru != nil {
+										for resKey, resVal := range ru {
+											resStr := fmt.Sprintf("%v", resVal)
+											if q, err := resource.ParseQuantity(resStr); err == nil {
+												milliVal := q.MilliValue()
+												newMilliVal := (milliVal * newCount) / curCount
+												q.SetMilli(newMilliVal)
+												ru[resKey] = q.String()
+											}
+										}
+										psa["resourceUsage"] = ru
+									}
+
+									psa["count"] = newCount
+									psas[pi] = psa
+									wlModified = true
+								}
+								break
+							}
+						}
+					}
+
+					if wlModified {
+						_ = unstructured.SetNestedSlice(currentWl.Object, psas, "status", "admission", "podSetAssignments")
+
+						// Set Preempted status condition
+						condList, _, _ := unstructured.NestedSlice(currentWl.Object, "status", "conditions")
+						nowStr := time.Now().UTC().Format(time.RFC3339)
+						condFound := false
+						newCond := map[string]interface{}{
+							"type":               "Preempted",
+							"status":             "True",
+							"lastTransitionTime": nowStr,
+							"reason":             "SpotInterrupted",
+							"message":            fmt.Sprintf("Preempted %d replicas due to cloud spot interruption", interrupted),
+						}
+						for ci, c := range condList {
+							if cMap, ok := c.(map[string]interface{}); ok {
+								if cMap["type"] == "Preempted" {
+									condList[ci] = newCond
+									condFound = true
+									break
+								}
+							}
+						}
+						if !condFound {
+							condList = append(condList, newCond)
+						}
+						_ = unstructured.SetNestedSlice(currentWl.Object, condList, "status", "conditions")
+
+						return r.Status().Update(ctx, currentWl)
+					}
+					return nil
+				})
+			}
+		}
+	}
+
+	// Step 2: Update RayCluster spec with contracted replicas and scaleStrategy.
+	// Preserves original maxReplicas so self-healing elastic re-expansion is possible.
+	err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latestRc := &unstructured.Unstructured{}
+		latestRc.SetGroupVersionKind(rayClusterGVK)
+		if err := r.Get(ctx, client.ObjectKey{Namespace: cm.Namespace, Name: targetCluster}, latestRc); err != nil {
+			return err
+		}
+		wgsNow, found, _ := unstructured.NestedSlice(latestRc.Object, "spec", "workerGroupSpecs")
+		if !found || len(wgsNow) == 0 {
+			return nil
+		}
+		rcModified := false
+		for i, wg := range wgsNow {
+			wgMap, ok := wg.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			curGroupName, _ := wgMap["groupName"].(string)
+			if counts, ok := contractedGroups[curGroupName]; ok {
+				logger.Info("contracting workerGroup replicas to match surviving capacity",
+					"cluster", targetCluster, "group", curGroupName, "old", counts.oldCount, "new", counts.newCount)
+				wgMap["replicas"] = counts.newCount
+
+				if targetPod != "" {
+					strategy, _, _ := unstructured.NestedMap(wgMap, "scaleStrategy")
+					if strategy == nil {
+						strategy = map[string]interface{}{}
+					}
+					toDelete, _, _ := unstructured.NestedStringSlice(strategy, "workersToDelete")
+					toDelete = append(toDelete, targetPod)
+					strategy["workersToDelete"] = toDelete
+					wgMap["scaleStrategy"] = strategy
+				}
+
+				wgsNow[i] = wgMap
+				rcModified = true
+			}
+		}
+		if rcModified {
+			_ = unstructured.SetNestedSlice(latestRc.Object, wgsNow, "spec", "workerGroupSpecs")
+			return r.Update(ctx, latestRc)
+		}
+		return nil
+	})
+
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+
+	// Step 3: Mark processed for idempotency
+	_ = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latestCm := &corev1.ConfigMap{}
+		if err := r.Get(ctx, req.NamespacedName, latestCm); err != nil {
+			return err
+		}
+		ann := latestCm.GetAnnotations()
+		if ann == nil {
+			ann = map[string]string{}
+		}
+		ann[AnnotationProcessed] = "true"
+		latestCm.SetAnnotations(ann)
+		return r.Update(ctx, latestCm)
+	})
+
+	return ctrl.Result{}, nil
+}
+
+func (r *SpotInterruptionReconciler) SetupWithManager(mgr ctrl.Manager) error {
+	return ctrl.NewControllerManagedBy(mgr).
+		Named("spotinterruption").
+		For(&corev1.ConfigMap{}).
+		Complete(r)
+}
