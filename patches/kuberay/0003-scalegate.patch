diff --git a/ray-operator/controllers/ray/scalegate_controller.go b/ray-operator/controllers/ray/scalegate_controller.go
new file mode 100644
index 0000000..4886245
--- /dev/null
+++ b/ray-operator/controllers/ray/scalegate_controller.go
@@ -0,0 +1,496 @@
+package ray
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"strings"
+
+	"k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/api/meta"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/util/retry"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+// unlimitedQuota marks a quota that this ClusterQueue alone does not bound.
+const unlimitedQuota = int64(math.MaxInt64)
+
+// kueueVersions lists the Kueue API versions ScaleGate reads, newest first.
+var kueueVersions = []string{"v1beta2", "v1beta1"}
+
+// ScaleGateReconciler caps the replicas and maxReplicas of each worker group of a Kueue-queued RayCluster at the
+// most workers its ClusterQueue could ever hold, so the Ray autoscaler cannot request pods Kueue can never admit.
+type ScaleGateReconciler struct {
+	client.Client
+	Scheme *runtime.Scheme
+}
+
+// flavorQuota maps each resource a flavor offers to the most of it one ClusterQueue can use on that flavor.
+type flavorQuota map[string]int64
+
+// resourceGroupQuota is one ClusterQueue resource group: a set of resources and the flavors that offer them.
+type resourceGroupQuota struct {
+	covered map[string]bool
+	flavors []flavorQuota
+}
+
+// clusterQueueQuota is the most of each resource a ClusterQueue can use, per resource group and flavor.
+type clusterQueueQuota struct {
+	groups []resourceGroupQuota
+}
+
+// maxWorkers returns how many workers needing unit fit in the quota, and false when the quota does not bound them.
+// Resource groups hold different resources, so every group a worker needs must fit it: the bound is the minimum
+// over groups. Kueue may place the worker on any flavor of a group, so a group fits as many workers as its
+// largest flavor: the bound within a group is the maximum over flavors.
+func (q clusterQueueQuota) maxWorkers(unit map[string]int64) (int64, bool) {
+	bound := unlimitedQuota
+	for _, group := range q.groups {
+		var needed []string
+		for res, amount := range unit {
+			if amount > 0 && group.covered[res] {
+				needed = append(needed, res)
+			}
+		}
+		if len(needed) == 0 {
+			continue
+		}
+		best := int64(0)
+		for _, flavor := range group.flavors {
+			fit := unlimitedQuota
+			for _, res := range needed {
+				limit, ok := flavor[res]
+				if !ok {
+					fit = 0
+					break
+				}
+				if limit != unlimitedQuota {
+					fit = min(fit, limit/unit[res])
+				}
+			}
+			best = max(best, fit)
+		}
+		bound = min(bound, best)
+	}
+	if bound == unlimitedQuota {
+		return 0, false
+	}
+	return bound, true
+}
+
+// workerGroupTarget returns the most replicas a worker group may keep under a quota bound. The target never drops below the count Kueue admitted for the group, since Kueue's admission is the authority
+// on what fits, nor below minReplicas, since a smaller maxReplicas makes the operator reject the spec.
+func workerGroupTarget(quotaBound int64, admitted int64, minReplicas int64) int64 {
+	return max(quotaBound, admitted, minReplicas)
+}
+
+func (r *ScaleGateReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	rc := &unstructured.Unstructured{}
+	rc.SetGroupVersionKind(rayClusterGVK)
+	if err := r.Get(ctx, req.NamespacedName, rc); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	queueName := rc.GetLabels()["kueue.x-k8s.io/queue-name"]
+	if queueName == "" {
+		return ctrl.Result{}, nil
+	}
+	if wgs, found, err := unstructured.NestedSlice(rc.Object, "spec", "workerGroupSpecs"); !found || err != nil || len(wgs) == 0 {
+		return ctrl.Result{}, nil
+	}
+
+	quota, err := r.resolveQuota(ctx, rc.GetNamespace(), queueName)
+	if err != nil {
+		logger.V(2).Info("could not resolve Kueue quota for queue", "queue", queueName, "error", err)
+		return ctrl.Result{}, nil
+	}
+	admitted, err := r.admittedWorkerCounts(ctx, rc)
+	if err != nil {
+		logger.V(2).Info("could not read the Kueue admission of the RayCluster", "cluster", rc.GetName(), "error", err)
+		return ctrl.Result{}, nil
+	}
+
+	clamped := false
+	err = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latest := &unstructured.Unstructured{}
+		latest.SetGroupVersionKind(rayClusterGVK)
+		if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+			return err
+		}
+		wgs, _, _ := unstructured.NestedSlice(latest.Object, "spec", "workerGroupSpecs")
+		changed := false
+		for i, wg := range wgs {
+			wgMap, ok := wg.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			bound, ok := quota.maxWorkers(extractWorkerUnitResources(wgMap))
+			if !ok {
+				continue
+			}
+			groupName, _ := wgMap["groupName"].(string)
+			minReplicas, _ := getInt64(wgMap["minReplicas"])
+			target := workerGroupTarget(bound, admitted[strings.ToLower(groupName)], minReplicas)
+			if maxReplicas, _ := getInt64(wgMap["maxReplicas"]); maxReplicas > target {
+				logger.Info("clamping RayCluster maxReplicas to Kueue quota",
+					"cluster", latest.GetName(), "group", groupName, "requestedMax", maxReplicas, "clamped", target)
+				wgMap["maxReplicas"] = target
+				changed = true
+			}
+			if replicas, _ := getInt64(wgMap["replicas"]); replicas > target {
+				logger.Info("clamping RayCluster replicas to Kueue quota",
+					"cluster", latest.GetName(), "group", groupName, "requestedReplicas", replicas, "clamped", target)
+				wgMap["replicas"] = target
+				changed = true
+			}
+			wgs[i] = wgMap
+		}
+		if !changed {
+			return nil
+		}
+		if err := unstructured.SetNestedSlice(latest.Object, wgs, "spec", "workerGroupSpecs"); err != nil {
+			return err
+		}
+		if err := r.Update(ctx, latest); err != nil {
+			return err
+		}
+		clamped = true
+		return nil
+	})
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+	if !clamped {
+		return ctrl.Result{}, nil
+	}
+
+	_ = retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		latest := &unstructured.Unstructured{}
+		latest.SetGroupVersionKind(rayClusterGVK)
+		if err := r.Get(ctx, req.NamespacedName, latest); err != nil {
+			return err
+		}
+		conditions, _, _ := unstructured.NestedSlice(latest.Object, "status", "conditions")
+		filteredConditions := []interface{}{}
+		for _, cond := range conditions {
+			if cMap, ok := cond.(map[string]interface{}); ok {
+				if cMap["type"] != "ScaleGateClamped" {
+					filteredConditions = append(filteredConditions, cond)
+				}
+			}
+		}
+		filteredConditions = append(filteredConditions, map[string]interface{}{
+			"type":               "ScaleGateClamped",
+			"status":             "True",
+			"reason":             "KueueQuotaCapped",
+			"message":            "Worker replicas and maxReplicas clamped to available Kueue ClusterQueue quota",
+			"lastTransitionTime": metav1.Now().UTC().Format("2006-01-02T15:04:05Z"),
+		})
+		_ = unstructured.SetNestedSlice(latest.Object, filteredConditions, "status", "conditions")
+		return r.Status().Update(ctx, latest)
+	})
+
+	return ctrl.Result{}, nil
+}
+
+// extractWorkerUnitResources returns the resources one worker pod requests, in the units parseResourceValue uses,
+// plus one "pods", which Kueue counts per pod when a ClusterQueue covers it.
+func extractWorkerUnitResources(wgMap map[string]interface{}) map[string]int64 {
+	unit := map[string]int64{"pods": 1}
+	containers, _, _ := unstructured.NestedSlice(wgMap, "template", "spec", "containers")
+	for _, c := range containers {
+		cMap, ok := c.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		reqs, _, _ := unstructured.NestedMap(cMap, "resources", "requests")
+		for resName, val := range reqs {
+			if amount := parseResourceValue(resName, val); amount > 0 {
+				unit[resName] += amount
+			}
+		}
+	}
+	return unit
+}
+
+// parseResourceValue returns a quantity in millicores for cpu and in whole units for every other resource.
+func parseResourceValue(resName string, raw interface{}) int64 {
+	if raw == nil {
+		return 0
+	}
+	q, err := resource.ParseQuantity(fmt.Sprint(raw))
+	if err != nil {
+		return 0
+	}
+	if resName == "cpu" {
+		return q.MilliValue()
+	}
+	return q.Value()
+}
+
+// getKueueObject reads a Kueue object at the newest API version the cluster serves.
+func (r *ScaleGateReconciler) getKueueObject(ctx context.Context, kind string, key client.ObjectKey) (*unstructured.Unstructured, error) {
+	var lastErr error
+	for _, v := range kueueVersions {
+		obj := &unstructured.Unstructured{}
+		obj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: v, Kind: kind})
+		if lastErr = r.Get(ctx, key, obj); lastErr == nil {
+			return obj, nil
+		}
+		if !meta.IsNoMatchError(lastErr) {
+			return nil, lastErr
+		}
+	}
+	return nil, lastErr
+}
+
+// listKueueObjects lists Kueue objects at the newest API version the cluster serves.
+func (r *ScaleGateReconciler) listKueueObjects(ctx context.Context, kind string, opts ...client.ListOption) ([]unstructured.Unstructured, error) {
+	var lastErr error
+	for _, v := range kueueVersions {
+		list := &unstructured.UnstructuredList{}
+		list.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: v, Kind: kind + "List"})
+		if lastErr = r.List(ctx, list, opts...); lastErr == nil {
+			return list.Items, nil
+		}
+		if !meta.IsNoMatchError(lastErr) {
+			return nil, lastErr
+		}
+	}
+	return nil, lastErr
+}
+
+// resolveClusterQueue returns the ClusterQueue that queueName names, either directly or through a LocalQueue.
+func (r *ScaleGateReconciler) resolveClusterQueue(ctx context.Context, namespace, queueName string) (*unstructured.Unstructured, error) {
+	if cq, err := r.getKueueObject(ctx, "ClusterQueue", client.ObjectKey{Name: queueName}); err == nil {
+		return cq, nil
+	}
+	lq, err := r.getKueueObject(ctx, "LocalQueue", client.ObjectKey{Namespace: namespace, Name: queueName})
+	if err != nil {
+		return nil, fmt.Errorf("cluster queue not found for queue %s: %w", queueName, err)
+	}
+	target, _, _ := unstructured.NestedString(lq.Object, "spec", "clusterQueue")
+	if target == "" {
+		return nil, fmt.Errorf("local queue %s names no cluster queue", queueName)
+	}
+	return r.getKueueObject(ctx, "ClusterQueue", client.ObjectKey{Name: target})
+}
+
+// resolveQuota returns the most of each resource the ClusterQueue behind queueName can use on each flavor.
+func (r *ScaleGateReconciler) resolveQuota(ctx context.Context, namespace, queueName string) (clusterQueueQuota, error) {
+	cq, err := r.resolveClusterQueue(ctx, namespace, queueName)
+	if err != nil {
+		return clusterQueueQuota{}, err
+	}
+	var supply map[string]map[string]int64
+	if cohort := cohortOf(cq); cohort != "" {
+		clusterQueues, err := r.listKueueObjects(ctx, "ClusterQueue")
+		if err != nil {
+			return clusterQueueQuota{}, err
+		}
+		cohorts, err := r.listKueueObjects(ctx, "Cohort")
+		if err != nil && !meta.IsNoMatchError(err) {
+			return clusterQueueQuota{}, err
+		}
+		supply = cohortTreeSupply(cohort, clusterQueues, cohorts)
+	}
+	return buildClusterQueueQuota(cq, supply)
+}
+
+// cohortOf returns the cohort a ClusterQueue belongs to, or "" when it cannot borrow.
+func cohortOf(cq *unstructured.Unstructured) string {
+	if cohort, _, _ := unstructured.NestedString(cq.Object, "spec", "cohortName"); cohort != "" {
+		return cohort
+	}
+	cohort, _, _ := unstructured.NestedString(cq.Object, "spec", "cohort")
+	return cohort
+}
+
+// cohortTreeSupply sums the nominal quota per flavor and resource of every ClusterQueue and Cohort in the cohort
+// tree that contains cohort. Nothing in the tree can use more than that sum, so it bounds borrowing from above
+// however the cohorts nest, ignoring the lending and borrowing limits that may lower the real ceiling.
+func cohortTreeSupply(cohort string, clusterQueues, cohorts []unstructured.Unstructured) map[string]map[string]int64 {
+	parents := map[string]string{}
+	for i := range cohorts {
+		parent, _, _ := unstructured.NestedString(cohorts[i].Object, "spec", "parentName")
+		if parent == "" {
+			parent, _, _ = unstructured.NestedString(cohorts[i].Object, "spec", "parent")
+		}
+		parents[cohorts[i].GetName()] = parent
+	}
+	root := func(name string) string {
+		seen := map[string]bool{}
+		for parents[name] != "" && !seen[name] {
+			seen[name] = true
+			name = parents[name]
+		}
+		return name
+	}
+	treeRoot := root(cohort)
+
+	supply := map[string]map[string]int64{}
+	add := func(obj *unstructured.Unstructured) {
+		rGroups, _, _ := unstructured.NestedSlice(obj.Object, "spec", "resourceGroups")
+		forEachFlavorResource(rGroups, func(flavor, res string, resMap map[string]interface{}) {
+			if supply[flavor] == nil {
+				supply[flavor] = map[string]int64{}
+			}
+			supply[flavor][res] += parseResourceValue(res, resMap["nominalQuota"])
+		})
+	}
+	for i := range clusterQueues {
+		if c := cohortOf(&clusterQueues[i]); c != "" && root(c) == treeRoot {
+			add(&clusterQueues[i])
+		}
+	}
+	for i := range cohorts {
+		if root(cohorts[i].GetName()) == treeRoot {
+			add(&cohorts[i])
+		}
+	}
+	return supply
+}
+
+// forEachFlavorResource calls fn for every resource of every flavor in rGroups, a spec.resourceGroups list.
+func forEachFlavorResource(rGroups []interface{}, fn func(flavor, res string, resMap map[string]interface{})) {
+	for _, rg := range rGroups {
+		rgMap, ok := rg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		flavors, _, _ := unstructured.NestedSlice(rgMap, "flavors")
+		for _, fl := range flavors {
+			flMap, ok := fl.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			flavorName, _ := flMap["name"].(string)
+			resources, _, _ := unstructured.NestedSlice(flMap, "resources")
+			for _, res := range resources {
+				if resMap, ok := res.(map[string]interface{}); ok {
+					resName, _ := resMap["name"].(string)
+					fn(flavorName, resName, resMap)
+				}
+			}
+		}
+	}
+}
+
+// buildClusterQueueQuota computes the most of each resource the ClusterQueue can use on each flavor: its nominal
+// quota without a cohort, and with one the cohort tree's supply, lowered to nominal plus borrowingLimit when the
+// ClusterQueue sets a borrowingLimit. A missing borrowingLimit means unlimited borrowing in Kueue, so only the
+// supply of the cohort tree bounds it.
+func buildClusterQueueQuota(cq *unstructured.Unstructured, supply map[string]map[string]int64) (clusterQueueQuota, error) {
+	rGroups, found, _ := unstructured.NestedSlice(cq.Object, "spec", "resourceGroups")
+	if !found || len(rGroups) == 0 {
+		return clusterQueueQuota{}, fmt.Errorf("no resource groups found in cluster queue %s", cq.GetName())
+	}
+	hasCohort := cohortOf(cq) != ""
+	quota := clusterQueueQuota{}
+	for _, rg := range rGroups {
+		rgMap, ok := rg.(map[string]interface{})
+		if !ok {
+			continue
+		}
+		group := resourceGroupQuota{covered: map[string]bool{}}
+		covered, _, _ := unstructured.NestedStringSlice(rgMap, "coveredResources")
+		for _, res := range covered {
+			group.covered[res] = true
+		}
+		flavorIndex := map[string]int{}
+		forEachFlavorResource([]interface{}{rgMap}, func(flavor, res string, resMap map[string]interface{}) {
+			idx, ok := flavorIndex[flavor]
+			if !ok {
+				idx = len(group.flavors)
+				flavorIndex[flavor] = idx
+				group.flavors = append(group.flavors, flavorQuota{})
+			}
+			group.covered[res] = true
+			nominal := parseResourceValue(res, resMap["nominalQuota"])
+			limit := nominal
+			if hasCohort {
+				limit = max(supply[flavor][res], nominal)
+				if resMap["borrowingLimit"] != nil {
+					limit = min(limit, nominal+parseResourceValue(res, resMap["borrowingLimit"]))
+				}
+			}
+			group.flavors[idx][res] = limit
+		})
+		quota.groups = append(quota.groups, group)
+	}
+	return quota, nil
+}
+
+// admittedWorkerCounts returns, by lowercased pod set name, the pod counts Kueue admitted for the Workload of the
+// RayCluster or of the RayJob that owns it; the map is empty when that Workload is not admitted.
+func (r *ScaleGateReconciler) admittedWorkerCounts(ctx context.Context, rc *unstructured.Unstructured) (map[string]int64, error) {
+	owners := map[types.UID]bool{rc.GetUID(): true}
+	for _, ref := range rc.GetOwnerReferences() {
+		if ref.Kind == "RayJob" {
+			owners[ref.UID] = true
+		}
+	}
+	workloads, err := r.listKueueObjects(ctx, "Workload", client.InNamespace(rc.GetNamespace()))
+	if err != nil {
+		return nil, err
+	}
+	counts := map[string]int64{}
+	for i := range workloads {
+		wl := &workloads[i]
+		owned := false
+		for _, ref := range wl.GetOwnerReferences() {
+			owned = owned || owners[ref.UID]
+		}
+		if !owned {
+			continue
+		}
+		assignments, found, _ := unstructured.NestedSlice(wl.Object, "status", "admission", "podSetAssignments")
+		if !found {
+			continue
+		}
+		specCounts := map[string]int64{}
+		podSets, _, _ := unstructured.NestedSlice(wl.Object, "spec", "podSets")
+		for _, ps := range podSets {
+			if psMap, ok := ps.(map[string]interface{}); ok {
+				name, _ := psMap["name"].(string)
+				specCounts[strings.ToLower(name)], _ = getInt64(psMap["count"])
+			}
+		}
+		for _, a := range assignments {
+			aMap, ok := a.(map[string]interface{})
+			if !ok {
+				continue
+			}
+			name, _ := aMap["name"].(string)
+			name = strings.ToLower(name)
+			count, ok := getInt64(aMap["count"])
+			if !ok {
+				count = specCounts[name]
+			}
+			counts[name] = max(counts[name], count)
+		}
+	}
+	return counts, nil
+}
+
+func (r *ScaleGateReconciler) SetupWithManager(mgr ctrl.Manager) error {
+	rc := &unstructured.Unstructured{}
+	rc.SetGroupVersionKind(rayClusterGVK)
+	return ctrl.NewControllerManagedBy(mgr).
+		Named("scalegate").
+		For(rc).
+		Complete(r)
+}
