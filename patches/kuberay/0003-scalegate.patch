@@ -0,0 +1,305 @@
+package ray
+
+import (
+	"context"
+	"testing"
+
+	"k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	clientFake "sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+)
+
+// Tests for the ScaleGate quota bound: flavor and resource group combination, cohort borrowing, Kueue admission,
+// and the minReplicas floor that keeps the clamped spec valid.
+
+type sgFlavor struct {
+	name      string
+	resources []map[string]interface{}
+}
+
+func sgResource(name string, nominal interface{}, borrowingLimit ...interface{}) map[string]interface{} {
+	res := map[string]interface{}{"name": name, "nominalQuota": nominal}
+	if len(borrowingLimit) > 0 {
+		res["borrowingLimit"] = borrowingLimit[0]
+	}
+	return res
+}
+
+func sgResourceGroups(groups ...[]sgFlavor) []interface{} {
+	out := []interface{}{}
+	for _, flavors := range groups {
+		covered := []interface{}{}
+		seen := map[string]bool{}
+		fls := []interface{}{}
+		for _, fl := range flavors {
+			resources := []interface{}{}
+			for _, res := range fl.resources {
+				resources = append(resources, res)
+				if name := res["name"].(string); !seen[name] {
+					seen[name] = true
+					covered = append(covered, name)
+				}
+			}
+			fls = append(fls, map[string]interface{}{"name": fl.name, "resources": resources})
+		}
+		out = append(out, map[string]interface{}{"coveredResources": covered, "flavors": fls})
+	}
+	return out
+}
+
+func sgKueueObject(kind, name, namespace string, spec map[string]interface{}) *unstructured.Unstructured {
+	obj := &unstructured.Unstructured{Object: map[string]interface{}{"spec": spec}}
+	obj.SetGroupVersionKind(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: kind})
+	obj.SetName(name)
+	obj.SetNamespace(namespace)
+	return obj
+}
+
+func sgClusterQueue(name, cohort string, groups []interface{}) *unstructured.Unstructured {
+	spec := map[string]interface{}{"resourceGroups": groups}
+	if cohort != "" {
+		spec["cohortName"] = cohort
+	}
+	return sgKueueObject("ClusterQueue", name, "", spec)
+}
+
+func sgRayCluster(queue string, replicas, minReplicas, maxReplicas int64) *unstructured.Unstructured {
+	rc := &unstructured.Unstructured{Object: map[string]interface{}{
+		"spec": map[string]interface{}{
+			"workerGroupSpecs": []interface{}{map[string]interface{}{
+				"groupName":   "gpu-workers",
+				"replicas":    replicas,
+				"minReplicas": minReplicas,
+				"maxReplicas": maxReplicas,
+				"template": map[string]interface{}{"spec": map[string]interface{}{"containers": []interface{}{
+					map[string]interface{}{"name": "ray-worker", "resources": map[string]interface{}{
+						"requests": map[string]interface{}{"cpu": "4", "nvidia.com/gpu": "1"},
+					}},
+				}}},
+			}},
+		},
+	}}
+	rc.SetGroupVersionKind(rayClusterGVK)
+	rc.SetName("gang")
+	rc.SetNamespace("default")
+	rc.SetUID(types.UID("raycluster-uid"))
+	rc.SetLabels(map[string]string{"kueue.x-k8s.io/queue-name": queue})
+	return rc
+}
+
+func sgAdmittedWorkload(count int64) *unstructured.Unstructured {
+	wl := sgKueueObject("Workload", "raycluster-gang", "default", map[string]interface{}{
+		"podSets": []interface{}{
+			map[string]interface{}{"name": "head", "count": int64(1)},
+			map[string]interface{}{"name": "gpu-workers", "count": count},
+		},
+	})
+	wl.Object["status"] = map[string]interface{}{"admission": map[string]interface{}{
+		"clusterQueue": "team-queue",
+		"podSetAssignments": []interface{}{
+			map[string]interface{}{"name": "head", "count": int64(1)},
+			map[string]interface{}{"name": "gpu-workers", "count": count},
+		},
+	}}
+	wl.SetOwnerReferences([]metav1.OwnerReference{{APIVersion: "ray.io/v1", Kind: "RayCluster", Name: "gang", UID: "raycluster-uid"}})
+	return wl
+}
+
+func sgReconcile(t *testing.T, objs ...client.Object) (*unstructured.Unstructured, bool) {
+	t.Helper()
+	mapper := meta.NewDefaultRESTMapper(nil)
+	mapper.Add(rayClusterGVK, meta.RESTScopeNamespace)
+	for _, kind := range []string{"ClusterQueue", "Cohort"} {
+		mapper.Add(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: kind}, meta.RESTScopeRoot)
+	}
+	for _, kind := range []string{"LocalQueue", "Workload"} {
+		mapper.Add(schema.GroupVersionKind{Group: "kueue.x-k8s.io", Version: "v1beta2", Kind: kind}, meta.RESTScopeNamespace)
+	}
+	scheme := runtime.NewScheme()
+	if err := rayv1.AddToScheme(scheme); err != nil {
+		t.Fatalf("AddToScheme: %v", err)
+	}
+	fakeClient := clientFake.NewClientBuilder().
+		WithScheme(scheme).
+		WithStatusSubresource(&rayv1.RayCluster{}).
+		WithRESTMapper(mapper).
+		WithObjects(objs...).
+		Build()
+	r := &ScaleGateReconciler{Client: fakeClient}
+	key := types.NamespacedName{Namespace: "default", Name: "gang"}
+	if _, err := r.Reconcile(context.Background(), ctrl.Request{NamespacedName: key}); err != nil {
+		t.Fatalf("Reconcile returned an error: %v", err)
+	}
+	got := &unstructured.Unstructured{}
+	got.SetGroupVersionKind(rayClusterGVK)
+	if err := fakeClient.Get(context.Background(), key, got); err != nil {
+		t.Fatalf("Get RayCluster: %v", err)
+	}
+	conditions, _, _ := unstructured.NestedSlice(got.Object, "status", "conditions")
+	clamped := false
+	for _, c := range conditions {
+		clamped = clamped || c.(map[string]interface{})["type"] == "ScaleGateClamped"
+	}
+	return got, clamped
+}
+
+func sgWorkerCounts(t *testing.T, rc *unstructured.Unstructured) (replicas, minReplicas, maxReplicas int64) {
+	t.Helper()
+	wgs, _, _ := unstructured.NestedSlice(rc.Object, "spec", "workerGroupSpecs")
+	wg := wgs[0].(map[string]interface{})
+	replicas, _ = getInt64(wg["replicas"])
+	minReplicas, _ = getInt64(wg["minReplicas"])
+	maxReplicas, _ = getInt64(wg["maxReplicas"])
+	return replicas, minReplicas, maxReplicas
+}
+
+// A fixed-size gang admitted on a flavor that has no nominal GPUs and borrows from the cohort without a
+// borrowingLimit keeps its size, even though another flavor of the ClusterQueue holds only 2 GPUs.
+func TestScaleGateKeepsAdmittedGangOnBorrowOnlyFlavor(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "shared", sgResourceGroups([]sgFlavor{
+		{name: "reserved", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "2")}},
+		{name: "borrowed", resources: []map[string]interface{}{sgResource("cpu", "0"), sgResource("nvidia.com/gpu", "0")}},
+	}))
+	lender := sgClusterQueue("lender-queue", "shared", sgResourceGroups([]sgFlavor{
+		{name: "borrowed", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "64")}},
+	}))
+	rc, clamped := sgReconcile(t, queue, lender, sgRayCluster("team-queue", 50, 50, 50), sgAdmittedWorkload(50))
+	if replicas, minReplicas, maxReplicas := sgWorkerCounts(t, rc); replicas != 50 || minReplicas != 50 || maxReplicas != 50 {
+		t.Errorf("worker group = replicas %d, min %d, max %d; want 50, 50, 50", replicas, minReplicas, maxReplicas)
+	}
+	if clamped {
+		t.Errorf("ScaleGateClamped condition set on a gang Kueue admitted")
+	}
+}
+
+// Borrowing without a borrowingLimit is bounded by the supply of the whole cohort tree, including parent cohorts.
+func TestScaleGateBoundsUnlimitedBorrowingByCohortTree(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "shared", sgResourceGroups([]sgFlavor{
+		{name: "reserved", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "2")}},
+		{name: "borrowed", resources: []map[string]interface{}{sgResource("cpu", "0"), sgResource("nvidia.com/gpu", "0")}},
+	}))
+	cohort := sgKueueObject("Cohort", "shared", "", map[string]interface{}{"parentName": "org"})
+	parent := sgKueueObject("Cohort", "org", "", map[string]interface{}{"resourceGroups": sgResourceGroups([]sgFlavor{
+		{name: "borrowed", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "40")}},
+	})})
+	rc, clamped := sgReconcile(t, queue, cohort, parent, sgRayCluster("team-queue", 32, 1, 64))
+	if replicas, _, maxReplicas := sgWorkerCounts(t, rc); replicas != 32 || maxReplicas != 40 || !clamped {
+		t.Errorf("worker group = replicas %d, max %d, clamped %v; want 32, 40 (the parent cohort's supply), true", replicas, maxReplicas, clamped)
+	}
+}
+
+// Kueue's admission is the authority: a RayJob's gang admitted at 50 workers keeps them even when the quota
+// ScaleGate can see holds only 2.
+func TestScaleGateNeverClampsBelowAdmittedCount(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "shared", sgResourceGroups([]sgFlavor{
+		{name: "reserved", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "2")}},
+	}))
+	job := []metav1.OwnerReference{{APIVersion: "ray.io/v1", Kind: "RayJob", Name: "gang-job", UID: "rayjob-uid"}}
+	rc := sgRayCluster("team-queue", 50, 50, 50)
+	rc.SetOwnerReferences(job)
+	wl := sgAdmittedWorkload(50)
+	wl.SetOwnerReferences(job)
+	got, clamped := sgReconcile(t, queue, rc, wl)
+	if replicas, minReplicas, maxReplicas := sgWorkerCounts(t, got); replicas != 50 || minReplicas != 50 || maxReplicas != 50 || clamped {
+		t.Errorf("worker group = replicas %d, min %d, max %d, clamped %v; want 50, 50, 50, false", replicas, minReplicas, maxReplicas, clamped)
+	}
+
+	rc = sgRayCluster("team-queue", 50, 1, 50)
+	rc.SetOwnerReferences(job)
+	got, _ = sgReconcile(t, queue, rc, wl)
+	if replicas, _, maxReplicas := sgWorkerCounts(t, got); replicas != 50 || maxReplicas != 50 {
+		t.Errorf("worker group = replicas %d, max %d; want 50, 50 (the admitted count)", replicas, maxReplicas)
+	}
+}
+
+// A real borrowingLimit still bounds the group at nominal quota plus borrowingLimit.
+func TestScaleGateClampsToBorrowingLimit(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "shared", sgResourceGroups([]sgFlavor{
+		{name: "spot", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "4", "4")}},
+	}))
+	lender := sgClusterQueue("lender-queue", "shared", sgResourceGroups([]sgFlavor{
+		{name: "spot", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "64")}},
+	}))
+	rc, clamped := sgReconcile(t, queue, lender, sgRayCluster("team-queue", 16, 1, 32))
+	if replicas, minReplicas, maxReplicas := sgWorkerCounts(t, rc); replicas != 8 || minReplicas != 1 || maxReplicas != 8 {
+		t.Errorf("worker group = replicas %d, min %d, max %d; want 8, 1, 8", replicas, minReplicas, maxReplicas)
+	}
+	if !clamped {
+		t.Errorf("ScaleGateClamped condition missing after clamping")
+	}
+}
+
+// Clamping stops at minReplicas, so the operator never sees a worker group whose minReplicas exceeds maxReplicas.
+func TestScaleGateNeverClampsBelowMinReplicas(t *testing.T) {
+	queue := sgClusterQueue("team-queue", "", sgResourceGroups([]sgFlavor{
+		{name: "on-demand", resources: []map[string]interface{}{sgResource("cpu", "1000"), sgResource("nvidia.com/gpu", "4")}},
+	}))
+	rc, _ := sgReconcile(t, queue, sgRayCluster("team-queue", 10, 6, 10))
+	replicas, minReplicas, maxReplicas := sgWorkerCounts(t, rc)
+	if minReplicas > maxReplicas {
+		t.Fatalf("minReplicas %d exceeds maxReplicas %d", minReplicas, maxReplicas)
+	}
+	if replicas != 6 || minReplicas != 6 || maxReplicas != 6 {
+		t.Errorf("worker group = replicas %d, min %d, max %d; want 6, 6, 6", replicas, minReplicas, maxReplicas)
+	}
+}
+
+func TestClusterQueueQuotaMaxWorkers(t *testing.T) {
+	unit := map[string]int64{"pods": 1, "cpu": 2000, "nvidia.com/gpu": 1}
+	cpuGroup := resourceGroupQuota{covered: map[string]bool{"cpu": true}, flavors: []flavorQuota{{"cpu": 100000}}}
+	tests := []struct {
+		name      string
+		quota     clusterQueueQuota
+		want      int64
+		wantBound bool
+	}{
+		{
+			name: "largest flavor of a group bounds it",
+			quota: clusterQueueQuota{groups: []resourceGroupQuota{cpuGroup, {
+				covered: map[string]bool{"nvidia.com/gpu": true},
+				flavors: []flavorQuota{{"nvidia.com/gpu": 2}, {"nvidia.com/gpu": 0}, {"nvidia.com/gpu": 12}},
+			}}},
+			want: 12, wantBound: true,
+		},
+		{
+			name: "smallest group bounds the worker",
+			quota: clusterQueueQuota{groups: []resourceGroupQuota{cpuGroup, {
+				covered: map[string]bool{"nvidia.com/gpu": true},
+				flavors: []flavorQuota{{"nvidia.com/gpu": 3}},
+			}}},
+			want: 3, wantBound: true,
+		},
+		{
+			name: "an unlimited flavor leaves the worker unbounded",
+			quota: clusterQueueQuota{groups: []resourceGroupQuota{{
+				covered: map[string]bool{"nvidia.com/gpu": true},
+				flavors: []flavorQuota{{"nvidia.com/gpu": 2}, {"nvidia.com/gpu": unlimitedQuota}},
+			}}},
+			wantBound: false,
+		},
+		{
+			name: "groups the worker does not use do not bound it",
+			quota: clusterQueueQuota{groups: []resourceGroupQuota{cpuGroup, {
+				covered: map[string]bool{"example.com/fpga": true},
+				flavors: []flavorQuota{{"example.com/fpga": 0}},
+			}}},
+			want: 50, wantBound: true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, bound := tc.quota.maxWorkers(unit)
+			if bound != tc.wantBound || (bound && got != tc.want) {
+				t.Errorf("maxWorkers = %d, %v; want %d, %v", got, bound, tc.want, tc.wantBound)
+			}
+		})
+	}
+}
