+func TestSlowStartBatchRunsDoublingConcurrentBatches(t *testing.T) {
+	const count = 50
+	started := make(chan int, count)
+	release := make(chan struct{})
+	var successes int
+	var err error
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		successes, err = slowStartBatch(count, func(i int) error {
+			started <- i
+			<-release
+			return nil
+		})
+	}()
+
+	// Every call of a batch blocks until the test releases it, so receiving a whole batch proves its
+	// calls run concurrently, and no call of the next batch may start before the batch is released.
+	next := 0
+	for _, size := range []int{1, 2, 4, 8, 16, 19} {
+		batch := map[int]bool{}
+		for range size {
+			select {
+			case i := <-started:
+				batch[i] = true
+			case <-time.After(10 * time.Second):
+				t.Fatalf("batch starting at %d ran %d calls concurrently, want %d", next, len(batch), size)
+			}
+		}
+		select {
+		case i := <-started:
+			t.Fatalf("call %d started before the batch of %d calls starting at %d finished", i, size, next)
+		case <-time.After(50 * time.Millisecond):
+		}
+		for i := next; i < next+size; i++ {
+			assert.True(t, batch[i], "batch starting at %d did not call %d", next, i)
+		}
+		next += size
+		for range size {
+			release <- struct{}{}
+		}
+	}
+	<-done
+	require.NoError(t, err)
+	assert.Equal(t, count, successes)
+	assert.Empty(t, started, "calls beyond count")
+}
+
+func TestSlowStartBatchStopsAfterFailedBatch(t *testing.T) {
+	errFirst := errstd.New("first failure")
+	errSecond := errstd.New("second failure")
+	tests := []struct {
+		name          string
+		failures      map[int]error
+		wantSuccesses int
+		wantCalls     int
+	}{
+		{
+			// Batches are [0], [1 2], [3 4 5 6]: the third batch fails, so the fourth never starts.
+			name:          "one failure",
+			failures:      map[int]error{5: errFirst},
+			wantSuccesses: 6,
+			wantCalls:     7,
+		},
+		{
+			name:          "two failures in one batch",
+			failures:      map[int]error{4: errFirst, 6: errSecond},
+			wantSuccesses: 5,
+			wantCalls:     7,
+		},
+		{
+			name:          "failure in the first batch",
+			failures:      map[int]error{0: errFirst},
+			wantSuccesses: 0,
+			wantCalls:     1,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var calls atomic.Int32
+			successes, err := slowStartBatch(50, func(i int) error {
+				calls.Add(1)
+				return tc.failures[i]
+			})
+			require.Error(t, err)
+			for _, want := range tc.failures {
+				require.ErrorIs(t, err, want)
+			}
+			assert.Equal(t, tc.wantSuccesses, successes)
+			assert.Equal(t, int32(tc.wantCalls), calls.Load())
+		})
+	}
+}
+
+func TestSlowStartBatchWithZeroCount(t *testing.T) {
+	successes, err := slowStartBatch(0, func(int) error {
+		t.Fatal("fn called for count 0")
+		return nil
+	})
+	require.NoError(t, err)
+	assert.Equal(t, 0, successes)
+}
