+// TestSlowStartBatchReconcileCreatesWorkerGroup checks that one reconcile creates every missing worker
+// of a large group with concurrent creates, and that after a failed create the Pods already created
+// stay and the next reconcile creates only the rest.
+func TestSlowStartBatchReconcileCreatesWorkerGroup(t *testing.T) {
+	const replicas = 50
+	for _, multiHostIndexing := range []bool{false, true} {
+		t.Run(fmt.Sprintf("RayMultiHostIndexing=%t", multiHostIndexing), func(t *testing.T) {
+			setupTest(t)
+			features.SetFeatureGateDuringTest(t, features.RayMultiHostIndexing, multiHostIndexing)
+			cluster := testRayCluster.DeepCopy()
+			cluster.Spec.EnableInTreeAutoscaling = new(false)
+			cluster.Spec.WorkerGroupSpecs[0].Replicas = new(int32(replicas))
+			cluster.Spec.WorkerGroupSpecs[0].ScaleStrategy.WorkersToDelete = nil
+			headPod := testPods[0]
+
+			t.Run("one reconcile creates every worker", func(t *testing.T) {
+				var mu sync.Mutex
+				inFlight, maxInFlight := 0, 0
+				fakeClient := clientFake.NewClientBuilder().WithInterceptorFuncs(interceptor.Funcs{
+					Create: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.CreateOption) error {
+						mu.Lock()
+						inFlight++
+						maxInFlight = max(maxInFlight, inFlight)
+						mu.Unlock()
+						defer func() {
+							mu.Lock()
+							inFlight--
+							mu.Unlock()
+						}()
+						// Hold each create long enough that the calls of a batch overlap.
+						time.Sleep(10 * time.Millisecond)
+						return c.Create(ctx, obj, opts...)
+					},
+				}).WithRuntimeObjects(headPod.DeepCopyObject()).Build()
+				r := newSlowStartBatchTestReconciler(fakeClient, events.NewFakeRecorder(4*replicas))
+
+				require.NoError(t, r.reconcilePods(context.Background(), cluster))
+				assertWorkerPods(t, fakeClient, replicas, multiHostIndexing)
+				assert.Greater(t, maxInFlight, 1, "worker Pods were created one at a time")
+			})
+
+			t.Run("a failed create keeps created workers and the next reconcile creates the rest", func(t *testing.T) {
+				var creates atomic.Int32
+				errCreate := errstd.New("admission webhook denied the request")
+				fakeClient := clientFake.NewClientBuilder().WithInterceptorFuncs(interceptor.Funcs{
+					Create: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.CreateOption) error {
+						// Fail the 10th create, which runs in the fourth batch of 8 calls after 7 Pods exist.
+						if creates.Add(1) == 10 {
+							return errCreate
+						}
+						return c.Create(ctx, obj, opts...)
+					},
+				}).WithRuntimeObjects(headPod.DeepCopyObject()).Build()
+				recorder := events.NewFakeRecorder(4 * replicas)
+				r := newSlowStartBatchTestReconciler(fakeClient, recorder)
+
+				err := r.reconcilePods(context.Background(), cluster)
+				require.ErrorIs(t, err, utils.ErrFailedCreateWorkerPod)
+				require.ErrorIs(t, err, errCreate)
+				assertWorkerPods(t, fakeClient, 14, multiHostIndexing)
+				assert.Equal(t, int32(15), creates.Load(), "creates after the failed batch")
+				assert.Equal(t, 1, countEvents(recorder, string(utils.FailedToCreateWorkerPod)))
+
+				require.NoError(t, r.reconcilePods(context.Background(), cluster))
+				assertWorkerPods(t, fakeClient, replicas, multiHostIndexing)
+				assert.Equal(t, int32(15+replicas-14), creates.Load(), "the second reconcile created more than the missing Pods")
+			})
+		})
+	}
+}
+
+func newSlowStartBatchTestReconciler(c client.Client, recorder events.EventRecorder) *RayClusterReconciler {
+	return &RayClusterReconciler{
+		Client:                     c,
+		Recorder:                   recorder,
+		Scheme:                     scheme.Scheme,
+		rayClusterScaleExpectation: expectations.NewRayClusterScaleExpectation(c),
+	}
+}
+
+// assertWorkerPods checks the group has want worker Pods and, with RayMultiHostIndexing, that their
+// replica indices are distinct.
+func assertWorkerPods(t *testing.T, c client.Client, want int, multiHostIndexing bool) {
+	t.Helper()
+	pods := corev1.PodList{}
+	require.NoError(t, c.List(context.Background(), &pods, &client.ListOptions{LabelSelector: workerSelector, Namespace: namespaceStr}))
+	require.Len(t, pods.Items, want)
+	if !multiHostIndexing {
+		return
+	}
+	indices := map[int]bool{}
+	for _, pod := range pods.Items {
+		index, err := strconv.Atoi(pod.Labels[utils.RayWorkerReplicaIndexKey])
+		require.NoError(t, err, "Pod %s has no replica index", pod.Name)
+		assert.False(t, indices[index], "replica index %d is used twice", index)
+		indices[index] = true
+	}
+}
+
+func countEvents(recorder *events.FakeRecorder, reason string) int {
+	n := 0
+	for {
+		select {
+		case event := <-recorder.Events:
+			if strings.Contains(event, reason) {
+				n++
+			}
+		default:
+			return n
+		}
+	}
+}
