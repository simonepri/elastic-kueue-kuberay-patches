new file mode 100644
index 0000000..c845592
--- /dev/null
+++ b/ray-operator/controllers/ray/slow_start_batch.go
@@ -0,0 +1,36 @@
+package ray
+
+import (
+	errstd "errors"
+	"sync"
+)
+
+// slowStartBatch calls fn(i) for every i in [0, count) in concurrent batches of 1, 2, 4, ... calls,
+// like the ReplicaSet and Job controllers create Pods. It stops after the first batch in which any
+// call fails, so when the API server rejects every Pod, such as on a webhook denial or an exhausted
+// quota, only a few creates fail instead of all of them. It returns how many calls succeeded and the
+// joined errors of the failing batch; calls that succeeded in that batch stay done.
+func slowStartBatch(count int, fn func(i int) error) (int, error) {
+	successes := 0
+	for start, batchSize := 0, min(1, count); batchSize > 0; batchSize = min(2*batchSize, count-start) {
+		errs := make([]error, batchSize)
+		var wg sync.WaitGroup
+		for j := range batchSize {
+			wg.Go(func() {
+				errs[j] = fn(start + j)
+			})
+		}
+		wg.Wait()
+		if err := errstd.Join(errs...); err != nil {
+			for _, e := range errs {
+				if e == nil {
+					successes++
+				}
+			}
+			return successes, err
+		}
+		successes += batchSize
+		start += batchSize
+	}
+	return successes, nil
+}
