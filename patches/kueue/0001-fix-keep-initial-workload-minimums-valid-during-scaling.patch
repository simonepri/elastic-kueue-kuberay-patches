+// syncInitialMinCounts updates an initial slice before admission or readmission.
+func syncInitialMinCounts(wl *kueue.Workload, jobPodSets []kueue.PodSet) {
+	if workload.HasQuotaReservation(wl) || workload.IsAdmitted(wl) || ScaledUp(wl) {
+		return
+	}
+	if wl.Status.AccumulatedPastExecutionTimeSeconds != nil {
+		for i := range wl.Spec.PodSets {
+			ps := &wl.Spec.PodSets[i]
+			if ps.MinCount != nil && *ps.MinCount > ps.Count {
+				ps.MinCount = new(ps.Count)
+			}
+		}
+		return
+	}
+	for i := range wl.Spec.PodSets {
+		for _, jobPodSet := range jobPodSets {
+			if wl.Spec.PodSets[i].Name == jobPodSet.Name {
+				wl.Spec.PodSets[i].MinCount = jobPodSet.MinCount
+				break
+			}
+		}
+	}
+}
