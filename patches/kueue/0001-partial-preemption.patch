+)
+
+// TestScaleDownByWholeReplicas checks that a worker group of NumOfHosts pods
+// per replica counts pods in its pod set, minimum included, scales down by
+// whole replicas, and turns an admitted pod count back into replicas.
+func TestScaleDownByWholeReplicas(t *testing.T) {
+	_, log := utiltesting.ContextWithLog(t)
+	cluster := testingrayutil.MakeCluster("cluster", "ns").
+		WithWorkerGroups(*testingrayutil.MakeWorkerGroup("workers", 3).Obj()).
+		WithNumOfHosts("workers", 2).Obj()
+	cluster.Spec.WorkerGroupSpecs[0].MinReplicas = ptr.To[int32](1)
+
+	podSets, err := BuildPodSets(&cluster.Spec, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	workers := podSets[1]
+	if diff := cmp.Diff([]int32{6, 2}, []int32{workers.Count, ptr.Deref(workers.MinCount, 0)}); diff != "" {
+		t.Errorf("unexpected worker pod count and minimum (-want/+got):\n%s", diff)
+	}
+
+	if diff := cmp.Diff(map[kueue.PodSetReference]int32{"workers": 2}, (*RayCluster)(cluster).ScaleDownSteps()); diff != "" {
+		t.Errorf("unexpected scale down steps (-want/+got):\n%s", diff)
+	}
+
+	wl := utiltestingapi.MakeWorkload("wl", "ns").ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+		utiltestingapi.MakePodSetAssignment("head").Count(1).Obj(),
+		utiltestingapi.MakePodSetAssignment("workers").Count(4).Obj()).Obj(), time.Now()).Obj()
+	synced := cluster.DeepCopy()
+	if !(*RayCluster)(synced).SyncScale(wl) {
+		t.Fatal("SyncScale did not change the cluster")
+	}
+	if diff := cmp.Diff(int32(2), ptr.Deref(synced.Spec.WorkerGroupSpecs[0].Replicas, 0)); diff != "" {
+		t.Errorf("unexpected replicas after SyncScale (-want/+got):\n%s", diff)
+	}
+
+	started := cluster.DeepCopy()
+	if err := UpdateRayClusterSpecToRunWithPodSetsInfo(log, &started.Spec, []podset.PodSetInfo{{Name: "head", Count: 1}, {Name: "workers", Count: 4}}); err != nil {
+		t.Fatal(err)
+	}
+	if diff := cmp.Diff(int32(2), ptr.Deref(started.Spec.WorkerGroupSpecs[0].Replicas, 0)); diff != "" {
+		t.Errorf("unexpected replicas after starting with 4 pods (-want/+got):\n%s", diff)
+	}
+}
