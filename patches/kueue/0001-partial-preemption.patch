+)
+
+// RemoveWorkloadUsage removes usage, a part of wl's usage such as only its
+// quota or only its TAS usage, from wl's ClusterQueue and the overlapping TAS
+// flavors, and keeps wl in the ClusterQueue. It lets a search see the
+// snapshot as if one kind of wl's usage were gone, at a fraction of the cost
+// of RemoveWorkload. AddWorkloadUsage reverts it. Neither changes a workload
+// whose usage was released.
+func (s *Snapshot) RemoveWorkloadUsage(wl *workload.Info, usage workload.Usage) {
+	cq := s.ClusterQueue(wl.ClusterQueue)
+	if !cq.released.Has(workload.Key(wl.Obj)) {
+		s.removeUsage(cq, usage)
+	}
+}
+
+// AddWorkloadUsage adds usage, a part of wl's usage, to wl's ClusterQueue and
+// the overlapping TAS flavors without adding wl to the ClusterQueue, such as
+// usage removed by RemoveWorkloadUsage or the part a removed wl keeps.
+func (s *Snapshot) AddWorkloadUsage(wl *workload.Info, usage workload.Usage) {
+	cq := s.ClusterQueue(wl.ClusterQueue)
+	if !cq.released.Has(workload.Key(wl.Obj)) {
+		s.AddUsage(cq, usage)
+	}
+}
