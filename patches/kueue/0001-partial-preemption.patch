+// SimulateRemoval is SimulateUsageRemoval that also takes the evicted targets
+// out of their ClusterQueues and their Pods out of the scheduling simulator.
+// Shrunk targets keep their Pods in the simulator, since which of them the
+// job deletes is not known.
+func (p PreemptedWorkloads) SimulateRemoval(ctx context.Context, log logr.Logger, snapshot *schdcache.Snapshot) func() {
+	evicted := p.Evicted()
+	revertUsage := snapshot.SimulateWorkloadRemoval(evicted)
+	revertShrinks := p.simulateShrinks(snapshot)
+	revertPods := snapshot.SimulatePodRemoval(ctx, log, evicted)
+	return func() {
+		revertPods()
+		revertShrinks()
+		revertUsage()
+	}
+}
+
+// simulateShrinks takes the shrunk targets out of their ClusterQueues, so
+// that a preemption search does not offer them again, leaving only the usage
+// they keep, KeptUsage, and returns a function that restores them.
+func (p PreemptedWorkloads) simulateShrinks(snapshot *schdcache.Snapshot) func() {
+	var shrunk []*Target
+	for _, target := range p {
+		if target.NewCount != nil {
+			shrunk = append(shrunk, target)
+			snapshot.RemoveWorkload(target.WorkloadInfo)
+			snapshot.AddWorkloadUsage(target.WorkloadInfo, target.KeptUsage)
+		}
+	}
+	return func() {
+		for _, target := range shrunk {
+			snapshot.RemoveWorkloadUsage(target.WorkloadInfo, target.KeptUsage)
+			snapshot.AddWorkload(target.WorkloadInfo)
+		}
+	}
+}
+
+// PreemptedTargets returns targets keyed by workload.
+func PreemptedTargets(targets []*Target) PreemptedWorkloads {
+	p := make(PreemptedWorkloads, len(targets))
+	p.Insert(targets)
+	return p
 }
