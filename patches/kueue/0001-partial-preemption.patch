+func TestShrunkWorkloadCountsTheKeptPods(t *testing.T) {
+	// A pod set admitted at 4 pods, one of them reclaimable, counts 3 pods.
+	// Shrunk to 2 pods, it counts exactly 2, with the quota of 2 pods.
+	ctx, log := utiltesting.ContextWithLog(t)
+	wl := utiltestingapi.MakeWorkload("elastic", "default").
+		PodSets(*utiltestingapi.MakePodSet("main", 4).SetMinimumCount(1).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("borrower").PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(4).Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), time.Now()).
+		ReclaimablePods(kueue.ReclaimablePod{Name: "main", Count: 1}).Obj()
+	if got := workload.NewInfo(log, wl).TotalRequests[0].Count; got != 3 {
+		t.Fatalf("before the shrink the pod set counts %d pods, want 3", got)
+	}
+	cl := utiltesting.NewClientBuilder().WithObjects(wl).WithStatusSubresource(&kueue.Workload{}).
+		WithInterceptorFuncs(interceptor.Funcs{SubResourceApply: utiltesting.TreatSSAAsStrategicMergeForApplyConfiguration}).Build()
+	preemptor := New(cl, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+
+	if err := preemptor.applyPartialPreemption(ctx, wl, "main", 2, kueue.InCohortReclamationReason, "shrunk"); err != nil {
+		t.Fatal(err)
+	}
+
+	var got kueue.Workload
+	if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+		t.Fatal(err)
+	}
+	podSet := workload.NewInfo(log, &got).TotalRequests[0]
+	if podSet.Count != 2 {
+		t.Errorf("the shrunk pod set counts %d pods, want 2", podSet.Count)
+	}
+	if cpu, _ := podSet.Requests.ResourceValue(corev1.ResourceCPU).Int64(); cpu != 2000 {
+		t.Errorf("the shrunk pod set uses %dm CPU, want 2000m", cpu)
+	}
+}
