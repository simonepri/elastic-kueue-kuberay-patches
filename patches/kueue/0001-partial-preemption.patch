+// elasticTopologyCluster describes a cohort where ClusterQueue "incoming",
+// with a nominal quota of 2 CPUs it does not lend, reclaims CPU that
+// ClusterQueue "borrower" borrows from it. Every node has 2 CPUs. Workload
+// "elastic" of ClusterQueue "borrower" runs pod set "main", whose pods of 1
+// CPU elasticPods places, with a minimum of 1 pod, and, when elasticHead names
+// a node, pod set "head" with one pod of 1 CPU there. The other workloads run
+// one pod of 1 CPU each.
+type elasticTopologyCluster struct {
+	nodes           []string
+	borrowerNominal string
+	elasticPods     map[string]int32
+	elasticHead     string
+	// elasticReclaimable is how many pods of "main" are reclaimable.
+	elasticReclaimable int32
+	// elasticStep is the number of pods by which "main" scales, 1 when unset.
+	elasticStep int32
+	// elasticFixed means the job of "elastic" cannot scale down.
+	elasticFixed bool
+	elasticAge   time.Duration
+	others       []elasticTopologyOther
+}
+
+// elasticTopologyOther is a one-pod workload admitted age ago on node, which
+// requests cpu, 1 CPU when unset.
+type elasticTopologyOther struct {
+	name         string
+	clusterQueue kueue.ClusterQueueReference
+	node         string
+	age          time.Duration
+	cpu          string
+}
+
+type elasticTopologySetup struct {
+	snapshot   *schdcache.Snapshot
+	incoming   workload.Info
+	assignment flavorassigner.Assignment
+}
+
+// build creates the snapshot and an incoming workload of priority 3 that needs
+// 2 CPUs on one node; every admitted workload has priority 1.
+func (c elasticTopologyCluster) build(ctx context.Context, t testing.TB, log logr.Logger) elasticTopologySetup {
+	t.Helper()
+	now := time.Now().Truncate(time.Second)
+	podSetAssignment := func(name kueue.PodSetReference, pods map[string]int32) kueue.PodSetAssignment {
+		topology := utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname})
+		var count int32
+		for _, node := range slices.Sorted(maps.Keys(pods)) {
+			topology.Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, pods[node]).Obj())
+			count += pods[node]
+		}
+		return utiltestingapi.MakePodSetAssignment(name).Count(count).
+			Assignment(corev1.ResourceCPU, "tas", fmt.Sprint(count)).
+			TopologyAssignment(topology.Obj()).Obj()
+	}
+	var elasticCount int32
+	for _, pods := range c.elasticPods {
+		elasticCount += pods
+	}
+	podSets := []kueue.PodSet{*utiltestingapi.MakePodSet("main", int(elasticCount)).SetMinimumCount(1).Request(corev1.ResourceCPU, "1").UnconstrainedTopologyRequest().Obj()}
+	assignments := []kueue.PodSetAssignment{podSetAssignment("main", c.elasticPods)}
+	if c.elasticHead != "" {
+		podSets = append([]kueue.PodSet{*utiltestingapi.MakePodSet("head", 1).Request(corev1.ResourceCPU, "1").UnconstrainedTopologyRequest().Obj()}, podSets...)
+		assignments = append([]kueue.PodSetAssignment{podSetAssignment("head", map[string]int32{c.elasticHead: 1})}, assignments...)
+	}
+	elastic := utiltestingapi.MakeWorkload("elastic", "default").UID("elastic").Priority(1).PodSets(podSets...).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("borrower").PodSets(assignments...).Obj(), now.Add(-c.elasticAge))
+	if c.elasticReclaimable > 0 {
+		elastic.ReclaimablePods(kueue.ReclaimablePod{Name: "main", Count: c.elasticReclaimable})
+	}
+	switch {
+	case c.elasticFixed:
+		elastic.Label(scaleDownStepLabel, "0")
+	case c.elasticStep > 0:
+		elastic.Label(scaleDownStepLabel, fmt.Sprint(c.elasticStep))
+	}
+	admitted := []kueue.Workload{*elastic.Obj()}
+	for _, other := range c.others {
+		cpu := cmp.Or(other.cpu, "1")
+		assignment := podSetAssignment("main", map[string]int32{other.node: 1})
+		assignment.ResourceUsage[corev1.ResourceCPU] = resource.MustParse(cpu)
+		admitted = append(admitted, *utiltestingapi.MakeWorkload(other.name, "default").Priority(1).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, cpu).UnconstrainedTopologyRequest().Obj()).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission(other.clusterQueue).PodSets(assignment).Obj(), now.Add(-other.age)).Obj())
+	}
+
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+	for _, node := range c.nodes {
+		cache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+			StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("2"), corev1.ResourcePods: resource.MustParse("10")}).
+			Ready().Obj())
+	}
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "2", "0").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, c.borrowerNominal).Obj()).Obj(),
+		utiltestingapi.MakeClusterQueue("other").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "1").Obj()).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").UID("incoming").Priority(3).
+		PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").UnconstrainedTopologyRequest().Obj()).Obj())
+	incoming.ClusterQueue = "incoming"
+	return elasticTopologySetup{
+		snapshot: snapshot,
+		incoming: *incoming,
+		assignment: flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+			Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("2")},
+			Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "tas", Mode: flavorassigner.Preempt}},
+		}}},
+	}
+}
+
+// scaleDownStepLabel sets the number of pods by which the pod sets of a test
+// workload scale down; 0 means its job cannot scale down. Without it, they
+// scale by one pod.
+const scaleDownStepLabel = "test-scale-down-step"
+
+// testScaleDownSteps is the ScaleDownSteps of the tests, set by
+// scaleDownStepLabel.
+func testScaleDownSteps(_ context.Context, wl *kueue.Workload) (map[kueue.PodSetReference]int32, bool) {
+	step := int32(1)
+	if value, ok := wl.Labels[scaleDownStepLabel]; ok {
+		parsed, err := strconv.ParseInt(value, 10, 32)
+		if err != nil || parsed <= 0 {
+			return nil, false
+		}
+		step = int32(parsed)
+	}
+	steps := make(map[kueue.PodSetReference]int32, len(wl.Spec.PodSets))
+	for _, ps := range wl.Spec.PodSets {
+		steps[ps.Name] = step
+	}
+	return steps, true
+}
+
+// newShrinkingPreemptor returns a preemptor that shrinks workloads by
+// testScaleDownSteps.
+func newShrinkingPreemptor(fairSharing *config.FairSharing) *Preemptor {
+	preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, fairSharing, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+	preemptor.SetScaleDownSteps(testScaleDownSteps)
+	return preemptor
+}
+
+// targetNames returns the sorted names of the targets, with the pod count a
+// shrunk target keeps.
+func targetNames(targets []*Target) []string {
+	var names []string
+	for _, target := range targets {
+		name := target.WorkloadInfo.Obj.Name
+		if target.NewCount != nil {
+			name = fmt.Sprintf("%s/%d", name, *target.NewCount)
+		}
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	return names
+}
+
+// checkSnapshotUnchanged fails the test when the targets search left quota or
+// topology usage behind in the snapshot.
+func checkSnapshotUnchanged(t *testing.T, snapshot *schdcache.Snapshot) func() {
+	t.Helper()
+	freeCapacity := func() string {
+		t.Helper()
+		tasFlavor := snapshot.ClusterQueue("incoming").TASFlavors["tas"]
+		if tasFlavor == nil {
+			return ""
+		}
+		capacity, err := tasFlavor.SerializeFreeCapacityPerDomain()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return capacity
+	}
+	usage := maps.Clone(snapshot.ClusterQueue("borrower").ResourceNode.Usage)
+	capacity := freeCapacity()
+	return func() {
+		t.Helper()
+		if diff := gocmp.Diff(usage, snapshot.ClusterQueue("borrower").ResourceNode.Usage); diff != "" {
+			t.Errorf("quota snapshot changed (-before/+after):\n%s", diff)
+		}
+		if diff := gocmp.Diff(capacity, freeCapacity()); diff != "" {
+			t.Errorf("topology snapshot changed (-before/+after):\n%s", diff)
+		}
+	}
+}
