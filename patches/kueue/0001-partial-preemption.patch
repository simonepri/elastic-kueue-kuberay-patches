+// multiHostCluster returns a cluster with one worker group of 3 replicas of 2
+// pods each, at least 1 replica, elastic when elastic is true.
+func multiHostCluster(elastic bool) *rayv1.RayCluster {
+	wrapper := testingrayutil.MakeCluster("cluster", "default").UID("cluster").
+		WithWorkerGroups(*testingrayutil.MakeWorkerGroup("workers", 3).Obj()).
+		WithNumOfHosts("workers", 2)
+	if elastic {
+		wrapper.SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue)
+	}
+	cluster := wrapper.Obj()
+	cluster.Spec.WorkerGroupSpecs[0].MinReplicas = ptr.To[int32](1)
+	return cluster
+}
+
+// TestScaleDownByWholeReplicas checks that an elastic worker group of
+// NumOfHosts pods per replica counts pods in its pod set, minimum included,
+// scales down by whole replicas, and turns an admitted pod count back into
+// replicas.
+func TestScaleDownByWholeReplicas(t *testing.T) {
+	_, log := utiltesting.ContextWithLog(t)
+	cluster := multiHostCluster(true)
+
+	podSets, err := BuildPodSets(&cluster.Spec, cluster.Annotations)
+	if err != nil {
+		t.Fatal(err)
+	}
+	workers := podSets[1]
+	if diff := cmp.Diff([]int32{6, 2}, []int32{workers.Count, ptr.Deref(workers.MinCount, 0)}); diff != "" {
+		t.Errorf("unexpected worker pod count and minimum (-want/+got):\n%s", diff)
+	}
+
+	wantLimits := map[kueue.PodSetReference]preemption.PodSetScaleDown{"workers": {Step: 2, MinCount: 2}}
+	if diff := cmp.Diff(wantLimits, (*RayCluster)(cluster).ScaleDownLimits()); diff != "" {
+		t.Errorf("unexpected scale down limits (-want/+got):\n%s", diff)
+	}
+
+	wl := utiltestingapi.MakeWorkload("wl", "default").ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+		utiltestingapi.MakePodSetAssignment("head").Count(1).Obj(),
+		utiltestingapi.MakePodSetAssignment("workers").Count(4).Obj()).Obj(), time.Now()).Obj()
+	synced := cluster.DeepCopy()
+	if !(*RayCluster)(synced).SyncScale(wl) {
+		t.Fatal("SyncScale did not change the cluster")
+	}
+	if diff := cmp.Diff(int32(2), ptr.Deref(synced.Spec.WorkerGroupSpecs[0].Replicas, 0)); diff != "" {
+		t.Errorf("unexpected replicas after SyncScale (-want/+got):\n%s", diff)
+	}
+
+	started := cluster.DeepCopy()
+	if err := UpdateRayClusterSpecToRunWithPodSetsInfo(log, &started.Spec, []podset.PodSetInfo{{Name: "head", Count: 1}, {Name: "workers", Count: 4}}); err != nil {
+		t.Fatal(err)
+	}
+	if diff := cmp.Diff(int32(2), ptr.Deref(started.Spec.WorkerGroupSpecs[0].Replicas, 0)); diff != "" {
+		t.Errorf("unexpected replicas after starting with 4 pods (-want/+got):\n%s", diff)
+	}
+}
+
+// TestClusterThatIsNotElasticKeepsItsSize checks that a cluster without the
+// elastic-job annotation gets no minimum count, although KubeRay defaults
+// minReplicas, so its Workload keeps the shape of stock Kueue, passes
+// validation with several worker groups, and is never shrunk.
+func TestClusterThatIsNotElasticKeepsItsSize(t *testing.T) {
+	cluster := testingrayutil.MakeCluster("cluster", "default").
+		WithWorkerGroups(*testingrayutil.MakeWorkerGroup("small", 2).Obj(), *testingrayutil.MakeWorkerGroup("large", 3).Obj()).Obj()
+	for i := range cluster.Spec.WorkerGroupSpecs {
+		cluster.Spec.WorkerGroupSpecs[i].MinReplicas = ptr.To[int32](0)
+	}
+
+	podSets, err := BuildPodSets(&cluster.Spec, cluster.Annotations)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, ps := range podSets {
+		if ps.MinCount != nil {
+			t.Errorf("pod set %s has minimum count %d, want none", ps.Name, *ps.MinCount)
+		}
+	}
+	wl := utiltestingapi.MakeWorkload("wl", "default").PodSets(podSets...).Obj()
+	if errs := webhooks.ValidateWorkload(wl, nil); len(errs) > 0 {
+		t.Errorf("the Workload is invalid: %v", errs)
+	}
+	if limits := (*RayCluster)(cluster).ScaleDownLimits(); len(limits) > 0 {
+		t.Errorf("unexpected scale down limits %v, want none", limits)
+	}
+}
+
+// TestRunningClusterStaysEquivalentAcrossMinimumEncodings checks that a
+// running elastic cluster whose Workload an earlier release built, with no
+// minimum or with the minimum counted in replicas, stays equivalent to it, so
+// an upgrade does not suspend it.
+func TestRunningClusterStaysEquivalentAcrossMinimumEncodings(t *testing.T) {
+	cases := map[string]*int32{
+		"stock Kueue sets no minimum":                     nil,
+		"an earlier patch counts the minimum in replicas": ptr.To[int32](1),
+		"this patch counts the minimum in pods":           ptr.To[int32](2),
+	}
+	for name, minCount := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			cluster := multiHostCluster(true)
+			cluster.Spec.Suspend = ptr.To(false)
+			podSets, err := BuildPodSets(&cluster.Spec, cluster.Annotations)
+			if err != nil {
+				t.Fatal(err)
+			}
+			podSets[1].MinCount = minCount
+			wl := utiltestingapi.MakeWorkload("wl", "default").PodSets(podSets...).
+				ControllerReference(rayv1.GroupVersion.WithKind("RayCluster"), "cluster", "cluster").
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+					utiltestingapi.MakePodSetAssignment("head").Count(1).Obj(),
+					utiltestingapi.MakePodSetAssignment("workers").Count(6).Obj()).Obj(), time.Now()).
+				AdmittedAt(true, time.Now()).Obj()
+			cl := utiltesting.NewClientBuilder(rayv1.AddToScheme).
+				WithObjects(utiltestingapi.MakeResourceFlavor("default").Obj()).Build()
+
+			equivalent, err := jobframework.EquivalentToWorkload(ctx, cl, (*RayCluster)(cluster), wl)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !equivalent {
+				t.Error("the running cluster is not equivalent to its Workload")
+			}
+		})
+	}
+}
