+func (p *Preemptor) applyPartialPreemption(ctx context.Context, w *kueue.Workload, podSetName string, newCount int32, reason, message string) error {
+	latest := &kueue.Workload{}
+	if err := p.client.Get(ctx, client.ObjectKeyFromObject(w), latest); err == nil {
+		w = latest
+	} else {
+		w = w.DeepCopy()
+	}
+	workload.SetPreemptedCondition(w, reason, message)
+	if w.Status.Admission != nil {
+		for i := range w.Status.Admission.PodSetAssignments {
+			psa := &w.Status.Admission.PodSetAssignments[i]
+			if psa.Name == podSetName {
+				oldCount := ptr.Deref(psa.Count, 1)
+				if oldCount > 0 {
+					for resName, quant := range psa.ResourceUsage {
+						val := quant.MilliValue()
+						newVal := (val * int64(newCount)) / int64(oldCount)
+						quant.SetMilli(newVal)
+						psa.ResourceUsage[resName] = quant
+					}
+				}
+				psa.Count = ptr.To(newCount)
+			}
+		}
+	}
+	return workload.ApplyAdmissionStatus(ctx, p.client, w, false)
+}
