+// TestScheduleCountsWhatAShrunkVictimKeeps checks that a preemptor whose
+// victim is only shrunk does not leave the quota of the victim's kept pods to
+// another preemptor in the same cycle.
+//
+// ClusterQueues "a" and "b" share a Cohort of 4 CPUs. Elastic workload
+// "elastic" of "a" runs 2 pods of 1 CPU with a minimum of 1, and "worker" of
+// "b" runs one pod of 1 CPU. Preemptor "a-new" needs 2 CPUs: shrinking
+// "elastic" to 1 pod frees enough, borrowing the CPU "b" does not use.
+// Preemptor "b-new" needs 2 CPUs: evicting "worker" frees enough at the start
+// of the cycle. After either one books its usage, the other fits only if
+// "elastic" gives up both pods, so only the first may preempt.
+func TestScheduleCountsWhatAShrunkVictimKeeps(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	ctx, log := utiltesting.ContextWithLog(t)
+	admission := func(cq kueue.ClusterQueueReference, count int32, cpu string) *kueue.Admission {
+		return utiltestingapi.MakeAdmission(cq).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(count).
+				Assignment(corev1.ResourceCPU, "default", cpu).Obj()).Obj()
+	}
+	workloads := []kueue.Workload{
+		*utiltestingapi.MakeWorkload("elastic", "default").Priority(1).
+			PodSets(*utiltestingapi.MakePodSet("main", 2).SetMinimumCount(1).Request(corev1.ResourceCPU, "1").Obj()).
+			ReserveQuotaAt(admission("a", 2, "2"), now.Add(-time.Hour)).AdmittedAt(true, now.Add(-time.Hour)).Obj(),
+		*utiltestingapi.MakeWorkload("worker", "default").Priority(1).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "1").Obj()).
+			ReserveQuotaAt(admission("b", 1, "1"), now.Add(-time.Hour)).AdmittedAt(true, now.Add(-time.Hour)).Obj(),
+		*utiltestingapi.MakeWorkload("a-new", "default").Queue("a").Priority(3).Creation(now.Add(-2 * time.Minute)).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").Obj()).Obj(),
+		*utiltestingapi.MakeWorkload("b-new", "default").Queue("b").Priority(3).Creation(now.Add(-time.Minute)).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").Obj()).Obj(),
+	}
+	localQueues := []kueue.LocalQueue{
+		*utiltestingapi.MakeLocalQueue("a", "default").ClusterQueue("a").Obj(),
+		*utiltestingapi.MakeLocalQueue("b", "default").ClusterQueue("b").Obj(),
+	}
+	cl := utiltesting.NewClientBuilder().
+		WithLists(&kueue.WorkloadList{Items: workloads}, &kueue.LocalQueueList{Items: localQueues}).
+		WithObjects(utiltesting.MakeNamespace("default")).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithStatusSubresource(&kueue.Workload{}).Build()
+	cqCache := schdcache.New(cl)
+	cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	fakeClock := testingclock.NewFakeClock(now)
+	qManager := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithClock(fakeClock))
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("a").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "2").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}).Obj(),
+		utiltestingapi.MakeClusterQueue("b").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "2").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}).Obj(),
+	} {
+		if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+		if err := qManager.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := range localQueues {
+		if err := qManager.AddLocalQueue(ctx, &localQueues[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	scheduler := New(qManager, cqCache, cl, &utiltesting.EventRecorder{}, WithClock(t, fakeClock), WithPreemptionExpectations(preemptexpectations.New()))
+	wg := sync.WaitGroup{}
+	scheduler.setAdmissionRoutineWrapper(routine.NewWrapper(func() { wg.Add(1) }, func() { wg.Done() }))
+
+	scheduler.schedule(ctx)
+	wg.Wait()
+
+	var got kueue.WorkloadList
+	if err := cl.List(ctx, &got); err != nil {
+		t.Fatal(err)
+	}
+	var preempted []string
+	for _, wl := range got.Items {
+		if apimeta.IsStatusConditionTrue(wl.Status.Conditions, kueue.WorkloadPreempted) {
