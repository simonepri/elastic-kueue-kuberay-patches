+func TestPreemptionShrinksElasticVictimKeepingQuotaUsage(t *testing.T) {
+	cases := map[string]elasticShrinkCase{
+		"a victim is not added back while the shrunk victim's kept pods use the quota it needs": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x3": 2}, elasticAge: time.Hour,
+				others: []elasticTopologyOther{{name: "x1-worker", clusterQueue: "borrower", node: "x1"}},
+			},
+			wantTargets: []string{"elastic/1", "x1-worker"},
+		},
+		"the quota of another pod set counts toward what a shrunk victim keeps": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "1500m",
+				elasticPods: map[string]int32{"x3": 2}, elasticHead: "x2",
+			},
+		},
+		"a victim whose reclaimable pods leave it at its minimum is evicted": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "0",
+				elasticPods: map[string]int32{"x2": 2, "x3": 2}, elasticReclaimable: 3,
+			},
+			wantTargets: []string{"elastic"},
+		},
+		"a victim with reclaimable pods is shrunk below the pods it runs": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x2": 2, "x3": 2}, elasticReclaimable: 1,
+			},
+			wantTargets: []string{"elastic/1"},
+		},
+		"an elastic victim offered first is shrunk together with a later victim": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x3": 2},
+				others:      []elasticTopologyOther{{name: "x2-worker", clusterQueue: "borrower", node: "x2", age: time.Hour}},
+			},
+			wantTargets: []string{"elastic/1", "x2-worker"},
+		},
+		"an elastic victim offered before the victim that makes the preemptor fit is shrunk, not evicted": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x3": 2},
+				others:      []elasticTopologyOther{{name: "x2-worker", clusterQueue: "borrower", node: "x2", age: time.Hour, cpu: "2"}},
+			},
+			wantTargets: []string{"elastic/1", "x2-worker"},
+		},
+		"an elastic victim the preemptor does not need is put back whole": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "2",
+				elasticPods: map[string]int32{"x3": 2},
+				others:      []elasticTopologyOther{{name: "x2-worker", clusterQueue: "borrower", node: "x2", age: time.Hour, cpu: "3"}},
+			},
+			wantTargets: []string{"x2-worker"},
+		},
+		"a workload whose job cannot scale down is evicted, not shrunk": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x3": 2}, elasticFixed: true,
+			},
+			wantTargets: []string{"elastic"},
+		},
+		"a pod set that scales by several pods shrinks by whole steps": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "3",
+				elasticPods: map[string]int32{"x2": 2, "x3": 2}, elasticStep: 2,
+			},
+			wantTargets: []string{"elastic/2"},
+		},
+		"a victim with another pod set is shrunk when its kept pods fit the quota": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2", "x3"}, borrowerNominal: "2",
+				elasticPods: map[string]int32{"x3": 2}, elasticHead: "x2",
+			},
+			wantTargets: []string{"elastic/1"},
+		},
+	}
+	for _, tas := range []bool{true, false} {
+		t.Run(fmt.Sprintf("tas=%t", tas), func(t *testing.T) {
+			runElasticShrinkCases(t, tas, cases)
+		})
+	}
+}
+
+// elasticShrinkCase is a cluster and the targets, sorted by targetNames,
+// that preemption finds in it for the incoming workload.
+type elasticShrinkCase struct {
+	cluster     elasticTopologyCluster
+	wantTargets []string
+}
+
+// runElasticShrinkCases runs ordinary preemption in each case's cluster, with
+// Topology Aware Scheduling enabled when tas is true.
+func runElasticShrinkCases(t *testing.T, tas bool, cases map[string]elasticShrinkCase) {
+	t.Helper()
+	modes := []struct {
+		name         string
+		cacheEnabled bool
+		fairSharing  *config.FairSharing
+	}{
+		{name: "classical/cache=false"},
+		{name: "classical/cache=true", cacheEnabled: true},
+		{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	}
+	for _, mode := range modes {
+		t.Run(mode.name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+			for name, tc := range cases {
+				t.Run(name, func(t *testing.T) {
+					features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, tas)
+					ctx, log := utiltesting.ContextWithLog(t)
+					setup := tc.cluster.build(ctx, t, log)
+					check := checkSnapshotUnchanged(t, setup.snapshot)
+					preemptor := newShrinkingPreemptor(mode.fairSharing)
+					targets := preemptor.GetTargetsWithStrategy(ctx, preemptor.GetPreemptionStrategyIterator(ctx, setup.incoming, setup.snapshot, setup.assignment))
+					if diff := gocmp.Diff(tc.wantTargets, targetNames(targets), cmpopts.EquateEmpty()); diff != "" {
+						t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+					}
+					check()
+				})
+			}
+		})
+	}
+}
