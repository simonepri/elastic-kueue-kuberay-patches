+func (p *Preemptor) applyPartialPreemption(ctx context.Context, w *kueue.Workload, podSetName string, newCount int32, reason, message string) error {
+	return workloadpatching.PatchAdmissionStatus(ctx, p.client, w, p.clock, func(wl *kueue.Workload) (bool, error) {
+		workload.SetPreemptedCondition(wl, p.clock.Now(), reason, message)
+		if wl.Status.Admission != nil {
+			for i := range wl.Status.Admission.PodSetAssignments {
+				psa := &wl.Status.Admission.PodSetAssignments[i]
+				if string(psa.Name) == podSetName {
+					oldCount := ptr.Deref(psa.Count, 1)
+					if oldCount > 0 {
+						for resName, quant := range psa.ResourceUsage {
+							val := quant.MilliValue()
+							newVal := (val * int64(newCount)) / int64(oldCount)
+							quant.SetMilli(newVal)
+							psa.ResourceUsage[resName] = quant
+						}
+					}
+					psa.Count = ptr.To(newCount)
+				}
+			}
+		}
+		return true, nil
+	}, workloadpatching.WithLooseOnApply(), workloadpatching.WithRetryOnConflict())
+}
