+// checkClusterQueueUsageUnchanged fails the test when the targets search left
+// quota usage behind in the ClusterQueues.
+func checkClusterQueueUsageUnchanged(t *testing.T, snapshot *schdcache.Snapshot, cqs ...kueue.ClusterQueueReference) func() {
+	t.Helper()
+	before := make(map[kueue.ClusterQueueReference]resources.FlavorResourceQuantities, len(cqs))
+	for _, cq := range cqs {
+		before[cq] = maps.Clone(snapshot.ClusterQueue(cq).ResourceNode.Usage)
+	}
+	return func() {
+		t.Helper()
+		for _, cq := range cqs {
+			if diff := gocmp.Diff(before[cq], snapshot.ClusterQueue(cq).ResourceNode.Usage); diff != "" {
+				t.Errorf("quota snapshot of %s changed (-before/+after):\n%s", cq, diff)
+			}
+		}
+	}
+}
