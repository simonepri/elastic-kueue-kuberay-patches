+
+package jobframework
+
+import (
+	"context"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption"
+)
+
+// NewScaleDownSteps returns the preemption.ScaleDownSteps of the jobs the
+// integrations of m manage: a workload's job can scale down when its
+// integration implements JobWithDynamicScaling, and scales by the steps the
+// job reports. It reads the job through c.
+func NewScaleDownSteps(c client.Client, m *IntegrationManager) preemption.ScaleDownSteps {
+	return func(ctx context.Context, wl *kueue.Workload) (map[kueue.PodSetReference]int32, bool) {
+		owner := metav1.GetControllerOf(wl)
+		if owner == nil {
+			return nil, false
+		}
+		gv, err := schema.ParseGroupVersion(owner.APIVersion)
+		if err != nil {
+			return nil, false
+		}
+		integration, ok := m.GetIntegrationByGVK(gv.WithKind(owner.Kind))
+		if !ok || integration.NewJob == nil {
+			return nil, false
+		}
+		job := integration.NewJob()
+		scaler, ok := job.(JobWithDynamicScaling)
+		if !ok {
+			return nil, false
+		}
+		if err := c.Get(ctx, client.ObjectKey{Namespace: wl.Namespace, Name: owner.Name}, job.Object()); err != nil || job.Object().GetUID() != owner.UID {
+			return nil, false
+		}
+		return scaler.ScaleDownSteps(), true
+	}
+}
