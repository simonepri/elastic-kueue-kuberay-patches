@@ -19,6 +19,7 @@ package raycluster
 import (
 	"context"
 	"fmt"
+	"strings"
 
 	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
 	rayutils "github.com/ray-project/kuberay/ray-operator/controllers/ray/utils"
@@ -150,6 +151,48 @@ func (j *RayCluster) RestorePodSetsInfo(ctx context.Context, podSetsInfo []podse
 	return ClearRuntimeWorkerStateAnnotations(j.Object()) || changed
 }
 
+func (j *RayCluster) SyncScale(wl *kueue.Workload) bool {
+	if wl == nil || wl.Status.Admission == nil {
+		return false
+	}
+	changed := false
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		if psa.Name == headGroupPodSetName {
+			continue
+		}
+		for i := range j.Spec.WorkerGroupSpecs {
+			wgs := &j.Spec.WorkerGroupSpecs[i]
+			if strings.EqualFold(wgs.GroupName, string(psa.Name)) {
+				if psa.Count != nil {
+					targetCount := *psa.Count
+					if wgs.NumOfHosts > 1 {
+						targetCount = targetCount / wgs.NumOfHosts
+					}
+					if wgs.MaxReplicas != nil && targetCount > *wgs.MaxReplicas {
+						targetCount = *wgs.MaxReplicas
+					}
+					if wgs.Replicas == nil || *wgs.Replicas != targetCount {
+						wgs.Replicas = ptr.To(targetCount)
+						changed = true
+					}
+				}
+			}
+		}
+	}
+	return changed
+}
+
+// ScaleDownSteps returns, for each worker group, the pods of one replica,
+// since KubeRay scales a group by whole replicas of NumOfHosts pods.
+func (j *RayCluster) ScaleDownSteps() map[kueue.PodSetReference]int32 {
+	steps := make(map[kueue.PodSetReference]int32, len(j.Spec.WorkerGroupSpecs))
+	for i := range j.Spec.WorkerGroupSpecs {
+		wgs := &j.Spec.WorkerGroupSpecs[i]
+		steps[kueue.NewPodSetReference(wgs.GroupName)] = max(wgs.NumOfHosts, 1)
+	}
+	return steps
+}
+
 func (j *RayCluster) Finished(ctx context.Context) (message string, success, finished bool) {
 	// Technically a RayCluster is never "finished"
 	return j.Status.Reason, j.Status.State != rayv1.Failed, false
