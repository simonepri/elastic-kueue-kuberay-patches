+// elasticTopologyCluster describes a cohort where ClusterQueue "incoming",
+// with a nominal quota of 2 CPUs it does not lend, reclaims CPU that
+// ClusterQueue "borrower" borrows from it. Every node has 2 CPUs. Workload
+// "elastic" of ClusterQueue "borrower" runs 2 pods of 1 CPU with a minimum of
+// 1, placed by elasticPods; the other workloads run one pod of 1 CPU each.
+type elasticTopologyCluster struct {
+	nodes           []string
+	borrowerNominal string
+	elasticPods     map[string]int32
+	elasticAge      time.Duration
+	others          []elasticTopologyOther
+}
+
+// elasticTopologyOther is a one-pod workload admitted age ago on node.
+type elasticTopologyOther struct {
+	name         string
+	clusterQueue kueue.ClusterQueueReference
+	node         string
+	age          time.Duration
+}
+
+type elasticTopologySetup struct {
+	snapshot   *schdcache.Snapshot
+	incoming   workload.Info
+	assignment flavorassigner.Assignment
+}
+
+// build creates the snapshot and an incoming workload of priority 3 that needs
+// 2 CPUs on one node; every admitted workload has priority 1.
+func (c elasticTopologyCluster) build(ctx context.Context, t testing.TB, log logr.Logger) elasticTopologySetup {
+	t.Helper()
+	now := time.Now().Truncate(time.Second)
+	admission := func(cq kueue.ClusterQueueReference, pods map[string]int32) *kueue.Admission {
+		topology := utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname})
+		var count int32
+		for _, node := range slices.Sorted(maps.Keys(pods)) {
+			topology.Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, pods[node]).Obj())
+			count += pods[node]
+		}
+		return utiltestingapi.MakeAdmission(cq).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(count).
+				Assignment(corev1.ResourceCPU, "tas", fmt.Sprint(count)).
+				TopologyAssignment(topology.Obj()).Obj()).Obj()
+	}
+	admitted := []kueue.Workload{
+		*utiltestingapi.MakeWorkload("elastic", "default").UID("elastic").Priority(1).
+			PodSets(*utiltestingapi.MakePodSet("main", 2).SetMinimumCount(1).Request(corev1.ResourceCPU, "1").UnconstrainedTopologyRequest().Obj()).
+			ReserveQuotaAt(admission("borrower", c.elasticPods), now.Add(-c.elasticAge)).Obj(),
+	}
+	for _, other := range c.others {
+		admitted = append(admitted, *utiltestingapi.MakeWorkload(other.name, "default").Priority(1).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "1").UnconstrainedTopologyRequest().Obj()).
+			ReserveQuotaAt(admission(other.clusterQueue, map[string]int32{other.node: 1}), now.Add(-other.age)).Obj())
+	}
+
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+	for _, node := range c.nodes {
+		cache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+			StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("2"), corev1.ResourcePods: resource.MustParse("10")}).
+			Ready().Obj())
+	}
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "2", "0").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, c.borrowerNominal).Obj()).Obj(),
+		utiltestingapi.MakeClusterQueue("other").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "1").Obj()).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").UID("incoming").Priority(3).
+		PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").UnconstrainedTopologyRequest().Obj()).Obj())
+	incoming.ClusterQueue = "incoming"
+	return elasticTopologySetup{
+		snapshot: snapshot,
+		incoming: *incoming,
+		assignment: flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+			Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("2")},
+			Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "tas", Mode: flavorassigner.Preempt}},
+		}}},
+	}
+}
+
+// targetNames returns the sorted names of the targets, with the pod count a
+// shrunk target keeps.
+func targetNames(targets []*Target) []string {
+	var names []string
+	for _, target := range targets {
+		name := target.WorkloadInfo.Obj.Name
+		if target.NewCount != nil {
+			name = fmt.Sprintf("%s/%d", name, *target.NewCount)
+		}
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	return names
+}
+
+// checkSnapshotUnchanged fails the test when the targets search left quota or
+// topology usage behind in the snapshot.
+func checkSnapshotUnchanged(t *testing.T, snapshot *schdcache.Snapshot) func() {
+	t.Helper()
+	usage := maps.Clone(snapshot.ClusterQueue("borrower").ResourceNode.Usage)
+	capacity, err := snapshot.ClusterQueue("incoming").TASFlavors["tas"].SerializeFreeCapacityPerDomain()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return func() {
+		t.Helper()
+		if diff := gocmp.Diff(usage, snapshot.ClusterQueue("borrower").ResourceNode.Usage); diff != "" {
+			t.Errorf("quota snapshot changed (-before/+after):\n%s", diff)
+		}
+		after, err := snapshot.ClusterQueue("incoming").TASFlavors["tas"].SerializeFreeCapacityPerDomain()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if diff := gocmp.Diff(capacity, after); diff != "" {
+			t.Errorf("topology snapshot changed (-before/+after):\n%s", diff)
+		}
+	}
+}
+
+func TestPreemptionShrinksElasticVictimKeepingTopologyUsage(t *testing.T) {
+	cases := map[string]struct {
+		cluster     elasticTopologyCluster
+		wantTargets []string
+	}{
+		"the pod a shrunk victim keeps still occupies the only node": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x1": 2},
+			},
+		},
+		"a whole victim on another node is evicted when the shrunk victim's node stays occupied": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2"}, borrowerNominal: "2",
+				elasticPods: map[string]int32{"x1": 2},
+				others:      []elasticTopologyOther{{name: "x2-worker", clusterQueue: "borrower", node: "x2", age: time.Hour}},
+			},
+			wantTargets: []string{"x2-worker"},
+		},
+		"shrinking a victim spread over both nodes frees neither node": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x1": 1, "x2": 1},
+			},
+		},
+		"the victim is shrunk when its pods occupy another node than the one the preemptor takes": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x2": 2},
+			},
+			wantTargets: []string{"elastic/1"},
+		},
+		"a victim whose node the preemptor takes is not added back while a shrunk victim keeps its node": {
+			cluster: elasticTopologyCluster{
+				nodes: []string{"x1", "x2"}, borrowerNominal: "1",
+				elasticPods: map[string]int32{"x1": 2}, elasticAge: time.Hour,
+				others: []elasticTopologyOther{{name: "x2-worker", clusterQueue: "borrower", node: "x2"}},
+			},
+			wantTargets: []string{"elastic/1", "x2-worker"},
+		},
+	}
+	modes := []struct {
+		name         string
+		cacheEnabled bool
+		fairSharing  *config.FairSharing
+	}{
+		{name: "classical/cache=false"},
+		{name: "classical/cache=true", cacheEnabled: true},
+		{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	}
+	for _, mode := range modes {
+		t.Run(mode.name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+			for name, tc := range cases {
+				t.Run(name, func(t *testing.T) {
+					features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+					ctx, log := utiltesting.ContextWithLog(t)
+					setup := tc.cluster.build(ctx, t, log)
+					check := checkSnapshotUnchanged(t, setup.snapshot)
+					preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, mode.fairSharing, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+					targets := preemptor.GetTargetsWithStrategy(ctx, preemptor.GetPreemptionStrategyIterator(ctx, setup.incoming, setup.snapshot, setup.assignment))
+					if diff := gocmp.Diff(tc.wantTargets, targetNames(targets), cmpopts.EquateEmpty()); diff != "" {
+						t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+					}
+					check()
+				})
+			}
+		})
+	}
+}
