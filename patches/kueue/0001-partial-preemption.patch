+// count pods: the quota of every other pod set and of count pods of psName,
+// and all of its TAS usage. A shrink frees no topology capacity because the
+// shrunk workload keeps its TopologyAssignment, from which Kueue counts its
+// TAS usage, and which pods the job deletes is not known here.
+func shrunkUsage(wl *workload.Info, psName string, count int32) workload.Usage {
+	assigned := make(resources.FlavorResourceQuantities)
+	for _, ps := range wl.TotalRequests {
+		requests := ps.Requests
