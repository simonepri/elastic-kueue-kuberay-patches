+func TestPreemptionFillsBackVictimsBeforeShrinking(t *testing.T) {
+	// ClusterQueue "b1" borrows all its usage: "w1", one pod of 2 CPUs,
+	// which is offered first, and "elastic", 3 pods of 2 CPUs with no
+	// minimum. The preemptor needs 4 CPUs. Once both are removed, "w1" is put
+	// back before "elastic" is shrunk, so shrinking "elastic" to 1 pod is
+	// enough and "w1" keeps running.
+	now := time.Now().Truncate(time.Second)
+	admission := func(count int32, cpu string) *kueue.Admission {
+		return utiltestingapi.MakeAdmission("b1").PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(count).Assignment(corev1.ResourceCPU, "default", cpu).Obj()).Obj()
+	}
+	admitted := []kueue.Workload{
+		*utiltestingapi.MakeWorkload("w1", "default").Priority(0).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").Obj()).
+			ReserveQuotaAt(admission(1, "2"), now.Add(-time.Hour)).Obj(),
+		*utiltestingapi.MakeWorkload("elastic", "default").Priority(1).
+			PodSets(*utiltestingapi.MakePodSet("main", 3).SetMinimumCount(0).Request(corev1.ResourceCPU, "2").Obj()).
+			ReserveQuotaAt(admission(3, "6"), now.Add(-2*time.Hour)).Obj(),
+	}
+	modes := []struct {
+		name        string
+		fairSharing *config.FairSharing
+	}{
+		{name: "classical"},
+		{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	}
+	for _, mode := range modes {
+		t.Run(mode.name, func(t *testing.T) {
+			ctx, log := utiltesting.ContextWithLog(t)
+			cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+				WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+			cache := schdcache.New(cl)
+			cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+			for name, nominal := range map[kueue.ClusterQueueReference]string{"incoming": "2", "b1": "0", "b2": "6"} {
+				cq := utiltestingapi.MakeClusterQueue(string(name)).Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, nominal).Obj())
+				if name == "incoming" {
+					cq.Preemption(kueue.ClusterQueuePreemption{
+						ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority,
+						BorrowWithinCohort:  &kueue.BorrowWithinCohort{Policy: kueue.BorrowWithinCohortPolicyLowerPriority},
+					})
+				}
+				if err := cache.AddClusterQueue(ctx, cq.Obj()); err != nil {
+					t.Fatal(err)
+				}
+			}
+			snapshot, err := cache.Snapshot(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			check := checkClusterQueueUsageUnchanged(t, snapshot, "b1", "b2")
+			incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").Priority(2).
+				PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "4").Obj()).Obj())
+			incoming.ClusterQueue = "incoming"
+			assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+				Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("4")},
+				Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "default", Mode: flavorassigner.Preempt}},
+			}}}
+			preemptor := newShrinkingPreemptor(mode.fairSharing)
+			targets := preemptor.GetTargetsWithStrategy(ctx, preemptor.GetPreemptionStrategyIterator(ctx, *incoming, snapshot, assignment))
+			if diff := gocmp.Diff([]string{"elastic/1"}, targetNames(targets)); diff != "" {
+				t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+			}
+			check()
+		})
+	}
+}
