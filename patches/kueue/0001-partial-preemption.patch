+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingjob "sigs.k8s.io/kueue/pkg/util/testingjobs/job"
+	testingrayutil "sigs.k8s.io/kueue/pkg/util/testingjobs/raycluster"
+)
+
+// TestScaleDownSteps checks that only workloads of jobs whose integration
+// follows a shrink while they run may be shrunk: a RayCluster may, by whole
+// replicas, while a Job with a minimum parallelism may not.
+func TestScaleDownSteps(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	batchJob := testingjob.MakeJob("job", "default").UID("job").Parallelism(4).
+		SetAnnotation(job.JobMinParallelismAnnotation, "1").Obj()
+	cluster := testingrayutil.MakeCluster("cluster", "default").UID("cluster").
+		WithWorkerGroups(*testingrayutil.MakeWorkerGroup("workers", 3).Obj()).
+		WithNumOfHosts("workers", 2).Obj()
+	cl := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(batchJob, cluster).Build()
+	steps := jobframework.NewScaleDownSteps(cl, NewIntegrationManager())
+
+	cases := map[string]struct {
+		workload  *kueue.Workload
+		wantSteps map[kueue.PodSetReference]int32
+		wantOK    bool
+	}{
+		"a RayCluster scales by whole replicas": {
+			workload: utiltestingapi.MakeWorkload("cluster", "default").
+				ControllerReference(rayv1.GroupVersion.WithKind("RayCluster"), "cluster", "cluster").Obj(),
+			wantSteps: map[kueue.PodSetReference]int32{"workers": 2},
+			wantOK:    true,
+		},
+		"a Job with a minimum parallelism cannot scale down": {
+			workload: utiltestingapi.MakeWorkload("job", "default").
+				ControllerReference(batchv1.SchemeGroupVersion.WithKind("Job"), "job", "job").Obj(),
+		},
+		"a workload whose RayCluster was replaced cannot scale down": {
+			workload: utiltestingapi.MakeWorkload("cluster", "default").
+				ControllerReference(rayv1.GroupVersion.WithKind("RayCluster"), "cluster", "old-cluster").Obj(),
+		},
+		"a workload without a job cannot scale down": {
+			workload: utiltestingapi.MakeWorkload("standalone", "default").Obj(),
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			gotSteps, gotOK := steps(ctx, tc.workload)
+			if gotOK != tc.wantOK {
+				t.Errorf("can scale down = %t, want %t", gotOK, tc.wantOK)
+			}
+			if diff := cmp.Diff(tc.wantSteps, gotSteps); diff != "" {
+				t.Errorf("unexpected steps (-want/+got):\n%s", diff)
+			}
+		})
+	}
+}
