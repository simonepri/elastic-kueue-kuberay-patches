+
+package preemption
+
+import (
+	"context"
+	"slices"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/utils/ptr"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/resources"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// PodSetScaleDown describes how a pod set of a running job scales down: by
+// Step pods at a time, to no fewer than MinCount pods.
+type PodSetScaleDown struct {
+	Step     int32
+	MinCount int32
+}
+
+// ScaleDownLimits reports whether the job of wl can scale down while it runs
+// and, if so, how each of its pod sets that may scale down does. Preemption
+// shrinks only such pod sets; it evicts every other workload.
+type ScaleDownLimits func(ctx context.Context, wl *kueue.Workload) (map[kueue.PodSetReference]PodSetScaleDown, bool)
+
+// SetScaleDownLimits sets how the preemptor learns which workloads it may
+// shrink instead of evicting. Without it, the preemptor evicts every victim.
+func (p *Preemptor) SetScaleDownLimits(limits ScaleDownLimits) {
+	p.scaleDownLimits = limits
+}
+
+// elasticPodSet is the pod set of a workload that preemption shrinks instead
+// of evicting the workload.
+type elasticPodSet struct {
+	name string
+	// count is how many pods the pod set counts, which leaves out its
+	// reclaimable pods.
+	count int32
+	// minCount is the fewest pods it may keep, a multiple of step.
+	minCount int32
+	// step is the number of pods by which the pod set scales.
+	step int32
+}
+
+// elasticPodSet returns the first pod set of wl with a minimum count that its
+// job can scale down by at least one step without going below the larger of
+// that minimum and the job's own.
+func (p *Preemptor) elasticPodSet(ctx context.Context, wl *workload.Info) (elasticPodSet, bool) {
+	if p.scaleDownLimits == nil || wl == nil || wl.Obj == nil {
+		return elasticPodSet{}, false
+	}
+	var limits map[kueue.PodSetReference]PodSetScaleDown
+	for _, ps := range wl.Obj.Spec.PodSets {
+		if ps.MinCount == nil {
+			continue
+		}
+		if limits == nil {
+			var ok bool
+			if limits, ok = p.scaleDownLimits(ctx, wl.Obj); !ok {
+				return elasticPodSet{}, false
+			}
+		}
+		limit, ok := limits[ps.Name]
+		if !ok || limit.Step <= 0 {
+			continue
+		}
+		for _, psr := range wl.TotalRequests {
+			if psr.Name != ps.Name {
+				continue
+			}
+			minCount := max(*ps.MinCount, limit.MinCount, 0)
+			elastic := elasticPodSet{
+				name:     string(ps.Name),
+				count:    psr.Count,
+				minCount: (minCount + limit.Step - 1) / limit.Step * limit.Step,
+				step:     limit.Step,
+			}
+			if elastic.minCount < elastic.count {
+				return elastic, true
+			}
+		}
+	}
+	return elasticPodSet{}, false
+}
+
+// keptCounts returns the pod counts the pod set may shrink to, the most
+// first: the multiples of step from below count down to minCount.
+func (e elasticPodSet) keptCounts() []int32 {
+	var counts []int32
+	for count := (e.count - 1) / e.step * e.step; count >= e.minCount; count -= e.step {
+		counts = append(counts, count)
+	}
+	return counts
+}
+
+// shrinks tracks the elastic targets of one preemption search.
+type shrinks struct {
+	preemptor *Preemptor
+	snapshot  *schdcache.Snapshot
+	elastic   map[*Target]elasticPodSet
+}
+
+func (p *Preemptor) newShrinks(snapshot *schdcache.Snapshot) *shrinks {
+	return &shrinks{preemptor: p, snapshot: snapshot, elastic: make(map[*Target]elasticPodSet)}
+}
+
+// elasticPodSet returns the elastic pod set of a target, which it looks up
+// once per target.
+func (s *shrinks) elasticPodSet(ctx context.Context, t *Target) (elasticPodSet, bool) {
+	if elastic, ok := s.elastic[t]; ok {
+		return elastic, true
+	}
+	elastic, ok := s.preemptor.elasticPodSet(ctx, t.WorkloadInfo)
+	if ok {
+		s.elastic[t] = elastic
+	}
+	return elastic, ok
+}
+
+// offer shrinks a candidate the strategy just removed from the snapshot to its
+// minimum, when it is elastic, by adding back the usage it keeps.
+func (s *shrinks) offer(ctx context.Context, candidate *Target) {
+	if elastic, ok := s.elasticPodSet(ctx, candidate); ok {
+		s.keep(candidate, elastic, elastic.minCount)
+	}
+}
+
+// keep sets the pods a target keeps, replacing in the snapshot the usage it
+// kept so far, if it was shrunk.
+func (s *shrinks) keep(t *Target, elastic elasticPodSet, count int32) {
+	s.unshrink(t)
+	t.NewCount = ptr.To(count)
+	t.PodSetName = elastic.name
+	t.KeptUsage = shrunkUsage(t.WorkloadInfo, elastic.name, count)
+	s.snapshot.AddWorkloadUsage(t.WorkloadInfo, t.KeptUsage)
+}
+
+// unshrink removes from the snapshot the usage a shrunk target keeps, which
+// leaves the target removed whole.
+func (s *shrinks) unshrink(t *Target) {
+	if t.NewCount != nil {
+		s.snapshot.RemoveWorkloadUsage(t.WorkloadInfo, t.KeptUsage)
+		t.NewCount, t.PodSetName, t.KeptUsage = nil, "", workload.Usage{}
+	}
+}
+
+// shrink is called once the preemptor fits. It goes over the elastic targets,
+// the last offered first, and shrinks each one as little as the preemptor
+// allows: a target removed whole keeps the most pods that still fit, and one
+// shrunk to its minimum grows back as far as still fits. When no shrink of a
+// target removed whole fits, it puts the target back whole, drops it, and
+// reports that the preemptor no longer fits.
+func (s *shrinks) shrink(ctx context.Context, strategy PreemptionStrategy, targets []*Target) ([]*Target, bool) {
+	fits := func() bool { return workloadFits(ctx, strategy.pCtx, strategy.allowBorrowing) }
+	for i := len(targets) - 1; i >= 0; i-- {
+		t := targets[i]
+		elastic, ok := s.elasticPodSet(ctx, t)
+		if !ok {
+			continue
+		}
+		kept := t.NewCount
+		shrunk := false
+		for _, count := range elastic.keptCounts() {
+			if kept != nil && count <= *kept {
+				s.keep(t, elastic, *kept)
+				shrunk = true
+				break
+			}
+			s.keep(t, elastic, count)
+			if shrunk = fits(); shrunk {
+				break
+			}
+		}
+		if !shrunk {
+			s.unshrink(t)
+			s.snapshot.AddWorkload(t.WorkloadInfo)
+			return slices.Delete(targets, i, i+1), false
+		}
+	}
+	return targets, true
+}
+
+// shrinkToMinimum shrinks every shrunk target to its minimum, which only frees
+// more, and reports whether any of them kept more.
+func (s *shrinks) shrinkToMinimum(targets []*Target) bool {
+	changed := false
+	for _, t := range targets {
+		elastic, ok := s.elastic[t]
+		if ok && t.NewCount != nil && *t.NewCount > elastic.minCount {
+			s.keep(t, elastic, elastic.minCount)
+			changed = true
+		}
+	}
+	return changed
+}
+
+// shrunkUsage returns the usage wl keeps when its pod set psName shrinks to
+// count pods: the quota of every other pod set and of count pods of psName,
+// and all of its TAS usage. A shrink frees no topology capacity because the
+// shrunk workload keeps its TopologyAssignment, from which Kueue counts its
+// TAS usage, and which pods the job deletes is not known here.
+func shrunkUsage(wl *workload.Info, psName string, count int32) workload.Usage {
+	assigned := make(resources.FlavorResourceQuantities)
+	for _, ps := range wl.TotalRequests {
+		requests := ps.Requests
+		if string(ps.Name) == psName {
+			requests = ps.SinglePodRequests()
+			if requests != nil {
+				requests = requests.ScaledUp(int64(count))
+			}
+		}
+		if requests == nil {
+			continue
+		}
+		requests.ForEach(func(res corev1.ResourceName, q resources.Amount) {
+			if flavor := ps.Flavors[res]; flavor != "" {
+				fr := resources.FlavorResource{Flavor: flavor, Resource: res}
+				assigned[fr] = assigned[fr].Add(q)
+			}
+		})
+	}
+	return workload.Usage{Quota: workload.ResourceUsage{Assigned: assigned}, TAS: wl.TASUsage()}
+}
+
+// releasedUsage returns the usage preempting t frees: all of the workload's
+// usage, or, for a target shrunk to NewCount pods, the quota beyond what it
+// keeps.
+func releasedUsage(t *Target) workload.Usage {
+	usage := t.WorkloadInfo.Usage()
+	if t.NewCount == nil {
+		return usage
+	}
+	released := make(resources.FlavorResourceQuantities, len(usage.Quota.Assigned))
+	for fr, q := range usage.Quota.Assigned {
+		released[fr] = q.Sub(t.KeptUsage.Quota.Assigned[fr])
+	}
+	return workload.Usage{Quota: workload.ResourceUsage{Assigned: released}}
+}
