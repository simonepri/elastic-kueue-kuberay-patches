+package jobframework
+
+import (
+	"context"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption"
+)
+
+// NewScaleDownLimits returns the preemption.ScaleDownLimits of the jobs the
+// enabled integrations of m manage: a workload's job can scale down when its
+// integration implements JobWithDynamicScaling, and scales by the limits the
+// job reports. It reads the job through c, whose cache the integration's
+// controller already fills, so it never reads a kind no controller watches.
+func NewScaleDownLimits(c client.Client, m *IntegrationManager) preemption.ScaleDownLimits {
+	return func(ctx context.Context, wl *kueue.Workload) (map[kueue.PodSetReference]preemption.PodSetScaleDown, bool) {
+		owner := metav1.GetControllerOf(wl)
+		if owner == nil {
+			return nil, false
+		}
+		gv, err := schema.ParseGroupVersion(owner.APIVersion)
+		if err != nil {
+			return nil, false
+		}
+		integration, ok := m.enabledIntegrationByGVK(gv.WithKind(owner.Kind))
+		if !ok || integration.NewJob == nil {
+			return nil, false
+		}
+		job := integration.NewJob()
+		scaler, ok := job.(JobWithDynamicScaling)
+		if !ok {
+			return nil, false
+		}
+		if err := c.Get(ctx, client.ObjectKey{Namespace: wl.Namespace, Name: owner.Name}, job.Object()); err != nil || job.Object().GetUID() != owner.UID {
+			return nil, false
+		}
+		return scaler.ScaleDownLimits(), true
+	}
+}
+
+// enabledIntegrationByGVK returns the callbacks of the enabled integration for
+// gvk.
+func (m *IntegrationManager) enabledIntegrationByGVK(gvk schema.GroupVersionKind) (IntegrationCallbacks, bool) {
+	enabled := m.getEnabledIntegrations()
+	for _, name := range m.getList() {
+		integration, ok := m.get(name)
+		if ok && enabled.Has(name) && integration.matchingGVK(gvk) {
+			return integration, true
+		}
+	}
+	return IntegrationCallbacks{}, false
+}
