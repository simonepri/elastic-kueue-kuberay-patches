+// SimulateShrinks removes from the snapshot the usage that the shrunk targets
+// give up, which is their usage beyond what they keep, KeptUsage, and returns
+// a function that adds it back. The shrunk targets stay in their
+// ClusterQueues.
+func (p PreemptedWorkloads) SimulateShrinks(snapshot *schdcache.Snapshot) func() {
+	var shrunk []*Target
+	for _, target := range p {
+		if target.NewCount != nil {
+			shrunk = append(shrunk, target)
+			snapshot.RemoveWorkloadUsage(target.WorkloadInfo, target.WorkloadInfo.Usage())
+			snapshot.AddWorkloadUsage(target.WorkloadInfo, target.KeptUsage)
+		}
+	}
+	return func() {
+		for _, target := range shrunk {
+			snapshot.RemoveWorkloadUsage(target.WorkloadInfo, target.KeptUsage)
+			snapshot.AddWorkloadUsage(target.WorkloadInfo, target.WorkloadInfo.Usage())
+		}
+	}
 }
