+func TestFairPreemptionVerifiesShrunkTargetShare(t *testing.T) {
+	// Fair sharing compares the shares of the victim's ClusterQueue before and
+	// after the preemption. Before it, "b" holds all 12 pods of "elastic":
+	// shrinking "elastic" to the pods "a" needs leaves "b" with a share the
+	// preemption strategies do not allow taking from.
+	ctx, log := utiltesting.ContextWithLog(t)
+	now := time.Now().Truncate(time.Second)
+	admission := func(cq kueue.ClusterQueueReference, count int32, cpu string) *kueue.Admission {
+		return utiltestingapi.MakeAdmission(cq).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(count).Assignment(corev1.ResourceCPU, "default", cpu).Obj()).Obj()
+	}
+	admitted := []kueue.Workload{
+		*utiltestingapi.MakeWorkload("a1", "default").Priority(0).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "500m").Obj()).
+			ReserveQuotaAt(admission("a", 1, "500m"), now.Add(-time.Hour)).Obj(),
+		*utiltestingapi.MakeWorkload("elastic", "default").Priority(0).
+			PodSets(*utiltestingapi.MakePodSet("main", 12).SetMinimumCount(1).Request(corev1.ResourceCPU, "1").Obj()).
+			ReserveQuotaAt(admission("b", 12, "12"), now.Add(-time.Hour)).Obj(),
+	}
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("a").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "10").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{
+				WithinClusterQueue:  kueue.PreemptionPolicyLowerPriority,
+				ReclaimWithinCohort: kueue.PreemptionPolicyAny,
+			}).Obj(),
+		utiltestingapi.MakeClusterQueue("b").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "9750m").Obj()).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	check := checkClusterQueueUsageUnchanged(t, snapshot, "a", "b")
+	incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").Priority(1).
+		PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "12150m").Obj()).Obj())
+	incoming.ClusterQueue = "a"
+	assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+		Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("12150m")},
+		Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "default", Mode: flavorassigner.Preempt}},
+	}}}
+	preemptor := newShrinkingPreemptor(&config.FairSharing{})
+	targets := preemptor.GetTargetsWithStrategy(ctx, preemptor.GetPreemptionStrategyIterator(ctx, *incoming, snapshot, assignment))
+	if got := targetNames(targets); len(got) > 0 {
+		t.Errorf("preemption found targets %v, want none", got)
+	}
+	check()
+}
