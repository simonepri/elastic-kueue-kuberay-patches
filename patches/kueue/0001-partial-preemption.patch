+// SyncScale lowers each worker group to the count that partial preemption left
+// admitted, which the workload records with its Preempted condition until the
+// next admission or re-expansion clears it. An elastic RayCluster only follows
+// such a shrink: workload slicing tracks its other resizes, so raising replicas
+// would revert a scale-down and lowering them on a partial admission would
+// revert a pending scale-up. A RayCluster without workload slicing runs the
+// admitted count in either direction, which re-expansion relies on.
+func (j *RayCluster) SyncScale(wl *kueue.Workload) bool {
+	if wl == nil || wl.Status.Admission == nil {
+		return false
+	}
+	elastic := isAnElasticJob((*rayv1.RayCluster)(j))
+	if elastic && !apimeta.IsStatusConditionTrue(wl.Status.Conditions, kueue.WorkloadPreempted) {
+		return false
+	}
+	changed := false
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		if psa.Name == headGroupPodSetName || psa.Count == nil {
+			continue
+		}
+		for i := range j.Spec.WorkerGroupSpecs {
+			wgs := &j.Spec.WorkerGroupSpecs[i]
+			if !strings.EqualFold(wgs.GroupName, string(psa.Name)) {
+				continue
+			}
+			targetCount := *psa.Count
+			if wgs.NumOfHosts > 1 {
+				targetCount /= wgs.NumOfHosts
+			}
+			if wgs.MaxReplicas != nil && targetCount > *wgs.MaxReplicas {
+				targetCount = *wgs.MaxReplicas
+			}
+			if elastic && (wgs.Replicas == nil || *wgs.Replicas <= targetCount) {
+				continue
+			}
+			if wgs.Replicas == nil || *wgs.Replicas != targetCount {
+				wgs.Replicas = ptr.To(targetCount)
+				changed = true
+			}
+		}
+	}
+	return changed
+}
