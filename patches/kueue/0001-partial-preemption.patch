+// TestScheduleCountsWhatAShrunkVictimKeeps checks that a preemptor whose
+// victim is only shrunk does not leave the quota of the victim's kept pods to
+// another preemptor in the same cycle. Every workload but the preemptors has
+// priority 1, and among preemptors that borrow alike, "a-new" is processed
+// first, as it was created first.
+func TestScheduleCountsWhatAShrunkVictimKeeps(t *testing.T) {
+	cases := map[string]struct {
+		clusterQueues map[kueue.ClusterQueueReference]string
+		admitted      []shrinkCycleWorkload
+		preemptors    []shrinkCycleWorkload
+		wantPreempted []string
+	}{
+		// "a-new" can shrink "elastic" to 1 pod, borrowing the CPU "b" does
+		// not use, and "b-new" can evict "worker" at the start of the cycle.
+		// "b-new" goes first, as it does not borrow. Once it books its usage,
+		// "a-new" fits only if "elastic" gives up both pods.
+		"a preemptor does not count on the pods a victim shrunk for another preemptor keeps": {
+			clusterQueues: map[kueue.ClusterQueueReference]string{"a": "2", "b": "2"},
+			admitted: []shrinkCycleWorkload{
+				{name: "elastic", clusterQueue: "a", pods: 2, minCount: 1, age: time.Hour},
+				{name: "worker", clusterQueue: "b", pods: 1, age: time.Hour},
+			},
+			preemptors: []shrinkCycleWorkload{
+				{name: "a-new", clusterQueue: "a", cpu: "2", age: 2 * time.Minute},
+				{name: "b-new", clusterQueue: "b", cpu: "2", age: time.Minute},
+			},
+			wantPreempted: []string{"worker"},
+		},
+		// Both preemptors first pick "elastic", the newest workload of
+		// "borrower". "b-new" overlaps "a-new", so the scheduler searches its
+		// targets again with "elastic" shrunk, where only "worker", the newer
+		// of the other two, needs to go.
+		"a preemptor whose targets overlap a shrunk victim does not take it again": {
+			clusterQueues: map[kueue.ClusterQueueReference]string{"a": "2", "b": "2", "borrower": "0"},
+			admitted: []shrinkCycleWorkload{
+				{name: "elastic", clusterQueue: "borrower", pods: 2, minCount: 1, age: time.Minute},
+				{name: "worker", clusterQueue: "borrower", pods: 1, age: time.Hour},
+				{name: "other-worker", clusterQueue: "borrower", pods: 1, age: 2 * time.Hour},
+			},
+			preemptors: []shrinkCycleWorkload{
+				{name: "a-new", clusterQueue: "a", cpu: "1", age: 2 * time.Minute},
+				{name: "b-new", clusterQueue: "b", cpu: "1", age: time.Minute},
+			},
+			wantPreempted: []string{"elastic", "worker"},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got := runShrinkCycle(t, tc.clusterQueues, tc.admitted, tc.preemptors)
+			if diff := cmp.Diff(tc.wantPreempted, got); diff != "" {
+				t.Errorf("unexpected preempted workloads (-want/+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+// shrinkCycleWorkload is a workload of runShrinkCycle: an admitted one runs
+// pods pods of 1 CPU, with minCount as their minimum when it is positive, and
+// a preemptor of priority 3 requests one pod of cpu.
+type shrinkCycleWorkload struct {
+	name         string
+	clusterQueue kueue.ClusterQueueReference
+	pods         int32
+	minCount     int32
+	cpu          string
+	age          time.Duration
+}
+
+// runShrinkCycle runs one scheduling cycle with ClusterQueues of the given
+// nominal CPU quotas in one Cohort, each reclaiming from the others and
+// preempting within itself, and returns the sorted names of the workloads the
+// cycle preempted.
+func runShrinkCycle(t *testing.T, clusterQueues map[kueue.ClusterQueueReference]string, admitted, preemptors []shrinkCycleWorkload) []string {
+	t.Helper()
+	now := time.Now().Truncate(time.Second)
+	ctx, log := utiltesting.ContextWithLog(t)
+	var workloads []kueue.Workload
+	for _, w := range admitted {
+		podSet := utiltestingapi.MakePodSet("main", int(w.pods)).Request(corev1.ResourceCPU, "1")
+		if w.minCount > 0 {
+			podSet.SetMinimumCount(w.minCount)
+		}
+		admission := utiltestingapi.MakeAdmission(w.clusterQueue).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(w.pods).
+				Assignment(corev1.ResourceCPU, "default", fmt.Sprint(w.pods)).Obj()).Obj()
+		workloads = append(workloads, *utiltestingapi.MakeWorkload(w.name, "default").Priority(1).PodSets(*podSet.Obj()).
+			ReserveQuotaAt(admission, now.Add(-w.age)).AdmittedAt(true, now.Add(-w.age)).Obj())
+	}
+	var localQueues []kueue.LocalQueue
+	for _, w := range preemptors {
+		workloads = append(workloads, *utiltestingapi.MakeWorkload(w.name, "default").Queue(kueue.LocalQueueName(w.clusterQueue)).
+			Priority(3).Creation(now.Add(-w.age)).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, w.cpu).Obj()).Obj())
+		localQueues = append(localQueues, *utiltestingapi.MakeLocalQueue(string(w.clusterQueue), "default").ClusterQueue(string(w.clusterQueue)).Obj())
+	}
+	cl := utiltesting.NewClientBuilder().
+		WithLists(&kueue.WorkloadList{Items: workloads}, &kueue.LocalQueueList{Items: localQueues}).
+		WithObjects(utiltesting.MakeNamespace("default")).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithStatusSubresource(&kueue.Workload{}).Build()
+	cqCache := schdcache.New(cl)
+	cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	fakeClock := testingclock.NewFakeClock(now)
+	qManager := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithClock(fakeClock))
+	for _, name := range slices.Sorted(maps.Keys(clusterQueues)) {
+		cq := utiltestingapi.MakeClusterQueue(string(name)).Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, clusterQueues[name]).Obj()).
+			Preemption(kueue.ClusterQueuePreemption{
+				WithinClusterQueue:  kueue.PreemptionPolicyLowerPriority,
+				ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority,
+			}).Obj()
+		if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+		if err := qManager.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := range localQueues {
+		if err := qManager.AddLocalQueue(ctx, &localQueues[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	scheduler := New(qManager, cqCache, cl, &utiltesting.EventRecorder{}, WithClock(t, fakeClock), WithPreemptionExpectations(preemptexpectations.New()),
+		WithScaleDownSteps(scaleDownByOnePod))
+	wg := sync.WaitGroup{}
+	scheduler.setAdmissionRoutineWrapper(routine.NewWrapper(func() { wg.Add(1) }, func() { wg.Done() }))
+
+	scheduler.schedule(ctx)
+	wg.Wait()
+
+	var got kueue.WorkloadList
+	if err := cl.List(ctx, &got); err != nil {
+		t.Fatal(err)
+	}
+	var preempted []string
+	for _, wl := range got.Items {
+		if apimeta.IsStatusConditionTrue(wl.Status.Conditions, kueue.WorkloadPreempted) {
+			preempted = append(preempted, wl.Name)
+		}
+	}
+	slices.Sort(preempted)
+	return preempted
+}
+
+// scaleDownByOnePod lets preemption shrink every pod set of every workload by
+// one pod at a time.
+func scaleDownByOnePod(_ context.Context, wl *kueue.Workload) (map[kueue.PodSetReference]int32, bool) {
+	steps := make(map[kueue.PodSetReference]int32, len(wl.Spec.PodSets))
+	for _, ps := range wl.Spec.PodSets {
+		steps[ps.Name] = 1
+	}
+	return steps, true
+}
+
+// TestSchedulePlacesThePreemptorBesideAShrunkVictim checks that the topology
+// placement of a preemptor counts the pods a shrunk victim keeps. Node x1
+// holds both pods of "elastic", and node x2 has 3 of its 4 CPUs free. The
+// preemptor needs 2 CPUs on one node and one CPU of quota that shrinking
+// "elastic" frees, so it goes on x2 while "elastic" keeps x1.
+func TestSchedulePlacesThePreemptorBesideAShrunkVictim(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+	now := time.Now().Truncate(time.Second)
+	ctx, log := utiltesting.ContextWithLog(t)
+	admitted := func(name string, cq kueue.ClusterQueueReference, node string, pods int32, minCount *int32, priority int32) kueue.Workload {
+		podSet := utiltestingapi.MakePodSet("main", int(pods)).Request(corev1.ResourceCPU, "1").RequiredTopologyRequest(corev1.LabelHostname)
+		if minCount != nil {
+			podSet.SetMinimumCount(*minCount)
+		}
+		admission := utiltestingapi.MakeAdmission(cq).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(pods).
+				Assignment(corev1.ResourceCPU, "tas", fmt.Sprint(pods)).
+				TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+					Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, pods).Obj()).Obj()).Obj()).Obj()
+		return *utiltestingapi.MakeWorkload(name, "default").Priority(priority).PodSets(*podSet.Obj()).
+			ReserveQuotaAt(admission, now.Add(-time.Hour)).AdmittedAt(true, now.Add(-time.Hour)).Obj()
+	}
+	workloads := []kueue.Workload{
+		admitted("elastic", "borrower", "x1", 2, ptr.To[int32](1), 1),
+		admitted("fixed", "other", "x2", 1, nil, 5),
+		*utiltestingapi.MakeWorkload("incoming", "default").Queue("incoming").Priority(3).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").RequiredTopologyRequest(corev1.LabelHostname).Obj()).Obj(),
+	}
+	localQueues := []kueue.LocalQueue{*utiltestingapi.MakeLocalQueue("incoming", "default").ClusterQueue("incoming").Obj()}
+	clientBuilder := utiltesting.NewClientBuilder().
+		WithLists(&kueue.WorkloadList{Items: workloads}, &kueue.LocalQueueList{Items: localQueues}).
+		WithObjects(utiltesting.MakeNamespace("default")).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithStatusSubresource(&kueue.Workload{})
+	_ = tasindexer.SetupIndexes(ctx, utiltesting.AsIndexer(clientBuilder))
+	cl := clientBuilder.Build()
+	cqCache := schdcache.New(cl)
+	cqCache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+	cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+	for node, cpu := range map[string]string{"x1": "2", "x2": "4"} {
+		cqCache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+			StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse(cpu), corev1.ResourcePods: resource.MustParse("10")}).
+			Ready().Obj())
+	}
+	fakeClock := testingclock.NewFakeClock(now)
+	qManager := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithClock(fakeClock))
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "2").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "1").Obj()).Obj(),
+		utiltestingapi.MakeClusterQueue("other").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "1").Obj()).Obj(),
+	} {
+		if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+		if err := qManager.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := qManager.AddLocalQueue(ctx, &localQueues[0]); err != nil {
+		t.Fatal(err)
+	}
+	scheduler := New(qManager, cqCache, cl, &utiltesting.EventRecorder{}, WithClock(t, fakeClock), WithPreemptionExpectations(preemptexpectations.New()),
+		WithScaleDownSteps(scaleDownByOnePod))
+	wg := sync.WaitGroup{}
+	scheduler.setAdmissionRoutineWrapper(routine.NewWrapper(func() { wg.Add(1) }, func() { wg.Done() }))
+
+	scheduler.schedule(ctx)
+	wg.Wait()
+
+	var got kueue.Workload
+	if err := cl.Get(ctx, client.ObjectKey{Namespace: "default", Name: "elastic"}, &got); err != nil {
+		t.Fatal(err)
+	}
+	if !apimeta.IsStatusConditionTrue(got.Status.Conditions, kueue.WorkloadPreempted) {
+		t.Fatal("elastic was not preempted")
+	}
+	if diff := cmp.Diff(int32(1), ptr.Deref(got.Status.Admission.PodSetAssignments[0].Count, 0)); diff != "" {
+		t.Errorf("unexpected pods kept by elastic (-want/+got):\n%s", diff)
