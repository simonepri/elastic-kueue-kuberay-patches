+// equivalentScaledPodSets compares the pod sets of a running job that follows
+// a shrink of its admitted counts with those of its Workload. An elastic pod
+// set may run any count, and its minimum is not compared: earlier releases
+// encoded it differently, and preemption reads it from the job itself, so a
+// different minimum must not suspend a running job.
+func equivalentScaledPodSets(jobPodSets, reference []kueue.PodSet, opts ...equality.ComparePodSetsOption) bool {
+	jobCopy := append([]kueue.PodSet(nil), jobPodSets...)
+	for i := range jobCopy {
+		if i >= len(reference) || jobCopy[i].Name != reference[i].Name {
+			continue
