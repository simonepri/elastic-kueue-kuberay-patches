+
+// TestScaleDownLimits checks that only workloads of jobs whose enabled
+// integration follows a shrink while they run may be shrunk: an elastic
+// RayCluster may, by whole replicas, while a Job with a minimum parallelism
+// may not, and a disabled integration's job is never read.
+func TestScaleDownLimits(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	batchJob := testingjob.MakeJob("job", "default").UID("job").Parallelism(4).
+		SetAnnotation(job.JobMinParallelismAnnotation, "1").Obj()
+	cluster := testingrayutil.MakeCluster("cluster", "default").UID("cluster").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		WithWorkerGroups(*testingrayutil.MakeWorkerGroup("workers", 3).Obj()).
+		WithNumOfHosts("workers", 2).Obj()
+	cluster.Spec.WorkerGroupSpecs[0].MinReplicas = ptr.To[int32](1)
+	enabled := NewIntegrationManager()
+	enabled.EnableIntegrationsForTest(t, raycluster.FrameworkName, job.FrameworkName)
+
+	cases := map[string]struct {
+		manager    *jobframework.IntegrationManager
+		workload   *kueue.Workload
+		wantLimits map[kueue.PodSetReference]preemption.PodSetScaleDown
+		wantOK     bool
+		wantReads  int
+	}{
+		"an elastic RayCluster scales by whole replicas": {
+			manager: enabled,
+			workload: utiltestingapi.MakeWorkload("cluster", "default").
+				ControllerReference(rayv1.GroupVersion.WithKind("RayCluster"), "cluster", "cluster").Obj(),
+			wantLimits: map[kueue.PodSetReference]preemption.PodSetScaleDown{"workers": {Step: 2, MinCount: 2}},
+			wantOK:     true,
+			wantReads:  1,
+		},
+		"a Job with a minimum parallelism cannot scale down": {
+			manager: enabled,
+			workload: utiltestingapi.MakeWorkload("job", "default").
+				ControllerReference(batchv1.SchemeGroupVersion.WithKind("Job"), "job", "job").Obj(),
+		},
+		"a workload whose RayCluster was replaced cannot scale down": {
+			manager: enabled,
+			workload: utiltestingapi.MakeWorkload("cluster", "default").
+				ControllerReference(rayv1.GroupVersion.WithKind("RayCluster"), "cluster", "old-cluster").Obj(),
+			wantReads: 1,
+		},
+		"a RayCluster whose integration is disabled is not read": {
+			manager: NewIntegrationManager(),
+			workload: utiltestingapi.MakeWorkload("cluster", "default").
+				ControllerReference(rayv1.GroupVersion.WithKind("RayCluster"), "cluster", "cluster").Obj(),
+		},
+		"a workload without a job cannot scale down": {
+			manager:  enabled,
+			workload: utiltestingapi.MakeWorkload("standalone", "default").Obj(),
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			reads := 0
+			cl := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(batchJob, cluster).
+				WithInterceptorFuncs(interceptor.Funcs{Get: func(ctx context.Context, c client.WithWatch, key client.ObjectKey, obj client.Object, opts ...client.GetOption) error {
+					reads++
+					return c.Get(ctx, key, obj, opts...)
+				}}).Build()
+			gotLimits, gotOK := jobframework.NewScaleDownLimits(cl, tc.manager)(ctx, tc.workload)
+			if gotOK != tc.wantOK {
+				t.Errorf("can scale down = %t, want %t", gotOK, tc.wantOK)
+			}
+			if diff := cmp.Diff(tc.wantLimits, gotLimits); diff != "" {
+				t.Errorf("unexpected limits (-want/+got):\n%s", diff)
+			}
+			if reads != tc.wantReads {
+				t.Errorf("read %d jobs, want %d", reads, tc.wantReads)
+			}
+		})
+	}
+}
