+		}
+	}
+	slices.Sort(preempted)
+	// "a-new" comes first, as it was created first.
+	if diff := cmp.Diff([]string{"elastic"}, preempted); diff != "" {
+		t.Errorf("unexpected preempted workloads (-want/+got):\n%s", diff)
+	}
+}
