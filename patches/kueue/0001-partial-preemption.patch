+func TestPreemptionShrinksElasticVictimKeepingQuotaUsage(t *testing.T) {
+	cases := map[string]elasticShrinkCase{
+		"a victim is not added back while the shrunk victim's kept pods use the quota it needs": {
+			cluster: elasticTopologyCluster{
