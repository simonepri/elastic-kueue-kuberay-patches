+func (j *RayCluster) SyncScale(wl *kueue.Workload) bool {
+	if wl == nil || wl.Status.Admission == nil {
+		return false
+	}
+	changed := false
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		if psa.Name == headGroupPodSetName {
+			continue
+		}
+		for i := range j.Spec.WorkerGroupSpecs {
+			wgs := &j.Spec.WorkerGroupSpecs[i]
+			if strings.EqualFold(wgs.GroupName, string(psa.Name)) {
+				if psa.Count != nil {
+					targetCount := *psa.Count
+					if wgs.NumOfHosts > 1 {
+						targetCount = targetCount / wgs.NumOfHosts
+					}
+					if wgs.MaxReplicas != nil && targetCount > *wgs.MaxReplicas {
+						targetCount = *wgs.MaxReplicas
+					}
+					if wgs.Replicas == nil || *wgs.Replicas != targetCount {
+						wgs.Replicas = ptr.To(targetCount)
+						changed = true
+					}
+				}
+			}
+		}
+	}
+	return changed
+}
+
+// ScaleDownLimits returns, for each worker group of an elastic cluster, its
+// scale down in pods: KubeRay scales a group by whole replicas of NumOfHosts
+// pods, down to minReplicas. A cluster that is not elastic keeps its size.
+func (j *RayCluster) ScaleDownLimits() map[kueue.PodSetReference]preemption.PodSetScaleDown {
+	if !elasticWorkerGroups(j.Annotations) {
+		return nil
+	}
+	limits := make(map[kueue.PodSetReference]preemption.PodSetScaleDown, len(j.Spec.WorkerGroupSpecs))
+	for i := range j.Spec.WorkerGroupSpecs {
+		wgs := &j.Spec.WorkerGroupSpecs[i]
+		hosts := max(wgs.NumOfHosts, 1)
+		limits[kueue.NewPodSetReference(wgs.GroupName)] = preemption.PodSetScaleDown{
+			Step:     hosts,
+			MinCount: ptr.Deref(wgs.MinReplicas, 0) * hosts,
+		}
+	}
+	return limits
+}
