+func (j *RayCluster) SyncScale(wl *kueue.Workload) bool {
+	if wl == nil || wl.Status.Admission == nil {
+		return false
+	}
+	changed := false
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		if psa.Name == headGroupPodSetName {
+			continue
+		}
+		for i := range j.Spec.WorkerGroupSpecs {
+			wgs := &j.Spec.WorkerGroupSpecs[i]
+			if strings.EqualFold(wgs.GroupName, psa.Name) {
+				if psa.Count != nil && (wgs.Replicas == nil || *wgs.Replicas != *psa.Count) {
+					wgs.Replicas = ptr.To(*psa.Count)
+					changed = true
+				}
+			}
+		}
+	}
+	return changed
+}
