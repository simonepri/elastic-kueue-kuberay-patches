+// releasedUsage returns the usage preempting t frees: all of the workload's
+// usage, or, for a target shrunk to NewCount pods, the quota beyond what it
+// keeps.
+func releasedUsage(t *Target) workload.Usage {
+	usage := t.WorkloadInfo.Usage()
