+// podSetSteps returns the number of pods by which each pod set of wl scales,
+// for the pod sets whose job scales by more than one pod at a time, so that
+// partial admission admits only counts the job can run.
+func (s *Scheduler) podSetSteps(ctx context.Context, wl *kueue.Workload) map[kueue.PodSetReference]int32 {
+	if s.scaleDownLimits == nil {
+		return nil
+	}
+	limits, ok := s.scaleDownLimits(ctx, wl)
+	if !ok {
+		return nil
+	}
+	steps := make(map[kueue.PodSetReference]int32, len(limits))
+	for name, limit := range limits {
+		if limit.Step > 1 {
+			steps[name] = limit.Step
+		}
+	}
+	return steps
+}
+
+// roundDownToSteps rounds each count down to a multiple of its pod set's step.
+func roundDownToSteps(counts workload.PodSetsCounts, steps map[kueue.PodSetReference]int32) workload.PodSetsCounts {
+	if len(steps) == 0 {
+		return counts
+	}
+	rounded := maps.Clone(counts)
+	for name, step := range steps {
+		if count, ok := rounded[name]; ok {
+			rounded[name] = count - count%step
+		}
+	}
+	return rounded
+}
