+func TestApplyPartialPreemptionScalesFromTheSpecCount(t *testing.T) {
+	// Without an admitted count, the pod set was admitted at its spec count.
+	ctx, _ := utiltesting.ContextWithLog(t)
+	admission := utiltestingapi.MakeAdmission("borrower").PodSets(
+		utiltestingapi.MakePodSetAssignment("main").Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj()
+	admission.PodSetAssignments[0].Count = nil
+	wl := utiltestingapi.MakeWorkload("elastic", "default").
+		PodSets(*utiltestingapi.MakePodSet("main", 4).SetMinimumCount(1).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(admission, time.Now()).Obj()
+	cl := utiltesting.NewClientBuilder().WithObjects(wl).WithStatusSubresource(&kueue.Workload{}).
+		WithInterceptorFuncs(interceptor.Funcs{SubResourceApply: utiltesting.TreatSSAAsStrategicMergeForApplyConfiguration}).Build()
+	preemptor := New(cl, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+	original := wl.DeepCopy()
+
+	if err := preemptor.applyPartialPreemption(ctx, wl, "main", 2, kueue.InCohortReclamationReason, "shrunk"); err != nil {
+		t.Fatal(err)
+	}
+
+	if diff := gocmp.Diff(original, wl); diff != "" {
+		t.Errorf("the shared workload object changed (-before/+after):\n%s", diff)
+	}
+	var got kueue.Workload
+	if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+		t.Fatal(err)
+	}
+	psa := got.Status.Admission.PodSetAssignments[0]
+	if diff := gocmp.Diff(int32(2), ptr.Deref(psa.Count, 0)); diff != "" {
+		t.Errorf("unexpected admitted count (-want/+got):\n%s", diff)
+	}
+	if cpu := psa.ResourceUsage[corev1.ResourceCPU]; cpu.Cmp(resource.MustParse("2")) != 0 {
+		t.Errorf("admitted CPU is %s, want 2", cpu.String())
+	}
+}
