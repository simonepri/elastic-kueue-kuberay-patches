+func getElasticInfo(wl *workload.Info) (string, int32, int32, bool) {
+	if wl == nil || wl.Obj == nil {
+		return "", 0, 0, false
+	}
+	for _, ps := range wl.Obj.Spec.PodSets {
+		if ps.MinCount != nil {
+			cCount := ps.Count
+			if wl.Obj.Status.Admission != nil {
+				for _, psa := range wl.Obj.Status.Admission.PodSetAssignments {
+					if psa.Name == ps.Name && psa.Count != nil {
+						cCount = *psa.Count
+						break
+					}
+				}
+			}
+			if cCount > *ps.MinCount {
+				return string(ps.Name), cCount, *ps.MinCount, true
+			}
+		}
+	}
+	return "", 0, 0, false
+}
+
+// shrinkTarget finds the most pods, from currentCount-1 down to minCount, that
+// the candidate's pod set psName can keep while the preemptor fits, and marks
+// the candidate to be shrunk to them. The candidate must already be removed
+// from the snapshot. When it finds a count, the usage the candidate keeps
+// stays in the snapshot, so that the checks that follow see it, until
+// restoreSnapshot removes it; otherwise the snapshot is left unchanged.
+func shrinkTarget(ctx context.Context, strategy PreemptionStrategy, candidate *Target, psName string, currentCount, minCount int32) bool {
+	snapshot := strategy.pCtx.snapshot
+	for count := currentCount - 1; count >= minCount; count-- {
+		kept := shrunkUsage(candidate.WorkloadInfo, psName, count)
+		snapshot.AddWorkloadUsage(candidate.WorkloadInfo, kept)
+		if workloadFits(ctx, strategy.pCtx, strategy.allowBorrowing) {
+			candidate.NewCount = ptr.To(count)
+			candidate.PodSetName = psName
+			candidate.KeptUsage = kept
+			return true
+		}
+		snapshot.RemoveWorkloadUsage(candidate.WorkloadInfo, kept)
+	}
+	return false
+}
+
+// shrunkUsage returns the usage wl keeps when its pod set psName shrinks to
+// count pods: the quota of every other pod set and of count pods of psName,
+// and all of its TAS usage. A shrink frees no topology capacity because the
+// shrunk workload keeps its TopologyAssignment, from which Kueue counts its
+// TAS usage, and which pods the job deletes is not known here.
+func shrunkUsage(wl *workload.Info, psName string, count int32) workload.Usage {
+	assigned := make(resources.FlavorResourceQuantities)
+	for _, ps := range wl.TotalRequests {
+		requests := ps.Requests
+		if string(ps.Name) == psName {
+			requests = ps.SinglePodRequests()
+			if requests != nil {
+				requests = requests.ScaledUp(int64(count))
+			}
+		}
+		if requests == nil {
+			continue
+		}
+		requests.ForEach(func(res corev1.ResourceName, q resources.Amount) {
+			if flavor := ps.Flavors[res]; flavor != "" {
+				fr := resources.FlavorResource{Flavor: flavor, Resource: res}
+				assigned[fr] = assigned[fr].Add(q)
+			}
+		})
+	}
+	return workload.Usage{Quota: workload.ResourceUsage{Assigned: assigned}, TAS: wl.TASUsage()}
+}
+
+func (p *Preemptor) applyPartialPreemption(ctx context.Context, w *kueue.Workload, podSetName string, newCount int32, reason, message string) error {
+	return workloadpatching.PatchAdmissionStatus(ctx, p.client, w, p.clock, func(wl *kueue.Workload) (bool, error) {
+		workload.SetPreemptedCondition(wl, p.clock.Now(), reason, message)
+		if wl.Status.Admission != nil {
+			for i := range wl.Status.Admission.PodSetAssignments {
+				psa := &wl.Status.Admission.PodSetAssignments[i]
+				if string(psa.Name) == podSetName {
+					oldCount := ptr.Deref(psa.Count, 1)
+					if oldCount > 0 {
+						for resName, quant := range psa.ResourceUsage {
+							val := quant.MilliValue()
+							newVal := (val * int64(newCount)) / int64(oldCount)
+							quant.SetMilli(newVal)
+							psa.ResourceUsage[resName] = quant
+						}
+					}
+					psa.Count = ptr.To(newCount)
+				}
+			}
+		}
+		return true, nil
+	}, workloadpatching.WithLooseOnApply(), workloadpatching.WithRetryOnConflict())
+}
