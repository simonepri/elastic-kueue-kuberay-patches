+func (r *WorkloadReconciler) tryReexpand(ctx context.Context, wl *kueue.Workload) bool {
+	log := ctrl.LoggerFrom(ctx)
+	if wl.Status.Admission == nil {
+		return false
+	}
+	cqName := string(wl.Status.Admission.ClusterQueue)
+	cqObj := &kueue.ClusterQueue{ObjectMeta: metav1.ObjectMeta{Name: cqName}}
+	if pending, err := r.queues.Pending(cqObj); err == nil && pending > 0 {
+		return false
+	}
+	if infoCount := len(r.queues.PendingWorkloadsInfo(kueue.ClusterQueueReference(cqName))); infoCount > 0 {
+		return false
+	}
+
+	changed := false
+	wlCopy := wl.DeepCopy()
+
+	for i := range wlCopy.Status.Admission.PodSetAssignments {
+		psa := &wlCopy.Status.Admission.PodSetAssignments[i]
+		for _, ps := range wlCopy.Spec.PodSets {
+			if ps.Name == psa.Name {
+				if psa.Count == nil || *psa.Count >= ps.Count {
+					continue
+				}
+				oldCount := *psa.Count
+				if oldCount <= 0 {
+					continue
+				}
+				deltaCount := ps.Count - oldCount
+				reqs := resources.NewRequestsFromResourceList(psa.ResourceUsage)
+				deltaQuota := make(resources.FlavorResourceQuantities)
+				reqs.ForEach(func(res corev1.ResourceName, q resources.Amount) {
+					flv := psa.Flavors[res]
+					if flv != "" {
+						unitAmount := q.QuoInt64(int64(oldCount))
+						deltaAmount := unitAmount.MulInt64(int64(deltaCount))
+						deltaQuota[resources.FlavorResource{Flavor: flv, Resource: res}] = deltaAmount
+					}
+				})
+
+				snap, err := r.cache.Snapshot(ctx)
+				if err != nil {
+					continue
+				}
+				cq := snap.ClusterQueue(kueue.ClusterQueueReference(cqName))
+				fits := cq != nil && cq.Fits(workload.Usage{Quota: workload.ResourceUsage{Assigned: deltaQuota}}) == schdcache.FitsCheckOk
+				if fits {
+					for resName, quant := range psa.ResourceUsage {
+						val := quant.MilliValue()
+						newVal := (val * int64(ps.Count)) / int64(oldCount)
+						quant.SetMilli(newVal)
+						psa.ResourceUsage[resName] = quant
+					}
+					psa.Count = ptr.To(ps.Count)
+					changed = true
+				}
+			}
+		}
+	}
+	if changed {
+		err := workloadpatching.PatchAdmissionStatus(ctx, r.client, wlCopy, r.clock, func(w *kueue.Workload) (bool, error) {
+			apimeta.RemoveStatusCondition(&w.Status.Conditions, kueue.WorkloadPreempted)
+			if w.Status.Admission != nil {
+				w.Status.Admission.PodSetAssignments = wlCopy.Status.Admission.PodSetAssignments
+			}
+			return true, nil
+		}, workloadpatching.WithLooseOnApply(), workloadpatching.WithRetryOnConflict())
+		if err != nil {
+			log.Error(err, "Failed to apply re-expanded admission status", "workload", klog.KObj(wl))
+			return false
+		}
+		r.recorder.Eventf(wl, nil, corev1.EventTypeNormal, "Reexpanded", "Reexpanded", "Workload re-expanded to spec count")
+		return true
+	}
+	return false
+}
+
+func (r *WorkloadReconciler) triggerReexpansionForCQ(ctx context.Context, finishedWl *kueue.Workload) {
+	cqName := ""
+	if finishedWl != nil {
+		if finishedWl.Status.Admission != nil {
+			cqName = string(finishedWl.Status.Admission.ClusterQueue)
+		}
+		if cqName == "" && finishedWl.Spec.QueueName != "" {
+			lq := &kueue.LocalQueue{}
+			if err := r.client.Get(ctx, types.NamespacedName{Namespace: finishedWl.Namespace, Name: string(finishedWl.Spec.QueueName)}, lq); err == nil {
+				cqName = string(lq.Spec.ClusterQueue)
+			}
+		}
+	}
+	var wList kueue.WorkloadList
+	if err := r.client.List(ctx, &wList); err != nil {
+		return
+	}
+	for i := range wList.Items {
+		otherWl := &wList.Items[i]
+		if (finishedWl != nil && otherWl.UID == finishedWl.UID) || !workload.IsAdmitted(otherWl) || otherWl.Status.Admission == nil {
+			continue
+		}
+		if cqName != "" && string(otherWl.Status.Admission.ClusterQueue) != cqName {
+			continue
+		}
+		r.tryReexpand(ctx, otherWl)
+	}
+}
