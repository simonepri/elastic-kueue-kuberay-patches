+func (r *WorkloadReconciler) tryReexpand(ctx context.Context, wl *kueue.Workload) bool {
+	if wl.Status.Admission == nil {
+		
+		return false
+	}
+	cqName := string(wl.Status.Admission.ClusterQueue)
+	cqObj := &kueue.ClusterQueue{ObjectMeta: metav1.ObjectMeta{Name: cqName}}
+	if pending, err := r.queues.Pending(cqObj); err == nil && pending > 0 {
+		
+		return false
+	}
+	if infoCount := len(r.queues.PendingWorkloadsInfo(cqName)); infoCount > 0 {
+		
+		return false
+	}
+
+	changed := false
+	wlCopy := wl.DeepCopy()
+
+	for i := range wlCopy.Status.Admission.PodSetAssignments {
+		psa := &wlCopy.Status.Admission.PodSetAssignments[i]
+		for _, ps := range wlCopy.Spec.PodSets {
+			if ps.Name == psa.Name {
+				if psa.Count == nil || *psa.Count >= ps.Count {
+					
+					continue
+				}
+				oldCount := *psa.Count
+				if oldCount <= 0 {
+					continue
+				}
+				deltaCount := ps.Count - oldCount
+				deltaUsage := make(resources.FlavorResourceQuantities)
+				for resName, quant := range psa.ResourceUsage {
+					unitVal := quant.MilliValue() / int64(oldCount)
+					deltaMilli := unitVal * int64(deltaCount)
+					flv := psa.Flavors[resName]
+					deltaUsage[resources.FlavorResource{Flavor: flv, Resource: resName}] = (deltaMilli + 999) / 1000
+				}
+
+				snap, err := r.cache.Snapshot(ctx)
+				if err != nil {
+					
+					continue
+				}
+				cq := snap.ClusterQueues[cqName]
+				fits := cq != nil && cq.Fits(deltaUsage)
+				r.log.V(3).Info("Checking re-expansion fit", "workload", klog.KObj(wl), "oldCount", oldCount, "specCount", ps.Count, "fits", fits)
+				if fits {
+					for resName, quant := range psa.ResourceUsage {
+						unitVal := quant.MilliValue() / int64(oldCount)
+						quant.SetMilli(unitVal * int64(ps.Count))
+						psa.ResourceUsage[resName] = quant
+					}
+					psa.Count = ptr.To(ps.Count)
+					changed = true
+				}
+			}
+		}
+	}
+	if changed {
+		apimeta.RemoveStatusCondition(&wlCopy.Status.Conditions, "Preempted")
+		if err := workload.ApplyAdmissionStatus(ctx, r.client, wlCopy, false); err != nil {
+			r.log.Error(err, "Failed to apply re-expanded admission status", "workload", klog.KObj(wl))
+			return false
+		}
+		r.recorder.Eventf(wl, corev1.EventTypeNormal, "Reexpanded", "Workload re-expanded to spec count")
+		return true
+	}
+	return false
+}
+
+func (r *WorkloadReconciler) triggerReexpansionForCQ(ctx context.Context, finishedWl *kueue.Workload) {
+	if finishedWl.Status.Admission == nil {
+		return
+	}
+	cqName := string(finishedWl.Status.Admission.ClusterQueue)
+	var wList kueue.WorkloadList
+	if err := r.client.List(ctx, &wList); err != nil {
+		return
+	}
+	for i := range wList.Items {
+		otherWl := &wList.Items[i]
+		if otherWl.UID == finishedWl.UID || !workload.IsAdmitted(otherWl) || otherWl.Status.Admission == nil {
+			continue
+		}
+		if string(otherWl.Status.Admission.ClusterQueue) != cqName {
+			continue
+		}
+		r.tryReexpand(ctx, otherWl)
+	}
+}
