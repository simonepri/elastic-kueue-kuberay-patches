+package jobframework
+
+import (
+	"maps"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// JobWithPodSetCountSteps is implemented by jobs whose PodSets grow and shrink in steps.
+type JobWithPodSetCountSteps interface {
+	// PodSetCountSteps returns the pod count each PodSet grows and shrinks by, at least 1.
+	PodSetCountSteps() workload.PodSetsCounts
+}
+
+// PodSetCountSteps returns the steps above 1 the job asks its Workload to carry.
+// Empty unless partial scale-up is on and the job uses workload slices.
+func PodSetCountSteps(job GenericJob) workload.PodSetsCounts {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp) || !WorkloadSliceEnabled(job) {
+		return nil
+	}
+	if j, ok := job.(JobWithPodSetCountSteps); ok {
+		steps := maps.Clone(j.PodSetCountSteps())
+		for name, step := range steps {
+			if step <= 1 {
+				delete(steps, name)
+			}
+		}
+		return steps
+	}
+	return nil
+}
+
+// applyPodSetCountSteps writes the job's steps on a Workload built for it.
+func applyPodSetCountSteps(job GenericJob, wl *kueue.Workload) {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp) {
+		return
+	}
+	steps := PodSetCountSteps(job)
+	if len(steps) > 0 {
+		workload.SetPodSetCountSteps(wl, steps)
+	}
+}
+
+// podSetCountStepsOption makes EnsureWorkloadSlices keep the steps of the job's
+// Workload current. It is nil with partial scale-up off, which leaves the Workload alone.
+func podSetCountStepsOption(job GenericJob) workloadslicing.EnsureOption {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp) {
+		return nil
+	}
+	steps := PodSetCountSteps(job)
+	return workloadslicing.WithPodSetCountSteps(steps)
+}
