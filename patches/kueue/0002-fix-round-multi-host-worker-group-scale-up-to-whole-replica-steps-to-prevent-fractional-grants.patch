diff --git a/pkg/controller/elasticjobs/ungate_whole_groups.go b/pkg/controller/elasticjobs/ungate_whole_groups.go
new file mode 100644
index 000000000..f68380762
--- /dev/null
+++ b/pkg/controller/elasticjobs/ungate_whole_groups.go
@@ -0,0 +1,83 @@
