+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package workloadslicing
+
+import (
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// EnsureOption changes how EnsureWorkloadSlices treats the slice it returns.
+type EnsureOption func(*ensureOptions)
+
+type ensureOptions struct {
+	steps        workload.PodSetsCounts
+	refreshSteps bool
+}
+
+// WithPodSetCountSteps makes EnsureWorkloadSlices write the job's count steps
+// on the slice it returns.
+func WithPodSetCountSteps(steps workload.PodSetsCounts) EnsureOption {
+	return func(o *ensureOptions) {
+		o.steps, o.refreshSteps = steps, true
+	}
+}
+
+func newEnsureOptions(opts []EnsureOption) ensureOptions {
+	var o ensureOptions
+	for _, opt := range opts {
+		if opt != nil {
+			opt(&o)
+		}
+	}
+	return o
+}
+
+func (o *ensureOptions) apply(wl *kueue.Workload) bool {
+	if !o.refreshSteps {
+		return false
+	}
+	current := wl.Annotations[constants.PodSetCountStepsAnnotation]
+	want := workload.FormatPodSetCounts(o.steps)
+	if len(o.steps) == 0 {
+		want = ""
+	}
+	if current == want {
+		return false
+	}
+	if want == "" {
+		delete(wl.Annotations, constants.PodSetCountStepsAnnotation)
+	} else {
+		if wl.Annotations == nil {
+			wl.Annotations = make(map[string]string, 1)
+		}
+		wl.Annotations[constants.PodSetCountStepsAnnotation] = want
+	}
+	return true
+}
