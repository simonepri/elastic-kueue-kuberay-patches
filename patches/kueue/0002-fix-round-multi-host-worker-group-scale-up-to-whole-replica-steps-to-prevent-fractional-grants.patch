+// PodSetCountSteps implements jobframework.JobWithPodSetCountSteps. A replica is the unit
+// KubeRay creates and deletes, so a worker group changes by numOfHosts pods.
+func (j *RayCluster) PodSetCountSteps() workload.PodSetsCounts {
+	steps := workload.PodSetsCounts{}
+	for i := range j.Spec.WorkerGroupSpecs {
+		wgs := &j.Spec.WorkerGroupSpecs[i]
+		steps[kueue.NewPodSetReference(wgs.GroupName)] = hostsPerReplica(wgs)
+	}
+	return steps
+}
+
+func hostsPerReplica(wgs *rayv1.WorkerGroupSpec) int32 {
+	return max(wgs.NumOfHosts, 1)
+}
