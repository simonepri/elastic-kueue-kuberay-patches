+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package workload
+
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strconv"
+	"strings"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+)
+
+// ParsePodSetCounts parses a "<podSet>=<count>[,<podSet>=<count>]" list.
+// Malformed entries are ignored.
+func ParsePodSetCounts(value string) PodSetsCounts {
+	if value == "" {
+		return nil
+	}
+	counts := make(PodSetsCounts)
+	for entry := range strings.SplitSeq(value, ",") {
+		name, count, found := strings.Cut(entry, "=")
+		n, err := strconv.ParseInt(count, 10, 32)
+		if found && name != "" && err == nil && n >= 0 {
+			counts[kueue.PodSetReference(name)] = int32(n)
+		}
+	}
+	return counts
+}
+
+// FormatPodSetCounts formats counts as a "<podSet>=<count>[,<podSet>=<count>]" list,
+// sorted by PodSet name.
+func FormatPodSetCounts(counts PodSetsCounts) string {
+	entries := make([]string, 0, len(counts))
+	for _, name := range slices.Sorted(maps.Keys(counts)) {
+		entries = append(entries, fmt.Sprintf("%s=%d", name, counts[name]))
+	}
+	return strings.Join(entries, ",")
+}
+
+// PodSetCountSteps reads kueue.x-k8s.io/podset-count-steps. Every PodSet of the Workload
+// is in the result; one the annotation leaves out, or lists with a malformed or non-positive
+// step, has step 1.
+func PodSetCountSteps(wl *kueue.Workload) PodSetsCounts {
+	listed := ParsePodSetCounts(wl.Annotations[constants.PodSetCountStepsAnnotation])
+	steps := make(PodSetsCounts, len(wl.Spec.PodSets))
+	for i := range wl.Spec.PodSets {
+		name := wl.Spec.PodSets[i].Name
+		steps[name] = 1
+		if step, ok := listed[name]; ok && step >= 1 {
+			steps[name] = step
+		}
+	}
+	return steps
+}
+
+// SetPodSetCountSteps writes kueue.x-k8s.io/podset-count-steps, or removes it when steps is empty.
+func SetPodSetCountSteps(wl *kueue.Workload, steps PodSetsCounts) {
+	if len(steps) == 0 {
+		delete(wl.Annotations, constants.PodSetCountStepsAnnotation)
+		return
+	}
+	if wl.Annotations == nil {
+		wl.Annotations = make(map[string]string, 1)
+	}
+	wl.Annotations[constants.PodSetCountStepsAnnotation] = FormatPodSetCounts(steps)
+}
