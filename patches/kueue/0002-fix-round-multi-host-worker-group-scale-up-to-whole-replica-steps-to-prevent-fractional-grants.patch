+// Partial scale-up of a multi-host worker group: grants come in whole replicas.
+
+package raycluster
+
+import (
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/component-base/featuregate"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingraycluster "sigs.k8s.io/kueue/pkg/util/testingjobs/raycluster"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+	"sigs.k8s.io/kueue/test/util/behavioral"
+)
+
+var _ = ginkgo.Describe("RayCluster partial scale-up of a multi-host worker group", ginkgo.Label("job:ray", "area:jobs"), func() {
+	var (
+		ns             *corev1.Namespace
+		resourceFlavor *kueue.ResourceFlavor
+		clusterQueue   *kueue.ClusterQueue
+		localQueue     *kueue.LocalQueue
+	)
+
+	setup := func() {
+		ginkgo.BeforeEach(func() {
+			features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlices:                          true,
+				features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+			})
+			fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+
+			ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "multi-host-")
+			resourceFlavor = utiltestingapi.MakeResourceFlavor("default").Obj()
+			behavioral.MustCreate(ctx, k8sClient, resourceFlavor)
+			// One head and four workers use 5 pods. The quota leaves room for 5 workers, not 6.
+			clusterQueue = utiltestingapi.MakeClusterQueue("default").
+				ResourceGroup(*utiltestingapi.MakeFlavorQuotas(resourceFlavor.Name).
+					Resource(corev1.ResourcePods, "6").
+					Resource(corev1.ResourceCPU, "100").
+					Obj()).
+				Obj()
+			behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+			localQueue = utiltestingapi.MakeLocalQueue("default", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+			behavioral.MustCreate(ctx, k8sClient, localQueue)
+		})
+		ginkgo.AfterEach(func() {
+			gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, resourceFlavor, true)
+			fwk.StopManager(ctx)
+		})
+	}
+
+	// multiHostCluster has one worker group of two hosts per replica, admitted at two replicas (four pods).
+	multiHostCluster := func() *rayv1.RayCluster {
+		return testingraycluster.MakeCluster("foo", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			SetAnnotation(constants.ElasticJobScaleUpStrategyAnnotationKey, constants.ElasticJobScaleUpStrategyPartial).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			FirstWorkerGroupReplicas(2, 1, 4).
+			WithNumOfHosts(workersGroupName, 2).
+			Obj()
+	}
+
+	scaleTo := func(rc *rayv1.RayCluster, replicas int32) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rc), rc)).To(gomega.Succeed())
+			rc.Spec.WorkerGroupSpecs[0].Replicas = new(replicas)
+			g.Expect(k8sClient.Update(ctx, rc)).To(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+
+	setPodsQuota := func(quota string) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(clusterQueue), clusterQueue)).To(gomega.Succeed())
+			behavioral.SetResourceNominalQuota(clusterQueue, corev1.ResourcePods, quota)
+			g.Expect(k8sClient.Update(ctx, clusterQueue)).To(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+
+	// Four pods granted, eight asked: room for five does not admit the slice at four again,
+	// and room for six admits it at six.
+	growsInWholeReplicas := func() {
+		rc := multiHostCluster()
+		behavioral.MustCreate(ctx, k8sClient, rc)
+		initial := &behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)[0]
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, initial, workersGroupName, 4)
+		gomega.Expect(initial.Annotations).To(gomega.HaveKeyWithValue(constants.PodSetCountStepsAnnotation, workersGroupName+"=2"))
+
+		ginkgo.By("asking for eight pods when room is left for five")
+		scaleTo(rc, 4)
+		slice := behavioral.ExpectNewWorkloadSlice(ctx, k8sClient, initial)
+		gomega.Expect(slice.Spec.PodSets[workersPodSetIdx].Count).To(gomega.Equal(int32(8)))
+		gomega.Expect(slice.Spec.PodSets[workersPodSetIdx].MinCount).To(gomega.Equal(new(int32(4))))
+		gomega.Expect(slice.Annotations).To(gomega.HaveKeyWithValue(constants.PodSetCountStepsAnnotation, workersGroupName+"=2"))
+
+		ginkgo.By("keeping the slice pending instead of admitting it at four pods again")
+		behavioral.ExpectWorkloadsToBePending(ctx, k8sClient, slice)
+		gomega.Consistently(func(g gomega.Gomega) {
+			g.Expect(behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 2)).To(gomega.HaveLen(2))
+			got := &kueue.Workload{}
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(slice), got)).To(gomega.Succeed())
+			g.Expect(got.Status.Admission).To(gomega.BeNil())
+		}, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, initial, workersGroupName, 4)
+
+		ginkgo.By("granting six pods once room is left for six")
+		setPodsQuota("7")
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, slice, workersGroupName, 6)
+		behavioral.ExpectWorkloadToFinish(ctx, k8sClient, client.ObjectKeyFromObject(initial))
+	}
+
+	setup()
+
+	ginkgo.It("Should grow in whole replicas and write the step", func() {
+		growsInWholeReplicas()
+	})
+})
