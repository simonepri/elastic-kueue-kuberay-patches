+
+func TestParsePodSetCounts(t *testing.T) {
+	cases := map[string]struct {
+		value string
+		want  PodSetsCounts
+	}{
+		"empty": {value: "", want: nil},
+		"single entry": {
+			value: "workers=2",
+			want:  PodSetsCounts{"workers": 2},
+		},
+		"multiple entries": {
+			value: "a=1,b=2,c=4",
+			want:  PodSetsCounts{"a": 1, "b": 2, "c": 4},
+		},
+		"malformed entries ignored": {
+			value: "a=1,b,=3,c=x,d=-1,e=99999999999,f=2",
+			want:  PodSetsCounts{"a": 1, "f": 2},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got := ParsePodSetCounts(tc.value)
+			if diff := cmp.Diff(tc.want, got, cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("ParsePodSetCounts() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestFormatPodSetCounts(t *testing.T) {
+	counts := PodSetsCounts{"b": 2, "a": 1}
+	if got, want := FormatPodSetCounts(counts), "a=1,b=2"; got != want {
+		t.Errorf("FormatPodSetCounts() = %q, want %q", got, want)
+	}
+}
+
+func TestPodSetCountSteps(t *testing.T) {
+	wl := &kueue.Workload{
+		Spec: kueue.WorkloadSpec{
+			PodSets: []kueue.PodSet{
+				{Name: "head", Count: 1},
+				{Name: "workers", Count: 4},
+				{Name: "tpu", Count: 8},
+			},
+		},
+	}
+	wl.Annotations = map[string]string{
+		constants.PodSetCountStepsAnnotation: "workers=2,tpu=4",
+	}
+
+	want := PodSetsCounts{"head": 1, "workers": 2, "tpu": 4}
+	got := PodSetCountSteps(wl)
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("PodSetCountSteps() (-want,+got):\n%s", diff)
+	}
+}
+
+func TestSetPodSetCountSteps(t *testing.T) {
+	wl := &kueue.Workload{}
+	SetPodSetCountSteps(wl, PodSetsCounts{"b": 2, "a": 1})
+	if got, want := wl.Annotations[constants.PodSetCountStepsAnnotation], "a=1,b=2"; got != want {
+		t.Errorf("annotation = %q, want %q", got, want)
+	}
+	SetPodSetCountSteps(wl, nil)
+	if _, ok := wl.Annotations[constants.PodSetCountStepsAnnotation]; ok {
+		t.Error("empty steps did not remove the annotation")
+	}
+}
