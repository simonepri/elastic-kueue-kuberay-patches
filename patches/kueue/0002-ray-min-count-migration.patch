+	"sigs.k8s.io/kueue/pkg/controller/jobs/raycluster"
+	"sigs.k8s.io/kueue/pkg/controller/jobs/rayjob"
+	"sigs.k8s.io/kueue/pkg/controller/jobs/rayservice"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingraycluster "sigs.k8s.io/kueue/pkg/util/testingjobs/raycluster"
+	testingrayjob "sigs.k8s.io/kueue/pkg/util/testingjobs/rayjob"
+	testingrayservice "sigs.k8s.io/kueue/pkg/util/testingjobs/rayservice"
+)
+
+type quotaState int
+
+const (
+	pending quotaState = iota
+	quotaReserved
+	admitted
+)
+
+// workloadFromEarlierRelease returns the Workload that patch releases up to p0.6.x built
+// for a Ray job: the job's PodSets, with every worker group's minCount set to its
+// minReplicas, holding quota for every pod when state is quotaReserved or admitted.
+func workloadFromEarlierRelease(t *testing.T, c client.Client, job jobframework.GenericJob, spec *rayv1.RayClusterSpec, state quotaState) *kueue.Workload {
+	t.Helper()
+	podSets, err := jobframework.JobPodSets(t.Context(), job, c)
+	if err != nil {
+		t.Fatalf("Building the job's PodSets: %v", err)
+	}
+	for i := range podSets {
+		for _, wgs := range spec.WorkerGroupSpecs {
+			if podSets[i].Name == kueue.NewPodSetReference(wgs.GroupName) {
+				podSets[i].MinCount = ptr.To(ptr.Deref(wgs.MinReplicas, 0))
+			}
+		}
+	}
+	obj := job.Object()
+	wl := utiltestingapi.MakeWorkload("old-release", obj.GetNamespace()).
+		ControllerReference(job.GVK(), obj.GetName(), string(obj.GetUID())).
+		PodSets(podSets...)
+	if state == pending {
+		return wl.Obj()
+	}
+	assignments := make([]kueue.PodSetAssignment, 0, len(podSets))
+	for _, ps := range podSets {
+		assignments = append(assignments, utiltestingapi.MakePodSetAssignment(ps.Name).
+			Assignment(corev1.ResourceCPU, "default", "1").
+			Count(ps.Count).
+			Obj())
+	}
+	now := time.Now()
+	wl.ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(assignments...).Obj(), now)
+	if state == admitted {
+		wl.AdmittedAt(true, now)
+	}
+	return wl.Obj()
+}
+
+func TestMinCountMigrationEquivalence(t *testing.T) {
+	workers := *testingraycluster.MakeWorkerGroup("workers", 3).
+		MinReplicas(0).
+		MaxReplicas(3).
+		Request(corev1.ResourceCPU, "1").
+		Obj()
+	jobs := map[string]func() (jobframework.GenericJob, *rayv1.RayClusterSpec){
+		"RayCluster": func() (jobframework.GenericJob, *rayv1.RayClusterSpec) {
+			rc := testingraycluster.MakeCluster("job", "ns").UID("job-uid").WithWorkerGroups(workers).Obj()
+			return (*raycluster.RayCluster)(rc), &rc.Spec
+		},
+		"RayJob": func() (jobframework.GenericJob, *rayv1.RayClusterSpec) {
+			rj := testingrayjob.MakeJob("job", "ns").WithWorkerGroups(workers).Obj()
+			rj.UID = "job-uid"
+			return (*rayjob.RayJob)(rj), rj.Spec.RayClusterSpec
+		},
+		"RayService": func() (jobframework.GenericJob, *rayv1.RayClusterSpec) {
+			rs := testingrayservice.MakeService("job", "ns").Obj()
+			rs.UID = "job-uid"
+			rs.Spec.RayClusterSpec.WorkerGroupSpecs = []rayv1.WorkerGroupSpec{*workers.DeepCopy()}
+			return (*rayservice.RayService)(rs), &rs.Spec.RayClusterSpec
+		},
+	}
+	states := map[string]struct {
+		state quotaState
+		// A running job keeps its Workload only while the Workload matches it.
+		running        bool
+		wantEquivalent bool
+	}{
+		"admitted Workload of a running job": {
+			state:          admitted,
+			running:        true,
+			wantEquivalent: true,
+		},
+		"Workload holding quota while its admission checks run": {
+			state:          quotaReserved,
+			wantEquivalent: true,
+		},
+		// The job reconciler replaces the PodSets of a suspended job's pending Workload.
+		"pending Workload": {
+			state:          pending,
+			wantEquivalent: false,
+		},
+	}
+	for kind, makeJob := range jobs {
+		for name, tc := range states {
+			t.Run(kind+" with "+name, func(t *testing.T) {
+				job, spec := makeJob()
+				if tc.running {
+					spec.Suspend = ptr.To(false)
+					if rj, ok := job.(*rayjob.RayJob); ok {
+						rj.Spec.Suspend = false
+					}
+				}
+				c := utiltesting.NewClientBuilder(rayv1.AddToScheme).
+					WithObjects(utiltestingapi.MakeResourceFlavor("default").Obj()).
+					Build()
+				wl := workloadFromEarlierRelease(t, c, job, spec, tc.state)
+				got, err := jobframework.EquivalentToWorkload(t.Context(), c, job, wl)
+				if err != nil {
+					t.Fatalf("EquivalentToWorkload() error: %v", err)
+				}
+				if got != tc.wantEquivalent {
+					t.Errorf("EquivalentToWorkload() = %t, want %t", got, tc.wantEquivalent)
+				}
+			})
+		}
+	}
+}
+
+// TestMinCountMigrationKeepsRunningCluster checks that a running RayCluster whose Workload an
+// earlier release admitted keeps running and keeps its Workload after the upgrade.
+func TestMinCountMigrationKeepsRunningCluster(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	rc := testingraycluster.MakeCluster("job", "ns").
+		UID("job-uid").
+		Suspend(false).
+		Queue("lq").
+		WithWorkerGroups(*testingraycluster.MakeWorkerGroup("workers", 2).
+			MinReplicas(0).
+			MaxReplicas(4).
+			Request(corev1.ResourceCPU, "1").
+			Obj()).
+		Obj()
+
+	builder := utiltesting.NewClientBuilder(rayv1.AddToScheme)
+	indexer := utiltesting.AsIndexer(builder)
+	if err := raycluster.SetupIndexes(ctx, indexer); err != nil {
+		t.Fatalf("Setting up indexes: %v", err)
+	}
+	c := builder.WithObjects(
+		utiltesting.MakeNamespace("ns"),
+		utiltestingapi.MakeResourceFlavor("default").Obj(),
+		rc,
+	).Build()
+	wl := workloadFromEarlierRelease(t, c, (*raycluster.RayCluster)(rc), &rc.Spec, admitted)
+	wl.Spec.QueueName = "lq"
+	if err := c.Create(ctx, wl); err != nil {
+		t.Fatalf("Creating the Workload: %v", err)
+	}
+
+	reconciler, err := raycluster.NewReconciler(ctx, c, indexer, &utiltesting.EventRecorder{})
+	if err != nil {
+		t.Fatalf("Creating the reconciler: %v", err)
+	}
+	if _, err := reconciler.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(rc)}); err != nil {
+		t.Fatalf("Reconcile() error: %v", err)
+	}
+
+	var gotCluster rayv1.RayCluster
+	if err := c.Get(ctx, client.ObjectKeyFromObject(rc), &gotCluster); err != nil {
+		t.Fatalf("Getting the RayCluster: %v", err)
+	}
+	if ptr.Deref(gotCluster.Spec.Suspend, false) {
+		t.Errorf("RayCluster was suspended, want it running")
+	}
+	var gotWorkload kueue.Workload
+	if err := c.Get(ctx, client.ObjectKeyFromObject(wl), &gotWorkload); err != nil {
+		t.Errorf("Getting the Workload: %v, want it kept", err)
+	}
+}
+
+// TestMinCountMigrationMultiHostShrink checks a multi-host worker group that an earlier release
+// shrank to a pod count that is not a whole number of replicas: 4 replicas of 2 hosts admitted
+// at 5 pods, with replicas set to 5/2 = 2. The cluster keeps running while its replicas match
+// the admitted count rounded down to whole replicas, and only then.
+func TestMinCountMigrationMultiHostShrink(t *testing.T) {
+	cases := map[string]struct {
+		replicas       int32
+		wantEquivalent bool
+	}{
+		"replicas at the admitted count rounded down": {replicas: 2, wantEquivalent: true},
+		"fewer replicas":                              {replicas: 1},
+		"more replicas":                               {replicas: 3},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			rc := testingraycluster.MakeCluster("job", "ns").
+				UID("job-uid").
+				Suspend(false).
+				WithWorkerGroups(*testingraycluster.MakeWorkerGroup("workers", 4).
+					MinReplicas(0).
+					MaxReplicas(4).
+					NumOfHosts(2).
+					Request(corev1.ResourceCPU, "1").
+					Obj()).
+				Obj()
+			c := utiltesting.NewClientBuilder(rayv1.AddToScheme).
+				WithObjects(utiltestingapi.MakeResourceFlavor("default").Obj()).
+				Build()
+			wl := workloadFromEarlierRelease(t, c, (*raycluster.RayCluster)(rc), &rc.Spec, admitted)
+			for i := range wl.Status.Admission.PodSetAssignments {
+				if psa := &wl.Status.Admission.PodSetAssignments[i]; psa.Name == "workers" {
+					psa.Count = ptr.To[int32](5)
+				}
+			}
+			rc.Spec.WorkerGroupSpecs[0].Replicas = ptr.To(tc.replicas)
+			got, err := jobframework.EquivalentToWorkload(t.Context(), c, (*raycluster.RayCluster)(rc), wl)
+			if err != nil {
+				t.Fatalf("EquivalentToWorkload() error: %v", err)
+			}
+			if got != tc.wantEquivalent {
+				t.Errorf("EquivalentToWorkload() = %t, want %t", got, tc.wantEquivalent)
+			}
+		})
+	}
+}
