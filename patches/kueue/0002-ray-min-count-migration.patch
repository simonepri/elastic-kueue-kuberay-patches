+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package raycluster
+
+import (
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/util/equality"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// TODO(simonepri): remove this file, its test, equality.WithIgnoreMinCount,
+// equality.WithCountsInWholeSteps and the
+// MinCountMigrationOptions calls of RayCluster, RayJob and RayService once no Workload
+// that held quota under patch release p0.6.x or earlier remains.
+
+// MinCountMigrationOptions keeps a Ray job running when its Workload holds quota that an
+// earlier release of these patches reserved. Those releases set every worker group's
+// minCount to its minReplicas, which the job's PodSets no longer carry, so the Workload
+// would stop matching the job and the running job would be suspended. MinCount only
+// decides the pod count a Workload may be admitted with, so it cannot change what a
+// Workload holding quota runs. Once the quota is released, the job reconciler replaces
+// the Workload's PodSets with the job's, which drops the stale minCount.
+//
+// Those releases also shrank a multi-host worker group to a pod count that is not a whole
+// number of replicas, and set replicas to that count divided by numOfHosts, rounded down,
+// so the job asks for fewer pods than the Workload holds. The job then matches while its
+// count is the admitted count rounded down to whole replicas; the Workload stays charged
+// for the admitted count until its quota is released.
+func MinCountMigrationOptions(wl *kueue.Workload, spec *rayv1.RayClusterSpec) []equality.ComparePodSetsOption {
+	if wl == nil || !workload.HasQuotaReservation(wl) {
+		return nil
+	}
+	opts := []equality.ComparePodSetsOption{equality.WithIgnoreMinCount()}
+	if spec == nil {
+		return opts
+	}
+	steps := make(map[kueue.PodSetReference]int32)
+	for _, wgs := range spec.WorkerGroupSpecs {
+		if wgs.NumOfHosts > 1 {
+			steps[kueue.NewPodSetReference(wgs.GroupName)] = wgs.NumOfHosts
+		}
+	}
+	if len(steps) > 0 {
+		opts = append(opts, equality.WithCountsInWholeSteps(steps))
+	}
+	return opts
+}
