+)
+
+// Re-applying the manifest replaces the atomic workerGroupSpecs list, which drops what Kueue
+// stamped on the templates, and every worker KubeRay creates from them afterwards must still
+// be ungated: up to the admitted count, and never beyond it.
+var _ = reapplySpecs("RayCluster elastic template re-apply")
+
+const (
+	workerGroup = "workers-group-0"
+	classLabel  = "example.com/class"
+)
+
+var classToleration = corev1.Toleration{Key: classLabel, Operator: corev1.TolerationOpEqual, Value: "test", Effect: corev1.TaintEffectNoSchedule}
+
+func reapplySpecs(name string) bool {
+	return ginkgo.Describe(name, ginkgo.Label("job:ray", "area:jobs"), ginkgo.Ordered, ginkgo.ContinueOnFailure, func() {
+		var (
+			ns             *corev1.Namespace
+			resourceFlavor *kueue.ResourceFlavor
+			clusterQueue   *kueue.ClusterQueue
+			localQueue     *kueue.LocalQueue
+		)
+
+		ginkgo.BeforeAll(func() {
+			features.SetFeatureGateDuringTest(ginkgo.GinkgoTB(), features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(ginkgo.GinkgoTB(), features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, false)
+			fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+		})
+		ginkgo.AfterAll(func() {
+			fwk.StopManager(ctx)
+		})
+
+		ginkgo.BeforeEach(func() {
+			ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "reapply-")
+			resourceFlavor = utiltestingapi.MakeResourceFlavor("default").NodeLabel(classLabel, "test").Toleration(classToleration).Obj()
+			behavioral.MustCreate(ctx, k8sClient, resourceFlavor)
+			clusterQueue = utiltestingapi.MakeClusterQueue("default").
+				ResourceGroup(*utiltestingapi.MakeFlavorQuotas(resourceFlavor.Name).Resource(corev1.ResourceCPU, "10").Obj()).
+				Obj()
+			behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+			localQueue = utiltestingapi.MakeLocalQueue("default", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+			behavioral.MustCreate(ctx, k8sClient, localQueue)
+		})
+		ginkgo.AfterEach(func() {
+			gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, resourceFlavor, true)
+		})
+
+		// newManifest is what a user keeps in Git: the elastic gate in every template, which the
+		// RayCluster validation requires, and nothing Kueue stamps when it starts the cluster.
+		newManifest := func() *rayv1.RayCluster {
+			return testingraycluster.MakeCluster("foo", ns.Name).
+				SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+				Queue(localQueue.Name).
+				Request(rayv1.HeadNode, corev1.ResourceCPU, "1").
+				RequestWorkerGroup(corev1.ResourceCPU, "1").
+				FirstWorkerGroupReplicas(2, 0, 8).
+				SchedulingGate(kueue.ElasticJobSchedulingGate).
+				Obj()
+		}
+
+		ginkgo.It("Should accept a re-applied manifest that has no elastic gate and put the gate back", func() {
+			manifest := newManifest()
+			behavioral.MustCreate(ctx, k8sClient, manifest.DeepCopy())
+			gomega.Eventually(func(g gomega.Gomega) {
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), manifest)).Should(gomega.Succeed())
+				g.Expect(manifest.Spec.Suspend).Should(gomega.Equal(new(false)))
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+			ginkgo.By("re-applying a manifest without the gate")
+			ungatedManifest := newManifest()
+			ungatedManifest.Spec.HeadGroupSpec.Template.Spec.SchedulingGates = nil
+			ungatedManifest.Spec.WorkerGroupSpecs[0].Template.Spec.SchedulingGates = nil
+			gomega.Expect(k8sClient.Patch(ctx, manifest, client.RawPatch(types.MergePatchType, reapplyPatch(ungatedManifest)))).Should(gomega.Succeed())
+
+			gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), manifest)).Should(gomega.Succeed())
+			gate := corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}
+			gomega.Expect(manifest.Spec.HeadGroupSpec.Template.Spec.SchedulingGates).Should(gomega.ContainElement(gate))
+			gomega.Expect(manifest.Spec.WorkerGroupSpecs[0].Template.Spec.SchedulingGates).Should(gomega.ContainElement(gate))
+		})
+
+		ginkgo.It("Should ungate the workers of a re-applied cluster up to the admitted count and never beyond", func() {
+			manifest := newManifest()
+
+			ginkgo.By("creating the cluster and starting it with two admitted workers")
+			behavioral.MustCreate(ctx, k8sClient, manifest.DeepCopy())
+			rayCluster := &rayv1.RayCluster{}
+			gomega.Eventually(func(g gomega.Gomega) {
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), rayCluster)).Should(gomega.Succeed())
+				g.Expect(rayCluster.Spec.Suspend).Should(gomega.Equal(new(false)))
+				g.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Labels).Should(gomega.HaveKeyWithValue(constants.PodSetLabel, workerGroup))
+				g.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Labels).Should(gomega.HaveKeyWithValue(constants.LocalQueueLabel, localQueue.Name))
+				g.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Labels).Should(gomega.HaveKeyWithValue(constants.ClusterQueueLabel, clusterQueue.Name))
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+			sliceName := rayCluster.Spec.WorkerGroupSpecs[0].Template.Annotations[kueue.WorkloadSliceNameAnnotation]
+			gomega.Expect(sliceName).ShouldNot(gomega.BeEmpty())
+
+			// worker creates a gated Pod the way KubeRay does: from the worker group's current template.
+			worker := func(name string) *corev1.Pod {
+				template := rayCluster.Spec.WorkerGroupSpecs[0].Template
+				pod := testingpod.MakePod(name, ns.Name).Obj()
+				pod.Labels = template.Labels
+				pod.Annotations = template.Annotations
+				pod.Spec.SchedulingGates = template.Spec.SchedulingGates
+				pod.Spec.NodeSelector = template.Spec.NodeSelector
+				pod.Spec.Tolerations = template.Spec.Tolerations
+				return pod
+			}
+			ungated := func() []string {
+				pods := &corev1.PodList{}
+				gomega.Expect(k8sClient.List(ctx, pods, client.InNamespace(ns.Name))).Should(gomega.Succeed())
+				var names []string
+				for _, pod := range pods.Items {
+					if len(pod.Spec.SchedulingGates) == 0 {
+						names = append(names, pod.Name)
+					}
+				}
+				return names
+			}
+			refresh := func() {
+				ginkgo.GinkgoHelper()
+				gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), rayCluster)).Should(gomega.Succeed())
+			}
+			for _, name := range []string{"first-0", "first-1"} {
+				behavioral.MustCreate(ctx, k8sClient, worker(name))
+			}
+			gomega.Eventually(ungated, behavioral.Timeout, behavioral.Interval).Should(gomega.ConsistOf("first-0", "first-1"))
+
+			ginkgo.By("re-applying the original manifest as a JSON merge patch")
+			patch := reapplyPatch(manifest)
+			gomega.Expect(k8sClient.Patch(ctx, rayCluster, client.RawPatch(types.MergePatchType, patch))).Should(gomega.Succeed())
+
+			ginkgo.By("keeping the gate, the PodSet label, and the slice name on the replaced worker group")
+			refresh()
+			template := rayCluster.Spec.WorkerGroupSpecs[0].Template
+			gomega.Expect(template.Spec.SchedulingGates).Should(gomega.ContainElement(corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}))
+			gomega.Expect(template.Labels).Should(gomega.HaveKeyWithValue(constants.PodSetLabel, workerGroup))
+			gomega.Expect(template.Labels).Should(gomega.HaveKeyWithValue(constants.LocalQueueLabel, localQueue.Name))
+			gomega.Expect(template.Labels).Should(gomega.HaveKeyWithValue(constants.ClusterQueueLabel, clusterQueue.Name))
+			gomega.Expect(template.Annotations).Should(gomega.HaveKeyWithValue(kueue.WorkloadSliceNameAnnotation, sliceName))
+
+			ginkgo.By("keeping the flavor placement on the template, which nothing else adds to the workers")
+			gomega.Expect(template.Spec.NodeSelector).Should(gomega.HaveKeyWithValue(classLabel, "test"))
+			gomega.Expect(template.Spec.Tolerations).Should(gomega.ContainElement(classToleration))
+
+			ginkgo.By("ungating the replacements of two lost workers, and no third worker")
+			for _, name := range []string{"first-0", "first-1"} {
+				gomega.Expect(k8sClient.Delete(ctx, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: ns.Name}})).Should(gomega.Succeed())
+			}
+			for _, name := range []string{"replacement-0", "replacement-1", "extra"} {
+				behavioral.MustCreate(ctx, k8sClient, worker(name))
+			}
+			gomega.Eventually(ungated, behavioral.Timeout, behavioral.Interval).Should(gomega.HaveLen(2))
+			gomega.Consistently(ungated, behavioral.LongConsistentDuration, behavioral.Interval).Should(gomega.HaveLen(2))
+
+			ginkgo.By("placing every ungated worker on the flavor")
+			pods := &corev1.PodList{}
+			gomega.Expect(k8sClient.List(ctx, pods, client.InNamespace(ns.Name))).Should(gomega.Succeed())
+			for _, pod := range pods.Items {
+				if len(pod.Spec.SchedulingGates) == 0 {
+					gomega.Expect(pod.Spec.NodeSelector).Should(gomega.HaveKeyWithValue(classLabel, "test"), pod.Name)
+					gomega.Expect(pod.Spec.Tolerations).Should(gomega.ContainElement(classToleration), pod.Name)
+				}
+			}
+
+			ginkgo.By("scaling up to four workers after a second re-apply")
+			gomega.Expect(k8sClient.Patch(ctx, rayCluster, client.RawPatch(types.MergePatchType, patch))).Should(gomega.Succeed())
+			gomega.Eventually(func(g gomega.Gomega) {
+				refresh()
+				rayCluster.Spec.WorkerGroupSpecs[0].Replicas = new(int32(4))
+				g.Expect(k8sClient.Update(ctx, rayCluster)).Should(gomega.Succeed())
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+			gomega.Eventually(func(g gomega.Gomega) {
+				workloads := &kueue.WorkloadList{}
+				g.Expect(k8sClient.List(ctx, workloads, client.InNamespace(ns.Name))).Should(gomega.Succeed())
+				admitted := 0
+				for _, wl := range workloads.Items {
+					if wl.Status.Admission == nil {
+						continue
+					}
+					for _, psa := range wl.Status.Admission.PodSetAssignments {
+						if psa.Name == workerGroup && ptr.Deref(psa.Count, 0) == 4 {
+							admitted++
+						}
+					}
+				}
+				g.Expect(admitted).Should(gomega.BeNumerically(">=", 1))
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+			refresh()
+			for i := range 2 {
+				behavioral.MustCreate(ctx, k8sClient, worker(fmt.Sprintf("scale-up-%d", i)))
+			}
+			gomega.Eventually(ungated, behavioral.Timeout, behavioral.Interval).Should(gomega.HaveLen(4))
+			gomega.Consistently(ungated, behavioral.LongConsistentDuration, behavioral.Interval).Should(gomega.HaveLen(4))
+		})
+	})
+}
+
+// reapplyPatch returns the JSON merge patch that applies the manifest again: the whole
+// object, as a GitOps tool or kubectl apply sends it, without the fields a user does not
+// write.
+func reapplyPatch(manifest *rayv1.RayCluster) []byte {
+	ginkgo.GinkgoHelper()
+	raw, err := json.Marshal(manifest)
+	gomega.Expect(err).ShouldNot(gomega.HaveOccurred())
+	var obj map[string]any
+	gomega.Expect(json.Unmarshal(raw, &obj)).Should(gomega.Succeed())
+	delete(obj, "status")
+	delete(obj["spec"].(map[string]any), "suspend")
+	patch, err := json.Marshal(obj)
+	gomega.Expect(err).ShouldNot(gomega.HaveOccurred())
+	return patch
+}
