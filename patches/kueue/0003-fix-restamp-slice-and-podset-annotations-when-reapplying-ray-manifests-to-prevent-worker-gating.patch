+func TestAPIs(t *testing.T) {
+	behavioral.RunSuite(t, "RayCluster Elastic Template Re-apply Suite")
+}
+
+// This suite installs the RayCluster webhooks, which the sibling RayCluster suite leaves out,
+// because a re-applied manifest reaches the templates through them.
+var _ = ginkgo.BeforeSuite(func() {
+	fwk = &framework.Framework{
+		DepCRDPaths: []string{behavioral.RayOperatorCrds},
+		WebhookPath: rayClusterWebhookPath(),
+	}
+	cfg = fwk.Init()
+	ctx, k8sClient = fwk.SetupClient(cfg)
+})
+
+var _ = ginkgo.AfterSuite(func() {
+	fwk.Teardown()
+})
