+// A PodSet with a topology assignment has the topology scheduling gate on its template, which
+// keeps its Pods off nodes outside their domains until Kueue places them. A re-apply drops it.
+var _ = ginkgo.Describe("RayCluster elastic template re-apply with topology-aware scheduling", ginkgo.Label("job:ray", "area:jobs", "feature:tas"), ginkgo.Ordered, func() {
+	const nodeGroupLabel = "node-group"
+	var (
+		ns           *corev1.Namespace
+		topology     *kueue.Topology
+		flavor       *kueue.ResourceFlavor
+		clusterQueue *kueue.ClusterQueue
+		localQueue   *kueue.LocalQueue
+	)
+
+	ginkgo.BeforeAll(func() {
+		features.SetFeatureGateDuringTest(ginkgo.GinkgoTB(), features.ElasticJobsViaWorkloadSlices, true)
+		features.SetFeatureGateDuringTest(ginkgo.GinkgoTB(), features.TopologyAwareScheduling, true)
+		fwk.StartManager(ctx, cfg, managerAndSchedulerWithTASSetup())
+	})
+	ginkgo.AfterAll(func() {
+		fwk.StopManager(ctx)
+	})
+
+	ginkgo.BeforeEach(func() {
+		ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "tas-reapply-")
+		integration.CreateNodesWithStatus(ctx, k8sClient, []corev1.Node{
+			*testingnode.MakeNode("b1r1").
+				Label(nodeGroupLabel, "tas").
+				Label(utiltesting.DefaultBlockTopologyLevel, "b1").
+				Label(utiltesting.DefaultRackTopologyLevel, "r1").
+				StatusAllocatable(corev1.ResourceList{
+					corev1.ResourceCPU:    resource.MustParse("2"),
+					corev1.ResourceMemory: resource.MustParse("2Gi"),
+					corev1.ResourcePods:   resource.MustParse("10"),
+				}).
+				Ready().
+				Obj(),
+		})
+		topology = utiltestingapi.MakeDefaultTwoLevelTopology("default")
+		behavioral.MustCreate(ctx, k8sClient, topology)
+		flavor = utiltestingapi.MakeResourceFlavor("tas-flavor").NodeLabel(nodeGroupLabel, "tas").TopologyName("default").Obj()
+		behavioral.MustCreate(ctx, k8sClient, flavor)
+		clusterQueue = utiltestingapi.MakeClusterQueue("cluster-queue").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas(flavor.Name).Resource(corev1.ResourceCPU, "5").Obj()).
+			Obj()
+		behavioral.CreateClusterQueuesAndWaitForActive(ctx, k8sClient, clusterQueue)
+		localQueue = utiltestingapi.MakeLocalQueue("local-queue", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+		behavioral.CreateLocalQueuesAndWaitForActive(ctx, k8sClient, localQueue)
+	})
+	ginkgo.AfterEach(func() {
+		gomega.Expect(k8sClient.DeleteAllOf(ctx, &rayv1.RayCluster{}, client.InNamespace(ns.Name))).To(gomega.Succeed())
+		gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, flavor, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, topology, true)
+		gomega.Expect(client.IgnoreNotFound(k8sClient.Delete(ctx, &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "b1r1"}}))).To(gomega.Succeed())
+	})
+
+	ginkgo.It("Should put the topology scheduling gate back on a re-applied worker group", func() {
+		manifest := testingraycluster.MakeCluster("foo", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Queue(localQueue.Name).
+			Request(rayv1.HeadNode, corev1.ResourceCPU, "250m").
+			RequestWorkerGroup(corev1.ResourceCPU, "250m").
+			FirstWorkerGroupReplicas(2, 0, 8).
+			SchedulingGate(kueue.ElasticJobSchedulingGate).
+			Obj()
+		topologyGate := corev1.PodSchedulingGate{Name: kueue.TopologySchedulingGate}
+
+		ginkgo.By("starting the cluster with the topology gate on its worker template")
+		behavioral.MustCreate(ctx, k8sClient, manifest.DeepCopy())
+		rayCluster := &rayv1.RayCluster{}
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), rayCluster)).Should(gomega.Succeed())
+			g.Expect(rayCluster.Spec.Suspend).Should(gomega.Equal(new(false)))
+			g.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Spec.SchedulingGates).Should(gomega.ContainElement(topologyGate))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("re-applying the original manifest as a JSON merge patch")
+		gomega.Expect(k8sClient.Patch(ctx, rayCluster, client.RawPatch(types.MergePatchType, reapplyPatch(manifest)))).Should(gomega.Succeed())
+
+		ginkgo.By("keeping the topology gate on the replaced worker group")
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), rayCluster)).Should(gomega.Succeed())
+		template := rayCluster.Spec.WorkerGroupSpecs[0].Template
+		gomega.Expect(template.Spec.SchedulingGates).Should(gomega.ContainElement(topologyGate))
+		gomega.Expect(template.Annotations).Should(gomega.HaveKeyWithValue(kueue.PodSetUnconstrainedTopologyAnnotation, "true"))
+	})
+})
