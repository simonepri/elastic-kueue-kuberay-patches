+
+func TestRestampElasticTemplatesOnUpdate(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	updateCtx := func(ctx context.Context) context.Context {
+		return admission.NewContextWithRequest(ctx, admission.Request{
+			AdmissionRequest: admissionv1.AdmissionRequest{Operation: admissionv1.Update},
+		})
+	}
+	// The manifest a user applies: no gate, no PodSet label, no slice name.
+	original := func(elastic, suspended bool) *rayv1.RayCluster {
+		cluster := testingrayutil.MakeCluster("job", "ns").UID("job-uid").Suspend(suspended)
+		if elastic {
+			cluster = cluster.SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue)
+		}
+		return cluster.Obj()
+	}
+	assignment := utiltestingapi.MakeAdmission("cq").
+		PodSets(
+			utiltestingapi.MakePodSetAssignment("head").Assignment(corev1.ResourceCPU, "remote", "1").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers-group-0").Assignment(corev1.ResourceCPU, "remote", "1").Obj(),
+		).Obj()
+	// slice is a Workload of an elastic chain.
+	slice := func(name, chain string, finished bool) kueue.Workload {
+		wl := utiltestingapi.MakeWorkload(name, "ns").
+			Queue("lq").
+			Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			PodSets(*utiltestingapi.MakePodSet("head", 1).Obj(), *utiltestingapi.MakePodSet("workers-group-0", 2).Obj()).
+			ControllerReference(gvk, "job", "job-uid").
+			ReserveQuotaAt(assignment, now)
+		if chain != "" {
+			wl = wl.Annotation(kueue.WorkloadSliceNameAnnotation, chain)
+		}
+		if finished {
+			wl = wl.Condition(metav1.Condition{Type: kueue.WorkloadFinished, Status: metav1.ConditionTrue, Reason: "Succeeded"})
+		}
+		return *wl.Obj()
+	}
+	stamped := func(chain string) func(*rayv1.RayCluster) {
+		return func(c *rayv1.RayCluster) {
+			stamp := func(t *corev1.PodTemplateSpec, podSet string) {
+				t.Labels = map[string]string{
+					constants.PodSetLabel:       podSet,
+					constants.LocalQueueLabel:   "lq",
+					constants.ClusterQueueLabel: "cq",
+				}
+				t.Annotations = map[string]string{kueue.WorkloadSliceNameAnnotation: chain}
+			}
+			stamp(&c.Spec.HeadGroupSpec.Template, "head")
+			stamp(&c.Spec.WorkerGroupSpecs[0].Template, "workers-group-0")
+		}
+	}
+	unqueuedStamped := func(chain string) func(*rayv1.RayCluster) {
+		return func(c *rayv1.RayCluster) {
+			stamp := func(t *corev1.PodTemplateSpec, podSet string) {
+				t.Labels = map[string]string{constants.PodSetLabel: podSet}
+				t.Annotations = map[string]string{kueue.WorkloadSliceNameAnnotation: chain}
+			}
+			stamp(&c.Spec.HeadGroupSpec.Template, "head")
+			stamp(&c.Spec.WorkerGroupSpecs[0].Template, "workers-group-0")
+		}
+	}
+	gated := func(c *rayv1.RayCluster) {
+		c.Spec.HeadGroupSpec.Template.Spec.SchedulingGates = []corev1.PodSchedulingGate{{Name: kueue.ElasticJobSchedulingGate}}
+		c.Spec.WorkerGroupSpecs[0].Template.Spec.SchedulingGates = []corev1.PodSchedulingGate{{Name: kueue.ElasticJobSchedulingGate}}
+	}
+	placementOnTemplates := func() kueue.Workload {
+		return slice("origin", "", false)
+	}
+	toleration := corev1.Toleration{Key: "example.com/provider", Operator: corev1.TolerationOpExists}
+	placed := func(c *rayv1.RayCluster) {
+		for _, t := range []*corev1.PodTemplateSpec{&c.Spec.HeadGroupSpec.Template, &c.Spec.WorkerGroupSpecs[0].Template} {
+			t.Spec.NodeSelector = map[string]string{"example.com/class": "test"}
+			t.Spec.Tolerations = []corev1.Toleration{toleration}
+		}
+	}
+	tracked := func(c *rayv1.RayCluster) {
+		c.Spec.HeadGroupSpec.Template.Annotations[kueue.WorkloadAnnotation] = "origin"
+		c.Spec.WorkerGroupSpecs[0].Template.Annotations[kueue.WorkloadAnnotation] = "origin"
+	}
+	with := func(c *rayv1.RayCluster, mutations ...func(*rayv1.RayCluster)) *rayv1.RayCluster {
+		c = c.DeepCopy()
+		for _, mutate := range mutations {
+			mutate(c)
+		}
+		return c
+	}
+
+	// topologyOnTemplates is a Workload whose worker PodSet has a topology assignment.
+	topologyOnTemplates := func() kueue.Workload {
+		wl := slice("origin", "", false)
+		wl.Status.Admission.PodSetAssignments[1].TopologyAssignment = utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+			Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{"node-a"}, 2).Obj()).
+			Obj()
+		return wl
+	}
+	topologyGated := func(c *rayv1.RayCluster) {
+		t := &c.Spec.WorkerGroupSpecs[0].Template
+		t.Spec.SchedulingGates = append(t.Spec.SchedulingGates, corev1.PodSchedulingGate{Name: kueue.TopologySchedulingGate})
+		t.Annotations[kueue.PodSetUnconstrainedTopologyAnnotation] = "true"
+		t.Annotations[kueue.WorkloadAnnotation] = "origin"
+	}
+	withAnnotation := func(c *rayv1.RayCluster) {
+		c.Spec.HeadGroupSpec.Template.Annotations = map[string]string{kueue.WorkloadAnnotation: "first-slice"}
+	}
+
+	cases := map[string]struct {
+		cluster   *rayv1.RayCluster
+		workloads []kueue.Workload
+		gates     map[featuregate.Feature]bool
+		want      *rayv1.RayCluster
+	}{
+		"put the flavor placement back on the templates": {
+			cluster:   original(true, false),
+			workloads: []kueue.Workload{placementOnTemplates()},
+			want:      with(original(true, false), gated, stamped("origin"), placed),
+		},
+		"keep a node selector value the template sets": {
+			cluster: with(original(true, false), func(c *rayv1.RayCluster) {
+				c.Spec.WorkerGroupSpecs[0].Template.Spec.NodeSelector = map[string]string{"example.com/class": "mine"}
+			}),
+			workloads: []kueue.Workload{placementOnTemplates()},
+			want: with(original(true, false), gated, stamped("origin"), placed, func(c *rayv1.RayCluster) {
+				c.Spec.WorkerGroupSpecs[0].Template.Spec.NodeSelector = map[string]string{"example.com/class": "mine"}
+			}),
+		},
+		"restore the topology gate and annotation of a PodSet with a topology assignment": {
+			cluster:   original(true, false),
+			workloads: []kueue.Workload{topologyOnTemplates()},
+			gates:     map[featuregate.Feature]bool{features.TopologyAwareScheduling: true},
+			want: with(original(true, false), gated, stamped("origin"), placed, topologyGated, func(c *rayv1.RayCluster) {
+				c.Spec.HeadGroupSpec.Template.Annotations[kueue.WorkloadAnnotation] = "origin"
+			}),
+		},
+		"never overwrite the Workload annotation of the slice that started the cluster": {
+			cluster:   with(original(true, false), withAnnotation),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			gates:     map[featuregate.Feature]bool{features.WaitForPodsReadyUnscheduledTimeout: true},
+			want: with(original(true, false), gated, stamped("origin"), placed, func(c *rayv1.RayCluster) {
+				c.Spec.HeadGroupSpec.Template.Annotations[kueue.WorkloadAnnotation] = "first-slice"
+				c.Spec.WorkerGroupSpecs[0].Template.Annotations[kueue.WorkloadAnnotation] = "first-slice"
+			}),
+		},
+		"stamp the Workload annotation with the active slice when Pod scheduling is tracked": {
+			cluster:   original(true, false),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			gates:     map[featuregate.Feature]bool{features.WaitForPodsReadyUnscheduledTimeout: true},
+			want:      with(original(true, false), gated, stamped("origin"), placed, tracked),
+		},
+		"stamp the gate, the PodSet labels, and the chain's slice name on a running elastic cluster": {
+			cluster:   original(true, false),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			want:      with(original(true, false), gated, stamped("origin"), placed),
+		},
+		"use the active slice's chain, not a finished slice of an earlier chain": {
+			cluster: original(true, false),
+			workloads: []kueue.Workload{
+				slice("earlier", "", true),
+				slice("current-slice", "current", false),
+			},
+			want: with(original(true, false), gated, stamped("current"), placed),
+		},
+		"stamp only the gate while the cluster is suspended": {
+			cluster:   original(true, true),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			want:      with(original(true, true), gated),
+		},
+		"stamp only the gate while no slice is active": {
+			cluster:   original(true, false),
+			workloads: []kueue.Workload{slice("origin", "", true)},
+			want:      with(original(true, false), gated),
+		},
+		"leave a cluster that is not elastic alone": {
+			cluster:   original(false, false),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			want:      original(false, false),
+		},
+		"change nothing when the templates are already stamped": {
+			cluster:   with(original(true, false), gated, stamped("origin"), placed),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			want:      with(original(true, false), gated, stamped("origin"), placed),
+		},
+		"replace a stale slice name": {
+			cluster:   with(original(true, false), gated, stamped("stale"), placed),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			want:      with(original(true, false), gated, stamped("origin"), placed),
+		},
+		"omit queue labels when AssignQueueLabelsForPods is disabled": {
+			cluster:   original(true, false),
+			workloads: []kueue.Workload{slice("origin", "", false)},
+			gates:     map[featuregate.Feature]bool{features.AssignQueueLabelsForPods: false},
+			want:      with(original(true, false), gated, unqueuedStamped("origin"), placed),
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			// Topology-aware scheduling is on by default and tracks Pod scheduling, which has a case of its own.
+			features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, false)
+			for gate, enabled := range tc.gates {
+				features.SetFeatureGateDuringTest(t, gate, enabled)
+			}
+			ctx, _ := utiltesting.ContextWithLog(t)
+			builder := utiltesting.NewClientBuilder().
+				WithObjects(utiltestingapi.MakeResourceFlavor("remote").NodeLabel("example.com/class", "test").Toleration(toleration).Obj()).
+				WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(gvk), coreindexer.WorkloadOwnerIndexFunc(gvk))
+			for i := range tc.workloads {
+				builder = builder.WithObjects(&tc.workloads[i])
+			}
+			wh := &RayClusterWebhook{client: builder.Build()}
+
+			got := tc.cluster.DeepCopy()
+			if err := wh.Default(updateCtx(ctx), got); err != nil {
+				t.Fatalf("Default() error: %v", err)
+			}
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("Default() mismatch (-want +got):\n%s", diff)
+			}
+			// Defaulting its own output changes nothing, so a tool that applies the result again sees no drift.
+			again := got.DeepCopy()
+			if err := wh.Default(updateCtx(ctx), again); err != nil {
+				t.Fatalf("second Default() error: %v", err)
+			}
+			if diff := cmp.Diff(got, again); diff != "" {
+				t.Errorf("second Default() changed the object (-first +second):\n%s", diff)
+			}
+		})
+	}
+}
