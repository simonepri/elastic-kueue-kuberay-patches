+package raycluster
+
+import (
+	"context"
+	"slices"
+
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	corev1 "k8s.io/api/core/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/controller/jobframework"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/podset"
+	utilpod "sigs.k8s.io/kueue/pkg/util/pod"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// restampElasticTemplates is the defaulting of an elastic RayCluster on update. The
+// ElasticJobUngater ungates a Pod only when its template carries the scheduling gate,
+// the PodSet label, and the slice name annotation, and the job reconciler stamps the
+// last two once, when it starts the cluster. Replacing a worker group, as a re-apply
+// of the original manifest does with the atomic workerGroupSpecs list, drops them, and
+// every Pod KubeRay creates afterwards would stay gated or unmanaged forever. So every
+// write puts them back, derived from the cluster's active workload slice: the webhook
+// answers the write itself, so no second writer ever races the user's, and a later
+// re-apply meets the same webhook.
+//
+// A cluster that is not elastic is left alone. One that is suspended, or has no active slice, only gets the gate.
+//
+// Besides the label and the slice name, it puts back what the job reconciler stamped from the
+// admission when it started the cluster: the Workload annotation when Pod scheduling is tracked,
+// the queue labels when AssignQueueLabelsForPods is enabled, the topology scheduling gate and
+// annotation of a PodSet with a topology assignment, and the flavors' node labels and tolerations.
+// Stamps from MultiKueue and admission-check PodSetUpdates are not restored.
+func (w *RayClusterWebhook) restampElasticTemplates(ctx context.Context, obj *rayv1.RayCluster) error {
+	if !isAnElasticJob(obj) {
+		return nil
+	}
+	job := fromObject(obj)
+	utilpod.GateTemplate(&job.Spec.HeadGroupSpec.Template, kueue.ElasticJobSchedulingGate)
+	for i := range job.Spec.WorkerGroupSpecs {
+		utilpod.GateTemplate(&job.Spec.WorkerGroupSpecs[i].Template, kueue.ElasticJobSchedulingGate)
+	}
+	if job.IsSuspended() {
+		return nil
+	}
+	active, err := workloadslicing.FindLatestActiveWorkload(ctx, w.client, job.Object(), job.GVK())
+	if err != nil {
+		return err
+	}
+	if active == nil || !workloadslicing.IsElasticWorkload(active) {
+		return nil
+	}
+	sliceName := workloadslicing.SliceName(active)
+	templates := map[kueue.PodSetReference]*corev1.PodTemplateSpec{
+		headGroupPodSetName: &job.Spec.HeadGroupSpec.Template,
+	}
+	for i := range job.Spec.WorkerGroupSpecs {
+		wgs := &job.Spec.WorkerGroupSpecs[i]
+		templates[kueue.NewPodSetReference(wgs.GroupName)] = &wgs.Template
+	}
+	for podSet, template := range templates {
+		stampPodSet(ctx, template, podSet, active)
+		// The name of the slice that started the cluster stays: changing it would change the
+		// template of a running cluster, and with upgradeStrategy Recreate KubeRay deletes every
+		// Pod when the template changes. It only fills a gap that a re-apply left.
+		if _, found := template.Annotations[kueue.WorkloadAnnotation]; !found && podsScheduledTracking() {
+			startingWorkload := job.Spec.HeadGroupSpec.Template.Annotations[kueue.WorkloadAnnotation]
+			if startingWorkload == "" {
+				startingWorkload = sliceName
+			}
+			template.Annotations[kueue.WorkloadAnnotation] = startingWorkload
+		}
+		if err := w.stampAdmission(ctx, active, podSet, template); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// podsScheduledTracking reports whether the job reconciler stamps the Workload annotation
+// on the templates, as getPodSetsInfoFromStatus does.
+func podsScheduledTracking() bool {
+	return features.Enabled(features.WaitForPodsReadyUnscheduledTimeout) ||
+		features.Enabled(features.TopologyAwareScheduling) ||
+		features.Enabled(features.SchedulerLibraryIntegration)
+}
+
+// stampAdmission puts back what the job reconciler took from the admission when it started
+// the cluster: the topology scheduling gate and annotation of a PodSet with a topology
+// assignment, which keep its Pods from running outside their domains, and the flavors' node
+// labels and tolerations. It keeps a value the template already sets.
+func (w *RayClusterWebhook) stampAdmission(ctx context.Context, active *kueue.Workload, podSetName kueue.PodSetReference, template *corev1.PodTemplateSpec) error {
+	if active.Status.Admission == nil {
+		return nil
+	}
+	psIdx := slices.IndexFunc(active.Spec.PodSets, func(ps kueue.PodSet) bool { return ps.Name == podSetName })
+	psaIdx := slices.IndexFunc(active.Status.Admission.PodSetAssignments, func(psa kueue.PodSetAssignment) bool { return psa.Name == podSetName })
+	if psIdx == -1 || psaIdx == -1 {
+		return nil
+	}
+	info, err := podset.FromAssignment(ctx, w.client, &active.Status.Admission.PodSetAssignments[psaIdx], &active.Spec.PodSets[psIdx])
+	if err != nil {
+		return err
+	}
+	for _, gate := range info.SchedulingGates {
+		utilpod.GateTemplate(template, gate.Name)
+	}
+	for key, value := range info.Annotations {
+		if key == kueue.PodSetUnconstrainedTopologyAnnotation {
+			if _, found := template.Annotations[key]; !found {
+				template.Annotations[key] = value
+			}
+		}
+	}
+	for key, value := range info.NodeSelector {
+		if _, found := template.Spec.NodeSelector[key]; !found {
+			if template.Spec.NodeSelector == nil {
+				template.Spec.NodeSelector = make(map[string]string, len(info.NodeSelector))
+			}
+			template.Spec.NodeSelector[key] = value
+		}
+	}
+	for _, toleration := range info.Tolerations {
+		if !slices.ContainsFunc(template.Spec.Tolerations, func(t corev1.Toleration) bool { return toleration.MatchToleration(&t) }) {
+			template.Spec.Tolerations = append(template.Spec.Tolerations, toleration)
+		}
+	}
+	return nil
+}
+
+func stampPodSet(ctx context.Context, template *corev1.PodTemplateSpec, podSet kueue.PodSetReference, active *kueue.Workload) {
+	if template.Labels == nil {
+		template.Labels = make(map[string]string, 3)
+	}
+	template.Labels[constants.PodSetLabel] = string(podSet)
+	if features.Enabled(features.AssignQueueLabelsForPods) {
+		jobframework.AssignQueueLabels(ctx, template.Labels, active)
+	}
+	if template.Annotations == nil {
+		template.Annotations = make(map[string]string, 1)
+	}
+	template.Annotations[kueue.WorkloadSliceNameAnnotation] = workloadslicing.SliceName(active)
+}
