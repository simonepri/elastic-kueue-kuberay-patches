+				t.Errorf("check = %s %q, want Retry containing %q", check.State, check.Message, tc.wantMessage)
+			}
+			if n := len(f.claims()); n != 0 {
+				t.Errorf("got %d NodeClaims, want 0", n)
+			}
+			if _, ok := f.workload().Annotations[ExcludedFlavorsAnnotation]; !ok {
+				t.Error("flavor not excluded")
+			}
+		})
+	}
+}
