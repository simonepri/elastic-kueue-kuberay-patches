+			requirements: []any{cpu("32"), cpu("8")}, fraction: 1, want: 8,
+		},
+		"gpus bound": {
+			requests:     corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("1"), "nvidia.com/gpu": resource.MustParse("1")},
+			requirements: []any{cpu("96"), gpus}, fraction: 0.5, want: 4,
+		},
+		"resource without capacity label": {
+			requests:     corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("1"), corev1.ResourceEphemeralStorage: resource.MustParse("1Gi")},
+			requirements: []any{cpu("96")}, fraction: 0.5, want: 1,
+		},
+		"pod larger than the fraction": {
+			requests:     corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("6")},
+			requirements: []any{cpu("8")}, fraction: 0.5, want: 1,
+		},
+		"non-numeric value": {
+			requests:     corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("1")},
+			requirements: []any{cpu("large")}, fraction: 0.5, want: 1,
+		},
+		"no requests": {requirements: []any{cpu("8")}, fraction: 0.5, want: 1},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			if got := podsPerNodeClaim(tc.requests, tc.requirements, tc.fraction); got != tc.want {
+				t.Errorf("podsPerNodeClaim = %d, want %d", got, tc.want)
+			}
+		})
+	}
