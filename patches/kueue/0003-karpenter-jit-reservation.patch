+func TestParseConfig(t *testing.T) {
+	cases := map[string]struct {
+		annotations map[string]string
+		want        config
+		wantErr     bool
+	}{
+		"defaults": {
+			want: config{launchTimeout: DefaultLaunchTimeout, waitFor: conditionLaunched, flavorCooldown: DefaultFlavorCooldown,
+				nodeFillFraction: DefaultNodeFillFraction, maxNodeClaims: DefaultMaxNodeClaims},
+		},
+		"overrides": {
+			annotations: map[string]string{
+				LaunchTimeoutAnnotation: "90s", WaitForAnnotation: conditionRegistered, FlavorCooldownAnnotation: "1h",
+				NodeClassAnnotation: "karpenter.k8s.aws/EC2NodeClass/default", NodeFillFractionAnnotation: "0.8", MaxNodeClaimsAnnotation: "8",
+			},
+			want: config{launchTimeout: 90 * time.Second, waitFor: conditionRegistered, flavorCooldown: time.Hour,
+				nodeClass:        nodeClassRef{group: "karpenter.k8s.aws", kind: "EC2NodeClass", name: "default"},
+				nodeFillFraction: 0.8, maxNodeClaims: 8},
+		},
+		"bad duration":        {annotations: map[string]string{LaunchTimeoutAnnotation: "soon"}, wantErr: true},
+		"zero cooldown":       {annotations: map[string]string{FlavorCooldownAnnotation: "0s"}, wantErr: true},
+		"bad wait-for":        {annotations: map[string]string{WaitForAnnotation: "Ready"}, wantErr: true},
+		"bad node class":      {annotations: map[string]string{NodeClassAnnotation: "default"}, wantErr: true},
+		"fill fraction above": {annotations: map[string]string{NodeFillFractionAnnotation: "1.5"}, wantErr: true},
+		"zero max claims":     {annotations: map[string]string{MaxNodeClaimsAnnotation: "0"}, wantErr: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ac := utiltestingapi.MakeAdmissionCheck("ac").Obj()
+			ac.Annotations = tc.annotations
+			got, err := parseConfig(ac)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("err = %v, wantErr %v", err, tc.wantErr)
+			}
+			if !tc.wantErr && got != tc.want {
+				t.Errorf("config = %+v, want %+v", got, tc.want)
+			}
+		})
+	}
+}
