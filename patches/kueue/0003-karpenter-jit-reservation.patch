+func TestReleasesDisruptionHoldOncePodsAreBound(t *testing.T) {
+	f := newFixture(t, reservedWorkload("karpenter-a").Obj(), nil)
+	f.reconcile()
+	claims := f.claims()
+	for i := range claims {
+		nodeName := fmt.Sprintf("node-%d", i)
+		if err := unstructured.SetNestedField(claims[i].Object, nodeName, "status", "nodeName"); err != nil {
+			t.Fatal(err)
+		}
+		f.setCondition(&claims[i], conditionLaunched)
+		node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: nodeName, Annotations: map[string]string{DoNotDisruptAnnotationKey: "true"}}}
+		if err := f.c.Create(f.ctx, node); err != nil {
+			t.Fatal(err)
+		}
+	}
+	f.reconcile()
+	if got := f.check().State; got != kueue.CheckStateReady {
+		t.Fatalf("check state = %s, want Ready", got)
+	}
+	daemon := &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "daemon", Namespace: ns, OwnerReferences: []metav1.OwnerReference{{
+		APIVersion: "apps/v1", Kind: "DaemonSet", Name: "agent", UID: "ds", Controller: new(true),
+	}}}, Spec: corev1.PodSpec{NodeName: "node-0"}}
+	worker := &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "worker-0", Namespace: ns}, Spec: corev1.PodSpec{NodeName: "node-0"}}
+	for _, pod := range []*corev1.Pod{daemon, worker} {
+		if err := f.c.Create(f.ctx, pod); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if res := f.reconcile(); res.RequeueAfter == 0 {
+		t.Error("expected a requeue while node-1 has no pods")
+	}
+	held := func() []string {
+		var names []string
+		for _, claim := range f.claims() {
+			node := &corev1.Node{}
+			if err := f.c.Get(f.ctx, types.NamespacedName{Name: claim.Object["status"].(map[string]any)["nodeName"].(string)}, node); err != nil {
+				t.Fatal(err)
+			}
+			_, claimHeld := claim.GetAnnotations()[DoNotDisruptAnnotationKey]
+			_, nodeHeld := node.Annotations[DoNotDisruptAnnotationKey]
+			if claimHeld != nodeHeld {
+				t.Errorf("NodeClaim %s held=%t but its Node held=%t", claim.GetName(), claimHeld, nodeHeld)
+			}
+			if claimHeld {
+				names = append(names, node.Name)
+			}
+		}
+		return names
+	}
+	if diff := cmp.Diff([]string{"node-1"}, held()); diff != "" {
+		t.Errorf("held nodes (-want +got):\n%s", diff)
+	}
+
+	if err := f.c.Create(f.ctx, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "worker-1", Namespace: ns}, Spec: corev1.PodSpec{NodeName: "node-1"}}); err != nil {
+		t.Fatal(err)
+	}
+	if res := f.reconcile(); res.RequeueAfter != 0 {
+		t.Errorf("RequeueAfter = %s, want no requeue once every hold is released", res.RequeueAfter)
+	}
+	if got := held(); len(got) != 0 {
+		t.Errorf("held nodes = %v, want none", got)
+	}
+	if got := f.workload().Annotations[HoldsReleasedAnnotation]; got != attemptID(f.workload(), reservedAt) {
+		t.Errorf("holds released annotation = %q, want the attempt", got)
+	}
+}
