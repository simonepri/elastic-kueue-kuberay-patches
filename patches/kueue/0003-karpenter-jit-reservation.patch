+	ps := utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 1).
+		InitContainers(
+			corev1.Container{Name: "sidecar", RestartPolicy: &always, Resources: corev1.ResourceRequirements{Requests: corev1.ResourceList{
