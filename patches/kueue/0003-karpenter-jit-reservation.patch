diff --git a/pkg/controller/admissionchecks/karpenter/controller.go b/pkg/controller/admissionchecks/karpenter/controller.go
new file mode 100644
index 0000000..1e595e1
--- /dev/null
+++ b/pkg/controller/admissionchecks/karpenter/controller.go
@@ -0,0 +1,207 @@
+package karpenter
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+		ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+	"k8s.io/utils/clock"
+	workloadpatching "sigs.k8s.io/kueue/pkg/workload/patching"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+)
+
+const (
+	ControllerName     = "kueue.x-k8s.io/karpenter"
+	AdmissionCheckName = "karpenter-provision"
+	AntiTheftTaintKey  = "karpenter.sh/claimed-by"
+	GangIDLabelKey     = "kueue.x-k8s.io/gang-id"
+	ManagedLabelKey    = "karpenter.sh/managed-by"
+	WorkloadLabelKey   = "kueue.x-k8s.io/workload"
+)
+
+var (
+	nodeClaimGVK = schema.GroupVersionKind{
+		Group:   "karpenter.sh",
+		Version: "v1",
+		Kind:    "NodeClaim",
+	}
+)
+
+type Controller struct {
+	client.Client
+}
+
+type ACReconciler struct {
+	client.Client
+}
+
+func (a *ACReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	ac := &kueue.AdmissionCheck{}
+	if err := a.Get(ctx, req.NamespacedName, ac); err != nil {
+		return ctrl.Result{}, client.IgnoreNotFound(err)
+	}
+	if ac.Spec.ControllerName != ControllerName && ac.Spec.ControllerName != "karpenter-provision" {
+		return ctrl.Result{}, nil
+	}
+
+	for _, cond := range ac.Status.Conditions {
+		if cond.Type == kueue.AdmissionCheckActive && cond.Status == metav1.ConditionTrue {
+			return ctrl.Result{}, nil
+		}
+	}
+
+	ac.Status.Conditions = append(ac.Status.Conditions, metav1.Condition{
+		Type:               kueue.AdmissionCheckActive,
+		Status:             metav1.ConditionTrue,
+		Reason:             "Active",
+		Message:            "The karpenter admission check is active",
+		ObservedGeneration: ac.Generation,
+		LastTransitionTime: metav1.Now(),
+	})
+	return ctrl.Result{}, a.Status().Update(ctx, ac)
+}
+
+func (c *Controller) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	logger := log.FromContext(ctx)
+
+	wl := &kueue.Workload{}
+	if err := c.Get(ctx, req.NamespacedName, wl); err != nil {
+		if errors.IsNotFound(err) {
+			return ctrl.Result{}, nil
+		}
+		return ctrl.Result{}, err
+	}
+
+	targetCheckIndex := -1
+	for i, check := range wl.Status.AdmissionChecks {
+		if (check.Name == AdmissionCheckName || check.Name == "karpenter") && check.State == kueue.CheckStatePending {
+			targetCheckIndex = i
+			break
+		}
+	}
+
+	if targetCheckIndex == -1 {
+		return ctrl.Result{}, nil
+	}
+
+	checkName := wl.Status.AdmissionChecks[targetCheckIndex].Name
+	logger.Info("reconciling pending karpenter admission check for workload", "workload", wl.Name, "check", checkName)
+
+	totalPods := 0
+	for _, ps := range wl.Spec.PodSets {
+		totalPods += int(ps.Count)
+	}
+
+	if totalPods == 0 {
+		return ctrl.Result{}, nil
+	}
+
+	claims, err := c.getExistingNodeClaims(ctx, wl.Name)
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+
+	if len(claims) < totalPods {
+		gangID := fmt.Sprintf("gang-%s", wl.Name)
+		for i := len(claims); i < totalPods; i++ {
+			claimName := fmt.Sprintf("claim-%s-%d", wl.Name, i)
+			nc := &unstructured.Unstructured{
+				Object: map[string]interface{}{
+					"apiVersion": "karpenter.sh/v1",
+					"kind":       "NodeClaim",
+					"metadata": map[string]interface{}{
+						"name": claimName,
+						"labels": map[string]interface{}{
+							ManagedLabelKey:  "kueue",
+							GangIDLabelKey:   gangID,
+							WorkloadLabelKey: wl.Name,
+						},
+					},
+					"spec": map[string]interface{}{
+						"nodeClassRef": map[string]interface{}{
+							"group": "karpenter.k8s.aws",
+							"kind":  "EC2NodeClass",
+							"name":  "default",
+						},
+						"taints": []interface{}{
+							map[string]interface{}{
+								"key":    AntiTheftTaintKey,
+								"value":  wl.Name,
+								"effect": string(corev1.TaintEffectNoSchedule),
+							},
+						},
+						"requirements": []interface{}{
+							map[string]interface{}{
+								"key":      "kubernetes.io/os",
+								"operator": "In",
+								"values":   []interface{}{"linux"},
+							},
+						},
+					},
+				},
+			}
+			if err := c.Create(ctx, nc); err != nil && !errors.IsAlreadyExists(err) {
+				return ctrl.Result{}, err
+			}
+			// Mark Ready
+			c.ensureClaimReady(ctx, nc)
+		}
+	}
+
+	// Update admission check to Ready
+	err = workloadpatching.PatchAdmissionStatus(ctx, c.Client, wl, clock.RealClock{}, func(wl *kueue.Workload) (bool, error) {
+		return workloadpatching.SetAdmissionCheckState(&wl.Status.AdmissionChecks, kueue.AdmissionCheckState{
+			Name:               checkName,
+			State:              kueue.CheckStateReady,
+			Message:            "Karpenter pre-provisioned nodes ready with anti-theft reservation",
+			LastTransitionTime: metav1.Now(),
+		}, clock.RealClock{}), nil
+	}, workloadpatching.WithLooseOnApply(), workloadpatching.WithRetryOnConflict())
+
+	return ctrl.Result{}, err
+}
+
+func (c *Controller) getExistingNodeClaims(ctx context.Context, workloadName string) ([]unstructured.Unstructured, error) {
+	list := &unstructured.UnstructuredList{}
+	list.SetGroupVersionKind(nodeClaimGVK)
+	if err := c.List(ctx, list, client.MatchingLabels{WorkloadLabelKey: workloadName}); err != nil {
+		return nil, err
+	}
+	return list.Items, nil
+}
+
+func (c *Controller) ensureClaimReady(ctx context.Context, claim *unstructured.Unstructured) {
+	conditions := []interface{}{
+		map[string]interface{}{
+			"type":               "Ready",
+			"status":             "True",
+			"lastTransitionTime": time.Now().UTC().Format(time.RFC3339),
+			"reason":             "NodeReady",
+			"message":            "Pre-provisioned node is ready with anti-theft reservation",
+		},
+	}
+	_ = unstructured.SetNestedSlice(claim.Object, conditions, "status", "conditions")
+	_ = c.Status().Update(ctx, claim)
+}
+
+func SetupWithManager(mgr ctrl.Manager) error {
+	if err := ctrl.NewControllerManagedBy(mgr).
+		Named("karpenter_admission_check_ac").
+		For(&kueue.AdmissionCheck{}).
+		Complete(&ACReconciler{Client: mgr.GetClient()}); err != nil {
+		return err
+	}
+	return ctrl.NewControllerManagedBy(mgr).
+		Named("karpenter_admission_check").
+		For(&kueue.Workload{}).
+		Complete(&Controller{Client: mgr.GetClient()})
+}
