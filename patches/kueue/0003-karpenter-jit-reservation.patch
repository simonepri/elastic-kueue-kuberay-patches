+func TestACInactiveWithoutConcurrentAdmission(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("ConcurrentAdmission=%t", enabled), func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ConcurrentAdmission, enabled)
+			ac := utiltestingapi.MakeAdmissionCheck(string(checkRef)).ControllerName(ControllerName).Obj()
+			c := utiltesting.NewClientBuilder().WithObjects(ac).WithStatusSubresource(ac).Build()
+			r := &ACReconciler{Client: c}
+			if _, err := r.Reconcile(t.Context(), reconcile.Request{NamespacedName: types.NamespacedName{Name: string(checkRef)}}); err != nil {
+				t.Fatal(err)
+			}
+			if err := c.Get(t.Context(), types.NamespacedName{Name: string(checkRef)}, ac); err != nil {
+				t.Fatal(err)
+			}
+			active := apimeta.FindStatusCondition(ac.Status.Conditions, kueue.AdmissionCheckActive)
+			wantStatus, wantReason := metav1.ConditionTrue, "Active"
+			if !enabled {
+				wantStatus, wantReason = metav1.ConditionFalse, "FeatureGateDisabled"
+			}
+			if active == nil || active.Status != wantStatus || active.Reason != wantReason {
+				t.Fatalf("Active condition = %v, want %s %s", active, wantStatus, wantReason)
+			}
+			if !enabled && !strings.Contains(active.Message, "--feature-gates=ConcurrentAdmission=true") {
+				t.Errorf("message %q does not say how to enable the feature gate", active.Message)
+			}
+		})
+	}
+}
