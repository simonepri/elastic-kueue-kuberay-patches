--- a/pkg/controller/jobs/deployment/deployment_webhook.go
+++ b/pkg/controller/jobs/deployment/deployment_webhook.go
@@ -85,7 +85,8 @@ func (wh *Webhook) Default(ctx context.Context, obj *appsv1.Deployment) error {
 	if err != nil {
 		return err
 	}
-	// ValidateUpdate rejects adding the label to a running Deployment that did not have it.
+	// Defaulting the label on a running Deployment would change its Pod template on any
+	// update and roll every Pod, so only an explicit label adds a class to it.
 	if oldDeploymentObj == nil || jobframework.CanSetWorkloadPriorityClassName(oldDeploymentObj.Status.ReadyReplicas == 0, oldDeploymentObj) {
 		if err := wh.integrationManager.ApplyDefaultWorkloadPriorityClass(ctx, wh.client, deployment.Object(), wh.managedJobsNamespaceSelector); err != nil {
 			return err
@@ -169,14 +170,17 @@ func (wh *Webhook) ValidateUpdate(ctx context.Context, oldObj, newObj *appsv1.De
 	allErrs := jobframework.ValidateQueueName(newDeployment.Object())
 	allErrs = append(allErrs, jobframework.ValidateElasticJobAnnotation(newDeployment.Object(), newDeployment.GVK())...)
 
-	// Prevents updating the queue-name if at least one Pod is not suspended
-	// or if the queue-name has been deleted.
-	isSuspended := oldDeployment.Status.ReadyReplicas == 0
-	if !isSuspended || newQueueName == "" {
+	// Prevents removing the queue-name once set.
+	// Changing the queue-name while Pods are ready is allowed because Kueue admits each
+	// Deployment Pod as its own workload, enabling zero-downtime rolling updates.
+	if newQueueName == "" {
 		allErrs = append(allErrs, apivalidation.ValidateImmutableField(newQueueName, oldQueueName, queueNameLabelPath)...)
 	}
+	// Adding a WorkloadPriorityClass to a running Deployment is allowed for the same reason:
+	// only Pods created after the change carry the label, so their new workloads get the class
+	// while existing workloads keep their priority. Removing it stays rejected.
 	allErrs = append(allErrs, jobframework.ValidateUpdateForWorkloadPriorityClassName(
-		isSuspended,
+		true,
 		oldDeployment.Object(),
 		newDeployment.Object(),
 	)...)
