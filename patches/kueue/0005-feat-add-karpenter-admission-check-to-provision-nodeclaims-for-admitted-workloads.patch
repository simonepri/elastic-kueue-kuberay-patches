+func TestCreatesNodeClaimsForAdmittedPods(t *testing.T) {
+	f := newFixture(t, reservedWorkload("karpenter-a").Obj(), nil)
+	if res := f.reconcile(); res.RequeueAfter == 0 {
+		t.Error("expected a requeue to poll the NodeClaims")
+	}
+
+	claims := f.claims()
+	if len(claims) != 2 {
+		t.Fatalf("got %d NodeClaims, want 2", len(claims))
+	}
+	attempt := attemptID(f.workload(), reservedAt)
+	for _, claim := range claims {
+		wantLabels := map[string]string{
+			ManagedLabelKey:                  "kueue",
+			"kueue.x-k8s.io/podset":          string(kueue.DefaultPodSetName),
+			GangIDLabelKey:                   "gang-" + wlName,
+			WorkloadLabelKey:                 "uid",
+			WorkloadNamespaceLabelKey:        ns,
+			AttemptLabelKey:                  attempt,
+			NodePoolLabelKey:                 "pool-a",
+			"karpenter.k8s.aws/ec2nodeclass": "gpu",
+			"team":                           "ml",
+		}
+		if diff := cmp.Diff(wantLabels, claim.GetLabels()); diff != "" {
+			t.Errorf("labels (-want +got):\n%s", diff)
+		}
+		wantAnnotations := map[string]string{
+			PodsAnnotation:                   "1",
+			DoNotDisruptAnnotationKey:        "true",
+			DisruptionHoldAnnotation:         "true",
+			nodePoolHashAnnotationKey:        "123",
+			nodePoolHashVersionAnnotationKey: "v3",
+			WorkloadAnnotation:               wlName,
+		}
+		if diff := cmp.Diff(wantAnnotations, claim.GetAnnotations()); diff != "" {
+			t.Errorf("annotations (-want +got):\n%s", diff)
+		}
+		if refs := claim.GetOwnerReferences(); len(refs) != 1 || refs[0].Kind != "NodePool" || refs[0].Name != "pool-a" {
+			t.Errorf("owner references = %v, want the NodePool", refs)
+		}
+		wantSpec := map[string]any{
+			"nodeClassRef": map[string]any{"group": "karpenter.k8s.aws", "kind": "EC2NodeClass", "name": "gpu"},
+			"requirements": []any{
+				map[string]any{"key": "karpenter.sh/capacity-type", "operator": "In", "values": []any{"on-demand"}},
+				requirement(NodePoolLabelKey, "pool-a"),
+			},
+			"taints": []any{
+				map[string]any{"key": AntiTheftTaintKey, "value": "uid", "effect": "NoSchedule"},
+				map[string]any{"key": "nvidia.com/gpu", "effect": "NoSchedule"},
+			},
+			"resources":   map[string]any{"requests": map[string]any{"cpu": "1", "pods": "1"}},
+			"expireAfter": "168h",
+		}
+		if diff := cmp.Diff(wantSpec, claim.Object["spec"]); diff != "" {
+			t.Errorf("spec (-want +got):\n%s", diff)
+		}
+	}
+	if got := f.workload().Annotations[ProvisionedAttemptAnnotation]; got != attempt {
+		t.Errorf("provisioned attempt = %q, want %q", got, attempt)
+	}
+	if got := f.check().State; got != kueue.CheckStatePending {
+		t.Errorf("check state = %s, want Pending", got)
+	}
+}
