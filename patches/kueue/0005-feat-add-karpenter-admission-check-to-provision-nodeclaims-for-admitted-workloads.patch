+func TestPodPlacementNarrowsDaemonOverheadAndPacking(t *testing.T) {
+	amd := controllerOverheadDaemonSet("2", "1Gi")
+	amd.Spec.Template.Spec.NodeSelector = map[string]string{corev1.LabelArchStable: "amd64"}
+	arm := controllerOverheadDaemonSet("8", "64Gi")
+	arm.Name, arm.UID = "arm-agent", "arm-agent"
+	arm.Spec.Template.Spec.NodeSelector = map[string]string{corev1.LabelArchStable: "arm64"}
+	ps := utiltestingapi.MakePodSet("workers", 4).Request(corev1.ResourceCPU, "1").Request(corev1.ResourceMemory, "1Gi").Obj()
+	ps.Template.Spec.Affinity = mandatoryAffinity(placementTerm(corev1.LabelArchStable, corev1.NodeSelectorOpIn, "amd64"))
+	f := newFixture(t, podSetWorkload(ps), nil, amd, arm)
+	f.setPoolField([]any{requirement("karpenter.k8s.aws/instance-cpu", "8"), requirement("karpenter.k8s.aws/instance-memory", "65536")}, "spec", "template", "spec", "requirements")
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 2 {
+		t.Fatalf("claims = %d, want 2 with narrowed overhead and packing", len(claims))
+	}
+	for _, claim := range claims {
+		if diff := cmp.Diff(map[string]string{"cpu": "4", "memory": "3Gi", "pods": "3"}, requests(t, claim)); diff != "" {
+			t.Errorf("requests (-want +got):\n%s", diff)
+		}
+		if claim.GetAnnotations()[PodsAnnotation] != "2" {
+			t.Errorf("workload pods = %s, want 2", claim.GetAnnotations()[PodsAnnotation])
+		}
+	}
