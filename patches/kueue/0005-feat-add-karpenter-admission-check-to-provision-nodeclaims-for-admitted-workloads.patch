+// reservedWorkload returns a Workload with 2 pods holding quota on the flavor and a Pending check.
+func reservedWorkload(flavor kueue.ResourceFlavorReference) *utiltestingapi.WorkloadWrapper {
+	return utiltestingapi.MakeWorkload(wlName, ns).
+		UID("uid").
+		Queue("lq").
+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 2).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Flavor(corev1.ResourceCPU, flavor).Count(2).Obj(),
+		).Obj(), reservedAt).
+		AdmissionCheck(kueue.AdmissionCheckState{Name: checkRef, State: kueue.CheckStatePending, LastTransitionTime: metav1.NewTime(reservedAt)})
+}
