+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 2).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Flavor(corev1.ResourceCPU, "karpenter-a").Count(2).Obj(),
+		).Obj(), reservedAt).
+		AdmissionCheck(kueue.AdmissionCheckState{Name: checkRef, State: kueue.CheckStatePending, LastTransitionTime: metav1.NewTime(reservedAt)}).
+		Obj()
+
+	f := newFixture(t, succWl, nil, prevWl)
+	f.wlKey = types.NamespacedName{Namespace: ns, Name: succWlName}
+
+	res := f.reconcile()
+	if res.RequeueAfter != 100*time.Millisecond {
+		t.Errorf("RequeueAfter = %v, want 100ms waiting for predecessor replaced status", res.RequeueAfter)
+	}
+}
+
+func TestRegrowSliceAfterPartialPreemptionAdoptsOnlyRemainingClaims(t *testing.T) {
+	sliceName := "partial-preempt-slice"
+	prevWlName := "slice-prev"
+	succWlName := "slice-succ"
+
+	prevWl := utiltestingapi.MakeWorkload(prevWlName, ns).
+		UID("uid-prev").
+		Queue("lq").
+		Annotation(kueue.WorkloadSliceNameAnnotation, sliceName).
+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 4).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Flavor(corev1.ResourceCPU, "karpenter-a").Count(4).Obj(),
+		).Obj(), reservedAt).
+		AdmittedAt(true, reservedAt).
+		ReclaimablePods(kueue.ReclaimablePod{Name: kueue.DefaultPodSetName, Count: 3}).
+		Condition(metav1.Condition{
+			Type:               kueue.WorkloadFinished,
+			Status:             metav1.ConditionTrue,
+			Reason:             kueue.WorkloadSliceReplaced,
+			LastTransitionTime: metav1.NewTime(reservedAt),
+		}).
+		Obj()
+
+	var prevClaims []client.Object
+	for i := 0; i < 4; i++ {
+		claim := (&nodeClaimTemplate{}).nodeClaim(prevWl, "prev-attempt", fmt.Sprintf("main-%d", i), 1, nil, nil)
+		labels := claim.GetLabels()
+		labels[constants.PodSetLabel] = string(kueue.DefaultPodSetName)
+		labels[AttemptLabelKey] = "prev-attempt"
+		labels[NodePoolLabelKey] = "pool-a"
+		labels[ManagedLabelKey] = "kueue"
+		claim.SetLabels(labels)
+		prevClaims = append(prevClaims, claim)
+	}
+
+	succWl := utiltestingapi.MakeWorkload(succWlName, ns).
+		UID("uid-succ").
+		Queue("lq").
+		Annotation(kueue.WorkloadSliceNameAnnotation, sliceName).
+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 4).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Flavor(corev1.ResourceCPU, "karpenter-a").Count(4).Obj(),
+		).Obj(), reservedAt).
+		AdmissionCheck(kueue.AdmissionCheckState{Name: checkRef, State: kueue.CheckStatePending, LastTransitionTime: metav1.NewTime(reservedAt)}).
+		Obj()
+
+	objs := append([]client.Object{prevWl}, prevClaims...)
+	f := newFixture(t, succWl, nil, objs...)
+	f.wlKey = types.NamespacedName{Namespace: ns, Name: succWlName}
+
+	f.reconcile()
+
+	claims := f.claims()
+	if len(claims) != 4 {
+		t.Fatalf("got %d NodeClaims after first reconcile, want 4 (1 adopted + 3 delta)", len(claims))
+	}
+
+	f.reconcile()
+
+	claims = f.claims()
+	if len(claims) != 4 {
+		t.Fatalf("got %d NodeClaims after second reconcile, want 4 kept", len(claims))
+	}
+	if got := f.check().State; got != kueue.CheckStatePending {
+		t.Fatalf("check state = %s, want Pending", got)
+	}
+
+	for i := range claims {
+		f.setCondition(&claims[i], conditionLaunched)
+	}
+	f.reconcile()
+
+	if got := f.check().State; got != kueue.CheckStateReady {
+		t.Errorf("check state = %s, want Ready after all Launched", got)
+	}
+}
