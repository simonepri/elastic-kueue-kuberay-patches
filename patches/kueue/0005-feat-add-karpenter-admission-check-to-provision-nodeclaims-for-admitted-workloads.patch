+// Package karpenter implements an AdmissionCheck that provisions Karpenter NodeClaims sized for the admitted pods
+// in the flavor's NodePool, waits for Karpenter to launch them, and steers the Workload to another flavor when it cannot.
+package karpenter
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"maps"
+	"math"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/equality"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/klog/v2"
+	"k8s.io/utils/clock"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/builder"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+	"sigs.k8s.io/controller-runtime/pkg/manager"
+	"sigs.k8s.io/controller-runtime/pkg/predicate"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	controllerconstants "sigs.k8s.io/kueue/pkg/controller/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/resources"
+	"sigs.k8s.io/kueue/pkg/util/admissioncheck"
+	"sigs.k8s.io/kueue/pkg/util/csv"
+	utilqueue "sigs.k8s.io/kueue/pkg/util/queue"
+	"sigs.k8s.io/kueue/pkg/util/resourcegroups"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadfinish "sigs.k8s.io/kueue/pkg/workload/finish"
+	workloadpatching "sigs.k8s.io/kueue/pkg/workload/patching"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+const (
+	ControllerName     = constants.KarpenterControllerName
+	AdmissionCheckName = "karpenter-provision"
+	AntiTheftTaintKey  = constants.KarpenterAntiTheftTaintKey
+	GangIDLabelKey     = "kueue.x-k8s.io/gang-id"
+	ManagedLabelKey    = "kueue.x-k8s.io/managed-by"
+	WorkloadLabelKey      = "kueue.x-k8s.io/workload"
+	WorkloadAnnotation    = kueue.WorkloadAnnotation
+	ClaimSuffixAnnotation = "kueue.x-k8s.io/karpenter-claim-suffix"
+
+	// AdoptedFrom annotations record predecessor Workload identity on adopted NodeClaims
+	// so that original labels can be restored if the successor's scale-up attempt fails.
+	AdoptedFromWorkloadAnnotation  = "kueue.x-k8s.io/karpenter-adopted-from-workload"
+	AdoptedFromUIDAnnotation       = "kueue.x-k8s.io/karpenter-adopted-from-uid"
+	AdoptedFromNamespaceAnnotation = "kueue.x-k8s.io/karpenter-adopted-from-namespace"
+
+	// WorkloadNamespaceLabelKey and AttemptLabelKey identify the quota reservation a NodeClaim serves.
+	WorkloadNamespaceLabelKey = "kueue.x-k8s.io/workload-namespace"
+	AttemptLabelKey           = constants.KarpenterAttemptLabel
+
+	// LaunchTimeoutAnnotation on the AdmissionCheck bounds how long the check waits for its NodeClaims.
+	LaunchTimeoutAnnotation = "kueue.x-k8s.io/karpenter-launch-timeout"
+	// WaitForAnnotation on the AdmissionCheck names the NodeClaim condition that makes it Ready: Launched or Registered.
+	WaitForAnnotation = "kueue.x-k8s.io/karpenter-wait-for"
+	// FlavorCooldownAnnotation on the AdmissionCheck sets how long a failed flavor stays excluded.
+	FlavorCooldownAnnotation = "kueue.x-k8s.io/karpenter-flavor-cooldown"
+	// NodeClassAnnotation on the AdmissionCheck names the node class, as "group/Kind/name", of NodeClaims for
+	// flavors whose node labels name no NodePool. Flavors that name a NodePool use the NodePool's nodeClassRef.
+	NodeClassAnnotation = constants.KarpenterNodeClassAnnotation
+	// NodeFillFractionAnnotation on the AdmissionCheck sets the share of the largest instance the NodePool allows
+	// that the pods packed onto one NodeClaim may request, between 0 (exclusive) and 1.
+	NodeFillFractionAnnotation = "kueue.x-k8s.io/karpenter-node-fill-fraction"
+	// MaxNodeClaimsAnnotation on the AdmissionCheck caps the NodeClaims of one quota reservation; a reservation
+	// that needs more fails like one Karpenter cannot launch.
+	MaxNodeClaimsAnnotation = "kueue.x-k8s.io/karpenter-max-nodeclaims"
+
+	// ExcludedFlavorsAnnotation on the Workload records each excluded flavor with the time its exclusion expires,
+	// as "flavor=RFC3339,...". The controller owns the allowed-flavors annotation only while this one is present.
+	ExcludedFlavorsAnnotation = "kueue.x-k8s.io/karpenter-excluded-flavors"
+	// ProvisionedAttemptAnnotation on the Workload records the attempt whose NodeClaims were all created,
+	// so a NodeClaim that is missing afterwards was deleted rather than not yet created.
+	ProvisionedAttemptAnnotation = "kueue.x-k8s.io/karpenter-provisioned-attempt"
+	// HoldsReleasedAnnotation on the Workload records the attempt whose NodeClaims no longer block disruption.
+	HoldsReleasedAnnotation = "kueue.x-k8s.io/karpenter-holds-released"
+
+	// DisruptionHoldAnnotation on a NodeClaim marks a do-not-disrupt annotation that the check set and removes
+	// once the NodeClaim's Node runs the pods the NodeClaim was sized for.
+	DisruptionHoldAnnotation = "kueue.x-k8s.io/karpenter-disruption-hold"
+	// PodsAnnotation on a NodeClaim records how many pods of its pod set the NodeClaim was sized for.
+	PodsAnnotation = "kueue.x-k8s.io/karpenter-pods"
+
+	// Karpenter's well-known label and annotations.
+	NodePoolLabelKey                 = constants.KarpenterNodePoolLabel
+	DoNotDisruptAnnotationKey        = "karpenter.sh/do-not-disrupt"
+	nodePoolHashAnnotationKey        = "karpenter.sh/nodepool-hash"
+	nodePoolHashVersionAnnotationKey = "karpenter.sh/nodepool-hash-version"
+
+	DefaultLaunchTimeout    = 5 * time.Minute
+	DefaultFlavorCooldown   = 10 * time.Minute
+	DefaultNodeFillFraction = 0.5
+	DefaultMaxNodeClaims    = 100
+	pollInterval            = 10 * time.Second
+	sweepInterval           = 5 * time.Minute
+	sweepGracePeriod        = 2 * time.Minute
+
+	conditionLaunched   = "Launched"
+	conditionRegistered = "Registered"
+)
+
+var (
+	nodeClaimGVK = schema.GroupVersionKind{Group: "karpenter.sh", Version: "v1", Kind: "NodeClaim"}
+	nodePoolGVK  = schema.GroupVersionKind{Group: "karpenter.sh", Version: "v1", Kind: "NodePool"}
+)
+
+// instanceCapacityLabels maps a resource to the instance label that states how much of it an instance has, and
+// the quantity of one label unit. They are the labels the Karpenter AWS provider puts on its instance types.
+var instanceCapacityLabels = map[corev1.ResourceName]struct {
+	key  string
+	unit resource.Quantity
+}{
+	corev1.ResourceCPU:    {"karpenter.k8s.aws/instance-cpu", resource.MustParse("1")},
+	corev1.ResourceMemory: {"karpenter.k8s.aws/instance-memory", resource.MustParse("1Mi")},
+	"nvidia.com/gpu":      {"karpenter.k8s.aws/instance-gpu-count", resource.MustParse("1")},
+}
+
+func isOwnController(name string) bool {
+	return name == ControllerName || name == AdmissionCheckName
+}
+
+type ACReconciler struct {
+	client.Client
+}
+
+func (a *ACReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	ac := &kueue.AdmissionCheck{}
+	if err := a.Get(ctx, req.NamespacedName, ac); err != nil {
+		return ctrl.Result{}, client.IgnoreNotFound(err)
+	}
+	if !isOwnController(ac.Spec.ControllerName) {
+		return ctrl.Result{}, nil
+	}
+	if !features.Enabled(features.ConcurrentAdmission) {
+		return ctrl.Result{}, a.setActive(ctx, ac, metav1.ConditionFalse, "FeatureGateDisabled",
+			"The karpenter admission check requires the ConcurrentAdmission feature gate, because Kueue honors the "+
+				controllerconstants.WorkloadAllowedResourceFlavorAnnotation+" annotation that moves Workloads to another flavor only with it; "+
+				"start Kueue with --feature-gates=ConcurrentAdmission=true")
+	}
+	if _, err := parseConfig(ac); err != nil {
+		return ctrl.Result{}, a.setActive(ctx, ac, metav1.ConditionFalse, "BadParameters", err.Error())
+	}
+	return ctrl.Result{}, a.setActive(ctx, ac, metav1.ConditionTrue, "Active", "The karpenter admission check is active")
+}
+
+func (a *ACReconciler) setActive(ctx context.Context, ac *kueue.AdmissionCheck, status metav1.ConditionStatus, reason, message string) error {
+	changed := apimeta.SetStatusCondition(&ac.Status.Conditions, metav1.Condition{
+		Type:               kueue.AdmissionCheckActive,
+		Status:             status,
+		Reason:             reason,
+		Message:            message,
+		ObservedGeneration: ac.Generation,
+	})
+	if !changed {
+		return nil
+	}
+	return a.Status().Update(ctx, ac)
+}
+
+// config holds the per-AdmissionCheck settings read from its annotations.
+type config struct {
+	launchTimeout    time.Duration
+	waitFor          string
+	flavorCooldown   time.Duration
+	nodeClass        nodeClassRef
+	nodeFillFraction float64
+	maxNodeClaims    int
+}
+
+// nodeClassRef is a NodeClaim's spec.nodeClassRef; the zero value means none is configured.
+type nodeClassRef struct {
+	group, kind, name string
+}
+
+func (r nodeClassRef) object() map[string]any {
+	return map[string]any{"group": r.group, "kind": r.kind, "name": r.name}
+}
+
+func parseConfig(ac *kueue.AdmissionCheck) (config, error) {
+	cfg := config{
+		launchTimeout:    DefaultLaunchTimeout,
+		waitFor:          conditionLaunched,
+		flavorCooldown:   DefaultFlavorCooldown,
+		nodeFillFraction: DefaultNodeFillFraction,
+		maxNodeClaims:    DefaultMaxNodeClaims,
+	}
+	for key, target := range map[string]*time.Duration{LaunchTimeoutAnnotation: &cfg.launchTimeout, FlavorCooldownAnnotation: &cfg.flavorCooldown} {
+		if v, ok := ac.Annotations[key]; ok {
+			d, err := time.ParseDuration(v)
+			if err != nil || d <= 0 {
+				return cfg, fmt.Errorf("annotation %s must be a positive duration, got %q", key, v)
+			}
+			*target = d
+		}
+	}
+	if v, ok := ac.Annotations[WaitForAnnotation]; ok {
+		if v != conditionLaunched && v != conditionRegistered {
+			return cfg, fmt.Errorf("annotation %s must be %s or %s, got %q", WaitForAnnotation, conditionLaunched, conditionRegistered, v)
+		}
+		cfg.waitFor = v
+	}
+	if v, ok := ac.Annotations[NodeClassAnnotation]; ok {
+		parts := strings.Split(v, "/")
+		if len(parts) != 3 || slices.Contains(parts, "") {
+			return cfg, fmt.Errorf("annotation %s must be group/Kind/name, got %q", NodeClassAnnotation, v)
+		}
+		cfg.nodeClass = nodeClassRef{group: parts[0], kind: parts[1], name: parts[2]}
+	}
+	if v, ok := ac.Annotations[NodeFillFractionAnnotation]; ok {
+		f, err := strconv.ParseFloat(v, 64)
+		if err != nil || f <= 0 || f > 1 {
+			return cfg, fmt.Errorf("annotation %s must be a number greater than 0 and at most 1, got %q", NodeFillFractionAnnotation, v)
+		}
+		cfg.nodeFillFraction = f
+	}
+	if v, ok := ac.Annotations[MaxNodeClaimsAnnotation]; ok {
+		n, err := strconv.Atoi(v)
+		if err != nil || n <= 0 {
+			return cfg, fmt.Errorf("annotation %s must be a positive integer, got %q", MaxNodeClaimsAnnotation, v)
+		}
+		cfg.maxNodeClaims = n
+	}
+	return cfg, nil
+}
+
+type Controller struct {
+	client.Client
+	// APIReader lists the Pods on a Node from the API server, which needs no Pod index in the cache.
+	APIReader client.Reader
+	Clock     clock.Clock
+}
+
+func (c *Controller) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
+	wl := &kueue.Workload{}
+	if err := c.Get(ctx, req.NamespacedName, wl); err != nil {
+		if apierrors.IsNotFound(err) {
+			return ctrl.Result{}, c.deleteNodeClaims(ctx, req.Namespace, req.Name, "")
+		}
+		return ctrl.Result{}, err
+	}
+
+	var expiry time.Duration
+	if _, owned := wl.Annotations[ExcludedFlavorsAnnotation]; owned {
+		var err error
+		if expiry, err = c.syncExclusions(ctx, wl); err != nil {
+			return ctrl.Result{}, err
+		}
+	}
+
+	if !holdsReservation(wl) {
+		if workloadslicing.IsReplaced(wl.Status) {
+			return ctrl.Result{RequeueAfter: expiry}, nil
+		}
+		if _, provisioned := wl.Annotations[ProvisionedAttemptAnnotation]; provisioned {
+			if err := c.releaseNodeClaims(ctx, wl); err != nil {
+				return ctrl.Result{}, err
+			}
+		}
+		return ctrl.Result{RequeueAfter: expiry}, nil
+	}
+
+	var checks []kueue.AdmissionCheckState
+	for _, check := range wl.Status.AdmissionChecks {
+		if check.State == kueue.CheckStatePending || check.State == kueue.CheckStateReady {
+			checks = append(checks, check)
+		}
+	}
+	for _, check := range checks {
+		ac := &kueue.AdmissionCheck{}
+		if err := c.Get(ctx, types.NamespacedName{Name: string(check.Name)}, ac); err != nil {
+			if apierrors.IsNotFound(err) {
+				continue
+			}
+			return ctrl.Result{}, err
+		}
+		if !isOwnController(ac.Spec.ControllerName) {
+			continue
+		}
+		cfg, err := parseConfig(ac)
+		if err != nil || !features.Enabled(features.ConcurrentAdmission) {
+			// The AdmissionCheck reconciler reports bad parameters and a disabled feature gate as Active=False.
+			return ctrl.Result{RequeueAfter: expiry}, nil
+		}
+		var result ctrl.Result
+		if check.State == kueue.CheckStatePending {
+			result, err = c.reconcileCheck(ctx, wl, check.Name, cfg)
+		} else {
+			result, err = c.releaseDisruptionHolds(ctx, wl)
+		}
+		if expiry > 0 && (result.RequeueAfter == 0 || expiry < result.RequeueAfter) {
+			result.RequeueAfter = expiry
+		}
+		return result, err
+	}
+	return ctrl.Result{RequeueAfter: expiry}, nil
+}
+
+// holdsReservation reports whether the Workload still uses the quota its current NodeClaims were created for.
+// A finished, deleted, deactivated, or evicted Workload, or one without quota, needs no NodeClaims.
+func holdsReservation(wl *kueue.Workload) bool {
+	return wl.DeletionTimestamp == nil && workload.IsActive(wl) && workload.HasQuotaReservation(wl) && wl.Status.Admission != nil &&
+		!apimeta.IsStatusConditionTrue(wl.Status.Conditions, kueue.WorkloadEvicted) &&
+		!apimeta.IsStatusConditionTrue(wl.Status.Conditions, kueue.WorkloadFinished)
+}
+
+// releaseNodeClaims deletes every NodeClaim of a Workload that no longer holds a reservation, then forgets the attempt.
+func (c *Controller) releaseNodeClaims(ctx context.Context, wl *kueue.Workload) error {
+	if err := c.deleteNodeClaims(ctx, wl.Namespace, workloadClaimLabel(wl.Namespace, wl.Name, wl.UID), ""); err != nil {
+		return err
+	}
+	patch := client.MergeFrom(wl.DeepCopy())
+	delete(wl.Annotations, ProvisionedAttemptAnnotation)
+	delete(wl.Annotations, HoldsReleasedAnnotation)
+	log.FromContext(ctx).Info("Released NodeClaims of a Workload without a reservation")
+	return client.IgnoreNotFound(c.Patch(ctx, wl, patch))
+}
+
+// deleteNodeClaims deletes the Workload's NodeClaims except those of the given attempt.
+func (c *Controller) deleteNodeClaims(ctx context.Context, namespace, name, keepAttempt string) error {
+	claims, err := c.listNodeClaims(ctx, namespace, name)
+	if err != nil {
+		if apimeta.IsNoMatchError(err) {
+			return nil
+		}
+		return err
+	}
+	for i := range claims {
+		if keepAttempt != "" && claims[i].GetLabels()[AttemptLabelKey] == keepAttempt {
+			continue
+		}
+		if err := c.Delete(ctx, &claims[i]); client.IgnoreNotFound(err) != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Sweep deletes NodeClaims whose Workload no longer exists or no longer holds the reservation they were created for.
+// It catches what the Workload reconciler missed, such as a deletion while Kueue was down. NodeClaims younger than
+// sweepGracePeriod are skipped, so a Workload the informer cache has not caught up with keeps its new NodeClaims.
+func (c *Controller) Sweep(ctx context.Context) error {
+	list := &unstructured.UnstructuredList{}
+	list.SetGroupVersionKind(nodeClaimGVK.GroupVersion().WithKind("NodeClaimList"))
+	if err := c.List(ctx, list, client.MatchingLabels{ManagedLabelKey: "kueue"}); err != nil {
+		if apimeta.IsNoMatchError(err) {
+			return nil
+		}
+		return err
+	}
+	for i := range list.Items {
+		claim := &list.Items[i]
+		labels := claim.GetLabels()
+		namespace, name, attempt := labels[WorkloadNamespaceLabelKey], labels[WorkloadLabelKey], labels[AttemptLabelKey]
+		// NodeClaims created before the namespace and attempt labels cannot be matched to a Workload.
+		if namespace == "" || name == "" || attempt == "" || claim.GetDeletionTimestamp() != nil ||
+			c.Clock.Since(claim.GetCreationTimestamp().Time) < sweepGracePeriod {
+			continue
+		}
+		workloadName := claim.GetAnnotations()[WorkloadAnnotation]
+		if workloadName == "" {
+			workloadName = name
+		}
+		wl := &kueue.Workload{}
+		err := c.Get(ctx, types.NamespacedName{Namespace: namespace, Name: workloadName}, wl)
+		if client.IgnoreNotFound(err) != nil {
+			return err
+		}
+		if err == nil {
+			if workloadslicing.IsReplaced(wl.Status) {
+				continue
+			}
+			if holdsReservation(wl) &&
+				attemptID(wl, apimeta.FindStatusCondition(wl.Status.Conditions, kueue.WorkloadQuotaReserved).LastTransitionTime.Time) == attempt {
+				continue
+			}
+		}
+		log.FromContext(ctx).Info("Deleting orphaned NodeClaim", "nodeClaim", claim.GetName(), "workload", klog.KRef(namespace, name))
+		if err := c.Delete(ctx, claim); client.IgnoreNotFound(err) != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// syncExclusions drops the flavor exclusions once the Workload is admitted, since they have done their job, and
+// otherwise drops those whose cooldown has passed; it returns when the next remaining exclusion expires.
+func (c *Controller) syncExclusions(ctx context.Context, wl *kueue.Workload) (time.Duration, error) {
+	now := c.Clock.Now()
+	excluded := parseExclusions(wl.Annotations[ExcludedFlavorsAnnotation])
+	var next time.Duration
+	for flavor, expiry := range excluded {
+		if workload.IsAdmitted(wl) || !expiry.After(now) {
+			delete(excluded, flavor)
+		} else if left := expiry.Sub(now); next == 0 || left < next {
+			next = left
+		}
+	}
+	if len(excluded) == len(parseExclusions(wl.Annotations[ExcludedFlavorsAnnotation])) {
+		return next, nil
+	}
+	return next, c.writeExclusions(ctx, wl, excluded)
+}
+
+func (c *Controller) reconcileCheck(ctx context.Context, wl *kueue.Workload, checkName kueue.AdmissionCheckReference, cfg config) (ctrl.Result, error) {
+	logger := log.FromContext(ctx).WithValues("check", checkName)
+	reservedAt := apimeta.FindStatusCondition(wl.Status.Conditions, kueue.WorkloadQuotaReserved).LastTransitionTime.Time
+	attempt := attemptID(wl, reservedAt)
+
+	// Right after a reservation on a flavor the check does not guard, the check is still Pending
+	// until Kueue drops it from the Workload; it needs no NodeClaims.
+	guarded, err := c.guardedFlavors(ctx, wl, checkName, cfg)
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+	if len(guarded) == 0 {
+		return ctrl.Result{}, c.setCheck(ctx, wl, checkName, kueue.CheckStateReady, "No pods require NodeClaims")
+	}
+
+	workloadID := workloadClaimLabel(wl.Namespace, wl.Name, wl.UID)
+	claims, err := c.listNodeClaims(ctx, wl.Namespace, workloadID)
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+
+	var previousCounts workload.PodSetsCounts
+	if wl.Annotations[ProvisionedAttemptAnnotation] != attempt {
+		if sliceName := wl.Annotations[kueue.WorkloadSliceNameAnnotation]; sliceName != "" {
+			prev, err := workloadslicing.FindLatestAdmittedWorkloadForSlice(ctx, c.Client, wl.Namespace, sliceName, workloadslicing.WithFinishedWorkloads())
+			if err == nil && prev != nil && prev.Name != wl.Name {
+				if !workloadslicing.IsReplaced(prev.Status) {
+					if !workloadfinish.IsFinished(prev) {
+						// Only adopt once predecessor is finished with WorkloadSliceReplaced.
+						return ctrl.Result{RequeueAfter: 100 * time.Millisecond}, nil
+					}
+				} else {
+					previousCounts, _ = workloadslicing.PreviousAdmittedPodSetCounts(ctx, c.Client, wl)
+					prevClaims, err := c.listNodeClaims(ctx, prev.Namespace, workloadClaimLabel(prev.Namespace, prev.Name, prev.UID))
+					if err == nil && len(prevClaims) > 0 {
+						sort.Slice(prevClaims, func(i, j int) bool {
+							return prevClaims[i].GetName() < prevClaims[j].GetName()
+						})
+						adoptedCounts := map[string]int{}
+						adoptedPods := map[string]int32{}
+						for i := range claims {
+							cObj := &claims[i]
+							if cObj.GetLabels()[AttemptLabelKey] == attempt && cObj.GetAnnotations()[ClaimSuffixAnnotation] != "" {
+								podSet := cObj.GetLabels()[constants.PodSetLabel]
+								adoptedCounts[podSet]++
+								claimPods := int32(1)
+								if n, err := strconv.ParseInt(cObj.GetAnnotations()[PodsAnnotation], 10, 32); err == nil && n > 0 {
+									claimPods = int32(n)
+								}
+								adoptedPods[podSet] += claimPods
+							}
+						}
+						for i := range prevClaims {
+							pClaim := &prevClaims[i]
+							if pClaim.GetDeletionTimestamp() != nil {
+								continue
+							}
+							podSet := pClaim.GetLabels()[constants.PodSetLabel]
+							claimPods := int32(1)
+							if n, err := strconv.ParseInt(pClaim.GetAnnotations()[PodsAnnotation], 10, 32); err == nil && n > 0 {
+								claimPods = int32(n)
+							}
+							limitPods := int32(math.MaxInt32)
+							if previousCounts != nil {
+								if limit, ok := previousCounts[kueue.PodSetReference(podSet)]; ok {
+									limitPods = limit
+								}
+							}
+							if adoptedPods[podSet]+claimPods > limitPods {
+								_ = c.Delete(ctx, pClaim)
+								continue
+							}
+							suffix := fmt.Sprintf("%s-%d", podSet, adoptedCounts[podSet])
+							adoptedCounts[podSet]++
+							adoptedPods[podSet] += claimPods
+							if pClaim.GetLabels()[WorkloadLabelKey] != workloadID {
+								patch := client.MergeFrom(pClaim.DeepCopy())
+								pLabels := pClaim.GetLabels()
+								pLabels[WorkloadNamespaceLabelKey] = wl.Namespace
+								pLabels[WorkloadLabelKey] = workloadID
+								pLabels[AttemptLabelKey] = attempt
+								pClaim.SetLabels(pLabels)
+								pAnnotations := pClaim.GetAnnotations()
+								if pAnnotations == nil {
+									pAnnotations = map[string]string{}
+								}
+								pAnnotations[WorkloadAnnotation] = wl.Name
+								pAnnotations[ClaimSuffixAnnotation] = suffix
+								pAnnotations[AdoptedFromWorkloadAnnotation] = prev.Name
+								pAnnotations[AdoptedFromUIDAnnotation] = string(prev.UID)
+								pAnnotations[AdoptedFromNamespaceAnnotation] = prev.Namespace
+								pClaim.SetAnnotations(pAnnotations)
+								if err := c.Patch(ctx, pClaim, patch); err == nil {
+									claims = append(claims, *pClaim)
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+
+	expected, problem, err := c.desiredNodeClaims(ctx, wl, attempt, cfg, guarded, claims, previousCounts)
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+	if problem != "" {
+		claims, err := c.listNodeClaims(ctx, wl.Namespace, workloadID)
+		if err != nil {
+			return ctrl.Result{}, err
+		}
+		current := make(map[string]*unstructured.Unstructured, len(claims))
+		for i := range claims {
+			current[claims[i].GetName()] = &claims[i]
+		}
+		logger.Info("Cannot provision NodeClaims on this flavor, retrying on another flavor", "reason", problem)
+		return ctrl.Result{}, c.fail(ctx, wl, checkName, cfg, current, problem)
+	}
+	if len(expected) == 0 {
+		if len(claims) == 0 {
+			return ctrl.Result{}, c.setCheck(ctx, wl, checkName, kueue.CheckStateReady, "No pods require NodeClaims")
+		}
+		if wl.Annotations[ProvisionedAttemptAnnotation] != attempt {
+			patch := client.MergeFromWithOptions(wl.DeepCopy(), client.MergeFromWithOptimisticLock{})
+			metav1.SetMetaDataAnnotation(&wl.ObjectMeta, ProvisionedAttemptAnnotation, attempt)
+			if err := c.Patch(ctx, wl, patch); err != nil {
+				return ctrl.Result{}, err
+			}
+		}
+		updates := podSetUpdatesForWorkload(wl, attempt, guarded)
+		return ctrl.Result{}, c.setCheck(ctx, wl, checkName, kueue.CheckStateReady, "All pods covered by existing NodeClaims", updates...)
+	}
+
+	current := make(map[string]*unstructured.Unstructured, len(claims))
+	for i := range claims {
+		claim := &claims[i]
+		if claim.GetLabels()[AttemptLabelKey] == attempt {
+			current[claim.GetName()] = claim
+			continue
+		}
+		// NodeClaims of an earlier quota reservation hold no pods, because eviction removed them.
+		if err := c.Delete(ctx, claim); client.IgnoreNotFound(err) != nil {
+			return ctrl.Result{}, err
+		}
+	}
+
+	if wl.Annotations[ProvisionedAttemptAnnotation] != attempt {
+		var missing []*unstructured.Unstructured
+		for _, nc := range expected {
+			if _, ok := current[nc.GetName()]; !ok {
+				missing = append(missing, nc)
+			}
+		}
+		problem, err := c.exceedsNodePoolLimits(ctx, missing)
+		if err != nil {
+			return ctrl.Result{}, err
+		}
+		if problem != "" {
+			logger.Info("Cannot provision NodeClaims on this flavor, retrying on another flavor", "reason", problem)
+			return ctrl.Result{}, c.fail(ctx, wl, checkName, cfg, current, problem)
+		}
+		for _, nc := range missing {
+			if _, ok := nc.GetLabels()[NodePoolLabelKey]; !ok {
+				logger.Info("Warning: the flavor names no NodePool in node label "+NodePoolLabelKey+
+					", so Karpenter does not apply NodePool limits, drift, or repair to the NodeClaim", "nodeClaim", nc.GetName())
+			}
+			if err := c.Create(ctx, nc); client.IgnoreAlreadyExists(err) != nil {
+				return ctrl.Result{}, err
+			}
+		}
+		patch := client.MergeFromWithOptions(wl.DeepCopy(), client.MergeFromWithOptimisticLock{})
+		metav1.SetMetaDataAnnotation(&wl.ObjectMeta, ProvisionedAttemptAnnotation, attempt)
+		if err := c.Patch(ctx, wl, patch); err != nil {
+			return ctrl.Result{}, err
+		}
+		logger.Info("Created NodeClaims", "count", len(expected), "attempt", attempt)
+		return ctrl.Result{RequeueAfter: min(pollInterval, cfg.launchTimeout)}, nil
+	}
+
+	ready := 0
+	var failure string
+	for _, nc := range expected {
+		claim, ok := current[nc.GetName()]
+		switch {
+		case !ok:
+			failure = fmt.Sprintf("NodeClaim %s was deleted before it became %s", nc.GetName(), cfg.waitFor)
+		case claim.GetDeletionTimestamp() != nil && !conditionTrue(claim, cfg.waitFor):
+			failure = fmt.Sprintf("NodeClaim %s is being deleted before it became %s", nc.GetName(), cfg.waitFor)
+		case conditionTrue(claim, cfg.waitFor):
+			ready++
+		}
+		if failure != "" {
+			break
+		}
+	}
+	if failure == "" && ready == len(expected) {
+		updates := podSetUpdatesForWorkload(wl, attempt, guarded)
+		return ctrl.Result{}, c.setCheck(ctx, wl, checkName, kueue.CheckStateReady,
+			fmt.Sprintf("All %d NodeClaims are %s", ready, cfg.waitFor), updates...)
+	}
+	elapsed := c.Clock.Since(reservedAt)
+	if failure == "" && elapsed >= cfg.launchTimeout {
+		failure = fmt.Sprintf("%d of %d NodeClaims became %s within %s", ready, len(expected), cfg.waitFor, cfg.launchTimeout)
+	}
+	if failure != "" {
+		logger.Info("Karpenter could not provide capacity, retrying on another flavor", "reason", failure)
+		return ctrl.Result{}, c.fail(ctx, wl, checkName, cfg, current, failure)
+	}
+	if err := c.setCheck(ctx, wl, checkName, kueue.CheckStatePending,
+		fmt.Sprintf("%d of %d NodeClaims are %s", ready, len(expected), cfg.waitFor)); err != nil {
+		return ctrl.Result{}, err
+	}
+	return ctrl.Result{RequeueAfter: min(pollInterval, cfg.launchTimeout-elapsed)}, nil
+}
+
+// fail releases the attempt's NodeClaims, excludes the flavors the check guards, and sets the check to Retry
+// so that Kueue evicts the Workload and assigns it a flavor that is still allowed.
+func (c *Controller) fail(ctx context.Context, wl *kueue.Workload, checkName kueue.AdmissionCheckReference, cfg config, claims map[string]*unstructured.Unstructured, reason string) error {
+	for _, claim := range claims {
+		if prevUID, ok := claim.GetAnnotations()[AdoptedFromUIDAnnotation]; ok && prevUID != "" {
+			// Restore labels on failure instead of deleting adopted predecessor claims
+			patch := client.MergeFrom(claim.DeepCopy())
+			labels := claim.GetLabels()
+			prevNs := claim.GetAnnotations()[AdoptedFromNamespaceAnnotation]
+			prevName := claim.GetAnnotations()[AdoptedFromWorkloadAnnotation]
+			labels[WorkloadNamespaceLabelKey] = prevNs
+			labels[WorkloadLabelKey] = workloadClaimLabel(prevNs, prevName, types.UID(prevUID))
+			delete(labels, AttemptLabelKey)
+			claim.SetLabels(labels)
+			annotations := claim.GetAnnotations()
+			annotations[WorkloadAnnotation] = prevName
+			delete(annotations, ClaimSuffixAnnotation)
+			delete(annotations, AdoptedFromWorkloadAnnotation)
+			delete(annotations, AdoptedFromUIDAnnotation)
+			delete(annotations, AdoptedFromNamespaceAnnotation)
+			claim.SetAnnotations(annotations)
+			if err := c.Patch(ctx, claim, patch); err != nil {
+				return err
+			}
+			continue
+		}
+		if err := c.Delete(ctx, claim); client.IgnoreNotFound(err) != nil {
+			return err
+		}
+	}
+	_, owned := wl.Annotations[ExcludedFlavorsAnnotation]
+	if _, foreign := wl.Annotations[controllerconstants.WorkloadAllowedResourceFlavorAnnotation]; foreign && !owned {
+		log.FromContext(ctx).Info("Not excluding flavors because another controller set the allowed flavors", "check", checkName)
+	} else {
+		flavors, err := c.guardedFlavors(ctx, wl, checkName, cfg)
+		if err != nil {
+			return err
+		}
+		excluded := parseExclusions(wl.Annotations[ExcludedFlavorsAnnotation])
+		expiry := c.Clock.Now().Add(cfg.flavorCooldown)
+		for _, f := range flavors {
+			excluded[f] = expiry
+		}
+		if err := c.writeExclusions(ctx, wl, excluded); err != nil {
+			return err
+		}
+		reason = fmt.Sprintf("%s; excluded flavors %s until %s", reason, strings.Join(flavors, ","), expiry.UTC().Format(time.RFC3339))
+	}
+	return c.setCheck(ctx, wl, checkName, kueue.CheckStateRetry, reason)
+}
+
+// guardedFlavors returns the flavors of the Workload's admission that the ClusterQueue runs the check for.
+func (c *Controller) guardedFlavors(ctx context.Context, wl *kueue.Workload, checkName kueue.AdmissionCheckReference, cfg config) ([]string, error) {
+	cq := &kueue.ClusterQueue{}
+	if err := c.Get(ctx, types.NamespacedName{Name: string(wl.Status.Admission.ClusterQueue)}, cq); err != nil {
+		return nil, err
+	}
+	onFlavors := admissioncheck.NewAdmissionChecks(cq)[checkName]
+	var flavors []string
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		for _, f := range psa.Flavors {
+			if onFlavors.Has(f) && !slices.Contains(flavors, string(f)) {
+				rf := &kueue.ResourceFlavor{}
+				if err := c.Get(ctx, types.NamespacedName{Name: string(f)}, rf); err != nil {
+					return nil, err
+				}
+				if rf.Spec.NodeLabels[NodePoolLabelKey] != "" || cfg.nodeClass.name != "" {
+					flavors = append(flavors, string(f))
+				}
+			}
+		}
+	}
+	sort.Strings(flavors)
+	return flavors, nil
+}
+
+// writeExclusions stores the exclusions and derives the allowed-flavors annotation from them: every flavor
+// of the ClusterQueue that is not excluded. With no exclusions left, it removes both annotations.
+func (c *Controller) writeExclusions(ctx context.Context, wl *kueue.Workload, excluded map[string]time.Time) error {
+	// The patch response replaces wl, so without the lock a stale wl would come back as the current
+	// reservation and the Retry that follows would evict a reservation this reconcile never saw.
+	patch := client.MergeFromWithOptions(wl.DeepCopy(), client.MergeFromWithOptimisticLock{})
+	if len(excluded) == 0 {
+		delete(wl.Annotations, ExcludedFlavorsAnnotation)
+		delete(wl.Annotations, controllerconstants.WorkloadAllowedResourceFlavorAnnotation)
+		return c.Patch(ctx, wl, patch)
+	}
+	cqName := wl.Spec.QueueName
+	lq := &kueue.LocalQueue{}
+	if err := c.Get(ctx, types.NamespacedName{Namespace: wl.Namespace, Name: string(cqName)}, lq); err != nil {
+		return err
+	}
+	cq := &kueue.ClusterQueue{}
+	if err := c.Get(ctx, types.NamespacedName{Name: string(lq.Spec.ClusterQueue)}, cq); err != nil {
+		return err
+	}
+	var allowed []string
+	for f := range utilqueue.AllFlavors(resourcegroups.EffectiveResourceGroups(cq)) {
+		if _, ok := excluded[string(f)]; !ok {
+			allowed = append(allowed, string(f))
+		}
+	}
+	sort.Strings(allowed)
+	metav1.SetMetaDataAnnotation(&wl.ObjectMeta, ExcludedFlavorsAnnotation, formatExclusions(excluded))
+	metav1.SetMetaDataAnnotation(&wl.ObjectMeta, controllerconstants.WorkloadAllowedResourceFlavorAnnotation, csv.Serialize(allowed))
+	return c.Patch(ctx, wl, patch)
+}
+
+func (c *Controller) setCheck(ctx context.Context, wl *kueue.Workload, checkName kueue.AdmissionCheckReference, state kueue.CheckState, message string, updates ...kueue.PodSetUpdate) error {
+	// Eviction resets the checks. Never resurrect Retry or Ready from a stale
+	// reservation; strict status patches below also reject concurrent eviction.
+	if !holdsReservation(wl) {
+		return nil
+	}
+	if current := admissioncheck.FindAdmissionCheck(wl.Status.AdmissionChecks, checkName); current != nil &&
+		current.State == state && current.Message == message && equality.Semantic.DeepEqual(current.PodSetUpdates, updates) {
+		return nil
+	}
+	return workloadpatching.PatchAdmissionStatus(ctx, c.Client, wl, c.Clock, func(wl *kueue.Workload) (bool, error) {
+		return workloadpatching.SetAdmissionCheckState(&wl.Status.AdmissionChecks, kueue.AdmissionCheckState{
+			Name:          checkName,
+			State:         state,
+			Message:       message,
+			PodSetUpdates: updates,
+		}, c.Clock), nil
+	})
+}
+
+// desiredNodeClaims returns the NodeClaims for the admitted pods. A pod set's NodeClaims are restricted to the
+// node labels of its flavors, use the NodePool those labels name, and each requests the resources of the pods
+// packed onto it. A non-empty problem means the check cannot provision this reservation on its flavors.
+func (c *Controller) desiredNodeClaims(
+	ctx context.Context,
+	wl *kueue.Workload,
+	attempt string,
+	cfg config,
+	guarded []string,
+	existing []unstructured.Unstructured,
+	previousCounts ...workload.PodSetsCounts,
+) ([]*unstructured.Unstructured, string, error) {
+	var prevCounts workload.PodSetsCounts
+	if len(previousCounts) > 0 {
+		prevCounts = previousCounts[0]
+	}
+	podSets := make(map[kueue.PodSetReference]kueue.PodSet, len(wl.Spec.PodSets))
+	for _, ps := range wl.Spec.PodSets {
+		podSets[ps.Name] = ps
+	}
+	nodeLabels := map[kueue.ResourceFlavorReference]map[string]string{}
+	overheadCache := map[string]corev1.ResourceList{}
+	var claims []*unstructured.Unstructured
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		provision := false
+		for _, flavor := range psa.Flavors {
+			provision = provision || slices.Contains(guarded, string(flavor))
+		}
+		if !provision {
+			continue
+		}
+		labels := map[string]string{}
+		for _, f := range psa.Flavors {
+			if _, ok := nodeLabels[f]; !ok {
+				rf := &kueue.ResourceFlavor{}
+				if err := c.Get(ctx, types.NamespacedName{Name: string(f)}, rf); err != nil {
+					return nil, "", err
+				}
+				nodeLabels[f] = rf.Spec.NodeLabels
+			}
+			for k, v := range nodeLabels[f] {
+				if previous, found := labels[k]; found && previous != v {
+					values := []string{previous, v}
+					slices.Sort(values)
+					return nil, fmt.Sprintf("pod set %s has conflicting flavor node labels for %s: %q and %q", psa.Name, k, values[0], values[1]), nil
+				}
+				labels[k] = v
+			}
+		}
+		ps := podSets[psa.Name]
+		count := ps.Count
+		if psa.Count != nil {
+			count = *psa.Count
+		}
+		isProvisioned := wl.Annotations[ProvisionedAttemptAnnotation] == attempt
+		var offset int32
+		if !isProvisioned {
+			var adoptedPods int32
+			for i := range existing {
+				if prevCounts != nil &&
+					existing[i].GetLabels()[AttemptLabelKey] == attempt &&
+					existing[i].GetLabels()[constants.PodSetLabel] == string(psa.Name) &&
+					existing[i].GetAnnotations()[ClaimSuffixAnnotation] != "" {
+					offset++
+					pods := int32(1)
+					if n, err := strconv.ParseInt(existing[i].GetAnnotations()[PodsAnnotation], 10, 32); err == nil && n > 0 {
+						pods = int32(n)
+					}
+					adoptedPods += pods
+				}
+			}
+			if prevCounts != nil {
+				count -= adoptedPods
+			}
+		}
+		if count <= 0 {
+			continue
+		}
+		if isProvisioned && len(existing) > 0 {
+			preserved, problem := provisionedPodSetClaims(wl, attempt, psa.Name, count, labels, existing)
+			if problem != "" {
+				return nil, problem, nil
+			}
+			claims = append(claims, preserved...)
+			continue
+		}
+		tmpl, problem, err := c.nodeClaimTemplate(ctx, labels, cfg)
+		if err != nil || problem != "" {
+			return nil, problem, err
+		}
+		tmpl.requirements, err = podPlacementRequirements(tmpl, &ps.Template.Spec)
+		if err != nil {
+			return nil, fmt.Sprintf("pod set %s cannot be provisioned: %s", ps.Name, err), nil
+		}
+		tmplKey := ""
+		if tmpl.nodePool != nil {
+			tmplKey = tmpl.nodePool.GetName()
+		}
+		overhead, ok := overheadCache[tmplKey]
+		if !ok {
+			overhead, err = c.daemonSetOverhead(ctx, tmpl)
+			if err != nil {
+				return nil, "", err
+			}
+			overheadCache[tmplKey] = overhead
+		}
+		perPod := resources.PodRequests(&ps.Template.Spec)
+		perClaim := min(podsPerNodeClaim(perPod, tmpl.requirements, cfg.nodeFillFraction, overhead), count)
+		for i := int32(0); i*perClaim < count; i++ {
+			pods := min(perClaim, count-i*perClaim)
+			suffix := fmt.Sprintf("%s-%d", psa.Name, offset+i)
+			claim := tmpl.nodeClaim(wl, attempt, suffix, pods, perPod, overhead)
+			labels := claim.GetLabels()
+			labels[constants.PodSetLabel] = string(psa.Name)
+			claim.SetLabels(labels)
+			claims = append(claims, claim)
+		}
+	}
+	if wl.Annotations[ProvisionedAttemptAnnotation] == attempt && len(existing) > 0 {
+		current := 0
+		for i := range existing {
+			if existing[i].GetLabels()[AttemptLabelKey] == attempt {
+				current++
+			}
+		}
+		if current != len(claims) {
+			return nil, "the provisioned attempt has unexpected NodeClaims", nil
+		}
+	} else if len(claims) > cfg.maxNodeClaims {
+		return nil, fmt.Sprintf("the reservation needs %d NodeClaims, more than the %d that annotation %s allows",
+			len(claims), cfg.maxNodeClaims, MaxNodeClaimsAnnotation), nil
+	}
+	return claims, "", nil
+}
+
+// nodeClaimTemplate holds what the NodeClaims of one pod set share.
+type nodeClaimTemplate struct {
+	// nodePool is the NodePool the flavor names, or nil when it names none.
+	nodePool     *unstructured.Unstructured
+	nodeClassRef map[string]any
+	requirements []any
+	// spec holds the NodePool template's taints, startup taints, expiry, and termination grace period.
+	spec        map[string]any
+	labels      map[string]string
+	annotations map[string]string
+}
+
+// nodeClaimTemplate builds the template from the NodePool that the flavor node labels name in karpenter.sh/nodepool,
+// as Karpenter builds its own NodeClaims, or from the node class annotation of the AdmissionCheck when they name none.
+func (c *Controller) nodeClaimTemplate(ctx context.Context, flavorLabels map[string]string, cfg config) (*nodeClaimTemplate, string, error) {
+	tmpl := &nodeClaimTemplate{spec: map[string]any{}, labels: map[string]string{}, annotations: map[string]string{}}
+	if name, ok := flavorLabels[NodePoolLabelKey]; ok {
+		pool := &unstructured.Unstructured{}
+		pool.SetGroupVersionKind(nodePoolGVK)
+		if err := c.Get(ctx, types.NamespacedName{Name: name}, pool); err != nil {
+			if apierrors.IsNotFound(err) || apimeta.IsNoMatchError(err) {
+				return nil, fmt.Sprintf("NodePool %s that the flavor names in node label %s does not exist", name, NodePoolLabelKey), nil
+			}
+			return nil, "", err
+		}
+		if _, static, _ := unstructured.NestedFieldNoCopy(pool.Object, "spec", "replicas"); static {
+			return nil, fmt.Sprintf("NodePool %s sets spec.replicas, and Karpenter removes NodeClaims beyond the replicas of a static NodePool", name), nil
+		}
+		ref, _, _ := unstructured.NestedMap(pool.Object, "spec", "template", "spec", "nodeClassRef")
+		if len(ref) == 0 {
+			return nil, fmt.Sprintf("NodePool %s has no spec.template.spec.nodeClassRef", name), nil
+		}
+		tmpl.nodePool = pool
+		tmpl.nodeClassRef = ref
+		tmpl.requirements, _, _ = unstructured.NestedSlice(pool.Object, "spec", "template", "spec", "requirements")
+		for _, field := range []string{"taints", "startupTaints", "expireAfter", "terminationGracePeriod"} {
+			if v, ok, _ := unstructured.NestedFieldCopy(pool.Object, "spec", "template", "spec", field); ok {
+				tmpl.spec[field] = v
+			}
+		}
+		if labels, _, _ := unstructured.NestedStringMap(pool.Object, "spec", "template", "metadata", "labels"); labels != nil {
+			tmpl.labels = labels
+		}
+		if annotations, _, _ := unstructured.NestedStringMap(pool.Object, "spec", "template", "metadata", "annotations"); annotations != nil {
+			tmpl.annotations = annotations
+		}
+	} else {
+		if cfg.nodeClass == (nodeClassRef{}) {
+			return nil, fmt.Sprintf("the flavor names no NodePool in node label %s and the AdmissionCheck has no %s annotation",
+				NodePoolLabelKey, NodeClassAnnotation), nil
+		}
+		tmpl.nodeClassRef = cfg.nodeClass.object()
+		tmpl.requirements = []any{requirement(corev1.LabelOSStable, string(corev1.Linux))}
+	}
+	keys := make([]string, 0, len(flavorLabels))
+	for k := range flavorLabels {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		tmpl.requirements = append(tmpl.requirements, requirement(k, flavorLabels[k]))
+	}
+	return tmpl, "", nil
+}
+
+// nodeClaim returns a NodeClaim for the given number of pods of a pod set.
+func (t *nodeClaimTemplate) nodeClaim(wl *kueue.Workload, attempt, suffix string, pods int32, perPod, overhead corev1.ResourceList) *unstructured.Unstructured {
+	totals := corev1.ResourceList{}
+	for name, q := range perPod {
+		total := q.DeepCopy()
+		total.Mul(int64(pods))
+		totals[name] = total
+	}
+	totals[corev1.ResourcePods] = *resource.NewQuantity(int64(pods), resource.DecimalSI)
+	for name, q := range overhead {
+		total := totals[name]
+		total.Add(q)
+		totals[name] = total
+	}
+	requests := map[string]any{}
+	for name, q := range totals {
+		if !q.IsZero() {
+			requests[string(name)] = q.String()
+		}
+	}
+	spec := map[string]any{}
+	maps.Copy(spec, runtime.DeepCopyJSON(t.spec))
+	spec["nodeClassRef"] = runtime.DeepCopyJSON(t.nodeClassRef)
+	spec["requirements"] = runtime.DeepCopyJSONValue(t.requirements)
+	spec["resources"] = map[string]any{"requests": requests}
+	taintVal := workloadTaintValue(wl)
+	poolTaints, _ := spec["taints"].([]any)
+	spec["taints"] = append([]any{map[string]any{
+		"key":    AntiTheftTaintKey,
+		"value":  taintVal,
+		"effect": string(corev1.TaintEffectNoSchedule),
+	}}, poolTaints...)
+
+	nc := &unstructured.Unstructured{Object: map[string]any{"spec": spec}}
+	nc.SetGroupVersionKind(nodeClaimGVK)
+	identity := fmt.Sprintf("%s/%s/%s", wl.Namespace, wl.Name, wl.UID)
+	nc.SetName(nodeClaimName(wl, attempt, suffix))
+	labels := map[string]string{}
+	maps.Copy(labels, t.labels)
+	maps.Copy(labels, map[string]string{
+		ManagedLabelKey:           "kueue",
+		GangIDLabelKey:            boundedClaimIdentity("gang-"+wl.Name, identity),
+		WorkloadLabelKey:          workloadClaimLabel(wl.Namespace, wl.Name, wl.UID),
+		WorkloadNamespaceLabelKey: wl.Namespace,
+		AttemptLabelKey:           attempt,
+	})
+	annotations := map[string]string{}
+	maps.Copy(annotations, t.annotations)
+	annotations[WorkloadAnnotation] = wl.Name
+	annotations[PodsAnnotation] = strconv.Itoa(int(pods))
+	if t.nodePool != nil {
+		// Karpenter applies a NodePool's limits accounting, drift, repair, and expiry to the NodeClaims labeled with it.
+		labels[NodePoolLabelKey] = t.nodePool.GetName()
+		if group, kind := t.nodeClassRef["group"], t.nodeClassRef["kind"]; group != nil && kind != nil {
+			labels[fmt.Sprintf("%v/%s", group, strings.ToLower(fmt.Sprint(kind)))] = fmt.Sprint(t.nodeClassRef["name"])
+		}
+		for _, key := range []string{nodePoolHashAnnotationKey, nodePoolHashVersionAnnotationKey} {
+			if v, ok := t.nodePool.GetAnnotations()[key]; ok {
+				annotations[key] = v
+			}
+		}
+		nc.SetOwnerReferences([]metav1.OwnerReference{{
+			APIVersion: nodePoolGVK.GroupVersion().String(),
+			Kind:       nodePoolGVK.Kind,
+			Name:       t.nodePool.GetName(),
+			UID:        t.nodePool.GetUID(),
+		}})
+		// Consolidation would remove a launched node before the pods it was made for are bound to it.
+		if annotations[DoNotDisruptAnnotationKey] != "true" {
+			annotations[DoNotDisruptAnnotationKey] = "true"
+			annotations[DisruptionHoldAnnotation] = "true"
+		}
+	}
+	nc.SetLabels(labels)
+	nc.SetAnnotations(annotations)
+	return nc
+}
+
+// nodeClaimName includes the workload UID when bounding a complete claim identity.
+func nodeClaimName(wl *kueue.Workload, attempt, suffix string) string {
+	name := strings.ToLower(fmt.Sprintf("%s-%s-%s", wl.Name, attempt, suffix))
+	identity := fmt.Sprintf("%s/%s/%s/%s/%s", wl.Namespace, wl.Name, wl.UID, attempt, suffix)
+	return boundedClaimIdentity(name, identity)
+}
+
+// boundedClaimIdentity keeps identities within Kubernetes label values, including providers' name-valued labels.
+func boundedClaimIdentity(value, identity string) string {
+	if len(value) <= 63 {
+		return value
+	}
+	sum := sha256.Sum256([]byte(identity))
+	return fmt.Sprintf("%s-%x", strings.TrimRight(value[:30], "-."), sum[:16])
+}
+
+// legacyNodeClaimName identifies claims created before complete names were label-compatible.
+func legacyNodeClaimName(workloadName, attempt, suffix string) string {
+	if len(workloadName) > 200 {
+		workloadName = workloadName[:200]
+	}
+	return strings.ToLower(fmt.Sprintf("%s-%s-%s", workloadName, attempt, suffix))
+}
+
+func matchesNodeClaimLabels(actual, expected map[string]string) bool {
+	for key, value := range expected {
+		if actual[key] != value {
+			return false
+		}
+	}
+	return true
+}
+
+func requirement(key, value string) map[string]any {
+	return map[string]any{"key": key, "operator": "In", "values": []any{value}}
+}
+
+// podsPerNodeClaim returns how many pods with the given requests one NodeClaim holds: as many as fit in the
+// fill fraction of the largest instance the requirements allow. It is 1 when the requirements do not bound
+// the instance size of a requested resource through the instance capacity labels.
+func podsPerNodeClaim(perPod corev1.ResourceList, requirements []any, fillFraction float64, overhead corev1.ResourceList) int32 {
+	pods := int64(math.MaxInt32)
+	for name, q := range perPod {
+		if q.IsZero() {
+			continue
+		}
+		capacityLabel, ok := instanceCapacityLabels[name]
+		if !ok {
+			return 1
+		}
+		units, ok := upperBound(requirements, capacityLabel.key)
+		if !ok {
+			return 1
+		}
+		capacity := float64(units) * float64(capacityLabel.unit.MilliValue())
+		reserved := overhead[name]
+		pods = min(pods, int64(math.Floor((fillFraction*capacity-float64(reserved.MilliValue()))/float64(q.MilliValue()))))
+	}
+	if pods == math.MaxInt32 {
+		return 1
+	}
+	return int32(max(pods, 1))
+}
+
+// upperBound returns the largest integer value that the requirements allow for the label, if they bound it.
+func upperBound(requirements []any, key string) (int64, bool) {
+	bound, found := int64(math.MaxInt64), false
+	for _, raw := range requirements {
+		req, ok := raw.(map[string]any)
+		if !ok || req["key"] != key {
+			continue
+		}
+		values, _ := req["values"].([]any)
+		switch req["operator"] {
+		case string(corev1.NodeSelectorOpIn):
+			largest := int64(math.MinInt64)
+			for _, v := range values {
+				n, err := strconv.ParseInt(fmt.Sprint(v), 10, 64)
+				if err != nil {
+					return 0, false
+				}
+				largest = max(largest, n)
+			}
+			if len(values) > 0 {
+				bound, found = min(bound, largest), true
+			}
+		case string(corev1.NodeSelectorOpLt):
+			if len(values) != 1 {
+				return 0, false
+			}
+			n, err := strconv.ParseInt(fmt.Sprint(values[0]), 10, 64)
+			if err != nil {
+				return 0, false
+			}
+			bound, found = min(bound, n-1), true
+		}
+	}
+	return bound, found && bound > 0
+}
+
+// exceedsNodePoolLimits reports a NodePool whose spec.limits the NodeClaims would exceed on top of its
+// status.resources. Karpenter enforces limits only on the NodeClaims it creates itself, so the check enforces
+// them on its own; instances usually have more than the requested resources, so this bounds usage from below.
+func (c *Controller) exceedsNodePoolLimits(ctx context.Context, claims []*unstructured.Unstructured) (string, error) {
+	added := map[string]corev1.ResourceList{}
+	for _, nc := range claims {
+		pool, ok := nc.GetLabels()[NodePoolLabelKey]
+		if !ok {
+			continue
+		}
+		if added[pool] == nil {
+			added[pool] = corev1.ResourceList{}
+		}
+		requests, _, _ := unstructured.NestedStringMap(nc.Object, "spec", "resources", "requests")
+		if requests == nil {
+			requests = map[string]string{}
+		}
+		requests["nodes"] = "1"
+		for name, v := range requests {
+			total := added[pool][corev1.ResourceName(name)]
+			total.Add(resource.MustParse(v))
+			added[pool][corev1.ResourceName(name)] = total
+		}
+	}
+	pools := slices.Sorted(maps.Keys(added))
+	for _, name := range pools {
+		pool := &unstructured.Unstructured{}
+		pool.SetGroupVersionKind(nodePoolGVK)
+		if err := c.Get(ctx, types.NamespacedName{Name: name}, pool); err != nil {
+			return "", err
+		}
+		limits, _, _ := unstructured.NestedStringMap(pool.Object, "spec", "limits")
+		used, _, _ := unstructured.NestedStringMap(pool.Object, "status", "resources")
+		for _, r := range slices.Sorted(maps.Keys(limits)) {
+			limit, err := resource.ParseQuantity(limits[r])
+			if err != nil {
+				continue
+			}
+			total := added[name][corev1.ResourceName(r)]
+			if v, err := resource.ParseQuantity(used[r]); err == nil {
+				total.Add(v)
+			}
+			if total.Cmp(limit) > 0 {
+				return fmt.Sprintf("the NodeClaims would take NodePool %s to %s %s, over its limit of %s", name, total.String(), r, limit.String()), nil
+			}
+		}
+	}
+	return "", nil
+}
+
+// releaseDisruptionHolds removes the do-not-disrupt annotation that the check set on a NodeClaim and its Node
+// once the Node runs as many pods, other than DaemonSet pods, as the NodeClaim was sized for. It polls while
+// a hold remains and records on the Workload when none does.
+func (c *Controller) releaseDisruptionHolds(ctx context.Context, wl *kueue.Workload) (ctrl.Result, error) {
+	attempt := wl.Annotations[ProvisionedAttemptAnnotation]
+	if attempt == "" || wl.Annotations[HoldsReleasedAnnotation] == attempt {
+		return ctrl.Result{}, nil
+	}
+	workloadID := workloadClaimLabel(wl.Namespace, wl.Name, wl.UID)
+	claims, err := c.listNodeClaims(ctx, wl.Namespace, workloadID)
+	if err != nil {
+		return ctrl.Result{}, err
+	}
+	held := 0
+	for i := range claims {
+		claim := &claims[i]
+		if claim.GetLabels()[AttemptLabelKey] != attempt || claim.GetAnnotations()[DisruptionHoldAnnotation] != "true" {
+			continue
+		}
+		nodeName, _, _ := unstructured.NestedString(claim.Object, "status", "nodeName")
+		bound, err := c.boundPods(ctx, nodeName)
+		if err != nil {
+			return ctrl.Result{}, err
+		}
+		want, err := strconv.Atoi(claim.GetAnnotations()[PodsAnnotation])
+		if err != nil {
+			want = 1
+		}
+		if bound < want {
+			held++
+			continue
+		}
+		release := client.RawPatch(types.MergePatchType, fmt.Appendf(nil, `{"metadata":{"annotations":{%q:null,%q:null}}}`,
+			DoNotDisruptAnnotationKey, DisruptionHoldAnnotation))
+		// Karpenter copies NodeClaim annotations to the Node when it registers, and reads them from the Node afterwards.
+		if err := c.Patch(ctx, &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: nodeName}}, release); client.IgnoreNotFound(err) != nil {
+			return ctrl.Result{}, err
+		}
+		if err := c.Patch(ctx, claim, release); client.IgnoreNotFound(err) != nil {
+			return ctrl.Result{}, err
+		}
+		log.FromContext(ctx).V(2).Info("Released the disruption hold of a NodeClaim", "nodeClaim", claim.GetName(), "node", nodeName)
+	}
+	if held > 0 {
+		return ctrl.Result{RequeueAfter: pollInterval}, nil
+	}
+	patch := client.MergeFrom(wl.DeepCopy())
+	metav1.SetMetaDataAnnotation(&wl.ObjectMeta, HoldsReleasedAnnotation, attempt)
+	return ctrl.Result{}, client.IgnoreNotFound(c.Patch(ctx, wl, patch))
+}
+
+// boundPods counts the running or pending Pods bound to the Node that no DaemonSet owns.
+func (c *Controller) boundPods(ctx context.Context, nodeName string) (int, error) {
+	if nodeName == "" {
+		return 0, nil
+	}
+	pods := &corev1.PodList{}
+	if err := c.APIReader.List(ctx, pods, client.MatchingFields{"spec.nodeName": nodeName}); err != nil {
+		return 0, err
+	}
+	bound := 0
+	for _, pod := range pods.Items {
+		owner := metav1.GetControllerOf(&pod)
+		if pod.Status.Phase == corev1.PodSucceeded || pod.Status.Phase == corev1.PodFailed || (owner != nil && owner.Kind == "DaemonSet") {
+			continue
+		}
+		bound++
+	}
+	return bound, nil
+}
+
+func (c *Controller) listNodeClaims(ctx context.Context, namespace, identity string) ([]unstructured.Unstructured, error) {
+	list := &unstructured.UnstructuredList{}
+	list.SetGroupVersionKind(nodeClaimGVK.GroupVersion().WithKind("NodeClaimList"))
+	if err := c.List(ctx, list, client.MatchingLabels{WorkloadLabelKey: identity, WorkloadNamespaceLabelKey: namespace}); err != nil {
+		return nil, err
+	}
+	if len(list.Items) > 0 {
+		return list.Items, nil
+	}
+	all := &unstructured.UnstructuredList{}
+	all.SetGroupVersionKind(nodeClaimGVK.GroupVersion().WithKind("NodeClaimList"))
+	if err := c.List(ctx, all, client.MatchingLabels{WorkloadNamespaceLabelKey: namespace}); err != nil {
+		return nil, err
+	}
+	var matched []unstructured.Unstructured
+	for _, item := range all.Items {
+		if item.GetAnnotations()[WorkloadAnnotation] == identity || item.GetLabels()[WorkloadLabelKey] == identity {
+			matched = append(matched, item)
+		}
+	}
+	return matched, nil
+}
+
+func workloadClaimLabel(namespace, name string, uid types.UID) string {
+	if uid != "" {
+		return string(uid)
+	}
+	identity := fmt.Sprintf("%s/%s", namespace, name)
+	return boundedClaimIdentity(name, identity)
+}
+
+func workloadTaintValue(wl *kueue.Workload) string {
+	if wl.UID != "" {
+		return string(wl.UID)
+	}
+	return workloadClaimLabel(wl.Namespace, wl.Name, wl.UID)
+}
+
+func podSetUpdatesForWorkload(wl *kueue.Workload, attempt string, guarded []string) []kueue.PodSetUpdate {
+	taintValue := workloadTaintValue(wl)
+	var updates []kueue.PodSetUpdate
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		hasGuarded := false
+		for _, flavor := range psa.Flavors {
+			if slices.Contains(guarded, string(flavor)) {
+				hasGuarded = true
+				break
+			}
+		}
+		if !hasGuarded {
+			continue
+		}
+		updates = append(updates, kueue.PodSetUpdate{
+			Name: psa.Name,
+			NodeSelector: map[string]string{
+				AttemptLabelKey: attempt,
+			},
+			Tolerations: []corev1.Toleration{
+				{
+					Key:      AntiTheftTaintKey,
+					Operator: corev1.TolerationOpEqual,
+					Value:    taintValue,
+					Effect:   corev1.TaintEffectNoSchedule,
+				},
+			},
+		})
+	}
+	return updates
+}
+
+// attemptID identifies one quota reservation of the Workload by its time and flavors,
+// so each reservation gets its own NodeClaims.
+func attemptID(wl *kueue.Workload, reservedAt time.Time) string {
+	key := fmt.Sprintf("%s/%s/%s/%d", wl.Namespace, wl.Name, wl.UID, reservedAt.Unix())
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		resources := make([]string, 0, len(psa.Flavors))
+		for r := range psa.Flavors {
+			resources = append(resources, string(r))
+		}
+		sort.Strings(resources)
+		for _, r := range resources {
+			key += fmt.Sprintf("/%s=%s", r, psa.Flavors[corev1.ResourceName(r)])
+		}
+	}
+	sum := sha256.Sum256([]byte(key))
+	return fmt.Sprintf("%x", sum[:5])
+}
+
+func conditionTrue(claim *unstructured.Unstructured, condType string) bool {
+	conditions, _, _ := unstructured.NestedSlice(claim.Object, "status", "conditions")
+	for _, raw := range conditions {
+		cond, ok := raw.(map[string]any)
+		if ok && cond["type"] == condType {
+			return cond["status"] == string(metav1.ConditionTrue)
+		}
+	}
+	return false
+}
+
+func parseExclusions(value string) map[string]time.Time {
+	excluded := map[string]time.Time{}
+	for _, entry := range csv.Parse(value) {
+		flavor, expiry, ok := strings.Cut(entry, "=")
+		if !ok {
+			continue
+		}
+		t, err := time.Parse(time.RFC3339, expiry)
+		if err != nil {
+			continue
+		}
+		excluded[flavor] = t
+	}
+	return excluded
+}
+
+func formatExclusions(excluded map[string]time.Time) string {
+	entries := make([]string, 0, len(excluded))
+	for flavor, expiry := range excluded {
+		entries = append(entries, flavor+"="+expiry.UTC().Format(time.RFC3339))
+	}
+	sort.Strings(entries)
+	return csv.Serialize(entries)
+}
+
+func SetupWithManager(mgr ctrl.Manager) error {
+	if err := ctrl.NewControllerManagedBy(mgr).
+		Named("karpenter_admission_check_ac").
+		For(&kueue.AdmissionCheck{}).
+		Complete(&ACReconciler{Client: mgr.GetClient()}); err != nil {
+		return err
+	}
+	c := &Controller{Client: mgr.GetClient(), APIReader: mgr.GetAPIReader(), Clock: clock.RealClock{}}
+	clnt := mgr.GetClient()
+	workloadPredicate := predicate.NewPredicateFuncs(func(obj client.Object) bool {
+		wl, ok := obj.(*kueue.Workload)
+		if !ok {
+			return false
+		}
+		if _, ok := wl.Annotations[ProvisionedAttemptAnnotation]; ok {
+			return true
+		}
+		if _, ok := wl.Annotations[ExcludedFlavorsAnnotation]; ok {
+			return true
+		}
+		for _, check := range wl.Status.AdmissionChecks {
+			if check.Name == AdmissionCheckName {
+				return true
+			}
+			ac := &kueue.AdmissionCheck{}
+			if err := clnt.Get(context.Background(), types.NamespacedName{Name: string(check.Name)}, ac); err == nil {
+				if isOwnController(ac.Spec.ControllerName) {
+					return true
+				}
+			}
+		}
+		return false
+	})
+	// NodeClaims are polled rather than watched, so Kueue starts on clusters without the Karpenter CRDs.
+	// Deleting a Workload also reconciles it, and the NotFound path deletes its NodeClaims.
+	if err := ctrl.NewControllerManagedBy(mgr).
+		Named("karpenter_admission_check").
+		For(&kueue.Workload{}, builder.WithPredicates(workloadPredicate)).
+		Complete(c); err != nil {
+		return err
+	}
+	// The sweep runs only on the leader, like every Runnable that does not opt out of leader election.
+	return mgr.Add(manager.RunnableFunc(func(ctx context.Context) error {
+		wait.UntilWithContext(ctx, func(ctx context.Context) {
+			if err := c.Sweep(ctx); err != nil {
+				log.FromContext(ctx).Error(err, "Sweeping orphaned NodeClaims")
+			}
+		}, sweepInterval)
+		return nil
+	}))
+}
diff --git a/pkg/controller/admissionchecks/karpenter/overhead.go b/pkg/controller/admissionchecks/karpenter/overhead.go
new file mode 100644
--- /dev/null
+++ b/pkg/controller/admissionchecks/karpenter/overhead.go
@@ -0,0 +1,340 @@
+/*
