+func baseObjects(acAnnotations map[string]string) []client.Object {
+	ac := utiltestingapi.MakeAdmissionCheck(string(checkRef)).ControllerName(ControllerName).Obj()
+	ac.Annotations = acAnnotations
+	return []client.Object{
+		ac,
+		utiltestingapi.MakeAdmissionCheck("other").ControllerName("example.com/other").Obj(),
+		utiltestingapi.MakeResourceFlavor("karpenter-a").NodeLabel(NodePoolLabelKey, "pool-a").Obj(),
+		utiltestingapi.MakeResourceFlavor("karpenter-b").NodeLabel("pool", "b").Obj(),
+		nodePool("pool-a"),
+		utiltestingapi.MakeResourceFlavor("remote").Obj(),
+		utiltestingapi.MakeClusterQueue("cq").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("karpenter-a").Resource(corev1.ResourceCPU, "10").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("karpenter-b").Resource(corev1.ResourceCPU, "10").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("remote").Resource(corev1.ResourceCPU, "10").Obj(),
+			).
+			AdmissionCheckStrategy(*utiltestingapi.MakeAdmissionCheckStrategyRule(checkRef, "karpenter-a", "karpenter-b").Obj()).
+			Obj(),
+		utiltestingapi.MakeLocalQueue("lq", ns).ClusterQueue("cq").Obj(),
+	}
+}
