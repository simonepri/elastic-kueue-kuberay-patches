+// Verify that provisioned NodeClaims retain mandatory Pod placement, resource requests, and the NodePool/flavor intersection.
+package karpenter
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
