+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/resources"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+const gpuMemoryLabel = "karpenter.k8s.aws/instance-gpu-memory"
+
+func mandatoryAffinity(terms ...corev1.NodeSelectorTerm) *corev1.Affinity {
+	return &corev1.Affinity{NodeAffinity: &corev1.NodeAffinity{RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{NodeSelectorTerms: terms}}}
+}
+
+func placementTerm(key string, op corev1.NodeSelectorOperator, values ...string) corev1.NodeSelectorTerm {
+	return corev1.NodeSelectorTerm{MatchExpressions: []corev1.NodeSelectorRequirement{{Key: key, Operator: op, Values: values}}}
+}
+
+func TestNodeClaimsPreservePodPlacement(t *testing.T) {
+	ps := utiltestingapi.MakePodSet("gpu", 1).Request(corev1.ResourceCPU, "3").Request(corev1.ResourceMemory, "12Gi").Request("nvidia.com/gpu", "1").Obj()
+	ps.Template.Spec.NodeSelector = map[string]string{"gpu-class": "l4"}
+	ps.Template.Spec.Affinity = mandatoryAffinity(placementTerm(gpuMemoryLabel, corev1.NodeSelectorOpGt, "20000"))
+	wl := podSetWorkload(ps)
+	wantSpec := wl.Spec.DeepCopy()
+	f := newFixture(t, wl, nil)
+	pool := &unstructured.Unstructured{}
+	pool.SetGroupVersionKind(nodePoolGVK)
+	if err := f.c.Get(f.ctx, types.NamespacedName{Name: "pool-a"}, pool); err != nil {
+		t.Fatal(err)
+	}
+	wantPool := pool.DeepCopy()
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 1 {
+		t.Fatalf("claims = %d, want 1", len(claims))
+	}
+	got, _, err := unstructured.NestedSlice(claims[0].Object, "spec", "requirements")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []any{
+		requirement("karpenter.sh/capacity-type", "on-demand"), requirement(NodePoolLabelKey, "pool-a"), requirement("gpu-class", "l4"),
+		map[string]any{"key": gpuMemoryLabel, "operator": "Gt", "values": []any{"20000"}},
+	}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("requirements (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(map[string]string{"cpu": "3", "memory": "12Gi", "nvidia.com/gpu": "1", "pods": "1"}, requests(t, claims[0])); diff != "" {
+		t.Errorf("resources (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(wantSpec, &f.workload().Spec); diff != "" {
+		t.Errorf("Workload spec mutated (-want +got):\n%s", diff)
+	}
+	if err := f.c.Get(f.ctx, types.NamespacedName{Name: "pool-a"}, pool); err != nil {
+		t.Fatal(err)
+	}
+	if diff := cmp.Diff(wantPool, pool); diff != "" {
+		t.Errorf("NodePool mutated (-want +got):\n%s", diff)
+	}
+}
