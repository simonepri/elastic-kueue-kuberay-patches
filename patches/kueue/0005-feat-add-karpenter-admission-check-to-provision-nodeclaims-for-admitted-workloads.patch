+func TestProvisionedClaimsAdoptedClaimAnnotationDoesNotMatchNameSuffix(t *testing.T) {
+	wl := reservedWorkload("karpenter-a").Obj()
+	wl.Name = strings.Repeat("a", 46)
+	attempt := attemptID(wl, reservedAt)
+	c0 := unstructured.Unstructured{}
+	c0.SetName("pred-attempt-main-1")
+	c0.SetLabels(map[string]string{
+		ManagedLabelKey:           "kueue",
+		WorkloadLabelKey:          wl.Name,
+		WorkloadNamespaceLabelKey: wl.Namespace,
+		AttemptLabelKey:           attempt,
+		constants.PodSetLabel:     string(kueue.DefaultPodSetName),
+		NodePoolLabelKey:          "pool-a",
+	})
+	c0.SetAnnotations(map[string]string{
+		PodsAnnotation:        "1",
+		ClaimSuffixAnnotation: fmt.Sprintf("%s-0", kueue.DefaultPodSetName),
+	})
+
+	c1 := unstructured.Unstructured{}
+	c1.SetName(nodeClaimName(wl, attempt, fmt.Sprintf("%s-1", kueue.DefaultPodSetName)))
+	c1.SetLabels(map[string]string{
+		ManagedLabelKey:           "kueue",
+		WorkloadLabelKey:          wl.Name,
+		WorkloadNamespaceLabelKey: wl.Namespace,
+		AttemptLabelKey:           attempt,
+		constants.PodSetLabel:     string(kueue.DefaultPodSetName),
+		NodePoolLabelKey:          "pool-a",
+	})
+	c1.SetAnnotations(map[string]string{
+		PodsAnnotation: "1",
+	})
+
+	got, problem := provisionedPodSetClaims(wl, attempt, kueue.DefaultPodSetName, 2, map[string]string{NodePoolLabelKey: "pool-a"}, []unstructured.Unstructured{c0, c1})
+	if problem != "" || len(got) != 2 {
+		t.Fatalf("expected 2 claims accepted, got %d problem=%s", len(got), problem)
+	}
+	if got[0].GetName() != c0.GetName() || got[1].GetName() != c1.GetName() {
+		t.Fatalf("unexpected order: %s, %s", got[0].GetName(), got[1].GetName())
+	}
