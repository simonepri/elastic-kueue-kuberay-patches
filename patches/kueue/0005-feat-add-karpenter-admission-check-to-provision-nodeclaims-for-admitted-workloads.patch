+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Size reserved NodeClaims for the DaemonSets that can share each node. Use admitted Pod requests while preserving the DaemonSet's placement constraints.
+package karpenter
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"strconv"
+
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/labels"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/selection"
+	"k8s.io/component-helpers/scheduling/corev1/nodeaffinity"
+	"k8s.io/klog/v2"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	"sigs.k8s.io/kueue/pkg/resources"
+)
+
+// +kubebuilder:rbac:groups="apps",resources=daemonsets,verbs=get;list
+// +kubebuilder:rbac:groups="karpenter.sh",resources=nodeclaims,verbs=get;list;create;patch;delete
+// +kubebuilder:rbac:groups="karpenter.sh",resources=nodepools,verbs=get
+// +kubebuilder:rbac:groups="",resources=nodes,verbs=patch
+
+// daemonSetOverhead returns one effective request, including a Pod slot, per compatible DaemonSet.
+func (c *Controller) daemonSetOverhead(ctx context.Context, tmpl *nodeClaimTemplate) (corev1.ResourceList, error) {
+	dsReader := c.APIReader
+	if dsReader == nil {
+		dsReader = c.Client
+	}
+	daemonSets := &appsv1.DaemonSetList{}
+	if err := dsReader.List(ctx, daemonSets); err != nil {
+		return nil, fmt.Errorf("listing DaemonSets for NodeClaim overhead: %w", err)
+	}
+	requests := corev1.ResourceList{}
+	if len(daemonSets.Items) == 0 {
+		return requests, nil
+	}
+	podReader := client.Reader(c.Client)
+	if podReader == nil {
+		podReader = c.APIReader
+	}
+	for i := range daemonSets.Items {
+		ds := &daemonSets.Items[i]
+		if ds.DeletionTimestamp != nil {
+			continue
+		}
+		var listOpts []client.ListOption
+		listOpts = append(listOpts, client.InNamespace(ds.Namespace))
+		if ds.Spec.Selector != nil {
+			selector, err := metav1.LabelSelectorAsSelector(ds.Spec.Selector)
+			if err != nil {
+				return nil, fmt.Errorf("parsing selector for DaemonSet %s/%s: %w", ds.Namespace, ds.Name, err)
+			}
+			listOpts = append(listOpts, client.MatchingLabelsSelector{Selector: selector})
+		}
+		dsPods := &corev1.PodList{}
+		if err := podReader.List(ctx, dsPods, listOpts...); err != nil {
+			return nil, fmt.Errorf("listing admitted DaemonSet Pods for NodeClaim overhead: %w", err)
+		}
+		daemonRequests := corev1.ResourceList{}
+		compatible := false
+		for _, pod := range daemonSetPods(ds, dsPods.Items) {
+			fits, err := daemonSetCompatible(tmpl, pod)
+			if err != nil {
+				return nil, fmt.Errorf("checking DaemonSet %s/%s for NodeClaim overhead: %w", ds.Namespace, ds.Name, err)
+			}
+			if !fits {
+				continue
+			}
+			compatible = true
+			// Replicas can have different admission/VPA requests during a rollout. Reserve their per-resource maximum once.
+			for name, quantity := range resources.PodRequests(&pod.Spec) {
+				if current := daemonRequests[name]; quantity.Cmp(current) > 0 {
+					daemonRequests[name] = quantity.DeepCopy()
+				}
+			}
+		}
+		if !compatible {
+			continue
+		}
+		for name, quantity := range daemonRequests {
+			total := requests[name]
+			total.Add(quantity)
+			requests[name] = total
+		}
+		count := requests[corev1.ResourcePods]
+		count.Add(resource.MustParse("1"))
+		requests[corev1.ResourcePods] = count
+	}
+	return requests, nil
+}
+
+// daemonSetPods preserves admission mutations without inheriting the controller's node-specific affinity.
+func daemonSetPods(ds *appsv1.DaemonSet, pods []corev1.Pod) []*corev1.Pod {
+	// The current template can request more than old replicas while its rollout is starting.
+	representatives := []*corev1.Pod{daemonSetSchedulingPod(ds, &corev1.Pod{Spec: *ds.Spec.Template.Spec.DeepCopy()})}
+	for i := range pods {
+		pod := &pods[i]
+		if pod.Namespace == ds.Namespace && metav1.IsControlledBy(pod, ds) &&
+			pod.Status.Phase != corev1.PodSucceeded && pod.Status.Phase != corev1.PodFailed && pod.DeletionTimestamp == nil {
+			representatives = append(representatives, daemonSetSchedulingPod(ds, pod))
+		}
+	}
+	return representatives
+}
+
+func daemonSetSchedulingPod(ds *appsv1.DaemonSet, admitted *corev1.Pod) *corev1.Pod {
+	pod := admitted.DeepCopy()
+	// The DaemonSet controller replaces required affinity with the selected node's name.
+	if pod.Spec.Affinity != nil && pod.Spec.Affinity.NodeAffinity != nil {
+		pod.Spec.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution = nil
+	}
+	if affinity := ds.Spec.Template.Spec.Affinity; affinity != nil && affinity.NodeAffinity != nil &&
+		affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution != nil {
+		if pod.Spec.Affinity == nil {
+			pod.Spec.Affinity = &corev1.Affinity{}
+		}
+		if pod.Spec.Affinity.NodeAffinity == nil {
+			pod.Spec.Affinity.NodeAffinity = &corev1.NodeAffinity{}
+		}
+		pod.Spec.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution =
+			affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution.DeepCopy()
+	}
+	// Kubernetes adds these tolerations when creating DaemonSet Pods, including when no replica exists yet.
+	for _, key := range []string{corev1.TaintNodeNotReady, corev1.TaintNodeUnreachable} {
+		pod.Spec.Tolerations = append(pod.Spec.Tolerations, corev1.Toleration{Key: key, Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoExecute})
+	}
+	for _, key := range []string{corev1.TaintNodeDiskPressure, corev1.TaintNodeMemoryPressure, corev1.TaintNodePIDPressure, corev1.TaintNodeUnschedulable} {
+		pod.Spec.Tolerations = append(pod.Spec.Tolerations, corev1.Toleration{Key: key, Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule})
+	}
+	if pod.Spec.HostNetwork {
+		pod.Spec.Tolerations = append(pod.Spec.Tolerations, corev1.Toleration{Key: corev1.TaintNodeNetworkUnavailable, Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule})
+	}
+	return pod
+}
+
+func daemonSetCompatible(tmpl *nodeClaimTemplate, pod *corev1.Pod) (bool, error) {
+	if raw, ok := tmpl.spec["taints"]; ok {
+		taints := struct {
+			Taints []corev1.Taint `json:"taints"`
+		}{}
+		if err := runtime.DefaultUnstructuredConverter.FromUnstructured(map[string]any{"taints": raw}, &taints); err != nil {
+			return false, fmt.Errorf("decoding NodePool taints: %w", err)
+		}
+		for _, taint := range taints.Taints {
+			if taint.Key == AntiTheftTaintKey || (taint.Effect != corev1.TaintEffectNoSchedule && taint.Effect != corev1.TaintEffectNoExecute) {
+				continue
+			}
+			tolerated := false
+			for _, toleration := range pod.Spec.Tolerations {
+				tolerated = tolerated || toleration.ToleratesTaint(klog.Background(), &taint, true)
+			}
+			if !tolerated {
+				return false, nil
+			}
+		}
+	}
+	base := []corev1.NodeSelectorRequirement{}
+	for _, raw := range tmpl.requirements {
+		object, ok := raw.(map[string]any)
+		if !ok {
+			return false, fmt.Errorf("invalid NodeClaim requirement %T", raw)
+		}
+		req := corev1.NodeSelectorRequirement{}
+		if err := runtime.DefaultUnstructuredConverter.FromUnstructured(object, &req); err != nil {
+			return false, fmt.Errorf("decoding NodeClaim requirement: %w", err)
+		}
+		base = append(base, req)
+	}
+	for key, value := range tmpl.labels {
+		base = append(base, corev1.NodeSelectorRequirement{Key: key, Operator: corev1.NodeSelectorOpIn, Values: []string{value}})
+	}
+	for key, value := range pod.Spec.NodeSelector {
+		base = append(base, corev1.NodeSelectorRequirement{Key: key, Operator: corev1.NodeSelectorOpIn, Values: []string{value}})
+	}
+	if affinity := pod.Spec.Affinity; affinity != nil && affinity.NodeAffinity != nil &&
+		affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution != nil {
+		for _, term := range affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution.NodeSelectorTerms {
+			if len(term.MatchExpressions) == 0 && len(term.MatchFields) == 0 {
+				continue
+			}
+			compatible, err := selectorRequirementsCompatible(append(append([]corev1.NodeSelectorRequirement{}, base...), term.MatchExpressions...))
+			if err != nil {
+				return false, err
+			}
+			fieldsCompatible, err := daemonSetFieldsCompatible(term.MatchFields)
+			if err != nil {
+				return false, err
+			}
+			if compatible && fieldsCompatible {
+				return true, nil
+			}
+		}
+		return false, nil
+	}
+	return selectorRequirementsCompatible(base)
+}
+
+func daemonSetFieldsCompatible(requirements []corev1.NodeSelectorRequirement) (bool, error) {
+	if len(requirements) == 0 {
+		return true, nil
+	}
+	selector, err := nodeaffinity.NewNodeSelector(&corev1.NodeSelector{NodeSelectorTerms: []corev1.NodeSelectorTerm{{MatchFields: requirements}}})
+	if err != nil {
+		return false, err
+	}
+	var names []string
+	for _, req := range requirements {
+		if req.Key == "metadata.name" && req.Operator == corev1.NodeSelectorOpIn {
+			names = req.Values
+			break
+		}
+	}
+	if names == nil {
+		// Without an exact name, one more candidate than exclusions guarantees a possible future node name.
+		for i := 0; i <= len(requirements); i++ {
+			names = append(names, "daemon-node-"+strconv.Itoa(i))
+		}
+	}
+	for _, name := range names {
+		if selector.Match(&corev1.Node{Name: name}) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// selectorRequirementsCompatible checks intersections without mistaking unknown future labels for absent labels.
+func selectorRequirementsCompatible(requirements []corev1.NodeSelectorRequirement) (bool, error) {
+	groups := map[string][]*labels.Requirement{}
+	for _, req := range requirements {
+		operators := map[corev1.NodeSelectorOperator]selection.Operator{
+			corev1.NodeSelectorOpIn: selection.In, corev1.NodeSelectorOpNotIn: selection.NotIn,
+			corev1.NodeSelectorOpExists: selection.Exists, corev1.NodeSelectorOpDoesNotExist: selection.DoesNotExist,
+			corev1.NodeSelectorOpGt: selection.GreaterThan, corev1.NodeSelectorOpLt: selection.LessThan,
+		}
+		op, ok := operators[req.Operator]
+		if !ok {
+			return false, fmt.Errorf("unsupported selector operator %q", req.Operator)
+		}
+		parsed, err := labels.NewRequirement(req.Key, op, req.Values)
+		if err != nil {
+			return false, err
+		}
+		groups[req.Key] = append(groups[req.Key], parsed)
+	}
+	for key, group := range groups {
+		matches := func(values labels.Set) bool {
+			for _, req := range group {
+				if !req.Matches(values) {
+					return false
+				}
+			}
+			return true
+		}
+		if matches(labels.Set{}) {
+			continue
+		}
+		var candidates []string
+		bounded := false
+		lower, upper := int64(0), int64(math.MaxInt64)
+		valuesCount := 0
+		for _, req := range group {
+			values := req.Values().List()
+			valuesCount += len(values)
+			if req.Operator() == selection.In {
+				candidates, bounded = values, true
+				break
+			}
+		}
+		if !bounded {
+			numeric := false
+			for _, req := range group {
+				if req.Operator() != selection.GreaterThan && req.Operator() != selection.LessThan {
+					continue
+				}
+				numeric = true
+				n, _ := strconv.ParseInt(req.Values().List()[0], 10, 64)
+				if req.Operator() == selection.GreaterThan {
+					if n == math.MaxInt64 {
+						return false, nil
+					}
+					lower = max(lower, n+1)
+				} else {
+					upper = min(upper, n-1)
+				}
+			}
+			if numeric {
+				for n, tried := lower, 0; n <= upper && tried <= valuesCount; tried++ {
+					value := strconv.FormatInt(n, 10)
+					// Leading zeros are valid label values, including when a narrow numeric range excludes the canonical spelling.
+					for len(value) <= 63 {
+						candidates = append(candidates, value)
+						value = "0" + value
+					}
+					if n == math.MaxInt64 {
+						break
+					}
+					n++
+				}
+			} else {
+				for i := 0; i <= valuesCount; i++ {
+					candidates = append(candidates, "daemon-"+strconv.Itoa(i))
+				}
+			}
+		}
+		found := false
+		for _, value := range candidates {
+			if matches(labels.Set{key: value}) {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false, nil
+		}
+	}
+	return true, nil
+}
