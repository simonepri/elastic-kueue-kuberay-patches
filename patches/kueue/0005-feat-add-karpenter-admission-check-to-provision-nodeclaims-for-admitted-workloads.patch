+	prevWl := utiltestingapi.MakeWorkload(prevWlName, ns).
+		UID("uid-prev").
+		Queue("lq").
+		Annotation(kueue.WorkloadSliceNameAnnotation, sliceName).
+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 1).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Flavor(corev1.ResourceCPU, "karpenter-a").Count(1).Obj(),
+		).Obj(), reservedAt).
+		AdmittedAt(true, reservedAt).
+		Condition(metav1.Condition{
+			Type:               kueue.WorkloadFinished,
+			Status:             metav1.ConditionTrue,
+			Reason:             kueue.WorkloadSliceReplaced,
+			LastTransitionTime: metav1.NewTime(reservedAt),
+		}).
+		Obj()
+
+	// Predecessor created claim for main-0
+	prevClaim := (&nodeClaimTemplate{}).nodeClaim(prevWl, "prev-attempt", "main-0", 1, nil, nil)
+	prevLabels := prevClaim.GetLabels()
+	prevLabels[constants.PodSetLabel] = string(kueue.DefaultPodSetName)
+	prevLabels[AttemptLabelKey] = "prev-attempt"
+	prevLabels[NodePoolLabelKey] = "pool-a"
+	prevLabels[ManagedLabelKey] = "kueue"
+	prevClaim.SetLabels(prevLabels)
+
+	succWl := utiltestingapi.MakeWorkload(succWlName, ns).
+		UID("uid-succ").
+		Queue("lq").
+		Annotation(kueue.WorkloadSliceNameAnnotation, sliceName).
+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 2).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Flavor(corev1.ResourceCPU, "karpenter-a").Count(2).Obj(),
+		).Obj(), reservedAt).
+		AdmissionCheck(kueue.AdmissionCheckState{Name: checkRef, State: kueue.CheckStatePending, LastTransitionTime: metav1.NewTime(reservedAt)}).
+		Obj()
+
+	f := newFixture(t, succWl, nil, prevWl, prevClaim)
+	f.wlKey = types.NamespacedName{Namespace: ns, Name: succWlName}
+
+	// First reconcile: adopts prev claim, creates delta claim (main-1), sets ProvisionedAttemptAnnotation
+	f.reconcile()
+
+	claims := f.claims()
+	if len(claims) != 2 {
+		t.Fatalf("got %d NodeClaims after first reconcile, want 2 (1 adopted + 1 delta)", len(claims))
+	}
+
+	attempt := attemptID(f.workload(), reservedAt)
+	for _, c := range claims {
+		if c.GetLabels()[AttemptLabelKey] != attempt {
+			t.Errorf("claim %s has attempt %s, want %s", c.GetName(), c.GetLabels()[AttemptLabelKey], attempt)
+		}
+	}
+
+	// Second reconcile: ProvisionedAttemptAnnotation is set, must validate existing + adopted claims successfully
+	f.reconcile()
+
+	claims = f.claims()
+	if len(claims) != 2 {
+		t.Fatalf("got %d NodeClaims after second reconcile, want 2 kept", len(claims))
+	}
+	if got := f.check().State; got != kueue.CheckStatePending {
+		t.Fatalf("check state = %s, want Pending", got)
+	}
+
+	// Set both claims to Launched
+	for i := range claims {
+		f.setCondition(&claims[i], conditionLaunched)
+	}
+	f.reconcile()
+
+	if got := f.check().State; got != kueue.CheckStateReady {
+		t.Errorf("check state = %s, want Ready after both Launched", got)
+	}
+}
