+func assertRetriedWithExclusion(t *testing.T, f *fixture, wantExpiry time.Time) {
+	t.Helper()
+	if got := f.check().State; got != kueue.CheckStateRetry {
+		t.Errorf("check state = %s, want Retry", got)
+	}
+	if n := len(f.claims()); n != 0 {
+		t.Errorf("got %d NodeClaims after failure, want 0", n)
+	}
+	wl := f.workload()
+	if got := wl.Annotations[controllerconstants.WorkloadAllowedResourceFlavorAnnotation]; got != "karpenter-b,remote" {
+		t.Errorf("allowed flavors = %q, want %q", got, "karpenter-b,remote")
+	}
+	want := "karpenter-a=" + wantExpiry.UTC().Format(time.RFC3339)
+	if got := wl.Annotations[ExcludedFlavorsAnnotation]; got != want {
+		t.Errorf("excluded flavors = %q, want %q", got, want)
+	}
