+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package preemption
+
+import (
+	"context"
+	"hash/maphash"
+	"sync"
+
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/klog/v2"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/resources"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// maxTopologyRetryFailures bounds how many failed topology retries are
+// remembered; the memory is dropped whole once it is full.
+const maxTopologyRetryFailures = 4096
+
+// topologyRetryFailures remembers, for each workload whose topology retry
+// found no targets, a fingerprint of the state the retry read. A retry for
+// the same workload in the same state fails again, so it is skipped until any
+// admission, eviction, quota, policy, or topology change in the workload's
+// cohort tree or its topology flavors changes the fingerprint.
+type topologyRetryFailures struct {
+	seed maphash.Seed
+
+	mu     sync.Mutex
+	failed map[topologyRetryKey]uint64
+}
+
+type topologyRetryKey struct {
+	workload workload.Reference
+	uid      types.UID
+}
+
+func newTopologyRetryFailures() *topologyRetryFailures {
+	return &topologyRetryFailures{seed: maphash.MakeSeed(), failed: make(map[topologyRetryKey]uint64)}
+}
+
+// run returns the targets of retry, or none without running it when it
+// already failed for the workload in the same state.
+func (f *topologyRetryFailures) run(ctx context.Context, p *Preemptor, pCtx *preemptionCtx, retry func() []*Target) []*Target {
+	// Admission fair sharing orders candidates by usage that decays over
+	// time, and configurable preemptions read rules outside the snapshot, so
+	// the snapshot does not hold everything such a retry reads.
+	if p.enabledAfs || features.Enabled(features.ConfigurablePreemptions) {
+		return retry()
+	}
+	key := topologyRetryKey{workload: workload.Key(pCtx.preemptor.Obj), uid: pCtx.preemptor.Obj.UID}
+	fingerprint := f.fingerprint(pCtx)
+	f.mu.Lock()
+	previous, found := f.failed[key]
+	f.mu.Unlock()
+	if found && previous == fingerprint {
+		log.FromContext(ctx).V(5).Info("Skipping the topology retry, which already failed in the same state", "workload", klog.KObj(pCtx.preemptor.Obj))
+		return nil
+	}
+	targets := retry()
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if len(targets) > 0 {
+		delete(f.failed, key)
+		return targets
+	}
+	if len(f.failed) >= maxTopologyRetryFailures {
+		clear(f.failed)
+	}
+	f.failed[key] = fingerprint
+	return nil
+}
+
+// fingerprint hashes the state a topology retry for pCtx reads: the
+// preemptor's spec and assignment, the quotas, usage, policies, and workloads
+// of every ClusterQueue and Cohort in its cohort tree, and the state of its
+// ClusterQueue's topology flavors, which also holds the TAS usage of
+// workloads outside the tree. Collections are combined by summing item
+// hashes, so their iteration order does not matter.
+func (f *topologyRetryFailures) fingerprint(pCtx *preemptionCtx) uint64 {
+	h := fingerprintHasher{seed: f.seed}
+	obj := pCtx.preemptor.Obj
+	var priority int32
+	if obj.Spec.Priority != nil {
+		priority = *obj.Spec.Priority
+	}
+	h.add(struct {
+		uid        types.UID
+		generation int64
+		priority   int32
+	}{obj.UID, obj.Generation, priority})
+	for i, ps := range pCtx.assignment.PodSets {
+		h.add(struct {
+			index int
+			name  kueue.PodSetReference
+			count int32
+		}{i, ps.Name, ps.Count})
+		for resource, flavor := range ps.Flavors {
+			if flavor == nil {
+				continue
+			}
+			h.add(struct {
+				index    int
+				resource string
+				flavor   kueue.ResourceFlavorReference
+				mode     int
+			}{i, string(resource), flavor.Name, int(flavor.Mode)})
+		}
+	}
+	h.addQuantities("preemptor", pCtx.workloadUsage.Quota.Assigned)
+
+	cq := pCtx.preemptorCQ
+	cqs := []*schdcache.ClusterQueueSnapshot{cq}
+	if cq.HasParent() {
+		root := cq.Parent().Root()
+		cqs = root.SubtreeClusterQueues()
+		h.addCohorts(root)
+	}
+	for _, member := range cqs {
+		h.addClusterQueue(member)
+	}
+	for name, tasFlavor := range cq.TASFlavors {
+		h.add(struct {
+			flavor kueue.ResourceFlavorReference
+			state  uint64
+		}{name, tasFlavor.StateFingerprint(f.seed)})
+	}
+	return h.sum
+}
+
+type fingerprintHasher struct {
+	seed maphash.Seed
+	sum  uint64
+}
+
+func (h *fingerprintHasher) add(item any) {
+	h.sum += maphash.Comparable(h.seed, item)
+}
+
+func (h *fingerprintHasher) addAmount(owner, kind string, fr resources.FlavorResource, amount resources.Amount) {
+	item := struct {
+		owner, kind string
+		fr          resources.FlavorResource
+		small       int64
+		large       string
+	}{owner: owner, kind: kind, fr: fr}
+	if small, ok := amount.Int64(); ok {
+		item.small = small
+	} else {
+		item.large = amount.String()
+	}
+	h.add(item)
+}
+
+func (h *fingerprintHasher) addQuantities(owner string, quantities resources.FlavorResourceQuantities) {
+	for fr, amount := range quantities {
+		h.addAmount(owner, "quantity", fr, amount)
+	}
+}
+
+func (h *fingerprintHasher) addQuotas(owner string, quotas map[resources.FlavorResource]schdcache.ResourceQuota) {
+	for fr, quota := range quotas {
+		h.addAmount(owner, "nominal", fr, quota.Nominal)
+		if quota.BorrowingLimit != nil {
+			h.addAmount(owner, "borrowingLimit", fr, *quota.BorrowingLimit)
+		}
+		if quota.LendingLimit != nil {
+			h.addAmount(owner, "lendingLimit", fr, *quota.LendingLimit)
+		}
+	}
+}
+
+func (h *fingerprintHasher) addCohorts(cohort *schdcache.CohortSnapshot) {
+	owner := "cohort/" + string(cohort.Name)
+	h.add(struct {
+		owner      string
+		fairWeight float64
+	}{owner, cohort.FairWeight})
+	h.addQuotas(owner, cohort.ResourceNode.Quotas)
+	h.addQuantities(owner+"/subtreeQuota", cohort.ResourceNode.SubtreeQuota)
+	h.addQuantities(owner+"/usage", cohort.ResourceNode.Usage)
+	for _, child := range cohort.ChildCohorts() {
+		h.addCohorts(child)
+	}
+}
+
+func (h *fingerprintHasher) addClusterQueue(cq *schdcache.ClusterQueueSnapshot) {
+	owner := "clusterQueue/" + string(cq.Name)
+	borrowWithinCohort := struct {
+		set       bool
+		policy    kueue.BorrowWithinCohortPolicy
+		threshold int32
+		hasLimit  bool
+	}{}
+	if bwc := cq.Preemption.BorrowWithinCohort; bwc != nil {
+		borrowWithinCohort.set = true
+		borrowWithinCohort.policy = bwc.Policy
+		if bwc.MaxPriorityThreshold != nil {
+			borrowWithinCohort.hasLimit = true
+			borrowWithinCohort.threshold = *bwc.MaxPriorityThreshold
+		}
+	}
+	h.add(struct {
+		owner                 string
+		generation            int64
+		reclaim, withinCQ     kueue.PreemptionPolicy
+		borrowWithinCohortSet bool
+		borrowWithinCohort    kueue.BorrowWithinCohortPolicy
+		borrowThreshold       int32
+		borrowThresholdSet    bool
+		fairWeight            float64
+		workloads, notReady   int
+	}{
+		owner, cq.AllocatableResourceGeneration,
+		cq.Preemption.ReclaimWithinCohort, cq.Preemption.WithinClusterQueue,
+		borrowWithinCohort.set, borrowWithinCohort.policy, borrowWithinCohort.threshold, borrowWithinCohort.hasLimit,
+		cq.FairWeight, len(cq.Workloads), len(cq.WorkloadsNotReady),
+	})
+	h.addQuotas(owner, cq.ResourceNode.Quotas)
+	h.addQuantities(owner+"/subtreeQuota", cq.ResourceNode.SubtreeQuota)
+	h.addQuantities(owner+"/usage", cq.ResourceNode.Usage)
+	for key, wl := range cq.Workloads {
+		var priority int32
+		if wl.Obj.Spec.Priority != nil {
+			priority = *wl.Obj.Spec.Priority
+		}
+		h.add(struct {
+			owner           string
+			key             workload.Reference
+			uid             types.UID
+			resourceVersion string
+			generation      int64
+			priority        int32
+		}{owner, key, wl.Obj.UID, wl.Obj.ResourceVersion, wl.Obj.Generation, priority})
+	}
+}
