+
+// maxTopologyEvaluations bounds how many placements a topology retry runs the
+// preemption strategy for in each attempt. maxTopologySearches and
+// maxMinimizingSearches bound how many topology searches it runs to find the
+// priority ceiling and the placements and to trim each placement's victims,
+// so a workload that keeps failing costs a bounded amount of work per
+// scheduling attempt, however many candidates and priorities there are; see
+// topologyRetryAttemptTargets for the bound.
+const (
+	maxTopologyEvaluations = 8
+	maxTopologySearches    = 64
+	maxMinimizingSearches  = 8
+)
+
+// TopologyRetry searches for preemption targets that free whole topology
+// domains for the preemptor. It returns no targets when no placement can be
+// freed within the preemption policies.
+type TopologyRetry func(ctx context.Context) []*Target
+
+// GetTargets returns the targets of ordinary preemption for wl. When ordinary
+// preemption finds no targets because the quota fits but no topology placement
+// does, it also returns a TopologyRetry. The caller runs it only once every
+// other way to admit wl failed, so ordinary preemption wins whenever it
+// succeeds. A retry that already failed for wl in the same state is not run
+// again.
+func (p *Preemptor) GetTargets(
+	ctx context.Context,
+	wl workload.Info,
+	snapshot *schdcache.Snapshot,
+	assignment flavorassigner.Assignment,
+) ([]*Target, TopologyRetry) {
+	pCtx := p.buildContext(ctx, wl, assignment, snapshot)
+	targets := p.getTargets(ctx, p.getPreemptionStrategyIterator(ctx, pCtx))
+	if len(targets) > 0 || !pCtx.topologyBlocked {
+		return targets, nil
+	}
+	return nil, func(ctx context.Context) []*Target {
+		return p.topologyRetryFailures.run(ctx, p, pCtx, func() []*Target {
+			return p.topologyRetryTargets(ctx, pCtx)
+		})
+	}
+}
+
+// topologyRetryAttempt is one way the preemption algorithm may take victims:
+// the candidates it can preempt, and a strategy offering the kept candidates,
+// the preferred ones first, while it rechecks every policy as victims are
+// removed.
+type topologyRetryAttempt struct {
+	allowBorrowing bool
+	candidates     []*workload.Info
+	strategy       func(preferred sets.Set[*workload.Info], keep func(*workload.Info) bool) PreemptionStrategy
+}
+
+// topologyRetryTargets takes victims by topology placement instead of by
+// priority alone. The ordinary attempts stop taking victims once each
+// borrowing queue is back at its nominal quota, which can leave the freed
+// capacity spread across topology domains. For the first attempt that frees a
+// placement, it returns the targets that cost the least among the
+// placements it evaluates: the lowest highest-priority target first, then the
+// lowest next-highest, and so on, then the fewest targets. See
+// topologyRetryAttemptTargets for which of these are exact.
+func (p *Preemptor) topologyRetryTargets(ctx context.Context, pCtx *preemptionCtx) []*Target {
+	var attempts []topologyRetryAttempt
+	if p.enableFairSharing {
+		attempts = fairTopologyRetryAttempts(ctx, p, pCtx, p.fsStrategies)
+	} else {
+		attempts = classicalTopologyRetryAttempts(ctx, p, pCtx)
+	}
+	for _, attempt := range attempts {
+		if targets := p.topologyRetryAttemptTargets(ctx, pCtx, attempt); len(targets) > 0 {
+			return targets
+		}
+	}
+	return nil
+}
+
+// retryCandidate is a candidate of a topology retry, with the parts of its
+// usage the search removes from the snapshot computed once.
+type retryCandidate struct {
+	wl       *workload.Info
+	priority int64
+	quota    workload.Usage
+	tas      workload.Usage
+	domains  []flavorDomain
+	// order is the candidate's position in ascending priority, ties in the
+	// order the strategy offers them.
+	order int
+	// removedLeaves counts the freed leaves the candidate occupies.
+	removedLeaves int
+	// excluded marks the occupants of a placement already found, which stay
+	// in the snapshot.
+	excluded bool
+}
+
+// topologyRetryAttemptTargets raises a priority ceiling through the
+// candidates' priorities, lowest first, and starts at the first ceiling where
+// removing every candidate at or below it frees both the quota and a
+// topology placement for the preemptor. Removing more candidates never frees
+// less, so no set of victims below that ceiling admits the preemptor,
+// however many topology domains there are. At each ceiling from there, it
+// finds the placements whose occupants cost the least, keeps of each only
+// the occupants the preemptor needs gone, skips those the ClusterQueues may
+// not give up together, runs the strategy for the rest, limited to the
+// candidates at or below the ceiling, and returns the targets that cost the
+// least. When the policies reject every such placement, it moves on to the
+// next ceiling. The search removes only the quota or only the TAS usage of
+// the candidates, and restores the snapshot before it runs a strategy.
+//
+// It runs the strategy at most maxTopologyEvaluations times and at most
+// maxTopologySearches + maxTopologyEvaluations*(2*bits.Len(L) +
+// maxMinimizingSearches) topology searches, where L is the number of
+// topology leaves the candidates occupy: finding the starting ceiling takes
+// about log2 of the number of distinct priorities, and each placement about
+// 2*log2(L) to find and up to maxMinimizingSearches to trim. With 8
+// evaluations and 1024 leaves that is 304 searches.
+//
+// The highest priority among the targets is the lowest any set of victims
+// that admits the preemptor can have when the strategy succeeds at the
+// starting ceiling, given that freeing more capacity never makes a topology
+// placement stop fitting. The lowest next-highest priorities and the fewest
+// targets are best effort: they compare only the placements found, at most
+// maxTopologyEvaluations, chosen by a greedy order of topology leaves.
+func (p *Preemptor) topologyRetryAttemptTargets(ctx context.Context, pCtx *preemptionCtx, attempt topologyRetryAttempt) []*Target {
+	log := log.FromContext(ctx)
+	limits := newReclaimLimits(pCtx)
+	candidates := make([]*retryCandidate, 0, len(attempt.candidates))
+	leaves := sets.New[flavorDomain]()
+	for _, wl := range attempt.candidates {
+		usage := wl.Usage()
+		candidate := &retryCandidate{
+			wl:       wl,
+			priority: priority.EffectivePriority(log, wl.Obj),
+			quota:    workload.Usage{Quota: usage.Quota},
+			tas:      workload.Usage{TAS: usage.TAS},
+			domains:  candidateDomains(usage.TAS),
+		}
+		leaves.Insert(candidate.domains...)
+		candidates = append(candidates, candidate)
+	}
+	slices.SortStableFunc(candidates, func(a, b *retryCandidate) int { return cmp.Compare(a.priority, b.priority) })
+	var ceilings []int
+	for i, candidate := range candidates {
+		candidate.order = i
+		if i+1 == len(candidates) || candidates[i+1].priority != candidate.priority {
+			ceilings = append(ceilings, i+1)
+		}
+	}
+
+	searches := maxTopologySearches + maxTopologyEvaluations*(2*bits.Len(uint(leaves.Len()))+maxMinimizingSearches)
+	start := lowestQuotaCeiling(pCtx, candidates, ceilings, attempt.allowBorrowing)
+	start = lowestTopologyCeiling(ctx, pCtx, candidates, ceilings, start, &searches)
+	evaluations := maxTopologyEvaluations
+	for _, end := range ceilings[start:] {
+		if evaluations == 0 || searches == 0 {
+			break
+		}
+		placements := cheapestPlacements(ctx, pCtx, limits, candidates[:end], attempt.allowBorrowing, evaluations, &searches)
+		if len(placements) == 0 {
+			continue
+		}
+		evaluations -= len(placements)
+		ceiling := candidates[end-1].priority
+		keep := func(wl *workload.Info) bool { return priority.EffectivePriority(log, wl.Obj) <= ceiling }
+		if targets := p.cheapestTargets(ctx, placements, attempt, keep); len(targets) > 0 {
+			return targets
+		}
+	}
+	return nil
+}
+
+// lowestQuotaCeiling returns the index of the first ceiling at which removing
+// the quota usage of every candidate at or below it lets the preemptor's
+// quota fit, or len(ceilings) when none does. It ignores which candidates the
+// ClusterQueues may give up, so the ceiling it returns is never above the
+// lowest one the strategies can reach.
+func lowestQuotaCeiling(pCtx *preemptionCtx, candidates []*retryCandidate, ceilings []int, allowBorrowing bool) int {
+	removed := 0
+	defer func() {
+		for _, candidate := range candidates[:removed] {
+			pCtx.snapshot.AddWorkloadUsage(candidate.wl, candidate.quota)
+		}
+	}()
+	for i, end := range ceilings {
+		for ; removed < end; removed++ {
+			pCtx.snapshot.RemoveWorkloadUsage(candidates[removed].wl, candidates[removed].quota)
+		}
+		if workloadQuotaFits(pCtx, allowBorrowing) {
+			return i
+		}
+	}
+	return len(ceilings)
+}
+
+// lowestTopologyCeiling returns the index of the first ceiling, from start
+// on, at which removing the TAS usage of every candidate at or below it lets
+// a topology placement fit, or len(ceilings) when none does. It bisects the
+// ceilings, which assumes that freeing more capacity never makes a placement
+// stop fitting, so its searches grow with the logarithm of the number of
+// distinct priorities, and it charges each one to searches.
+func lowestTopologyCeiling(ctx context.Context, pCtx *preemptionCtx, candidates []*retryCandidate, ceilings []int, start int, searches *int) int {
+	// cheapestPlacements searches with every candidate removed at the last
+	// ceiling anyway.
+	if start >= len(ceilings)-1 {
+		return start
+	}
+	removed := 0
+	setRemoved := func(n int) {
+		for ; removed < n; removed++ {
+			pCtx.snapshot.RemoveWorkloadUsage(candidates[removed].wl, candidates[removed].tas)
+		}
+		for ; removed > n; removed-- {
+			pCtx.snapshot.AddWorkloadUsage(candidates[removed-1].wl, candidates[removed-1].tas)
+		}
+	}
+	defer setRemoved(0)
+	fits := func(i int) (fit, ok bool) {
+		if *searches == 0 {
+			return false, false
+		}
+		*searches--
+		setRemoved(ceilings[i])
+		return topologyFits(ctx, pCtx), true
+	}
+	// low never fits; high fits.
+	low, high := start-1, len(ceilings)-1
+	if fit, ok := fits(high); !fit || !ok {
+		return len(ceilings)
+	}
+	for high-low > 1 {
+		mid := (low + high) / 2
+		fit, ok := fits(mid)
+		if !ok {
+			return len(ceilings)
+		}
+		if fit {
+			high = mid
+		} else {
+			low = mid
+		}
+	}
+	return high
+}
+
+// topologyFits reports whether a topology placement of the preemptor fits in
+// the current state of the snapshot.
+func topologyFits(ctx context.Context, pCtx *preemptionCtx) bool {
+	return pCtx.assignment.FindTopologyAssignments(ctx, pCtx.preemptorCQ, pCtx.tasRequests, schdcache.WithWorkloadInfo(&pCtx.preemptor)).Failure() == nil
+}
+
+// cheapestPlacements finds up to limit placements of the preemptor, cheapest
+// first, that removing candidates makes possible within what their
+// ClusterQueues may give up, and returns, for each, the candidates the
+// preemptor needs gone from its topology domains.
+//
+// Each topology leaf offers a set of its candidates that their ClusterQueues
+// and Cohorts may give up together, built from the most expensive candidate
+// down, so a cheap candidate a placement may not need cannot use up what a
+// lender may give before one it does. It orders the leaves by the priorities
+// of those candidates, highest first, compared like victim costs, and frees
+// the shortest run of the cheapest leaves after which a placement fits, found
+// by bisection, which assumes that freeing more leaves never makes a
+// placement stop fitting, so a placement inside one leaf is the cheapest one. It then puts back the
+// occupants of the placement's leaves, most expensive first, that the
+// preemptor's topology placement and quota still fit without, keeps the rest
+// as the placement's victims, and keeps every occupant in place while it
+// looks for the next placement. A placement whose victims the ClusterQueues
+// may not give up together is skipped and does not count toward limit. It
+// charges each topology search to searches and returns what it found when
+// they run out.
+//
+// The leaf order and the occupants it puts back are greedy: they find the
+// lowest highest-priority victim the ceiling allows, but not always the
+// lowest next-highest victims or the fewest victims.
+func cheapestPlacements(ctx context.Context, pCtx *preemptionCtx, limits *reclaimLimits, candidates []*retryCandidate, allowBorrowing bool, limit int, searches *int) []sets.Set[*workload.Info] {
+	allOccupants := make(map[flavorDomain][]*retryCandidate)
+	for _, candidate := range candidates {
+		candidate.removedLeaves, candidate.excluded = 0, false
+		for _, leaf := range candidate.domains {
+			allOccupants[leaf] = append(allOccupants[leaf], candidate)
+		}
+	}
+	type leafCost struct {
+		leaf flavorDomain
+		cost []int64
+	}
+	byLeaf := make(map[flavorDomain][]*retryCandidate, len(allOccupants))
+	leaves := make([]leafCost, 0, len(allOccupants))
+	for leaf, occupants := range allOccupants {
+		// The occupants are in ascending priority.
+		group := limits.newGroup()
+		for _, occupant := range slices.Backward(occupants) {
+			group.tryAdd(occupant)
+		}
+		freeable := group.release()
+		if len(freeable) == 0 {
+			continue
+		}
+		byLeaf[leaf] = freeable
+		cost := make([]int64, 0, len(freeable))
+		for _, occupant := range freeable {
+			cost = append(cost, occupant.priority)
+		}
+		leaves = append(leaves, leafCost{leaf: leaf, cost: cost})
+	}
+	slices.SortFunc(leaves, func(a, b leafCost) int {
+		return cmp.Or(slices.Compare(a.cost, b.cost), cmp.Compare(a.leaf.flavor, b.leaf.flavor), cmp.Compare(a.leaf.domain, b.leaf.domain))
+	})
+
+	// freed is the number of leading leaves whose candidates are removed.
+	freed := 0
+	freeLeaves := func(n int) {
+		for ; freed < n; freed++ {
+			for _, candidate := range byLeaf[leaves[freed].leaf] {
+				if candidate.removedLeaves++; candidate.removedLeaves == 1 && !candidate.excluded {
+					pCtx.snapshot.RemoveWorkloadUsage(candidate.wl, candidate.tas)
+				}
+			}
+		}
+		for ; freed > n; freed-- {
+			for _, candidate := range byLeaf[leaves[freed-1].leaf] {
+				if candidate.removedLeaves--; candidate.removedLeaves == 0 && !candidate.excluded {
+					pCtx.snapshot.AddWorkloadUsage(candidate.wl, candidate.tas)
+				}
+			}
+		}
+	}
+	defer freeLeaves(0)
+	// search reports whether a placement fits with the first n leaves freed,
+	// and false for ok once the searches run out.
+	var fitting schdcache.TASAssignmentsResult
+	search := func(n int) (fit, ok bool) {
+		if *searches == 0 {
+			return false, false
+		}
+		*searches--
+		freeLeaves(n)
+		assignments := pCtx.assignment.FindTopologyAssignments(ctx, pCtx.preemptorCQ, pCtx.tasRequests, schdcache.WithWorkloadInfo(&pCtx.preemptor))
+		if assignments.Failure() != nil {
+			return false, true
+		}
+		fitting = assignments
+		return true, true
+	}
+
+	var placements []sets.Set[*workload.Info]
+	if fit, _ := search(len(leaves)); !fit {
+		return nil
+	}
+	// low leaves never fit; the search fits with high leaves.
+	low := 0
+	for len(placements) < limit {
+		high := -1
+		var assignments schdcache.TASAssignmentsResult
+		for step := 1; ; step *= 2 {
+			n := min(low+step, len(leaves))
+			fit, ok := search(n)
+			if !ok {
+				return placements
+			}
+			if fit {
+				high, assignments = n, fitting
+				break
+			}
+			if n == len(leaves) {
+				break
+			}
+			low = n
+		}
+		if high < 0 {
+			break
+		}
+		for high-low > 1 {
+			mid := (low + high) / 2
+			fit, ok := search(mid)
+			if !ok {
+				return placements
+			}
+			if fit {
+				high, assignments = mid, fitting
+			} else {
+				low = mid
+			}
+		}
+		freeLeaves(high)
+		// The occupants are every removed candidate in the placement's leaves,
+		// including one removed for another leaf it also occupies.
+		var occupants []*retryCandidate
+		for _, assignment := range assignments {
+			for _, domain := range assignment.TopologyAssignment.Domains {
+				for _, candidate := range allOccupants[flavorDomain{flavor: assignment.Flavor, domain: utiltas.DomainID(domain.Values)}] {
+					if candidate.removedLeaves > 0 && !candidate.excluded {
+						candidate.excluded = true
+						occupants = append(occupants, candidate)
+					}
+				}
+			}
+		}
+		if len(occupants) == 0 {
+			break
+		}
+		// Excluded candidates stay in the snapshot, so restore the occupants
+		// before freeing the leaves again.
+		for _, occupant := range occupants {
+			pCtx.snapshot.AddWorkloadUsage(occupant.wl, occupant.tas)
+		}
+		freeLeaves(0)
+		// The strategy takes the occupants cheapest first; when that would
+		// leave a lender that stops borrowing before an occupant it needs,
+		// it keeps only the occupants the preemptor needs gone.
+		slices.SortFunc(occupants, func(a, b *retryCandidate) int { return cmp.Compare(a.order, b.order) })
+		victims := occupants
+		if !limits.allowsInOrder(occupants) {
+			victims = neededOccupants(ctx, pCtx, occupants, allowBorrowing, searches)
+		}
+		if limits.allows(victims) {
+			placement := sets.New[*workload.Info]()
+			for _, victim := range victims {
+				placement.Insert(victim.wl)
+			}
+			placements = append(placements, placement)
+		}
+		// With the occupants back, the first high-1 leaves still do not fit.
+		low = high - 1
+	}
+	return placements
+}
+
+// neededOccupants removes the quota and TAS usage of the occupants of a
+// placement, puts them back one at a time, most expensive first, keeping
+// back each one the preemptor's topology placement still fits without and,
+// when the quota fit with every occupant removed, its quota too, and returns
+// the occupants it could not put back. It runs a topology search for each of
+// the first maxMinimizingSearches occupants, charges it to searches, and
+// keeps the others as victims. It leaves the snapshot as it found it.
+func neededOccupants(ctx context.Context, pCtx *preemptionCtx, occupants []*retryCandidate, allowBorrowing bool, searches *int) []*retryCandidate {
+	if len(occupants) < 2 {
+		return occupants
+	}
+	slices.SortFunc(occupants, func(a, b *retryCandidate) int { return cmp.Compare(b.order, a.order) })
+	usage := func(candidate *retryCandidate) workload.Usage {
+		return workload.Usage{Quota: candidate.quota.Quota, TAS: candidate.tas.TAS}
+	}
+	for _, occupant := range occupants {
+		pCtx.snapshot.RemoveWorkloadUsage(occupant.wl, usage(occupant))
+	}
+	quotaFits := workloadQuotaFits(pCtx, allowBorrowing)
+	needed := make([]*retryCandidate, 0, len(occupants))
+	for i, occupant := range occupants {
+		if i < maxMinimizingSearches && *searches > 0 {
+			*searches--
+			pCtx.snapshot.AddWorkloadUsage(occupant.wl, usage(occupant))
+			if topologyFits(ctx, pCtx) && (!quotaFits || workloadQuotaFits(pCtx, allowBorrowing)) {
+				continue
+			}
+			pCtx.snapshot.RemoveWorkloadUsage(occupant.wl, usage(occupant))
+		}
+		needed = append(needed, occupant)
+	}
+	for _, occupant := range needed {
+		pCtx.snapshot.AddWorkloadUsage(occupant.wl, usage(occupant))
+	}
+	return needed
+}
+
+// cheapestTargets runs the strategy for each placement, ordered by the cost
+// of its occupants, and returns the targets that cost the least.
+func (p *Preemptor) cheapestTargets(
+	ctx context.Context,
+	placements []sets.Set[*workload.Info],
+	attempt topologyRetryAttempt,
+	keep func(*workload.Info) bool,
+) []*Target {
+	log := log.FromContext(ctx)
+	var best []*Target
+	var bestCost []int64
+	for _, placement := range placements {
+		strategy := attempt.strategy(placement, keep)
+		targets := p.getTargets(ctx, func(yield func(PreemptionStrategy) bool) { yield(strategy) })
+		if len(targets) == 0 {
+			continue
+		}
+		cost := make([]int64, 0, len(targets))
+		for _, target := range targets {
+			cost = append(cost, priority.EffectivePriority(log, target.WorkloadInfo.Obj))
+		}
+		slices.SortFunc(cost, func(a, b int64) int { return cmp.Compare(b, a) })
+		if best == nil || slices.Compare(cost, bestCost) < 0 {
+			best, bestCost = targets, cost
+		}
+	}
+	return best
+}
+
+// flavorDomain identifies a topology domain of a resource flavor.
+type flavorDomain struct {
+	flavor kueue.ResourceFlavorReference
+	domain utiltas.TopologyDomainID
+}
+
+// candidateDomains returns the topology domains of a candidate's TAS usage.
+func candidateDomains(usage workload.TASUsage) []flavorDomain {
+	var domains []flavorDomain
+	for flavor, flavorUsage := range usage {
+		for _, domain := range flavorUsage {
+			domains = append(domains, flavorDomain{flavor: flavor, domain: utiltas.DomainID(domain.Values)})
+		}
+	}
+	return domains
+}
