+package tas
+
+// Cohort reclaim of a topology-required workload when the borrowing
+// ClusterQueue spreads its workloads across topology domains
+// (https://github.com/kubernetes-sigs/kueue/issues/10815), under Classic and
+// Fair Sharing preemption.
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/onsi/ginkgo/v2"
