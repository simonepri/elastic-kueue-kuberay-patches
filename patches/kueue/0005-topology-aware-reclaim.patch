+
+func topologyPreemptionSuite(mode topologyPreemptionMode) {
+	ginkgo.Context(mode.name, ginkgo.Ordered, func() {
+		prefix := strings.ToLower(mode.name)
+		twoRacks := map[string][]string{}
+		for _, rack := range []string{"r1", "r2"} {
+			for i := 1; i <= 4; i++ {
+				twoRacks[rack] = append(twoRacks[rack], fmt.Sprintf("%s-%s-n%d", prefix, rack, i))
+			}
+		}
