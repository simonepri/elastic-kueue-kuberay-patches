+
+// TestTopologyRetryWithPartialAdmission checks that a workload that can be
+// partially admitted takes ordinary preemption at a reduced count whenever
+// one succeeds, and otherwise frees a whole node at the full count.
+func TestTopologyRetryWithPartialAdmission(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	cases := map[string]struct {
+		oldX1CPU    string
+		wantCount   int32
+		wantTargets []string
+		wantDomain  string
+	}{
+		"ordinary preemption at a reduced count wins over the retry": {
+			oldX1CPU:    "1",
+			wantCount:   3,
+			wantTargets: []string{"new-x1"},
+			wantDomain:  "x1",
+		},
+		"the retry frees a whole node when no count fits ordinarily": {
+			oldX1CPU:    "2",
+			wantCount:   4,
+			wantTargets: []string{"new-x1", "old-x1"},
+			wantDomain:  "x1",
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+			ctx, log := utiltesting.ContextWithLog(t)
+			borrower := func(name, node, cpu string, priority int32, age time.Duration) kueue.Workload {
+				return *utiltestingapi.MakeWorkload(name, "default").Priority(priority).
+					PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, cpu).
+						RequiredTopologyRequest(corev1.LabelHostname).Obj()).
+					ReserveQuotaAt(utiltestingapi.MakeAdmission("borrower").PodSets(
+						utiltestingapi.MakePodSetAssignment("main").Count(1).
+							Assignment(corev1.ResourceCPU, "tas", cpu).
+							TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+								Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, 1).Obj()).Obj()).Obj()).Obj(),
+						now.Add(-age)).
+					AdmittedAt(true, now.Add(-age)).Obj()
+			}
+			// The borrower borrows from the incoming queue, and its newest
+			// workloads sit on different nodes, so the ordinary search stops at
+			// the nominal quota with no node free enough.
+			admitted := []kueue.Workload{
+				borrower("old-x1", "x1", tc.oldX1CPU, 1, 2*time.Hour),
+				borrower("old-x2", "x2", "2", 2, time.Hour),
+				borrower("new-x1", "x1", "2", 1, time.Minute),
+				borrower("new-x2", "x2", "2", 1, 0),
+			}
+			clientBuilder := utiltesting.NewClientBuilder().
+				WithLists(&kueue.WorkloadList{Items: admitted}).
+				WithObjects(utiltesting.MakeNamespace("default")).
+				WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+				WithStatusSubresource(&kueue.Workload{})
+			_ = tasindexer.SetupIndexes(ctx, utiltesting.AsIndexer(clientBuilder))
+			cl := clientBuilder.Build()
+			cqCache := schdcache.New(cl)
+			topology := utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj()
+			cqCache.AddOrUpdateTopology(log, topology)
+			cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+			for _, node := range []string{"x1", "x2"} {
+				cqCache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+					StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("4"), corev1.ResourcePods: resource.MustParse("10")}).
+					Ready().Obj())
+			}
+			fakeClock := testingclock.NewFakeClock(now)
+			qManager := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithClock(fakeClock))
+			for _, cq := range []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "4").Obj()).
+					Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}).Obj(),
+				utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "4").Obj()).Obj(),
+			} {
+				if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+					t.Fatal(err)
+				}
+			}
+			scheduler := New(qManager, cqCache, cl, &utiltesting.EventRecorder{}, WithClock(t, fakeClock), WithPreemptionExpectations(preemptexpectations.New()))
+			snapshot, err := cqCache.Snapshot(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			info := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").Priority(3).
+				PodSets(*utiltestingapi.MakePodSet("main", 4).SetMinimumCount(3).Request(corev1.ResourceCPU, "1").
+					RequiredTopologyRequest(corev1.LabelHostname).Obj()).Obj())
+			info.ClusterQueue = "incoming"
+
+			assignment, targets := scheduler.getAssignments(ctx, info, snapshot)
+
+			var gotTargets []string
+			for _, target := range targets {
+				gotTargets = append(gotTargets, target.WorkloadInfo.Obj.Name)
+			}
+			slices.Sort(gotTargets)
+			if diff := cmp.Diff(tc.wantTargets, gotTargets); diff != "" {
+				t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+			}
+			podSet := assignment.PodSets[0]
+			if podSet.Count != tc.wantCount {
+				t.Errorf("unexpected pod count: want %d, got %d", tc.wantCount, podSet.Count)
+			}
+			if podSet.TopologyAssignment == nil {
+				t.Fatal("missing topology assignment")
+			}
+			var gotDomains []string
+			for _, domain := range podSet.TopologyAssignment.Domains {
+				gotDomains = append(gotDomains, domain.Values...)
+			}
+			if diff := cmp.Diff([]string{tc.wantDomain}, gotDomains); diff != "" {
+				t.Errorf("unexpected topology domains (-want/+got):\n%s", diff)
+			}
+		})
+	}
+}
diff --git a/test/integration/singlecluster/tas/tas_preemption_topology_test.go b/test/integration/singlecluster/tas/tas_preemption_topology_test.go
new file mode 100644
index 0000000..8b39b31
--- /dev/null
+++ b/test/integration/singlecluster/tas/tas_preemption_topology_test.go
@@ -0,0 +1,309 @@
