+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package preemption
+
+import (
+	"cmp"
+	"context"
+	"slices"
+
+	"k8s.io/apimachinery/pkg/util/sets"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/util/priority"
+	utiltas "sigs.k8s.io/kueue/pkg/util/tas"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// maxTopologyPlacements bounds how many alternative placements a topology
+// retry evaluates, so a workload that keeps failing costs a bounded amount of
+// work per scheduling attempt.
+const maxTopologyPlacements = 8
+
+// topologyPlacements finds placements of the preemptor that become possible
+// once candidates are removed, and returns, for each placement, the candidates
+// occupying its topology domains. Each search keeps the candidates of the
+// previous placements in place, so the next placement lands in other domains.
+// The placements only guide victim ordering: the strategies built from them
+// recheck every policy as victims are removed.
+func topologyPlacements(ctx context.Context, pCtx *preemptionCtx, candidates []*workload.Info) []sets.Set[workload.Reference] {
+	var placements []sets.Set[workload.Reference]
+	kept := sets.New[workload.Reference]()
+	for range maxTopologyPlacements {
+		removed := make([]*workload.Info, 0, len(candidates))
+		for _, candidate := range candidates {
+			if !kept.Has(workload.Key(candidate.Obj)) {
+				removed = append(removed, candidate)
+			}
+		}
+		if len(removed) == 0 {
+			break
+		}
+		restore := pCtx.snapshot.SimulateWorkloadRemoval(removed)
+		assignments := pCtx.preemptorCQ.FindTopologyAssignmentsForWorkload(ctx, pCtx.tasRequests, schdcache.WithWorkloadInfo(&pCtx.preemptor))
+		restore()
+		if assignments.Failure() != nil {
+			break
+		}
+		occupants := candidatesInDomains(removed, assignments)
+		if len(occupants) == 0 {
+			break
+		}
+		placements = append(placements, occupants)
+		kept = kept.Union(occupants)
+	}
+	return placements
+}
+
+// candidatesInDomains returns the candidates that use any topology domain of
+// the given assignments.
+func candidatesInDomains(candidates []*workload.Info, assignments schdcache.TASAssignmentsResult) sets.Set[workload.Reference] {
+	domains := make(map[kueue.ResourceFlavorReference]sets.Set[utiltas.TopologyDomainID])
+	for _, assignment := range assignments {
+		if domains[assignment.Flavor] == nil {
+			domains[assignment.Flavor] = sets.New[utiltas.TopologyDomainID]()
+		}
+		for _, domain := range assignment.TopologyAssignment.Domains {
+			domains[assignment.Flavor].Insert(utiltas.DomainID(domain.Values))
+		}
+	}
+	occupants := sets.New[workload.Reference]()
+	for _, candidate := range candidates {
+		for flavor, usage := range candidate.TASUsage() {
+			for _, domain := range usage {
+				if domains[flavor].Has(utiltas.DomainID(domain.Values)) {
+					occupants.Insert(workload.Key(candidate.Obj))
+				}
+			}
+		}
+	}
+	return occupants
+}
+
+// cheapestTopologyPlacement evaluates the strategy built for each placement
+// and returns the placement whose targets cost the least: the lowest
+// highest-priority target first, then the lowest next-highest, and so on, then
+// the fewest targets. It returns false when no placement yields targets.
+func (p *Preemptor) cheapestTopologyPlacement(
+	ctx context.Context,
+	placements []sets.Set[workload.Reference],
+	makeStrategy func(preferred sets.Set[workload.Reference]) PreemptionStrategy,
+) (sets.Set[workload.Reference], bool) {
+	log := log.FromContext(ctx)
+	var best sets.Set[workload.Reference]
+	var bestCost []int64
+	for _, placement := range placements {
+		strategy := makeStrategy(placement)
+		targets := p.getTargets(ctx, func(yield func(PreemptionStrategy) bool) { yield(strategy) })
+		if len(targets) == 0 {
+			continue
+		}
+		cost := make([]int64, 0, len(targets))
+		for _, target := range targets {
+			cost = append(cost, priority.EffectivePriority(log, target.WorkloadInfo.Obj))
+		}
+		slices.SortFunc(cost, func(a, b int64) int { return cmp.Compare(b, a) })
+		if best == nil || slices.Compare(cost, bestCost) < 0 {
+			best, bestCost = placement, cost
+		}
+	}
+	return best, best != nil
+}
