+
+package preemption
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"testing"
+	"time"
+
+	gocmp "github.com/google/go-cmp/cmp"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	"k8s.io/apimachinery/pkg/types"
+	clocktesting "k8s.io/utils/clock/testing"
+
+	config "sigs.k8s.io/kueue/apis/config/v1beta2"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/controller/core/indexer"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	preemptexpectations "sigs.k8s.io/kueue/pkg/scheduler/preemption/expectations"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingnode "sigs.k8s.io/kueue/pkg/util/testingjobs/node"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// TestTopologyRetryRespectsReclaimLimits builds nodes of 4 CPUs. Every node
+// but the last holds one priority-2 workload of ClusterQueue "c" and three
+// priority-1 workloads of ClusterQueue "b"; the last node holds the four
+// oldest workloads of "c". "b" borrows 2 CPUs and "c" borrows 4, which
+// ClusterQueue "incoming" reclaims for a priority-3 workload that needs a
+// whole node. Each node but the last frees cheaper victims, but only after
+// taking 3 CPUs from "b", which stops being a candidate once it is back at
+// its nominal quota, so only the last node can be freed.
+func TestTopologyRetryRespectsReclaimLimits(t *testing.T) {
+	modes := []struct {
+		name         string
+		cacheEnabled bool
+		fairSharing  *config.FairSharing
+	}{
+		{name: "classical/cache=false"},
+		{name: "classical/cache=true", cacheEnabled: true},
+		{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	}
+	for _, mode := range modes {
+		for _, nodes := range []int{5, 9, 64} {
+			t.Run(fmt.Sprintf("%s/nodes=%d", mode.name, nodes), func(t *testing.T) {
+				features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+				features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+				ctx, log := utiltesting.ContextWithLog(t)
+				now := time.Now().Truncate(time.Second)
+				const slots = 4
+				last := fmt.Sprintf("n%02d", nodes-1)
+				var admitted []kueue.Workload
+				add := func(name string, cq kueue.ClusterQueueReference, node string, priority int32, age int) {
+					admitted = append(admitted, *utiltestingapi.MakeWorkload(name, "default").UID(types.UID(name)).Priority(priority).
+						PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "1").UnconstrainedTopologyRequest().Obj()).
+						ReserveQuotaAt(utiltestingapi.MakeAdmission(cq).PodSets(
+							utiltestingapi.MakePodSetAssignment("main").Count(1).
+								Assignment(corev1.ResourceCPU, "tas", "1").
+								TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+									Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, 1).Obj()).Obj()).Obj()).Obj(),
+							now.Add(-time.Duration(age)*time.Second)).Obj())
+				}
+				// Newer workloads spread over the nodes, so ordinary preemption,
+				// which takes the newest first among equal priorities, takes
+				// victims on different nodes.
+				for s := range slots {
+					add(fmt.Sprintf("%s-c%d", last, s), "c", last, 2, 10*nodes+s)
+				}
+				for n := range nodes - 1 {
+					node := fmt.Sprintf("n%02d", n)
+					add(node+"-c", "c", node, 2, n)
+					for s := range slots - 1 {
+						add(fmt.Sprintf("%s-b%d", node, s), "b", node, 1, s*nodes+n)
+					}
+				}
+
+				cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+					WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+				cache := schdcache.New(cl)
+				cache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+				cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+				for n := range nodes {
+					node := fmt.Sprintf("n%02d", n)
+					cache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+						StatusAllocatable(corev1.ResourceList{
+							corev1.ResourceCPU:  resource.MustParse(strconv.Itoa(slots)),
+							corev1.ResourcePods: resource.MustParse("100"),
+						}).Ready().Obj())
+				}
+				// "b" uses 3 CPUs per node but the last and borrows 2, "c" uses
+				// one per node but the last plus 4 and borrows 4, and "incoming"
+				// lends the 6 CPUs they borrow.
+				for _, cq := range []*kueue.ClusterQueue{
+					utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+						ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "6", "0").Obj()).
+						Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}).Obj(),
+					utiltestingapi.MakeClusterQueue("b").Cohort("shared").
+						ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, strconv.Itoa(3*(nodes-1)-2)).Obj()).Obj(),
+					utiltestingapi.MakeClusterQueue("c").Cohort("shared").
+						ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, strconv.Itoa(nodes-1)).Obj()).Obj(),
+				} {
+					if err := cache.AddClusterQueue(ctx, cq); err != nil {
+						t.Fatal(err)
+					}
+				}
+				snapshot, err := cache.Snapshot(ctx)
+				if err != nil {
+					t.Fatal(err)
+				}
+				incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").UID("incoming").Priority(3).
+					PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, strconv.Itoa(slots)).UnconstrainedTopologyRequest().Obj()).Obj())
+				incoming.ClusterQueue = "incoming"
+				assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+					Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse(strconv.Itoa(slots))},
+					Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "tas", Mode: flavorassigner.Preempt}},
+				}}}
+
+				preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, mode.fairSharing, false, clocktesting.NewFakeClock(now), nil, preemptexpectations.New(), nil)
+				targets, retry := preemptor.GetTargets(ctx, *incoming, snapshot, assignment)
+				if len(targets) > 0 || retry == nil {
+					t.Fatalf("ordinary preemption found %d targets and retry=%t, want no targets and a retry", len(targets), retry != nil)
+				}
+				var gotTargets []string
+				for _, target := range retry(ctx) {
+					gotTargets = append(gotTargets, target.WorkloadInfo.Obj.Name)
+				}
+				slices.Sort(gotTargets)
+				wantTargets := []string{last + "-c0", last + "-c1", last + "-c2", last + "-c3"}
+				if diff := gocmp.Diff(wantTargets, gotTargets); diff != "" {
+					t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+				}
+			})
+		}
+	}
+}
+
+// limitsWorkload is a one-pod workload of a ClusterQueue on one node.
+type limitsWorkload struct {
+	name     string
+	cq       kueue.ClusterQueueReference
+	node     string
+	cpu      int
+	gpu      int
+	priority int32
+}
+
+// limitsResources is the capacity of a node or the requests of a pod.
+type limitsResources struct {
+	cpu, gpu int
+}
+
+// TestTopologyRetryMatchesStrategyLimits checks that the retry offers every
+// victim set the strategies may take: a ClusterQueue or Cohort gives up
+// quota to its parent only past its guaranteed quota, and a cheap victim the
+// placement does not need must not use up what a lender may give.
+func TestTopologyRetryMatchesStrategyLimits(t *testing.T) {
+	gpu := corev1.ResourceName("example.com/gpu")
+	cpu := func(nominal string, limits ...string) kueue.FlavorQuotas {
+		return *utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, append([]string{nominal}, limits...)...).Obj()
+	}
+	cpuGPU := func(cpuNominal, gpuNominal string) kueue.FlavorQuotas {
+		return *utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, cpuNominal).Resource(gpu, gpuNominal).Obj()
+	}
+	requests := func(r limitsResources) corev1.ResourceList {
+		list := corev1.ResourceList{corev1.ResourceCPU: resource.MustParse(strconv.Itoa(r.cpu))}
+		if r.gpu > 0 {
+			list[gpu] = resource.MustParse(strconv.Itoa(r.gpu))
+		}
+		return list
+	}
+	reclaim := kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}
+	cases := map[string]struct {
+		cohorts     []*kueue.Cohort
+		cqs         []*kueue.ClusterQueue
+		nodes       map[string]limitsResources
+		workloads   []limitsWorkload
+		incoming    limitsResources
+		wantTargets []string
+	}{
+		// "sub" borrows 2 CPUs, one for each ClusterQueue, which lend nothing,
+		// so removing a1 takes only the 1 CPU a1 borrows from "sub".
+		"ClusterQueues with a lending limit in a nested Cohort": {
+			cohorts: []*kueue.Cohort{utiltestingapi.MakeCohort("sub").Parent("root").Obj()},
+			cqs: []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("root").ResourceGroup(cpu("7")).Preemption(reclaim).Obj(),
+				utiltestingapi.MakeClusterQueue("a1").Cohort("sub").ResourceGroup(cpu("2", "", "0")).Obj(),
+				utiltestingapi.MakeClusterQueue("a2").Cohort("sub").ResourceGroup(cpu("1", "", "0")).Obj(),
+			},
+			nodes: map[string]limitsResources{"n0": {cpu: 2}, "n1": {cpu: 4}},
+			workloads: []limitsWorkload{
+				{name: "a1x", cq: "a1", node: "n0", cpu: 1, priority: 1},
+				{name: "a1", cq: "a1", node: "n1", cpu: 2, priority: 2},
+				{name: "a2", cq: "a2", node: "n1", cpu: 2, priority: 2},
+			},
+			incoming:    limitsResources{cpu: 4},
+			wantTargets: []string{"a1", "a2"},
+		},
+		// "sub" guarantees itself 1 CPU and borrows 2, so it still borrows
+		// after a1 gives up the CPU it borrows from "sub".
+		"Cohort with a lending limit": {
+			cohorts: []*kueue.Cohort{utiltestingapi.MakeCohort("sub").Parent("root").ResourceGroup(cpu("1", "", "0")).Obj()},
+			cqs: []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("root").ResourceGroup(cpu("7")).Preemption(reclaim).Obj(),
+				utiltestingapi.MakeClusterQueue("a1").Cohort("sub").ResourceGroup(cpu("2", "", "0")).Obj(),
+				utiltestingapi.MakeClusterQueue("a2").Cohort("sub").ResourceGroup(cpu("1", "", "0")).Obj(),
+				utiltestingapi.MakeClusterQueue("a3").Cohort("sub").ResourceGroup(cpu("0")).Obj(),
+			},
+			nodes: map[string]limitsResources{"n0": {cpu: 2}, "n1": {cpu: 4}, "n2": {cpu: 1}},
+			workloads: []limitsWorkload{
+				{name: "a1x", cq: "a1", node: "n0", cpu: 1, priority: 1},
+				{name: "a1", cq: "a1", node: "n1", cpu: 2, priority: 2},
+				{name: "a2", cq: "a2", node: "n1", cpu: 2, priority: 2},
+				{name: "a3", cq: "a3", node: "n2", cpu: 1, priority: 5},
+			},
+			incoming:    limitsResources{cpu: 4},
+			wantTargets: []string{"a1", "a2"},
+		},
+		// "b" borrows 1 CPU, so it may give up b1, but not bx and then b1;
+		// freeing n1 needs only b1.
+		"a cheap victim the placement does not need": {
+			cqs: []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").ResourceGroup(cpu("5")).Preemption(reclaim).Obj(),
+				utiltestingapi.MakeClusterQueue("b").Cohort("shared").ResourceGroup(cpu("3")).Obj(),
+			},
+			nodes: map[string]limitsResources{"n1": {cpu: 4}},
+			workloads: []limitsWorkload{
+				{name: "bx", cq: "b", node: "n1", cpu: 1, priority: 1},
+				{name: "b1", cq: "b", node: "n1", cpu: 3, priority: 2},
+			},
+			incoming:    limitsResources{cpu: 3},
+			wantTargets: []string{"b1"},
+		},
+		// "b" borrows 2 CPUs, so it may give up b1 and then bx, but not bx and
+		// then b1, the order the strategy takes them in when it prefers both;
+		// freeing the GPU of n1 needs only b1.
+		"a cheap victim that uses up a lender before the one the placement needs": {
+			cqs: []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").ResourceGroup(cpuGPU("5", "1")).Preemption(reclaim).Obj(),
+				utiltestingapi.MakeClusterQueue("b").Cohort("shared").ResourceGroup(cpuGPU("3", "1")).Obj(),
+			},
+			nodes: map[string]limitsResources{"n1": {cpu: 4, gpu: 1}, "n2": {cpu: 1}},
+			workloads: []limitsWorkload{
+				{name: "bx", cq: "b", node: "n1", cpu: 3, priority: 1},
+				{name: "b1", cq: "b", node: "n1", cpu: 1, gpu: 1, priority: 2},
+				{name: "b2", cq: "b", node: "n2", cpu: 1, priority: 5},
+			},
+			incoming:    limitsResources{cpu: 1, gpu: 1},
+			wantTargets: []string{"b1"},
+		},
+	}
+	modes := []struct {
+		name         string
+		cacheEnabled bool
+		fairSharing  *config.FairSharing
+	}{
+		{name: "classical/cache=false"},
+		{name: "classical/cache=true", cacheEnabled: true},
+		{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	}
+	for _, mode := range modes {
+		for name, tc := range cases {
+			t.Run(mode.name+"/"+name, func(t *testing.T) {
+				features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+				features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+				ctx, log := utiltesting.ContextWithLog(t)
+				now := time.Now().Truncate(time.Second)
+				var admitted []kueue.Workload
+				for i, w := range tc.workloads {
+					podSet := utiltestingapi.MakePodSet("main", 1).UnconstrainedTopologyRequest()
+					podSetAssignment := utiltestingapi.MakePodSetAssignment("main").Count(1)
+					for resourceName, quantity := range requests(limitsResources{cpu: w.cpu, gpu: w.gpu}) {
+						podSet.Request(resourceName, quantity.String())
+						podSetAssignment.Assignment(resourceName, "tas", quantity.String())
+					}
+					admitted = append(admitted, *utiltestingapi.MakeWorkload(w.name, "default").UID(types.UID(w.name)).Priority(w.priority).
+						PodSets(*podSet.Obj()).
+						ReserveQuotaAt(utiltestingapi.MakeAdmission(w.cq).PodSets(
+							podSetAssignment.TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+								Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{w.node}, 1).Obj()).Obj()).Obj()).Obj(),
+							now.Add(-time.Duration(i)*time.Second)).Obj())
+				}
+				cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+					WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+				cache := schdcache.New(cl)
+				cache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+				cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+				for node, capacity := range tc.nodes {
+					allocatable := requests(capacity)
+					allocatable[corev1.ResourcePods] = resource.MustParse("100")
+					cache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+						StatusAllocatable(allocatable).Ready().Obj())
+				}
+				for _, cohort := range tc.cohorts {
+					if err := cache.AddOrUpdateCohort(cohort); err != nil {
+						t.Fatal(err)
+					}
+				}
+				for _, cq := range tc.cqs {
+					if err := cache.AddClusterQueue(ctx, cq); err != nil {
+						t.Fatal(err)
+					}
+				}
+				snapshot, err := cache.Snapshot(ctx)
+				if err != nil {
+					t.Fatal(err)
+				}
+				incomingPodSet := utiltestingapi.MakePodSet("main", 1).UnconstrainedTopologyRequest()
+				flavors := flavorassigner.ResourceAssignment{}
+				for resourceName, quantity := range requests(tc.incoming) {
+					incomingPodSet.Request(resourceName, quantity.String())
+					flavors[resourceName] = &flavorassigner.FlavorAssignment{Name: "tas", Mode: flavorassigner.Preempt}
+				}
+				incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").UID("incoming").Priority(3).
+					PodSets(*incomingPodSet.Obj()).Obj())
+				incoming.ClusterQueue = "incoming"
+				assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+					Name: "main", Count: 1, Requests: requests(tc.incoming), Flavors: flavors,
+				}}}
+
+				preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, mode.fairSharing, false, clocktesting.NewFakeClock(now), nil, preemptexpectations.New(), nil)
+				targets, retry := preemptor.GetTargets(ctx, *incoming, snapshot, assignment)
+				if len(targets) > 0 || retry == nil {
+					t.Fatalf("ordinary preemption found %d targets and retry=%t, want no targets and a retry", len(targets), retry != nil)
+				}
+				var gotTargets []string
+				for _, target := range retry(ctx) {
+					gotTargets = append(gotTargets, target.WorkloadInfo.Obj.Name)
+				}
+				slices.Sort(gotTargets)
+				if diff := gocmp.Diff(tc.wantTargets, gotTargets); diff != "" {
+					t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+				}
+			})
+		}
+	}
+}
