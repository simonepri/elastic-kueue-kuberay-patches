+
+// topologyRetryCluster is a cohort where ClusterQueue "borrower" fills every
+// slot of nodes that each hold slots one-CPU workloads, and borrows exactly
+// one node's worth of CPU from ClusterQueue "incoming", which may reclaim it.
+// ClusterQueue "other", outside the cohort, has one workload on node n00.
+type topologyRetryCluster struct {
+	snapshot   *schdcache.Snapshot
+	incoming   workload.Info
+	assignment flavorassigner.Assignment
+}
+
+// newTopologyRetryCluster builds the cluster with priorities[n] holding the
+// priorities of node n's workloads. The last node's workloads were admitted
+// first, so ordinary preemption, which takes the newest workloads first among
+// equal priorities, spreads its victims over the other nodes.
+func newTopologyRetryCluster(ctx context.Context, t testing.TB, log logr.Logger, priorities [][]int32) topologyRetryCluster {
+	t.Helper()
+	now := time.Now().Truncate(time.Second)
+	nodes, slots := len(priorities), len(priorities[0])
+	admission := func(cq kueue.ClusterQueueReference, node string) *kueue.Admission {
+		return utiltestingapi.MakeAdmission(cq).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(1).
+				Assignment(corev1.ResourceCPU, "tas", "1").
+				TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+					Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, 1).Obj()).Obj()).Obj()).Obj()
+	}
+	worker := func(name string, priority int32) *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload(name, "default").UID(types.UID(name)).Priority(priority).
+			PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "1").UnconstrainedTopologyRequest().Obj())
+	}
+	var admitted []kueue.Workload
+	for n, nodePriorities := range priorities {
+		node := fmt.Sprintf("n%02d", n)
+		for s, p := range nodePriorities {
+			age := s*nodes + n
+			if n == nodes-1 {
+				age = nodes*slots + s
+			}
+			admitted = append(admitted, *worker(fmt.Sprintf("%s-%d", node, s), p).
+				ReserveQuotaAt(admission("borrower", node), now.Add(-time.Duration(age)*time.Second)).Obj())
+		}
+	}
+	admitted = append(admitted, *worker("other", 1).ReserveQuotaAt(admission("other", "n00"), now).Obj())
+
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+	for n := range nodes {
+		node := fmt.Sprintf("n%02d", n)
+		// Node n00 has one more slot, used by the workload of ClusterQueue "other".
+		capacity := slots
+		if n == 0 {
+			capacity++
+		}
+		cache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+			StatusAllocatable(corev1.ResourceList{
+				corev1.ResourceCPU:  resource.MustParse(strconv.Itoa(capacity)),
+				corev1.ResourcePods: resource.MustParse("100"),
+			}).Ready().Obj())
+	}
+	slotsQuantity := strconv.Itoa(slots)
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, slotsQuantity, "0").Obj()).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, strconv.Itoa(nodes*slots-slots)).Obj()).Obj(),
+		utiltestingapi.MakeClusterQueue("other").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "1").Obj()).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").UID("incoming").Priority(3).
+		PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, slotsQuantity).UnconstrainedTopologyRequest().Obj()).Obj())
+	incoming.ClusterQueue = "incoming"
+	return topologyRetryCluster{
+		snapshot: snapshot,
+		incoming: *incoming,
+		assignment: flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+			Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: resource.MustParse(slotsQuantity)},
+			Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "tas", Mode: flavorassigner.Preempt}},
+		}}},
+	}
+}
+
+// uniformPriorities returns the priorities of the given number of nodes that
+// each hold the workloads of priorities, except for the last node, which
+// holds those of last.
+func uniformPriorities(nodes int, priorities, last []int32) [][]int32 {
+	result := make([][]int32, nodes)
+	for n := range nodes - 1 {
+		result[n] = priorities
+	}
+	result[nodes-1] = last
+	return result
+}
+
+func TestTopologyRetryComparesEveryDomain(t *testing.T) {
+	cases := map[string]struct {
+		priorities  [][]int32
+		wantTargets []string
+	}{
+		"only the last of 10 nodes can be freed without a priority-2 victim": {
+			priorities:  uniformPriorities(10, []int32{2, 1}, []int32{1, 1}),
+			wantTargets: []string{"n09-0", "n09-1"},
+		},
+		"only the last of 64 nodes can be freed without a priority-2 victim": {
+			priorities:  uniformPriorities(64, []int32{2, 1, 1}, []int32{1, 1, 1}),
+			wantTargets: []string{"n63-0", "n63-1", "n63-2"},
+		},
+		"the last of 64 nodes has the lowest next-highest victims": {
+			priorities:  uniformPriorities(64, []int32{2, 1, 1}, []int32{2, 1, 0}),
+			wantTargets: []string{"n63-0", "n63-1", "n63-2"},
+		},
+	}
+	modes := []struct {
+		name         string
+		cacheEnabled bool
+		fairSharing  *config.FairSharing
+	}{
+		{name: "classical/cache=false"},
+		{name: "classical/cache=true", cacheEnabled: true},
+		{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	}
+	for _, mode := range modes {
+		t.Run(mode.name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+			for name, tc := range cases {
+				t.Run(name, func(t *testing.T) {
+					features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+					ctx, log := utiltesting.ContextWithLog(t)
+					cluster := newTopologyRetryCluster(ctx, t, log, tc.priorities)
+					preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, mode.fairSharing, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+					targets, retry := preemptor.GetTargets(ctx, cluster.incoming, cluster.snapshot, cluster.assignment)
+					if len(targets) > 0 || retry == nil {
+						t.Fatalf("ordinary preemption found %d targets and retry=%t, want no targets and a retry", len(targets), retry != nil)
+					}
+					var gotTargets []string
+					for _, target := range retry(ctx) {
+						gotTargets = append(gotTargets, target.WorkloadInfo.Obj.Name)
+					}
+					slices.Sort(gotTargets)
+					if diff := gocmp.Diff(tc.wantTargets, gotTargets); diff != "" {
+						t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestTopologyRetryRemembersFailures(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+	ctx, log := utiltesting.ContextWithLog(t)
+	// Every node holds a workload of the incoming workload's priority, so no
+	// node can be freed, and node n00 stays blocked without the workload of
+	// ClusterQueue "other".
+	priorities := uniformPriorities(4, []int32{3, 1}, []int32{3, 1})
+	priorities[0] = []int32{3, 3}
+	cluster := newTopologyRetryCluster(ctx, t, log, priorities)
+	preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+	pCtx := preemptor.buildContext(ctx, cluster.incoming, cluster.assignment, cluster.snapshot)
+	runs := 0
+	var retryTargets []*Target
+	retry := func() []*Target {
+		runs++
+		return preemptor.topologyRetryTargets(ctx, pCtx)
+	}
+	attempt := func(step string, wantRuns int) {
+		t.Helper()
+		if targets := preemptor.topologyRetryFailures.run(ctx, preemptor, pCtx, retry); len(targets) != len(retryTargets) {
+			t.Errorf("%s: got %d targets, want %d", step, len(targets), len(retryTargets))
+		}
+		if runs != wantRuns {
+			t.Errorf("%s: the retry ran %d times, want %d", step, runs, wantRuns)
+		}
+	}
+	attempt("first attempt", 1)
+	attempt("same state", 1)
+
+	other := cluster.snapshot.ClusterQueue("other").Workloads[workload.NewReference("default", "other")]
+	cluster.snapshot.RemoveWorkload(other)
+	attempt("TAS usage outside the cohort changed", 2)
+	attempt("same state after the TAS change", 2)
+	cluster.snapshot.AddWorkload(other)
+	attempt("TAS usage outside the cohort restored", 3)
+
+	victim := cluster.snapshot.ClusterQueue("borrower").Workloads[workload.NewReference("default", "n01-1")]
+	cluster.snapshot.RemoveWorkload(victim)
+	attempt("workload in the cohort removed", 4)
+	cluster.snapshot.AddWorkload(victim)
+	attempt("workload in the cohort restored", 5)
+
+	otherAssignment := cluster.assignment
+	otherAssignment.PodSets = slices.Clone(cluster.assignment.PodSets)
+	otherAssignment.PodSets[0].Count = 2
+	pCtx = preemptor.buildContext(ctx, cluster.incoming, otherAssignment, cluster.snapshot)
+	attempt("another assignment", 6)
+	attempt("same assignment again", 6)
+
+	// A retry that finds targets clears the memory.
+	retryTargets = []*Target{{WorkloadInfo: victim}}
+	retry = func() []*Target {
+		runs++
+		return retryTargets
+	}
+	cluster.snapshot.RemoveWorkload(victim)
+	attempt("retry succeeds", 7)
+	if len(preemptor.topologyRetryFailures.failed) != 0 {
+		t.Errorf("a successful retry left %d remembered failures", len(preemptor.topologyRetryFailures.failed))
+	}
+}
+
+func TestTopologyRetryForgetsFailuresAfterPriorityBoost(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+	features.SetFeatureGateDuringTest(t, features.PriorityBoost, true)
+	ctx, log := utiltesting.ContextWithLog(t)
+	// Every node holds a workload of the incoming workload's priority, so the
+	// retry fails until a priority boost lets the incoming workload preempt
+	// them.
+	cluster := newTopologyRetryCluster(ctx, t, log, uniformPriorities(4, []int32{3, 1}, []int32{3, 1}))
+	preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+	runs := 0
+	attempt := func() []*Target {
+		pCtx := preemptor.buildContext(ctx, cluster.incoming, cluster.assignment, cluster.snapshot)
+		return preemptor.topologyRetryFailures.run(ctx, preemptor, pCtx, func() []*Target {
+			runs++
+			return preemptor.topologyRetryTargets(ctx, pCtx)
+		})
+	}
+	if targets := attempt(); len(targets) != 0 || runs != 1 {
+		t.Fatalf("before the boost: got %d targets after %d runs, want none after 1", len(targets), runs)
+	}
+	// The boost annotation changes the effective priority, not the generation.
+	cluster.incoming.Obj.Annotations = map[string]string{constants.PriorityBoostAnnotationKey: "1"}
+	targets := attempt()
+	if runs != 2 {
+		t.Errorf("after the boost: the retry ran %d times, want 2", runs)
+	}
+	if len(targets) != 2 {
+		t.Errorf("after the boost: got %d targets, want the 2 workloads of one node", len(targets))
+	}
+}
+
+// distinctPriorities returns the priorities of the given number of nodes,
+// each with slots workloads, that all differ, with the lowest ones spread
+// over the nodes, so node n00 is the only one that can be freed below the
+// highest priorities and ordinary preemption takes its victims on different
+// nodes.
+func distinctPriorities(nodes, slots int) [][]int32 {
+	priorities := make([][]int32, nodes)
+	for n := range nodes {
+		priorities[n] = make([]int32, slots)
+		for s := range slots {
+			priorities[n][s] = int32(s*nodes + n + 1)
+		}
+	}
+	return priorities
+}
+
+func TestTopologyRetryWithDistinctPriorities(t *testing.T) {
+	const nodes, slots = 64, 4
+	for _, fairSharing := range []*config.FairSharing{nil, {}} {
+		t.Run(fmt.Sprintf("fairsharing=%t", fairSharing != nil), func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.TopologyAwareScheduling, true)
+			ctx, log := utiltesting.ContextWithLog(t)
+			cluster := newTopologyRetryCluster(ctx, t, log, distinctPriorities(nodes, slots))
+			incomingPriority := int32(nodes*slots + 1)
+			cluster.incoming.Obj.Spec.Priority = &incomingPriority
+			preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, fairSharing, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+			var gotTargets []string
+			for _, target := range getTargetsWithTopologyRetry(ctx, preemptor, cluster.incoming, cluster.snapshot, cluster.assignment) {
+				gotTargets = append(gotTargets, target.WorkloadInfo.Obj.Name)
+			}
+			slices.Sort(gotTargets)
+			if diff := gocmp.Diff([]string{"n00-0", "n00-1", "n00-2", "n00-3"}, gotTargets); diff != "" {
+				t.Errorf("unexpected preemption targets (-want/+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+// BenchmarkTopologyRetryDistinctPriorities measures a retry whose candidates
+// all have different priorities, so the lowest priority ceiling at which a
+// node can be freed is three quarters of the way up.
+func BenchmarkTopologyRetryDistinctPriorities(b *testing.B) {
+	const slots = 4
+	for _, nodes := range []int{64, 256, 1024} {
+		b.Run(fmt.Sprintf("nodes=%d", nodes), func(b *testing.B) {
+			features.SetFeatureGateDuringTest(b, features.TopologyAwareScheduling, true)
+			ctx, log := utiltesting.ContextWithLog(b)
+			cluster := newTopologyRetryCluster(ctx, b, log, distinctPriorities(nodes, slots))
+			incomingPriority := int32(nodes*slots + 1)
+			cluster.incoming.Obj.Spec.Priority = &incomingPriority
+			b.ReportAllocs()
+			b.ResetTimer()
+			targetCount := 0
+			for range b.N {
+				b.StopTimer()
+				preemptor := New(nil, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(time.Now()), nil, preemptexpectations.New(), nil)
+				b.StartTimer()
+				targetCount += len(getTargetsWithTopologyRetry(ctx, preemptor, cluster.incoming, cluster.snapshot, cluster.assignment))
+			}
+			b.StopTimer()
+			b.ReportMetric(float64(targetCount)/float64(b.N), "targets/op")
+		})
+	}
+}
