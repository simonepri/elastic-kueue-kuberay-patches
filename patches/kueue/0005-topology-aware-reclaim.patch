+
+package scheduler
+
+import (
+	"hash/maphash"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+
+	"sigs.k8s.io/kueue/pkg/resources"
+	utiltas "sigs.k8s.io/kueue/pkg/util/tas"
+)
+
+// StateFingerprint returns a hash of the state a topology assignment on the
+// snapshot reads: the nodes the topology was built from, each leaf's capacity,
+// free capacity and TAS usage, the TAS usage of virtual domains, and the
+// flavor's tolerations. Snapshots that place workloads differently have
+// different fingerprints, except for hash collisions.
+func (s *TASFlavorSnapshot) StateFingerprint(seed maphash.Seed) uint64 {
+	type amountItem struct {
+		kind     uint8
+		domain   utiltas.TopologyDomainID
+		resource corev1.ResourceName
+		small    int64
+		large    string
+	}
+	var sum uint64
+	addRequests := func(kind uint8, domain utiltas.TopologyDomainID, requests resources.Requests) {
+		if requests == nil {
+			return
+		}
+		for name, amount := range requests.Iter() {
+			item := amountItem{kind: kind, domain: domain, resource: name}
+			if small, ok := amount.Int64(); ok {
+				item.small = small
+			} else {
+				item.large = amount.String()
+			}
+			sum += maphash.Comparable(seed, item)
+		}
+	}
+	sum += maphash.Comparable(seed, struct {
+		generation int64
+		levels     string
+		leaves     int
+		virtual    bool
+	}{s.generation, strings.Join(s.levelKeys, "\x00"), len(s.leaves), s.virtualHostname})
+	for id, leaf := range s.leaves {
+		leafCapacity := s.leafCapacityOf(leaf)
+		addRequests(0, id, leaf.capacity)
+		addRequests(1, id, leafCapacity.freeCapacity)
+		addRequests(2, id, leafCapacity.tasUsage)
+	}
+	for id, usage := range s.domainTASUsage {
+		addRequests(3, id, usage)
+	}
+	for i, toleration := range s.tolerations {
+		var seconds int64 = -1
+		if toleration.TolerationSeconds != nil {
+			seconds = *toleration.TolerationSeconds
+		}
+		sum += maphash.Comparable(seed, struct {
+			index                int
+			key, operator, value string
+			effect               corev1.TaintEffect
+			tolerationSeconds    int64
+		}{i, toleration.Key, string(toleration.Operator), toleration.Value, toleration.Effect, seconds})
+	}
+	return sum
+}
