+		// candidate order alternates racks.
+		alternate := func(priority func(i int) int32) []topologyPreemptionVictim {
+			var victims []topologyPreemptionVictim
+			for i := range 8 {
+				rack := []string{"r1", "r2"}[i%2]
+				victims = append(victims, topologyPreemptionVictim{node: twoRacks[rack][i/2], gpus: "8", priority: priority(i)})
+			}
+			return victims
+		}
+		oneRack := map[string][]string{"r1": {prefix + "-n1", prefix + "-n2"}}
+		// halfNodes pins four 4-GPU victims to n1, n2, n1, n2.
+		halfNodes := func(priority func(i int) int32) []topologyPreemptionVictim {
+			var victims []topologyPreemptionVictim
+			for i := range 4 {
+				victims = append(victims, topologyPreemptionVictim{node: oneRack["r1"][i%2], gpus: "4", priority: priority(i)})
+			}
+			return victims
+		}
+		ascending := func(i int) int32 { return int32(i + 1) }
+		equal := func(int) int32 { return 10 }
+
+		var (
+			ns      *corev1.Namespace
+			cleanup func()
+		)
+		ginkgo.BeforeAll(func() {
+			fwk.StartManager(ctx, cfg, managerSetupWithConfig(mode.cfg))
+		})
+		ginkgo.AfterAll(func() {
+			fwk.StopManager(ctx)
+		})
+		ginkgo.BeforeEach(func() {
+			ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "tas-reclaim-")
+		})
+		ginkgo.AfterEach(func() {
+			if cleanup != nil {
+				cleanup()
+				cleanup = nil
+			}
+			gomega.Expect(forceDeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+		})
+
+		ginkgo.DescribeTable("reclaims one topology domain",
+			func(tc topologyPreemptionCase) {
+				var nodes []corev1.Node
+				domainOfHost := map[string]string{}
+				for rack, names := range tc.racks {
+					for _, name := range names {
+						domainOfHost[name] = name
+						if tc.preemptorLevel == utiltesting.DefaultRackTopologyLevel {
+							domainOfHost[name] = rack
+						}
+						nodes = append(nodes, *testingnode.MakeNode(name).
+							Label("node-group", prefix).
+							Label(utiltesting.DefaultBlockTopologyLevel, "b1").
+							Label(utiltesting.DefaultRackTopologyLevel, rack).
+							Label(corev1.LabelHostname, name).
+							StatusAllocatable(corev1.ResourceList{
+								topologyPreemptionGPU: resource.MustParse("8"),
+								corev1.ResourceCPU:    resource.MustParse("8"),
+								corev1.ResourceMemory: resource.MustParse("8Gi"),
+								corev1.ResourcePods:   resource.MustParse("20"),
+							}).
+							Ready().
+							Obj())
+					}
+				}
+				integration.CreateNodesWithStatus(ctx, k8sClient, nodes)
+				topology := utiltestingapi.MakeDefaultThreeLevelTopology(prefix + "-topo")
+				behavioral.MustCreate(ctx, k8sClient, topology)
+				flavor := utiltestingapi.MakeResourceFlavor(prefix+"-flavor").
+					NodeLabel("node-group", prefix).TopologyName(topology.Name).Obj()
+				behavioral.MustCreate(ctx, k8sClient, flavor)
+				makeCQ := func(name string) *kueue.ClusterQueue {
+					return utiltestingapi.MakeClusterQueue(prefix + "-" + name).
+						Cohort(kueue.CohortReference(prefix + "-cohort")).
+						Preemption(kueue.ClusterQueuePreemption{
+							WithinClusterQueue:  kueue.PreemptionPolicyLowerPriority,
+							ReclaimWithinCohort: kueue.PreemptionPolicyAny,
+						}).
+						ResourceGroup(*utiltestingapi.MakeFlavorQuotas(flavor.Name).Resource(topologyPreemptionGPU, tc.nominal).Obj()).
+						Obj()
+				}
+				cqA, cqB := makeCQ("cq-a"), makeCQ("cq-b")
+				behavioral.MustCreate(ctx, k8sClient, cqA)
+				behavioral.MustCreate(ctx, k8sClient, cqB)
+				behavioral.ExpectClusterQueuesToBeActive(ctx, k8sClient, cqA, cqB)
+				lqA := utiltestingapi.MakeLocalQueue("lq-a", ns.Name).ClusterQueue(cqA.Name).Obj()
+				lqB := utiltestingapi.MakeLocalQueue("lq-b", ns.Name).ClusterQueue(cqB.Name).Obj()
+				behavioral.MustCreate(ctx, k8sClient, lqA)
+				behavioral.MustCreate(ctx, k8sClient, lqB)
+				// The manager has to keep running while the queues are deleted, so
+				// this runs in AfterEach rather than after the Ordered container.
+				cleanup = func() {
+					gomega.Expect(behavioral.DeleteWorkloadsInNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+					gomega.Expect(behavioral.DeleteObject(ctx, k8sClient, lqA)).To(gomega.Succeed())
+					gomega.Expect(behavioral.DeleteObject(ctx, k8sClient, lqB)).To(gomega.Succeed())
+					behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, cqA, true)
+					behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, cqB, true)
+					behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, flavor, true)
+					behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, topology, true)
+					for i := range nodes {
+						behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, &nodes[i], true)
+					}
+				}
+
+				var victims []*kueue.Workload
+				for i, v := range tc.victims {
+					ps := utiltestingapi.MakePodSet("main", 1).
+						RequiredTopologyRequest(corev1.LabelHostname).
+						Request(topologyPreemptionGPU, v.gpus)
+					if v.node != "" {
+						ps = ps.NodeSelector(map[string]string{corev1.LabelHostname: v.node})
+					}
+					wl := utiltestingapi.MakeWorkload(fmt.Sprintf("b-%d", i+1), ns.Name).
+						Queue(kueue.LocalQueueName(lqB.Name)).
+						Priority(v.priority).
+						PodSets(*ps.Obj()).
+						Obj()
+					behavioral.MustCreate(ctx, k8sClient, wl)
+					behavioral.ExpectWorkloadsToBeAdmitted(ctx, k8sClient, wl)
+					victims = append(victims, wl)
+				}
+
+				reclaimer := utiltestingapi.MakeWorkload("a", ns.Name).
+					Queue(kueue.LocalQueueName(lqA.Name)).
+					Priority(100).
+					PodSets(*utiltestingapi.MakePodSet("main", tc.preemptorPods).
+						RequiredTopologyRequest(tc.preemptorLevel).
+						Request(topologyPreemptionGPU, "8").
+						Obj()).
+					Obj()
+				behavioral.MustCreate(ctx, k8sClient, reclaimer)
+
+				preempted := map[int]string{}
+				gomega.Eventually(func(g gomega.Gomega) {
+					for i, wl := range victims {
+						g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).To(gomega.Succeed())
+						if !workloadevict.IsEvicted(wl) {
+							continue
+						}
+						if _, seen := preempted[i]; !seen {
+							preempted[i] = domainOf(wl, domainOfHost)
+						}
+						if workload.HasQuotaReservation(wl) {
+							behavioral.FinishEvictionForWorkloads(ctx, k8sClient, wl)
+						}
+					}
+					g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(reclaimer), reclaimer)).To(gomega.Succeed())
+					message := ""
+					if cond := apimeta.FindStatusCondition(reclaimer.Status.Conditions, kueue.WorkloadQuotaReserved); cond != nil {
+						message = cond.Message
+					}
+					g.Expect(workload.IsAdmitted(reclaimer)).To(gomega.BeTrue(), "reclaimer not admitted: %q; preempted %v", message, preempted)
+				}, behavioral.MediumTimeout, behavioral.Interval).Should(gomega.Succeed())
+
+				domains := map[string]bool{}
+				var indexes []int
+				for i, domain := range preempted {
+					domains[domain] = true
+					indexes = append(indexes, i)
+				}
+				slices.Sort(indexes)
+				gomega.Expect(domains).To(gomega.HaveLen(1), "victims span domains: %v", preempted)
+				if tc.wantPreempted != nil {
+					gomega.Expect(indexes).To(gomega.Equal(tc.wantPreempted))
+				}
+			},
+			ginkgo.Entry("rack, victims placed by TAS", topologyPreemptionCase{
+				racks: twoRacks, nominal: "32", preemptorPods: 4, preemptorLevel: utiltesting.DefaultRackTopologyLevel,
+				victims: func() []topologyPreemptionVictim {
+					victims := make([]topologyPreemptionVictim, 8)
+					for i := range victims {
+						victims[i] = topologyPreemptionVictim{gpus: "8", priority: 10}
+					}
+					return victims
+				}(),
+			}),
+			ginkgo.Entry("rack, victims alternate racks by priority", topologyPreemptionCase{
+				racks: twoRacks, nominal: "32", preemptorPods: 4, preemptorLevel: utiltesting.DefaultRackTopologyLevel,
+				victims: alternate(ascending), wantPreempted: []int{0, 2, 4, 6},
+			}),
+			ginkgo.Entry("rack, equal-priority victims alternate racks by age", topologyPreemptionCase{
+				racks: twoRacks, nominal: "32", preemptorPods: 4, preemptorLevel: utiltesting.DefaultRackTopologyLevel,
+				victims: alternate(equal),
+			}),
+			ginkgo.Entry("node, victims alternate nodes by priority", topologyPreemptionCase{
+				racks: oneRack, nominal: "8", preemptorPods: 1, preemptorLevel: corev1.LabelHostname,
+				victims: halfNodes(ascending), wantPreempted: []int{0, 2},
+			}),
+			ginkgo.Entry("node, equal-priority victims alternate nodes by age", topologyPreemptionCase{
+				racks: oneRack, nominal: "8", preemptorPods: 1, preemptorLevel: corev1.LabelHostname,
+				victims: halfNodes(equal),
+			}),
+		)
+	})
+}
+
+// domainOf returns the domains, at the reclaimer's required level, of the
+// hosts the workload was placed on.
+func domainOf(wl *kueue.Workload, domainOfHost map[string]string) string {
+	if wl.Status.Admission == nil || wl.Status.Admission.PodSetAssignments[0].TopologyAssignment == nil {
+		return "<none>"
+	}
+	ta := utiltas.InternalFrom(wl.Status.Admission.PodSetAssignments[0].TopologyAssignment)
+	host := slices.Index(ta.Levels, corev1.LabelHostname)
+	var domains []string
+	for _, d := range ta.Domains {
+		domains = append(domains, domainOfHost[d.Values[host]])
+	}
+	slices.Sort(domains)
+	return strings.Join(slices.Compact(domains), ",")
+}
