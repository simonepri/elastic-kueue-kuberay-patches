+// planWithTopologyRetry returns the plan without preemption targets, and lets
+// the caller run the topology retry once nothing else fits.
+func (p *nativePlanner) planWithTopologyRetry(
+	ctx context.Context,
+	cq *schdcache.ClusterQueueSnapshot,
+	asgn *flavorassigner.Assignment,
+	topologyRetry preemption.TopologyRetry,
+) assignment.Plan {
+	type podSetTopology struct {
+		assignment *tas.TopologyAssignment
+		delayed    *kueue.DelayedTopologyRequestState
+	}
+	unplaced := make([]podSetTopology, len(asgn.PodSets))
+	for i, ps := range asgn.PodSets {
+		unplaced[i] = podSetTopology{ps.TopologyAssignment, ps.DelayedTopologyRequest}
+	}
+	p.updateAssignmentForTAS(ctx, cq, asgn, nil)
+	plan := assignment.Plan{Assignment: asgn}
+	plan.TopologyRetry = func(ctx context.Context) assignment.Plan {
+		targets := topologyRetry(ctx)
+		if len(targets) == 0 {
+			return plan
+		}
+		// Drop the placement on an empty cluster recorded above, so the
+		// topology requests are placed again around the targets.
+		for i, ps := range unplaced {
+			asgn.PodSets[i].TopologyAssignment = ps.assignment
+			asgn.PodSets[i].DelayedTopologyRequest = ps.delayed
+		}
+		p.updateAssignmentForTAS(ctx, cq, asgn, targets)
+		return assignment.Plan{Assignment: asgn, PreemptionTargets: targets}
+	}
+	return plan
+}
