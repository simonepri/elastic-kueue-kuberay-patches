+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package preemption
+
+import (
+	"slices"
+
+	"k8s.io/apimachinery/pkg/util/sets"
+
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/resources"
+)
+
+// reclaimLimits checks sets of candidates against the rule Classical
+// preemption and fair sharing share: a candidate of another ClusterQueue is
+// taken only while that ClusterQueue, and every Cohort between it and the
+// first Cohort it shares with the preemptor, still borrows in one of the
+// resources that need preemption. It removes the candidates' quota usage from
+// the snapshot and asks the snapshot's own resource tree whether each of them
+// still borrows, so guaranteed quota, lending limits, and nested Cohorts give
+// up usage to their parents exactly as they do when the strategy removes the
+// victims. A topology retry checks its placements with it before it runs a
+// strategy, so it does not spend its evaluations on placements the strategy
+// rejects. Fair sharing also requires every node on the path to borrow in one
+// resource the candidate uses, and checks the shares, so it may reject a set
+// this accepts, never the other way around.
+type reclaimLimits struct {
+	pCtx               *preemptionCtx
+	frs                sets.Set[resources.FlavorResource]
+	preemptorAncestors sets.Set[*schdcache.CohortSnapshot]
+}
+
+func newReclaimLimits(pCtx *preemptionCtx) *reclaimLimits {
+	limits := &reclaimLimits{
+		pCtx:               pCtx,
+		frs:                pCtx.frsNeedPreemption,
+		preemptorAncestors: sets.New[*schdcache.CohortSnapshot](),
+	}
+	for cohort := range pCtx.preemptorCQ.PathParentToRoot() {
+		limits.preemptorAncestors.Insert(cohort)
+	}
+	return limits
+}
+
+// mayTake reports whether the strategies may take candidate in the current
+// state of the snapshot.
+func (l *reclaimLimits) mayTake(candidate *retryCandidate) bool {
+	if candidate.wl.ClusterQueue == l.pCtx.preemptorCQ.Name {
+		return true
+	}
+	cq := l.pCtx.snapshot.ClusterQueue(candidate.wl.ClusterQueue)
+	if schdcache.IsWithinNominalInResources(cq, l.frs) {
+		return false
+	}
+	for cohort := range cq.PathParentToRoot() {
+		if l.preemptorAncestors.Has(cohort) {
+			break
+		}
+		if schdcache.IsWithinNominalInResources(cohort, l.frs) {
+			return false
+		}
+	}
+	return true
+}
+
+// allows reports whether the strategies may take every candidate in
+// candidates in some order. It answers exactly: removing usage never makes a
+// node borrow, so a candidate the rule accepts with more usage left still
+// accepts it later. Building the order backwards, from the state with every
+// candidate removed, it can add back any candidate the rule accepts as the
+// last one taken without ruling out an order for the others. It leaves the
+// snapshot as it found it and costs up to len(candidates) squared checks of the rule.
+func (l *reclaimLimits) allows(candidates []*retryCandidate) bool {
+	snapshot := l.pCtx.snapshot
+	pending := make([]*retryCandidate, 0, len(candidates))
+	for _, candidate := range candidates {
+		if candidate.wl.ClusterQueue == l.pCtx.preemptorCQ.Name {
+			continue
+		}
+		snapshot.RemoveWorkloadUsage(candidate.wl, candidate.quota)
+		pending = append(pending, candidate)
+	}
+	defer func() {
+		for _, candidate := range pending {
+			snapshot.AddWorkloadUsage(candidate.wl, candidate.quota)
+		}
+	}()
+	for len(pending) > 0 {
+		last := -1
+		for i, candidate := range pending {
+			snapshot.AddWorkloadUsage(candidate.wl, candidate.quota)
+			if l.mayTake(candidate) {
+				last = i
+				break
+			}
+			snapshot.RemoveWorkloadUsage(candidate.wl, candidate.quota)
+		}
+		if last < 0 {
+			return false
+		}
+		pending = append(pending[:last], pending[last+1:]...)
+	}
+	return true
+}
+
+// allowsInOrder reports whether the strategies may take candidates in the
+// order given, as they take the candidates a placement prefers. It leaves
+// the snapshot as it found it.
+func (l *reclaimLimits) allowsInOrder(candidates []*retryCandidate) bool {
+	snapshot := l.pCtx.snapshot
+	removed := 0
+	defer func() {
+		for _, candidate := range candidates[:removed] {
+			snapshot.AddWorkloadUsage(candidate.wl, candidate.quota)
+		}
+	}()
+	for _, candidate := range candidates {
+		if !l.mayTake(candidate) {
+			return false
+		}
+		snapshot.RemoveWorkloadUsage(candidate.wl, candidate.quota)
+		removed++
+	}
+	return true
+}
+
+// reclaimGroup is a set of candidates the strategies may take together in
+// some order. It keeps their quota usage removed from the snapshot until
+// release.
+type reclaimGroup struct {
+	limits  *reclaimLimits
+	members []*retryCandidate
+}
+
+func (l *reclaimLimits) newGroup() *reclaimGroup {
+	return &reclaimGroup{limits: l}
+}
+
+// tryAdd adds candidate to the group when the strategies may still take the
+// whole group, and reports whether it did. When the rule accepts candidate
+// with the group removed, candidate can be taken last, which costs one check;
+// otherwise it looks for another order the way allows does.
+func (g *reclaimGroup) tryAdd(candidate *retryCandidate) bool {
+	snapshot := g.limits.pCtx.snapshot
+	if g.limits.mayTake(candidate) {
+		snapshot.RemoveWorkloadUsage(candidate.wl, candidate.quota)
+		g.members = append(g.members, candidate)
+		return true
+	}
+	snapshot.RemoveWorkloadUsage(candidate.wl, candidate.quota)
+	pending := append(slices.Clone(g.members), candidate)
+	var added []*retryCandidate
+	for len(pending) > 0 {
+		last := -1
+		for i, member := range pending {
+			snapshot.AddWorkloadUsage(member.wl, member.quota)
+			if g.limits.mayTake(member) {
+				last = i
+				break
+			}
+			snapshot.RemoveWorkloadUsage(member.wl, member.quota)
+		}
+		if last < 0 {
+			break
+		}
+		added = append(added, pending[last])
+		pending = append(pending[:last], pending[last+1:]...)
+	}
+	for _, member := range added {
+		snapshot.RemoveWorkloadUsage(member.wl, member.quota)
+	}
+	if len(pending) > 0 {
+		snapshot.AddWorkloadUsage(candidate.wl, candidate.quota)
+		return false
+	}
+	g.members = append(g.members, candidate)
+	return true
+}
+
+// release puts back the quota usage of the group's members and returns them.
+func (g *reclaimGroup) release() []*retryCandidate {
+	for _, member := range g.members {
+		g.limits.pCtx.snapshot.AddWorkloadUsage(member.wl, member.quota)
+	}
+	return g.members
+}
