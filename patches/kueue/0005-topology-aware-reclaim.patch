+package preemption
+
+import (
+	"cmp"
+	"context"
+	"slices"
+
+	"k8s.io/apimachinery/pkg/util/sets"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	"sigs.k8s.io/kueue/pkg/util/priority"
+	utiltas "sigs.k8s.io/kueue/pkg/util/tas"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// maxTopologyPlacements bounds how many alternative placements a topology
+// retry evaluates, so a workload that keeps failing costs a bounded amount of
+// work per scheduling attempt.
+const maxTopologyPlacements = 8
+
+// TopologyRetry searches for preemption targets that free whole topology
+// domains for the preemptor. It returns no targets when no placement can be
+// freed within the preemption policies.
+type TopologyRetry func(ctx context.Context) []*Target
+
+// GetTargets returns the targets of ordinary preemption for wl. When ordinary
+// preemption finds no targets because the quota fits but no topology placement
+// does, it also returns a TopologyRetry. The caller runs it only once every
+// other way to admit wl failed, so ordinary preemption wins whenever it
+// succeeds.
+func (p *Preemptor) GetTargets(
+	ctx context.Context,
+	wl workload.Info,
+	snapshot *schdcache.Snapshot,
+	assignment flavorassigner.Assignment,
+) ([]*Target, TopologyRetry) {
+	pCtx := p.buildContext(ctx, wl, assignment, snapshot)
+	targets := p.getTargets(ctx, p.getPreemptionStrategyIterator(ctx, pCtx))
+	if len(targets) > 0 || !pCtx.topologyBlocked {
+		return targets, nil
+	}
+	return nil, func(ctx context.Context) []*Target {
+		return p.topologyRetryTargets(ctx, pCtx)
+	}
+}
+
+// topologyRetryAttempt is one way the preemption algorithm may take victims:
+// the candidates it can preempt, and a strategy offering the preferred
+// candidates first while it rechecks every policy as victims are removed.
+type topologyRetryAttempt struct {
+	allowBorrowing bool
+	candidates     []*workload.Info
+	strategy       func(preferred sets.Set[*workload.Info]) PreemptionStrategy
+}
+
+// topologyRetryTargets takes victims by topology placement instead of by
+// priority alone. The ordinary attempts stop taking victims once each
+// borrowing queue is back at its nominal quota, which can leave the freed
+// capacity spread across topology domains. For the first attempt that frees a
+// placement, it returns the targets that cost the least: the lowest
+// highest-priority target first, then the lowest next-highest, and so on, then
+// the fewest targets.
+func (p *Preemptor) topologyRetryTargets(ctx context.Context, pCtx *preemptionCtx) []*Target {
+	log := log.FromContext(ctx)
+	var attempts []topologyRetryAttempt
+	if p.enableFairSharing {
+		attempts = fairTopologyRetryAttempts(ctx, p, pCtx, p.fsStrategies)
+	} else {
+		attempts = classicalTopologyRetryAttempts(ctx, p, pCtx)
+	}
+	for _, attempt := range attempts {
+		var best []*Target
+		var bestCost []int64
+		for _, placement := range topologyPlacements(ctx, pCtx, attempt.candidates, attempt.allowBorrowing) {
+			strategy := attempt.strategy(placement)
+			targets := p.getTargets(ctx, func(yield func(PreemptionStrategy) bool) { yield(strategy) })
+			if len(targets) == 0 {
+				continue
+			}
+			cost := make([]int64, 0, len(targets))
+			for _, target := range targets {
+				cost = append(cost, priority.EffectivePriority(log, target.WorkloadInfo.Obj))
+			}
+			slices.SortFunc(cost, func(a, b int64) int { return cmp.Compare(b, a) })
+			if best == nil || slices.Compare(cost, bestCost) < 0 {
+				best, bestCost = targets, cost
+			}
+		}
+		if best != nil {
+			return best
+		}
+	}
+	return nil
+}
+
+// topologyPlacements finds placements of the preemptor that become possible
+// once candidates are removed, and returns, for each placement, the candidates
+// occupying its topology domains. Each search puts the occupants of the
+// previous placements back, so the next placement lands in other domains. It
+// returns nothing when removing every candidate still leaves the quota short.
+// The placements only guide victim ordering: the strategies built from them
+// recheck every policy as victims are removed.
+func topologyPlacements(ctx context.Context, pCtx *preemptionCtx, candidates []*workload.Info, allowBorrowing bool) []sets.Set[*workload.Info] {
+	removed := slices.Clone(candidates)
+	for _, candidate := range removed {
+		pCtx.snapshot.RemoveWorkload(candidate)
+	}
+	defer func() {
+		for _, candidate := range removed {
+			pCtx.snapshot.AddWorkload(candidate)
+		}
+	}()
+	if !workloadQuotaFits(pCtx, allowBorrowing) {
+		return nil
+	}
+	candidateDomains := domainsByCandidate(candidates)
+	var placements []sets.Set[*workload.Info]
+	for len(placements) < maxTopologyPlacements && len(removed) > 0 {
+		assignments := pCtx.assignment.FindTopologyAssignments(ctx, pCtx.preemptorCQ, pCtx.tasRequests, schdcache.WithWorkloadInfo(&pCtx.preemptor))
+		if assignments.Failure() != nil {
+			break
+		}
+		occupants := candidatesInDomains(removed, candidateDomains, assignments)
+		if len(occupants) == 0 {
+			break
+		}
+		placements = append(placements, occupants)
+		removed = slices.DeleteFunc(removed, func(candidate *workload.Info) bool {
+			if !occupants.Has(candidate) {
+				return false
+			}
+			pCtx.snapshot.AddWorkload(candidate)
+			return true
+		})
+	}
+	return placements
+}
+
+// flavorDomain identifies a topology domain of a resource flavor.
+type flavorDomain struct {
+	flavor kueue.ResourceFlavorReference
+	domain utiltas.TopologyDomainID
+}
+
+// domainsByCandidate returns the topology domains each candidate uses.
+func domainsByCandidate(candidates []*workload.Info) map[*workload.Info][]flavorDomain {
+	domains := make(map[*workload.Info][]flavorDomain, len(candidates))
+	for _, candidate := range candidates {
+		for flavor, usage := range candidate.TASUsage() {
+			for _, domain := range usage {
+				domains[candidate] = append(domains[candidate], flavorDomain{flavor: flavor, domain: utiltas.DomainID(domain.Values)})
+			}
+		}
+	}
+	return domains
+}
+
+// candidatesInDomains returns the candidates that use any topology domain of
+// the given assignments.
+func candidatesInDomains(candidates []*workload.Info, candidateDomains map[*workload.Info][]flavorDomain, assignments schdcache.TASAssignmentsResult) sets.Set[*workload.Info] {
+	assigned := sets.New[flavorDomain]()
+	for _, assignment := range assignments {
+		for _, domain := range assignment.TopologyAssignment.Domains {
+			assigned.Insert(flavorDomain{flavor: assignment.Flavor, domain: utiltas.DomainID(domain.Values)})
+		}
+	}
+	occupants := sets.New[*workload.Info]()
+	for _, candidate := range candidates {
+		for _, domain := range candidateDomains[candidate] {
+			if assigned.Has(domain) {
+				occupants.Insert(candidate)
+				break
+			}
+		}
+	}
+	return occupants
+}
