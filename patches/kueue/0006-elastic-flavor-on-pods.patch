+
+// A worker group admitted with no workers moves to another flavor when it scales up, so
+// the flavor's node labels and tolerations go on each worker and never on the template.
+var _ = ginkgo.Describe("RayCluster elastic flavor change from zero", ginkgo.Label("job:ray", "area:jobs"), ginkgo.Ordered, ginkgo.ContinueOnFailure, func() {
+	const (
+		classLabel    = "example.com/class"
+		providerLabel = "example.com/provider"
+	)
+	var (
+		ns           *corev1.Namespace
+		local        *kueue.ResourceFlavor
+		remote       *kueue.ResourceFlavor
+		clusterQueue *kueue.ClusterQueue
+		localQueue   *kueue.LocalQueue
+	)
+	providerToleration := corev1.Toleration{
+		Key:      providerLabel,
+		Operator: corev1.TolerationOpEqual,
+		Value:    "remote",
+		Effect:   corev1.TaintEffectNoSchedule,
+	}
+
+	ginkgo.BeforeAll(func() {
+		features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+			features.ElasticJobsViaWorkloadSlices:                     true,
+			features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: true,
+		})
+		fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+	})
+	ginkgo.AfterAll(func() {
+		fwk.StopManager(ctx)
+	})
+
+	ginkgo.BeforeEach(func() {
+		ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "flavor-")
+
+		// "local" fits the head and three workers, "remote" fits eight workers.
+		local = utiltestingapi.MakeResourceFlavor("local").NodeLabel(classLabel, "test").Obj()
+		remote = utiltestingapi.MakeResourceFlavor("remote").
+			NodeLabel(classLabel, "test").
+			NodeLabel(providerLabel, "remote").
+			Toleration(providerToleration).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, local)
+		behavioral.MustCreate(ctx, k8sClient, remote)
+		clusterQueue = utiltestingapi.MakeClusterQueue("default").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas(local.Name).Resource(corev1.ResourceCPU, "1").Obj(),
+				*utiltestingapi.MakeFlavorQuotas(remote.Name).Resource(corev1.ResourceCPU, "2").Obj(),
+			).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+		localQueue = utiltestingapi.MakeLocalQueue("default", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+		behavioral.MustCreate(ctx, k8sClient, localQueue)
+	})
+	ginkgo.AfterEach(func() {
+		gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, local, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, remote, true)
+	})
+
+	ginkgo.It("Should add the new flavor's placement to each worker and keep it off the template", func() {
+		rayCluster := testingraycluster.MakeCluster("foo", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Queue(localQueue.Name).
+			RequestHead(corev1.ResourceCPU, "250m").
+			RequestWorkerGroup(corev1.ResourceCPU, "250m").
+			FirstWorkerGroupReplicas(0, 0, 8).
+			Obj()
+
+		ginkgo.By("admitting the worker group with no workers in the first flavor")
+		behavioral.MustCreate(ctx, k8sClient, rayCluster)
+		initial := &behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)[0]
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, initial, workersGroupName, 0)
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(initial), initial)).Should(gomega.Succeed())
+			g.Expect(workload.IsAdmitted(initial)).Should(gomega.BeTrue())
+			g.Expect(initial.Status.Admission.PodSetAssignments[workersPodSetIdx].Flavors).
+				Should(gomega.HaveKeyWithValue(corev1.ResourceCPU, kueue.ResourceFlavorReference(local.Name)))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("starting the cluster without the first flavor's placement on its templates")
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), rayCluster)).Should(gomega.Succeed())
+			g.Expect(rayCluster.Spec.Suspend).Should(gomega.Equal(new(false)))
+			for _, template := range []corev1.PodTemplateSpec{rayCluster.Spec.HeadGroupSpec.Template, rayCluster.Spec.WorkerGroupSpecs[0].Template} {
+				g.Expect(template.Spec.NodeSelector).ShouldNot(gomega.HaveKey(classLabel))
+				g.Expect(template.Spec.Tolerations).Should(gomega.BeEmpty())
+			}
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("scaling up to six workers, of which only three fit in the first flavor")
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), rayCluster)).Should(gomega.Succeed())
+			rayCluster.Spec.WorkerGroupSpecs[0].Replicas = new(int32(6))
+			g.Expect(k8sClient.Update(ctx, rayCluster)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("admitting all six in the next flavor")
+		moved := behavioral.ExpectNewWorkloadSlice(ctx, k8sClient, initial)
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, moved, workersGroupName, 6)
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(moved), moved)).Should(gomega.Succeed())
+			g.Expect(workload.IsAdmitted(moved)).Should(gomega.BeTrue())
+			g.Expect(moved.Status.Admission.PodSetAssignments[workersPodSetIdx].Flavors).
+				Should(gomega.HaveKeyWithValue(corev1.ResourceCPU, kueue.ResourceFlavorReference(remote.Name)))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("creating the gated workers the KubeRay controller would create, one with the first flavor's selector")
+		newWorker := func(name string, selector map[string]string) *corev1.Pod {
+			pod := testingpod.MakePod(name, ns.Name).
+				Annotation(kueue.WorkloadAnnotation, moved.Name).
+				Annotation(kueue.WorkloadSliceNameAnnotation, workloadslicing.SliceName(moved)).
+				Label(constants.PodSetLabel, workersGroupName).
+				Gate(kueue.ElasticJobSchedulingGate).
+				Obj()
+			pod.Spec.NodeSelector = selector
+			return pod
+		}
+		for i := range 6 {
+			behavioral.MustCreate(ctx, k8sClient, newWorker("worker-"+string(rune('a'+i)), nil))
+		}
+		stale := newWorker("worker-stale", map[string]string{classLabel: "test", providerLabel: "local"})
+		behavioral.MustCreate(ctx, k8sClient, stale)
+
+		ginkgo.By("recycling the worker whose selector conflicts with the new flavor")
+		gomega.Eventually(func(g gomega.Gomega) {
+			err := k8sClient.Get(ctx, client.ObjectKeyFromObject(stale), &corev1.Pod{})
+			g.Expect(apierrors.IsNotFound(err)).Should(gomega.BeTrue(), "worker-stale still exists: %v", err)
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("ungating each of the six workers with the new flavor's node labels and toleration")
+		gomega.Eventually(func(g gomega.Gomega) {
+			pods := &corev1.PodList{}
+			g.Expect(k8sClient.List(ctx, pods, client.InNamespace(ns.Name))).Should(gomega.Succeed())
+			g.Expect(pods.Items).Should(gomega.HaveLen(6))
+			for _, pod := range pods.Items {
+				g.Expect(pod.Spec.SchedulingGates).Should(gomega.BeEmpty(), pod.Name)
+				g.Expect(pod.Spec.NodeSelector).Should(gomega.Equal(map[string]string{classLabel: "test", providerLabel: "remote"}), pod.Name)
+				g.Expect(pod.Spec.Tolerations).Should(gomega.ContainElement(providerToleration), pod.Name)
+			}
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("keeping the placement off the template")
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), rayCluster)).Should(gomega.Succeed())
+		gomega.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Spec.NodeSelector).ShouldNot(gomega.HaveKey(providerLabel))
+		gomega.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Spec.Tolerations).Should(gomega.BeEmpty())
+	})
+})
