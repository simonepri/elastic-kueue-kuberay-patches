+func withSelector(pod *testingpod.PodWrapper, selector map[string]string) *testingpod.PodWrapper {
+	for key, value := range selector {
+		pod = pod.NodeSelector(key, value)
+	}
+	return pod
+}
+
+func TestFlavorPlacementOnPods(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	remoteToleration := corev1.Toleration{
+		Key:      "example.com/provider",
+		Operator: corev1.TolerationOpEqual,
+		Value:    "remote",
+		Effect:   corev1.TaintEffectNoSchedule,
+	}
+	remote := func() *utiltestingapi.ResourceFlavorWrapper {
+		return utiltestingapi.MakeResourceFlavor("remote").
+			NodeLabel("example.com/class", "test").
+			NodeLabel("example.com/provider", "remote").
+			Toleration(remoteToleration)
+	}
+	// The slice moved the PodSet to "remote"; its template is what the job's owner
+	// creates Pods from now.
+	workloadWith := func(templateSelector map[string]string) *kueue.Workload {
+		return utiltestingapi.MakeWorkload("wl", "ns").
+			Finalizers(kueue.ResourceInUseFinalizerName).
+			Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			ControllerReference(rayClusterGVK, "ray", "ray-uid").
+			PodSets(*utiltestingapi.MakePodSet(workersPodSet, 1).
+				Request(corev1.ResourceCPU, "1").
+				NodeSelector(templateSelector).
+				Obj()).
+			ReserveQuotaAt(
+				utiltestingapi.MakeAdmission("cq").
+					PodSets(utiltestingapi.MakePodSetAssignment(workersPodSet).
+						Assignment(corev1.ResourceCPU, "remote", "1").
+						Obj()).
+					Obj(), now,
+			).
+			AdmittedAt(true, now).
+			Obj()
+	}
+	gatedPod := func(selector map[string]string) *testingpod.PodWrapper {
+		return withSelector(makeElasticPodForPodSet("pod", workersPodSet), selector).
+			Gate(kueue.ElasticJobSchedulingGate)
+	}
+	ungatedOnRemote := func(selector map[string]string) corev1.Pod {
+		pod := withSelector(makeElasticPodForPodSet("pod", workersPodSet), selector).Obj()
+		pod.Spec.Tolerations = []corev1.Toleration{remoteToleration}
+		return *pod
+	}
+	onRemote := map[string]string{"example.com/class": "test", "example.com/provider": "remote"}
+	staleOnLocal := map[string]string{"example.com/class": "test", "example.com/provider": "local"}
+
+	testCases := map[string]struct {
+		gate      bool
+		workload  *kueue.Workload
+		pod       *corev1.Pod
+		wantPods  []corev1.Pod
+		wantError bool
+	}{
+		"add the node labels and tolerations of the PodSet's flavor before ungating": {
+			gate:     true,
+			workload: workloadWith(nil),
+			pod:      gatedPod(map[string]string{"example.com/class": "test"}).Obj(),
+			wantPods: []corev1.Pod{ungatedOnRemote(onRemote)},
+		},
+		"add them to a pod whose template carried no placement": {
+			gate:     true,
+			workload: workloadWith(nil),
+			pod:      gatedPod(nil).Obj(),
+			wantPods: []corev1.Pod{ungatedOnRemote(onRemote)},
+		},
+		"leave the placement to the template with the gate off": {
+			workload: workloadWith(nil),
+			pod:      gatedPod(nil).Obj(),
+			wantPods: []corev1.Pod{*makeElasticPodForPodSet("pod", workersPodSet).Obj()},
+		},
+		"delete a gated pod whose template carried the first flavor's selector, so the owner recreates it": {
+			gate:     true,
+			workload: workloadWith(nil),
+			pod:      gatedPod(staleOnLocal).Obj(),
+		},
+		"keep a gated pod when the template still conflicts, so the owner would recreate the same pod": {
+			gate:     true,
+			workload: workloadWith(staleOnLocal),
+			pod:      gatedPod(staleOnLocal).Obj(),
+			wantPods: []corev1.Pod{*gatedPod(staleOnLocal).Obj()},
+		},
+		"ungate a pod with the first flavor's selector unchanged with the gate off": {
+			workload: workloadWith(nil),
+			pod:      gatedPod(staleOnLocal).Obj(),
+			wantPods: []corev1.Pod{*withSelector(makeElasticPodForPodSet("pod", workersPodSet), staleOnLocal).Obj()},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, tc.gate)
+			ctx, _ := utiltesting.ContextWithLog(t)
+
+			kClient := utiltesting.NewClientBuilder().
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+				WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(rayClusterGVK), coreindexer.WorkloadOwnerIndexFunc(rayClusterGVK)).
+				WithIndex(&kueue.Workload{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexWorkloadSliceName).
+				WithInterceptorFuncs(interceptor.Funcs{
+					Patch: func(ctx context.Context, clnt client.WithWatch, obj client.Object, _ client.Patch, _ ...client.PatchOption) error {
+						return clnt.Update(ctx, obj)
+					},
+				}).
+				WithObjects(remote().Obj(), tc.pod).
+				WithStatusSubresource(tc.workload).
+				Build()
+			if err := kClient.Create(ctx, tc.workload); err != nil {
+				t.Fatalf("Could not create workload: %v", err)
+			}
+			ungater := &elasticJobUngater{
+				client:            kClient,
+				clock:             testingclock.NewFakeClock(now),
+				expectationsStore: expectations.NewStore(ControllerName),
+			}
+			if _, err := ungater.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(tc.workload)}); err != nil {
+				t.Fatalf("Reconcile returned error: %v", err)
+			}
+			var gotPods corev1.PodList
+			if err := kClient.List(ctx, &gotPods); err != nil {
+				t.Fatalf("Could not list pods: %v", err)
+			}
+			if diff := gocmp.Diff(tc.wantPods, gotPods.Items, podCmpOpts...); diff != "" {
+				t.Errorf("Pods after reconcile (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
