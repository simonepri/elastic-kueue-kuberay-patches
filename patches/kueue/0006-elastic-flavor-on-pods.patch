+func TestDeferFlavorPlacementToPods(t *testing.T) {
+	provider := corev1.Toleration{Key: "example.com/provider", Operator: corev1.TolerationOpEqual, Value: "remote", Effect: corev1.TaintEffectNoSchedule}
+	other := corev1.Toleration{Key: "example.com/other", Operator: corev1.TolerationOpExists}
+	flavor := utiltestingapi.MakeResourceFlavor("remote").
+		NodeLabel("example.com/class", "test").
+		NodeLabel("example.com/provider", "remote").
+		Toleration(provider).
+		Obj()
+	newWorkload := func(elastic, gatedTemplate bool) *kueue.Workload {
+		podSet := utiltestingapi.MakePodSet("workers", 1)
+		if gatedTemplate {
+			podSet = podSet.SchedulingGates(corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate})
+		}
+		wl := utiltestingapi.MakeWorkload("wl", "ns").
+			PodSets(*podSet.Obj()).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").
+				PodSets(utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "remote", "1").Obj()).
+				Obj(), time.Now()).
+			AdmissionChecks(kueue.AdmissionCheckState{
+				Name: "check",
+				PodSetUpdates: []kueue.PodSetUpdate{{
+					Name:         "workers",
+					NodeSelector: map[string]string{"example.com/check": "yes"},
+				}},
+			}).
+			Obj()
+		if elastic {
+			wl.Annotations = map[string]string{workloadslicing.EnabledAnnotationKey: workloadslicing.EnabledAnnotationValue}
+		}
+		return wl
+	}
+	newInfo := func() []podset.PodSetInfo {
+		return []podset.PodSetInfo{{
+			Name: "workers",
+			NodeSelector: map[string]string{
+				"example.com/class":    "test",
+				"example.com/provider": "remote",
+				"example.com/check":    "yes",
+			},
+			Tolerations: []corev1.Toleration{provider, other},
+		}}
+	}
+	cases := map[string]struct {
+		gate         bool
+		elastic      bool
+		marker       bool
+		notGated     bool
+		want         podset.PodSetInfo
+		wantDeferred bool
+	}{
+		"remove the flavor's node labels and tolerations, keeping the admission checks'": {
+			gate:         true,
+			elastic:      true,
+			wantDeferred: true,
+			want: podset.PodSetInfo{
+				Name:         "workers",
+				NodeSelector: map[string]string{"example.com/check": "yes"},
+				Tolerations:  []corev1.Toleration{other},
+			},
+		},
+		"keep removing them with the gate off for a Workload marked as started with it on": {
+			elastic:      true,
+			marker:       true,
+			wantDeferred: true,
+			want: podset.PodSetInfo{
+				Name:         "workers",
+				NodeSelector: map[string]string{"example.com/check": "yes"},
+				Tolerations:  []corev1.Toleration{other},
+			},
+		},
+		"keep them with the gate off":                                   {elastic: true, want: newInfo()[0]},
+		"keep them for a PodSet whose Pods the ungater does not handle": {gate: true, elastic: true, notGated: true, want: newInfo()[0]},
+		"keep them for a workload that is not elastic":                  {gate: true, want: newInfo()[0]},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, tc.gate)
+			cl := utiltesting.NewClientBuilder(kueue.AddToScheme).WithObjects(flavor).Build()
+			info := newInfo()
+			wl := newWorkload(tc.elastic, !tc.notGated)
+			if tc.marker {
+				wl.Annotations[workloadslicing.FlavorPlacementOnPodsAnnotation] = "true"
+			}
+			deferred, err := deferFlavorPlacementToPods(t.Context(), cl, wl, info)
+			if err != nil {
+				t.Fatalf("deferFlavorPlacementToPods() error: %v", err)
+			}
+			if deferred != tc.wantDeferred {
+				t.Errorf("deferFlavorPlacementToPods() = %v, want %v", deferred, tc.wantDeferred)
+			}
+			if diff := cmp.Diff(tc.want, info[0], cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("PodSetInfo mismatch (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
