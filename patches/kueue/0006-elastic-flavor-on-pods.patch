+// deferFlavorPlacementToPods removes the node labels and tolerations of the
+// assigned ResourceFlavors from info when the ElasticJobUngater adds them to
+// each Pod instead (ElasticJobsViaWorkloadSlicesFlavorChangeFromZero). A
+// PodSet admitted with no Pods may move to another flavor when it scales up,
+// and a Pod can only gain nodeSelector keys while it is gated, so placement
+// baked into the job template by the first admission would conflict with the
+// new flavor's. Selectors and tolerations from admission checks stay in info.
+func deferFlavorPlacementToPods(ctx context.Context, c client.Client, wl *kueue.Workload, info []podset.PodSetInfo) error {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero) || !workloadslicing.IsElasticWorkload(wl) {
+		return nil
+	}
+	baseByName, err := flavorInfoByPodSet(ctx, c, wl)
+	if err != nil {
+		return err
+	}
+	for i := range info {
+		base, found := baseByName[info[i].Name]
+		if !found {
+			continue
+		}
