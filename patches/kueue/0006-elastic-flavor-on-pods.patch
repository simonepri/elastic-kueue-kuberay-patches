+// FlavorPlacementOnPodsAnnotation marks a Workload whose job was started with the flavors'
+// node labels and tolerations kept off its templates. Every slice of the chain carries it.
+const FlavorPlacementOnPodsAnnotation = "kueue.x-k8s.io/flavor-placement-on-pods"
+
+// FlavorPlacementOnPods reports whether the ElasticJobUngater, and not the job template,
+// owns the flavor placement of the elastic Workload's Pods. It does so with
+// ElasticJobsViaWorkloadSlicesFlavorChangeFromZero on, and for a chain started with it on
+// even after the gate is turned off, because its templates have no placement to fall back on.
+func FlavorPlacementOnPods(wl *kueue.Workload) bool {
+	if !IsElasticWorkload(wl) {
+		return false
+	}
+	return features.Enabled(features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero) ||
+		wl.Annotations[FlavorPlacementOnPodsAnnotation] == "true"
+}
