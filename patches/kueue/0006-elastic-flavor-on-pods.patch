+// The job template of an elastic workload started with the gate on carries no
+// flavor placement, so the expected running PodSets must not either.
+func TestExpectedRunningPodSetsDefersFlavorPlacement(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, true)
+	flavor := utiltestingapi.MakeResourceFlavor("remote").
+		NodeLabel("example.com/provider", "remote").
+		Toleration(corev1.Toleration{Key: "example.com/provider", Operator: corev1.TolerationOpExists}).
+		Obj()
+	wl := utiltestingapi.MakeWorkload("wl", "ns").
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		PodSets(*utiltestingapi.MakePodSet("workers", 1).SchedulingGates(corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}).Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").
+			PodSets(utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "remote", "1").Obj()).
+			Obj(), time.Now()).
+		Obj()
+	cl := utiltesting.NewClientBuilder(kueue.AddToScheme).WithObjects(flavor).Build()
+
+	got := expectedRunningPodSets(t.Context(), cl, wl)
+	if len(got) != 1 {
+		t.Fatalf("expectedRunningPodSets() returned %d PodSets, want 1", len(got))
+	}
+	if len(got[0].Template.Spec.Tolerations) != 0 || len(got[0].Template.Spec.NodeSelector) != 0 {
+		t.Errorf("running PodSet carries flavor placement: nodeSelector=%v tolerations=%v",
+			got[0].Template.Spec.NodeSelector, got[0].Template.Spec.Tolerations)
+	}
+}
+
+func TestMarkFlavorPlacementOnPods(t *testing.T) {
+	gate := corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}
+	build := func(gated bool) *kueue.Workload {
+		podSet := utiltestingapi.MakePodSet("workers", 1)
+		if gated {
+			podSet = podSet.SchedulingGates(gate)
+		}
+		return utiltestingapi.MakeWorkload("wl", "ns").
+			Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			PodSets(*podSet.Obj()).
+			Obj()
+	}
+	cases := map[string]struct {
+		gate  bool
+		gated bool
+		want  bool
+	}{
+		"mark a Workload with a gated PodSet when the gate is on": {gate: true, gated: true, want: true},
+		"leave a Workload without a gated PodSet alone":           {gate: true},
+		"leave a Workload alone with the gate off":                {gated: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, tc.gate)
+			wl := build(tc.gated)
+			markFlavorPlacementOnPods(wl)
+			if got := wl.Annotations[workloadslicing.FlavorPlacementOnPodsAnnotation] == "true"; got != tc.want {
+				t.Errorf("marker = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
