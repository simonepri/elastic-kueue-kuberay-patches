+			if info[i].NodeSelector[key] == value {
+				delete(info[i].NodeSelector, key)
+			}
+		}
+		info[i].Tolerations = slices.Pick(info[i].Tolerations, func(t *corev1.Toleration) bool {
+			for j := range base.Tolerations {
+				if base.Tolerations[j].MatchToleration(t) {
+					return false
+				}
+			}
+			return true
+		})
+	}
+	return nil
+}
+
+// flavorInfoByPodSet returns, by PodSet name, the placement the ResourceFlavors
+// assigned to each PodSet of wl contribute.
+func flavorInfoByPodSet(ctx context.Context, c client.Client, wl *kueue.Workload) (map[kueue.PodSetReference]podset.PodSetInfo, error) {
+	assignments, err := podSetAssignmentsInSpecOrder(wl)
+	if err != nil {
+		return nil, err
+	}
+	baseByName := make(map[kueue.PodSetReference]podset.PodSetInfo, len(assignments))
+	for i := range assignments {
+		base, err := podset.FromAssignment(ctx, c, &assignments[i], &wl.Spec.PodSets[i])
+		if err != nil {
+			return nil, err
+		}
+		baseByName[base.Name] = base
+	}
+	return baseByName, nil
+}
