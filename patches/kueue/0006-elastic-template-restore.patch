+// podSetsInfoForTemplates returns the PodSet info from wl's admission that
+// Kueue merges into the job's pod templates.
+func (r *JobReconciler) podSetsInfoForTemplates(ctx context.Context, wl *kueue.Workload) ([]podset.PodSetInfo, error) {
+	info, err := getPodSetsInfoFromStatus(ctx, r.client, wl, r.podsScheduledTrackingEnabled())
+	if err != nil {
+		return nil, err
+	}
+	if workloadslicing.IsEnabledForProvisioningRequests(wl) {
+		if err := deferAdmissionCheckNodeSelectorsToPods(ctx, r.client, wl, info); err != nil {
+			return nil, err
+		}
+	}
+	return info, nil
+}
+
+// restoreElasticPodTemplates merges wl's PodSet info back into the pod
+// templates of a running elastic job that lost it, as when a client re-applies
+// the job's manifest and replaces its templates. Once the templates carry it
+// again, it deletes the gated Pods created from the stripped templates: the
+// ElasticJobUngater finds Pods only by the PodSet info, so those Pods would
+// stay gated while wl holds their quota, and having never been scheduled they
+// lose no work when the job recreates them. It returns whether it updated the
+// job.
+func (r *JobReconciler) restoreElasticPodTemplates(ctx context.Context, job GenericJob, wl *kueue.Workload) (bool, error) {
+	restorer, ok := job.(JobWithPodTemplateRestore)
+	if !ok {
+		return false, nil
+	}
+	info, err := r.podSetsInfoForTemplates(ctx, wl)
+	if err != nil {
+		return false, err
+	}
+	object := job.Object()
+	restored := false
+	if err := clientutil.Patch(ctx, r.client, object, func() (bool, error) {
+		var err error
+		restored, err = restorer.RestorePodTemplates(ctx, info)
+		return restored, err
+	}); err != nil {
+		return false, err
+	}
+	if restored {
+		ctrl.LoggerFrom(ctx).V(2).Info("Restored the admitted PodSet info on the pod templates of a running elastic job")
+		return true, nil
+	}
+	return false, r.deleteStaleElasticPods(ctx, job)
+}
+
+// deleteStaleElasticPods deletes the job's Pods that wait on the elastic job
+// scheduling gate without the constants.PodSetLabel.
+func (r *JobReconciler) deleteStaleElasticPods(ctx context.Context, job GenericJob) error {
+	selectorJob, ok := job.(JobWithPodLabelSelector)
+	if !ok {
+		return nil
+	}
+	selector, err := labels.Parse(selectorJob.PodLabelSelector())
+	if err != nil {
+		return err
+	}
+	object := job.Object()
+	var pods corev1.PodList
+	if err := r.client.List(ctx, &pods, client.InNamespace(object.GetNamespace()), client.MatchingLabelsSelector{Selector: selector}); err != nil {
+		return err
+	}
+	for i := range pods.Items {
+		pod := &pods.Items[i]
+		if !metav1.IsControlledBy(pod, object) || !pod.DeletionTimestamp.IsZero() ||
+			!utilpod.HasGate(pod, kueue.ElasticJobSchedulingGate) {
+			continue
+		}
+		if _, found := pod.Labels[constants.PodSetLabel]; found {
+			continue
+		}
+		ctrl.LoggerFrom(ctx).V(2).Info("Deleting an elastic Pod created from a pod template without the admitted PodSet info", "pod", klog.KObj(pod))
+		if err := r.client.Delete(ctx, pod); client.IgnoreNotFound(err) != nil {
+			return err
+		}
+	}
+	return nil
+}
