+// RestorePodTemplates merges podSetsInfo into the head and worker templates
+// that lack the constants.PodSetLabel, leaving replicas and suspension as they are.
+func (j *RayCluster) RestorePodTemplates(ctx context.Context, podSetsInfo []podset.PodSetInfo) (bool, error) {
+	if expectedLen := ExpectedPodSetsCount(&j.Spec); len(podSetsInfo) != expectedLen {
+		return false, podset.BadPodSetsInfoLenError(expectedLen, len(podSetsInfo))
+	}
+	templates := []*corev1.PodTemplateSpec{&j.Spec.HeadGroupSpec.Template}
+	for i := range j.Spec.WorkerGroupSpecs {
+		templates = append(templates, &j.Spec.WorkerGroupSpecs[i].Template)
+	}
+	changed := false
+	for i, template := range templates {
+		if _, found := template.Labels[constants.PodSetLabel]; found {
+			continue
+		}
+		if err := podset.Merge(ctrl.LoggerFrom(ctx), &template.ObjectMeta, &template.Spec, podSetsInfo[i]); err != nil {
+			return false, err
+		}
+		jobframework.DefaultPodIndexOffsetForPodSetGroup(&template.ObjectMeta)
+		changed = true
+	}
+	return changed, nil
+}
