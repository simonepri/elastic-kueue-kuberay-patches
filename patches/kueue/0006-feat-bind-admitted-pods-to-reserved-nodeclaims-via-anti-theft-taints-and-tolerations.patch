+// Tests deferral of Karpenter anti-theft placement to ungated pods for elastic job templates.
+package jobframework
+
+import (
+	"testing"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/podset"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+func TestKarpenterPlacementStaysOffElasticTemplates(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.KarpenterAdmissionCheck, true)
+	taint := corev1.Toleration{Key: constants.KarpenterAntiTheftTaintKey, Operator: corev1.TolerationOpEqual, Value: "slice-1", Effect: corev1.TaintEffectNoSchedule}
+	for name, tc := range map[string]struct {
+		gated, userPlacement bool
+		wantDeferred         bool
+	}{
+		"elastic workers":                      {gated: true, wantDeferred: true},
+		"ordinary head":                        {},
+		"explicit user placement is preserved": {gated: true, userPlacement: true},
+	} {
+		t.Run(name, func(t *testing.T) {
+			ps := utiltestingapi.MakePodSet("workers", 1).Request(corev1.ResourceCPU, "1").Obj()
+			if tc.gated {
+				ps.Template.Spec.SchedulingGates = []corev1.PodSchedulingGate{{Name: kueue.ElasticJobSchedulingGate}}
+			}
+			if tc.userPlacement {
+				ps.Template.Spec.NodeSelector = map[string]string{constants.KarpenterAttemptLabel: "attempt-1"}
+				ps.Template.Spec.Tolerations = []corev1.Toleration{taint}
+			}
+			update := kueue.PodSetUpdate{Name: ps.Name, NodeSelector: map[string]string{constants.KarpenterAttemptLabel: "attempt-1"}, Tolerations: []corev1.Toleration{taint}}
+			wl := utiltestingapi.MakeWorkload("slice-1", "ns").PodSets(*ps).ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(utiltestingapi.MakePodSetAssignment(ps.Name).Flavor(corev1.ResourceCPU, "pool").Count(1).Obj()).Obj(), time.Now()).
+				AdmissionCheck(kueue.AdmissionCheckState{Name: "karpenter", State: kueue.CheckStateReady, PodSetUpdates: []kueue.PodSetUpdate{update}}).Obj()
+			info := []podset.PodSetInfo{{Name: ps.Name, NodeSelector: map[string]string{constants.KarpenterAttemptLabel: "attempt-1", "stable": "pool"}, Tolerations: []corev1.Toleration{taint}}}
+			deferKarpenterPlacementToPods(wl, info)
+			_, hasAttempt := info[0].NodeSelector[constants.KarpenterAttemptLabel]
+			if hasAttempt == tc.wantDeferred || (len(info[0].Tolerations) == 0) != tc.wantDeferred || info[0].NodeSelector["stable"] != "pool" {
+				t.Fatalf("unexpected template placement: %+v", info[0])
+			}
+			// Workload/job equivalence must expect the same placement startJob applies.
+			cl := utiltesting.NewClientBuilder().WithObjects(utiltestingapi.MakeResourceFlavor("pool").NodeLabel("stable", "pool").Obj()).Build()
+			expected := expectedRunningPodSets(t.Context(), cl, wl)
+			if len(expected) != 1 {
+				t.Fatalf("got %d expected PodSets, want 1", len(expected))
+			}
+			_, hasAttempt = expected[0].Template.Spec.NodeSelector[constants.KarpenterAttemptLabel]
+			if hasAttempt == tc.wantDeferred {
+				t.Fatalf("equivalence expects per-attempt placement: %+v", expected[0])
+			}
+		})
+	}
+}
