+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingpod "sigs.k8s.io/kueue/pkg/util/testingjobs/pod"
+	testingraycluster "sigs.k8s.io/kueue/pkg/util/testingjobs/raycluster"
+	workloadpatching "sigs.k8s.io/kueue/pkg/workload/patching"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+	"sigs.k8s.io/kueue/test/util/behavioral"
+)
+
+var _ = ginkgo.Describe("RayCluster elastic workers and admission check pod set updates", ginkgo.Label("job:ray", "area:jobs"), func() {
+	ginkgo.It("gives a gated worker the node selector and tolerations of the check before it starts", func() {
+		features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+			features.ElasticJobsViaWorkloadSlices: true,
+			features.KarpenterAdmissionCheck:      true,
+		})
+		fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+		ginkgo.DeferCleanup(func() { fwk.StopManager(ctx) })
+		ns := behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "check-tolerations-")
+		flavor := utiltestingapi.MakeResourceFlavor("default").Obj()
+		check := utiltestingapi.MakeAdmissionCheck("check").ControllerName("example.com/check").Obj()
+		behavioral.MustCreate(ctx, k8sClient, flavor)
+		behavioral.MustCreate(ctx, k8sClient, check)
+		behavioral.SetAdmissionCheckActive(ctx, k8sClient, check, metav1.ConditionTrue)
+		cq := utiltestingapi.MakeClusterQueue("check-tolerations").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas(flavor.Name).Resource(corev1.ResourceCPU, "10").Obj()).
+			AdmissionChecks("check").Obj()
+		behavioral.MustCreate(ctx, k8sClient, cq)
+		lq := utiltestingapi.MakeLocalQueue("queue", ns.Name).ClusterQueue(cq.Name).Obj()
+		behavioral.MustCreate(ctx, k8sClient, lq)
+		ginkgo.DeferCleanup(func() {
+			gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, cq, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, lq, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, check, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, flavor, true)
+		})
+
+		rc := testingraycluster.MakeCluster("checked", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Queue(lq.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			FirstWorkerGroupReplicas(2, 0, 4).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, rc)
+		wl := &behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)[0]
+
+		toleration := corev1.Toleration{Key: "example.com/claimed-by", Operator: corev1.TolerationOpEqual, Value: wl.Name, Effect: corev1.TaintEffectNoSchedule}
+		pod := testingpod.MakePod("worker", ns.Name).
+			Annotation(kueue.WorkloadAnnotation, wl.Name).
+			Annotation(kueue.WorkloadSliceNameAnnotation, workloadslicing.SliceName(wl)).
+			Label(constants.PodSetLabel, workersGroupName).
+			Gate(kueue.ElasticJobSchedulingGate).
+			Obj()
+		pod.OwnerReferences = []metav1.OwnerReference{{
+			APIVersion: rayv1.SchemeGroupVersion.String(), Kind: "RayCluster", Name: rc.Name, UID: rc.UID, Controller: new(true),
+		}}
+		behavioral.MustCreate(ctx, k8sClient, pod)
+
+		gomega.Eventually(func(g gomega.Gomega) {
+			var latest kueue.Workload
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), &latest)).To(gomega.Succeed())
+			workloadpatching.SetAdmissionCheckState(&latest.Status.AdmissionChecks, kueue.AdmissionCheckState{
+				Name:  "check",
+				State: kueue.CheckStateReady,
+				PodSetUpdates: []kueue.PodSetUpdate{{
+					Name:         workersGroupName,
+					NodeSelector: map[string]string{"example.com/attempt": "attempt-1"},
+					Tolerations:  []corev1.Toleration{toleration},
+				}},
+			}, behavioral.RealClock)
+			g.Expect(k8sClient.Status().Update(ctx, &latest)).To(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		gomega.Eventually(func(g gomega.Gomega) {
+			var got corev1.Pod
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(pod), &got)).To(gomega.Succeed())
+			g.Expect(utilpod.HasGate(&got, kueue.ElasticJobSchedulingGate)).To(gomega.BeFalse())
+			g.Expect(got.Spec.NodeSelector).To(gomega.HaveKeyWithValue("example.com/attempt", "attempt-1"))
+			g.Expect(got.Spec.Tolerations).To(gomega.ContainElement(toleration))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	})
+})
