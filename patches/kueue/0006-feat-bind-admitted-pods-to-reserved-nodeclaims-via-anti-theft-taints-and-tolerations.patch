+// Defers Karpenter anti-theft placement to ungated pods so elastic job templates do not retain stale selectors.
+package jobframework
+
+import (
+	"slices"
+
+	corev1 "k8s.io/api/core/v1"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/podset"
+)
+
+// A long-lived elastic template must not retain the first slice's claim selector
+// or toleration. The ungater already applies Ready PodSetUpdates to each pod.
+// Keep user-supplied placement and ordinary, ungated PodSets on their normal path.
+func deferKarpenterPlacementToPods(wl *kueue.Workload, info []podset.PodSetInfo) {
+	if !features.Enabled(features.KarpenterAdmissionCheck) {
+		return
+	}
+	for _, ps := range wl.Spec.PodSets {
+		if !slices.ContainsFunc(ps.Template.Spec.SchedulingGates, func(g corev1.PodSchedulingGate) bool { return g.Name == kueue.ElasticJobSchedulingGate }) {
+			continue
+		}
+		for i := range info {
+			if info[i].Name != ps.Name {
+				continue
+			}
+			for _, check := range wl.Status.AdmissionChecks {
+				if check.State != kueue.CheckStateReady {
+					continue
+				}
+				for _, update := range check.PodSetUpdates {
+				if update.Name != ps.Name || update.NodeSelector[constants.KarpenterAttemptLabel] == "" {
+					continue
+				}
+				if _, supplied := ps.Template.Spec.NodeSelector[constants.KarpenterAttemptLabel]; !supplied {
+					delete(info[i].NodeSelector, constants.KarpenterAttemptLabel)
+				}
+				info[i].Tolerations = slices.DeleteFunc(info[i].Tolerations, func(t corev1.Toleration) bool {
+					if t.Key != constants.KarpenterAntiTheftTaintKey {
+						return false
+					}
+					supplied := slices.ContainsFunc(ps.Template.Spec.Tolerations, func(user corev1.Toleration) bool { return t.MatchToleration(&user) })
+					injected := slices.ContainsFunc(update.Tolerations, func(added corev1.Toleration) bool { return t.MatchToleration(&added) })
+					return injected && !supplied
+				})
+			}
+			}
+		}
+	}
+}
