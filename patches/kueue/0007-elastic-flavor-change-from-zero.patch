+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/component-base/featuregate"
+	testingclock "k8s.io/utils/clock/testing"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// TestScheduleElasticSliceFlavor covers the flavor a scale-up slice gets with the
+// default feature gates: a PodSet that had no pods in the replaced slice is
+// assigned like a new workload, so a later flavor that fits every pod wins over
+// partial admission in the flavor chosen while the PodSet was empty, and a
+// PodSet with pods stays in its flavor.
+func TestScheduleElasticSliceFlavor(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	gates := map[featuregate.Feature]bool{features.ElasticJobsViaWorkloadSlices: true}
+	assignment := func(flavor, cpu string, count int32) kueue.Admission {
+		return *utiltestingapi.MakeAdmission("cq").
+			PodSets(utiltestingapi.MakePodSetAssignment("workers").
+				Assignment(corev1.ResourceCPU, kueue.ResourceFlavorReference(flavor), cpu).
+				Count(count).
+				Obj()).
+			Obj()
+	}
+	admitted := func(wl *utiltestingapi.WorkloadWrapper, flavor, cpu string, count int32) *utiltestingapi.WorkloadWrapper {
+		admission := assignment(flavor, cpu, count)
+		return wl.
+			Admission(&admission).
+			Condition(metav1.Condition{
+				Type:               kueue.WorkloadQuotaReserved,
+				Status:             metav1.ConditionTrue,
+				Reason:             kueue.WorkloadQuotaReserved,
+				Message:            "Quota reserved in ClusterQueue cq",
+				ObservedGeneration: 1,
+				LastTransitionTime: metav1.NewTime(now),
+			}).
+			Condition(metav1.Condition{
+				Type:               kueue.WorkloadAdmitted,
+				Status:             metav1.ConditionTrue,
+				Reason:             kueue.WorkloadAdmitted,
+				Message:            "The workload is admitted",
+				ObservedGeneration: 1,
+				LastTransitionTime: metav1.NewTime(now),
+			})
+	}
+	replaced := metav1.Condition{
+		Type:               kueue.WorkloadFinished,
+		Status:             metav1.ConditionTrue,
+		Reason:             kueue.WorkloadSliceReplaced,
+		Message:            "Replaced to accommodate a workload (UID: , JobUID: ) due to workload slice aggregation",
+		ObservedGeneration: 1,
+		LastTransitionTime: metav1.NewTime(now),
+	}
+	slice := func(name string, count int, minCount int32) *utiltestingapi.WorkloadWrapper {
+		wl := utiltestingapi.MakeWorkload(name, "default").
+			Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			ResourceVersion("1").
+			Queue("lq").
+			PodSets(*utiltestingapi.MakePodSet("workers", count).
+				SetMinimumCount(minCount).
+				Request(corev1.ResourceCPU, "1").
+				Obj()).
+			Generation(1)
+		if name != "old" {
+			wl.Annotation(workloadslicing.WorkloadSliceReplacementFor, "default/old")
+		}
+		return wl
+	}
+	cases := map[string]scheduleTestCase{
+		"a slice replacing a PodSet with no pods gets all its pods in a later flavor instead of part of them in the empty PodSet's flavor": {
+			featureGates: gates,
+			workloads: []kueue.Workload{
+				*admitted(slice("old", 0, 0), "small", "0", 0).Obj(),
+				*slice("new", 5, 0).Obj(),
+			},
+			wantAssignments: map[workload.Reference]kueue.Admission{
+				"default/old": assignment("small", "0", 0),
+				"default/new": assignment("large", "5", 5),
+			},
+			wantWorkloads: []kueue.Workload{
+				*admitted(slice("new", 5, 0), "large", "5", 5).Obj(),
+				*admitted(slice("old", 0, 0), "small", "0", 0).Condition(replaced).Obj(),
+			},
+		},
+		"a slice replacing a PodSet with pods stays in its flavor and is partially admitted there": {
+			featureGates: gates,
+			workloads: []kueue.Workload{
+				*admitted(slice("old", 1, 1), "small", "1", 1).Obj(),
+				*slice("new", 5, 1).Obj(),
+			},
+			wantAssignments: map[workload.Reference]kueue.Admission{
+				"default/old": assignment("small", "1", 1),
+				"default/new": assignment("small", "2", 2),
+			},
+			wantWorkloads: []kueue.Workload{
+				*admitted(slice("new", 5, 1), "small", "2", 2).Obj(),
+				*admitted(slice("old", 1, 1), "small", "1", 1).Condition(replaced).Obj(),
+			},
+		},
+	}
+	runScheduleTestCases(t, scheduleTestConfig{
+		queues: []kueue.LocalQueue{*utiltestingapi.MakeLocalQueue("lq", "default").ClusterQueue("cq").Obj()},
+		clusterQueues: []kueue.ClusterQueue{*utiltestingapi.MakeClusterQueue("cq").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("small").Resource(corev1.ResourceCPU, "2").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("large").Resource(corev1.ResourceCPU, "10").Obj(),
+			).
+			Obj()},
+		resourceFlavors: []*kueue.ResourceFlavor{
+			utiltestingapi.MakeResourceFlavor("small").Obj(),
+			utiltestingapi.MakeResourceFlavor("large").Obj(),
+		},
+		fakeClock: testingclock.NewFakeClock(now),
+	}, cases)
+}
