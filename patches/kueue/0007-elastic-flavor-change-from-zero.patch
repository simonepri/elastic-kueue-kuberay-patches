+		return fmt.Errorf("reading the ResourceFlavors of PodSet %q: %w", podSetName, err)
+	}
+	utilmaps.Copy(&update.nodeSelector, info.NodeSelector)
+	update.tolerations = info.Tolerations
+	return nil
