+// Re-applying the manifest replaces the atomic workerGroupSpecs list, which drops what Kueue
+// stamped on the templates, and every worker KubeRay creates from them afterwards must still
+// be ungated: up to the admitted count, and never beyond it.
+var _ = ginkgo.Describe("RayCluster elastic template re-apply", ginkgo.Label("job:ray", "area:jobs"), ginkgo.Ordered, ginkgo.ContinueOnFailure, func() {
+	var (
+		ns             *corev1.Namespace
+		resourceFlavor *kueue.ResourceFlavor
+		clusterQueue   *kueue.ClusterQueue
+		localQueue     *kueue.LocalQueue
+	)
+
+	ginkgo.BeforeAll(func() {
+		features.SetFeatureGateDuringTest(ginkgo.GinkgoTB(), features.ElasticJobsViaWorkloadSlices, true)
+		fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+	})
+	ginkgo.AfterAll(func() {
+		fwk.StopManager(ctx)
+	})
+
+	ginkgo.BeforeEach(func() {
+		ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "reapply-")
+		resourceFlavor = utiltestingapi.MakeResourceFlavor("default").Obj()
+		behavioral.MustCreate(ctx, k8sClient, resourceFlavor)
+		clusterQueue = utiltestingapi.MakeClusterQueue("default").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas(resourceFlavor.Name).Resource(corev1.ResourceCPU, "10").Obj()).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+		localQueue = utiltestingapi.MakeLocalQueue("default", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+		behavioral.MustCreate(ctx, k8sClient, localQueue)
+	})
+	ginkgo.AfterEach(func() {
+		gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, resourceFlavor, true)
+	})
+
+	const workerGroup = "workers-group-0"
+	// newManifest is what a user keeps in Git: the elastic gate in every template, which the
+	// RayCluster validation requires, and nothing Kueue stamps when it starts the cluster.
+	newManifest := func() *rayv1.RayCluster {
+		return testingraycluster.MakeCluster("foo", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Queue(localQueue.Name).
+			Request(rayv1.HeadNode, corev1.ResourceCPU, "1").
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			FirstWorkerGroupReplicas(2, 0, 8).
+			SchedulingGate(kueue.ElasticJobSchedulingGate).
+			Obj()
+	}
+
+	ginkgo.It("Should accept a re-applied manifest that has no elastic gate and put the gate back", func() {
+		manifest := newManifest()
+		behavioral.MustCreate(ctx, k8sClient, manifest.DeepCopy())
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), manifest)).Should(gomega.Succeed())
+			g.Expect(manifest.Spec.Suspend).Should(gomega.Equal(new(false)))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("re-applying a manifest without the gate")
+		ungatedManifest := newManifest()
+		ungatedManifest.Spec.HeadGroupSpec.Template.Spec.SchedulingGates = nil
+		ungatedManifest.Spec.WorkerGroupSpecs[0].Template.Spec.SchedulingGates = nil
+		gomega.Expect(k8sClient.Patch(ctx, manifest, client.RawPatch(types.MergePatchType, reapplyPatch(ungatedManifest)))).Should(gomega.Succeed())
+
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), manifest)).Should(gomega.Succeed())
+		gate := corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}
+		gomega.Expect(manifest.Spec.HeadGroupSpec.Template.Spec.SchedulingGates).Should(gomega.ContainElement(gate))
+		gomega.Expect(manifest.Spec.WorkerGroupSpecs[0].Template.Spec.SchedulingGates).Should(gomega.ContainElement(gate))
+	})
+
+	ginkgo.It("Should ungate the workers of a re-applied cluster up to the admitted count and never beyond", func() {
+		manifest := newManifest()
+
+		ginkgo.By("creating the cluster and starting it with two admitted workers")
+		behavioral.MustCreate(ctx, k8sClient, manifest.DeepCopy())
+		rayCluster := &rayv1.RayCluster{}
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(manifest), rayCluster)).Should(gomega.Succeed())
+			g.Expect(rayCluster.Spec.Suspend).Should(gomega.Equal(new(false)))
+			g.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Template.Labels).Should(gomega.HaveKeyWithValue(constants.PodSetLabel, workerGroup))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		sliceName := rayCluster.Spec.WorkerGroupSpecs[0].Template.Annotations[kueue.WorkloadSliceNameAnnotation]
+		gomega.Expect(sliceName).ShouldNot(gomega.BeEmpty())
+
+		// worker creates a gated Pod the way KubeRay does: from the worker group's current template.
+		worker := func(name string) *corev1.Pod {
+			template := rayCluster.Spec.WorkerGroupSpecs[0].Template
+			pod := testingpod.MakePod(name, ns.Name).Obj()
+			pod.Labels = template.Labels
+			pod.Annotations = template.Annotations
+			pod.Spec.SchedulingGates = template.Spec.SchedulingGates
+			return pod
+		}
+		ungated := func() []string {
+			pods := &corev1.PodList{}
+			gomega.Expect(k8sClient.List(ctx, pods, client.InNamespace(ns.Name))).Should(gomega.Succeed())
+			var names []string
+			for _, pod := range pods.Items {
+				if len(pod.Spec.SchedulingGates) == 0 {
