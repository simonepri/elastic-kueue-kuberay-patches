+		gomega.Eventually(ungated, behavioral.Timeout, behavioral.Interval).Should(gomega.ConsistOf("first-0", "first-1"))
+
+		ginkgo.By("re-applying the original manifest as a JSON merge patch")
+		patch := reapplyPatch(manifest)
+		gomega.Expect(k8sClient.Patch(ctx, rayCluster, client.RawPatch(types.MergePatchType, patch))).Should(gomega.Succeed())
+
+		ginkgo.By("keeping the gate, the PodSet label, and the slice name on the replaced worker group")
+		refresh()
+		template := rayCluster.Spec.WorkerGroupSpecs[0].Template
+		gomega.Expect(template.Spec.SchedulingGates).Should(gomega.ContainElement(corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}))
+		gomega.Expect(template.Labels).Should(gomega.HaveKeyWithValue(constants.PodSetLabel, workerGroup))
+		gomega.Expect(template.Annotations).Should(gomega.HaveKeyWithValue(kueue.WorkloadSliceNameAnnotation, sliceName))
+
+		ginkgo.By("ungating the replacements of two lost workers, and no third worker")
+		for _, name := range []string{"first-0", "first-1"} {
+			gomega.Expect(k8sClient.Delete(ctx, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: ns.Name}})).Should(gomega.Succeed())
+		}
+		for _, name := range []string{"replacement-0", "replacement-1", "extra"} {
+			behavioral.MustCreate(ctx, k8sClient, worker(name))
+		}
+		gomega.Eventually(ungated, behavioral.Timeout, behavioral.Interval).Should(gomega.HaveLen(2))
+		gomega.Consistently(ungated, behavioral.LongConsistentDuration, behavioral.Interval).Should(gomega.HaveLen(2))
+
+		ginkgo.By("scaling up to four workers after a second re-apply")
+		gomega.Expect(k8sClient.Patch(ctx, rayCluster, client.RawPatch(types.MergePatchType, patch))).Should(gomega.Succeed())
+		gomega.Eventually(func(g gomega.Gomega) {
+			refresh()
+			rayCluster.Spec.WorkerGroupSpecs[0].Replicas = new(int32(4))
+			g.Expect(k8sClient.Update(ctx, rayCluster)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		gomega.Eventually(func(g gomega.Gomega) {
+			workloads := &kueue.WorkloadList{}
+			g.Expect(k8sClient.List(ctx, workloads, client.InNamespace(ns.Name))).Should(gomega.Succeed())
+			admitted := 0
+			for _, wl := range workloads.Items {
+				if wl.Status.Admission == nil {
+					continue
+				}
+				for _, psa := range wl.Status.Admission.PodSetAssignments {
+					if psa.Name == workerGroup && ptr.Deref(psa.Count, 0) == 4 {
+						admitted++
+					}
+				}
+			}
+			g.Expect(admitted).Should(gomega.BeNumerically(">=", 1))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		refresh()
+		for i := range 2 {
+			behavioral.MustCreate(ctx, k8sClient, worker(fmt.Sprintf("scale-up-%d", i)))
+		}
+		gomega.Eventually(ungated, behavioral.Timeout, behavioral.Interval).Should(gomega.HaveLen(4))
+		gomega.Consistently(ungated, behavioral.LongConsistentDuration, behavioral.Interval).Should(gomega.HaveLen(4))
+	})
+})
+
+// reapplyPatch returns the JSON merge patch that applies the manifest again: the whole
+// object, as a GitOps tool or kubectl apply sends it, without the fields a user does not
+// write.
+func reapplyPatch(manifest *rayv1.RayCluster) []byte {
+	ginkgo.GinkgoHelper()
+	raw, err := json.Marshal(manifest)
+	gomega.Expect(err).ShouldNot(gomega.HaveOccurred())
+	var obj map[string]any
+	gomega.Expect(json.Unmarshal(raw, &obj)).Should(gomega.Succeed())
+	delete(obj, "status")
+	delete(obj["spec"].(map[string]any), "suspend")
+	patch, err := json.Marshal(obj)
+	gomega.Expect(err).ShouldNot(gomega.HaveOccurred())
+	return patch
+}
