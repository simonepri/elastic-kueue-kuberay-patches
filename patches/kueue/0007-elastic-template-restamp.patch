+package reapply
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+	admissionregistrationv1 "k8s.io/api/admissionregistration/v1"
+	"sigs.k8s.io/yaml"
+
+	"sigs.k8s.io/kueue/test/util/behavioral"
+)
+
+// rayClusterWebhookPath writes the generated webhook manifests reduced to the RayCluster
+// webhooks, which are the only ones the suite's manager serves, and returns the directory.
+func rayClusterWebhookPath() string {
+	ginkgo.GinkgoHelper()
+	raw, err := os.ReadFile(filepath.Join(behavioral.WebhookPath, "manifests.yaml"))
+	gomega.Expect(err).NotTo(gomega.HaveOccurred())
+	dir := ginkgo.GinkgoT().TempDir()
+	var out []string
+	for _, doc := range strings.Split(string(raw), "\n---\n") {
+		var meta struct {
+			Kind string `json:"kind"`
+		}
+		gomega.Expect(yaml.Unmarshal([]byte(doc), &meta)).To(gomega.Succeed())
+		switch meta.Kind {
+		case "MutatingWebhookConfiguration":
+			cfg := &admissionregistrationv1.MutatingWebhookConfiguration{}
+			gomega.Expect(yaml.Unmarshal([]byte(doc), cfg)).To(gomega.Succeed())
+			kept := cfg.Webhooks[:0]
+			for _, wh := range cfg.Webhooks {
+				if wh.Name == "mraycluster.kb.io" {
+					kept = append(kept, wh)
+				}
+			}
+			cfg.Webhooks = kept
+			out = append(out, marshalWebhookConfig(cfg))
+		case "ValidatingWebhookConfiguration":
+			cfg := &admissionregistrationv1.ValidatingWebhookConfiguration{}
+			gomega.Expect(yaml.Unmarshal([]byte(doc), cfg)).To(gomega.Succeed())
+			kept := cfg.Webhooks[:0]
+			for _, wh := range cfg.Webhooks {
+				if wh.Name == "vraycluster.kb.io" {
+					kept = append(kept, wh)
+				}
+			}
+			cfg.Webhooks = kept
+			out = append(out, marshalWebhookConfig(cfg))
+		}
+	}
+	gomega.Expect(os.WriteFile(filepath.Join(dir, "manifests.yaml"), []byte(strings.Join(out, "\n---\n")), 0o600)).To(gomega.Succeed())
+	return dir
+}
+
+func marshalWebhookConfig(obj any) string {
+	ginkgo.GinkgoHelper()
+	raw, err := yaml.Marshal(obj)
+	gomega.Expect(err).NotTo(gomega.HaveOccurred())
+	return string(raw)
+}
