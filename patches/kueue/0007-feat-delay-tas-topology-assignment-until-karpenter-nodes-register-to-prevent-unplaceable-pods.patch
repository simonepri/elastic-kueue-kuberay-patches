@@ -425,6 +432,14 @@ func (c *Controller) reconcileCheck(ctx context.Context, wl *kueue.Workload, che
 	if len(guarded) == 0 {
 		return ctrl.Result{}, c.setCheck(ctx, wl, checkName, kueue.CheckStateReady, "No pods require NodeClaims")
 	}
+	// A delayed TAS request needs real nodes. Keep the launch timeout running
+	// through registration even when ordinary non-TAS jobs wait only for launch.
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		if psa.DelayedTopologyRequest != nil {
+			cfg.waitFor = conditionRegistered
+			break
+		}
+	}
 
 	workloadID := workloadClaimLabel(wl.Namespace, wl.Name, wl.UID)
 	claims, err := c.listNodeClaims(ctx, wl.Namespace, workloadID)
@@ -617,6 +632,50 @@ func (c *Controller) reconcileCheck(ctx context.Context, wl *kueue.Workload, che
 	return ctrl.Result{RequeueAfter: min(pollInterval, cfg.launchTimeout-elapsed)}, nil
 }
 
+// expireUnplacedTopology keeps the launch deadline running after registration for a delayed topology request
+// on a guarded flavor, until the scheduler's second pass assigns the topology. Packing estimates capacity from
+// pod requests while TAS places against the registered nodes' real allocatable capacity, so the gang can fail
+// to fit them. Kueue never times out such a Workload, since waitForPodsReady starts only at admission, and the
+// scheduler does not retry it, so the check fails the attempt once the deadline passes. It returns the time left
+// before the deadline and whether it failed the attempt.
+func (c *Controller) expireUnplacedTopology(ctx context.Context, wl *kueue.Workload, checkName kueue.AdmissionCheckReference, cfg config) (time.Duration, bool, error) {
+	reservedAt := apimeta.FindStatusCondition(wl.Status.Conditions, kueue.WorkloadQuotaReserved).LastTransitionTime.Time
+	attempt := attemptID(wl, reservedAt)
+	if wl.Annotations[ProvisionedAttemptAnnotation] != attempt || workload.IsAdmitted(wl) {
+		return 0, false, nil
+	}
+	guarded, err := c.guardedFlavors(ctx, wl, checkName, cfg)
+	if err != nil {
+		return 0, false, err
+	}
+	waiting := slices.ContainsFunc(wl.Status.Admission.PodSetAssignments, func(psa kueue.PodSetAssignment) bool {
+		return psa.DelayedTopologyRequest != nil && *psa.DelayedTopologyRequest == kueue.DelayedTopologyRequestStatePending &&
+			slices.ContainsFunc(guarded, func(flavor string) bool {
+				return slices.Contains(slices.Collect(maps.Values(psa.Flavors)), kueue.ResourceFlavorReference(flavor))
+			})
+	})
+	if !waiting {
+		return 0, false, nil
+	}
+	if remaining := cfg.launchTimeout - c.Clock.Since(reservedAt); remaining > 0 {
+		return remaining, false, nil
+	}
+	workloadID := workloadClaimLabel(wl.Namespace, wl.Name, wl.UID)
+	claims, err := c.listNodeClaims(ctx, wl.Namespace, workloadID)
+	if err != nil {
+		return 0, false, err
+	}
+	current := make(map[string]*unstructured.Unstructured, len(claims))
+	for i := range claims {
+		if claims[i].GetLabels()[AttemptLabelKey] == attempt {
+			current[claims[i].GetName()] = &claims[i]
+		}
+	}
+	reason := fmt.Sprintf("the topology was not assigned within %s of the quota reservation", cfg.launchTimeout)
+	log.FromContext(ctx).Info("The registered nodes did not fit the delayed topology, retrying on another flavor", "check", checkName, "reason", reason)
+	return 0, true, c.fail(ctx, wl, checkName, cfg, current, reason)
+}
+
 // fail releases the attempt's NodeClaims, excludes the flavors the check guards, and sets the check to Retry
 // so that Kueue evicts the Workload and assigns it a flavor that is still allowed.
 func (c *Controller) fail(ctx context.Context, wl *kueue.Workload, checkName kueue.AdmissionCheckReference, cfg config, claims map[string]*unstructured.Unstructured, reason string) error {
@@ -1164,6 +1223,35 @@ func (c *Controller) releaseDisruptionHolds(ctx context.Context, wl *kueue.Workl
 	if err != nil {
 		return ctrl.Result{}, err
 	}
+	// TAS uses real allocatable capacity, which can pack the gang differently
+	// from the claim request estimates. Keep all holds until the assigned gang
+	// has bound, then release even claims TAS did not need.
+	delayed := slices.ContainsFunc(wl.Status.Admission.PodSetAssignments, func(psa kueue.PodSetAssignment) bool { return psa.DelayedTopologyRequest != nil })
+	if delayed {
+		if !workload.IsAdmitted(wl) {
+			return ctrl.Result{RequeueAfter: pollInterval}, nil
+		}
+		bound, want := 0, 0
+		for i := range claims {
+			if claims[i].GetLabels()[AttemptLabelKey] != attempt {
+				continue
+			}
+			count, err := strconv.Atoi(claims[i].GetAnnotations()[PodsAnnotation])
+			if err != nil {
+				count = 1
+			}
+			want += count
+			nodeName, _, _ := unstructured.NestedString(claims[i].Object, "status", "nodeName")
+			count, err = c.boundPods(ctx, nodeName)
+			if err != nil {
+				return ctrl.Result{}, err
+			}
+			bound += count
+		}
+		if bound < want {
+			return ctrl.Result{RequeueAfter: pollInterval}, nil
+		}
+	}
 	held := 0
 	for i := range claims {
 		claim := &claims[i]
@@ -1179,7 +1267,7 @@ func (c *Controller) releaseDisruptionHolds(ctx context.Context, wl *kueue.Workl
 		if err != nil {
 			want = 1
 		}
-		if bound < want {
+		if !delayed && bound < want {
 			held++
 			continue
 		}
