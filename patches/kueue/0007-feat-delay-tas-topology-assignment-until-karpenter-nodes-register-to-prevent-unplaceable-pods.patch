+// Identifies ResourceFlavors guarded by Karpenter admission checks that delay topology assignment.
+package scheduler
+
+import (
+	"k8s.io/apimachinery/pkg/util/sets"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+)
+
+// Only flavors this check actually provisions delay topology. A check applied to
+// an entire queue must leave reserved and remote flavors on their normal path.
+func (c *Cache) flavorsWithKarpenterAdmissionCheck(cq *clusterQueue) sets.Set[kueue.ResourceFlavorReference] {
+	if !features.Enabled(features.KarpenterAdmissionCheck) {
+		return nil
+	}
+	flavors := sets.New[kueue.ResourceFlavorReference]()
+	for name, onFlavors := range cq.AdmissionChecks {
+		ac := c.admissionChecks[name]
+		if ac.Controller != constants.KarpenterControllerName {
+			continue
+		}
+		for flavor := range onFlavors {
+			rf := c.resourceFlavors[flavor]
+			if rf != nil && (rf.Spec.NodeLabels[constants.KarpenterNodePoolLabel] != "" || ac.KarpenterNodeClass) {
+				flavors.Insert(flavor)
+			}
+		}
+	}
+	return flavors
+}
+
+func (c *ClusterQueueSnapshot) HasKarpenterAdmissionCheck(rf kueue.ResourceFlavorReference) bool {
+	return c.flavorsForKarpenterACs.Has(rf)
+}
