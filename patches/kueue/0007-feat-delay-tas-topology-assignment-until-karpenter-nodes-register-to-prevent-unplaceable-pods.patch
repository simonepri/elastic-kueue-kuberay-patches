+// Tests delayed topology assignment and registration timeout for Karpenter NodeClaims.
+package karpenter
+
+import (
+	"fmt"
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+func delayedWorkload() *kueue.Workload {
+	wl := reservedWorkload("karpenter-a").Obj()
+	wl.Spec.PodSets[0].TopologyRequest = &kueue.PodSetTopologyRequest{Unconstrained: new(true)}
+	wl.Status.Admission.PodSetAssignments[0].DelayedTopologyRequest = new(kueue.DelayedTopologyRequestStatePending)
+	return wl
+}
+
+func TestDelayedTopologyWaitsForRegistrationAndPublishesPlacement(t *testing.T) {
+	f := newFixture(t, delayedWorkload(), nil)
+	// Two admitted pods fit on one claim, using the same packing as non-TAS jobs.
+	f.setPoolField([]any{map[string]any{"key": "karpenter.k8s.aws/instance-cpu", "operator": "In", "values": []any{"4"}}}, "spec", "template", "spec", "requirements")
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 1 {
+		t.Fatalf("got %d claims, want one packed claim", len(claims))
+	}
+	requests, _, _ := unstructured.NestedString(claims[0].Object, "spec", "resources", "requests", "cpu")
+	if requests != "2" || claims[0].GetAnnotations()[PodsAnnotation] != "2" {
+		t.Fatalf("claim does not cover both pods: %v", claims[0])
+	}
+	f.setCondition(&claims[0], conditionLaunched)
+	f.reconcile()
+	if f.check().State != kueue.CheckStatePending {
+		t.Fatal("TAS must wait for registration")
+	}
+	claims = f.claims()
+	f.setCondition(&claims[0], conditionRegistered)
+	f.reconcile()
+	check := f.check()
+	if check.State != kueue.CheckStateReady {
+		t.Fatalf("got check %v, want Ready", check)
+	}
+	want := []kueue.PodSetUpdate{{
+		Name:         kueue.DefaultPodSetName,
+		NodeSelector: map[string]string{AttemptLabelKey: claims[0].GetLabels()[AttemptLabelKey]},
+		Tolerations:  []corev1.Toleration{{Key: AntiTheftTaintKey, Value: "uid", Operator: corev1.TolerationOpEqual, Effect: corev1.TaintEffectNoSchedule}},
+	}}
+	if diff := cmp.Diff(want, check.PodSetUpdates); diff != "" {
+		t.Fatalf("placement (-want +got): %s", diff)
+	}
+	// The controller never writes topology or changes the reserved counts.
+	psa := f.workload().Status.Admission.PodSetAssignments[0]
+	if psa.TopologyAssignment != nil || *psa.DelayedTopologyRequest != kueue.DelayedTopologyRequestStatePending || *psa.Count != 2 {
+		t.Fatalf("controller changed scheduler-owned assignment: %v", psa)
+	}
+}
+
+func TestDelayedTopologyRegistrationTimeoutFallsBack(t *testing.T) {
+	f := newFixture(t, delayedWorkload(), map[string]string{LaunchTimeoutAnnotation: "1m"})
+	f.reconcile()
+	claims := f.claims()
+	for i := range claims {
+		f.setCondition(&claims[i], conditionLaunched)
+	}
+	f.clk.SetTime(reservedAt.Add(time.Minute))
+	f.reconcile()
+	assertRetriedWithExclusion(t, f, reservedAt.Add(time.Minute+DefaultFlavorCooldown))
+	if len(f.check().PodSetUpdates) != 0 {
+		t.Fatal("Retry must not retain placement from the failed attempt")
+	}
+}
+
+func TestExistingCapacityNeedsNoClaims(t *testing.T) {
+	f := newFixture(t, reservedWorkload("karpenter-b").Obj(), nil)
+	f.reconcile()
+	if len(f.claims()) != 0 || f.check().State != kueue.CheckStateReady || len(f.check().PodSetUpdates) != 0 {
+		t.Fatalf("existing capacity was provisioned: %v", f.check())
+	}
+}
+
+func TestMixedPodSetsProvisionOnlyGuardedCapacity(t *testing.T) {
+	wl := delayedWorkload()
+	wl.Spec.PodSets = append(wl.Spec.PodSets, *utiltestingapi.MakePodSet("head", 1).Request(corev1.ResourceCPU, "1").Obj())
+	wl.Status.Admission.PodSetAssignments = append(wl.Status.Admission.PodSetAssignments, utiltestingapi.MakePodSetAssignment("head").Flavor(corev1.ResourceCPU, "remote").Count(1).Obj())
+	f := newFixture(t, wl, nil)
+	f.reconcile()
+	claims := f.claims()
+	if len(claims) != 2 {
+		t.Fatalf("got %d claims, want 2 workers only", len(claims))
+	}
+	for i := range claims {
+		if claims[i].GetLabels()[constants.PodSetLabel] != string(kueue.DefaultPodSetName) {
+			t.Fatal("provisioned the reserved head")
+		}
+		f.setCondition(&claims[i], conditionRegistered)
+	}
+	f.reconcile()
+	if updates := f.check().PodSetUpdates; len(updates) != 1 || updates[0].Name != kueue.DefaultPodSetName {
+		t.Fatalf("updates affect existing capacity: %v", updates)
+	}
+}
+
+func TestDelayedTopologyReleasesHoldsAfterActualPlacement(t *testing.T) {
+	f := newFixture(t, delayedWorkload(), nil)
+	f.reconcile()
+	claims := f.claims()
+	for i := range claims {
+		name := fmt.Sprintf("node-%d", i)
+		if err := unstructured.SetNestedField(claims[i].Object, name, "status", "nodeName"); err != nil {
+			t.Fatal(err)
+		}
+		f.setCondition(&claims[i], conditionRegistered)
+		if err := f.c.Create(f.ctx, &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: name}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	f.reconcile()
+	if res := f.reconcile(); res.RequeueAfter == 0 {
+		t.Fatal("hold released before TAS admitted the gang")
+	}
+	wl := f.workload()
+	apimeta.SetStatusCondition(&wl.Status.Conditions, metav1.Condition{Type: kueue.WorkloadAdmitted, Status: metav1.ConditionTrue, Reason: "Admitted"})
+	if err := f.c.Status().Update(f.ctx, wl); err != nil {
+		t.Fatal(err)
+	}
+	// An oversized instance lets TAS place both pods on node-0, leaving node-1 empty.
+	for i := range 2 {
+		if err := f.c.Create(f.ctx, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: fmt.Sprintf("worker-%d", i), Namespace: ns}, Spec: corev1.PodSpec{NodeName: "node-0"}}); err != nil {
+			t.Fatal(err)
+		}
+		f.reconcile()
+		if i == 0 && f.workload().Annotations[HoldsReleasedAnnotation] != "" {
+			t.Fatal("hold released before the whole gang bound")
+		}
+	}
+	for _, claim := range f.claims() {
+		if claim.GetAnnotations()[DoNotDisruptAnnotationKey] != "" {
+			t.Fatalf("hold remains after placement on %s", claim.GetName())
+		}
+	}
+}
+
+func TestFailOnStaleWorkloadWritesNothing(t *testing.T) {
+	f := newFixture(t, delayedWorkload(), nil)
+	stale := f.workload()
+	live := f.workload()
+	metav1.SetMetaDataAnnotation(&live.ObjectMeta, "example.com/newer", "true")
+	if err := f.c.Update(f.ctx, live); err != nil {
+		t.Fatal(err)
+	}
+	err := f.ctrl.fail(f.ctx, stale, checkRef, config{flavorCooldown: DefaultFlavorCooldown}, nil, "stale timeout")
+	if !apierrors.IsConflict(err) {
+		t.Fatalf("fail on a stale Workload returned %v, want conflict", err)
+	}
+	got := f.workload()
+	if got.Annotations[ExcludedFlavorsAnnotation] != "" || f.check().State != kueue.CheckStatePending {
+		t.Fatalf("stale fail wrote exclusions %q or check %s", got.Annotations[ExcludedFlavorsAnnotation], f.check().State)
+	}
+}
+
+func TestCheckWriteDoesNotUndoEviction(t *testing.T) {
+	for _, mergePatch := range []bool{false, true} {
+		t.Run(fmt.Sprintf("mergePatch=%t", mergePatch), func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.WorkloadRequestUseMergePatch, mergePatch)
+			f := newFixture(t, delayedWorkload(), nil)
+			stale := f.workload()
+			live := stale.DeepCopy()
+			apimeta.SetStatusCondition(&live.Status.Conditions, metav1.Condition{Type: kueue.WorkloadEvicted, Status: metav1.ConditionTrue, Reason: "AdmissionCheck"})
+			if err := f.c.Status().Update(f.ctx, live); err != nil {
+				t.Fatal(err)
+			}
+			err := f.ctrl.setCheck(f.ctx, stale, checkRef, kueue.CheckStateRetry, "stale timeout")
+			if !apierrors.IsConflict(err) {
+				t.Fatalf("stale check write returned %v, want conflict", err)
+			}
+			if err := f.ctrl.setCheck(f.ctx, f.workload(), checkRef, kueue.CheckStateRetry, "timeout after eviction"); err != nil {
+				t.Fatal(err)
+			}
+			if f.check().State != kueue.CheckStatePending || !apimeta.IsStatusConditionTrue(f.workload().Status.Conditions, kueue.WorkloadEvicted) {
+				t.Fatal("check write undid eviction")
+			}
+		})
+	}
+}
+
+// registeredDelayedFixture returns a delayed-topology Workload whose claims are all Registered and whose
+// check is Ready, the state in which the scheduler's second pass cannot fit the pods on the nodes.
+func registeredDelayedFixture(t *testing.T) *fixture {
+	t.Helper()
+	f := newFixture(t, delayedWorkload(), map[string]string{LaunchTimeoutAnnotation: "1m"})
+	f.reconcile()
+	claims := f.claims()
+	for i := range claims {
+		f.setCondition(&claims[i], conditionRegistered)
+	}
+	f.reconcile()
+	if got := f.check().State; got != kueue.CheckStateReady {
+		t.Fatalf("check state = %s, want Ready", got)
+	}
+	return f
+}
+
+func TestDelayedTopologyPendingPastDeadlineRetriesAfterRegistration(t *testing.T) {
+	f := registeredDelayedFixture(t)
+
+	f.clk.SetTime(reservedAt.Add(59 * time.Second))
+	res := f.reconcile()
+	if got := f.check().State; got != kueue.CheckStateReady {
+		t.Fatalf("check state before the deadline = %s, want Ready", got)
+	}
+	if n := len(f.claims()); n != 2 {
+		t.Fatalf("got %d NodeClaims before the deadline, want 2", n)
+	}
+	if res.RequeueAfter <= 0 || res.RequeueAfter > time.Second {
+		t.Fatalf("RequeueAfter = %s, want the time left until the deadline", res.RequeueAfter)
+	}
+	if got := f.workload().Annotations[ExcludedFlavorsAnnotation]; got != "" {
+		t.Fatalf("excluded flavors before the deadline = %q, want none", got)
+	}
+
+	f.clk.SetTime(reservedAt.Add(time.Minute))
+	f.reconcile()
+	assertRetriedWithExclusion(t, f, reservedAt.Add(time.Minute+DefaultFlavorCooldown))
+}
+
+func TestDelayedTopologyAssignedStopsTheDeadline(t *testing.T) {
+	f := registeredDelayedFixture(t)
+	wl := f.workload()
+	wl.Status.Admission.PodSetAssignments[0].DelayedTopologyRequest = new(kueue.DelayedTopologyRequestStateReady)
+	if err := f.c.Status().Update(f.ctx, wl); err != nil {
+		t.Fatal(err)
+	}
+	f.clk.SetTime(reservedAt.Add(time.Hour))
+	f.reconcile()
+	if got := f.check().State; got != kueue.CheckStateReady {
+		t.Errorf("check state = %s, want Ready", got)
+	}
+	if n := len(f.claims()); n != 2 {
+		t.Errorf("got %d NodeClaims, want 2", n)
+	}
+}
