+// Tests discovery of ResourceFlavors with Karpenter admission checks in the scheduler cache.
+package scheduler
+
+import (
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/sets"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+func TestKarpenterDelayedTopologyFlavors(t *testing.T) {
+	for name, tc := range map[string]struct {
+		onFlavors  []kueue.ResourceFlavorReference
+		controller string
+		nodeClass  bool
+		want       sets.Set[kueue.ResourceFlavorReference]
+	}{
+		"queue-wide check leaves reserved capacity alone": {controller: constants.KarpenterControllerName, want: sets.New[kueue.ResourceFlavorReference]("karpenter")},
+		"per-flavor check":                                     {controller: constants.KarpenterControllerName, onFlavors: []kueue.ResourceFlavorReference{"karpenter"}, want: sets.New[kueue.ResourceFlavorReference]("karpenter")},
+		"check only on reserved capacity":                      {controller: constants.KarpenterControllerName, onFlavors: []kueue.ResourceFlavorReference{"reserved"}, want: sets.New[kueue.ResourceFlavorReference]()},
+		"other controller does not delay":                      {controller: "other", want: sets.New[kueue.ResourceFlavorReference]()},
+		"explicit node class provisions flavors without pools": {controller: constants.KarpenterControllerName, nodeClass: true, want: sets.New[kueue.ResourceFlavorReference]("karpenter", "reserved")},
+	} {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.KarpenterAdmissionCheck, true)
+			ctx, log := utiltesting.ContextWithLog(t)
+			cache := New(utiltesting.NewFakeClient())
+			cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("karpenter").NodeLabel(constants.KarpenterNodePoolLabel, "pool").Obj())
+			cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("reserved").Obj())
+			ac := utiltestingapi.MakeAdmissionCheck("check").ControllerName(tc.controller).Active(metav1.ConditionTrue).Obj()
+			if tc.nodeClass {
+				ac.Annotations = map[string]string{constants.KarpenterNodeClassAnnotation: "test/NodeClass/default"}
+			}
+			cache.AddOrUpdateAdmissionCheck(log, ac)
+			cq := utiltestingapi.MakeClusterQueue("cq").ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("karpenter").Resource(corev1.ResourceCPU, "10").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("reserved").Resource(corev1.ResourceCPU, "10").Obj(),
+			).AdmissionCheckStrategy(*utiltestingapi.MakeAdmissionCheckStrategyRule("check", tc.onFlavors...).Obj()).Obj()
+			if err := cache.AddClusterQueue(ctx, cq); err != nil {
+				t.Fatal(err)
+			}
+			got := cache.flavorsWithKarpenterAdmissionCheck(cache.hm.ClusterQueue("cq"))
+			if !tc.want.Equal(got) {
+				t.Fatalf("delayed flavors = %v, want %v", got, tc.want)
+			}
+			cache.DeleteAdmissionCheck(log, ac)
+			if got := cache.flavorsWithKarpenterAdmissionCheck(cache.hm.ClusterQueue("cq")); got.Len() != 0 {
+				t.Fatalf("deleted check still delays %v", got)
+			}
+		})
+	}
+}
+
+func TestKarpenterDelayedTopologyFlavorsGateDisabled(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.KarpenterAdmissionCheck, false)
+	ctx, log := utiltesting.ContextWithLog(t)
+	cache := New(utiltesting.NewFakeClient())
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("karpenter").NodeLabel(constants.KarpenterNodePoolLabel, "pool").Obj())
+	ac := utiltestingapi.MakeAdmissionCheck("check").ControllerName(constants.KarpenterControllerName).Active(metav1.ConditionTrue).Obj()
+	cache.AddOrUpdateAdmissionCheck(log, ac)
+	cq := utiltestingapi.MakeClusterQueue("cq").ResourceGroup(
+		*utiltestingapi.MakeFlavorQuotas("karpenter").Resource(corev1.ResourceCPU, "10").Obj(),
+	).AdmissionCheckStrategy(*utiltestingapi.MakeAdmissionCheckStrategyRule("check").Obj()).Obj()
+	if err := cache.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	got := cache.flavorsWithKarpenterAdmissionCheck(cache.hm.ClusterQueue("cq"))
+	if got.Len() != 0 {
+		t.Fatalf("disabled gate must return empty flavors, got %v", got)
+	}
+}
