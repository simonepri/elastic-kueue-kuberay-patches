+// deferFlavorPlacementToPods removes the node labels and tolerations of the
+// assigned ResourceFlavors from info when the ElasticJobUngater adds them to
+// each Pod instead (see workloadslicing.FlavorPlacementOnPods). A PodSet admitted
+// with no Pods may move to another flavor when it scales up, and a Pod can only
+// gain nodeSelector keys while it is gated, so placement baked into the job
+// template by the first admission would conflict with the new flavor's.
+// Selectors and tolerations from admission checks stay in info.
+//
+// Only a PodSet whose template carries the elastic scheduling gate is deferred:
+// the ungater handles the Pods of those and no others, so any other PodSet of an
+// elastic Workload keeps its placement on the template. It reports whether it
+// deferred any PodSet.
+func deferFlavorPlacementToPods(ctx context.Context, c client.Client, wl *kueue.Workload, info []podset.PodSetInfo) (bool, error) {
+	if !workloadslicing.FlavorPlacementOnPods(wl) {
+		return false, nil
+	}
+	baseByName, err := flavorInfoByPodSet(ctx, c, wl)
+	if err != nil {
+		return false, err
+	}
+	deferred := false
+	for i := range info {
+		base, found := baseByName[info[i].Name]
+		if !found || !ungatedByElasticJobUngater(wl, info[i].Name) {
+			continue
+		}
+		deferred = true
+		for key, value := range base.NodeSelector {
+			if info[i].NodeSelector[key] == value {
+				delete(info[i].NodeSelector, key)
+			}
+		}
+		info[i].Tolerations = slices.Pick(info[i].Tolerations, func(t *corev1.Toleration) bool {
+			for j := range base.Tolerations {
+				if base.Tolerations[j].MatchToleration(t) {
+					return false
+				}
+			}
+			return true
+		})
+	}
+	return deferred, nil
+}
+
+// markFlavorPlacementOnPods marks a Workload that will be started with the flavor placement
+// off its templates. It does so when the Workload is built, and not when the job starts, so
+// that every copy made from it, such as a ConcurrentAdmission variant, and every later slice
+// carries the marker.
+func markFlavorPlacementOnPods(wl *kueue.Workload) {
+	if !workloadslicing.FlavorPlacementOnPods(wl) {
+		return
+	}
+	for i := range wl.Spec.PodSets {
+		if ungatedByElasticJobUngater(wl, wl.Spec.PodSets[i].Name) {
+			metav1.SetMetaDataAnnotation(&wl.ObjectMeta, workloadslicing.FlavorPlacementOnPodsAnnotation, "true")
+			return
+		}
+	}
+}
+
+// ungatedByElasticJobUngater reports whether the Pods of the PodSet start behind the
+// elastic scheduling gate, which only the ElasticJobUngater removes.
+func ungatedByElasticJobUngater(wl *kueue.Workload, name kueue.PodSetReference) bool {
+	for i := range wl.Spec.PodSets {
+		if wl.Spec.PodSets[i].Name == name {
+			for _, gate := range wl.Spec.PodSets[i].Template.Spec.SchedulingGates {
+				if gate.Name == kueue.ElasticJobSchedulingGate {
+					return true
+				}
+			}
+			return false
+		}
+	}
+	return false
+}
+
+// flavorInfoByPodSet returns, by PodSet name, the placement the ResourceFlavors
+// assigned to each PodSet of wl contribute.
+func flavorInfoByPodSet(ctx context.Context, c client.Client, wl *kueue.Workload) (map[kueue.PodSetReference]podset.PodSetInfo, error) {
+	assignments, err := podSetAssignmentsInSpecOrder(wl)
+	if err != nil {
+		return nil, err
+	}
+	baseByName := make(map[kueue.PodSetReference]podset.PodSetInfo, len(assignments))
+	for i := range assignments {
+		base, err := podset.FromAssignment(ctx, c, &assignments[i], &wl.Spec.PodSets[i])
+		if err != nil {
+			return nil, err
+		}
+		baseByName[base.Name] = base
+	}
+	return baseByName, nil
+}
