+// Injects resource flavor node selectors and tolerations onto gated elastic job pods.
+package elasticjobs
+
+import (
+	"context"
+	"fmt"
+	"slices"
+
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/klog/v2"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/podset"
+	utilmaps "sigs.k8s.io/kueue/pkg/util/maps"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// admissionUpdate returns what the ungater adds to a gated Pod of the PodSet: the
+// admission check updates and, with ElasticJobsViaWorkloadSlicesFlavorChangeFromZero,
+// the placement of the ResourceFlavors that wl assigns to the PodSet.
+func (r *elasticJobUngater) admissionUpdate(ctx context.Context, wl *kueue.Workload, podSetName kueue.PodSetReference) (podAdmissionUpdate, error) {
+	update, err := admissionUpdateForPodSet(wl, podSetName)
+	if err != nil {
+		return podAdmissionUpdate{}, err
+	}
+	if err := addFlavorPlacement(ctx, r.client, wl, podSetName, &update); err != nil {
+		return podAdmissionUpdate{}, err
+	}
+	return update, nil
+}
+
+// addFlavorPlacement adds the node labels and tolerations of the ResourceFlavors
+// that wl assigns to the PodSet. The job template does not carry them (see
+// deferFlavorPlacementToPods in the job framework), because a PodSet that had no
+// Pods may move to another flavor, and only the Pods can follow it.
+func addFlavorPlacement(ctx context.Context, c client.Client, wl *kueue.Workload, podSetName kueue.PodSetReference, update *podAdmissionUpdate) error {
+	if !workloadslicing.FlavorPlacementOnPods(wl) || wl.Status.Admission == nil {
+		return nil
+	}
+	psIdx := slices.IndexFunc(wl.Spec.PodSets, func(ps kueue.PodSet) bool { return ps.Name == podSetName })
+	psaIdx := slices.IndexFunc(wl.Status.Admission.PodSetAssignments, func(psa kueue.PodSetAssignment) bool { return psa.Name == podSetName })
+	if psIdx == -1 || psaIdx == -1 {
+		return nil
+	}
+	info, err := podset.FromAssignment(ctx, c, &wl.Status.Admission.PodSetAssignments[psaIdx], &wl.Spec.PodSets[psIdx])
+	if err != nil {
+		return fmt.Errorf("reading the ResourceFlavors of PodSet %q: %w", podSetName, err)
+	}
+	for key, value := range info.NodeSelector {
+		if old, exists := update.nodeSelector[key]; exists && old != value {
+			return fmt.Errorf("conflicting %q node selector updates for PodSet %q", key, podSetName)
+		}
+	}
+	utilmaps.Copy(&update.nodeSelector, info.NodeSelector)
+	update.tolerations = append(update.tolerations, info.Tolerations...)
+	return nil
+}
+
+
+func nodeSelectorConflicts(selector map[string]string, update podAdmissionUpdate) bool {
+	for key, value := range update.nodeSelector {
+		if existing, found := selector[key]; found && existing != value {
+			return true
+		}
+	}
+	return false
+}
+
+// stalePlacement reports whether the gated Pod, whose nodeSelector conflicts with the
+// flavor placement in update, was created before the active slice from a template older
+// than the one the slice was built from, which no longer conflicts. A Pod that the job's
+// owner creates now gets that template, so it can only conflict again if the job's
+// template itself conflicts, and then deleting it would only make the owner recreate it.
+// A Pod created after the slice is therefore never reported, which bounds the recycling
+// to one deletion per Pod. Timestamps have a resolution of one second, so a Pod created in
+// the second of the slice still counts as older.
+func stalePlacement(pod *corev1.Pod, wl *kueue.Workload, template *corev1.PodTemplateSpec, update podAdmissionUpdate) bool {
+	return !pod.CreationTimestamp.After(wl.CreationTimestamp.Time) && !nodeSelectorConflicts(template.Spec.NodeSelector, update)
+}
+
+// recycleStalePod deletes a gated Pod whose nodeSelector conflicts with the flavor
+// placement of its PodSet because an older template gave it a stale value, so that
+// the job's owner recreates it from the current template. A gated Pod has not run.
+// It reports whether it deleted the Pod; any other conflicting Pod stays gated and
+// gets a Warning event on the Workload.
+func (r *elasticJobUngater) recycleStalePod(ctx context.Context, wl *kueue.Workload, pod *corev1.Pod, podSetName kueue.PodSetReference, update podAdmissionUpdate) (bool, error) {
+	if !workloadslicing.FlavorPlacementOnPods(wl) || !pod.DeletionTimestamp.IsZero() {
+		return false, nil
+	}
+	psIdx := slices.IndexFunc(wl.Spec.PodSets, func(ps kueue.PodSet) bool { return ps.Name == podSetName })
+	if psIdx == -1 {
+		return false, nil
+	}
+	if !nodeSelectorConflicts(pod.Spec.NodeSelector, update) {
+		return false, nil
+	}
+	if !stalePlacement(pod, wl, &wl.Spec.PodSets[psIdx].Template, update) {
+		if r.record != nil {
+			r.record.Eventf(wl, nil, corev1.EventTypeWarning, "ConflictingPodPlacement", "LeaveGated",
+				"Pod %s of PodSet %s has a node selector that conflicts with the flavor of the active slice and stays gated; fix the node selector in the job template", pod.Name, podSetName)
+		}
+		return false, nil
+	}
+	ctrl.LoggerFrom(ctx).Info("deleting gated elastic pod created from a template older than the active slice, whose node selector conflicts with the current flavor of its PodSet",
+		"pod", klog.KObj(pod), "podSet", podSetName)
+	err := r.client.Delete(ctx, pod, client.Preconditions{UID: &pod.UID})
+	if err != nil && !apierrors.IsNotFound(err) {
+		return false, fmt.Errorf("deleting stale elastic pod: %w", err)
+	}
+	return true, nil
+}
