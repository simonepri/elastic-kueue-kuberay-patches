+// Tests deferral of resource flavor placement from elastic job templates to pods.
+package jobframework
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+	corev1 "k8s.io/api/core/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/podset"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+func TestDeferFlavorPlacementToPods(t *testing.T) {
+	provider := corev1.Toleration{Key: "example.com/provider", Operator: corev1.TolerationOpEqual, Value: "remote", Effect: corev1.TaintEffectNoSchedule}
+	other := corev1.Toleration{Key: "example.com/other", Operator: corev1.TolerationOpExists}
+	flavor := utiltestingapi.MakeResourceFlavor("remote").
+		NodeLabel("example.com/class", "test").
+		NodeLabel("example.com/provider", "remote").
+		Toleration(provider).
+		Obj()
+	newWorkload := func(elastic, gatedTemplate bool) *kueue.Workload {
+		podSet := utiltestingapi.MakePodSet("workers", 1)
+		if gatedTemplate {
+			podSet = podSet.SchedulingGates(corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate})
+		}
+		wl := utiltestingapi.MakeWorkload("wl", "ns").
+			PodSets(*podSet.Obj()).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").
+				PodSets(utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "remote", "1").Obj()).
+				Obj(), time.Now()).
+			AdmissionChecks(kueue.AdmissionCheckState{
+				Name: "check",
+				PodSetUpdates: []kueue.PodSetUpdate{{
+					Name:         "workers",
+					NodeSelector: map[string]string{"example.com/check": "yes"},
+				}},
+			}).
+			Obj()
+		if elastic {
+			wl.Annotations = map[string]string{workloadslicing.EnabledAnnotationKey: workloadslicing.EnabledAnnotationValue}
+		}
+		return wl
+	}
+	newInfo := func() []podset.PodSetInfo {
+		return []podset.PodSetInfo{{
+			Name: "workers",
+			NodeSelector: map[string]string{
+				"example.com/class":    "test",
+				"example.com/provider": "remote",
+				"example.com/check":    "yes",
+			},
+			Tolerations: []corev1.Toleration{provider, other},
+		}}
+	}
+	cases := map[string]struct {
+		gate         bool
+		elastic      bool
+		marker       bool
+		notGated     bool
+		want         podset.PodSetInfo
+		wantDeferred bool
+	}{
+		"remove the flavor's node labels and tolerations, keeping the admission checks'": {
+			gate:         true,
+			elastic:      true,
+			wantDeferred: true,
+			want: podset.PodSetInfo{
+				Name:         "workers",
+				NodeSelector: map[string]string{"example.com/check": "yes"},
+				Tolerations:  []corev1.Toleration{other},
+			},
+		},
+		"keep removing them with the gate off for a Workload marked as started with it on": {
+			elastic:      true,
+			marker:       true,
+			wantDeferred: true,
+			want: podset.PodSetInfo{
+				Name:         "workers",
+				NodeSelector: map[string]string{"example.com/check": "yes"},
+				Tolerations:  []corev1.Toleration{other},
+			},
+		},
+		"keep them with the gate off":                                   {elastic: true, want: newInfo()[0]},
+		"keep them for a PodSet whose Pods the ungater does not handle": {gate: true, elastic: true, notGated: true, want: newInfo()[0]},
+		"keep them for a workload that is not elastic":                  {gate: true, want: newInfo()[0]},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, tc.gate)
+			cl := utiltesting.NewClientBuilder(kueue.AddToScheme).WithObjects(flavor).Build()
+			info := newInfo()
+			wl := newWorkload(tc.elastic, !tc.notGated)
+			if tc.marker {
+				wl.Annotations[workloadslicing.FlavorPlacementOnPodsAnnotation] = "true"
+			}
+			deferred, err := deferFlavorPlacementToPods(t.Context(), cl, wl, info)
+			if err != nil {
+				t.Fatalf("deferFlavorPlacementToPods() error: %v", err)
+			}
+			if deferred != tc.wantDeferred {
+				t.Errorf("deferFlavorPlacementToPods() = %v, want %v", deferred, tc.wantDeferred)
+			}
+			if diff := cmp.Diff(tc.want, info[0], cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("PodSetInfo mismatch (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+// The job template of an elastic workload started with the gate on carries no
+// flavor placement, so the expected running PodSets must not either.
+func TestExpectedRunningPodSetsDefersFlavorPlacement(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, true)
+	flavor := utiltestingapi.MakeResourceFlavor("remote").
+		NodeLabel("example.com/provider", "remote").
+		Toleration(corev1.Toleration{Key: "example.com/provider", Operator: corev1.TolerationOpExists}).
+		Obj()
+	wl := utiltestingapi.MakeWorkload("wl", "ns").
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		PodSets(*utiltestingapi.MakePodSet("workers", 1).SchedulingGates(corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}).Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").
+			PodSets(utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "remote", "1").Obj()).
+			Obj(), time.Now()).
+		Obj()
+	cl := utiltesting.NewClientBuilder(kueue.AddToScheme).WithObjects(flavor).Build()
+
+	got := expectedRunningPodSets(t.Context(), cl, wl)
+	if len(got) != 1 {
+		t.Fatalf("expectedRunningPodSets() returned %d PodSets, want 1", len(got))
+	}
+	if len(got[0].Template.Spec.Tolerations) != 0 || len(got[0].Template.Spec.NodeSelector) != 0 {
+		t.Errorf("running PodSet carries flavor placement: nodeSelector=%v tolerations=%v",
+			got[0].Template.Spec.NodeSelector, got[0].Template.Spec.Tolerations)
+	}
+}
+
+func TestMarkFlavorPlacementOnPods(t *testing.T) {
+	gate := corev1.PodSchedulingGate{Name: kueue.ElasticJobSchedulingGate}
+	build := func(gated bool) *kueue.Workload {
+		podSet := utiltestingapi.MakePodSet("workers", 1)
+		if gated {
+			podSet = podSet.SchedulingGates(gate)
+		}
+		return utiltestingapi.MakeWorkload("wl", "ns").
+			Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			PodSets(*podSet.Obj()).
+			Obj()
+	}
+	cases := map[string]struct {
+		gate  bool
+		gated bool
+		want  bool
+	}{
+		"mark a Workload with a gated PodSet when the gate is on": {gate: true, gated: true, want: true},
+		"leave a Workload without a gated PodSet alone":           {gate: true},
+		"leave a Workload alone with the gate off":                {gated: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, tc.gate)
+			wl := build(tc.gated)
+			markFlavorPlacementOnPods(wl)
+			if got := wl.Annotations[workloadslicing.FlavorPlacementOnPodsAnnotation] == "true"; got != tc.want {
+				t.Errorf("marker = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
