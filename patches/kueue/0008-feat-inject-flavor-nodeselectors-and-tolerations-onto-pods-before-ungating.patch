+// Tests preservation of the flavor placement marker when generating cluster variants.
+package concurrentadmission
+
+import (
+	"testing"
+
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// A cluster admitted through a variant has no other Workload for the ungater to read the
+// marker from, so the variant must carry the parent's.
+func TestGenerateVariantKeepsFlavorPlacementMarker(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero, false)
+	parent := utiltestingapi.MakeWorkload("parent", "ns").
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Annotation(workloadslicing.FlavorPlacementOnPodsAnnotation, "true").
+		Obj()
+
+	variant := generateVariant(parent, "remote")
+
+	if !workloadslicing.FlavorPlacementOnPods(variant) {
+		t.Errorf("variant annotations %v do not keep the flavor placement marker", variant.Annotations)
+	}
+}
