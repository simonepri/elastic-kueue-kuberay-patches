+			if err := UpdateReclaimablePodsAfterScaleDown(ctx, r.Client, selectedWorkload); err != nil {
+				return nil, true, fmt.Errorf("failed to update workload's reclaimable pods: %w", err)
+			}
 			return selectedWorkload, true, nil
 		}
 
