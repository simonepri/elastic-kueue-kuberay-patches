+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+func TestClearReclaimTargets(t *testing.T) {
+	testCases := map[string]struct {
+		disablePartialPreemption bool
+		wantWrites               int
+		wantReclaimable          []kueue.ReclaimablePod
+		wantAnnotations          map[string]string
+	}{
+		"clears the reclaimable pods of the shrunk PodSets, then the targets": {
+			wantWrites:      2,
+			wantReclaimable: []kueue.ReclaimablePod{{Name: "other", Count: 1}},
+			wantAnnotations: map[string]string{"kept": "true"},
+		},
+		"without the gate nothing is cleared": {
+			disablePartialPreemption: true,
+			wantReclaimable:          []kueue.ReclaimablePod{{Name: "other", Count: 1}, {Name: "workers", Count: 4}},
+			wantAnnotations: map[string]string{
+				"kept":                                  "true",
+				constants.ReclaimTargetCountsAnnotation: "workers=4",
+				constants.ReclaimPreemptorAnnotation:    "ns/preemptor",
+				constants.ReclaimRequestedAtAnnotation:  "2026-01-01T00:00:00Z",
+			},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, !tc.disablePartialPreemption)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			wl := utiltestingapi.MakeWorkload("wl", "ns").
+				PodSets(
+					*utiltestingapi.MakePodSet("other", 2).Obj(),
+					*utiltestingapi.MakePodSet("workers", 8).Obj(),
+				).
+				Annotation("kept", "true").
+				Annotation(constants.ReclaimTargetCountsAnnotation, "workers=4").
+				Annotation(constants.ReclaimPreemptorAnnotation, "ns/preemptor").
+				Annotation(constants.ReclaimRequestedAtAnnotation, "2026-01-01T00:00:00Z").
+				ReclaimablePods(
+					kueue.ReclaimablePod{Name: "other", Count: 1},
+					kueue.ReclaimablePod{Name: "workers", Count: 4},
+				).
+				Obj()
+			cl := utiltesting.NewClientBuilder().WithObjects(wl).WithStatusSubresource(wl).Build()
+			r := &WorkloadReconciler{client: cl}
+
+			writes := 0
+			for range 3 {
+				var got kueue.Workload
+				if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+					t.Fatalf("Get() error: %v", err)
+				}
+				wrote, err := r.clearReclaimTargets(ctx, &got)
+				if err != nil {
+					t.Fatalf("clearReclaimTargets() error: %v", err)
+				}
+				if wrote {
+					writes++
+				}
+			}
+			if writes != tc.wantWrites {
+				t.Errorf("clearReclaimTargets() wrote %d times, want %d", writes, tc.wantWrites)
+			}
+			var got kueue.Workload
+			if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			if diff := gocmp.Diff(tc.wantReclaimable, got.Status.ReclaimablePods); diff != "" {
+				t.Errorf("Reclaimable pods (-want,+got):\n%s", diff)
+			}
+			if diff := gocmp.Diff(tc.wantAnnotations, got.Annotations); diff != "" {
+				t.Errorf("Annotations (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
