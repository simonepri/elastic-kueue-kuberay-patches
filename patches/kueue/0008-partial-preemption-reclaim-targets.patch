+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package core
+
+import (
+	"context"
+	"slices"
+
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	clientutil "sigs.k8s.io/kueue/pkg/util/client"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// clearReclaimTargets removes the reclaim targets of partial preemption from a
+// Workload that no longer holds quota, since they apply only to the released
+// admission. It first clears the reclaimable Pods of the shrunk PodSets, which were
+// only the Pods partial preemption stopped. It reports whether it wrote the Workload.
+func (r *WorkloadReconciler) clearReclaimTargets(ctx context.Context, wl *kueue.Workload) (bool, error) {
+	if !features.Enabled(features.PartialPreemption) || !workload.IsPartiallyPreempted(wl) {
+		return false, nil
+	}
+	targets := workload.ReclaimTargetCounts(wl)
+	reclaimable := slices.DeleteFunc(slices.Clone(wl.Status.ReclaimablePods), func(rp kueue.ReclaimablePod) bool {
+		_, found := targets[rp.Name]
+		return found
+	})
+	if len(reclaimable) != len(wl.Status.ReclaimablePods) {
+		return true, client.IgnoreNotFound(workload.UpdateReclaimablePods(ctx, r.client, wl, reclaimable))
+	}
+	return true, client.IgnoreNotFound(clientutil.Patch(ctx, r.client, wl, func() (bool, error) {
+		return workload.ClearReclaimTargets(wl), nil
+	}))
+}
