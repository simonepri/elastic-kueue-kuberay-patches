+limitations under the License.
+*/
+
+package workloadslicing
+
+import (
+	"cmp"
+	"context"
+	"maps"
+	"slices"
+	"strconv"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/klog/v2"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/util/parallelize"
+	utilpod "sigs.k8s.io/kueue/pkg/util/pod"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// runningPodsPerPodSet returns the Pods of the workload slice that hold their
+// resources, by PodSet: the ungated Pods that are not terminated, including the
+// terminating ones.
+func runningPodsPerPodSet(ctx context.Context, c client.Client, wl *kueue.Workload) (map[kueue.PodSetReference][]*corev1.Pod, error) {
+	pods, err := ListPodsForWorkloadSlice(ctx, c, wl.Namespace, SliceName(wl))
+	if err != nil {
+		return nil, err
+	}
+	running := make(map[kueue.PodSetReference][]*corev1.Pod)
+	for _, p := range pods {
+		if utilpod.IsTerminated(p) || utilpod.HasGate(p, kueue.ElasticJobSchedulingGate) {
+			continue
+		}
+		ps := kueue.PodSetReference(p.Labels[constants.PodSetLabel])
+		running[ps] = append(running[ps], p)
+	}
+	return running, nil
+}
+
+// PodsAboveCounts reports whether any PodSet of the workload slice still has
+// more running Pods than counts.
+func PodsAboveCounts(ctx context.Context, c client.Client, wl *kueue.Workload, counts workload.PodSetsCounts) (bool, error) {
+	running, err := runningPodsPerPodSet(ctx, c, wl)
+	if err != nil {
+		return false, err
+	}
+	for ps, count := range counts {
+		if int32(len(running[ps])) > count {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// podGroup is a set of Pods that are deleted together.
+type podGroup struct {
+	pods         []*corev1.Pod
+	deletionCost int64
+	newest       *corev1.Pod
+}
+
+func podDeletionCost(p *corev1.Pod) int64 {
+	cost, err := strconv.ParseInt(p.Annotations[corev1.PodDeletionCost], 10, 32)
+	if err != nil {
+		return 0
+	}
+	return cost
+}
+
+// DeletePodGroupsAboveCounts deletes running Pods of the workload slice until
+// each PodSet in counts runs at most its count. It deletes whole groups, as
+// groupOf maps each Pod to a group key; the group whose costliest Pod has the
+// lowest controller.kubernetes.io/pod-deletion-cost goes first, then the group
+// with the newest Pod. Terminating Pods count toward counts and are not deleted
+// again. It returns whether any Pod was deleted.
+func DeletePodGroupsAboveCounts(ctx context.Context, c client.Client, wl *kueue.Workload, counts workload.PodSetsCounts, groupOf func(*corev1.Pod) string) (bool, error) {
+	running, err := runningPodsPerPodSet(ctx, c, wl)
+	if err != nil {
+		return false, err
+	}
+	var toDelete []*corev1.Pod
+	for _, ps := range slices.Sorted(maps.Keys(counts)) {
+		pods := running[ps]
+		remaining := int32(len(pods))
+		if remaining <= counts[ps] {
+			continue
+		}
+		groupsByKey := make(map[string]*podGroup)
+		for _, p := range pods {
+			if p.DeletionTimestamp != nil {
+				continue
+			}
+			key := groupOf(p)
+			g, found := groupsByKey[key]
+			if !found {
+				g = &podGroup{deletionCost: podDeletionCost(p), newest: p}
+				groupsByKey[key] = g
+			}
+			g.pods = append(g.pods, p)
+			g.deletionCost = max(g.deletionCost, podDeletionCost(p))
+			if newerPod(p, g.newest) {
+				g.newest = p
+			}
+		}
+		groups := slices.Collect(maps.Values(groupsByKey))
+		slices.SortFunc(groups, func(a, b *podGroup) int {
+			if a.deletionCost != b.deletionCost {
+				return cmp.Compare(a.deletionCost, b.deletionCost)
+			}
+			if newerPod(a.newest, b.newest) {
+				return -1
+			}
+			if newerPod(b.newest, a.newest) {
+				return 1
+			}
+			return 0
+		})
+		for _, g := range groups {
+			if remaining <= counts[ps] {
+				break
+			}
+			toDelete = append(toDelete, g.pods...)
+			remaining -= int32(len(g.pods))
+		}
+	}
+	log := ctrl.LoggerFrom(ctx)
+	err = parallelize.Until(ctx, len(toDelete), func(i int) error {
+		log.V(3).Info("Deleting elastic pod above the reclaim target count", "pod", klog.KObj(toDelete[i]))
+		return client.IgnoreNotFound(c.Delete(ctx, toDelete[i]))
+	})
+	return len(toDelete) > 0, err
+}
+
+// newerPod reports whether a was created after b, breaking ties by the higher name.
+func newerPod(a, b *corev1.Pod) bool {
+	if c := a.CreationTimestamp.Compare(b.CreationTimestamp.Time); c != 0 {
+		return c > 0
+	}
+	return strings.Compare(a.Name, b.Name) > 0
+}
+
+// reclaimScaleDown keeps the quota charge of a partially preempted workload slice
+// right when the job scales it down in place. A PodSet with a reclaim target keeps
+// its spec count while the job's count is at or above its admitted count, because
+// its charge is already the target. Below the admitted count, the PodSet takes the
+// job's count and its target is lowered to at most that count; the reclaimable
+// count is then re-derived by workload.ReclaimablePodsAfterScaleDown, which the
+// Workload webhook accepts only after the spec update.
+type reclaimScaleDown struct {
+	// kept holds the PodSets that keep their spec, and the spec they keep.
+	kept map[kueue.PodSetReference]kueue.PodSet
+	// targets holds the reclaim target counts after the scale-down.
+	targets workload.PodSetsCounts
+}
+
+// newReclaimScaleDown returns the reclaim changes for scaling wl down to jobCounts,
+// or nil when wl has no reclaim target to keep right.
+func newReclaimScaleDown(wl *kueue.Workload, jobCounts workload.PodSetsCounts) *reclaimScaleDown {
+	if !features.Enabled(features.PartialPreemption) || !workload.HasQuotaReservation(wl) {
+		return nil
+	}
+	targets := workload.ReclaimTargetCounts(wl)
+	if len(targets) == 0 {
+		return nil
+	}
+	admitted := workload.AdmittedPodSetCounts(wl)
+	r := &reclaimScaleDown{
+		kept:    make(map[kueue.PodSetReference]kueue.PodSet),
+		targets: targets,
+	}
+	for i := range wl.Spec.PodSets {
+		ps := &wl.Spec.PodSets[i]
+		target, hasTarget := targets[ps.Name]
+		newCount, found := jobCounts[ps.Name]
+		if !hasTarget || !found || newCount >= ps.Count {
+			continue
+		}
+		if newCount >= admitted[ps.Name] {
+			r.kept[ps.Name] = *ps.DeepCopy()
+			continue
+		}
+		r.targets[ps.Name] = min(target, newCount)
+	}
+	return r
+}
+
+// keepsSlice reports whether the scale-down leaves wl unchanged, because every
+// PodSet the job lowered keeps its spec count.
+func (r *reclaimScaleDown) keepsSlice(wlCounts, jobCounts workload.PodSetsCounts) bool {
+	if r == nil {
+		return false
+	}
+	for name, count := range jobCounts {
+		if _, kept := r.kept[name]; !kept && wlCounts[name] != count {
+			return false
+		}
+	}
+	return true
+}
+
+// apply restores the kept PodSets of wl, after the job's counts were applied to
+// it, and lowers its reclaim target counts.
+func (r *reclaimScaleDown) apply(wl *kueue.Workload) {
+	if r == nil {
+		return
+	}
+	for i := range wl.Spec.PodSets {
+		if kept, found := r.kept[wl.Spec.PodSets[i].Name]; found {
+			wl.Spec.PodSets[i].Count = kept.Count
+			wl.Spec.PodSets[i].MinCount = kept.MinCount
+		}
+	}
+	workload.SetReclaimTargetCounts(wl, r.targets)
+}
+
+// UpdateReclaimablePodsAfterScaleDown writes the reclaimable counts that
+// workload.ReclaimablePodsAfterScaleDown re-derives for wl, if they changed.
+func UpdateReclaimablePodsAfterScaleDown(ctx context.Context, c client.Client, wl *kueue.Workload) error {
+	if !features.Enabled(features.PartialPreemption) || !workload.IsPartiallyPreempted(wl) {
+		return nil
+	}
+	reclaimable := workload.ReclaimablePodsAfterScaleDown(wl)
+	if workload.ReclaimablePodsAreEqual(reclaimable, wl.Status.ReclaimablePods) {
+		return nil
+	}
+	ctrl.LoggerFrom(ctx).V(3).Info("Re-deriving the reclaimable pods of a partially preempted workload after a scale-down",
+		"reclaimTargetCounts", workload.FormatPodSetCounts(workload.ReclaimTargetCounts(wl)), "reclaimablePods", reclaimable)
+	return workload.UpdateReclaimablePods(ctx, c, wl, reclaimable)
+}
