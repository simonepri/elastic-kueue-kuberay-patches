+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package elasticjobs
+
+import (
+	"context"
+
+	ctrl "sigs.k8s.io/controller-runtime"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// reconcileReclaimTargets releases the quota that partial preemption reclaims from
+// the active slice: once the job reconciler stopped the Pods above the reclaim
+// targets and they are gone, it marks them reclaimable. Their deletion triggers
+// another reconcile until then. It reports whether the slice still has a pending
+// target, or whether it wrote the reclaimable Pods, so the Pods must stay gated in
+// this reconcile.
+func (r *elasticJobUngater) reconcileReclaimTargets(ctx context.Context, wl *kueue.Workload) (bool, error) {
+	if !features.Enabled(features.PartialPreemption) || !workload.IsPartiallyPreempted(wl) {
+		return false, nil
+	}
+	// Retry the re-derivation that an in-place scale-down failed to write.
+	if reclaimable := workload.ReclaimablePodsAfterScaleDown(wl); !workload.ReclaimablePodsAreEqual(reclaimable, wl.Status.ReclaimablePods) {
+		return true, workloadslicing.UpdateReclaimablePodsAfterScaleDown(ctx, r.client, wl)
+	}
+	targets := workload.PendingReclaimTargetCounts(wl)
+	if len(targets) == 0 {
+		return false, nil
+	}
+	above, err := workloadslicing.PodsAboveCounts(ctx, r.client, wl, targets)
+	if err != nil || above {
+		return true, err
+	}
+	ctrl.LoggerFrom(ctx).V(3).Info("Releasing the quota reclaimed by partial preemption", "reclaimTargetCounts", workload.FormatPodSetCounts(targets))
+	return true, workload.UpdateReclaimablePods(ctx, r.client, wl, workload.ReclaimablePodsForTargets(wl, targets))
+}
+
+// capAtReclaimTargets lowers the granted count of each PodSet with a reclaim target
+// to the target, so the Pods that the job recreates after partial preemption stopped
+// them stay gated.
+func capAtReclaimTargets(wl *kueue.Workload, granted workload.PodSetsCounts) {
+	if !features.Enabled(features.PartialPreemption) {
+		return
+	}
+	for ps, target := range workload.ReclaimTargetCounts(wl) {
+		if count, found := granted[ps]; found {
+			granted[ps] = min(count, target)
+		}
+	}
+}
