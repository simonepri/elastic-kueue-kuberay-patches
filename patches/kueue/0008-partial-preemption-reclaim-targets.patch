+)
+
+func TestEnsureWorkloadSlicesReclaimScaleDown(t *testing.T) {
+	testCases := map[string]struct {
+		disablePartialPreemption bool
+		additionalSlice          bool
+		// The slice before the scale-down.
+		count, admitted, target, reclaimable int32
+		jobCount                             int32
+		wantCount, wantTarget                int32
+		wantReclaimable                      int32
+		wantCharged                          int32
+		wantUnchanged                        bool
+	}{
+		"a released victim scaled to its target is charged its target": {
+			count: 8, admitted: 8, target: 4, reclaimable: 4,
+			jobCount:  4,
+			wantCount: 4, wantTarget: 4, wantReclaimable: 0, wantCharged: 4,
+		},
+		"a released victim scaled to its target among several slices is charged its target": {
+			additionalSlice: true,
+			count:           8, admitted: 8, target: 4, reclaimable: 4,
+			jobCount:  4,
+			wantCount: 4, wantTarget: 4, wantReclaimable: 0, wantCharged: 4,
+		},
+		"a partially admitted victim scaled to its admitted count keeps its spec": {
+			count: 8, admitted: 6, target: 4, reclaimable: 4,
+			jobCount:  6,
+			wantCount: 8, wantTarget: 4, wantReclaimable: 4, wantCharged: 4,
+			wantUnchanged: true,
+		},
+		"a partially admitted victim scaled to its admitted count keeps its spec among several slices": {
+			additionalSlice: true,
+			count:           8, admitted: 6, target: 4, reclaimable: 4,
+			jobCount:  6,
+			wantCount: 8, wantTarget: 4, wantReclaimable: 4, wantCharged: 4,
+			wantUnchanged: true,
+		},
+		"a partially admitted victim scaled below its admitted count is charged its target": {
+			count: 8, admitted: 6, target: 4, reclaimable: 4,
+			jobCount:  5,
+			wantCount: 5, wantTarget: 4, wantReclaimable: 1, wantCharged: 4,
+		},
+		"a released victim scaled below its target lowers the target": {
+			count: 8, admitted: 8, target: 4, reclaimable: 4,
+			jobCount:  3,
+			wantCount: 3, wantTarget: 3, wantReclaimable: 0, wantCharged: 3,
+		},
+		"a pending target keeps the reclaimable pods until the pods stop": {
+			count: 8, admitted: 8, target: 4, reclaimable: 0,
+			jobCount:  6,
+			wantCount: 6, wantTarget: 4, wantReclaimable: 0, wantCharged: 6,
+		},
+		"without the gate the scale-down follows upstream": {
+			disablePartialPreemption: true,
+			count:                    8, admitted: 6, target: 4, reclaimable: 4,
+			jobCount:  6,
+			wantCount: 6, wantTarget: 4, wantReclaimable: 4, wantCharged: 2,
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, !tc.disablePartialPreemption)
+			now := time.Now()
+			wlWrapper := utiltestingapi.MakeWorkload(testJobObject.Name+"-1", testJobObject.Namespace).
+				OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+				Creation(now).
+				Annotation(constants.ReclaimTargetCountsAnnotation, workload.FormatPodSetCounts(workload.PodSetsCounts{"workers": tc.target})).
+				PodSets(*utiltestingapi.MakePodSet("workers", int(tc.count)).Request(corev1.ResourceCPU, "1").Obj()).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("default").PodSets(
+					utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "default", "1").Count(tc.admitted).Obj(),
+				).Obj(), now).
+				AdmittedAt(true, now)
+			if tc.reclaimable > 0 {
+				wlWrapper.ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: tc.reclaimable})
+			}
+			wl := wlWrapper.Obj()
+			objects := []client.Object{wl}
+			if tc.additionalSlice {
+				objects = append(objects, utiltestingapi.MakeWorkload(testJobObject.Name+"-old", testJobObject.Namespace).
+					OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+					Creation(now.Add(-time.Minute)).
+					PodSets(*utiltestingapi.MakePodSet("workers", int(tc.count)).Request(corev1.ResourceCPU, "1").Obj()).
+					Obj())
+			}
+			clnt := testWorkloadClientBuilder().WithObjects(objects...).Build()
+			ctx, log := utiltesting.ContextWithLog(t)
+			var before kueue.Workload
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(wl), &before); err != nil {
+				t.Fatalf("Failed to get workload: %v", err)
+			}
+
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(now)}
+			jobPodSets := []kueue.PodSet{*utiltestingapi.MakePodSet("workers", int(tc.jobCount)).Request(corev1.ResourceCPU, "1").Obj()}
+			got, compatible, err := manager.EnsureWorkloadSlices(ctx, jobPodSets, testJobObject, testJobGVK)
+			if err != nil {
+				t.Fatalf("EnsureWorkloadSlices() error: %v", err)
+			}
+			if !compatible || got == nil || got.Name != wl.Name {
+				t.Fatalf("EnsureWorkloadSlices() workload = %v, compatible = %v", got, compatible)
+			}
+
+			var updated kueue.Workload
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(wl), &updated); err != nil {
+				t.Fatalf("Failed to get workload: %v", err)
+			}
+			if tc.wantUnchanged && updated.ResourceVersion != before.ResourceVersion {
+				t.Errorf("Workload was written, resourceVersion %s -> %s", before.ResourceVersion, updated.ResourceVersion)
+			}
+			if gotCount := updated.Spec.PodSets[0].Count; gotCount != tc.wantCount {
+				t.Errorf("PodSet count = %d, want %d", gotCount, tc.wantCount)
+			}
+			if diff := cmp.Diff(workload.PodSetsCounts{"workers": tc.wantTarget}, workload.ReclaimTargetCounts(&updated)); diff != "" {
+				t.Errorf("Reclaim target counts (-want,+got):\n%s", diff)
+			}
+			if gotReclaimable := workload.ReclaimableCounts(&updated)["workers"]; gotReclaimable != tc.wantReclaimable {
+				t.Errorf("Reclaimable count = %d, want %d", gotReclaimable, tc.wantReclaimable)
+			}
+			info := workload.NewInfo(log, &updated)
+			if gotCharged := info.TotalRequests[0].Count; gotCharged != tc.wantCharged {
+				t.Errorf("Charged pods = %d, want %d", gotCharged, tc.wantCharged)
+			}
+		})
+	}
+}
+
+func TestDeletePodGroupsAboveCounts(t *testing.T) {
+	now := time.Now()
+	wl := utiltestingapi.MakeWorkload("wl", "ns").Annotation(kueue.WorkloadSliceNameAnnotation, "origin").Obj()
+	worker := func(name string, created time.Duration) *testingpod.PodWrapper {
+		return testingpod.MakePod(name, "ns").
+			Annotation(kueue.WorkloadSliceNameAnnotation, "origin").
+			Label(constants.PodSetLabel, "workers").
+			CreationTimestamp(now.Add(created))
+	}
+	group := func(p *corev1.Pod) string {
+		if g, found := p.Labels["group"]; found {
+			return g
+		}
+		return p.Name
+	}
+	testCases := map[string]struct {
+		pods        []*corev1.Pod
+		counts      workload.PodSetsCounts
+		wantDeleted []string
+		wantStopped bool
+	}{
+		"no pod is deleted at or below the target": {
+			pods: []*corev1.Pod{
+				worker("a", 0).Obj(),
+				worker("b", time.Second).Obj(),
+			},
+			counts: workload.PodSetsCounts{"workers": 2},
+		},
+		"the newest pods are deleted first": {
+			pods: []*corev1.Pod{
+				worker("a", 0).Obj(),
+				worker("b", time.Second).Obj(),
+				worker("c", 2*time.Second).Obj(),
+			},
+			counts:      workload.PodSetsCounts{"workers": 1},
+			wantDeleted: []string{"b", "c"},
+			wantStopped: true,
+		},
+		"the cheapest pods are deleted first": {
+			pods: []*corev1.Pod{
+				worker("a", 0).Annotation(corev1.PodDeletionCost, "-1000").Obj(),
+				worker("b", time.Second).Annotation(corev1.PodDeletionCost, "1000").Obj(),
+				worker("c", 2*time.Second).Obj(),
+			},
+			counts:      workload.PodSetsCounts{"workers": 1},
+			wantDeleted: []string{"a", "c"},
+			wantStopped: true,
+		},
+		"whole groups are deleted, the group of the costliest pod last": {
+			pods: []*corev1.Pod{
+				worker("g1-a", 0).Label("group", "g1").Obj(),
+				worker("g1-b", 0).Label("group", "g1").Annotation(corev1.PodDeletionCost, "1000").Obj(),
+				worker("g2-a", time.Second).Label("group", "g2").Obj(),
+				worker("g2-b", time.Second).Label("group", "g2").Obj(),
+				worker("g3-a", 2*time.Second).Label("group", "g3").Annotation(corev1.PodDeletionCost, "-1000").Obj(),
+				worker("g3-b", 2*time.Second).Label("group", "g3").Obj(),
+			},
+			counts:      workload.PodSetsCounts{"workers": 3},
+			wantDeleted: []string{"g2-a", "g2-b", "g3-a", "g3-b"},
+			wantStopped: true,
+		},
+		"terminating pods count toward the target and are not deleted again": {
+			pods: []*corev1.Pod{
+				worker("a", 0).Obj(),
+				worker("b", time.Second).Obj(),
+				worker("c", 2*time.Second).Finalizer("test").DeletionTimestamp(now).Obj(),
+			},
+			counts:      workload.PodSetsCounts{"workers": 2},
+			wantDeleted: []string{"b"},
+			wantStopped: true,
+		},
+		"gated, terminated, and other PodSets' pods are kept": {
+			pods: []*corev1.Pod{
+				worker("a", 0).Obj(),
+				worker("gated", time.Second).Gate(kueue.ElasticJobSchedulingGate).Obj(),
+				worker("done", 2*time.Second).StatusPhase(corev1.PodSucceeded).Obj(),
+				worker("head", 3*time.Second).Label(constants.PodSetLabel, "head").Obj(),
+			},
+			counts: workload.PodSetsCounts{"workers": 1},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			objs := make([]client.Object, len(tc.pods))
+			for i := range tc.pods {
+				objs[i] = tc.pods[i]
+			}
+			clnt := utiltesting.NewClientBuilder().
+				WithObjects(objs...).
+				WithIndex(&corev1.Pod{}, indexer.WorkloadSliceNameKey, indexer.IndexPodWorkloadSliceName).
+				Build()
+			stopped, err := DeletePodGroupsAboveCounts(ctx, clnt, wl, tc.counts, group)
+			if err != nil {
+				t.Fatalf("DeletePodGroupsAboveCounts() error: %v", err)
+			}
+			if stopped != tc.wantStopped {
+				t.Errorf("DeletePodGroupsAboveCounts() = %v, want %v", stopped, tc.wantStopped)
+			}
+			var deleted []string
+			for _, p := range tc.pods {
+				var got corev1.Pod
+				err := clnt.Get(ctx, types.NamespacedName{Namespace: p.Namespace, Name: p.Name}, &got)
+				if apierrors.IsNotFound(err) {
+					deleted = append(deleted, p.Name)
+				} else if err != nil {
+					t.Fatalf("Failed to get pod %s: %v", p.Name, err)
+				}
+			}
+			slices.Sort(deleted)
+			if diff := cmp.Diff(tc.wantDeleted, deleted); diff != "" {
+				t.Errorf("Deleted pods (-want,+got):\n%s", diff)
+			}
+			above, err := PodsAboveCounts(ctx, clnt, wl, tc.counts)
+			if err != nil {
+				t.Fatalf("PodsAboveCounts() error: %v", err)
+			}
+			if above {
+				t.Errorf("PodsAboveCounts() = true after the deletion")
+			}
+		})
+	}
+}
