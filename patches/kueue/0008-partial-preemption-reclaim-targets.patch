+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+func TestReconcileReclaimTargets(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	now := time.Now().Truncate(time.Second)
+
+	running := func(name string) corev1.Pod { return *makeElasticPodForPodSet(name, workersPodSet).Obj() }
+	gated := func(name string) corev1.Pod {
+		return *makeElasticPodForPodSet(name, workersPodSet).Gate(kueue.ElasticJobSchedulingGate).Obj()
+	}
+	testCases := map[string]struct {
+		disablePartialPreemption bool
+		// workersCount lowers the spec count of the workers, admitted with 2 pods.
+		workersCount    int32
+		reclaimable     int32
+		pods            []corev1.Pod
+		wantGated       []string
+		wantReclaimable int32
+	}{
+		"a pending target keeps the quota while a pod above it runs": {
+			pods:      []corev1.Pod{running("w-0"), running("w-1"), gated("w-2")},
+			wantGated: []string{"w-2"},
+		},
+		"a pending target releases the quota once the pods above it are gone": {
+			pods:            []corev1.Pod{running("w-0"), gated("w-1")},
+			wantGated:       []string{"w-1"},
+			wantReclaimable: 1,
+		},
+		"a released target keeps the recreated pods gated": {
+			reclaimable:     1,
+			pods:            []corev1.Pod{running("w-0"), gated("w-1")},
+			wantGated:       []string{"w-1"},
+			wantReclaimable: 1,
+		},
+		"a scale-down whose reclaimable pods were not re-derived is charged the target again": {
+			workersCount:    1,
+			reclaimable:     1,
+			pods:            []corev1.Pod{running("w-0")},
+			wantReclaimable: 0,
+		},
+		"without the gate the target is ignored": {
+			disablePartialPreemption: true,
+			pods:                     []corev1.Pod{running("w-0"), gated("w-1")},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, !tc.disablePartialPreemption)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			wl := makeAdmittedTwoPodSetWorkload(now)
+			workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{workersPodSet: 1})
+			if tc.workersCount > 0 {
+				wl.Spec.PodSets[1].Count = tc.workersCount
+			}
+			if tc.reclaimable > 0 {
+				wl.Status.ReclaimablePods = []kueue.ReclaimablePod{{Name: workersPodSet, Count: tc.reclaimable}}
+			}
+			builder := utiltesting.NewClientBuilder().
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+				WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(rayClusterGVK), coreindexer.WorkloadOwnerIndexFunc(rayClusterGVK)).
+				WithIndex(&kueue.Workload{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexWorkloadSliceName).
+				WithStatusSubresource(wl).
+				WithInterceptorFuncs(interceptor.Funcs{
+					Patch: func(ctx context.Context, clnt client.WithWatch, obj client.Object, _ client.Patch, _ ...client.PatchOption) error {
+						return clnt.Update(ctx, obj)
+					},
+				})
+			for i := range tc.pods {
+				builder = builder.WithObjects(&tc.pods[i])
+			}
+			kClient := builder.Build()
+			if err := kClient.Create(ctx, wl); err != nil {
+				t.Fatalf("Could not create workload: %v", err)
+			}
+			ungater := &elasticJobUngater{
+				client:            kClient,
+				clock:             testingclock.NewFakeClock(now),
+				expectationsStore: expectations.NewStore(ControllerName),
+			}
+			if _, err := ungater.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(wl)}); err != nil {
+				t.Fatalf("Reconcile() error: %v", err)
+			}
+
+			var pods corev1.PodList
+			if err := kClient.List(ctx, &pods); err != nil {
+				t.Fatalf("Could not list pods: %v", err)
+			}
+			var gotGated []string
+			for i := range pods.Items {
+				if utilpod.HasGate(&pods.Items[i], kueue.ElasticJobSchedulingGate) {
+					gotGated = append(gotGated, pods.Items[i].Name)
+				}
+			}
+			if diff := gocmp.Diff(tc.wantGated, gotGated); diff != "" {
+				t.Errorf("Gated pods (-want,+got):\n%s", diff)
+			}
+			var got kueue.Workload
+			if err := kClient.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+				t.Fatalf("Could not get workload: %v", err)
+			}
+			if gotReclaimable := workload.ReclaimableCounts(&got)[workersPodSet]; gotReclaimable != tc.wantReclaimable {
+				t.Errorf("Reclaimable workers = %d, want %d", gotReclaimable, tc.wantReclaimable)
+			}
+			if got.Annotations[constants.ReclaimTargetCountsAnnotation] != "workers=1" {
+				t.Errorf("Reclaim target counts = %q, want %q", got.Annotations[constants.ReclaimTargetCountsAnnotation], "workers=1")
+			}
+		})
+	}
+}
