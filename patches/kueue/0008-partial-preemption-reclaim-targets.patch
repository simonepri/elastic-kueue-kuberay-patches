+package raycluster
+
+import (
+	"context"
+
+	rayutils "github.com/ray-project/kuberay/ray-operator/controllers/ray/utils"
+	corev1 "k8s.io/api/core/v1"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/controller/jobframework"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+var _ jobframework.JobWithPartialStop = (*RayCluster)(nil)
+
+// StopPartially deletes the running worker Pods above the reclaim targets in whole
+// worker group replicas, the cheapest by pod deletion cost first, then the newest.
+// KubeRay recreates them, because the RayCluster keeps its replicas, and they stay
+// gated until the slice has room for them again.
+func (j *RayCluster) StopPartially(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts) (bool, error) {
+	return workloadslicing.DeletePodGroupsAboveCounts(ctx, c, wl, targets, workerReplicaName)
+}
+
+// workerReplicaName returns the worker group replica a Pod belongs to; the Pods of
+// a multi-host replica share it. A Pod without one is a replica of its own.
+func workerReplicaName(p *corev1.Pod) string {
+	if name, found := p.Labels[rayutils.RayWorkerReplicaNameKey]; found && name != "" {
+		return name
+	}
+	return p.Name
+}
