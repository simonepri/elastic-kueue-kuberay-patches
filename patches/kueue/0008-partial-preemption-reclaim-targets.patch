+// Partial preemption shrinks an admitted elastic RayCluster to the reclaim target
+// counts that the preemptor writes on its Workload. These specs write the target
+// themselves, as the preemptor would, and emulate KubeRay, which envtest does not run,
+// by creating the worker Pods and recreating the deleted ones.
+var _ = ginkgo.Describe("RayCluster with partial preemption", ginkgo.Label("job:ray", "area:jobs"), ginkgo.Ordered, ginkgo.ContinueOnFailure, func() {
+	const blockDeletionFinalizer = "test.kueue.x-k8s.io/block-deletion"
+	var (
+		ns             *corev1.Namespace
+		resourceFlavor *kueue.ResourceFlavor
+		clusterQueue   *kueue.ClusterQueue
+		localQueue     *kueue.LocalQueue
+	)
+
+	expectPodsUsage := func(pods int64) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			cq := &kueue.ClusterQueue{}
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(clusterQueue), cq)).Should(gomega.Succeed())
+			g.Expect(cq.Status.FlavorsUsage).Should(gomega.HaveLen(1))
+			resources := cq.Status.FlavorsUsage[0].Resources
+			idx := slices.IndexFunc(resources, func(r kueue.ResourceUsage) bool { return r.Name == corev1.ResourcePods })
+			g.Expect(idx).ShouldNot(gomega.Equal(-1))
+			g.Expect(resources[idx].Total.Value()).Should(gomega.Equal(pods))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	setReclaimTarget := func(wl *kueue.Workload, target int32) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{workersGroupName: target})
+			metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimPreemptorAnnotation, wl.Namespace+"/preemptor")
+			metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimRequestedAtAnnotation, "2026-01-01T00:00:00Z")
+			g.Expect(k8sClient.Update(ctx, wl)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	// expectSlice asserts the worker count, reclaim target, and reclaimable count of wl.
+	expectSlice := func(wl *kueue.Workload, count, target, reclaimable int32) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			g.Expect(wl.Spec.PodSets[workersPodSetIdx].Count).Should(gomega.Equal(count))
+			g.Expect(workload.ReclaimTargetCounts(wl)).Should(gomega.Equal(workload.PodSetsCounts{workersGroupName: target}))
+			g.Expect(workload.ReclaimableCounts(wl)[workersGroupName]).Should(gomega.Equal(reclaimable))
+			g.Expect(workload.IsAdmitted(wl)).Should(gomega.BeTrue())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	scaleWorkers := func(rayCluster *rayv1.RayCluster, replicas int32) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), rayCluster)).Should(gomega.Succeed())
+			rayCluster.Spec.WorkerGroupSpecs[0].Replicas = new(replicas)
+			g.Expect(k8sClient.Update(ctx, rayCluster)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	// createWorker creates a gated worker Pod of wl's slice, as KubeRay does from the
+	// template that Kueue stamped.
+	createWorker := func(rayCluster *rayv1.RayCluster, wl *kueue.Workload, name, replica string) *corev1.Pod {
+		ginkgo.GinkgoHelper()
+		pod := testingpod.MakePod(name, ns.Name).
+			Annotation(kueue.WorkloadAnnotation, wl.Name).
+			Annotation(kueue.WorkloadSliceNameAnnotation, workloadslicing.SliceName(wl)).
+			Label(constants.PodSetLabel, workersGroupName).
+			Label(rayutils.RayWorkerReplicaNameKey, replica).
+			Gate(kueue.ElasticJobSchedulingGate).
+			Obj()
+		pod.OwnerReferences = []metav1.OwnerReference{{
+			APIVersion: rayv1.SchemeGroupVersion.String(),
+			Kind:       "RayCluster",
+			Name:       rayCluster.Name,
+			UID:        rayCluster.UID,
+			Controller: new(true),
+		}}
+		behavioral.MustCreate(ctx, k8sClient, pod)
+		return pod
+	}
+	isGated := func(g gomega.Gomega, pod *corev1.Pod) bool {
+		var got corev1.Pod
+		g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(pod), &got)).Should(gomega.Succeed())
+		return utilpod.HasGate(&got, kueue.ElasticJobSchedulingGate)
+	}
+
+	ginkgo.BeforeAll(func() {
+		features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+			features.ElasticJobsViaWorkloadSlices:                          true,
+			features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+			features.PartialPreemption:                                     true,
+		})
+		fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+	})
+	ginkgo.AfterAll(func() {
+		fwk.StopManager(ctx)
+	})
+
+	ginkgo.BeforeEach(func() {
+		ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "partial-preemption-")
+		resourceFlavor = utiltestingapi.MakeResourceFlavor("default").Obj()
+		behavioral.MustCreate(ctx, k8sClient, resourceFlavor)
+		clusterQueue = utiltestingapi.MakeClusterQueue("default").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas(resourceFlavor.Name).
+				Resource(corev1.ResourcePods, "9").
+				Resource(corev1.ResourceCPU, "100").
+				Obj()).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+		localQueue = utiltestingapi.MakeLocalQueue("default", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+		behavioral.MustCreate(ctx, k8sClient, localQueue)
+	})
+	ginkgo.AfterEach(func() {
+		gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, resourceFlavor, true)
+	})
+
+	ginkgo.It("Should stop whole worker replicas above the target and release their quota only once they are gone", func() {
+		rayCluster := testingraycluster.MakeCluster("victim", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			ScaleFirstWorkerGroup(4).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, rayCluster)
+		wl := &behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)[0]
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, wl, workersGroupName, 4)
+		expectPodsUsage(5)
+
+		ginkgo.By("creating four workers in two replicas, the first one protected by its deletion cost")
+		w0 := createWorker(rayCluster, wl, "w-0", "replica-a")
+		w1 := createWorker(rayCluster, wl, "w-1", "replica-a")
+		w2 := createWorker(rayCluster, wl, "w-2", "replica-b")
+		w3 := createWorker(rayCluster, wl, "w-3", "replica-b")
+		gomega.Eventually(func(g gomega.Gomega) {
+			var got corev1.Pod
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(w0), &got)).Should(gomega.Succeed())
+			metav1.SetMetaDataAnnotation(&got.ObjectMeta, corev1.PodDeletionCost, "1000")
+			g.Expect(k8sClient.Update(ctx, &got)).Should(gomega.Succeed())
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(w3), &got)).Should(gomega.Succeed())
+			got.Finalizers = append(got.Finalizers, blockDeletionFinalizer)
+			g.Expect(k8sClient.Update(ctx, &got)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		gomega.Eventually(func(g gomega.Gomega) {
+			for _, p := range []*corev1.Pod{w0, w1, w2, w3} {
+				g.Expect(isGated(g, p)).Should(gomega.BeFalse(), "pod %s", p.Name)
+			}
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("setting the reclaim target to two workers")
+		setReclaimTarget(wl, 2)
+
+		ginkgo.By("deleting the cheaper replica as a whole and keeping the protected one")
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(apierrors.IsNotFound(k8sClient.Get(ctx, client.ObjectKeyFromObject(w2), &corev1.Pod{}))).Should(gomega.BeTrue())
+			var got corev1.Pod
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(w3), &got)).Should(gomega.Succeed())
+			g.Expect(got.DeletionTimestamp).ShouldNot(gomega.BeNil())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(w0), &corev1.Pod{})).Should(gomega.Succeed())
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(w1), &corev1.Pod{})).Should(gomega.Succeed())
+
+		ginkgo.By("recreating the deleted workers, gated, as KubeRay does")
+		w4 := createWorker(rayCluster, wl, "w-4", "replica-c")
+		w5 := createWorker(rayCluster, wl, "w-5", "replica-c")
+
+		ginkgo.By("keeping the quota while a worker above the target is still terminating")
+		gomega.Consistently(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			g.Expect(wl.Status.ReclaimablePods).Should(gomega.BeEmpty())
+			g.Expect(isGated(g, w4)).Should(gomega.BeTrue())
+			g.Expect(isGated(g, w5)).Should(gomega.BeTrue())
+		}, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+		expectPodsUsage(5)
+
+		ginkgo.By("letting the terminating worker go")
+		gomega.Eventually(func(g gomega.Gomega) {
+			var got corev1.Pod
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(w3), &got)).Should(gomega.Succeed())
+			got.Finalizers = slices.DeleteFunc(got.Finalizers, func(f string) bool { return f == blockDeletionFinalizer })
+			g.Expect(k8sClient.Update(ctx, &got)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("releasing the quota of the two workers above the target")
+		expectSlice(wl, 4, 2, 2)
+		expectPodsUsage(3)
+
+		ginkgo.By("keeping the recreated workers gated")
+		gomega.Consistently(func(g gomega.Gomega) {
+			g.Expect(isGated(g, w4)).Should(gomega.BeTrue())
+			g.Expect(isGated(g, w5)).Should(gomega.BeTrue())
+		}, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+
+		ginkgo.By("keeping the RayCluster's replicas")
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), rayCluster)).Should(gomega.Succeed())
+		gomega.Expect(rayCluster.Spec.WorkerGroupSpecs[0].Replicas).Should(gomega.Equal(new(int32(4))))
+
+		ginkgo.By("releasing the Workload's quota")
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			wl.Spec.Active = new(false)
+			g.Expect(k8sClient.Update(ctx, wl)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		ginkgo.By("clearing the reclaimable pods and the reclaim target annotations")
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			g.Expect(workload.HasQuotaReservation(wl)).Should(gomega.BeFalse())
+			g.Expect(wl.Status.ReclaimablePods).Should(gomega.BeEmpty())
+			g.Expect(wl.Annotations).ShouldNot(gomega.HaveKey(constants.ReclaimTargetCountsAnnotation))
+			g.Expect(wl.Annotations).ShouldNot(gomega.HaveKey(constants.ReclaimPreemptorAnnotation))
+			g.Expect(wl.Annotations).ShouldNot(gomega.HaveKey(constants.ReclaimRequestedAtAnnotation))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	})
+
+	ginkgo.It("Should charge the target when the autoscaler scales down after a reclaim", func() {
+		rayCluster := testingraycluster.MakeCluster("victim", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			ScaleFirstWorkerGroup(8).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, rayCluster)
+		wl := &behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)[0]
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, wl, workersGroupName, 8)
+		expectPodsUsage(9)
+
+		ginkgo.By("shrinking the victim to four workers; no worker runs, so the quota is released at once")
+		setReclaimTarget(wl, 4)
+		expectSlice(wl, 8, 4, 4)
+		expectPodsUsage(5)
+
+		ginkgo.By("scaling the victim to four workers, as the autoscaler does")
+		scaleWorkers(rayCluster, 4)
+		expectSlice(wl, 4, 4, 0)
+		expectPodsUsage(5)
+		gomega.Consistently(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			g.Expect(wl.Spec.PodSets[workersPodSetIdx].Count).Should(gomega.Equal(int32(4)))
+			g.Expect(workload.ReclaimableCounts(wl)[workersGroupName]).Should(gomega.Equal(int32(0)))
+		}, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+		behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)
+	})
+
+	ginkgo.It("Should charge the target when the autoscaler scales down a partially admitted victim after a reclaim", func() {
+		ginkgo.By("lowering the quota to one head and six workers")
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(clusterQueue), clusterQueue)).Should(gomega.Succeed())
+			behavioral.SetResourceNominalQuota(clusterQueue, corev1.ResourcePods, "7")
+			g.Expect(k8sClient.Update(ctx, clusterQueue)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+		rayCluster := testingraycluster.MakeCluster("victim", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			SetAnnotation(constants.ElasticJobScaleUpStrategyAnnotationKey, constants.ElasticJobScaleUpStrategyPartial).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			FirstWorkerGroupReplicas(4, 0, 8).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, rayCluster)
+		initialSlice := &behavioral.ExpectWorkloadsInNamespace(ctx, k8sClient, ns.Name, 1)[0]
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, initialSlice, workersGroupName, 4)
+
+		ginkgo.By("scaling to eight workers, of which six are admitted")
+		scaleWorkers(rayCluster, 8)
+		wl := behavioral.ExpectNewWorkloadSlice(ctx, k8sClient, initialSlice)
+		behavioral.ExpectPodSetAdmittedCount(ctx, k8sClient, wl, workersGroupName, 6)
+		behavioral.ExpectWorkloadToFinish(ctx, k8sClient, client.ObjectKeyFromObject(initialSlice))
+		expectPodsUsage(7)
+		probe := behavioral.ExpectNewWorkloadSlice(ctx, k8sClient, wl)
+
+		ginkgo.By("shrinking the victim to four workers; no worker runs, so the quota is released at once")
+		setReclaimTarget(wl, 4)
+		expectSlice(wl, 8, 4, 4)
+		expectPodsUsage(5)
+
+		ginkgo.By("admitting a preemptor into the released quota")
+		preemptor := testingraycluster.MakeCluster("preemptor", ns.Name).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			ScaleFirstWorkerGroup(1).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, preemptor)
+		expectPodsUsage(7)
+
+		ginkgo.By("scaling the victim to six workers, its admitted count, as the autoscaler does")
+		scaleWorkers(rayCluster, 6)
+		gomega.Consistently(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			g.Expect(wl.Spec.PodSets[workersPodSetIdx].Count).Should(gomega.Equal(int32(8)))
+			g.Expect(workload.ReclaimableCounts(wl)[workersGroupName]).Should(gomega.Equal(int32(4)))
+			g.Expect(workload.IsAdmitted(wl)).Should(gomega.BeTrue())
+		}, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+		expectPodsUsage(7)
+
+		ginkgo.By("scaling the victim to five workers, below its admitted count")
+		scaleWorkers(rayCluster, 5)
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(probe), probe)).Should(gomega.Succeed())
+			g.Expect(probe.Spec.PodSets[workersPodSetIdx].Count).Should(gomega.Equal(int32(5)))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		behavioral.ExpectWorkloadsToBePending(ctx, k8sClient, probe)
+		expectPodsUsage(7)
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+		gomega.Expect(workload.IsAdmitted(wl)).Should(gomega.BeTrue())
+	})
+})
