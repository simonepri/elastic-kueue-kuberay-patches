+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+)
+
+// ReasonPartiallyStopped is the reason of the event recorded on a job whose Pods above
+// the reclaim target counts of partial preemption were stopped.
+const ReasonPartiallyStopped = "PartiallyStopped"
+
+// JobWithPartialStop is implemented by elastic jobs that partial preemption can shrink.
+// Once the Pods above the reclaim targets are gone, the ElasticJobUngater marks them
+// reclaimable, which releases their quota.
+type JobWithPartialStop interface {
+	// StopPartially brings each PodSet in targets down to its target count without changing
+	// the job's desired count, so the recreated pods stay gated. It makes no API call when the
+	// PodSets are already at their targets, and returns whether it stopped any pod.
+	StopPartially(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts) (bool, error)
+}
+
+// stopJobPartially brings an admitted elastic job down to the pending reclaim target
+// counts of partial preemption, and reports whether it stopped any pod.
+func (r *JobReconciler) stopJobPartially(ctx context.Context, job GenericJob, wl *kueue.Workload) (bool, error) {
+	partialJob, ok := job.(JobWithPartialStop)
+	if !ok || !features.Enabled(features.PartialPreemption) || !workload.IsAdmitted(wl) || workloadevict.IsEvicted(wl) {
+		return false, nil
+	}
+	targets := workload.PendingReclaimTargetCounts(wl)
+	if len(targets) == 0 {
+		return false, nil
+	}
+	stopped, err := partialJob.StopPartially(ctx, r.client, wl, targets)
+	if stopped {
+		r.record.Eventf(job.Object(), nil, corev1.EventTypeNormal, ReasonPartiallyStopped, "PartiallyStopped",
+			"Stopping the pods above the reclaim target counts %s of workload '%s'", workload.FormatPodSetCounts(targets), workload.Key(wl))
+	}
+	return stopped, err
+}
