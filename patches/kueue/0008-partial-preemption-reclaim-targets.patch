+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+)
+
+func TestParseAndFormatPodSetCounts(t *testing.T) {
+	testCases := map[string]struct {
+		value      string
+		want       PodSetsCounts
+		wantFormat string
+	}{
+		"empty": {},
+		"sorted by name": {
+			value:      "workers=4,head=1",
+			want:       PodSetsCounts{"head": 1, "workers": 4},
+			wantFormat: "head=1,workers=4",
+		},
+		"malformed entries are ignored": {
+			value:      "a=1,b,c=-1,d=x,=2,e=3",
+			want:       PodSetsCounts{"a": 1, "e": 3},
+			wantFormat: "a=1,e=3",
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			got := ParsePodSetCounts(tc.value)
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("ParsePodSetCounts() (-want,+got):\n%s", diff)
+			}
+			if gotFormat := FormatPodSetCounts(got); gotFormat != tc.wantFormat {
+				t.Errorf("FormatPodSetCounts() = %q, want %q", gotFormat, tc.wantFormat)
+			}
+		})
+	}
+}
+
+// partiallyPreempted returns an admitted workload with one "workers" PodSet.
+func partiallyPreempted(count, admitted int32, targets string, reclaimable ...kueue.ReclaimablePod) *kueue.Workload {
+	wl := &kueue.Workload{
+		Spec: kueue.WorkloadSpec{PodSets: []kueue.PodSet{{Name: "workers", Count: count}}},
+		Status: kueue.WorkloadStatus{
+			Admission:       &kueue.Admission{PodSetAssignments: []kueue.PodSetAssignment{{Name: "workers", Count: &admitted}}},
+			ReclaimablePods: reclaimable,
+		},
+	}
+	if targets != "" {
+		wl.Annotations = map[string]string{constants.ReclaimTargetCountsAnnotation: targets}
+	}
+	return wl
+}
+
+func TestPendingReclaimTargetCounts(t *testing.T) {
+	testCases := map[string]struct {
+		wl   *kueue.Workload
+		want PodSetsCounts
+	}{
+		"no target": {
+			wl: partiallyPreempted(8, 8, ""),
+		},
+		"a target below the charged count is pending": {
+			wl:   partiallyPreempted(8, 8, "workers=4"),
+			want: PodSetsCounts{"workers": 4},
+		},
+		"a released target is not pending": {
+			wl: partiallyPreempted(8, 8, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 4}),
+		},
+		"a target at a partial admission is not pending": {
+			wl: partiallyPreempted(8, 4, "workers=4"),
+		},
+		"a target of an unknown PodSet is ignored": {
+			wl: partiallyPreempted(8, 8, "other=1"),
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			if diff := cmp.Diff(tc.want, PendingReclaimTargetCounts(tc.wl)); diff != "" {
+				t.Errorf("PendingReclaimTargetCounts() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestReclaimablePodsForTargets(t *testing.T) {
+	testCases := map[string]struct {
+		wl   *kueue.Workload
+		want []kueue.ReclaimablePod
+	}{
+		"adds the pods above the target": {
+			wl:   partiallyPreempted(8, 8, "workers=4"),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 4}},
+		},
+		"keeps a larger count": {
+			wl:   partiallyPreempted(8, 8, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 5}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 5}},
+		},
+		"raises a smaller count": {
+			wl:   partiallyPreempted(8, 8, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 1}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 4}},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			got := ReclaimablePodsForTargets(tc.wl, ReclaimTargetCounts(tc.wl))
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("ReclaimablePodsForTargets() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestReclaimablePodsAfterScaleDown(t *testing.T) {
+	testCases := map[string]struct {
+		wl   *kueue.Workload
+		want []kueue.ReclaimablePod
+	}{
+		"scaled to the target": {
+			wl:   partiallyPreempted(4, 8, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 4}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 0}},
+		},
+		"a partially admitted victim scaled below its admitted count": {
+			wl:   partiallyPreempted(5, 6, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 4}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 1}},
+		},
+		"not scaled below the admitted count": {
+			wl:   partiallyPreempted(8, 6, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 4}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 4}},
+		},
+		"already charged the target": {
+			wl:   partiallyPreempted(5, 6, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 1}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 1}},
+		},
+		"a pending target": {
+			wl:   partiallyPreempted(6, 8, "workers=4", kueue.ReclaimablePod{Name: "workers", Count: 1}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 1}},
+		},
+		"no target": {
+			wl:   partiallyPreempted(4, 8, "", kueue.ReclaimablePod{Name: "workers", Count: 4}),
+			want: []kueue.ReclaimablePod{{Name: "workers", Count: 4}},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			if diff := cmp.Diff(tc.want, ReclaimablePodsAfterScaleDown(tc.wl)); diff != "" {
+				t.Errorf("ReclaimablePodsAfterScaleDown() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestClearReclaimTargets(t *testing.T) {
+	wl := partiallyPreempted(8, 8, "workers=4")
+	wl.Annotations[constants.ReclaimPreemptorAnnotation] = "ns/preemptor"
+	wl.Annotations[constants.ReclaimRequestedAtAnnotation] = "2026-01-01T00:00:00Z"
+	wl.Annotations["other"] = "kept"
+	if !ClearReclaimTargets(wl) {
+		t.Errorf("ClearReclaimTargets() = false, want true")
+	}
+	if diff := cmp.Diff(map[string]string{"other": "kept"}, wl.Annotations); diff != "" {
+		t.Errorf("Annotations (-want,+got):\n%s", diff)
+	}
+	if ClearReclaimTargets(wl) {
+		t.Errorf("ClearReclaimTargets() = true on a cleared workload, want false")
+	}
+	if IsPartiallyPreempted(wl) {
+		t.Errorf("IsPartiallyPreempted() = true on a cleared workload")
+	}
+}
