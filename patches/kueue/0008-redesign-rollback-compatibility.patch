+
+package raycluster
+
+import (
+	"context"
+
+	admissionv1 "k8s.io/api/admission/v1"
+	"sigs.k8s.io/controller-runtime/pkg/webhook/admission"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/util/equality"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// TODO(simonepri): remove this file, its test, equality.WithIgnoreMinCount, the
+// RollbackMinCountOptions calls of RayCluster, RayJob and RayService, and the
+// isRollbackUpdate call in Default once rolling back from the redesigned patch set
+// to this release is no longer supported.
+
+// RollbackMinCountOptions keeps a Ray job running when its Workload holds quota that
+// the redesigned patch set reserved. That patch set gives worker groups no minCount,
+// while this release sets every worker group's minCount to its minReplicas, so the
+// Workload would stop matching the job and the running job would be suspended. MinCount
+// only decides the pod count a Workload may be admitted with, so it cannot change what
+// a Workload holding quota runs. Once the quota is released, the job reconciler
+// replaces the Workload's PodSets with the job's.
+func RollbackMinCountOptions(wl *kueue.Workload) []equality.ComparePodSetsOption {
+	if wl == nil || !workload.HasQuotaReservation(wl) {
+		return nil
+	}
+	return []equality.ComparePodSetsOption{equality.WithIgnoreMinCount()}
+}
+
+// isRollbackUpdate reports whether the defaulting webhook is called for an update.
+// This release registers mraycluster.kb.io for CREATE only, but the redesigned patch
+// set adds UPDATE to its rule. Applying the create-time defaults to an update could
+// suspend a running RayCluster, so updates are left unchanged.
+func isRollbackUpdate(ctx context.Context) bool {
+	req, err := admission.RequestFromContext(ctx)
+	return err == nil && req.Operation == admissionv1.Update
+}
