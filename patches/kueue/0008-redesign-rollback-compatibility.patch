+// TestRollbackDefaultSkipsUpdates checks that the defaulting webhook leaves a running
+// queued RayCluster running when the redesigned patch set registered it for updates,
+// while it still suspends a new one.
+func TestRollbackDefaultSkipsUpdates(t *testing.T) {
+	cases := map[string]struct {
+		operation   admissionv1.Operation
+		wantSuspend bool
+	}{
+		"update": {operation: admissionv1.Update},
+		"create": {operation: admissionv1.Create, wantSuspend: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			ctx = admission.NewContextWithRequest(ctx, admission.Request{
+				AdmissionRequest: admissionv1.AdmissionRequest{Operation: tc.operation},
+			})
+			cli := utiltesting.NewClientBuilder().Build()
+			cqCache := schdcache.New(cli)
+			wh := &RayClusterWebhook{
+				client: cli,
+				queues: qcache.NewManagerForUnitTests(cli, cqCache),
+				cache:  cqCache,
+			}
+			rc := testingrayutil.MakeCluster("job", "ns").Queue("queue").Suspend(false).Obj()
+			if err := wh.Default(ctx, rc); err != nil {
+				t.Fatalf("Default() error: %v", err)
+			}
+			if got := ptr.Deref(rc.Spec.Suspend, false); got != tc.wantSuspend {
+				t.Errorf("suspend = %t, want %t", got, tc.wantSuspend)
+			}
+		})
+	}
+}
