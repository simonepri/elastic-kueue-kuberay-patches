+// Defines annotations used for partial preemption and worker reclaim coordination.
+package constants
+
+const (
+	// ReclaimTargetCountsAnnotation is set by Kueue on a workload slice that partial
+	// preemption shrinks. Its value lists the pod count that each shrunk PodSet goes
+	// down to, as "<podSet>=<count>[,<podSet>=<count>]". The Pods above it are stopped,
+	// and once they are gone, they are marked reclaimable, which releases their quota.
+	ReclaimTargetCountsAnnotation = "kueue.x-k8s.io/reclaim-target-counts"
+
+	// ReclaimPreemptorAnnotation records the "<namespace>/<name>" of the Workload that
+	// set the reclaim target counts.
+	ReclaimPreemptorAnnotation = "kueue.x-k8s.io/reclaim-preemptor"
+
+	// ReclaimRequestedAtAnnotation records, in RFC 3339, when the reclaim target counts
+	// were first set.
+	ReclaimRequestedAtAnnotation = "kueue.x-k8s.io/reclaim-requested-at"
+
+	// ReclaimGenerationAnnotation counts the requests that set or lowered the reclaim
+	// target counts. It tells apart two requests made within the same second, which
+	// ReclaimRequestedAtAnnotation cannot.
+	ReclaimGenerationAnnotation = "kueue.x-k8s.io/reclaim-generation"
+
+	// ReclaimStoppedAtAnnotation records the identity of the reclaim request whose
+	// workers the job controller has stopped, which is its ReclaimRequestedAtAnnotation
+	// value followed by "#" and its ReclaimGenerationAnnotation value when it has one, so
+	// it stops them once even if their quota was released before it looked.
+	ReclaimStoppedAtAnnotation = "kueue.x-k8s.io/reclaim-stopped-at"
+)
