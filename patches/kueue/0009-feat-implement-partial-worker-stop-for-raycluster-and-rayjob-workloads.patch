+func TestStopWorkersAbove(t *testing.T) {
+	testCases := map[string]struct {
+		replicas, minReplicas, numOfHosts int32
+		listed                            []string
+		pods, gated                       int
+		target                            int32
+		noCluster                         bool
+		wantReplicas                      int32
+		wantWorkersToDelete               []string
+		wantPods                          int
+		wantStopped                       bool
+	}{
+		"a single-host group ends at the target": {
+			replicas: 4, pods: 4, target: 1,
+			wantReplicas: 1, wantWorkersToDelete: []string{"w-1", "w-2", "w-3"}, wantPods: 4, wantStopped: true,
+		},
+		"the replicas of a multi-host group go down by whole replicas": {
+			replicas: 2, numOfHosts: 2, pods: 4, target: 2,
+			wantReplicas: 1, wantWorkersToDelete: []string{"w-2", "w-3"}, wantPods: 4, wantStopped: true,
+		},
+		"the replicas stop at minReplicas": {
+			replicas: 3, minReplicas: 2, pods: 3, target: 0,
+			wantReplicas: 2, wantWorkersToDelete: []string{"w-0", "w-1", "w-2"}, wantPods: 3, wantStopped: true,
+		},
+		"a worker already listed for deletion is not stopped again": {
+			replicas: 3, listed: []string{"w-3"}, pods: 4, target: 2,
+			wantReplicas: 2, wantWorkersToDelete: []string{"w-2", "w-3"}, wantPods: 4, wantStopped: true,
+		},
+		"replicas above the running workers end at the target too": {
+			replicas: 6, pods: 4, target: 2,
+			wantReplicas: 2, wantWorkersToDelete: []string{"w-2", "w-3"}, wantPods: 4, wantStopped: true,
+		},
+		"a gated worker the lowered replicas leave no room for is listed too": {
+			replicas: 3, pods: 3, gated: 1, target: 1,
+			wantReplicas: 1, wantWorkersToDelete: []string{"g-0", "w-1", "w-2"}, wantPods: 4, wantStopped: true,
+		},
+		"replicas above the running workers are lowered even with nothing to stop": {
+			replicas: 4, pods: 2, target: 2,
+			wantReplicas: 2, wantPods: 2,
+		},
+		"a group at its target is left alone": {
+			replicas: 2, pods: 2, target: 2,
+			wantReplicas: 2, wantPods: 2,
+		},
+		"the workers are deleted directly without a RayCluster": {
+			noCluster: true, pods: 4, target: 2, wantPods: 2, wantStopped: true,
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			now := time.Now().Truncate(time.Second)
+			wl := utiltestingapi.MakeWorkload("wl", "ns").Obj()
+			cluster := &rayv1.RayCluster{
+				ObjectMeta: metav1.ObjectMeta{Name: "job", Namespace: "ns"},
+				Spec: rayv1.RayClusterSpec{WorkerGroupSpecs: []rayv1.WorkerGroupSpec{{
+					GroupName:     "workers",
+					Replicas:      ptr.To(tc.replicas),
+					MinReplicas:   ptr.To(tc.minReplicas),
+					MaxReplicas:   ptr.To(int32(10)),
+					NumOfHosts:    tc.numOfHosts,
+					ScaleStrategy: rayv1.ScaleStrategy{WorkersToDelete: tc.listed},
+				}}},
+			}
+			hosts := max(tc.numOfHosts, 1)
+			var objs []client.Object
+			for i := range tc.pods {
+				objs = append(objs, testingpod.MakePod("w-"+string(rune('0'+i)), "ns").
+					Annotation(kueue.WorkloadSliceNameAnnotation, wl.Name).
+					Label(constants.PodSetLabel, "workers").
+					Label(rayutils.RayNodeGroupLabelKey, "workers").
+					Label(rayutils.RayWorkerReplicaNameKey, "replica-"+string(rune('0'+int32(i)/hosts))).
+					CreationTimestamp(now.Add(time.Duration(i)*time.Second)).
+					Obj())
+			}
+			for i := range tc.gated {
+				objs = append(objs, testingpod.MakePod("g-"+string(rune('0'+i)), "ns").
+					Annotation(kueue.WorkloadSliceNameAnnotation, wl.Name).
+					Label(constants.PodSetLabel, "workers").
+					Label(rayutils.RayNodeGroupLabelKey, "workers").
+					Label(rayutils.RayWorkerReplicaNameKey, "replica-g"+string(rune('0'+i))).
+					CreationTimestamp(now.Add(time.Hour)).
+					Gate(kueue.ElasticJobSchedulingGate).
+					Obj())
+			}
+			if !tc.noCluster {
+				objs = append(objs, cluster)
+			}
+			kClient := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(objs...).
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).Build()
+
+			stopped, err := StopWorkersAbove(ctx, kClient, wl, workload.PodSetsCounts{"workers": tc.target}, client.ObjectKeyFromObject(cluster))
+			if err != nil {
+				t.Fatalf("StopWorkersAbove() error: %v", err)
+			}
+			if stopped != tc.wantStopped {
+				t.Errorf("StopWorkersAbove() = %v, want %v", stopped, tc.wantStopped)
+			}
+			var pods corev1.PodList
+			if err := kClient.List(ctx, &pods); err != nil {
+				t.Fatalf("List() error: %v", err)
+			}
+			if len(pods.Items) != tc.wantPods {
+				t.Errorf("Pods = %d, want %d", len(pods.Items), tc.wantPods)
+			}
+			if tc.noCluster {
+				return
+			}
+			var got rayv1.RayCluster
+			if err := kClient.Get(ctx, client.ObjectKeyFromObject(cluster), &got); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			group := got.Spec.WorkerGroupSpecs[0]
+			if gotReplicas := ptr.Deref(group.Replicas, -1); gotReplicas != tc.wantReplicas {
+				t.Errorf("Replicas = %d, want %d", gotReplicas, tc.wantReplicas)
+			}
+			wantListed := tc.wantWorkersToDelete
+			if wantListed == nil {
+				wantListed = tc.listed
+			}
+			if diff := cmp.Diff(wantListed, group.ScaleStrategy.WorkersToDelete); diff != "" {
+				t.Errorf("WorkersToDelete (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestReconcileLowersReplicasOnceWhenTheQuotaIsAlreadyReleased(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	ctx, _ := utiltesting.ContextWithLog(t)
+	now := time.Now().Truncate(time.Second)
+	requestedAt := now.UTC().Format(time.RFC3339)
+
+	job := testingrayutil.MakeCluster("job", "ns").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Suspend(false).
+		Queue("lq").
+		RequestWorkerGroup(corev1.ResourceCPU, "1").
+		ScaleFirstWorkerGroup(4).
+		Obj()
+	podSets, err := (*RayCluster)(job).PodSets(ctx, nil)
+	if err != nil {
+		t.Fatalf("PodSets() error: %v", err)
+	}
+	workers := podSets[1].Name
+	// Nothing ran above the target, so its quota is already released.
+	wl := utiltestingapi.MakeWorkload("wl", "ns").
+		Finalizers(kueue.ResourceInUseFinalizerName).
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Annotation(constants.ReclaimTargetCountsAnnotation, workload.FormatPodSetCounts(workload.PodSetsCounts{workers: 2})).
+		Annotation(constants.ReclaimRequestedAtAnnotation, requestedAt).
+		ControllerReference(gvk, job.Name, string(job.UID)).
+		PodSets(podSets...).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(podSets[0].Name).Obj(),
+			utiltestingapi.MakePodSetAssignment(workers).Count(4).Obj(),
+		).Obj(), now).
+		AdmittedAt(true, now).
+		ReclaimablePods(kueue.ReclaimablePod{Name: workers, Count: 2}).
+		Obj()
+	builder := utiltesting.NewClientBuilder(rayv1.AddToScheme).
+		WithObjects(utiltesting.MakeNamespace("ns"), job, wl).
+		WithStatusSubresource(wl).
+		WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName)
+	indexer := utiltesting.AsIndexer(builder)
+	if err := SetupIndexes(ctx, indexer); err != nil {
+		t.Fatalf("SetupIndexes() error: %v", err)
+	}
+	kClient := builder.Build()
+	reconciler, err := NewReconciler(ctx, kClient, indexer, &utiltesting.EventRecorder{})
+	if err != nil {
+		t.Fatalf("NewReconciler() error: %v", err)
+	}
+	request := reconcile.Request{NamespacedName: client.ObjectKeyFromObject(job)}
+	replicas := func() int32 {
+		var got rayv1.RayCluster
+		if err := kClient.Get(ctx, client.ObjectKeyFromObject(job), &got); err != nil {
+			t.Fatalf("Get() error: %v", err)
+		}
+		return ptr.Deref(got.Spec.WorkerGroupSpecs[0].Replicas, -1)
+	}
+
+	if _, err := reconciler.Reconcile(ctx, request); err != nil {
+		t.Fatalf("Reconcile() error: %v", err)
+	}
+	if got := replicas(); got != 2 {
+		t.Errorf("Replicas after reconcile = %d, want 2", got)
+	}
+	var gotWl kueue.Workload
+	if err := kClient.Get(ctx, client.ObjectKeyFromObject(wl), &gotWl); err != nil {
+		t.Fatalf("Get() error: %v", err)
+	}
+	if got := gotWl.Annotations[constants.ReclaimStoppedAtAnnotation]; got != requestedAt {
+		t.Errorf("%s = %q, want %q", constants.ReclaimStoppedAtAnnotation, got, requestedAt)
+	}
+
+	// The autoscaler asks for workers again; the request is already handled.
+	var cluster rayv1.RayCluster
+	if err := kClient.Get(ctx, client.ObjectKeyFromObject(job), &cluster); err != nil {
+		t.Fatalf("Get() error: %v", err)
+	}
+	cluster.Spec.WorkerGroupSpecs[0].Replicas = ptr.To[int32](4)
+	if err := kClient.Update(ctx, &cluster); err != nil {
+		t.Fatalf("Update() error: %v", err)
+	}
+	if _, err := reconciler.Reconcile(ctx, request); err != nil {
+		t.Fatalf("second Reconcile() error: %v", err)
+	}
+	if got := replicas(); got != 4 {
+		t.Errorf("Replicas after the second reconcile = %d, want 4", got)
+	}
+}
