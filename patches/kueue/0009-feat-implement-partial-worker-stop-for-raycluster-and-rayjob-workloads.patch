+func TestReclaimTargetsStale(t *testing.T) {
+	reservedAt := time.Date(2026, 1, 1, 12, 0, 0, 0, time.UTC)
+	testCases := map[string]struct {
+		requestedAt string
+		reserved    bool
+		reclaimable []kueue.ReclaimablePod
+		wantStale   bool
+	}{
+		"requested before the current reservation, which inherited the reclaimable pods": {
+			requestedAt: reservedAt.Add(-time.Minute).Format(time.RFC3339),
+			reserved:    true,
+			reclaimable: []kueue.ReclaimablePod{{Name: "workers", Count: 4}},
+		},
+		"requested before the current reservation, with only another PodSet's reclaimable pods": {
+			requestedAt: reservedAt.Add(-time.Minute).Format(time.RFC3339),
+			reserved:    true,
+			reclaimable: []kueue.ReclaimablePod{{Name: "other", Count: 1}, {Name: "workers", Count: 0}},
+			wantStale:   true,
+		},
+		"requested during the current reservation": {
+			requestedAt: reservedAt.Add(time.Minute).Format(time.RFC3339),
+			reserved:    true,
+		},
+		"requested in the second the quota was reserved": {
+			requestedAt: reservedAt.Add(500 * time.Millisecond).Format(time.RFC3339Nano),
+			reserved:    true,
+		},
+		"requested before the current reservation": {
+			requestedAt: reservedAt.Add(-time.Minute).Format(time.RFC3339),
+			reserved:    true,
+			wantStale:   true,
+		},
+		"without a reservation": {
+			requestedAt: reservedAt.Add(-time.Minute).Format(time.RFC3339),
+		},
+		"without a valid requested-at time": {
+			requestedAt: "yesterday",
+			reserved:    true,
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			wl := partiallyPreempted(8, 8, "workers=4", tc.reclaimable...)
+			wl.Annotations[constants.ReclaimRequestedAtAnnotation] = tc.requestedAt
+			status := metav1.ConditionFalse
+			if tc.reserved {
+				status = metav1.ConditionTrue
+			}
+			wl.Status.Conditions = []metav1.Condition{{
+				Type:               kueue.WorkloadQuotaReserved,
+				Status:             status,
+				LastTransitionTime: metav1.NewTime(reservedAt),
+			}}
+			if got := ReclaimTargetsStale(wl); got != tc.wantStale {
+				t.Errorf("ReclaimTargetsStale() = %v, want %v", got, tc.wantStale)
+			}
+			wantTargets := PodSetsCounts{"workers": 4}
+			if tc.wantStale {
+				wantTargets = nil
+			}
+			if diff := cmp.Diff(wantTargets, ReclaimTargetCounts(wl)); diff != "" {
+				t.Errorf("ReclaimTargetCounts() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
