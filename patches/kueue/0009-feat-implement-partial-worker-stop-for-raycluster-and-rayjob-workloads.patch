+// Implements partial worker stopping and step-aligned reclaim floors for RayCluster workloads.
+package raycluster
+
+import (
+	"context"
+	"maps"
+	"slices"
+
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	rayutils "github.com/ray-project/kuberay/ray-operator/controllers/ray/utils"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/utils/ptr"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/controller/jobframework"
+	"sigs.k8s.io/kueue/pkg/features"
+	clientutil "sigs.k8s.io/kueue/pkg/util/client"
+	utilpod "sigs.k8s.io/kueue/pkg/util/pod"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+var _ jobframework.JobWithPartialStop = (*RayCluster)(nil)
+
+// StopPartially stops the running worker Pods above the reclaim targets in whole
+// worker group replicas, the cheapest by pod deletion cost first, then the newest.
+// It lowers each worker group to its target and lists
+// their Pods in the group's scaleStrategy.workersToDelete, so KubeRay removes
+// exactly those Pods and does not recreate them, and the Ray autoscaler starts
+// from the lower replicas.
+func (j *RayCluster) StopPartially(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts) (bool, error) {
+	return StopWorkersAbove(ctx, c, wl, targets, types.NamespacedName{Namespace: j.Namespace, Name: j.Name})
+}
+
+// StopWorkersAbove stops the worker Pods above the reclaim targets through the
+// RayCluster key, as RayCluster.StopPartially does, and lowers each worker group that
+// has a target to it even when no Pod runs above it. Pods of a worker group that the
+// RayCluster does not list, or of a RayCluster that does not exist, are deleted
+// directly. It returns whether it changed the RayCluster or stopped any Pod.
+func StopWorkersAbove(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts, key types.NamespacedName) (bool, error) {
+	cluster := &rayv1.RayCluster{}
+	if err := c.Get(ctx, key, cluster); err != nil {
+		if !apierrors.IsNotFound(err) {
+			return false, err
+		}
+		return DeleteWorkersAbove(ctx, c, wl, targets)
+	}
+	leaving := sets.New[string]()
+	for i := range cluster.Spec.WorkerGroupSpecs {
+		leaving.Insert(cluster.Spec.WorkerGroupSpecs[i].ScaleStrategy.WorkersToDelete...)
+	}
+	pods, err := workloadslicing.PodGroupsAboveCounts(ctx, c, wl, targets, workerReplicaName, func(p *corev1.Pod) bool { return leaving.Has(p.Name) })
+	if err != nil {
+		return false, err
+	}
+	byGroup := make(map[string][]*corev1.Pod)
+	for _, p := range pods {
+		group := workerGroupName(p)
+		byGroup[group] = append(byGroup[group], p)
+	}
+	groupTargets := targets
+	slicePods, err := workloadslicing.ListPodsForWorkloadSlice(ctx, c, wl.Namespace, workloadslicing.SliceName(wl))
+	if err != nil {
+		return false, err
+	}
+	stopping := sets.New[string]()
+	for _, p := range pods {
+		stopping.Insert(p.Name)
+	}
+	staying := make(map[string][]*corev1.Pod)
+	for _, p := range slicePods {
+		if p.DeletionTimestamp == nil && !utilpod.IsTerminated(p) && !stopping.Has(p.Name) && !leaving.Has(p.Name) &&
+			p.Labels[constants.PodSetLabel] != "" && p.Labels[rayutils.RayNodeTypeLabelKey] != string(rayv1.HeadNode) {
+			staying[workerGroupName(p)] = append(staying[workerGroupName(p)], p)
+		}
+	}
+	var unlisted []*corev1.Pod
+	err = clientutil.Patch(ctx, c, cluster, func() (bool, error) {
+		unlisted = unlisted[:0]
+		changed := false
+		for i := range cluster.Spec.WorkerGroupSpecs {
+			wgs := &cluster.Spec.WorkerGroupSpecs[i]
+			var target *int32
+			if count, found := groupTargets[kueue.NewPodSetReference(wgs.GroupName)]; found {
+				target = &count
+			}
+			if target == nil && len(byGroup[wgs.GroupName]) == 0 {
+				continue
+			}
+			changed = lowerWorkerGroup(wgs, byGroup[wgs.GroupName], target, staying[wgs.GroupName]) || changed
+		}
+		for group, groupPods := range byGroup {
+			if !slices.ContainsFunc(cluster.Spec.WorkerGroupSpecs, func(wgs rayv1.WorkerGroupSpec) bool { return wgs.GroupName == group }) {
+				unlisted = append(unlisted, groupPods...)
+			}
+		}
+		return changed, nil
+	}, clientutil.WithRetryOnConflict())
+	if err != nil {
+		return false, err
+	}
+	for _, p := range unlisted {
+		if err := c.Delete(ctx, p); client.IgnoreNotFound(err) != nil {
+			return true, err
+		}
+	}
+	return len(pods) > 0, nil
+}
+
+// DeleteWorkersAbove deletes the worker Pods above the reclaim targets directly, in
+// whole worker group replicas, and leaves the RayCluster as it is: KubeRay recreates
+// them, and they stay gated until the slice has room for them again.
+func DeleteWorkersAbove(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts) (bool, error) {
+	return workloadslicing.DeletePodGroupsAboveCounts(ctx, c, wl, targets, workerReplicaName)
+}
+
+// lowerWorkerGroup brings the worker group down to the reclaim target of its Pods, when
+// it has one, and otherwise by the replicas of pods, never below its minReplicas, and
+// lists pods in its workersToDelete, and reports whether it changed the group. KubeRay deletes a Pod of its choice when the group
+// has more Pods than replicas, which could be a running one, so it also lists the gated
+// Pods of staying, the newest replicas first, that the lowered replicas leave no room for.
+func lowerWorkerGroup(wgs *rayv1.WorkerGroupSpec, pods []*corev1.Pod, target *int32, staying []*corev1.Pod) bool {
+	hosts := max(wgs.NumOfHosts, 1)
+	leaving := sets.New(wgs.ScaleStrategy.WorkersToDelete...)
+	for _, p := range pods {
+		leaving.Insert(p.Name)
+	}
+	minReplicas := ptr.Deref(wgs.MinReplicas, 0)
+	current := max(ptr.Deref(wgs.Replicas, minReplicas), minReplicas)
+	if wgs.MaxReplicas != nil {
+		current = min(current, *wgs.MaxReplicas)
+	}
+	lowered := current - (int32(len(pods))+hosts-1)/hosts
+	if target != nil {
+		lowered = min(current, (*target+hosts-1)/hosts)
+	}
+	replicas := max(lowered, minReplicas)
+	changed := false
+	if replicas < current {
+		wgs.Replicas = ptr.To(replicas)
+		changed = true
+	} else {
+		replicas = current
+	}
+	excess := len(staying) - int(replicas*hosts)
+	for _, p := range slices.SortedFunc(slices.Values(staying), func(a, b *corev1.Pod) int { return -a.CreationTimestamp.Compare(b.CreationTimestamp.Time) }) {
+		if excess <= 0 {
+			break
+		}
+		if !utilpod.HasGate(p, kueue.ElasticJobSchedulingGate) || leaving.Has(p.Name) {
+			continue
+		}
+		for _, sibling := range staying {
+			if workerReplicaName(sibling) == workerReplicaName(p) && !leaving.Has(sibling.Name) {
+				leaving.Insert(sibling.Name)
+				excess--
+			}
+		}
+	}
+	listed := slices.Sorted(maps.Keys(leaving))
+	changed = changed || !slices.Equal(listed, wgs.ScaleStrategy.WorkersToDelete)
+	wgs.ScaleStrategy.WorkersToDelete = listed
+	return changed
+}
+
+// workerGroupName returns the worker group a Pod belongs to, which is the name of
+// its PodSet unless the PodSet is a split entry of the group.
+func workerGroupName(p *corev1.Pod) string {
+	if name := p.Labels[rayutils.RayNodeGroupLabelKey]; name != "" {
+		return name
+	}
+	return p.Labels[constants.PodSetLabel]
+}
+
+// workerReplicaName returns the worker group replica a Pod belongs to; the Pods of
+// a multi-host replica share it. A Pod without one is a replica of its own.
+func workerReplicaName(p *corev1.Pod) string {
+	if name, found := p.Labels[rayutils.RayWorkerReplicaNameKey]; found && name != "" {
+		return name
+	}
+	return p.Name
+}
+
+// readyWithHeadPod reports whether the readiness of the RayCluster is that of its
+// head Pod, as with the RayClusterHeadPodReady gate: while partial preemption shrinks
+// an elastic RayCluster, the workers it recreates stay gated, so the cluster may
+// never reach the Ready state, and waitForPodsReady would then evict it whole.
+// Without a reclaim target on its Workload, the cluster must reach the Ready state.
+func readyWithHeadPod(j *RayCluster, opts ...jobframework.PodsReadyOption) bool {
+	if !features.Enabled(features.PartialPreemption) || !workloadslicing.Enabled(j) {
+		return false
+	}
+	wl := jobframework.PodsReadyWorkload(opts...)
+	return wl != nil && len(workload.ReclaimTargetCounts(wl)) > 0
+}
