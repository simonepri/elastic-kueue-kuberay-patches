+func TestPodsReadyWithPartialPreemption(t *testing.T) {
+	testCases := map[string]struct {
+		partialPreemption bool
+		elastic           bool
+		target            bool
+		want              bool
+	}{
+		"a shrinking elastic RayCluster is ready with its head pod": {
+			partialPreemption: true,
+			elastic:           true,
+			target:            true,
+			want:              true,
+		},
+		"an elastic RayCluster without a target whose workers never start is not ready": {
+			partialPreemption: true,
+			elastic:           true,
+		},
+		"a RayCluster that is not elastic waits for the Ready state": {
+			partialPreemption: true,
+			target:            true,
+		},
+		"without the gate a shrinking elastic RayCluster waits for the Ready state": {
+			elastic: true,
+			target:  true,
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, tc.partialPreemption)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			// The head is ready, but the workers never start, so KubeRay never reports Ready.
+			job := testingrayutil.MakeCluster("job", "ns").
+				StatusConditions(metav1.Condition{Type: string(rayv1.HeadPodReady), Status: metav1.ConditionTrue}).
+				Obj()
+			if tc.elastic {
+				metav1.SetMetaDataAnnotation(&job.ObjectMeta, workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue)
+			}
+			wl := utiltestingapi.MakeWorkload("wl", "ns").Obj()
+			if tc.target {
+				workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{"workers-group-0": 1})
+			}
+			if got := (*RayCluster)(job).PodsReady(ctx, nil, jobframework.WithWorkload(wl)); got != tc.want {
+				t.Errorf("PodsReady() = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestReconcileClearsReclaimedPodsWhenEvictionReleasesQuota(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	ctx, _ := utiltesting.ContextWithLog(t)
+	now := time.Now().Truncate(time.Second)
+
+	job := testingrayutil.MakeCluster("job", "ns").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Suspend(true).
+		Queue("lq").
+		RequestWorkerGroup(corev1.ResourceCPU, "1").
+		ScaleFirstWorkerGroup(8).
+		Obj()
+	podSets, err := (*RayCluster)(job).PodSets(ctx, nil)
+	if err != nil {
+		t.Fatalf("PodSets() error: %v", err)
+	}
+	workers := podSets[1].Name
+	wl := utiltestingapi.MakeWorkload("wl", "ns").
+		Finalizers(kueue.ResourceInUseFinalizerName).
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Annotation(constants.ReclaimTargetCountsAnnotation, workload.FormatPodSetCounts(workload.PodSetsCounts{workers: 4})).
+		Annotation(constants.ReclaimRequestedAtAnnotation, now.Format(time.RFC3339)).
+		ControllerReference(gvk, job.Name, string(job.UID)).
+		PodSets(podSets...).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(podSets[0].Name).Obj(),
+			utiltestingapi.MakePodSetAssignment(workers).Count(8).Obj(),
+		).Obj(), now).
+		AdmittedAt(true, now).
+		EvictedAt(now).
+		ReclaimablePods(kueue.ReclaimablePod{Name: workers, Count: 4}).
+		Obj()
+	builder := utiltesting.NewClientBuilder(rayv1.AddToScheme).
+		WithObjects(utiltesting.MakeNamespace("ns"), job, wl).
+		WithStatusSubresource(wl).
+		WithInterceptorFuncs(interceptor.Funcs{SubResourceApply: utiltesting.TreatSSAAsStrategicMergeForApplyConfiguration})
+	indexer := utiltesting.AsIndexer(builder)
+	if err := SetupIndexes(ctx, indexer); err != nil {
+		t.Fatalf("SetupIndexes() error: %v", err)
+	}
+	kClient := builder.Build()
+	reconciler, err := NewReconciler(ctx, kClient, indexer, &utiltesting.EventRecorder{})
+	if err != nil {
+		t.Fatalf("NewReconciler() error: %v", err)
+	}
+	if _, err := reconciler.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(job)}); err != nil {
+		t.Fatalf("Reconcile() error: %v", err)
+	}
+	var got kueue.Workload
+	if err := kClient.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+		t.Fatalf("Get() error: %v", err)
+	}
+	if workload.HasQuotaReservation(&got) {
+		t.Fatalf("The eviction did not release the quota")
+	}
+	if len(got.Status.ReclaimablePods) != 0 {
+		t.Errorf("Reclaimable pods = %v, want none in the same reconcile that released the quota", got.Status.ReclaimablePods)
+	}
+}
