+// Tests RayJob reclaim boundaries and readiness while replacement workers stay gated.
+
+package rayjob
+
+import (
+	"reflect"
+	"testing"
+
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/utils/ptr"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	coreindexer "sigs.k8s.io/kueue/pkg/controller/core/indexer"
+	"sigs.k8s.io/kueue/pkg/controller/jobframework"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	api "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+func TestReclaimRayJobWorkers(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	job := &RayJob{Spec: rayv1.RayJobSpec{RayClusterSpec: &rayv1.RayClusterSpec{WorkerGroupSpecs: []rayv1.WorkerGroupSpec{{GroupName: "workers", Replicas: ptr.To[int32](4), MinReplicas: ptr.To[int32](1), NumOfHosts: 2}}}}}
+	if got := job.PodSetCountSteps(); !reflect.DeepEqual(got, workload.PodSetsCounts{"workers": 2}) {
+		t.Fatalf("steps=%v", got)
+	}
+	wl := api.MakeWorkload("slice", "ns").Obj()
+	objs := []client.Object{}
+	for name, entry := range map[string]string{"a": "workers", "b": "workers--2", "head": "head", "submitter": "submitter"} {
+		objs = append(objs, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "ns", Annotations: map[string]string{kueue.WorkloadSliceNameAnnotation: wl.Name}, Labels: map[string]string{constants.PodSetLabel: entry}}})
+	}
+	c := utiltesting.NewClientBuilder().WithObjects(objs...).WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).Build()
+	if _, err := job.StopPartially(ctx, c, wl, workload.PodSetsCounts{"workers": 0}); err != nil {
+		t.Fatal(err)
+	}
+	var pods corev1.PodList
+	if err := c.List(ctx, &pods); err != nil {
+		t.Fatal(err)
+	}
+	if len(pods.Items) != 3 {
+		t.Fatalf("remaining pods=%v", pods.Items)
+	}
+	for _, p := range pods.Items {
+		if p.Name == "a" {
+			t.Fatal("reclaimed entry survived")
+		}
+	}
+}
+
+func TestRayJobStopsWorkersThroughItsRayCluster(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	spec := &rayv1.RayClusterSpec{
+		EnableInTreeAutoscaling: ptr.To(true),
+		WorkerGroupSpecs:        []rayv1.WorkerGroupSpec{{GroupName: "workers", Replicas: ptr.To[int32](2)}},
+	}
+	job := &RayJob{
+		ObjectMeta: metav1.ObjectMeta{Name: "job", Namespace: "ns"},
+		Spec:       rayv1.RayJobSpec{RayClusterSpec: spec},
+		Status:     rayv1.RayJobStatus{RayClusterName: "job-abcde"},
+	}
+	child := &rayv1.RayCluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "job-abcde", Namespace: "ns"},
+		Spec:       rayv1.RayClusterSpec{WorkerGroupSpecs: []rayv1.WorkerGroupSpec{{GroupName: "workers", Replicas: ptr.To[int32](2)}}},
+	}
+	wl := api.MakeWorkload("slice", "ns").Obj()
+	var objs []client.Object
+	objs = append(objs, child)
+	for _, name := range []string{"a", "b"} {
+		objs = append(objs, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "ns", Annotations: map[string]string{kueue.WorkloadSliceNameAnnotation: wl.Name}, Labels: map[string]string{constants.PodSetLabel: "workers"}}})
+	}
+	c := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(objs...).WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).Build()
+	stopped, err := job.StopPartially(ctx, c, wl, workload.PodSetsCounts{"workers": 0})
+	if err != nil || !stopped {
+		t.Fatalf("StopPartially() = %v, %v, want true", stopped, err)
+	}
+	var pods corev1.PodList
+	if err := c.List(ctx, &pods); err != nil {
+		t.Fatal(err)
+	}
+	if len(pods.Items) != 2 {
+		t.Errorf("pods=%d, want both left for KubeRay to delete", len(pods.Items))
+	}
+	var got rayv1.RayCluster
+	if err := c.Get(ctx, client.ObjectKeyFromObject(child), &got); err != nil {
+		t.Fatal(err)
+	}
+	group := got.Spec.WorkerGroupSpecs[0]
+	if ptr.Deref(group.Replicas, -1) != 0 || !reflect.DeepEqual(group.ScaleStrategy.WorkersToDelete, []string{"a", "b"}) {
+		t.Errorf("replicas=%v workersToDelete=%v, want 0 and [a b]", group.Replicas, group.ScaleStrategy.WorkersToDelete)
+	}
+}
+
+func TestRayJobReadyDuringReclaim(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	ctx, _ := utiltesting.ContextWithLog(t)
+	job := &RayJob{ObjectMeta: metav1.ObjectMeta{Annotations: map[string]string{workloadslicing.EnabledAnnotationKey: "true"}}, Status: rayv1.RayJobStatus{RayClusterStatus: rayv1.RayClusterStatus{Conditions: []metav1.Condition{{Type: string(rayv1.HeadPodReady), Status: metav1.ConditionTrue}}}}}
+	wl := api.MakeWorkload("slice", "ns").Obj()
+	if job.PodsReady(ctx, nil, jobframework.WithWorkload(wl)) {
+		t.Fatal("workers must be ready before reclaim")
+	}
+	workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{"workers": 0})
+	if !job.PodsReady(ctx, nil, jobframework.WithWorkload(wl)) {
+		t.Fatal("ready head must preserve a reclaimed job")
+	}
+}
