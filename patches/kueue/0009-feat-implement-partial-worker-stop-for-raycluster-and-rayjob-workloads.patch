+// partiallyPreempted returns an admitted workload with one "workers" PodSet.
+func partiallyPreempted(count, admitted int32, targets string, reclaimable ...kueue.ReclaimablePod) *kueue.Workload {
+	wl := &kueue.Workload{
+		Spec: kueue.WorkloadSpec{PodSets: []kueue.PodSet{{Name: "workers", Count: count}}},
+		Status: kueue.WorkloadStatus{
+			Admission:       &kueue.Admission{PodSetAssignments: []kueue.PodSetAssignment{{Name: "workers", Count: &admitted}}},
+			ReclaimablePods: reclaimable,
+		},
+	}
+	if targets != "" {
+		wl.Annotations = map[string]string{constants.ReclaimTargetCountsAnnotation: targets}
+	}
+	return wl
+}
