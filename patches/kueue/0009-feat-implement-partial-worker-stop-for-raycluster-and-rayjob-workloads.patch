+func TestReconcileStopsWorkersAboveReclaimTargets(t *testing.T) {
+	testCases := map[string]struct {
+		disablePartialPreemption bool
+		wantReplicas             int32
+		wantWorkersToDelete      []string
+		wantRequeue              bool
+	}{
+		"the workers above the target are left to KubeRay with lower replicas and the job is requeued": {
+			wantReplicas:        2,
+			wantWorkersToDelete: []string{"w-2", "w-3"},
+			wantRequeue:         true,
+		},
+		"without the gate no worker is stopped": {
+			disablePartialPreemption: true,
+			wantReplicas:             4,
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, !tc.disablePartialPreemption)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			now := time.Now().Truncate(time.Second)
+
+			job := testingrayutil.MakeCluster("job", "ns").
+				SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+				Suspend(false).
+				Queue("lq").
+				RequestWorkerGroup(corev1.ResourceCPU, "1").
+				ScaleFirstWorkerGroup(4).
+				Obj()
+			podSets, err := (*RayCluster)(job).PodSets(ctx, nil)
+			if err != nil {
+				t.Fatalf("PodSets() error: %v", err)
+			}
+			workers := podSets[1].Name
+			wl := utiltestingapi.MakeWorkload("wl", "ns").
+				Finalizers(kueue.ResourceInUseFinalizerName).
+				Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+				Annotation(constants.ReclaimTargetCountsAnnotation, workload.FormatPodSetCounts(workload.PodSetsCounts{workers: 2})).
+				ControllerReference(gvk, job.Name, string(job.UID)).
+				PodSets(podSets...).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+					utiltestingapi.MakePodSetAssignment(podSets[0].Name).Obj(),
+					utiltestingapi.MakePodSetAssignment(workers).Count(4).Obj(),
+				).Obj(), now).
+				AdmittedAt(true, now).
+				Obj()
+			objs := []client.Object{utiltesting.MakeNamespace("ns"), job, wl}
+			for i := range 4 {
+				objs = append(objs, testingpod.MakePod("w-"+string(rune('0'+i)), "ns").
+					Annotation(kueue.WorkloadSliceNameAnnotation, wl.Name).
+					Label(constants.PodSetLabel, string(workers)).
+					Label(rayutils.RayWorkerReplicaNameKey, "replica-"+string(rune('0'+i))).
+					CreationTimestamp(now.Add(time.Duration(i)*time.Second)).
+					Obj())
+			}
+			builder := utiltesting.NewClientBuilder(rayv1.AddToScheme).
+				WithObjects(objs...).
+				WithStatusSubresource(wl).
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName)
+			indexer := utiltesting.AsIndexer(builder)
+			if err := SetupIndexes(ctx, indexer); err != nil {
+				t.Fatalf("SetupIndexes() error: %v", err)
+			}
+			kClient := builder.Build()
+			reconciler, err := NewReconciler(ctx, kClient, indexer, &utiltesting.EventRecorder{})
+			if err != nil {
+				t.Fatalf("NewReconciler() error: %v", err)
+			}
+
+			result, err := reconciler.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(job)})
+			if err != nil {
+				t.Fatalf("Reconcile() error: %v", err)
+			}
+			if gotRequeue := result.RequeueAfter > 0; gotRequeue != tc.wantRequeue {
+				t.Errorf("Reconcile() requeueAfter = %v, want requeue %v", result.RequeueAfter, tc.wantRequeue)
+			}
+			var pods corev1.PodList
+			if err := kClient.List(ctx, &pods); err != nil {
+				t.Fatalf("List() error: %v", err)
+			}
+			if len(pods.Items) != 4 {
+				t.Errorf("Pods after reconcile = %d, want 4 left for KubeRay to delete", len(pods.Items))
+			}
+			var got rayv1.RayCluster
+			if err := kClient.Get(ctx, client.ObjectKeyFromObject(job), &got); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			group := got.Spec.WorkerGroupSpecs[0]
+			if gotReplicas := ptr.Deref(group.Replicas, -1); gotReplicas != tc.wantReplicas {
+				t.Errorf("Replicas after reconcile = %d, want %d", gotReplicas, tc.wantReplicas)
+			}
+			if diff := cmp.Diff(tc.wantWorkersToDelete, group.ScaleStrategy.WorkersToDelete); diff != "" {
+				t.Errorf("WorkersToDelete after reconcile (-want,+got):\n%s", diff)
+			}
+
+			// Another pass, while KubeRay has not deleted the Pods yet, stops nothing more.
+			if _, err := reconciler.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(job)}); err != nil {
+				t.Fatalf("second Reconcile() error: %v", err)
+			}
+			if err := kClient.Get(ctx, client.ObjectKeyFromObject(job), &got); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			if gotReplicas := ptr.Deref(got.Spec.WorkerGroupSpecs[0].Replicas, -1); gotReplicas != tc.wantReplicas {
+				t.Errorf("Replicas after the second reconcile = %d, want %d", gotReplicas, tc.wantReplicas)
+			}
+		})
+	}
+}
