+// Reconciles partial preemption by marking stopped workers reclaimable and evicting if timeouts expire.
+package jobframework
+
+import (
+	"context"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	clientutil "sigs.k8s.io/kueue/pkg/util/client"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// ReasonPartiallyStopped is the reason of the event recorded on a job whose Pods above
+// the reclaim target counts of partial preemption were stopped.
+const ReasonPartiallyStopped = "PartiallyStopped"
+
+// JobWithPartialStop is implemented by elastic jobs that partial preemption can shrink.
+// Once the Pods above the reclaim targets are gone, the ElasticJobUngater marks them
+// reclaimable, which releases their quota.
+type JobWithPartialStop interface {
+	// StopPartially brings each PodSet in targets down to its target count, and the job's
+	// desired count with it, so the pods it stops are not recreated. It makes no API call
+	// when the PodSets are already at their targets, and returns whether it changed anything.
+	StopPartially(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts) (bool, error)
+}
+
+// partialStopRequeueAfter is how soon the job reconciler looks again at a job whose
+// reclaim targets are still pending, once it has stopped their workers.
+const partialStopRequeueAfter = 5 * time.Second
+
+// stopJobPartially brings a running elastic job down to the pending reclaim target
+// counts of partial preemption. It reports whether a target is pending, in which case
+// the reconcile ends here and is requeued until the ElasticJobUngater releases the quota.
+func (r *JobReconciler) stopJobPartially(ctx context.Context, job GenericJob, wl *kueue.Workload) (ctrl.Result, bool, error) {
+	partialJob, ok := job.(JobWithPartialStop)
+	if !ok || !features.Enabled(features.PartialPreemption) || job.IsSuspended() || !workload.IsAdmitted(wl) || workloadevict.IsEvicted(wl) {
+		return ctrl.Result{}, false, nil
+	}
+	// The workers stop once per reclaim request, which a mark on the Workload records.
+	if !workload.ReclaimStopPending(wl) {
+		return ctrl.Result{}, false, nil
+	}
+	// The quota may be released before this reconcile looks at the job, when no worker
+	// ran above the target; the job's replicas still go down to it.
+	targets := workload.PendingReclaimTargetCounts(wl)
+	pending := len(targets) > 0
+	if !pending {
+		targets = workload.ReclaimTargetCounts(wl)
+	}
+	stopped, err := partialJob.StopPartially(ctx, r.client, wl, targets)
+	if stopped {
+		r.record.Eventf(job.Object(), nil, corev1.EventTypeNormal, ReasonPartiallyStopped, "PartiallyStopped",
+			"Stopping the pods above the reclaim target counts %s of workload '%s'", workload.FormatPodSetCounts(targets), workload.Key(wl))
+	}
+	if err != nil {
+		return ctrl.Result{}, true, err
+	}
+	if err := clientutil.Patch(ctx, r.client, wl, func() (bool, error) {
+		workload.SetReclaimStopped(wl)
+		return true, nil
+	}, clientutil.WithRetryOnConflict()); err != nil {
+		return ctrl.Result{}, true, client.IgnoreNotFound(err)
+	}
+	if !pending {
+		return ctrl.Result{}, false, nil
+	}
+	return ctrl.Result{RequeueAfter: partialStopRequeueAfter}, true, nil
+}
+
+// clearReclaimedPods clears, right after the eviction released the Workload's quota,
+// the reclaimable Pods that partial preemption marked, so a re-admission does not
+// inherit them. The admission patch leaves out the reclaimable Pods, so the Workload
+// is read again first. A stale read is retried by the next reconcile, which the
+// admission change triggers, and the Workload controller clears them too.
+func (r *JobReconciler) clearReclaimedPods(ctx context.Context, wl *kueue.Workload) error {
+	if !workload.IsPartiallyPreempted(wl) {
+		return nil
+	}
+	latest := &kueue.Workload{}
+	if err := r.client.Get(ctx, client.ObjectKeyFromObject(wl), latest); err != nil {
+		return client.IgnoreNotFound(err)
+	}
+	_, err := workloadslicing.ClearReclaimablePodsForTargets(ctx, r.client, latest)
+	return client.IgnoreNotFound(err)
+}
