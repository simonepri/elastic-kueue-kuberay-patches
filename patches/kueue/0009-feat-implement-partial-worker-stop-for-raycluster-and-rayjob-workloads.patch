+func TestDeletePodGroupsAboveCounts(t *testing.T) {
+	now := time.Now()
+	wl := utiltestingapi.MakeWorkload("wl", "ns").Annotation(kueue.WorkloadSliceNameAnnotation, "origin").Obj()
+	worker := func(name string, created time.Duration) *testingpod.PodWrapper {
+		return testingpod.MakePod(name, "ns").
+			Annotation(kueue.WorkloadSliceNameAnnotation, "origin").
+			Label(constants.PodSetLabel, "workers").
+			Request(corev1.ResourceName("nvidia.com/gpu"), "1").
+			CreationTimestamp(now.Add(created))
+	}
+	group := func(p *corev1.Pod) string {
+		if g, found := p.Labels["group"]; found {
+			return g
+		}
+		return p.Name
+	}
+	testCases := map[string]struct {
+		pods      []*corev1.Pod
+		otherPods []*corev1.Pod
+		counts    workload.PodSetsCounts
+		// repeat calls DeletePodGroupsAboveCounts again while the Pods it deleted
+		// are still terminating, held by a finalizer.
+		repeat      bool
+		wantDeleted []string
+		// wantAbove is whether PodsAboveCounts still reports Pods above the counts
+		// after the call, because terminating Pods hold their resources until gone.
+		wantAbove   bool
+		wantStopped bool
+	}{
+		"node A holds 8 idle pods (cost 0); node B holds 8 pods, 4 of them with a high deletion cost. Deleting 8 must empty node A": func() struct {
+			pods        []*corev1.Pod
+			otherPods   []*corev1.Pod
+			counts      workload.PodSetsCounts
+			repeat      bool
+			wantDeleted []string
+			wantAbove   bool
+			wantStopped bool
+		} {
+			var pods []*corev1.Pod
+			var wantDeleted []string
+			for i := range 8 {
+				name := fmt.Sprintf("w-a-%d", i)
+				pods = append(pods, worker(name, time.Duration(i)*time.Second).NodeName("node-a").Obj())
+				wantDeleted = append(wantDeleted, name)
+			}
+			for i := range 4 {
+				name := fmt.Sprintf("w-b-idle-%d", i)
+				pods = append(pods, worker(name, time.Duration(i)*time.Second).NodeName("node-b").Obj())
+			}
+			for i := range 4 {
+				name := fmt.Sprintf("w-b-busy-%d", i)
+				pods = append(pods, worker(name, time.Duration(i+4)*time.Second).
+					NodeName("node-b").
+					Annotation(corev1.PodDeletionCost, "1000").
+					Obj())
+			}
+			slices.Sort(wantDeleted)
+			return struct {
+				pods        []*corev1.Pod
+				otherPods   []*corev1.Pod
+				counts      workload.PodSetsCounts
+				repeat      bool
+				wantDeleted []string
+				wantAbove   bool
+				wantStopped bool
+			}{
+				pods:        pods,
+				counts:      workload.PodSetsCounts{"workers": 8},
+				wantDeleted: wantDeleted,
+				wantStopped: true,
+			}
+		}(),
+		"multi-host 2-pod group split across two nodes": func() struct {
+			pods        []*corev1.Pod
+			otherPods   []*corev1.Pod
+			counts      workload.PodSetsCounts
+			repeat      bool
+			wantDeleted []string
+			wantAbove   bool
+			wantStopped bool
+		} {
+			var pods []*corev1.Pod
+			for i := range 2 {
+				pods = append(pods, worker(fmt.Sprintf("w-a-%d", i), time.Duration(i)*time.Second).NodeName("node-a").Obj())
+			}
+			for i := range 2 {
+				pods = append(pods, worker(fmt.Sprintf("w-b-%d", i), time.Duration(i)*time.Second).NodeName("node-b").Obj())
+			}
+			p1 := worker("g1-0", 2*time.Second).Label("group", "g1").NodeName("node-a").Obj()
+			p2 := worker("g1-1", 2*time.Second).Label("group", "g1").NodeName("node-b").Obj()
+			pods = append(pods, p1, p2)
+			wantDeleted := []string{"g1-0", "g1-1"}
+			slices.Sort(wantDeleted)
+			return struct {
+				pods        []*corev1.Pod
+				otherPods   []*corev1.Pod
+				counts      workload.PodSetsCounts
+				repeat      bool
+				wantDeleted []string
+				wantAbove   bool
+				wantStopped bool
+			}{
+				pods:        pods,
+				counts:      workload.PodSetsCounts{"workers": 4},
+				wantDeleted: wantDeleted,
+				wantStopped: true,
+			}
+		}(),
+		"multi-host groups spanning multiple nodes do not over-delete when node pod count is small": func() struct {
+			pods        []*corev1.Pod
+			otherPods   []*corev1.Pod
+			counts      workload.PodSetsCounts
+			repeat      bool
+			wantDeleted []string
+			wantAbove   bool
+			wantStopped bool
+		} {
+			g1a := worker("g1-a", 0).Label("group", "g1").NodeName("node-a").Obj()
+			g1b := worker("g1-b", 0).Label("group", "g1").NodeName("node-b").Obj()
+			g2a := worker("g2-a", time.Second).Label("group", "g2").NodeName("node-a").Obj()
+			g2b := worker("g2-b", time.Second).Label("group", "g2").NodeName("node-c").Obj()
+			g3a := worker("g3-a", 2*time.Second).Label("group", "g3").NodeName("node-b").Obj()
+			g3b := worker("g3-b", 2*time.Second).Label("group", "g3").NodeName("node-c").Obj()
+			pods := []*corev1.Pod{g1a, g1b, g2a, g2b, g3a, g3b}
+			// node-a has 2 pods (from g1, g2). Needed = 2. But g1+g2 = 4 pods > needed, so node-a is not a whole candidate.
+			// Active node ordering picks node-a (alphabetical tie-breaker), and newest group on node-a (g2) is deleted.
+			wantDeleted := []string{"g2-a", "g2-b"}
+			slices.Sort(wantDeleted)
+			return struct {
+				pods        []*corev1.Pod
+				otherPods   []*corev1.Pod
+				counts      workload.PodSetsCounts
+				repeat      bool
+				wantDeleted []string
+				wantAbove   bool
+				wantStopped bool
+			}{
+				pods:        pods,
+				counts:      workload.PodSetsCounts{"workers": 4},
+				wantDeleted: wantDeleted,
+				wantStopped: true,
+			}
+		}(),
+		"16 pods 8+8 on two nodes, delete 8 empties one node": func() struct {
+			pods        []*corev1.Pod
+			otherPods   []*corev1.Pod
+			counts      workload.PodSetsCounts
+			repeat      bool
+			wantDeleted []string
+			wantAbove   bool
+			wantStopped bool
+		} {
+			var pods []*corev1.Pod
+			var wantDeleted []string
+			for i := range 8 {
+				name := fmt.Sprintf("w-a-%d", i)
+				pods = append(pods, worker(name, time.Duration(i)*time.Second).NodeName("node-a").Obj())
+				wantDeleted = append(wantDeleted, name)
+			}
+			for i := range 8 {
+				pods = append(pods, worker(fmt.Sprintf("w-b-%d", i), time.Duration(i)*time.Second).NodeName("node-b").Obj())
+			}
+			slices.Sort(wantDeleted)
+			return struct {
+				pods        []*corev1.Pod
+				otherPods   []*corev1.Pod
+				counts      workload.PodSetsCounts
+				repeat      bool
+				wantDeleted []string
+				wantAbove   bool
+				wantStopped bool
+			}{
+				pods:        pods,
+				counts:      workload.PodSetsCounts{"workers": 8},
+				wantDeleted: wantDeleted,
+				wantStopped: true,
+			}
+		}(),
+		"two nodes both with 8 idle pods, prefer node with fewer other pods": func() struct {
+			pods        []*corev1.Pod
+			otherPods   []*corev1.Pod
+			counts      workload.PodSetsCounts
+			repeat      bool
+			wantDeleted []string
+			wantAbove   bool
+			wantStopped bool
+		} {
+			var pods []*corev1.Pod
+			var wantDeleted []string
+			for i := range 8 {
+				name := fmt.Sprintf("w-a-%d", i)
+				pods = append(pods, worker(name, time.Duration(i)*time.Second).NodeName("node-a").Obj())
+				wantDeleted = append(wantDeleted, name)
