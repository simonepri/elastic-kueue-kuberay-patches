+// Manages partial preemption state, reclaim target counts, and reclaimable pod accounting.
+package workload
+
+import (
+	"maps"
+	"slices"
+	"strconv"
+	"time"
+
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/utils/ptr"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+)
+
+// IsPartiallyPreempted reports whether partial preemption shrank, or is
+// shrinking, the workload.
+func IsPartiallyPreempted(wl *kueue.Workload) bool {
+	_, found := wl.Annotations[constants.ReclaimTargetCountsAnnotation]
+	return found
+}
+
+// ReclaimTargetCounts returns the reclaim target counts set by partial preemption.
+// Malformed entries are ignored, and so are stale targets (see ReclaimTargetsStale).
+func ReclaimTargetCounts(wl *kueue.Workload) PodSetsCounts {
+	if ReclaimTargetsStale(wl) {
+		return nil
+	}
+	return ParsePodSetCounts(wl.Annotations[constants.ReclaimTargetCountsAnnotation])
+}
+
+// ReclaimTargetsStale reports whether the reclaim targets were requested for an
+// earlier quota reservation than the current one: their requested-at time is
+// before the second the QuotaReserved condition last became true, and the quota
+// they reclaimed was already given back, so no PodSet with a target has reclaimable
+// Pods left. Such targets outlived the admission they were meant for, so they must
+// not shrink this one. When reclaimable Pods are left, because the admission was
+// released and reserved again before they were cleared, the Workload was admitted
+// for that smaller charge, so the targets still hold. Targets without a valid
+// requested-at time are never stale.
+func ReclaimTargetsStale(wl *kueue.Workload) bool {
+	requestedAt, err := time.Parse(time.RFC3339, wl.Annotations[constants.ReclaimRequestedAtAnnotation])
+	if err != nil {
+		return false
+	}
+	reserved := apimeta.FindStatusCondition(wl.Status.Conditions, kueue.WorkloadQuotaReserved)
+	if reserved == nil || reserved.Status != metav1.ConditionTrue ||
+		!requestedAt.Truncate(time.Second).Before(reserved.LastTransitionTime.Time) {
+		return false
+	}
+	targets := ParsePodSetCounts(wl.Annotations[constants.ReclaimTargetCountsAnnotation])
+	return !slices.ContainsFunc(wl.Status.ReclaimablePods, func(rp kueue.ReclaimablePod) bool {
+		_, found := targets[rp.Name]
+		return found && rp.Count > 0
+	})
+}
+
+// chargedCountsAfterReclaim raises the count of each PodSet with a reclaim target
+// in counts, the PodSet counts after its reclaimable Pods are subtracted, to at
+// least min(count, target): partial preemption keeps that many Pods running, so a
+// reclaimable count written ahead of the matching spec update never charges less.
+// Stale targets count too, since they only ever raise the charge.
+func chargedCountsAfterReclaim(wl *kueue.Workload, counts PodSetsCounts) {
+	targets := ParsePodSetCounts(wl.Annotations[constants.ReclaimTargetCountsAnnotation])
+	if len(targets) == 0 {
+		return
+	}
+	for _, ps := range wl.Spec.PodSets {
+		if target, found := targets[ps.Name]; found {
+			counts[ps.Name] = max(counts[ps.Name], min(ps.Count, target))
+		}
+	}
+}
+
+// SetReclaimTargetCounts sets the reclaim target counts of partial preemption.
+func SetReclaimTargetCounts(wl *kueue.Workload, targets PodSetsCounts) {
+	metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimTargetCountsAnnotation, FormatPodSetCounts(targets))
+}
+
+// ClearReclaimTargets removes the reclaim target counts of partial preemption,
+// with the preemptor and the time they were requested at. It reports whether
+// it removed any of them.
+func ClearReclaimTargets(wl *kueue.Workload) bool {
+	cleared := false
+	for _, key := range []string{
+		constants.ReclaimTargetCountsAnnotation,
+		constants.ReclaimPreemptorAnnotation,
+		constants.ReclaimRequestedAtAnnotation,
+		constants.ReclaimGenerationAnnotation,
+		constants.ReclaimStoppedAtAnnotation,
+	} {
+		if _, found := wl.Annotations[key]; found {
+			delete(wl.Annotations, key)
+			cleared = true
+		}
+	}
+	return cleared
+}
+
+// ReclaimStopPending reports whether wl carries a reclaim request whose workers the job
+// controller has not stopped yet, whether or not their quota is still charged.
+func ReclaimStopPending(wl *kueue.Workload) bool {
+	if len(ReclaimTargetCounts(wl)) == 0 {
+		return false
+	}
+	stoppedAt, found := wl.Annotations[constants.ReclaimStoppedAtAnnotation]
+	return !found || stoppedAt != ReclaimRequest(wl)
+}
+
+// ReclaimRequest returns the identity of the reclaim request wl carries: the time it
+// was made at, and its generation when it has one, which tells apart two requests
+// made within the same second.
+func ReclaimRequest(wl *kueue.Workload) string {
+	request := wl.Annotations[constants.ReclaimRequestedAtAnnotation]
+	if generation, found := wl.Annotations[constants.ReclaimGenerationAnnotation]; found {
+		request += "#" + generation
+	}
+	return request
+}
+
+// SetReclaimStopped records that the job controller has stopped the workers of the
+// reclaim request of wl.
+func SetReclaimStopped(wl *kueue.Workload) {
+	SetReclaimStoppedFor(wl, ReclaimRequest(wl))
+}
+
+// SetReclaimStoppedFor records that the job controller has stopped the workers of the
+// given reclaim request, as ReclaimRequest returned it when the workers were stopped.
+func SetReclaimStoppedFor(wl *kueue.Workload, request string) {
+	metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimStoppedAtAnnotation, request)
+}
+
+// NextReclaimGeneration returns the generation that follows the one wl carries.
+func NextReclaimGeneration(wl *kueue.Workload) string {
+	generation, _ := strconv.Atoi(wl.Annotations[constants.ReclaimGenerationAnnotation])
+	return strconv.Itoa(generation + 1)
+}
+
+// PendingReclaimTargetCounts returns the reclaim target counts of the PodSets
+// that are still charged above them, so their quota is not released yet.
+func PendingReclaimTargetCounts(wl *kueue.Workload) PodSetsCounts {
+	granted := ExtractGrantedPodSetCountsAfterReclaim(wl)
+	var pending PodSetsCounts
+	for name, target := range ReclaimTargetCounts(wl) {
+		if count, found := granted[name]; found && target < count {
+			if pending == nil {
+				pending = make(PodSetsCounts)
+			}
+			pending[name] = target
+		}
+	}
+	return pending
+}
+
+// ReclaimablePodsForTargets returns the reclaimable Pods of wl with each PodSet
+// in targets marked reclaimable down to its target count, which releases the
+// quota of the Pods above it.
+func ReclaimablePodsForTargets(wl *kueue.Workload, targets PodSetsCounts) []kueue.ReclaimablePod {
+	counts := ExtractPodSetCountsFromWorkload(wl)
+	reclaimable := slices.Clone(wl.Status.ReclaimablePods)
+	for _, name := range slices.Sorted(maps.Keys(targets)) {
+		count := max(counts[name]-targets[name], 0)
+		if i := slices.IndexFunc(reclaimable, func(rp kueue.ReclaimablePod) bool { return rp.Name == name }); i != -1 {
+			reclaimable[i].Count = max(reclaimable[i].Count, count)
+		} else {
+			reclaimable = append(reclaimable, kueue.ReclaimablePod{Name: name, Count: count})
+		}
+	}
+	return reclaimable
+}
+
+// AdmittedPodSetCounts returns the pod count of each PodSet in the admission,
+// before any scale-down: the assignment count, or the spec count when it is unset.
+func AdmittedPodSetCounts(wl *kueue.Workload) PodSetsCounts {
+	if wl.Status.Admission == nil {
+		return nil
+	}
+	counts := ExtractPodSetCountsFromWorkload(wl)
+	admitted := make(PodSetsCounts, len(wl.Status.Admission.PodSetAssignments))
+	for _, psa := range wl.Status.Admission.PodSetAssignments {
+		admitted[psa.Name] = ptr.Deref(psa.Count, counts[psa.Name])
+	}
+	return admitted
+}
+
+// ReclaimablePodsAfterScaleDown returns the reclaimable Pods of wl with the count
+// of each PodSet that has a reclaim target re-derived after an in-place scale-down:
+// when the PodSet's count is below its admitted count and it is charged for fewer
+// Pods than its target, its reclaimable count becomes max(0, count - target), so it
+// is charged min(count, target) again. Other PodSets keep their count.
+func ReclaimablePodsAfterScaleDown(wl *kueue.Workload) []kueue.ReclaimablePod {
+	admitted := AdmittedPodSetCounts(wl)
+	counts := ExtractPodSetCountsFromWorkload(wl)
+	targets := ReclaimTargetCounts(wl)
+	reclaimable := slices.Clone(wl.Status.ReclaimablePods)
+	for i := range reclaimable {
+		rp := &reclaimable[i]
+		target, hasTarget := targets[rp.Name]
+		count := counts[rp.Name]
+		if hasTarget && count < admitted[rp.Name] && count-rp.Count < target {
+			rp.Count = max(0, count-target)
+		}
+	}
+	return reclaimable
+}
