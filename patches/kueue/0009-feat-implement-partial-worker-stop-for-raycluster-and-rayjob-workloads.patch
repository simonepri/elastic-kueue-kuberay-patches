+func TestReclaimStopPendingTellsApartRequestsOfTheSameSecond(t *testing.T) {
+	wl := &kueue.Workload{ObjectMeta: metav1.ObjectMeta{Annotations: map[string]string{
+		constants.ReclaimTargetCountsAnnotation: "a=2",
+		constants.ReclaimRequestedAtAnnotation:  "2026-01-01T00:00:00Z",
+		constants.ReclaimGenerationAnnotation:   "1",
+	}}}
+	if !ReclaimStopPending(wl) {
+		t.Fatal("ReclaimStopPending() = false for a request nothing stopped for")
+	}
+	request := ReclaimRequest(wl)
+	SetReclaimStopped(wl)
+	if ReclaimStopPending(wl) {
+		t.Fatal("ReclaimStopPending() = true after the request was marked stopped")
+	}
+
+	wl.Annotations[constants.ReclaimTargetCountsAnnotation] = "a=1"
+	wl.Annotations[constants.ReclaimGenerationAnnotation] = NextReclaimGeneration(wl)
+	if !ReclaimStopPending(wl) {
+		t.Error("ReclaimStopPending() = false for a deeper request made within the same second")
+	}
+	SetReclaimStoppedFor(wl, request)
+	if !ReclaimStopPending(wl) {
+		t.Error("ReclaimStopPending() = false after marking the earlier request stopped, want the deeper one pending")
+	}
+}
