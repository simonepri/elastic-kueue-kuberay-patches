+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	indexer "sigs.k8s.io/kueue/pkg/controller/core/indexer"
+	clientutil "sigs.k8s.io/kueue/pkg/util/client"
+	"sigs.k8s.io/kueue/pkg/util/parallelize"
+	utilpod "sigs.k8s.io/kueue/pkg/util/pod"
+	utilresource "sigs.k8s.io/kueue/pkg/util/resource"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// runningPodsPerPodSet returns the Pods of the workload slice that hold their
+// resources, by PodSet: the ungated Pods that are not terminated, including the
+// terminating ones.
+func runningPodsPerPodSet(ctx context.Context, c client.Client, wl *kueue.Workload) (map[kueue.PodSetReference][]*corev1.Pod, error) {
+	pods, err := ListPodsForWorkloadSlice(ctx, c, wl.Namespace, SliceName(wl))
+	if err != nil {
+		return nil, err
+	}
+	running := make(map[kueue.PodSetReference][]*corev1.Pod)
+	for _, p := range pods {
+		if utilpod.IsTerminated(p) || utilpod.HasGate(p, kueue.ElasticJobSchedulingGate) {
+			continue
+		}
+		ps := kueue.PodSetReference(p.Labels[constants.PodSetLabel])
+		running[ps] = append(running[ps], p)
+	}
+	return running, nil
+}
+
+// PodsAboveCounts reports whether any PodSet of the workload slice still has
+// more running Pods than counts.
+func PodsAboveCounts(ctx context.Context, c client.Client, wl *kueue.Workload, counts workload.PodSetsCounts) (bool, error) {
+	running, err := runningPodsPerPodSet(ctx, c, wl)
+	if err != nil {
+		return false, err
+	}
+	for ps, count := range counts {
+		if int32(len(running[ps])) > count {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// podGroup is a set of Pods that are deleted together.
+type podGroup struct {
+	pods         []*corev1.Pod
+	deletionCost int64
+	newest       *corev1.Pod
+}
+
+func podDeletionCost(p *corev1.Pod) int64 {
+	cost, err := strconv.ParseInt(p.Annotations[corev1.PodDeletionCost], 10, 32)
+	if err != nil {
+		return 0
+	}
+	return cost
+}
+
+// comparePodGroups orders pod groups by deletion cost ascending, then newest first.
+func comparePodGroups(a, b *podGroup) int {
+	if a.deletionCost != b.deletionCost {
+		return cmp.Compare(a.deletionCost, b.deletionCost)
+	}
+	if newerPod(a.newest, b.newest) {
+		return -1
+	}
+	if newerPod(b.newest, a.newest) {
+		return 1
+	}
+	return 0
+}
+
+type nodeReclaimUsage struct {
+	name              string
+	deletionCost      int64
+	podCount          int32
+	otherPods         int
+	otherAccelerators int64
+}
+
+func compareNodes(a, b *nodeReclaimUsage) int {
+	if a.deletionCost != b.deletionCost {
+		return cmp.Compare(a.deletionCost, b.deletionCost) // prefer lower total deletion cost
+	}
+	if a.podCount != b.podCount {
+		return cmp.Compare(b.podCount, a.podCount) // prefer node holding most pods
+	}
+	if a.otherAccelerators != b.otherAccelerators {
+		return cmp.Compare(a.otherAccelerators, b.otherAccelerators) // prefer fewer other accelerators
+	}
+	if a.otherPods != b.otherPods {
+		return cmp.Compare(a.otherPods, b.otherPods) // prefer fewer other pods
+	}
+	return strings.Compare(a.name, b.name)
+}
+
+func computeNodeUsages(
+	candidateNodes sets.Set[string],
+	candidatePods []corev1.Pod,
+	ourPodUIDs, ourPodNames sets.Set[string],
+	acceleratorResources sets.Set[corev1.ResourceName],
+) map[string]*nodeReclaimUsage {
+	usages := make(map[string]*nodeReclaimUsage, len(candidateNodes))
+	for nodeName := range candidateNodes {
+		usages[nodeName] = &nodeReclaimUsage{name: nodeName}
+	}
+	for i := range candidatePods {
+		p := &candidatePods[i]
+		if p.Spec.NodeName == "" || !candidateNodes.Has(p.Spec.NodeName) || utilpod.IsTerminated(p) || p.DeletionTimestamp != nil {
+			continue
+		}
+		if (p.UID != "" && ourPodUIDs.Has(string(p.UID))) || ourPodNames.Has(p.Name) {
+			continue
+		}
+		u := usages[p.Spec.NodeName]
+		u.otherPods++
+		for _, containers := range [][]corev1.Container{p.Spec.InitContainers, p.Spec.Containers} {
+			for _, c := range containers {
+				for resName := range acceleratorResources {
+					if q, ok := c.Resources.Requests[resName]; ok {
+						u.otherAccelerators += q.Value()
+					}
+				}
+			}
+		}
+	}
+	return usages
+}
+
+func podsToReclaim(
+	groups []*podGroup,
+	needed int32,
+	candidateNodes sets.Set[string],
+	candidatePods []corev1.Pod,
+	ourPodUIDs, ourPodNames sets.Set[string],
+	acceleratorResources sets.Set[corev1.ResourceName],
+) []*corev1.Pod {
+	var toDelete []*corev1.Pod
+
+	// 1. Separate unscheduled and scheduled groups. Unscheduled groups are deleted first.
+	var unscheduled []*podGroup
+	var scheduled []*podGroup
+	for _, g := range groups {
+		hasScheduled := false
+		for _, p := range g.pods {
+			if p.Spec.NodeName != "" {
+				hasScheduled = true
+				break
+			}
+		}
+		if hasScheduled {
+			scheduled = append(scheduled, g)
+		} else {
+			unscheduled = append(unscheduled, g)
+		}
+	}
+
+	slices.SortFunc(unscheduled, comparePodGroups)
+	for _, g := range unscheduled {
+		if needed <= 0 {
+			break
+		}
+		toDelete = append(toDelete, g.pods...)
+		needed -= int32(len(g.pods))
+	}
+
+	if needed <= 0 || len(scheduled) == 0 {
+		return toDelete
+	}
+
+	// 2. Group scheduled replica groups by node.
+	// Account each pod on its own node; a group whose pods span several nodes counts toward each of them.
+	nodeUsages := computeNodeUsages(candidateNodes, candidatePods, ourPodUIDs, ourPodNames, acceleratorResources)
+	nodeGroups := make(map[string][]*podGroup)
+	for _, g := range scheduled {
+		nodesForGroup := sets.New[string]()
+		for _, p := range g.pods {
+			if p.Spec.NodeName != "" {
+				nodesForGroup.Insert(p.Spec.NodeName)
+				u := nodeUsages[p.Spec.NodeName]
+				if u == nil {
+					u = &nodeReclaimUsage{name: p.Spec.NodeName}
+					nodeUsages[p.Spec.NodeName] = u
+				}
+				u.podCount++
+			}
+		}
+		for nodeName := range nodesForGroup {
+			nodeGroups[nodeName] = append(nodeGroups[nodeName], g)
+			nodeUsages[nodeName].deletionCost += g.deletionCost
+		}
+	}
+
+	deletedGroups := make(map[*podGroup]bool)
+	deleteGroup := func(g *podGroup) {
+		deletedGroups[g] = true
+		toDelete = append(toDelete, g.pods...)
+		needed -= int32(len(g.pods))
+		nodesForGroup := sets.New[string]()
+		for _, p := range g.pods {
+			if p.Spec.NodeName != "" {
+				nodesForGroup.Insert(p.Spec.NodeName)
+				if nu, ok := nodeUsages[p.Spec.NodeName]; ok {
+					nu.podCount--
+				}
+			}
+		}
+		for n := range nodesForGroup {
+			if nu, ok := nodeUsages[n]; ok {
+				nu.deletionCost -= g.deletionCost
+			}
+		}
+	}
+
+	for needed > 0 && len(nodeGroups) > 0 {
+		var wholeCandidates []*nodeReclaimUsage
+		for nodeName, grps := range nodeGroups {
+			u := nodeUsages[nodeName]
+			if u.podCount <= 0 {
+				continue
+			}
+			var nodeGroupPods int32
+			for _, g := range grps {
+				if !deletedGroups[g] {
+					nodeGroupPods += int32(len(g.pods))
+				}
+			}
+			if nodeGroupPods > 0 && nodeGroupPods <= needed {
+				wholeCandidates = append(wholeCandidates, u)
+			}
+		}
+
+		if len(wholeCandidates) > 0 {
+			slices.SortFunc(wholeCandidates, compareNodes)
+			chosen := wholeCandidates[0]
+			for _, g := range nodeGroups[chosen.name] {
+				if deletedGroups[g] {
+					continue
+				}
+				deleteGroup(g)
+			}
+			delete(nodeGroups, chosen.name)
+			continue
+		}
+
+		var activeNodes []*nodeReclaimUsage
+		for nodeName := range nodeGroups {
+			u := nodeUsages[nodeName]
+			if u.podCount > 0 {
+				activeNodes = append(activeNodes, u)
+			}
+		}
+		if len(activeNodes) == 0 {
+			break
+		}
+		slices.SortFunc(activeNodes, compareNodes)
+		chosen := activeNodes[0]
+		grps := nodeGroups[chosen.name]
+		slices.SortFunc(grps, comparePodGroups)
+		var remainingGrps []*podGroup
+		for _, g := range grps {
+			if deletedGroups[g] {
+				continue
+			}
+			if needed <= 0 {
+				remainingGrps = append(remainingGrps, g)
+			} else {
+				deleteGroup(g)
+			}
+		}
+		if len(remainingGrps) == 0 || nodeUsages[chosen.name].podCount <= 0 {
+			delete(nodeGroups, chosen.name)
+		} else {
+			nodeGroups[chosen.name] = remainingGrps
+		}
+	}
+
+	return toDelete
+}
+
+// extractAcceleratorResources finds accelerator extended resource names from the pod set's container requests.
+func extractAcceleratorResources(wl *kueue.Workload, psRef kueue.PodSetReference, live []*corev1.Pod) sets.Set[corev1.ResourceName] {
+	accelerators := sets.New[corev1.ResourceName]()
+	if idx := slices.IndexFunc(wl.Spec.PodSets, func(ps kueue.PodSet) bool { return ps.Name == psRef }); idx >= 0 {
+		for _, containers := range [][]corev1.Container{wl.Spec.PodSets[idx].Template.Spec.InitContainers, wl.Spec.PodSets[idx].Template.Spec.Containers} {
+			for _, c := range containers {
+				for resName, qty := range c.Resources.Requests {
+					if !qty.IsZero() && utilresource.IsExtendedResourceName(resName) {
+						accelerators.Insert(resName)
+					}
+				}
+			}
+		}
+	}
+	if accelerators.Len() == 0 {
+		for _, p := range live {
+			for _, containers := range [][]corev1.Container{p.Spec.InitContainers, p.Spec.Containers} {
+				for _, c := range containers {
+					for resName, qty := range c.Resources.Requests {
+						if !qty.IsZero() && utilresource.IsExtendedResourceName(resName) {
+							accelerators.Insert(resName)
+						}
+					}
+				}
+			}
+		}
+	}
+	return accelerators
+}
+
+// DeletePodGroupsAboveCounts deletes the Pods that PodGroupsAboveCounts selects.
+// It returns whether any Pod was deleted.
+func DeletePodGroupsAboveCounts(ctx context.Context, c client.Client, wl *kueue.Workload, counts workload.PodSetsCounts, groupOf func(*corev1.Pod) string) (bool, error) {
+	toDelete, err := PodGroupsAboveCounts(ctx, c, wl, counts, groupOf, nil)
+	if err != nil {
+		return false, err
+	}
+	log := ctrl.LoggerFrom(ctx)
+	err = parallelize.Until(ctx, len(toDelete), func(i int) error {
+		log.V(3).Info("Deleting elastic pod above the reclaim target count", "pod", klog.KObj(toDelete[i]))
+		return client.IgnoreNotFound(c.Delete(ctx, toDelete[i]))
+	})
+	return len(toDelete) > 0, err
+}
+
+// PodGroupsAboveCounts selects the running Pods of the workload slice to stop until
+// each PodSet in counts runs at most its count. When selecting pods, unscheduled
+// pods are deleted first, then whole nodes' worth of pods are deleted (ranking
+// candidate nodes first by lower total deletion cost of this pod set's groups on
+// the node, then greedily preferring nodes where this pod set holds the most pods,
+// breaking ties by fewer other accelerators or other pods on the node, then node
+// name). Any remaining pods are deleted from a partial node in deletion cost / age
+// order. Multi-host replica groups are kept whole. Terminating Pods and the Pods
+// that skip reports as already leaving are neither selected again nor counted, so
+// a call made while earlier stops are still pending selects nothing more. A nil
+// skip keeps every Pod.
+func PodGroupsAboveCounts(ctx context.Context, c client.Client, wl *kueue.Workload, counts workload.PodSetsCounts, groupOf func(*corev1.Pod) string, skip func(*corev1.Pod) bool) ([]*corev1.Pod, error) {
+	running, err := runningPodsPerPodSet(ctx, c, wl)
+	if err != nil {
+		return nil, err
+	}
+	var toDelete []*corev1.Pod
+	for _, ps := range slices.Sorted(maps.Keys(counts)) {
+		// Terminating Pods are already on their way out, so only the others count
+		// toward the target here; PodsAboveCounts still waits for them to go.
+		live := slices.DeleteFunc(slices.Clone(running[ps]), func(p *corev1.Pod) bool {
+			return p.DeletionTimestamp != nil || skip != nil && skip(p)
+		})
+		remaining := int32(len(live))
+		if remaining <= counts[ps] {
+			continue
+		}
+		groupsByKey := make(map[string]*podGroup)
+		for _, p := range live {
+			key := groupOf(p)
+			g, found := groupsByKey[key]
+			if !found {
+				g = &podGroup{deletionCost: podDeletionCost(p), newest: p}
+				groupsByKey[key] = g
+			}
+			g.pods = append(g.pods, p)
+			g.deletionCost = max(g.deletionCost, podDeletionCost(p))
+			if newerPod(p, g.newest) {
+				g.newest = p
+			}
+		}
+		groups := slices.Collect(maps.Values(groupsByKey))
+		candidateNodes := sets.New[string]()
+		ourPodUIDs := sets.New[string]()
+		ourPodNames := sets.New[string]()
+		for _, p := range live {
+			if p.UID != "" {
+				ourPodUIDs.Insert(string(p.UID))
+			}
+			ourPodNames.Insert(p.Name)
+			if p.Spec.NodeName != "" {
+				candidateNodes.Insert(p.Spec.NodeName)
+			}
+		}
+		var candidatePods []corev1.Pod
+		if candidateNodes.Len() > 0 {
+			nodeNames := candidateNodes.UnsortedList()
+			slices.Sort(nodeNames)
+			for _, nodeName := range nodeNames {
+				var list corev1.PodList
+				if err := c.List(ctx, &list, client.MatchingFields{indexer.PodNodeNameKey: nodeName}); err != nil {
+					return nil, err
+				}
+				candidatePods = append(candidatePods, list.Items...)
+			}
+		}
+		accelerators := extractAcceleratorResources(wl, ps, live)
+		toDelete = append(toDelete, podsToReclaim(groups, remaining-counts[ps], candidateNodes, candidatePods, ourPodUIDs, ourPodNames, accelerators)...)
+	}
+	return toDelete, nil
+}
+
+// newerPod reports whether a was created after b, breaking ties by the higher name.
+func newerPod(a, b *corev1.Pod) bool {
+	if c := a.CreationTimestamp.Compare(b.CreationTimestamp.Time); c != 0 {
+		return c > 0
+	}
+	return strings.Compare(a.Name, b.Name) > 0
+}
+
+// ClearReclaimablePodsForTargets removes the reclaimable Pods of the PodSets with a
+// reclaim target from a Workload that no longer holds quota: they were only the Pods
+// partial preemption stopped, and the next admission must not inherit them. A merge
+// patch replaces the whole list, so the entries go even when another field manager
+// also owns them, which a server-side apply would leave behind. It reports whether
+// it wrote the Workload.
+func ClearReclaimablePodsForTargets(ctx context.Context, c client.Client, wl *kueue.Workload) (bool, error) {
+	if workload.HasQuotaReservation(wl) {
+		return false, nil
+	}
+	targets := workload.ParsePodSetCounts(wl.Annotations[constants.ReclaimTargetCountsAnnotation])
+	reclaimable := slices.DeleteFunc(slices.Clone(wl.Status.ReclaimablePods), func(rp kueue.ReclaimablePod) bool {
+		_, found := targets[rp.Name]
+		return found
+	})
+	if len(reclaimable) == len(wl.Status.ReclaimablePods) {
+		return false, nil
+	}
+	return true, clientutil.PatchStatus(ctx, c, wl, func() (bool, error) {
+		wl.Status.ReclaimablePods = reclaimable
+		return true, nil
+	})
+}
