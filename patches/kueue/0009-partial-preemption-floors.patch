+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package workloadslicing
+
+import (
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// EnsureOption changes how EnsureWorkloadSlices treats the slice it returns.
+type EnsureOption func(*ensureOptions)
+
+type ensureOptions struct {
+	// floors and steps are the job's current reclaim floors and count steps; refreshFloors
+	// reports whether to keep the slice's annotations equal to them.
+	floors, steps workload.PodSetsCounts
+	refreshFloors bool
+}
+
+// WithReclaimFloors makes EnsureWorkloadSlices write the job's reclaim floors and count
+// steps on the slice it returns, in the update it already makes or, when the PodSet counts
+// match, in a metadata update of its own. Empty counts remove the annotation. The update
+// changes no spec field, so a slice that holds quota stays admitted.
+func WithReclaimFloors(floors, steps workload.PodSetsCounts) EnsureOption {
+	return func(o *ensureOptions) {
+		o.floors, o.steps, o.refreshFloors = floors, steps, true
+	}
+}
+
+func newEnsureOptions(opts []EnsureOption) ensureOptions {
+	var o ensureOptions
+	for _, opt := range opts {
+		if opt != nil {
+			opt(&o)
+		}
+	}
+	return o
+}
+
+// apply sets the annotations on wl and reports whether they changed.
+func (o *ensureOptions) apply(wl *kueue.Workload) bool {
+	if !o.refreshFloors {
+		return false
+	}
+	changed := syncAnnotation(wl, constants.ReclaimMinCountsAnnotation, o.floors, workload.SetReclaimMinCounts)
+	return syncAnnotation(wl, constants.PodSetCountStepsAnnotation, o.steps, workload.SetPodSetCountSteps) || changed
+}
+
+func syncAnnotation(wl *kueue.Workload, key string, counts workload.PodSetsCounts, set func(*kueue.Workload, workload.PodSetsCounts)) bool {
+	want := workload.FormatFloorCounts(counts)
+	got, found := wl.Annotations[key]
+	if got == want && found == (want != "") {
+		return false
+	}
+	set(wl, counts)
+	return true
+}
