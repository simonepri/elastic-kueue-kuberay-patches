+package jobframework
+
+import (
+	"maps"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// JobWithReclaimMinCounts is implemented by elastic jobs whose PodSets partial preemption may shrink.
+type JobWithReclaimMinCounts interface {
+	// ReclaimMinCounts returns the fewest pods each shrinkable PodSet may keep, a multiple
+	// of its step and at most its count. A PodSet it leaves out is only evicted whole.
+	ReclaimMinCounts() workload.PodSetsCounts
+}
+
+// JobWithPodSetCountSteps is implemented by jobs whose PodSets grow and shrink in steps.
+type JobWithPodSetCountSteps interface {
+	// PodSetCountSteps returns the pod count each PodSet grows and shrinks by, at least 1.
+	PodSetCountSteps() workload.PodSetsCounts
+}
+
+// ReclaimFloors returns the floors and steps the job asks its Workload to carry. Both are
+// empty unless PartialPreemption is on and the job uses workload slices.
+func ReclaimFloors(job GenericJob) (floors, steps workload.PodSetsCounts) {
+	if !features.Enabled(features.PartialPreemption) || !WorkloadSliceEnabled(job) {
+		return nil, nil
+	}
+	if j, ok := job.(JobWithReclaimMinCounts); ok {
+		floors = maps.Clone(j.ReclaimMinCounts())
+	}
+	if j, ok := job.(JobWithPodSetCountSteps); ok {
+		steps = maps.Clone(j.PodSetCountSteps())
+	}
+	return floors, steps
+}
+
+// applyReclaimFloors writes the job's floors and steps on a Workload built for it.
+func applyReclaimFloors(job GenericJob, wl *kueue.Workload) {
+	if !features.Enabled(features.PartialPreemption) {
+		return
+	}
+	floors, steps := ReclaimFloors(job)
+	workload.SetReclaimMinCounts(wl, floors)
+	workload.SetPodSetCountSteps(wl, steps)
+}
+
+// reclaimFloorsOption makes EnsureWorkloadSlices keep the floors and steps of the job's
+// Workload current. It is nil with PartialPreemption off, which leaves the Workload alone.
+func reclaimFloorsOption(job GenericJob) workloadslicing.EnsureOption {
+	if !features.Enabled(features.PartialPreemption) {
+		return nil
+	}
+	floors, steps := ReclaimFloors(job)
+	return workloadslicing.WithReclaimFloors(floors, steps)
+}
