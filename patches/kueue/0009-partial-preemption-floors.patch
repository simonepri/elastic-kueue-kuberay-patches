diff --git a/pkg/workload/reclaim_floors.go b/pkg/workload/reclaim_floors.go
new file mode 100644
index 0000000..df02f9e
--- /dev/null
+++ b/pkg/workload/reclaim_floors.go
@@ -0,0 +1,101 @@
+/*
+Copyright The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package workload
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+)
+
+// ReclaimMinCounts reads kueue.x-k8s.io/reclaim-min-counts. A malformed entry is ignored.
+func ReclaimMinCounts(wl *kueue.Workload) PodSetsCounts {
+	return parseFloorCounts(wl.Annotations[constants.ReclaimMinCountsAnnotation], 0)
+}
+
+// SetReclaimMinCounts writes kueue.x-k8s.io/reclaim-min-counts, or removes it when counts is empty.
+func SetReclaimMinCounts(wl *kueue.Workload, counts PodSetsCounts) {
+	setFloorCounts(wl, constants.ReclaimMinCountsAnnotation, counts)
+}
+
+// PodSetCountSteps reads kueue.x-k8s.io/podset-count-steps. Every PodSet of the Workload
+// is in the result; one the annotation leaves out, or lists with a malformed or non-positive
+// step, has step 1.
+func PodSetCountSteps(wl *kueue.Workload) PodSetsCounts {
+	listed := parseFloorCounts(wl.Annotations[constants.PodSetCountStepsAnnotation], 1)
+	steps := make(PodSetsCounts, len(wl.Spec.PodSets))
+	for i := range wl.Spec.PodSets {
+		name := wl.Spec.PodSets[i].Name
+		steps[name] = 1
+		if step, ok := listed[name]; ok {
+			steps[name] = step
+		}
+	}
+	return steps
+}
+
+// SetPodSetCountSteps writes kueue.x-k8s.io/podset-count-steps, or removes it when steps is empty.
+func SetPodSetCountSteps(wl *kueue.Workload, steps PodSetsCounts) {
+	setFloorCounts(wl, constants.PodSetCountStepsAnnotation, steps)
+}
+
+// FormatFloorCounts renders counts as <podSet>=<count>[,<podSet>=<count>], PodSets sorted by name.
+func FormatFloorCounts(counts PodSetsCounts) string {
+	names := make([]string, 0, len(counts))
+	for name := range counts {
+		names = append(names, string(name))
+	}
+	slices.Sort(names)
+	entries := make([]string, len(names))
+	for i, name := range names {
+		entries[i] = fmt.Sprintf("%s=%d", name, counts[kueue.PodSetReference(name)])
+	}
+	return strings.Join(entries, ",")
+}
+
+func setFloorCounts(wl *kueue.Workload, key string, counts PodSetsCounts) {
+	if len(counts) == 0 {
+		delete(wl.Annotations, key)
+		return
+	}
+	if wl.Annotations == nil {
+		wl.Annotations = make(map[string]string, 1)
+	}
+	wl.Annotations[key] = FormatFloorCounts(counts)
+}
+
+// parseFloorCounts parses a count list and ignores every entry that is malformed or whose
+// count is below minCount.
+func parseFloorCounts(value string, minCount int32) PodSetsCounts {
+	counts := PodSetsCounts{}
+	for entry := range strings.SplitSeq(value, ",") {
+		name, countStr, found := strings.Cut(entry, "=")
+		if !found || name == "" {
+			continue
+		}
+		count, err := strconv.ParseInt(countStr, 10, 32)
+		if err != nil || int32(count) < minCount {
+			continue
+		}
+		counts[kueue.PodSetReference(name)] = int32(count)
+	}
+	return counts
+}
