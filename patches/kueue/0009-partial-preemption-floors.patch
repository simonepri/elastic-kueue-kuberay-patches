+package constants
+
+const (
+	// ReclaimMinCountsAnnotation is the Workload annotation that lists the fewest pods each
+	// PodSet may keep when partial preemption shrinks it, as <podSet>=<count>[,<podSet>=<count>].
+	// A PodSet missing from the list is only evicted whole.
+	ReclaimMinCountsAnnotation = "kueue.x-k8s.io/reclaim-min-counts"
+
+	// PodSetCountStepsAnnotation is the Workload annotation that lists the pod count each
+	// PodSet shrinks and grows by, in the format of ReclaimMinCountsAnnotation.
+	// A PodSet missing from the list has step 1.
+	PodSetCountStepsAnnotation = "kueue.x-k8s.io/podset-count-steps"
+)
