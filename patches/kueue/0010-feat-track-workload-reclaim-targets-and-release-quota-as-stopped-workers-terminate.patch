+			if tc.failStatusWrite {
+				if !errors.Is(err, errTestStatusWrite) {
+					t.Fatalf("EnsureWorkloadSlices() error = %v, want %v", err, errTestStatusWrite)
+				}
+			} else {
+				if err != nil {
+					t.Fatalf("EnsureWorkloadSlices() error: %v", err)
+				}
+				if !compatible || got == nil || got.Name != wl.Name {
+					t.Fatalf("EnsureWorkloadSlices() workload = %v, compatible = %v", got, compatible)
+				}
+			}
+
+			var updated kueue.Workload
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(wl), &updated); err != nil {
+				t.Fatalf("Failed to get workload: %v", err)
+			}
+			if tc.wantUnchanged && updated.ResourceVersion != before.ResourceVersion {
+				t.Errorf("Workload was written, resourceVersion %s -> %s", before.ResourceVersion, updated.ResourceVersion)
+			}
+			if gotCount := updated.Spec.PodSets[0].Count; gotCount != tc.wantCount {
+				t.Errorf("PodSet count = %d, want %d", gotCount, tc.wantCount)
+			}
+			if diff := cmp.Diff(workload.PodSetsCounts{"workers": tc.wantTarget}, workload.ReclaimTargetCounts(&updated)); diff != "" {
+				t.Errorf("Reclaim target counts (-want,+got):\n%s", diff)
+			}
+			if gotReclaimable := workload.ReclaimableCounts(&updated)["workers"]; gotReclaimable != tc.wantReclaimable {
+				t.Errorf("Reclaimable count = %d, want %d", gotReclaimable, tc.wantReclaimable)
+			}
+			info := workload.NewInfo(log, &updated)
+			if gotCharged := info.TotalRequests[0].Count; gotCharged != tc.wantCharged {
+				t.Errorf("Charged pods = %d, want %d", gotCharged, tc.wantCharged)
+			}
+			if tc.pendingReplacementProbe {
+				var probeWl kueue.Workload
+				if err := clnt.Get(ctx, client.ObjectKeyFromObject(probe), &probeWl); err != nil {
+					t.Fatalf("Failed to get probe workload: %v", err)
+				}
+				if !workloadfinish.IsFinished(&probeWl) {
+					t.Errorf("Expected probe workload to be finished, got conditions: %v", probeWl.Status.Conditions)
+				}
+			}
+		})
+	}
+}
