+// Tests clearing of partial preemption reclaim targets and status when quota is released.
+package core
+
+import (
+	"testing"
+
+	gocmp "github.com/google/go-cmp/cmp"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	qcache "sigs.k8s.io/kueue/pkg/cache/queue"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+func TestClearReclaimTargets(t *testing.T) {
+	testCases := map[string]struct {
+		disablePartialPreemption bool
+		wantWrites               int
+		wantReclaimable          []kueue.ReclaimablePod
+		wantAnnotations          map[string]string
+	}{
+		"clears the reclaimable pods of the shrunk PodSets, then the targets": {
+			wantWrites:      2,
+			wantReclaimable: []kueue.ReclaimablePod{{Name: "other", Count: 1}},
+			wantAnnotations: map[string]string{"kept": "true"},
+		},
+		"with the gate turned off after a reclaim the targets are still cleared": {
+			disablePartialPreemption: true,
+			wantWrites:               2,
+			wantReclaimable:          []kueue.ReclaimablePod{{Name: "other", Count: 1}},
+			wantAnnotations:          map[string]string{"kept": "true"},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, !tc.disablePartialPreemption)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			wl := utiltestingapi.MakeWorkload("wl", "ns").
+				PodSets(
+					*utiltestingapi.MakePodSet("other", 2).Obj(),
+					*utiltestingapi.MakePodSet("workers", 8).Obj(),
+				).
+				Annotation("kept", "true").
+				Annotation(constants.ReclaimTargetCountsAnnotation, "workers=4").
+				Annotation(constants.ReclaimPreemptorAnnotation, "ns/preemptor").
+				Annotation(constants.ReclaimRequestedAtAnnotation, "2026-01-01T00:00:00Z").
+				ReclaimablePods(
+					kueue.ReclaimablePod{Name: "other", Count: 1},
+					kueue.ReclaimablePod{Name: "workers", Count: 4},
+				).
+				Obj()
+			cl := utiltesting.NewClientBuilder().WithObjects(wl).WithStatusSubresource(wl).Build()
+			r := &WorkloadReconciler{client: cl}
+
+			writes := 0
+			for range 3 {
+				var got kueue.Workload
+				if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+					t.Fatalf("Get() error: %v", err)
+				}
+				wrote, err := r.clearReclaimTargets(ctx, &got)
+				if err != nil {
+					t.Fatalf("clearReclaimTargets() error: %v", err)
+				}
+				if wrote {
+					writes++
+				}
+			}
+			if writes != tc.wantWrites {
+				t.Errorf("clearReclaimTargets() wrote %d times, want %d", writes, tc.wantWrites)
+			}
+			var got kueue.Workload
+			if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			if diff := gocmp.Diff(tc.wantReclaimable, got.Status.ReclaimablePods); diff != "" {
+				t.Errorf("Reclaimable pods (-want,+got):\n%s", diff)
+			}
+			if diff := gocmp.Diff(tc.wantAnnotations, got.Annotations); diff != "" {
+				t.Errorf("Annotations (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestReconcileClearsReclaimTargetsOnceQuotaIsReleased(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	ctx, _ := utiltesting.ContextWithLog(t)
+	wl := utiltestingapi.MakeWorkload("wl", "ns").
+		Queue("lq").
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).Obj()).
+		Annotation(constants.ReclaimTargetCountsAnnotation, "workers=4").
+		Annotation(constants.ReclaimPreemptorAnnotation, "ns/preemptor").
+		Annotation(constants.ReclaimRequestedAtAnnotation, "2026-01-01T00:00:00Z").
+		ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: 4}).
+		Obj()
+	cl := utiltesting.NewClientBuilder().
+		WithObjects(wl).
+		WithStatusSubresource(wl).
+		Build()
+	cqCache := schdcache.New(cl)
+	qManager := qcache.NewManagerForUnitTests(cl, cqCache)
+	reconciler := NewWorkloadReconciler(cl, qManager, cqCache, &utiltesting.EventRecorder{})
+	setupClusterQueue(ctx, t, cl, qManager, cqCache, utiltestingapi.MakeClusterQueue("cq").Obj(), false)
+	setupLocalQueue(ctx, t, cl, qManager, utiltestingapi.MakeLocalQueue("lq", "ns").ClusterQueue("cq").Obj(), false)
+
+	// The first reconciles sync the Workload's admission checks and conditions.
+	for range 5 {
+		if _, err := reconciler.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(wl)}); err != nil {
+			t.Fatalf("Reconcile() error: %v", err)
+		}
+	}
+	var got kueue.Workload
+	if err := cl.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+		t.Fatalf("Get() error: %v", err)
+	}
+	if len(got.Status.ReclaimablePods) != 0 {
+		t.Errorf("Reclaimable pods = %v, want none", got.Status.ReclaimablePods)
+	}
+	for _, key := range []string{constants.ReclaimTargetCountsAnnotation, constants.ReclaimPreemptorAnnotation, constants.ReclaimRequestedAtAnnotation} {
+		if _, found := got.Annotations[key]; found {
+			t.Errorf("Annotation %s was not cleared", key)
+		}
+	}
+}
