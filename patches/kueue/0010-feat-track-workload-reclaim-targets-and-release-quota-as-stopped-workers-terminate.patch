+				AdmittedAt(true, now)
+			if tc.reclaimable > 0 {
+				wlWrapper.ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: tc.reclaimable})
+			}
+			wl := wlWrapper.Obj()
+			objects := []client.Object{wl}
+			var probe *kueue.Workload
+			if tc.pendingReplacementProbe {
+				probe = utiltestingapi.MakeWorkload(testJobObject.Name+"-probe", testJobObject.Namespace).
+					OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+					Creation(now.Add(time.Minute)).
+					Annotation(constants.WorkloadSliceReplacementForAnnotation, wl.Name).
+					PodSets(*utiltestingapi.MakePodSet("workers", int(tc.count)).Request(corev1.ResourceCPU, "1").Obj()).
+					Obj()
+				objects = append(objects, probe)
+			}
+			if tc.additionalSlice {
+				objects = append(objects, utiltestingapi.MakeWorkload(testJobObject.Name+"-old", testJobObject.Namespace).
+					OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+					Creation(now.Add(-time.Minute)).
+					PodSets(*utiltestingapi.MakePodSet("workers", int(tc.count)).Request(corev1.ResourceCPU, "1").Obj()).
+					Obj())
+			}
+			builder := testWorkloadClientBuilder().WithObjects(objects...)
+			if tc.failStatusWrite {
+				builder = builder.WithInterceptorFuncs(interceptor.Funcs{
+					SubResourcePatch: func(context.Context, client.Client, string, client.Object, client.Patch, ...client.SubResourcePatchOption) error {
+						return errTestStatusWrite
+					},
+					SubResourceApply: func(context.Context, client.Client, string, runtime.ApplyConfiguration, ...client.SubResourceApplyOption) error {
+						return errTestStatusWrite
+					},
+				})
+			}
+			clnt := builder.Build()
+			ctx, log := utiltesting.ContextWithLog(t)
+			var before kueue.Workload
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(wl), &before); err != nil {
+				t.Fatalf("Failed to get workload: %v", err)
+			}
+
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(now)}
+			jobPodSets := []kueue.PodSet{*utiltestingapi.MakePodSet("workers", int(tc.jobCount)).Request(corev1.ResourceCPU, "1").Obj()}
