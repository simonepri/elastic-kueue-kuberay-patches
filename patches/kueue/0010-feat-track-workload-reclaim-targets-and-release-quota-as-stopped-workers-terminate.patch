+// Tests releasing quota and capping ungate operations to reclaim targets during partial preemption.
+package elasticjobs
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	gocmp "github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	testingclock "k8s.io/utils/clock/testing"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/client/interceptor"
+	"sigs.k8s.io/controller-runtime/pkg/reconcile"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	coreindexer "sigs.k8s.io/kueue/pkg/controller/core/indexer"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/util/expectations"
+	utilpod "sigs.k8s.io/kueue/pkg/util/pod"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+func TestReconcileReclaimTargets(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	now := time.Now().Truncate(time.Second)
+
+	running := func(name string) corev1.Pod { return *makeElasticPodForPodSet(name, workersPodSet).Obj() }
+	gated := func(name string) corev1.Pod {
+		return *makeElasticPodForPodSet(name, workersPodSet).Gate(kueue.ElasticJobSchedulingGate).Obj()
+	}
+	testCases := map[string]struct {
+		disablePartialPreemption bool
+		// noTarget leaves the reclaim target annotation out.
+		noTarget bool
+		// staleTarget requests the target before the current quota reservation.
+		staleTarget bool
+		// workersCount lowers the spec count of the workers, admitted with 2 pods.
+		workersCount int32
+		reclaimable  int32
+		pods         []corev1.Pod
+		// expectUngated preloads an ungate expectation for these pods, as if the
+		// previous reconcile ungated them but the cache does not show it yet.
+		expectUngated   []string
+		wantGated       []string
+		wantReclaimable int32
+		wantErr         error
+		wantTarget      string
+	}{
+		"a pending target keeps the quota while a pod above it runs": {
+			pods:      []corev1.Pod{running("w-0"), running("w-1"), gated("w-2")},
+			wantGated: []string{"w-2"},
+		},
+		"a pending target releases the quota once the pods above it are gone": {
+			pods:            []corev1.Pod{running("w-0"), gated("w-1")},
+			wantGated:       []string{"w-1"},
+			wantReclaimable: 1,
+		},
+		"a released target keeps the recreated pods gated": {
+			reclaimable:     1,
+			pods:            []corev1.Pod{running("w-0"), gated("w-1")},
+			wantGated:       []string{"w-1"},
+			wantReclaimable: 1,
+		},
+		"a scale-down whose reclaimable pods were not re-derived is charged the target again": {
+			workersCount:    1,
+			reclaimable:     1,
+			pods:            []corev1.Pod{running("w-0")},
+			wantReclaimable: 0,
+		},
+		"an ungate the cache does not show yet keeps the quota": {
+			pods:          []corev1.Pod{running("w-0"), gated("w-1")},
+			expectUngated: []string{"w-1"},
+			wantGated:     []string{"w-1"},
+			wantErr:       errPendingUngateOps,
+		},
+		"a pending target keeps ungating the PodSets without a target": {
+			pods: []corev1.Pod{
+				running("w-0"), running("w-1"),
+				*makeElasticPodForPodSet("head", headPodSet).Gate(kueue.ElasticJobSchedulingGate).Obj(),
+			},
+		},
+		"a target requested for an earlier quota reservation is cleared and ignored": {
+			staleTarget: true,
+			pods:        []corev1.Pod{running("w-0"), gated("w-1")},
+		},
+		"with the gate turned off after a reclaim the target still caps and releases": {
+			disablePartialPreemption: true,
+			pods:                     []corev1.Pod{running("w-0"), gated("w-1")},
+			wantGated:                []string{"w-1"},
+			wantReclaimable:          1,
+		},
+		"with the gate off and no target the ungater follows upstream": {
+			disablePartialPreemption: true,
+			noTarget:                 true,
+			pods:                     []corev1.Pod{running("w-0"), gated("w-1")},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, !tc.disablePartialPreemption)
+			ctx, log := utiltesting.ContextWithLog(t)
+			wl := makeAdmittedTwoPodSetWorkload(now)
+			wantTarget := "workers=1"
+			if !tc.noTarget {
+				workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{workersPodSet: 1})
+				requestedAt := now
+				if tc.staleTarget {
+					requestedAt = now.Add(-time.Minute)
+					wantTarget = ""
+				}
+				metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimRequestedAtAnnotation, requestedAt.Format(time.RFC3339))
+			} else {
+				wantTarget = ""
+			}
+			if tc.workersCount > 0 {
+				wl.Spec.PodSets[1].Count = tc.workersCount
+			}
+			if tc.reclaimable > 0 {
+				wl.Status.ReclaimablePods = []kueue.ReclaimablePod{{Name: workersPodSet, Count: tc.reclaimable}}
+			}
+			builder := utiltesting.NewClientBuilder().
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+				WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(rayClusterGVK), coreindexer.WorkloadOwnerIndexFunc(rayClusterGVK)).
+				WithIndex(&kueue.Workload{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexWorkloadSliceName).
+				WithStatusSubresource(wl).
+				WithInterceptorFuncs(interceptor.Funcs{
+					Patch: func(ctx context.Context, clnt client.WithWatch, obj client.Object, _ client.Patch, _ ...client.PatchOption) error {
+						return clnt.Update(ctx, obj)
+					},
+				})
+			for i := range tc.pods {
+				builder = builder.WithObjects(&tc.pods[i])
+			}
+			kClient := builder.Build()
+			if err := kClient.Create(ctx, wl); err != nil {
+				t.Fatalf("Could not create workload: %v", err)
+			}
+			ungater := &elasticJobUngater{
+				client:            kClient,
+				clock:             testingclock.NewFakeClock(now),
+				expectationsStore: expectations.NewStore(ControllerName),
+			}
+			for _, name := range tc.expectUngated {
+				var pod corev1.Pod
+				if err := kClient.Get(ctx, client.ObjectKey{Namespace: wl.Namespace, Name: name}, &pod); err != nil {
+					t.Fatalf("Could not get pod %s: %v", name, err)
+				}
+				ungater.expectationsStore.ExpectUIDs(log, client.ObjectKey{Namespace: wl.Namespace, Name: workloadslicing.SliceName(wl)}, []types.UID{pod.UID})
+			}
+			// A stale target is cleared first; the next reconcile then ungates.
+			for range 2 {
+				_, err := ungater.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(wl)})
+				if diff := gocmp.Diff(tc.wantErr, err, cmpopts.EquateErrors()); diff != "" {
+					t.Fatalf("Reconcile() error (-want,+got):\n%s", diff)
+				}
+				if !tc.staleTarget {
+					break
+				}
+			}
+
+			var pods corev1.PodList
+			if err := kClient.List(ctx, &pods); err != nil {
+				t.Fatalf("Could not list pods: %v", err)
+			}
+			var gotGated []string
+			for i := range pods.Items {
+				if utilpod.HasGate(&pods.Items[i], kueue.ElasticJobSchedulingGate) {
+					gotGated = append(gotGated, pods.Items[i].Name)
+				}
+			}
+			if diff := gocmp.Diff(tc.wantGated, gotGated); diff != "" {
+				t.Errorf("Gated pods (-want,+got):\n%s", diff)
+			}
+			var got kueue.Workload
+			if err := kClient.Get(ctx, client.ObjectKeyFromObject(wl), &got); err != nil {
+				t.Fatalf("Could not get workload: %v", err)
+			}
+			if gotReclaimable := workload.ReclaimableCounts(&got)[workersPodSet]; gotReclaimable != tc.wantReclaimable {
+				t.Errorf("Reclaimable workers = %d, want %d", gotReclaimable, tc.wantReclaimable)
+			}
+			if got.Annotations[constants.ReclaimTargetCountsAnnotation] != wantTarget {
+				t.Errorf("Reclaim target counts = %q, want %q", got.Annotations[constants.ReclaimTargetCountsAnnotation], wantTarget)
+			}
+		})
+	}
+}
