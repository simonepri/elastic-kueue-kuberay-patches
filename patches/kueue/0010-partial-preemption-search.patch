+			}
+			victim := run.snapshot.ClusterQueue("borrower").Workloads["default/victim"]
+			revert := policy.SimulateRemoval(run.snapshot, []*Target{{WorkloadInfo: victim, Remaining: policy.ShrunkTo(victim, workload.PodSetsCounts{"main": 2})}})
+			defer revert()
+			run.incoming.TotalRequests[0] = *run.incoming.TotalRequests[0].ScaledTo(1)
+			run.assign.PodSets[0].Requests[corev1.ResourceCPU] = resource.MustParse("3")
