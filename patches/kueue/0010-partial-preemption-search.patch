+
+// Partial preemption in the classical strategy: which candidates are offered
+// shrunk, how a shrunk target escalates to a whole eviction or grows back
+// during fill-back, and how a partial target is issued as a reclaim target.
+
+package preemption
+
+import (
+	"context"
+	"maps"
+	"slices"
+	"sort"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/klog/v2"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	controllerconstants "sigs.k8s.io/kueue/pkg/controller/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption/policy"
+	utilclient "sigs.k8s.io/kueue/pkg/util/client"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+)
+
+// reclaimTimeout is how long a reclaim target may stay pending before a
+// preemptor that needs the victim evicts it whole.
+const reclaimTimeout = 5 * time.Minute
+
+// reclaimBound is the range a PodSet of a partial target may keep: from floor
+// up to ceiling pods, in steps of step. A target is offered at initial pods.
+type reclaimBound struct {
+	floor, ceiling, initial, step int32
+}
+
+// reclaimBounds returns the bound of each PodSet of wl that partial preemption
+// may shrink, or nil when wl may only be evicted whole. A workload whose reclaim
+// target is pending keeps at most that target, and is offered at it; one whose
+// target is older than reclaimTimeout is only evicted whole. Any other workload
+// is offered at the floors of kueue.x-k8s.io/reclaim-min-counts, rounded up to
+// their steps.
+func reclaimBounds(wl *workload.Info, now time.Time) map[kueue.PodSetReference]reclaimBound {
+	if !features.Enabled(features.PartialPreemption) || workloadevict.IsEvicted(wl.Obj) {
+		return nil
+	}
+	floors := workload.ReclaimMinCounts(wl.Obj)
+	pending := workload.PendingReclaimTargetCounts(wl.Obj)
+	if len(floors) == 0 && len(pending) == 0 {
+		return nil
+	}
+	if len(pending) > 0 && reclaimTimedOut(wl.Obj, now) {
+		return nil
+	}
+	steps := workload.PodSetCountSteps(wl.Obj)
+	bounds := make(map[kueue.PodSetReference]reclaimBound)
+	for _, ps := range wl.TotalRequests {
+		step := max(1, steps[ps.Name])
+		floor, hasFloor := floors[ps.Name]
+		if hasFloor {
+			floor = (floor + step - 1) / step * step
+		}
+		if len(pending) > 0 {
+			target, found := pending[ps.Name]
+			if !found || target >= ps.Count {
+				continue
+			}
+			if !hasFloor || floor > target {
+				floor = target
+			}
+			bounds[ps.Name] = reclaimBound{floor: floor, ceiling: target, initial: target, step: step}
+		} else if hasFloor && floor < ps.Count {
+			ceiling := floor + (ps.Count-1-floor)/step*step
+			bounds[ps.Name] = reclaimBound{floor: floor, ceiling: ceiling, initial: floor, step: step}
+		}
+	}
+	if len(bounds) == 0 {
+		return nil
+	}
+	return bounds
+}
+
+func reclaimTimedOut(wl *kueue.Workload, now time.Time) bool {
+	requestedAt, err := time.Parse(time.RFC3339, wl.Annotations[constants.ReclaimRequestedAtAnnotation])
+	return err == nil && now.Sub(requestedAt) >= reclaimTimeout
+}
+
+// offerPartially sets the target's Remaining to its workload shrunk to the
+// counts partial preemption offers it at, if it may shrink.
+func offerPartially(preemptionCtx *preemptionCtx, t *Target) {
+	bounds := reclaimBounds(t.WorkloadInfo, preemptionCtx.clock.Now())
+	if bounds == nil {
+		return
+	}
+	counts := make(workload.PodSetsCounts, len(bounds))
+	for name, b := range bounds {
+		counts[name] = b.initial
+	}
+	t.Remaining = policy.ShrunkTo(t.WorkloadInfo, counts)
+}
+
+// snapshotCandidate returns the workload the snapshot holds under the key of
+// a candidate an iterator returned. They differ only when another preemption
+// this cycle shrank the candidate and the snapshot holds what remains of it,
+// which the candidate-order cache does not know.
+func snapshotCandidate(preemptionCtx *preemptionCtx, wl *workload.Info) *workload.Info {
+	if !features.Enabled(features.PartialPreemption) {
+		return wl
+	}
+	if current := preemptionCtx.snapshot.ClusterQueue(wl.ClusterQueue).Workloads[workload.Key(wl.Obj)]; current != nil {
+		return current
+	}
+	return wl
+}
+
+// escalatePartialTargets evicts the shrunk targets whole, one at a time in the
+// order they were offered, until the preemptor fits. It reports whether it
+// fits; it never escalates when no target is shrunk.
+func escalatePartialTargets(ctx context.Context, preemptionCtx *preemptionCtx, targets []*Target, allowBorrowing bool) bool {
+	for _, t := range targets {
+		if t.Remaining == nil {
+			continue
+		}
+		preemptionCtx.snapshot.RemoveWorkload(t.Remaining)
+		t.Remaining = nil
+		if workloadFitsNotingTopology(ctx, preemptionCtx, allowBorrowing) {
+			return true
+		}
+	}
+	return false
+}
+
+// growPartialTargets gives each target offered shrunk back as many pods as
+// the preemptor still fits with, in steps up to its ceiling, in reverse
+// order. A target that was escalated is shrunk to its floors again first, if
+// the preemptor still fits.
+func growPartialTargets(ctx context.Context, preemptionCtx *preemptionCtx, targets []*Target, partial []*Target, allowBorrowing bool) {
+	snapshot := preemptionCtx.snapshot
+	swap := func(from, to *workload.Info) {
+		snapshot.RemoveWorkload(from)
+		snapshot.AddWorkload(to)
+	}
+	for _, t := range slices.Backward(targets) {
+		if !slices.Contains(partial, t) {
+			continue
+		}
+		bounds := reclaimBounds(t.WorkloadInfo, preemptionCtx.clock.Now())
+		if bounds == nil {
+			continue
+		}
+		counts := make(workload.PodSetsCounts, len(bounds))
+		for name, b := range bounds {
+			counts[name] = b.floor
+		}
+		if t.Remaining == nil {
+			remaining := policy.ShrunkTo(t.WorkloadInfo, counts)
+			snapshot.AddWorkload(remaining)
+			if !workloadFits(ctx, preemptionCtx, allowBorrowing) {
+				snapshot.RemoveWorkload(remaining)
+				continue
+			}
+			t.Remaining = remaining
+		}
+		for _, ps := range t.Remaining.TotalRequests {
+			if _, found := bounds[ps.Name]; found {
+				counts[ps.Name] = ps.Count
+			}
+		}
+		for _, name := range slices.Sorted(maps.Keys(bounds)) {
+			b, current := bounds[name], counts[name]
+			grownBy := func(steps int) *workload.Info {
+				grown := maps.Clone(counts)
+				grown[name] = current + int32(steps)*b.step
+				return policy.ShrunkTo(t.WorkloadInfo, grown)
+			}
+			steps := sort.Search(int((b.ceiling-current)/b.step), func(i int) bool {
+				grown := grownBy(i + 1)
+				swap(t.Remaining, grown)
+				fits := workloadFits(ctx, preemptionCtx, allowBorrowing)
+				swap(grown, t.Remaining)
+				return !fits
+			})
+			if steps > 0 {
+				grown := grownBy(steps)
+				swap(t.Remaining, grown)
+				t.Remaining = grown
+				counts[name] += int32(steps) * b.step
+			}
+		}
+	}
+}
+
+// issuePartialPreemption writes the target's Remaining counts as the victim's
+// reclaim target, never raising a target already set. It sets no preemption
+// expectation: an admitted victim that only gains an annotation is never
+// observed as evicted, and writing the same target again changes nothing.
+func (p *Preemptor) issuePartialPreemption(ctx context.Context, preemptor *workload.Info, target *Target) error {
+	wl := target.WorkloadInfo.Obj.DeepCopy()
+	changed := false
+	err := utilclient.Patch(ctx, p.client, wl, func() (bool, error) {
+		changed = setReclaimTarget(wl, target.Remaining, workload.Key(preemptor.Obj), p.clock.Now())
+		return changed, nil
+	}, utilclient.WithRetryOnConflict())
+	if err != nil || !changed {
+		return err
+	}
+	log.FromContext(ctx).V(3).Info("Partially preempted", "targetWorkload", klog.KObj(wl), "preemptingWorkload", klog.KObj(preemptor.Obj),
+		"reason", target.Reason, "reclaimTargetCounts", wl.Annotations[constants.ReclaimTargetCountsAnnotation])
+	p.recorder.Eventf(target.WorkloadInfo.Obj, nil, corev1.EventTypeNormal, "PartiallyPreempted", "PartiallyPreempted",
+		"Shrinking to %s to accommodate a workload (UID: %s, JobUID: %s) due to %s",
+		wl.Annotations[constants.ReclaimTargetCountsAnnotation], preemptor.Obj.UID, preemptor.Obj.Labels[controllerconstants.JobUIDLabel],
+		HumanReadablePreemptionReasons[target.Reason])
+	return nil
+}
+
+// setReclaimTarget lowers wl's reclaim target of each PodSet that remaining
+// keeps fewer pods of than wl is charged for to min(existing, remaining), and
+// records the preemptor, and the time when no target was pending before. It
+// reports whether it changed wl.
+func setReclaimTarget(wl *kueue.Workload, remaining *workload.Info, preemptor workload.Reference, now time.Time) bool {
+	targets := workload.ReclaimTargetCounts(wl)
+	pendingBefore := len(workload.PendingReclaimTargetCounts(wl)) > 0
+	granted := workload.ExtractGrantedPodSetCountsAfterReclaim(wl)
+	changed := false
+	for _, ps := range remaining.TotalRequests {
+		if count, found := granted[ps.Name]; !found || ps.Count >= count {
+			continue
+		}
+		if existing, found := targets[ps.Name]; found && existing <= ps.Count {
+			continue
+		}
+		if targets == nil {
+			targets = make(workload.PodSetsCounts)
+		}
+		targets[ps.Name] = ps.Count
+		changed = true
+	}
+	if !changed {
+		return false
+	}
+	workload.SetReclaimTargetCounts(wl, targets)
+	metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimPreemptorAnnotation, string(preemptor))
+	if !pendingBefore {
+		metav1.SetMetaDataAnnotation(&wl.ObjectMeta, constants.ReclaimRequestedAtAnnotation, now.UTC().Format(time.RFC3339))
+	}
+	return true
+}
