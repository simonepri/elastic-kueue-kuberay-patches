+// TestFitsCountsShrunkVictimsRemainingPods checks that the in-cycle fit check
+// frees only what a shrunk victim gives up.
+func TestFitsCountsShrunkVictimsRemainingPods(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	ctx, log := utiltesting.ContextWithLog(t)
+	cl := utiltesting.NewClientBuilder().Build()
+	cqCache := schdcache.New(cl)
+	cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	if err := cqCache.AddClusterQueue(ctx, utiltestingapi.MakeClusterQueue("cq").
+		ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "4").Obj()).Obj()); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := cqCache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	victim := workload.NewInfo(log, utiltestingapi.MakeWorkload("victim", "default").
+		PodSets(*utiltestingapi.MakePodSet("main", 4).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(utiltestingapi.MakePodSetAssignment("main").Count(4).
+			Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), time.Now()).Obj())
+	snapshot.AddWorkload(victim)
+	cq := snapshot.ClusterQueue("cq")
+	need := func(cpu int64) *workload.Usage {
+		return &workload.Usage{Quota: workload.ResourceUsage{Assigned: resources.FlavorResourceQuantities{
+			{Flavor: "default", Resource: corev1.ResourceCPU}: resources.NewAmount(cpu * 1000),
+		}}}
+	}
+	shrunk := &preemption.Target{WorkloadInfo: victim, Remaining: policy.ShrunkTo(victim, workload.PodSetsCounts{"main": 2})}
+	if got := fits(snapshot, cq, need(2), nil, []*preemption.Target{shrunk}); got != schdcache.FitsCheckOk {
+		t.Errorf("fits() for what the shrink frees = %v, want Ok", got)
+	}
+	if got := fits(snapshot, cq, need(3), nil, []*preemption.Target{shrunk}); got != schdcache.FitsCheckNoQuota {
+		t.Errorf("fits() for more than the shrink frees = %v, want NoQuota", got)
+	}
+	preempted := preemption.PreemptedWorkloads{workload.Key(victim.Obj): shrunk}
+	if got := fits(snapshot, cq, need(3), preempted, nil); got != schdcache.FitsCheckNoQuota {
+		t.Errorf("fits() after another preemptor shrank the victim = %v, want NoQuota", got)
+	}
+}
