+// TestIssuePartialPreemption checks that a partial target is written as a
+// reclaim target on the victim, only ever lowered, without an expectation.
+func TestIssuePartialPreemption(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	now := time.Now().Truncate(time.Second)
+	cases := map[string]struct {
+		victim          ppWorkload
+		needCPU         int64
+		wantTargets     []string
+		wantAnnotations map[string]string
+	}{
+		"first target": {
+			victim:      elastic("victim", "borrower", 0, 4, "main=1"),
+			needCPU:     2,
+			wantTargets: []string{"victim:main=2"},
+			wantAnnotations: map[string]string{
+				constants.ReclaimTargetCountsAnnotation: "main=2",
+				constants.ReclaimPreemptorAnnotation:    "default/preemptor",
+				constants.ReclaimRequestedAtAnnotation:  now.UTC().Format(time.RFC3339),
+			},
+		},
+		"the same pending target again writes nothing": {
+			victim:      ppWorkload{name: "victim", cq: "borrower", podSets: []ppPodSet{{name: "main", count: 4, cpu: 1}}, floors: "main=1", pending: "main=2", requestedAt: time.Minute},
+			needCPU:     2,
+			wantTargets: []string{"victim:main=2"},
+			wantAnnotations: map[string]string{
+				constants.ReclaimTargetCountsAnnotation: "main=2",
+				constants.ReclaimPreemptorAnnotation:    "default/earlier",
+				constants.ReclaimRequestedAtAnnotation:  now.Add(-time.Minute).UTC().Format(time.RFC3339),
+			},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			sc := ppScenario{incoming: 2, lender: 2, needCPU: tc.needCPU, workloads: []ppWorkload{tc.victim}}
+			run, expectations, list := setUpPartial(t, sc, classicalModes[0], now)
+			before := list()[0].ResourceVersion
+			targets := run.targets()
+			if diff := gocmp.Diff(tc.wantTargets, describeTargets(targets)); diff != "" {
+				t.Fatalf("unexpected targets (-want,+got):\n%s", diff)
+			}
+			ctx, log := utiltesting.ContextWithLog(t)
+			cached := targets[0].WorkloadInfo.Obj.DeepCopy()
+			for range 2 {
+				preempted, failed, err := run.preemptor.IssuePreemptions(ctx, run.cache, run.incoming, targets, run.snapshot.ClusterQueue("incoming"))
+				if err != nil || preempted != 1 || failed != 0 {
+					t.Fatalf("IssuePreemptions() = %d, %d, %v; want 1, 0, nil", preempted, failed, err)
+				}
+			}
+			if diff := gocmp.Diff(cached, targets[0].WorkloadInfo.Obj); diff != "" {
+				t.Errorf("IssuePreemptions mutated the cached victim (-before,+after):\n%s", diff)
+			}
+			got := list()[0]
+			gotAnnotations := make(map[string]string)
+			for _, key := range []string{constants.ReclaimTargetCountsAnnotation, constants.ReclaimPreemptorAnnotation, constants.ReclaimRequestedAtAnnotation} {
+				if v, found := got.Annotations[key]; found {
+					gotAnnotations[key] = v
+				}
+			}
+			if diff := gocmp.Diff(tc.wantAnnotations, gotAnnotations); diff != "" {
+				t.Errorf("unexpected reclaim annotations (-want,+got):\n%s", diff)
+			}
+			if tc.victim.pending != "" && got.ResourceVersion != before {
+				t.Errorf("re-issuing the pending target wrote the victim: resourceVersion %s -> %s", before, got.ResourceVersion)
+			}
+			if got.Status.Admission == nil || workloadevict.IsEvicted(&got) {
+				t.Error("the victim of a partial preemption lost its admission or was evicted")
+			}
+			if !expectations.Satisfied(log, types.NamespacedName{Namespace: "default", Name: "victim"}) {
+				t.Error("a partial preemption left a preemption expectation pending")
+			}
+		})
+	}
+}
