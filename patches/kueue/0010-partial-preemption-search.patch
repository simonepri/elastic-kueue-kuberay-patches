+
+// Tests of partial preemption in the preemption search: which targets are
+// shrunk, escalated or grown back, that only the classical strategy shrinks,
+// and how a partial target is issued.
+
+package preemption
+
+import (
+	"fmt"
+	"slices"
+	"testing"
+	"time"
+
+	gocmp "github.com/google/go-cmp/cmp"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/component-base/featuregate"
+	clocktesting "k8s.io/utils/clock/testing"
+
+	config "sigs.k8s.io/kueue/apis/config/v1beta2"
+	kueuealpha "sigs.k8s.io/kueue/apis/kueue/v1alpha1"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/controller/core/indexer"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/resources"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	preemptexpectations "sigs.k8s.io/kueue/pkg/scheduler/preemption/expectations"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption/policy"
+	utilexpectations "sigs.k8s.io/kueue/pkg/util/expectations"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingalpha "sigs.k8s.io/kueue/pkg/util/testing/v1alpha1"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingnode "sigs.k8s.io/kueue/pkg/util/testingjobs/node"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+)
+
+// ppPodSet is a PodSet of an admitted test workload, with cpu whole CPUs per pod.
+type ppPodSet struct {
+	name     kueue.PodSetReference
+	count    int32
+	cpu      int64
+	admitted int32 // 0 means count
+	nilCount bool  // admit with a nil count, which means the spec count
+	minCount int32 // 0 means none
+}
+
+// ppWorkload is an admitted test workload. floors and steps are written as R4
+// writes them, and pending as R5 writes a reclaim target.
+type ppWorkload struct {
+	name        string
+	cq          kueue.ClusterQueueReference
+	priority    int32
+	podSets     []ppPodSet
+	floors      string
+	steps       string
+	pending     string
+	requestedAt time.Duration // age of the pending target
+	reclaimable []kueue.ReclaimablePod
+	evicted     bool
+	elastic     bool
+}
+
+func (w ppWorkload) obj(now time.Time, age time.Duration) *kueue.Workload {
+	wrapper := utiltestingapi.MakeWorkload(w.name, "default").Priority(w.priority)
+	var podSets []kueue.PodSet
+	admission := utiltestingapi.MakeAdmission(w.cq)
+	var assignments []kueue.PodSetAssignment
+	for _, ps := range w.podSets {
+		psw := utiltestingapi.MakePodSet(ps.name, int(ps.count)).Request(corev1.ResourceCPU, fmt.Sprint(ps.cpu))
+		if ps.minCount > 0 {
+			psw.SetMinimumCount(ps.minCount)
+		}
+		podSets = append(podSets, *psw.Obj())
+		admitted := ps.count
+		if ps.admitted > 0 {
+			admitted = ps.admitted
+		}
+		psa := utiltestingapi.MakePodSetAssignment(ps.name).Count(admitted).
+			Assignment(corev1.ResourceCPU, "default", fmt.Sprint(ps.cpu*int64(admitted))).Obj()
+		if ps.nilCount {
+			psa.Count = nil
+		}
+		assignments = append(assignments, psa)
+	}
+	wrapper.PodSets(podSets...).ReserveQuotaAt(admission.PodSets(assignments...).Obj(), now.Add(-age)).AdmittedAt(true, now.Add(-age))
+	if w.floors != "" {
+		wrapper.Annotation(constants.ReclaimMinCountsAnnotation, w.floors)
+	}
+	if w.steps != "" {
+		wrapper.Annotation(constants.PodSetCountStepsAnnotation, w.steps)
+	}
+	if w.pending != "" {
+		wrapper.Annotation(constants.ReclaimTargetCountsAnnotation, w.pending).
+			Annotation(constants.ReclaimPreemptorAnnotation, "default/earlier").
+			Annotation(constants.ReclaimRequestedAtAnnotation, now.Add(-w.requestedAt).UTC().Format(time.RFC3339))
+	}
+	if w.elastic {
+		wrapper.Annotation(constants.ElasticJobAnnotation, "true")
+	}
+	if len(w.reclaimable) > 0 {
+		wrapper.ReclaimablePods(w.reclaimable...)
+	}
+	if w.evicted {
+		wrapper.EvictedAt(now)
+	}
+	return wrapper.Obj()
+}
+
+// elastic returns a single-PodSet workload of count pods of one CPU with the given floor.
+func elastic(name string, cq kueue.ClusterQueueReference, priority, count int32, floor string) ppWorkload {
+	return ppWorkload{name: name, cq: cq, priority: priority, podSets: []ppPodSet{{name: "main", count: count, cpu: 1}}, floors: floor}
+}
+
+// whole returns a single-PodSet workload with no floor.
+func whole(name string, cq kueue.ClusterQueueReference, priority, count int32, cpu int64) ppWorkload {
+	return ppWorkload{name: name, cq: cq, priority: priority, podSets: []ppPodSet{{name: "main", count: count, cpu: cpu}}}
+}
+
+type ppScenario struct {
+	// nominal CPU of the incoming, borrower and lender ClusterQueues in one cohort.
+	incoming, borrower, lender int64
+	// withinCQ is the incoming ClusterQueue's WithinClusterQueue policy; Never when empty.
+	withinCQ  kueue.PreemptionPolicy
+	workloads []ppWorkload
+	// needCPU and priority of the incoming workload, a single pod.
+	needCPU  int64
+	priority int32
+}
+
+type ppMode struct {
+	name         string
+	cacheEnabled bool
+	fairSharing  *config.FairSharing
+}
+
+var classicalModes = []ppMode{{name: "classical/cache=false"}, {name: "classical/cache=true", cacheEnabled: true}}
+
+var fairSharingModes = []ppMode{
+	{name: "fairsharing", fairSharing: &config.FairSharing{}},
+	{name: "fairsharing/LessThanInitialShare", fairSharing: &config.FairSharing{
+		PreemptionStrategies: []config.PreemptionStrategy{config.LessThanInitialShare},
+	}},
+}
+
+type ppRun struct {
+	t         *testing.T
+	preemptor *Preemptor
+	cache     *schdcache.Cache
+	snapshot  *schdcache.Snapshot
+	incoming  *workload.Info
+	assign    flavorassigner.Assignment
+	clock     *clocktesting.FakeClock
+}
+
+// setUpPartial builds the cache, snapshot and preemptor for the scenario.
+func setUpPartial(t *testing.T, sc ppScenario, mode ppMode, now time.Time) (*ppRun, *utilexpectations.Store, func() []kueue.Workload) {
+	t.Helper()
+	ctx, log := utiltesting.ContextWithLog(t)
+	var admitted []kueue.Workload
+	for i, w := range sc.workloads {
+		admitted = append(admitted, *w.obj(now, time.Duration(len(sc.workloads)-i)*time.Minute))
+	}
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: admitted}).
+		WithStatusSubresource(&kueue.Workload{}).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	withinCQ := sc.withinCQ
+	if withinCQ == "" {
+		withinCQ = kueue.PreemptionPolicyNever
+	}
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, fmt.Sprint(sc.incoming)).Obj()).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny, WithinClusterQueue: withinCQ}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, fmt.Sprint(sc.borrower)).Obj()).Obj(),
+		utiltestingapi.MakeClusterQueue("lender").Cohort("shared").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, fmt.Sprint(sc.lender)).Obj()).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	info := workload.NewInfo(log, utiltestingapi.MakeWorkload("preemptor", "default").Priority(sc.priority).
+		PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, fmt.Sprint(sc.needCPU)).Obj()).Obj())
+	info.ClusterQueue = "incoming"
+	assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+		Name: "main", Count: 1, Requests: corev1.ResourceList{corev1.ResourceCPU: *resource.NewQuantity(sc.needCPU, resource.DecimalSI)},
+		Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "default", Mode: flavorassigner.Preempt}},
+	}}}
+	clock := clocktesting.NewFakeClock(now)
+	expectations := preemptexpectations.New()
+	preemptor := New(cl, workload.Ordering{}, &utiltesting.EventRecorder{}, mode.fairSharing, false, clock, nil, expectations, nil)
+	list := func() []kueue.Workload {
+		var wls kueue.WorkloadList
+		if err := cl.List(ctx, &wls); err != nil {
+			t.Fatal(err)
+		}
+		return wls.Items
+	}
+	return &ppRun{t: t, preemptor: preemptor, cache: cache, snapshot: snapshot, incoming: info, assign: assignment, clock: clock}, expectations, list
+}
+
+// targets runs the search and checks that it leaves the snapshot as it found it.
+func (r *ppRun) targets() []*Target {
+	r.t.Helper()
+	ctx, _ := utiltesting.ContextWithLog(r.t)
+	before, err := r.cache.Snapshot(ctx)
+	if err != nil {
+		r.t.Fatal(err)
+	}
+	targets, _ := r.preemptor.GetTargets(ctx, *r.incoming, r.snapshot, r.assign)
+	if diff := gocmp.Diff(before, r.snapshot, snapCmpOpts); diff != "" {
+		r.t.Errorf("snapshot changed by the search (-before,+after):\n%s", diff)
+	}
+	return targets
+}
+
+// describeTargets returns each target's name, and the counts a shrunk target keeps.
+func describeTargets(targets []*Target) []string {
+	var got []string
+	for _, t := range targets {
+		s := t.WorkloadInfo.Obj.Name
+		if t.Remaining != nil {
+			kept := make(workload.PodSetsCounts)
+			for i, ps := range t.Remaining.TotalRequests {
+				if ps.Count != t.WorkloadInfo.TotalRequests[i].Count {
+					kept[ps.Name] = ps.Count
+				}
+			}
+			s += ":" + workload.FormatPodSetCounts(kept)
+		}
+		got = append(got, s)
+	}
+	slices.Sort(got)
+	return got
+}
+
+func TestPartialPreemptionSearch(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	cases := map[string]struct {
+		sc ppScenario
+		// want is the result with PartialPreemption on, wantOff with it off.
