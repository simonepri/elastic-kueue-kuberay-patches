+			defer cancel()
+			go qManager.CleanUpOnContext(ctx)
+			scheduler.schedule(ctx)
+			wg.Wait()
+
+			var got kueue.WorkloadList
+			if err := cl.List(ctx, &got); err != nil {
+				t.Fatal(err)
+			}
+			byName := make(map[string]*kueue.Workload)
+			for i := range got.Items {
+				byName[got.Items[i].Name] = &got.Items[i]
+			}
+			if v := byName["victim"]; workloadevict.IsEvicted(v) || v.Annotations[constants.ReclaimTargetCountsAnnotation] != "main=2" ||
+				v.Annotations[constants.ReclaimPreemptorAnnotation] != "default/first" {
+				t.Errorf("victim: evicted=%t annotations=%v; want not evicted, shrunk to main=2 by default/first", workloadevict.IsEvicted(v), v.Annotations)
+			}
+			for _, name := range []string{"first", "second"} {
+				if workload.HasQuotaReservation(byName[name]) {
+					t.Errorf("%s was admitted while the victim's pods still run", name)
+				}
+			}
+			if cond := meta.FindStatusCondition(byName["second"].Status.Conditions, kueue.WorkloadQuotaReserved); cond != nil &&
+				strings.Contains(cond.Message, "will fit after these preemptions complete") {
+				t.Errorf("second counts on quota the shrunk victim keeps: %s", cond.Message)
+			}
+		})
+	}
+}
+
+// describeTargets returns each target's name, and the counts a shrunk target keeps.
+func describeTargets(targets []*preemption.Target) []string {
+	var got []string
+	for _, t := range targets {
+		s := t.WorkloadInfo.Obj.Name
+		if t.Remaining != nil {
+			kept := make(workload.PodSetsCounts)
+			for i, ps := range t.Remaining.TotalRequests {
+				if ps.Count != t.WorkloadInfo.TotalRequests[i].Count {
+					kept[ps.Name] = ps.Count
+				}
+			}
+			s += ":" + workload.FormatPodSetCounts(kept)
+		}
+		got = append(got, s)
+	}
+	slices.Sort(got)
+	return got
+}
