+func TestSetReclaimTargetNeverRaisesATarget(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	log := utiltesting.NewLogger(t)
+	victim := ppWorkload{name: "victim", cq: "borrower", podSets: []ppPodSet{{name: "a", count: 4, cpu: 1}, {name: "b", count: 4, cpu: 1}}, pending: "a=1"}
+	wl := victim.obj(now, time.Minute)
+	info := workload.NewInfo(log, wl)
+	remaining := policy.ShrunkTo(info, workload.PodSetsCounts{"a": 3, "b": 2})
+	if !setReclaimTarget(wl, remaining, "default/next", now) {
+		t.Fatal("setReclaimTarget() reported no change for a lower target of b")
+	}
+	if got := wl.Annotations[constants.ReclaimTargetCountsAnnotation]; got != "a=1,b=2" {
+		t.Errorf("reclaim targets = %q, want a=1,b=2", got)
+	}
+	if got := wl.Annotations[constants.ReclaimRequestedAtAnnotation]; got != now.Add(-victim.requestedAt).UTC().Format(time.RFC3339) {
+		t.Errorf("requested-at changed to %q while a target was pending", got)
+	}
+	if setReclaimTarget(wl, remaining, "default/next", now) {
+		t.Error("setReclaimTarget() changed the workload for targets already set")
+	}
+}
