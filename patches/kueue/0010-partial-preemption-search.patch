+// The partial preemption seam: how a target shrunk instead of evicted leaves
+// and re-enters the snapshot, and the usage it frees. Every site that takes
+// a victim out of the snapshot goes through these helpers.
+
+package policy
+
+import (
+	"slices"
+	"time"
+
+	"github.com/go-logr/logr"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/resources"
+	cmputil "sigs.k8s.io/kueue/pkg/util/cmp"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+)
+
+// RemoveFrom removes the target's workload from the snapshot and adds back Remaining.
+func (t *Target) RemoveFrom(snapshot *schdcache.Snapshot) {
+	snapshot.RemoveWorkload(t.WorkloadInfo)
+	if t.Remaining != nil {
+		snapshot.AddWorkload(t.Remaining)
+	}
+}
+
+// AddTo reverts RemoveFrom.
+func (t *Target) AddTo(snapshot *schdcache.Snapshot) {
+	if t.Remaining != nil {
+		snapshot.RemoveWorkload(t.Remaining)
+	}
+	snapshot.AddWorkload(t.WorkloadInfo)
+}
+
+// FreedUsage returns the usage RemoveFrom frees: the workload's usage minus Remaining's.
+func (t *Target) FreedUsage() workload.Usage {
+	usage := t.WorkloadInfo.Usage()
+	if t.Remaining == nil {
+		return usage
+	}
+	kept := t.Remaining.ResourceUsage().Assigned
+	freed := workload.Usage{Quota: workload.ResourceUsage{Assigned: make(resources.FlavorResourceQuantities, len(usage.Quota.Assigned))}}
+	for fr, q := range usage.Quota.Assigned {
+		if d := q.Sub(kept[fr]); d.CmpInt64(0) > 0 {
+			freed.Quota.Assigned[fr] = d
+		}
+	}
+	// Remaining keeps the TAS usage of every PodSet that still has pods, so only
+	// a PodSet shrunk to zero pods frees its topology domains.
+	var dropped []workload.PodSetResources
+	for i := range t.WorkloadInfo.TotalRequests {
+		if len(podSetTASUsage(t.WorkloadInfo.TotalRequests[i])) > 0 && len(podSetTASUsage(t.Remaining.TotalRequests[i])) == 0 {
+			dropped = append(dropped, t.WorkloadInfo.TotalRequests[i])
+		}
+	}
+	if len(dropped) > 0 {
+		freed.TAS = (&workload.Info{TotalRequests: dropped}).TASUsage()
+	}
+	return freed
+}
+
+func podSetTASUsage(ps workload.PodSetResources) workload.TASUsage {
+	return (&workload.Info{TotalRequests: []workload.PodSetResources{ps}}).TASUsage()
+}
+
+// SimulateRemoval calls RemoveFrom on each target and returns a function that calls AddTo in reverse order.
+func SimulateRemoval(snapshot *schdcache.Snapshot, targets []*Target) (revert func()) {
+	for _, t := range targets {
+		t.RemoveFrom(snapshot)
+	}
+	return func() {
+		for _, t := range slices.Backward(targets) {
+			t.AddTo(snapshot)
+		}
+	}
+}
+
+// SimulateUsageRemoval removes each target's FreedUsage from its ClusterQueue, skipping
+// workloads whose usage the cycle already released, and returns the revert. With no
+// Remaining set it does what Snapshot.SimulateWorkloadUsageRemoval does.
+func SimulateUsageRemoval(snapshot *schdcache.Snapshot, targets []*Target) (revert func()) {
+	if !slices.ContainsFunc(targets, func(t *Target) bool { return t.Remaining != nil }) {
+		return snapshot.SimulateWorkloadUsageRemoval(EvictedWorkloads(targets))
+	}
+	usages := make([]workload.Usage, len(targets))
+	for i, t := range targets {
+		usages[i] = t.FreedUsage()
+		snapshot.RemoveWorkloadUsage(t.WorkloadInfo, usages[i])
+	}
+	return func() {
+		for i, t := range slices.Backward(targets) {
+			snapshot.AddWorkloadUsage(t.WorkloadInfo, usages[i])
+		}
+	}
+}
+
+// EvictedWorkloads returns the workloads of the targets without Remaining, the only
+// ones whose pods leave the scheduling simulator.
+func EvictedWorkloads(targets []*Target) []*workload.Info {
+	evicted := make([]*workload.Info, 0, len(targets))
+	for _, t := range targets {
+		if t.Remaining == nil {
+			evicted = append(evicted, t.WorkloadInfo)
+		}
+	}
+	return evicted
+}
+
+// ShrunkTo returns wl as it stays admitted with each PodSet in counts down to
+// its count: the PodSet's quota scaled to the count and its whole TAS usage
+// kept. PodSets missing from counts, or already at or below their count, are
+// unchanged.
+func ShrunkTo(wl *workload.Info, counts workload.PodSetsCounts) *workload.Info {
+	remaining := *wl
+	remaining.TotalRequests = slices.Clone(wl.TotalRequests)
+	for i := range remaining.TotalRequests {
+		ps := &remaining.TotalRequests[i]
+		count, found := counts[ps.Name]
+		if !found || count >= ps.Count {
+			continue
+		}
+		// ScaledTo leaves a PodSet with a topology request unscaled.
+		quotaOnly := *ps
+		quotaOnly.TopologyRequest = nil
+		scaled := *quotaOnly.ScaledTo(count)
+		scaled.TopologyRequest = ps.TopologyRequest
+		scaled.DelayedTopologyRequest = ps.DelayedTopologyRequest
+		*ps = scaled
+	}
+	return &remaining
+}
+
+// IsReclaimInFlight reports whether partial preemption set a reclaim target on
+// wl whose quota is not released yet, so its pods above the target are on
+// their way out.
+func IsReclaimInFlight(wl *workload.Info) bool {
+	return features.Enabled(features.PartialPreemption) && !workloadevict.IsEvicted(wl.Obj) &&
+		workload.IsPartiallyPreempted(wl.Obj) && len(workload.PendingReclaimTargetCounts(wl.Obj)) > 0
+}
+
+// ClassicalCandidatesOrdering is CandidatesOrdering with the workloads whose
+// partial preemption is in flight sorted right after the evicted ones, so the
+// classical strategy offers both first and a later preemptor counts the quota
+// already on its way out.
+func ClassicalCandidatesOrdering(log logr.Logger, afsEnabled bool, a, b *workload.Info, cq kueue.ClusterQueueReference, now time.Time) int {
+	return cmputil.LazyOr(
+		func() int { return compareEvictedThenReclaimInFlight(a, b) },
+		func() int { return CandidatesOrdering(log, afsEnabled, a, b, cq, now) },
+	)
+}
+
+// ClassicalCandidatesPreferenceOrdering is CandidatesPreferenceOrdering with
+// the order of ClassicalCandidatesOrdering.
+func ClassicalCandidatesPreferenceOrdering(log logr.Logger, afsEnabled bool, a, b *workload.Info, cq kueue.ClusterQueueReference, preferred func(*workload.Info) bool) int {
+	return cmputil.LazyOr(
+		func() int { return compareEvictedThenReclaimInFlight(a, b) },
+		func() int { return CandidatesPreferenceOrdering(log, afsEnabled, a, b, cq, preferred) },
+	)
+}
+
+func compareEvictedThenReclaimInFlight(a, b *workload.Info) int {
+	return cmputil.LazyOr(
+		func() int { return cmputil.CompareBool(workloadevict.IsEvicted(b.Obj), workloadevict.IsEvicted(a.Obj)) },
+		func() int { return cmputil.CompareBool(IsReclaimInFlight(b), IsReclaimInFlight(a)) },
+	)
+}
