+// TestPartialPreemptionFairSharingYieldsWholeTargets checks that fair sharing
+// returns the targets it returns with PartialPreemption off, whole.
+func TestPartialPreemptionFairSharingYieldsWholeTargets(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	scenarios := map[string]ppScenario{
+		"one elastic victim": {incoming: 2, lender: 2, needCPU: 2, workloads: []ppWorkload{
+			elastic("elastic", "borrower", 0, 4, "main=1"),
+		}},
+		"elastic and whole victims": {incoming: 3, lender: 1, needCPU: 3, workloads: []ppWorkload{
+			elastic("elastic", "borrower", 0, 2, "main=1"),
+			whole("w", "borrower", 1, 1, 2),
+		}},
+		"an in-flight victim": {incoming: 2, lender: 4, needCPU: 2, workloads: []ppWorkload{
+			whole("cheap", "borrower", 0, 2, 1),
+			{name: "inflight", cq: "borrower", priority: 5, podSets: []ppPodSet{{name: "main", count: 4, cpu: 1}}, floors: "main=1", pending: "main=2"},
+		}},
+	}
+	for _, mode := range fairSharingModes {
+		for name, sc := range scenarios {
+			t.Run(mode.name+"/"+name, func(t *testing.T) {
+				features.SetFeatureGateDuringTest(t, features.PartialPreemption, false)
+				off, _, _ := setUpPartial(t, sc, mode, now)
+				want := describeTargets(off.targets())
+				if len(want) == 0 {
+					t.Fatal("the scenario finds no targets")
+				}
+				features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+				on, _, _ := setUpPartial(t, sc, mode, now)
+				targets := on.targets()
+				for _, target := range targets {
+					if target.Remaining != nil {
+						t.Errorf("fair sharing shrank %s", target.WorkloadInfo.Obj.Name)
+					}
+				}
+				if diff := gocmp.Diff(want, describeTargets(targets)); diff != "" {
+					t.Errorf("fair sharing targets differ from PartialPreemption off (-off,+on):\n%s", diff)
+				}
+			})
+		}
+	}
+}
