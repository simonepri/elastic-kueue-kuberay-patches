+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// A randomized property test of the partial preemption search over random
+// cohorts: the snapshot is restored, the targets admit the preemptor, shrinks
+// are minimal and respect floors and steps, and the gate alone changes nothing.
+
+package preemption
+
+import (
+	"fmt"
+	"math/rand/v2"
+	"testing"
+	"time"
+
+	gocmp "github.com/google/go-cmp/cmp"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption/policy"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+const propertyCases = 1500
+
+func randomScenario(r *rand.Rand) ppScenario {
+	sc := ppScenario{
+		incoming: 1 + r.Int64N(6), borrower: r.Int64N(3), lender: r.Int64N(6),
+		withinCQ: kueue.PreemptionPolicyLowerPriority,
+		priority: r.Int32N(6),
+	}
+	sc.needCPU = 1 + r.Int64N(sc.incoming)
+	capacity := sc.incoming + sc.borrower + sc.lender
+	var used int64
+	for i := range 2 + r.IntN(6) {
+		cqs := []kueue.ClusterQueueReference{"borrower", "borrower", "lender", "incoming"}
+		w := ppWorkload{name: fmt.Sprintf("w%d", i), cq: cqs[r.IntN(len(cqs))], priority: r.Int32N(5)}
+		var floors, steps, pending workload.PodSetsCounts
+		var usage int64
+		for j := range 1 + r.IntN(2) {
+			ps := ppPodSet{name: kueue.PodSetReference(fmt.Sprintf("ps%d", j)), count: 1 + r.Int32N(6), cpu: 1 + r.Int64N(2)}
+			if r.IntN(4) == 0 {
+				ps.admitted = 1 + r.Int32N(ps.count)
+			}
+			admitted := max(ps.admitted, 0)
+			if admitted == 0 {
+				admitted = ps.count
+			}
+			charged := admitted
+			if r.IntN(6) == 0 {
+				rc := r.Int32N(ps.count)
+				w.reclaimable = append(w.reclaimable, kueue.ReclaimablePod{Name: ps.name, Count: rc})
+				charged = min(admitted, ps.count-rc)
+			}
+			if r.IntN(2) == 0 {
+				step := 1 + r.Int32N(3)
+				if floors == nil {
+					floors, steps = make(workload.PodSetsCounts), make(workload.PodSetsCounts)
+				}
+				floors[ps.name] = r.Int32N(ps.count+1) / step * step
+				steps[ps.name] = step
+			}
+			if r.IntN(8) == 0 && charged > 1 {
+				if pending == nil {
+					pending = make(workload.PodSetsCounts)
+				}
+				pending[ps.name] = r.Int32N(charged)
+			}
+			usage += ps.cpu * int64(charged)
+			w.podSets = append(w.podSets, ps)
+		}
+		if used+usage > capacity {
+			continue
+		}
+		used += usage
+		w.floors, w.steps, w.pending = workload.FormatPodSetCounts(floors), workload.FormatPodSetCounts(steps), workload.FormatPodSetCounts(pending)
+		if pending != nil && r.IntN(3) == 0 {
+			w.requestedAt = 2 * reclaimTimeout
+		}
+		if r.IntN(10) == 0 {
+			w.evicted = true
+		}
+		sc.workloads = append(sc.workloads, w)
+	}
+	return sc
+}
+
+func stripPartialAnnotations(sc ppScenario) ppScenario {
+	stripped := sc
+	stripped.workloads = make([]ppWorkload, len(sc.workloads))
+	for i, w := range sc.workloads {
+		w.floors, w.steps, w.pending = "", "", ""
+		stripped.workloads[i] = w
+	}
+	return stripped
+}
+
+// fitsAfter reports whether the preemptor's quota fits once targets are
+// removed, through both the seam's removal and its usage-only removal.
+func fitsAfter(t *testing.T, run *ppRun, targets []*Target) bool {
+	t.Helper()
+	cq := run.snapshot.ClusterQueue("incoming")
+	usage := workload.Usage{Quota: workload.ResourceUsage{Assigned: run.assign.TotalRequestsFor(utiltesting.NewLogger(t), run.incoming)}}
+	revert := policy.SimulateRemoval(run.snapshot, targets)
+	removed := cq.Fits(usage) == schdcache.FitsCheckOk
+	revert()
+	revert = policy.SimulateUsageRemoval(run.snapshot, targets)
+	usageRemoved := cq.Fits(usage) == schdcache.FitsCheckOk
+	revert()
+	if removed != usageRemoved {
+		t.Errorf("SimulateRemoval and SimulateUsageRemoval disagree: %t != %t", removed, usageRemoved)
+	}
+	return removed
+}
+
+func TestPartialPreemptionSearchProperties(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	for _, mode := range classicalModes {
+		t.Run(mode.name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+			r := rand.New(rand.NewPCG(20, 4))
+			var found, shrunk int
+			for i := range propertyCases {
+				sc := randomScenario(r)
+				ok := t.Run(fmt.Sprint(i), func(t *testing.T) {
+					features.SetFeatureGateDuringTest(t, features.PartialPreemption, false)
+					off, _, _ := setUpPartial(t, sc, mode, now)
+					wantOff := describeTargets(off.targets())
+
+					features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+					stripped, _, _ := setUpPartial(t, stripPartialAnnotations(sc), mode, now)
+					if diff := gocmp.Diff(wantOff, describeTargets(stripped.targets())); diff != "" {
+						t.Errorf("without floors, the gate changed the targets (-off,+on):\n%s", diff)
+					}
+
+					run, _, _ := setUpPartial(t, sc, mode, now)
+					targets := run.targets()
+					if len(targets) == 0 {
+						return
+					}
+					found++
+					seen := make(map[workload.Reference]bool)
+					for _, target := range targets {
+						key := workload.Key(target.WorkloadInfo.Obj)
+						if seen[key] {
+							t.Errorf("%s is targeted twice", key)
+						}
+						seen[key] = true
+					}
+					if !fitsAfter(t, run, targets) {
+						t.Errorf("the preemptor does not fit after the targets %v", describeTargets(targets))
+					}
+					for i, target := range targets {
+						bounds := reclaimBounds(target.WorkloadInfo, now)
+						if target.Remaining == nil {
+							if bounds == nil {
+								continue
+							}
+							floors := make(workload.PodSetsCounts)
+							for name, b := range bounds {
+								floors[name] = b.floor
+							}
+							alternative := append([]*Target(nil), targets...)
+							alternative[i] = &Target{WorkloadInfo: target.WorkloadInfo, Remaining: policy.ShrunkTo(target.WorkloadInfo, floors)}
+							if fitsAfter(t, run, alternative) {
+								t.Errorf("%s is evicted whole although its floors %v suffice: %v", target.WorkloadInfo.Obj.Name, floors, describeTargets(targets))
+							}
+							continue
+						}
+						shrunk++
+						for j, ps := range target.Remaining.TotalRequests {
+							current := target.WorkloadInfo.TotalRequests[j].Count
+							b, found := bounds[ps.Name]
+							switch {
+							case !found:
+								if ps.Count != current {
+									t.Errorf("%s/%s shrank without a floor", target.WorkloadInfo.Obj.Name, ps.Name)
+								}
+							case ps.Count >= current || ps.Count < b.floor || ps.Count > b.ceiling:
+								t.Errorf("%s/%s keeps %d of %d pods, outside [%d, %d]", target.WorkloadInfo.Obj.Name, ps.Name, ps.Count, current, b.floor, b.ceiling)
+							case !workload.IsPartiallyPreempted(target.WorkloadInfo.Obj) && ps.Count%b.step != 0:
+								t.Errorf("%s/%s keeps %d pods, not a multiple of the step %d", target.WorkloadInfo.Obj.Name, ps.Name, ps.Count, b.step)
+							}
+						}
+					}
+				})
+				if !ok {
+					t.Logf("failing scenario %d: %+v", i, sc)
+					break
+				}
+			}
+			t.Logf("%d of %d random cohorts found targets, %d targets shrunk", found, propertyCases, shrunk)
+		})
+	}
+}
