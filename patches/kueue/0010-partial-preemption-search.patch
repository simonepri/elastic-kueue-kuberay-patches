+// TestPreemptionOracleCountsShrunkTargets checks that the oracle's borrowing
+// height after preemption frees only what a shrunk target gives up.
+func TestPreemptionOracleCountsShrunkTargets(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	for _, gate := range []bool{true, false} {
+		t.Run(fmt.Sprintf("PartialPreemption=%t", gate), func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, gate)
+			ctx, log := utiltesting.ContextWithLog(t)
+			victim := elastic("victim", "borrower", 0, 7, "main=4").obj(now, time.Minute)
+			cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: []kueue.Workload{*victim}}).Build()
+			cache := schdcache.New(cl)
+			cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+			if err := cache.AddOrUpdateCohort(utiltestingapi.MakeCohort("team").Parent("root").Obj()); err != nil {
+				t.Fatal(err)
+			}
+			for _, cq := range []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("team").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "2").Obj()).
+					Preemption(kueue.ClusterQueuePreemption{
+						ReclaimWithinCohort: kueue.PreemptionPolicyAny,
+						BorrowWithinCohort:  &kueue.BorrowWithinCohort{Policy: kueue.BorrowWithinCohortPolicyLowerPriority},
+					}).Obj(),
+				utiltestingapi.MakeClusterQueue("borrower").Cohort("team").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "0").Obj()).Obj(),
+				utiltestingapi.MakeClusterQueue("lender").Cohort("team").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "2").Obj()).Obj(),
+				utiltestingapi.MakeClusterQueue("far").Cohort("root").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "3").Obj()).Obj(),
+			} {
+				if err := cache.AddClusterQueue(ctx, cq); err != nil {
+					t.Fatal(err)
+				}
+			}
+			snapshot, err := cache.Snapshot(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			preemptor := New(cl, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(now), nil, preemptexpectations.New(), nil)
+			info := workload.NewInfo(log, utiltestingapi.MakeWorkload("preemptor", "default").Priority(5).
+				PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "3").Obj()).Obj())
+			info.ClusterQueue = "incoming"
+			fr := resources.FlavorResource{Flavor: "default", Resource: corev1.ResourceCPU}
+			possibility, borrow := NewOracle(preemptor, snapshot).SimulatePreemption(ctx, snapshot.ClusterQueue("incoming"), *info, fr, resources.NewAmount(3000))
+			// Shrunk to 4 pods, the victim still uses the team's whole quota, so the
+			// preemptor borrows from the root; evicted whole, the team has room for it.
+			wantBorrow := 1
+			if gate {
+				wantBorrow = 2
+			}
+			if possibility != policy.Reclaim || borrow != wantBorrow {
+				t.Errorf("SimulatePreemption() = %v, %d; want Reclaim, %d", possibility, borrow, wantBorrow)
+			}
+		})
+	}
+}
