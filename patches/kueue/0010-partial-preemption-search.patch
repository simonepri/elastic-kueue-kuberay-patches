+// TestPartialPreemptionOffersWhatRemainsOfAShrunkVictim checks that a search
+// run while another preemption's shrink is simulated, as the scheduler's
+// overlap recompute does, offers what remains of the victim, from the flat and
+// the cached candidate order alike.
+func TestPartialPreemptionOffersWhatRemainsOfAShrunkVictim(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	now := time.Now().Truncate(time.Second)
+	for _, mode := range classicalModes {
+		t.Run(mode.name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ClassicalPreemptionCandidateOrderCache, mode.cacheEnabled)
+			sc := ppScenario{incoming: 2, lender: 2, needCPU: 1, workloads: []ppWorkload{elastic("victim", "borrower", 0, 4, "main=1")}}
+			run, _, _ := setUpPartial(t, sc, mode, now)
