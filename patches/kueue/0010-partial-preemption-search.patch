+// TestPartialPreemptionWithTAS checks that the planner and the in-cycle fit
+// check accept a shrink plan that places the preemptor beside the victim, and
+// that a preemptor needing the victim's node gets it evicted whole.
+func TestPartialPreemptionWithTAS(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	cases := map[string]struct {
+		blockerCPU  string
+		wantTargets []string
+		wantDomain  string
+	}{
+		"a shrink frees quota and the preemptor goes to the other node": {
+			blockerCPU:  "1",
+			wantTargets: []string{"elastic:main=1"},
+			wantDomain:  "x2",
+		},
+		"a preemptor that needs the victim's node evicts it whole": {
+			blockerCPU:  "4",
+			wantTargets: []string{"elastic"},
+			wantDomain:  "x1",
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{features.TopologyAwareScheduling: true, features.PartialPreemption: true})
+			ctx, log := utiltesting.ContextWithLog(t)
+			onNode := func(name string, cq kueue.ClusterQueueReference, node string, count int32) *utiltestingapi.WorkloadWrapper {
+				return utiltestingapi.MakeWorkload(name, "default").
+					PodSets(*utiltestingapi.MakePodSet("main", int(count)).Request(corev1.ResourceCPU, "1").
+						RequiredTopologyRequest(corev1.LabelHostname).Obj()).
+					ReserveQuotaAt(utiltestingapi.MakeAdmission(cq).PodSets(
+						utiltestingapi.MakePodSetAssignment("main").Count(count).
+							Assignment(corev1.ResourceCPU, "tas", fmt.Sprint(count)).
+							TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+								Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, count).Obj()).Obj()).Obj()).Obj(), now).
+					AdmittedAt(true, now)
+			}
+			blockerQuantity := resource.MustParse(tc.blockerCPU)
+			blockerCount := int32(blockerQuantity.Value())
+			admitted := []kueue.Workload{
+				*onNode("elastic", "borrower", "x1", 2).Annotation(constants.ReclaimMinCountsAnnotation, "main=1").Obj(),
+				*onNode("blocker", "other", "x2", blockerCount).Obj(),
+			}
+			clientBuilder := utiltesting.NewClientBuilder().
+				WithLists(&kueue.WorkloadList{Items: admitted}).
+				WithObjects(utiltesting.MakeNamespace("default")).
+				WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+				WithStatusSubresource(&kueue.Workload{})
+			_ = tasindexer.SetupIndexes(ctx, utiltesting.AsIndexer(clientBuilder))
+			cl := clientBuilder.Build()
+			cqCache := schdcache.New(cl)
+			cqCache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+			cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+			for node, cpu := range map[string]string{"x1": "2", "x2": "4"} {
+				cqCache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+					StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse(cpu), corev1.ResourcePods: resource.MustParse("10")}).
+					Ready().Obj())
+			}
+			for _, cq := range []*kueue.ClusterQueue{
+				utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "2").Obj()).
+					Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny}).Obj(),
+				utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "0").Obj()).Obj(),
+				utiltestingapi.MakeClusterQueue("other").Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, tc.blockerCPU).Obj()).Obj(),
+				utiltestingapi.MakeClusterQueue("lender").Cohort("shared").
+					ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "1").Obj()).Obj(),
+			} {
+				if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+					t.Fatal(err)
+				}
+			}
+			fakeClock := testingclock.NewFakeClock(now)
+			qManager := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithClock(fakeClock))
+			scheduler := New(qManager, cqCache, cl, &utiltesting.EventRecorder{}, WithClock(t, fakeClock), WithPreemptionExpectations(preemptexpectations.New()))
+			snapshot, err := cqCache.Snapshot(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			info := workload.NewInfo(log, utiltestingapi.MakeWorkload("incoming", "default").Priority(3).
+				PodSets(*utiltestingapi.MakePodSet("main", 1).Request(corev1.ResourceCPU, "2").
+					RequiredTopologyRequest(corev1.LabelHostname).Obj()).Obj())
+			info.ClusterQueue = "incoming"
+
+			assignment, targets := scheduler.getAssignments(ctx, info, snapshot)
+			if diff := cmp.Diff(tc.wantTargets, describeTargets(targets)); diff != "" {
+				t.Fatalf("unexpected preemption targets (-want/+got):\n%s", diff)
+			}
+			podSet := assignment.PodSets[0]
+			if podSet.TopologyAssignment == nil {
+				t.Fatal("the planner found no topology assignment")
+			}
+			if diff := cmp.Diff([]string{tc.wantDomain}, podSet.TopologyAssignment.Domains[0].Values); diff != "" {
+				t.Errorf("unexpected topology domain (-want/+got):\n%s", diff)
+			}
+			e := entry{Head: qcache.Head{Info: *info}, clusterQueueSnapshot: snapshot.ClusterQueue("incoming")}
+			e.recordAssignment(assignment, targets)
+			if got := e.checkFits(log, snapshot, snapshot.ClusterQueue("incoming"), nil); got != schdcache.FitsCheckOk {
+				t.Errorf("the in-cycle fit check rejects the plan: %v", got)
+			}
+		})
+	}
+}
