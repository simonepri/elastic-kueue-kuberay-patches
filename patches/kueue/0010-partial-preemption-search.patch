+// TestPartialPreemptionSeam checks the usage each seam helper frees and that
+// each one is reverted exactly.
+func TestPartialPreemptionSeam(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	now := time.Now().Truncate(time.Second)
+	sc := ppScenario{incoming: 2, lender: 20, needCPU: 1, workloads: []ppWorkload{
+		{name: "elastic", cq: "borrower", podSets: []ppPodSet{{name: "head", count: 1, cpu: 1}, {name: "workers", count: 4, cpu: 2}}, floors: "workers=1"},
+		whole("w", "borrower", 0, 1, 3),
+	}}
+	run, _, _ := setUpPartial(t, sc, classicalModes[0], now)
+	cq := run.snapshot.ClusterQueue("borrower")
+	elasticInfo, wInfo := cq.Workloads["default/elastic"], cq.Workloads["default/w"]
+	shrunk := &Target{WorkloadInfo: elasticInfo, Remaining: policy.ShrunkTo(elasticInfo, workload.PodSetsCounts{"workers": 1})}
+	evicted := &Target{WorkloadInfo: wInfo}
+	cpu := func() int64 {
+		usage := cq.ResourceNode.Usage[resources.FlavorResource{Flavor: "default", Resource: corev1.ResourceCPU}]
+		milli, _ := usage.Int64()
+		return milli / 1000
+	}
+	if got := cpu(); got != 12 {
+		t.Fatalf("borrower uses %d CPUs, want 12", got)
+	}
+	if got := shrunk.FreedUsage().Quota.Assigned[resources.FlavorResource{Flavor: "default", Resource: corev1.ResourceCPU}]; got.CmpInt64(6000) != 0 {
+		t.Errorf("FreedUsage() of the shrunk target frees %v CPUs, want 6", got)
+	}
+	targets := []*Target{shrunk, evicted}
+	revert := policy.SimulateRemoval(run.snapshot, targets)
+	if got := cpu(); got != 3 {
+		t.Errorf("after SimulateRemoval the borrower uses %d CPUs, want 3", got)
+	}
+	if cq.Workloads["default/elastic"] != shrunk.Remaining {
+		t.Error("SimulateRemoval did not leave the remaining workload in the ClusterQueue")
+	}
+	revert()
+	if got := cpu(); got != 12 || cq.Workloads["default/elastic"] != elasticInfo {
+		t.Errorf("SimulateRemoval revert left %d CPUs, want 12 and the original workload", got)
+	}
+	revert = policy.SimulateUsageRemoval(run.snapshot, targets)
+	if got := cpu(); got != 3 {
+		t.Errorf("after SimulateUsageRemoval the borrower uses %d CPUs, want 3", got)
+	}
+	revert()
+	if got := cpu(); got != 12 {
+		t.Errorf("SimulateUsageRemoval revert left %d CPUs, want 12", got)
+	}
+	if got := policy.EvictedWorkloads(targets); len(got) != 1 || got[0] != wInfo {
+		t.Errorf("EvictedWorkloads() = %v, want only the whole target's workload", got)
+	}
+	// A workload whose usage the cycle already released frees nothing again.
+	run.snapshot.ReleaseWorkloadUsage(elasticInfo)
+	revert = policy.SimulateUsageRemoval(run.snapshot, []*Target{shrunk})
+	if got := cpu(); got != 3 {
+		t.Errorf("after releasing the elastic workload, SimulateUsageRemoval left %d CPUs, want 3", got)
+	}
+	revert()
+}
