+// Tests parsing and formatting of reclaim min count annotations.
+package workload
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+)
+
+func TestReclaimMinCounts(t *testing.T) {
+	cases := map[string]struct {
+		annotations map[string]string
+		want        PodSetsCounts
+	}{
+		"missing": {want: PodSetsCounts{}},
+		"sorted list": {
+			annotations: map[string]string{constants.ReclaimMinCountsAnnotation: "a=1,b=0,c=7"},
+			want:        PodSetsCounts{"a": 1, "b": 0, "c": 7},
+		},
+		"malformed entries are ignored": {
+			annotations: map[string]string{constants.ReclaimMinCountsAnnotation: "a=1,b,=3,c=x,d=-1,e=99999999999,f=2"},
+			want:        PodSetsCounts{"a": 1, "f": 2},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			wl := &kueue.Workload{}
+			wl.Annotations = tc.annotations
+			if diff := cmp.Diff(tc.want, ReclaimMinCounts(wl), cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("ReclaimMinCounts() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestSetReclaimMinCounts(t *testing.T) {
+	wl := &kueue.Workload{}
+	SetReclaimMinCounts(wl, PodSetsCounts{"b": 2, "a": 1})
+	if got, want := wl.Annotations[constants.ReclaimMinCountsAnnotation], "a=1,b=2"; got != want {
+		t.Errorf("annotation = %q, want %q", got, want)
+	}
+	if _, ok := wl.Annotations[constants.PodSetCountStepsAnnotation]; ok {
+		t.Error("SetReclaimMinCounts wrote the steps annotation")
+	}
+	SetReclaimMinCounts(wl, nil)
+	if _, ok := wl.Annotations[constants.ReclaimMinCountsAnnotation]; ok {
+		t.Error("empty counts did not remove the annotation")
+	}
+}
