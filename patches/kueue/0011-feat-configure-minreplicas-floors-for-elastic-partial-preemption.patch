+// Writes reclaim minimum floors on workload slices.
+package workloadslicing
+
+import (
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// WithReclaimFloors makes EnsureWorkloadSlices write the job's reclaim floors
+// on the slice it returns.
+func WithReclaimFloors(floors workload.PodSetsCounts) EnsureOption {
+	return func(o *ensureOptions) {
+		o.floors, o.refreshFloors = floors, true
+	}
+}
+
+// floorsFor caps each floor at the PodSet's count in wl, since a slice smaller than the job,
+// such as an admitted slice under a pending scale-up, cannot keep more pods than it has.
+func (o *ensureOptions) floorsFor(wl *kueue.Workload) workload.PodSetsCounts {
+	floors := make(workload.PodSetsCounts, len(o.floors))
+	for name, floor := range o.floors {
+		floors[name] = floor
+	}
+	for i := range wl.Spec.PodSets {
+		if floor, ok := floors[wl.Spec.PodSets[i].Name]; ok {
+			floors[wl.Spec.PodSets[i].Name] = min(floor, wl.Spec.PodSets[i].Count)
+		}
+	}
+	return floors
+}
