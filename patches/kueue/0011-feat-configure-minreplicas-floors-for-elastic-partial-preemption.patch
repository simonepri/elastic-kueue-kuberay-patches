diff --git a/pkg/controller/jobs/raycluster/common.go b/pkg/controller/jobs/raycluster/common.go
index a7bf80c..1bea960 100644
--- a/pkg/controller/jobs/raycluster/common.go
+++ b/pkg/controller/jobs/raycluster/common.go
@@ -98,6 +98,21 @@ func effectiveWorkerCount(wgs *rayv1.WorkerGroupSpec) int32 {
 	return replicas * max(wgs.NumOfHosts, 1)
 }
 
+// ReclaimMinCounts implements jobframework.JobWithReclaimMinCounts. Partial preemption may
+// shrink a single-host worker group down to its minReplicas. A multi-host group has no
+// floor, so it is only evicted whole.
+func (j *RayCluster) ReclaimMinCounts() workload.PodSetsCounts {
+	floors := workload.PodSetsCounts{}
+	for i := range j.Spec.WorkerGroupSpecs {
+		wgs := &j.Spec.WorkerGroupSpecs[i]
+		if !isSingleHost(wgs) {
+			continue
+		}
+		floors[kueue.NewPodSetReference(wgs.GroupName)] = min(ptr.Deref(wgs.MinReplicas, 0), effectiveWorkerCount(wgs))
+	}
+	return floors
+}
+
 // PodSetCountSteps implements jobframework.JobWithPodSetCountSteps. A replica is the unit
 // KubeRay creates and deletes, so a worker group changes by numOfHosts pods.
 func (j *RayCluster) PodSetCountSteps() workload.PodSetsCounts {
@@ -109,6 +124,10 @@ func (j *RayCluster) PodSetCountSteps() workload.PodSetsCounts {
 	return steps
 }
 
+func isSingleHost(wgs *rayv1.WorkerGroupSpec) bool {
+	return max(wgs.NumOfHosts, 1) == 1
+}
+
 func hostsPerReplica(wgs *rayv1.WorkerGroupSpec) int32 {
 	return max(wgs.NumOfHosts, 1)
 }
