+)
+
+func elasticRayCluster() *testingrayutil.ClusterWrapper {
+	return testingrayutil.MakeCluster("rc", "ns").UID("rc-uid").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		WithWorkerGroups(
+			*testingrayutil.MakeWorkerGroup("small", 4).MinReplicas(1).Obj(),
+			*testingrayutil.MakeWorkerGroup("zero", 2).Obj(),
+			*testingrayutil.MakeWorkerGroup("tpu", 3).MinReplicas(1).Obj(),
+			*testingrayutil.MakeWorkerGroup("capped", 9).MinReplicas(2).MaxReplicas(3).Obj(),
+		).
+		WithNumOfHosts("tpu", 4)
+}
+
+func TestRayClusterReclaimFloorsAndSteps(t *testing.T) {
+	rc := (*RayCluster)(elasticRayCluster().Obj())
+
+	wantFloors := workload.PodSetsCounts{"small": 1, "zero": 0, "capped": 2}
+	if diff := cmp.Diff(wantFloors, rc.ReclaimMinCounts()); diff != "" {
+		t.Errorf("ReclaimMinCounts() (-want,+got):\n%s", diff)
+	}
+	wantSteps := workload.PodSetsCounts{"small": 1, "zero": 1, "capped": 1, "tpu": 4}
+	if diff := cmp.Diff(wantSteps, rc.PodSetCountSteps()); diff != "" {
+		t.Errorf("PodSetCountSteps() (-want,+got):\n%s", diff)
+	}
+}
+
+func TestConstructWorkloadReclaimFloors(t *testing.T) {
+	testCases := map[string]struct {
+		cluster        *testingrayutil.ClusterWrapper
+		partialPreempt bool
+		partialScaleUp bool
+		wantFloors     string
+		wantSteps      string
+	}{
+		"gate off: elastic cluster gets no annotation": {
+			cluster: elasticRayCluster(),
+		},
+		"gate on: elastic cluster without the partial scale-up strategy gets steps but no floor": {
+			cluster:        elasticRayCluster(),
+			partialPreempt: true,
+			partialScaleUp: true,
+			wantSteps:      "tpu=4",
+		},
+		"gate on: partial strategy annotation without the scale-up gate gets no floor": {
+			cluster:        elasticRayCluster().SetAnnotation(constants.ElasticJobScaleUpStrategyAnnotationKey, constants.ElasticJobScaleUpStrategyPartial),
+			partialPreempt: true,
+		},
+		"gate on: elastic cluster with the partial strategy gets floors and steps of its single-host groups": {
+			cluster:        elasticRayCluster().SetAnnotation(constants.ElasticJobScaleUpStrategyAnnotationKey, constants.ElasticJobScaleUpStrategyPartial),
+			partialPreempt: true,
+			partialScaleUp: true,
+			wantFloors:     "capped=2,small=1,zero=0",
+			wantSteps:      "tpu=4",
+		},
+		"gate on: non-elastic cluster gets no annotation": {
+			cluster: testingrayutil.MakeCluster("rc", "ns").UID("rc-uid").
+				WithWorkerGroups(*testingrayutil.MakeWorkerGroup("small", 4).MinReplicas(1).Obj()),
+			partialPreempt: true,
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, tc.partialPreempt)
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp, tc.partialScaleUp)
+			ctx, _ := utiltesting.ContextWithLog(t)
+
+			job := (*RayCluster)(tc.cluster.Obj())
+			wl, err := jobframework.ConstructWorkload(ctx, utiltesting.NewClientBuilder(rayv1.AddToScheme).
+				WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(gvk), indexer.WorkloadOwnerIndexFunc(gvk)).Build(), job, nil, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := wl.Annotations[constants.ReclaimMinCountsAnnotation]; got != tc.wantFloors {
+				t.Errorf("floors = %q, want %q", got, tc.wantFloors)
+			}
+			if got := wl.Annotations[constants.PodSetCountStepsAnnotation]; got != tc.wantSteps {
+				t.Errorf("steps = %q, want %q", got, tc.wantSteps)
+			}
+		})
+	}
+}
