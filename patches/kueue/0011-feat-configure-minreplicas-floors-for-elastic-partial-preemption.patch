+// Tests reclaim floor synchronization across workload slices.
+package workloadslicing
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/equality"
+	testingclock "k8s.io/utils/clock/testing"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+func TestEnsureWorkloadSlicesReclaimFloors(t *testing.T) {
+	now := time.Now()
+	workerSet := func(count int32) []kueue.PodSet {
+		return []kueue.PodSet{*utiltestingapi.MakePodSet("workers", int(count)).Request(corev1.ResourceCPU, "1").Obj()}
+	}
+	cases := map[string]struct {
+		existing       func(*utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper
+		jobCount       int32
+		opts           []EnsureOption
+		wantFloors     string
+		wantCount      int32
+		wantUpdate     bool
+		wantMinCount   *int32
+		wantStillQuota bool
+	}{
+		"admitted slice without annotations gets them and keeps its spec": {
+			existing: func(w *utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper {
+				return w.PodSets(*utiltestingapi.MakePodSet("workers", 4).SetMinimumCount(2).Request(corev1.ResourceCPU, "1").Obj()).
+					SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+			},
+			jobCount:       4,
+			opts:           []EnsureOption{WithReclaimFloors(workload.PodSetsCounts{"workers": 1})},
+			wantFloors:     "workers=1",
+			wantCount:      4,
+			wantUpdate:     true,
+			wantMinCount:   new(int32(2)),
+			wantStillQuota: true,
+		},
+		"a changed floor refreshes the annotation": {
+			existing: func(w *utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper {
+				return w.PodSets(workerSet(4)...).
+					Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+					SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+			},
+			jobCount:       4,
+			opts:           []EnsureOption{WithReclaimFloors(workload.PodSetsCounts{"workers": 3})},
+			wantFloors:     "workers=3",
+			wantCount:      4,
+			wantUpdate:     true,
+			wantStillQuota: true,
+		},
+		"matching annotations cause no write": {
+			existing: func(w *utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper {
+				return w.PodSets(workerSet(4)...).
+					Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+					SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+			},
+			jobCount:       4,
+			opts:           []EnsureOption{WithReclaimFloors(workload.PodSetsCounts{"workers": 2})},
+			wantFloors:     "workers=2",
+			wantCount:      4,
+			wantStillQuota: true,
+		},
+		"without the option nothing is written": {
+			existing: func(w *utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper {
+				return w.PodSets(workerSet(4)...).Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+					SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+			},
+			jobCount:       4,
+			wantFloors:     "workers=2",
+			wantCount:      4,
+			wantStillQuota: true,
+		},
+		"a job without floors removes the annotations": {
+			existing: func(w *utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper {
+				return w.PodSets(workerSet(4)...).
+					Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+					SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+			},
+			jobCount:       4,
+			opts:           []EnsureOption{WithReclaimFloors(nil)},
+			wantCount:      4,
+			wantUpdate:     true,
+			wantStillQuota: true,
+		},
+		"an in-place scale-down writes the count and the annotation together": {
+			existing: func(w *utiltestingapi.WorkloadWrapper) *utiltestingapi.WorkloadWrapper {
+				return w.PodSets(workerSet(4)...).
+					Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+					SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+			},
+			jobCount:       3,
+			opts:           []EnsureOption{WithReclaimFloors(workload.PodSetsCounts{"workers": 1})},
+			wantFloors:     "workers=1",
+			wantCount:      3,
+			wantUpdate:     true,
+			wantStillQuota: true,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			wl := tc.existing(utiltestingapi.MakeWorkload(testJobObject.Name+"-1", testJobObject.Namespace).
+				OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+				ResourceVersion("1").Creation(now)).Obj()
+			clnt := testWorkloadClientBuilder().WithObjects(wl).Build()
+			ctx, _ := utiltesting.ContextWithLog(t)
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(now)}
+			got, compatible, err := manager.EnsureWorkloadSlices(ctx, workerSet(tc.jobCount), testJobObject, testJobGVK, tc.opts...)
+			if err != nil || !compatible || got == nil {
+				t.Fatalf("EnsureWorkloadSlices() = %v, %v, %v", got, compatible, err)
+			}
+			var stored kueue.Workload
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(wl), &stored); err != nil {
+				t.Fatal(err)
+			}
+			for _, w := range []*kueue.Workload{got, &stored} {
+				if v := w.Annotations[constants.ReclaimMinCountsAnnotation]; v != tc.wantFloors {
+					t.Errorf("floors = %q, want %q", v, tc.wantFloors)
+				}
+				if w.Spec.PodSets[0].Count != tc.wantCount {
+					t.Errorf("count = %d, want %d", w.Spec.PodSets[0].Count, tc.wantCount)
+				}
+				if diff := cmp.Diff(tc.wantMinCount, w.Spec.PodSets[0].MinCount); tc.wantMinCount != nil && diff != "" {
+					t.Errorf("minCount (-want,+got):\n%s", diff)
+				}
+				if workload.HasQuotaReservation(w) != tc.wantStillQuota || workload.IsAdmitted(w) != tc.wantStillQuota {
+					t.Errorf("quota reserved = %v, admitted = %v, want %v", workload.HasQuotaReservation(w), workload.IsAdmitted(w), tc.wantStillQuota)
+				}
+			}
+			if updated := stored.ResourceVersion != wl.ResourceVersion; updated != tc.wantUpdate {
+				t.Errorf("updated = %v, want %v", updated, tc.wantUpdate)
+			}
+			if !tc.wantUpdate && !equality.Semantic.DeepEqual(wl.Annotations, stored.Annotations) {
+				t.Errorf("annotations changed without an update")
+			}
+		})
+	}
+}
+
+func TestEnsureWorkloadSlicesReclaimFloorsOnEverySlice(t *testing.T) {
+	now := time.Now()
+	workers := func(count int) *kueue.PodSet {
+		return utiltestingapi.MakePodSet("workers", count).Request(corev1.ResourceCPU, "1").Obj()
+	}
+	owned := func(name string, created time.Time) *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload(name, testJobObject.Namespace).
+			OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+			ResourceVersion("1").Creation(created)
+	}
+	admittedA := func() *utiltestingapi.WorkloadWrapper {
+		return owned(testJobObject.Name+"-a", now.Add(-time.Minute)).PodSets(*workers(4)).
+			Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+			SimpleReserveQuota("default", "default", now).AdmittedAt(true, now)
+	}
+	pendingB := func() *utiltestingapi.WorkloadWrapper {
+		return owned(testJobObject.Name+"-b", now).PodSets(*workers(8)).
+			Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+			Annotation(constants.WorkloadSliceReplacementForAnnotation, string(workload.Key(admittedA().Obj())))
+	}
+	cases := map[string]struct {
+		objects   []*kueue.Workload
+		floors    int32
+		wantFloor map[string]string
+	}{
+		"an admitted slice under a pending replacement gets the new floor": {
+			objects:   []*kueue.Workload{admittedA().Obj(), pendingB().Obj()},
+			floors:    3,
+			wantFloor: map[string]string{"-a": "workers=3", "-b": "workers=3"},
+		},
+		"a floor above a slice's count is capped at that count": {
+			objects:   []*kueue.Workload{admittedA().Obj(), pendingB().Obj()},
+			floors:    6,
+			wantFloor: map[string]string{"-a": "workers=4", "-b": "workers=6"},
+		},
+		"a partially admitted slice that matches the job gets the new floor": {
+			objects: []*kueue.Workload{
+				owned(testJobObject.Name+"-a", now).PodSets(*workers(8)).
+					Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+					ReserveQuotaAt(utiltestingapi.MakeAdmission("default").
+						PodSets(kueue.PodSetAssignment{Name: "workers", Count: new(int32(6))}).Obj(), now).
+					AdmittedAt(true, now).Obj(),
+			},
+			floors:    3,
+			wantFloor: map[string]string{"-a": "workers=3"},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			clnt := testWorkloadClientBuilder().WithObjects(toObjects(tc.objects)...).Build()
+			ctx, _ := utiltesting.ContextWithLog(t)
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(now)}
+			_, _, err := manager.EnsureWorkloadSlices(ctx, []kueue.PodSet{*workers(8)}, testJobObject, testJobGVK,
+				WithReclaimFloors(workload.PodSetsCounts{"workers": tc.floors}))
+			if err != nil {
+				t.Fatal(err)
+			}
+			for suffix, want := range tc.wantFloor {
+				var got kueue.Workload
+				if err := clnt.Get(ctx, client.ObjectKey{Namespace: testJobObject.Namespace, Name: testJobObject.Name + suffix}, &got); err != nil {
+					t.Fatal(err)
+				}
+				if v := got.Annotations[constants.ReclaimMinCountsAnnotation]; v != want {
+					t.Errorf("slice %s floors = %q, want %q", suffix, v, want)
+				}
+			}
+		})
+	}
+}
+
+func toObjects(wls []*kueue.Workload) []client.Object {
+	objs := make([]client.Object, len(wls))
+	for i, wl := range wls {
+		objs[i] = wl
+	}
+	return objs
+}
