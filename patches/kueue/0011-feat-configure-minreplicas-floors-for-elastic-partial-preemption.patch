+// refreshFloors brings the reclaim floor and step annotations of every slice up to the
+// job's, when the caller asked for that. It writes metadata only.
+func (r *Manager) refreshFloors(ctx context.Context, active []kueue.Workload, options ensureOptions, skip ...*kueue.Workload) error {
+	for i := range active {
+		wl := &active[i]
+		if workloadfinish.IsFinished(wl) {
+			continue
+		}
+		if slices.ContainsFunc(skip, func(s *kueue.Workload) bool { return s != nil && workload.Key(s) == workload.Key(wl) }) {
+			continue
+		}
+		if options.apply(wl) {
+			if err := r.Client.Update(ctx, wl); err != nil {
+				return fmt.Errorf("failed to update workload's reclaim floors: %w", err)
+			}
+		}
+	}
+	return nil
+}
