+// Defines the annotation recording minimum replica floors for partial preemption.
+package constants
+
+const (
+	// ReclaimMinCountsAnnotation is the Workload annotation that lists the fewest pods each
+	// PodSet may keep when partial preemption shrinks it, as <podSet>=<count>[,<podSet>=<count>].
+	// A PodSet missing from the list is only evicted whole.
+	ReclaimMinCountsAnnotation = "kueue.x-k8s.io/reclaim-min-counts"
+)
