+// Tests RayCluster reclaim floors synchronization under singlecluster controller.
+package raycluster
+
+import (
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/component-base/featuregate"
+	"k8s.io/utils/ptr"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingraycluster "sigs.k8s.io/kueue/pkg/util/testingjobs/raycluster"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+	"sigs.k8s.io/kueue/test/util/behavioral"
+)
+
+var _ = ginkgo.Describe("RayCluster reclaim floors", ginkgo.Label("job:ray", "area:jobs"), func() {
+	var (
+		ns             *corev1.Namespace
+		resourceFlavor *kueue.ResourceFlavor
+		clusterQueue   *kueue.ClusterQueue
+		localQueue     *kueue.LocalQueue
+	)
+
+	setup := func(partialPreemption bool) {
+		ginkgo.BeforeEach(func() {
+			features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlices:                          true,
+				features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+				features.PartialPreemption:                                     partialPreemption,
+			})
+			fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+
+			ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "floors-")
+			resourceFlavor = utiltestingapi.MakeResourceFlavor("default").Obj()
+			behavioral.MustCreate(ctx, k8sClient, resourceFlavor)
+			clusterQueue = utiltestingapi.MakeClusterQueue("default").
+				ResourceGroup(*utiltestingapi.MakeFlavorQuotas(resourceFlavor.Name).
+					Resource(corev1.ResourceCPU, "100").
+					Resource(corev1.ResourceMemory, "100Gi").
+					Obj()).
+				Obj()
+			behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+			localQueue = utiltestingapi.MakeLocalQueue("default", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+			behavioral.MustCreate(ctx, k8sClient, localQueue)
+		})
+		ginkgo.AfterEach(func() {
+			gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, localQueue, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, resourceFlavor, true)
+			fwk.StopManager(ctx)
+		})
+	}
+
+	elasticCluster := func() *testingraycluster.ClusterWrapper {
+		return testingraycluster.MakeCluster("foo", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			SetAnnotation(constants.ElasticJobScaleUpStrategyAnnotationKey, constants.ElasticJobScaleUpStrategyPartial).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			FirstWorkerGroupReplicas(4, 2, 8)
+	}
+
+	// onlyWorkload waits for the cluster's single admitted Workload.
+	onlyWorkload := func() *kueue.Workload {
+		ginkgo.GinkgoHelper()
+		var wl *kueue.Workload
+		gomega.Eventually(func(g gomega.Gomega) {
+			wls := &kueue.WorkloadList{}
+			g.Expect(k8sClient.List(ctx, wls, client.InNamespace(ns.Name))).To(gomega.Succeed())
+			g.Expect(wls.Items).To(gomega.HaveLen(1))
+			g.Expect(workload.IsAdmitted(&wls.Items[0])).To(gomega.BeTrue())
+			wl = &wls.Items[0]
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		return wl
+	}
+
+	ginkgo.When("PartialPreemption is on", func() {
+		setup(true)
+
+		ginkgo.It("Should write the floor of an elastic cluster's worker group and refresh it when minReplicas changes", func() {
+			rc := elasticCluster().Obj()
+			behavioral.MustCreate(ctx, k8sClient, rc)
+
+			wl := onlyWorkload()
+			gomega.Expect(wl.Annotations).To(gomega.HaveKeyWithValue(constants.ReclaimMinCountsAnnotation, "workers-group-0=2"))
+
+			ginkgo.By("raising minReplicas without changing the size")
+			gomega.Eventually(func(g gomega.Gomega) {
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rc), rc)).To(gomega.Succeed())
+				rc.Spec.WorkerGroupSpecs[0].MinReplicas = new(int32(3))
+				g.Expect(k8sClient.Update(ctx, rc)).To(gomega.Succeed())
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+			gomega.Eventually(func(g gomega.Gomega) {
+				got := &kueue.Workload{}
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), got)).To(gomega.Succeed())
+				g.Expect(got.Annotations).To(gomega.HaveKeyWithValue(constants.ReclaimMinCountsAnnotation, "workers-group-0=3"))
+				g.Expect(got.UID).To(gomega.Equal(wl.UID))
+				g.Expect(workload.IsAdmitted(got)).To(gomega.BeTrue())
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		})
+
+		ginkgo.It("Should give a multi-host worker group no floor", func() {
+			rc := elasticCluster().WithNumOfHosts("workers-group-0", 2).Obj()
+			behavioral.MustCreate(ctx, k8sClient, rc)
+
+			wl := onlyWorkload()
+			gomega.Expect(wl.Annotations).NotTo(gomega.HaveKey(constants.ReclaimMinCountsAnnotation))
+		})
+
+		ginkgo.It("Should give an elastic cluster without the partial scale-up strategy no floor", func() {
+			rc := testingraycluster.MakeCluster("foo", ns.Name).
+				SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+				Queue(localQueue.Name).
+				RequestWorkerGroup(corev1.ResourceCPU, "1").FirstWorkerGroupReplicas(4, 2, 8).Obj()
+			behavioral.MustCreate(ctx, k8sClient, rc)
+
+			wl := onlyWorkload()
+			gomega.Expect(wl.Annotations).NotTo(gomega.HaveKey(constants.ReclaimMinCountsAnnotation))
+		})
+
+		ginkgo.It("Should give a non-elastic cluster no floor", func() {
+			rc := testingraycluster.MakeCluster("foo", ns.Name).Queue(localQueue.Name).
+				RequestWorkerGroup(corev1.ResourceCPU, "1").FirstWorkerGroupReplicas(4, 2, 8).Obj()
+			behavioral.MustCreate(ctx, k8sClient, rc)
+
+			wl := onlyWorkload()
+			gomega.Expect(wl.Annotations).NotTo(gomega.HaveKey(constants.ReclaimMinCountsAnnotation))
+		})
+
+		ginkgo.It("Should keep an admitted Workload admitted while it adds the floor annotations", func() {
+			rc := elasticCluster().Obj()
+			behavioral.MustCreate(ctx, k8sClient, rc)
+			wl := onlyWorkload()
+			workerSet := wl.Spec.PodSets[1]
+
+			ginkgo.By("removing the annotations an older release did not write")
+			gomega.Eventually(func(g gomega.Gomega) {
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).To(gomega.Succeed())
+				delete(wl.Annotations, constants.ReclaimMinCountsAnnotation)
+				g.Expect(k8sClient.Update(ctx, wl)).To(gomega.Succeed())
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+
+			ginkgo.By("expecting the annotations back, and the Workload and cluster untouched otherwise")
+			gomega.Eventually(func(g gomega.Gomega) {
+				got := &kueue.Workload{}
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), got)).To(gomega.Succeed())
+				g.Expect(got.Annotations).To(gomega.HaveKeyWithValue(constants.ReclaimMinCountsAnnotation, "workers-group-0=2"))
+			}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+			gomega.Consistently(func(g gomega.Gomega) {
+				got := &kueue.Workload{}
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), got)).To(gomega.Succeed())
+				g.Expect(got.UID).To(gomega.Equal(wl.UID))
+				g.Expect(workload.IsAdmitted(got)).To(gomega.BeTrue())
+				g.Expect(got.Spec.PodSets[1].Count).To(gomega.Equal(workerSet.Count))
+				g.Expect(got.Status.Conditions).NotTo(gomega.ContainElement(gomega.HaveField("Type", kueue.WorkloadEvicted)))
+				g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rc), rc)).To(gomega.Succeed())
+				g.Expect(ptr.Deref(rc.Spec.Suspend, false)).To(gomega.BeFalse())
+			}, behavioral.ConsistentDuration, behavioral.Interval).Should(gomega.Succeed())
+		})
+	})
+
+	ginkgo.When("PartialPreemption is off", func() {
+		setup(false)
+
+		ginkgo.It("Should write no annotation", func() {
+			behavioral.MustCreate(ctx, k8sClient, elasticCluster().Obj())
+
+			wl := onlyWorkload()
+			gomega.Expect(wl.Annotations).NotTo(gomega.HaveKey(constants.ReclaimMinCountsAnnotation))
+		})
+	})
+})
