+		t.Error("RayJob does not implement JobWithReclaimMinCounts")
+	}
+	if _, ok := any((*rayservice.RayService)(nil)).(jobframework.JobWithReclaimMinCounts); ok {
+		t.Error("RayService implements JobWithReclaimMinCounts")
