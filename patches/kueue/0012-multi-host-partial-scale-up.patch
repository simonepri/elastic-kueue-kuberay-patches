+// Gating of the floor and step annotations on partial scale-up, so the scheduler can grant
+// whole replicas of multi-host worker groups without PartialPreemption.
+
+package jobframework
+
+import (
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// reclaimFloorsEnabled reports whether the job reconciler writes floor and step annotations:
+// PartialPreemption writes both, partial scale-up writes the steps.
+func reclaimFloorsEnabled() bool {
+	return features.Enabled(features.PartialPreemption) ||
+		features.Enabled(features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp)
+}
+
+// scaleUpOnlySteps drops the steps equal to 1, which a missing entry already means, so
+// partial scale-up annotates only the PodSets it must round.
+func scaleUpOnlySteps(steps workload.PodSetsCounts) workload.PodSetsCounts {
+	for name, step := range steps {
+		if step <= 1 {
+			delete(steps, name)
+		}
+	}
+	return steps
+}
