+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// A PodSetReducer that grants counts in whole steps, such as the replicas of a multi-host worker group.
+
+package flavorassigner
+
+import (
+	"slices"
+
+	"k8s.io/utils/ptr"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// SteppedPodSetReducer is a PodSetReducer whose counts are multiples of each PodSet's step.
+// It reduces step counts and converts them to pods, so the baseline, the growth check and
+// the search all see the rounded counts. A PodSet's full count is always a candidate, even
+// when it is not a multiple of the step, and its baseline (MinCount) rounds up to the next
+// multiple.
+type SteppedPodSetReducer struct {
+	inner *PodSetReducer
+	// scales are the per-PodSet conversions, in the order of the PodSets.
+	scales []stepScale
+	names  []kueue.PodSetReference
+}
+
+// stepScale converts between a PodSet's step counts and its pod counts.
+type stepScale struct {
+	step, count int32
+}
+
+func (s stepScale) pods(steps int32) int32 {
+	return int32(min(int64(steps)*int64(s.step), int64(s.count)))
+}
+
+func (s stepScale) steps(pods int32) int32 {
+	return int32((int64(pods) + int64(s.step) - 1) / int64(s.step))
+}
+
+// NewSteppedPodSetReducer is NewOrderedPodSetReducer for PodSets that grow and shrink by
+// steps[name] pods, where a PodSet missing from steps, or with a step below 1, has step 1.
+// With every step 1 it behaves exactly as NewOrderedPodSetReducer.
+func NewSteppedPodSetReducer(podSets []kueue.PodSet, steps workload.PodSetsCounts, fits func(workload.PodSetsCounts) bool) *SteppedPodSetReducer {
+	r := &SteppedPodSetReducer{
+		scales: make([]stepScale, len(podSets)),
+		names:  make([]kueue.PodSetReference, len(podSets)),
+	}
+	unitPodSets := slices.Clone(podSets)
+	for i := range unitPodSets {
+		ps := &unitPodSets[i]
+		r.names[i] = ps.Name
+		r.scales[i] = stepScale{step: max(steps[ps.Name], 1), count: ps.Count}
+		if ps.MinCount != nil {
+			ps.MinCount = ptr.To(r.scales[i].steps(min(*ps.MinCount, ps.Count)))
+		}
+		ps.Count = r.scales[i].steps(ps.Count)
+	}
+	r.inner = NewOrderedPodSetReducer(unitPodSets, func(unitCounts workload.PodSetsCounts) bool {
+		return fits(r.toPods(unitCounts))
+	})
+	return r
+}
+
+// Reduce is PodSetReducer.Reduce; the counts it returns are pods.
+func (r *SteppedPodSetReducer) Reduce(mustGrow bool) (workload.PodSetsCounts, bool) {
+	unitCounts, found := r.inner.Reduce(mustGrow)
+	if !found {
+		return nil, false
+	}
+	return r.toPods(unitCounts), true
+}
+
+func (r *SteppedPodSetReducer) toPods(unitCounts workload.PodSetsCounts) workload.PodSetsCounts {
+	pods := make(workload.PodSetsCounts, len(unitCounts))
+	for i, name := range r.names {
+		if c, ok := unitCounts[name]; ok {
+			pods[name] = r.scales[i].pods(c)
+		}
+	}
+	return pods
+}
diff --git a/pkg/scheduler/flavorassigner/podset_reducer_steps_test.go b/pkg/scheduler/flavorassigner/podset_reducer_steps_test.go
