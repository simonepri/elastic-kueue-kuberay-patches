+limitations under the License.
+*/
+
+package flavorassigner
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+func TestSteppedPodSetReducer(t *testing.T) {
+	workers := func(count, minCount int32) []kueue.PodSet {
+		return []kueue.PodSet{*utiltestingapi.MakePodSet("workers", int(count)).SetMinimumCount(minCount).Obj()}
+	}
+	room := func(n int32) func(workload.PodSetsCounts) bool {
+		return func(c workload.PodSetsCounts) bool { return c["workers"] <= n }
+	}
+	cases := map[string]struct {
+		podSets   []kueue.PodSet
+		steps     workload.PodSetsCounts
+		fits      func(workload.PodSetsCounts) bool
+		mustGrow  bool
+		wantFound bool
+		want      workload.PodSetsCounts
+	}{
+		"room for 5 of 8 in steps of 2 grants 4": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(5),
+			wantFound: true, want: workload.PodSetsCounts{"workers": 4},
+		},
+		"room for 6 grants 6": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(6),
+			wantFound: true, want: workload.PodSetsCounts{"workers": 6},
+		},
+		"room for 5 does not grow a running baseline of 4": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(5), mustGrow: true,
+		},
+		"room for 6 grows a running baseline of 4": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(6), mustGrow: true,
+			wantFound: true, want: workload.PodSetsCounts{"workers": 6},
+		},
+		"room for 3 is below the baseline": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(3),
+		},
+		"room for the full count grants it": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(8), mustGrow: true,
+			wantFound: true, want: workload.PodSetsCounts{"workers": 8},
+		},
+		"a baseline off the step rounds up": {
+			podSets: workers(8, 3), steps: workload.PodSetsCounts{"workers": 2}, fits: room(5),
+			wantFound: true, want: workload.PodSetsCounts{"workers": 4},
+		},
+		"a full count off the step stays a candidate": {
+			podSets: workers(7, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(7), mustGrow: true,
+			wantFound: true, want: workload.PodSetsCounts{"workers": 7},
+		},
+		"a partial grant of a full count off the step rounds down": {
+			podSets: workers(7, 4), steps: workload.PodSetsCounts{"workers": 2}, fits: room(6), mustGrow: true,
+			wantFound: true, want: workload.PodSetsCounts{"workers": 6},
+		},
+		"no steps behaves as step 1": {
+			podSets: workers(8, 4), fits: room(5), mustGrow: true,
+			wantFound: true, want: workload.PodSetsCounts{"workers": 5},
+		},
+		"a step below 1 behaves as step 1": {
+			podSets: workers(8, 4), steps: workload.PodSetsCounts{"workers": 0}, fits: room(5), mustGrow: true,
+			wantFound: true, want: workload.PodSetsCounts{"workers": 5},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got, found := NewSteppedPodSetReducer(tc.podSets, tc.steps, tc.fits).Reduce(tc.mustGrow)
+			if found != tc.wantFound {
+				t.Fatalf("Reduce() found = %v, want %v (counts %v)", found, tc.wantFound, got)
+			}
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("Reduce() counts (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+// TestSteppedPodSetReducerOnlyFitsMultiples pins that fits never sees a count that is not a
+// whole number of steps below the full count.
+func TestSteppedPodSetReducerOnlyFitsMultiples(t *testing.T) {
+	podSets := []kueue.PodSet{
+		*utiltestingapi.MakePodSet("a", 9).SetMinimumCount(3).Obj(),
+		*utiltestingapi.MakePodSet("b", 8).SetMinimumCount(4).Obj(),
+	}
+	fits := func(c workload.PodSetsCounts) bool {
+		if c["a"]%3 != 0 || c["b"]%2 != 0 {
+			t.Errorf("fits saw %v, not whole steps", c)
+		}
+		return c["a"]+c["b"] <= 13
+	}
+	got, found := NewSteppedPodSetReducer(podSets, workload.PodSetsCounts{"a": 3, "b": 2}, fits).Reduce(false)
+	if !found {
+		t.Fatal("Reduce() found nothing")
+	}
+	if got["a"]%3 != 0 || got["b"]%2 != 0 || got["a"]+got["b"] > 13 {
+		t.Errorf("Reduce() = %v", got)
+	}
+}
+
+// TestSteppedPodSetReducerStepOneMatchesOrdered pins that unit steps change nothing against the base reducer.
+func TestSteppedPodSetReducerStepOneMatchesOrdered(t *testing.T) {
+	podSets := []kueue.PodSet{
+		*utiltestingapi.MakePodSet("ps1", 6).SetMinimumCount(2).Obj(),
+		*utiltestingapi.MakePodSet("ps2", 5).SetMinimumCount(1).Obj(),
+	}
+	for limit := int32(2); limit <= 11; limit++ {
+		fits := func(c workload.PodSetsCounts) bool { return c["ps1"]+c["ps2"] <= limit }
+		for _, mustGrow := range []bool{false, true} {
+			want, wantFound := NewOrderedPodSetReducer(podSets, fits).Reduce(mustGrow)
+			got, found := NewSteppedPodSetReducer(podSets, nil, fits).Reduce(mustGrow)
+			if found != wantFound || cmp.Diff(want, got) != "" {
+				t.Errorf("limit %d mustGrow %v: got %v,%v want %v,%v", limit, mustGrow, got, found, want, wantFound)
+			}
+		}
+	}
+}
