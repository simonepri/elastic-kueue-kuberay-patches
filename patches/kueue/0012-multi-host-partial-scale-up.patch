+// Picks the gated pods of a PodSet that grows in steps so that only whole replica groups start.
+
+package elasticjobs
+
+import (
+	"slices"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	utilpod "sigs.k8s.io/kueue/pkg/util/pod"
+)
+
+// replicaGroupLabel names the pods of one replica of a multi-host Ray worker group.
+const replicaGroupLabel = "ray.io/worker-group-replica-name"
+
+// podsToUngateInWholeGroups returns up to room of the gated candidates of podSet, in whole
+// replica groups: a group is ungated only when all its gated pods fit, a group that
+// already has running pods is completed before a new one starts, and a group with nothing
+// running starts only once KubeRay has created all step pods of it. Groups go in name order.
+// A candidate without the group label is its own group. pods are all the live pods of the
+// slice, used to tell which groups have started.
+func podsToUngateInWholeGroups(candidates, pods []*corev1.Pod, podSet kueue.PodSetReference, step, room int32) []*corev1.Pod {
+	started := map[string]bool{}
+	for _, p := range pods {
+		if g := p.Labels[replicaGroupLabel]; g != "" && !utilpod.IsTerminated(p) &&
+			p.Labels[constants.PodSetLabel] == string(podSet) && !utilpod.HasGate(p, kueue.ElasticJobSchedulingGate) {
+			started[g] = true
+		}
+	}
+	groups := map[string][]*corev1.Pod{}
+	for _, p := range candidates {
+		key := p.Labels[replicaGroupLabel]
+		if key == "" {
+			key = "\x00" + p.Name
+		}
+		groups[key] = append(groups[key], p)
+	}
+	keys := make([]string, 0, len(groups))
+	for k := range groups {
+		keys = append(keys, k)
+	}
+	// Started groups first, then by name.
+	slices.SortFunc(keys, func(a, b string) int {
+		if started[a] != started[b] {
+			if started[a] {
+				return -1
+			}
+			return 1
+		}
+		return strings.Compare(a, b)
+	})
+	var out []*corev1.Pod
+	for _, k := range keys {
+		n := int32(len(groups[k]))
+		if !started[k] && !strings.HasPrefix(k, "\x00") && n != step {
+			continue
+		}
+		if n <= room {
+			out = append(out, groups[k]...)
+			room -= n
+		}
+	}
+	return out
+}
