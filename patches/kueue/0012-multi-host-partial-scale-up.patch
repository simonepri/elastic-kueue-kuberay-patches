+func replicaPod(name, group string, gated bool) *corev1.Pod {
+	p := makeElasticPodForPodSet(name, workersPodSet).Label(replicaGroupLabel, group)
+	if gated {
+		p = p.Gate(kueue.ElasticJobSchedulingGate)
+	}
+	return p.Obj()
+}
+
+// Pod names are random in KubeRay, so name order interleaves the replicas.
+func TestUngateWholeReplicaGroups(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	now := time.Now().Truncate(time.Second)
+
+	cases := map[string]struct {
+		step      string
+		granted   int32
+		pods      []*corev1.Pod
+		wantOpen  []string
+		wantGated []string
+	}{
+		"granted 6 with r1 and r2 running ungates r3 whole and keeps r4 whole gated": {
+			step:    "workers=2",
+			granted: 6,
+			pods: []*corev1.Pod{
+				replicaPod("p-1a", "r1", false), replicaPod("p-1b", "r1", false),
+				replicaPod("p-2a", "r2", false), replicaPod("p-2b", "r2", false),
+				replicaPod("p-a3", "r3", true), replicaPod("p-b4", "r4", true),
+				replicaPod("p-c3", "r3", true), replicaPod("p-d4", "r4", true),
+			},
+			wantOpen:  []string{"p-a3", "p-c3"},
+			wantGated: []string{"p-b4", "p-d4"},
+		},
+		"a half-started group is completed before a new one starts": {
+			step:    "workers=2",
+			granted: 4,
+			pods: []*corev1.Pod{
+				replicaPod("p-1a", "r1", false), replicaPod("p-1b", "r1", false),
+				replicaPod("p-2a", "r2", false), replicaPod("p-2b", "r2", true),
+				replicaPod("p-3a", "r3", true), replicaPod("p-3b", "r3", true),
+			},
+			wantOpen:  []string{"p-2b"},
+			wantGated: []string{"p-3a", "p-3b"},
+		},
+		"a group still missing pods is not started": {
+			step:    "workers=2",
+			granted: 4,
+			pods: []*corev1.Pod{
+				replicaPod("p-1a", "r1", false), replicaPod("p-1b", "r1", false),
+				replicaPod("p-2a", "r2", true), replicaPod("p-3a", "r3", true),
+			},
+			wantGated: []string{"p-2a", "p-3a"},
+		},
+		"a complete group starts while an incomplete one waits": {
+			step:    "workers=2",
+			granted: 4,
+			pods: []*corev1.Pod{
+				replicaPod("p-1a", "r1", false), replicaPod("p-1b", "r1", false),
+				replicaPod("p-2a", "r2", true), replicaPod("p-3a", "r3", true), replicaPod("p-3b", "r3", true),
+			},
+			wantOpen:  []string{"p-3a", "p-3b"},
+			wantGated: []string{"p-2a"},
+		},
+		"without a step pods go by name": {
+			granted: 5,
+			pods: []*corev1.Pod{
+				replicaPod("p-1a", "r1", false), replicaPod("p-1b", "r1", false),
+				replicaPod("p-2a", "r2", false), replicaPod("p-2b", "r2", false),
+				replicaPod("p-a3", "r3", true), replicaPod("p-b4", "r4", true),
+				replicaPod("p-c3", "r3", true), replicaPod("p-d4", "r4", true),
+			},
+			wantOpen:  []string{"p-a3"},
+			wantGated: []string{"p-b4", "p-c3", "p-d4"},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			wb := utiltestingapi.MakeWorkload("wl", "ns").
+				Finalizers(kueue.ResourceInUseFinalizerName).
+				Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+				ControllerReference(rayClusterGVK, "ray", "ray-uid").
+				PodSets(*utiltestingapi.MakePodSet(workersPodSet, 8).Request(corev1.ResourceCPU, "1").Obj()).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").
+					PodSets(utiltestingapi.MakePodSetAssignment(workersPodSet).
+						Assignment(corev1.ResourceCPU, "flavor", "6").Count(tc.granted).Obj()).Obj(), now).
+				AdmittedAt(true, now)
+			if tc.step != "" {
+				wb = wb.Annotation(constants.PodSetCountStepsAnnotation, tc.step)
+			}
+			wl := wb.Obj()
+
+			b := utiltesting.NewClientBuilder().
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+				WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(rayClusterGVK), coreindexer.WorkloadOwnerIndexFunc(rayClusterGVK)).
+				WithIndex(&kueue.Workload{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexWorkloadSliceName).
+				WithStatusSubresource(wl)
+			for _, p := range tc.pods {
+				b = b.WithObjects(p)
+			}
+			c := b.Build()
+			if err := c.Create(ctx, wl); err != nil {
+				t.Fatal(err)
+			}
+			u := &elasticJobUngater{client: c, clock: testingclock.NewFakeClock(now), expectationsStore: expectations.NewStore(ControllerName)}
+			if _, err := u.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(wl)}); err != nil {
+				t.Fatal(err)
+			}
+
+			var open, gated []string
+			var list corev1.PodList
+			if err := c.List(ctx, &list); err != nil {
+				t.Fatal(err)
+			}
+			for _, p := range list.Items {
+				if testingpodHasGate(&p) {
+					gated = append(gated, p.Name)
+				} else {
+					open = append(open, p.Name)
+				}
+			}
+			slices.Sort(gated)
+			for _, w := range tc.wantOpen {
+				if !slices.Contains(open, w) {
+					t.Errorf("%s should be ungated; ungated: %v", w, open)
+				}
+			}
+			if !slices.Equal(gated, tc.wantGated) {
+				t.Errorf("gated = %v, want %v", gated, tc.wantGated)
+			}
+		})
+	}
+}
+
+func testingpodHasGate(p *corev1.Pod) bool {
+	for _, g := range p.Spec.SchedulingGates {
+		if g.Name == kueue.ElasticJobSchedulingGate {
+			return true
+		}
+	}
+	return false
+}
