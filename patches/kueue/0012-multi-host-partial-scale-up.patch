+// The step sizes the scheduler's partial admission rounds a Workload's grants to.
+
+package scheduler
+
+import (
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// partialScaleUpSteps returns the step each PodSet of wl is granted in, read from its
+// kueue.x-k8s.io/podset-count-steps annotation, or nil when partial scale-up is off.
+func partialScaleUpSteps(wl *kueue.Workload) workload.PodSetsCounts {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp) {
+		return nil
+	}
+	return workload.PodSetCountSteps(wl)
+}
