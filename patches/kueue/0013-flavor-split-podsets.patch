+
+// A worker group split across two flavors is shrunk only in the entry on the flavor the
+// preemptor needs: its entry on the other flavor is grown back whole.
+func TestPartialPreemptionShrinksOnlyTheSplitEntryOnTheNeededFlavor(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	now := time.Now().Truncate(time.Second)
+	ctx, log := utiltesting.ContextWithLog(t)
+	victim := utiltestingapi.MakeWorkload("victim", "default").
+		Annotation(constants.ReclaimMinCountsAnnotation, "workers=2,workers--2=0").
+		PodSets(
+			*utiltestingapi.MakePodSet("workers", 4).Request(corev1.ResourceCPU, "1").Obj(),
+			*utiltestingapi.MakePodSet("workers--2", 4).
+				Annotations(map[string]string{"kueue.x-k8s.io/flavor-split-of": "workers"}).
+				Request(corev1.ResourceCPU, "1").Obj(),
+		).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("borrower").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(4).Assignment(corev1.ResourceCPU, "reserved", "4").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers--2").Count(4).Assignment(corev1.ResourceCPU, "spot", "4").Obj(),
+		).Obj(), now.Add(-time.Hour)).
+		AdmittedAt(true, now.Add(-time.Hour)).
+		Obj()
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: []kueue.Workload{*victim}}).
+		WithStatusSubresource(&kueue.Workload{}).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("reserved").Obj())
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("spot").Obj())
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("reserved").Resource(corev1.ResourceCPU, "0").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("spot").Resource(corev1.ResourceCPU, "4").Obj(),
+			).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny, WithinClusterQueue: kueue.PreemptionPolicyNever}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("reserved").Resource(corev1.ResourceCPU, "4").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("spot").Resource(corev1.ResourceCPU, "0").Obj(),
+			).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := cache.AddOrUpdateWorkload(ctx, log, victim); !err {
+		t.Fatal("Could not add the victim to the cache")
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("preemptor", "default").
+		PodSets(*utiltestingapi.MakePodSet("main", 2).Request(corev1.ResourceCPU, "1").Obj()).Obj())
+	incoming.ClusterQueue = "incoming"
+	assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+		Name: "main", Count: 2, Requests: corev1.ResourceList{corev1.ResourceCPU: *resource.NewQuantity(2, resource.DecimalSI)},
+		Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "spot", Mode: flavorassigner.Preempt}},
+	}}}
+	preemptor := New(cl, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(now), nil, preemptexpectations.New(), nil)
+	targets, _ := preemptor.GetTargets(ctx, *incoming, snapshot, assignment)
+	if diff := gocmp.Diff([]string{"victim:workers--2=2"}, describeTargets(targets)); diff != "" {
+		t.Errorf("GetTargets() (-want,+got):\n%s", diff)
+	}
+}
