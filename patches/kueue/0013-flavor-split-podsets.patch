+)
+
+// A worker group split across two flavors is shrunk only in the entry on the flavor the
+// preemptor needs: its entry on the other flavor is grown back whole.
+func TestPartialPreemptionShrinksOnlyTheSplitEntryOnTheNeededFlavor(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PartialPreemption, true)
+	now := time.Now().Truncate(time.Second)
+	ctx, log := utiltesting.ContextWithLog(t)
+	victim := utiltestingapi.MakeWorkload("victim", "default").
+		Annotation(constants.ReclaimMinCountsAnnotation, "workers=2,workers--2=0").
+		PodSets(
+			*utiltestingapi.MakePodSet("workers", 4).Request(corev1.ResourceCPU, "1").Obj(),
+			*utiltestingapi.MakePodSet("workers--2", 4).
+				Annotations(map[string]string{"kueue.x-k8s.io/flavor-split-of": "workers"}).
+				Request(corev1.ResourceCPU, "1").Obj(),
+		).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("borrower").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(4).Assignment(corev1.ResourceCPU, "reserved", "4").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers--2").Count(4).Assignment(corev1.ResourceCPU, "spot", "4").Obj(),
+		).Obj(), now.Add(-time.Hour)).
+		AdmittedAt(true, now.Add(-time.Hour)).
+		Obj()
+	cl := utiltesting.NewClientBuilder().WithLists(&kueue.WorkloadList{Items: []kueue.Workload{*victim}}).
+		WithStatusSubresource(&kueue.Workload{}).Build()
+	cache := schdcache.New(cl)
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("reserved").Obj())
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("spot").Obj())
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("incoming").Cohort("shared").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("reserved").Resource(corev1.ResourceCPU, "0").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("spot").Resource(corev1.ResourceCPU, "4").Obj(),
+			).
+			Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny, WithinClusterQueue: kueue.PreemptionPolicyNever}).Obj(),
+		utiltestingapi.MakeClusterQueue("borrower").Cohort("shared").
+			ResourceGroup(
+				*utiltestingapi.MakeFlavorQuotas("reserved").Resource(corev1.ResourceCPU, "4").Obj(),
+				*utiltestingapi.MakeFlavorQuotas("spot").Resource(corev1.ResourceCPU, "0").Obj(),
+			).Obj(),
+	} {
+		if err := cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := cache.AddOrUpdateWorkload(ctx, log, victim); !err {
+		t.Fatal("Could not add the victim to the cache")
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	incoming := workload.NewInfo(log, utiltestingapi.MakeWorkload("preemptor", "default").
+		PodSets(*utiltestingapi.MakePodSet("main", 2).Request(corev1.ResourceCPU, "1").Obj()).Obj())
+	incoming.ClusterQueue = "incoming"
+	assignment := flavorassigner.Assignment{PodSets: []flavorassigner.PodSetAssignment{{
+		Name: "main", Count: 2, Requests: corev1.ResourceList{corev1.ResourceCPU: *resource.NewQuantity(2, resource.DecimalSI)},
+		Flavors: flavorassigner.ResourceAssignment{corev1.ResourceCPU: {Name: "spot", Mode: flavorassigner.Preempt}},
+	}}}
+	preemptor := New(cl, workload.Ordering{}, &utiltesting.EventRecorder{}, nil, false, clocktesting.NewFakeClock(now), nil, preemptexpectations.New(), nil)
+	targets, _ := preemptor.GetTargets(ctx, *incoming, snapshot, assignment)
+	if diff := gocmp.Diff([]string{"victim:workers--2=2"}, describeTargets(targets)); diff != "" {
+		t.Errorf("GetTargets() (-want,+got):\n%s", diff)
+	}
+}
diff --git a/pkg/workloadslicing/flavor_split.go b/pkg/workloadslicing/flavor_split.go
new file mode 100644
index 0000000..8d9a02e
--- /dev/null
+++ b/pkg/workloadslicing/flavor_split.go
@@ -0,0 +1,363 @@
+/*
+Copyright The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Flavor-split PodSets: the pods an elastic job adds to a PodSet that do not fit on the flavor
+// of its running pods become a split entry of the same Workload, which the scheduler places
+// on the next flavor. This file maps job counts to entries and builds the entries.
+
+package workloadslicing
+
+import (
+	"context"
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/validation"
+	"k8s.io/utils/ptr"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+)
+
+// FlavorSplitOfAnnotation, on the template of a Workload PodSet, marks the PodSet as a split
+// entry of the job PodSet it names. A split entry runs some of that PodSet's pods, possibly on
+// another flavor; its name is the job PodSet's name with a "--<n>" suffix.
+const FlavorSplitOfAnnotation = "kueue.x-k8s.io/flavor-split-of"
+
+// maxWorkloadPodSets is the most PodSets the Workload API accepts.
+const maxWorkloadPodSets = 8
+
+// SplitBase returns the job PodSet whose pods ps runs: the one a split entry names, or ps itself.
+func SplitBase(ps *kueue.PodSet) kueue.PodSetReference {
+	if base := ps.Template.Annotations[FlavorSplitOfAnnotation]; base != "" {
+		return kueue.PodSetReference(base)
+	}
+	return ps.Name
+}
+
+// IsSplitEntry reports whether ps is a split entry of another PodSet.
+func IsSplitEntry(ps *kueue.PodSet) bool {
+	return ps.Template.Annotations[FlavorSplitOfAnnotation] != ""
+}
+
+// HasSplitEntries reports whether any PodSet is a split entry.
+func HasSplitEntries(podSets []kueue.PodSet) bool {
+	return slices.ContainsFunc(podSets, func(ps kueue.PodSet) bool { return IsSplitEntry(&ps) })
+}
+
+// splitGroups returns the indexes of the entries of each job PodSet in spec order, which puts
+// the job PodSet's own entry first and its split entries in the order they were added.
+func splitGroups(podSets []kueue.PodSet) map[kueue.PodSetReference][]int {
+	groups := make(map[kueue.PodSetReference][]int, len(podSets))
+	for i := range podSets {
+		base := SplitBase(&podSets[i])
+		groups[base] = append(groups[base], i)
+	}
+	return groups
+}
+
+// FoldSplitCounts sums counts, keyed by the entries of podSets, into counts per job PodSet.
+// Without split entries it returns counts.
+func FoldSplitCounts(podSets []kueue.PodSet, counts workload.PodSetsCounts) workload.PodSetsCounts {
+	if !HasSplitEntries(podSets) {
+		return counts
+	}
+	folded := make(workload.PodSetsCounts, len(counts))
+	for i := range podSets {
+		if count, found := counts[podSets[i].Name]; found {
+			folded[SplitBase(&podSets[i])] += count
+		}
+	}
+	return folded
+}
+
+// entryCountsForJob maps the job's count of each PodSet onto the entries of podSets. A PodSet
+// that grows grows in its newest entry. One that shrinks keeps, with running set, the running
+// pods of each entry and gives the rest of its count to its entries in order, so the newest
+// entries shrink first; with running nil it shrinks its newest entries first. It reports false
+// when an entry runs more pods than the job asks for, which happens until the job's controller
+// deletes the pods it removed, since which entry loses them is not known yet. A job PodSet with
+// no entry keeps its own key, so the keys still differ. Without split entries it returns jobCounts.
+func entryCountsForJob(podSets []kueue.PodSet, jobCounts, running workload.PodSetsCounts) (workload.PodSetsCounts, bool) {
+	if !HasSplitEntries(podSets) {
+		return jobCounts, true
+	}
+	groups := splitGroups(podSets)
+	counts := make(workload.PodSetsCounts, len(podSets))
+	for name, count := range jobCounts {
+		if _, found := groups[name]; !found {
+			counts[name] = count
+		}
+	}
+	for base, idxs := range groups {
+		want, found := jobCounts[base]
+		if !found {
+			continue
+		}
+		current := make([]int32, len(idxs))
+		var total int32
+		for i, idx := range idxs {
+			current[i] = podSets[idx].Count
+			total += current[i]
+		}
+		switch {
+		case want >= total:
+			current[len(current)-1] += want - total
+		case running == nil:
+			excess := total - want
+			for i := len(current) - 1; i >= 0 && excess > 0; i-- {
+				cut := min(current[i], excess)
+				current[i] -= cut
+				excess -= cut
+			}
+		default:
+			rest := want
+			kept := make([]int32, len(idxs))
+			for i, idx := range idxs {
+				kept[i] = min(current[i], running[podSets[idx].Name])
+				rest -= kept[i]
+			}
+			if rest < 0 {
+				return nil, false
+			}
+			for i := range kept {
+				add := min(current[i]-kept[i], rest)
+				kept[i] += add
+				rest -= add
+			}
+			current = kept
+		}
+		for i, idx := range idxs {
+			counts[podSets[idx].Name] = current[i]
+		}
+	}
+	return counts, true
+}
+
+// jobCountsForSlice maps the job's counts onto the entries of wl. A slice that holds quota
+// shrinks by its running pods (see entryCountsForJob), so the entry whose pods the job's
+// controller deleted is the one that shrinks.
+func jobCountsForSlice(ctx context.Context, c client.Client, wl *kueue.Workload, jobCounts workload.PodSetsCounts) (workload.PodSetsCounts, bool, error) {
+	counts, settled := entryCountsForJob(wl.Spec.PodSets, jobCounts, nil)
+	if !HasSplitEntries(wl.Spec.PodSets) || !workload.HasQuotaReservation(wl) ||
+		!counts.HasFewerReplicasThan(workload.ExtractPodSetCountsFromWorkload(wl)) {
+		return counts, settled, nil
+	}
+	running, err := runningPodsPerPodSet(ctx, c, wl)
+	if err != nil {
+		return nil, false, fmt.Errorf("listing the running pods of the split workload slice: %w", err)
+	}
+	live := make(workload.PodSetsCounts, len(running))
+	for ps, pods := range running {
+		for _, p := range pods {
+			if p.DeletionTimestamp == nil {
+				live[ps]++
+			}
+		}
+	}
+	counts, settled = entryCountsForJob(wl.Spec.PodSets, jobCounts, live)
+	return counts, settled, nil
+}
+
+// newSplitEntry returns a split entry of base named name, with base's template.
+func newSplitEntry(base *kueue.PodSet, name kueue.PodSetReference, count int32) kueue.PodSet {
+	entry := *base.DeepCopy()
+	entry.Name = name
+	entry.Count = count
+	entry.MinCount = nil
+	if !placesByTopology(entry.TopologyRequest) {
+		// Only the pod index labels, which describe the job PodSet's pods as a whole.
+		entry.TopologyRequest = nil
+	}
+	metav1.SetMetaDataAnnotation(&entry.Template.ObjectMeta, FlavorSplitOfAnnotation, string(base.Name))
+	return entry
+}
+
+// placesByTopology reports whether the topology request constrains where the pods go, which a split
+// entry cannot honor for pods spread over several entries. A request that only names the pod index
+// labels, as the RayCluster integration writes for every worker group, does not.
+func placesByTopology(tr *kueue.PodSetTopologyRequest) bool {
+	return tr != nil && (tr.Required != nil || tr.Preferred != nil || ptr.Deref(tr.Unconstrained, false) ||
+		tr.PodSetGroupName != nil || tr.PodSetSliceRequiredTopology != nil)
+}
+
+// nextSplitName returns the first "<base>--<n>" name, from n = 2, that no PodSet uses, and false
+// when it would be longer than a PodSet name may be.
+func nextSplitName(podSets []kueue.PodSet, base kueue.PodSetReference) (kueue.PodSetReference, bool) {
+	for n := 2; ; n++ {
+		name := kueue.PodSetReference(fmt.Sprintf("%s--%d", base, n))
+		if len(name) > validation.DNS1123LabelMaxLength {
+			return "", false
+		}
+		if !slices.ContainsFunc(podSets, func(ps kueue.PodSet) bool { return ps.Name == name }) {
+			return name, true
+		}
+	}
+}
+
+// CarrySplitEntries returns the PodSets of a new slice of the job that replaces prev: the job's
+// PodSets, followed by the split entries of prev that still have pods, each entry keeping its
+// count in prev. A split entry at 0 is dropped, so its PodSet merges back into fewer entries.
+// The job's counts are then mapped onto the entries: growth goes to a PodSet's newest entry and
+// a shrink takes its newest entries first. Without split entries in prev it returns jobPodSets.
+func CarrySplitEntries(jobPodSets []kueue.PodSet, prev *kueue.Workload) []kueue.PodSet {
+	if prev == nil || !HasSplitEntries(prev.Spec.PodSets) {
+		return jobPodSets
+	}
+	out := slices.Clone(jobPodSets)
+	byName := func(name kueue.PodSetReference) int {
+		return slices.IndexFunc(out, func(ps kueue.PodSet) bool { return ps.Name == name })
+	}
+	prevCounts := workload.ExtractPodSetCountsFromWorkload(prev)
+	var splits []kueue.PodSet
+	for i := range prev.Spec.PodSets {
+		ps := &prev.Spec.PodSets[i]
+		if !IsSplitEntry(ps) || ps.Count == 0 {
+			continue
+		}
+		baseIdx := byName(SplitBase(ps))
+		if baseIdx < 0 {
+			continue
+		}
+		// The job PodSet's own entry keeps its count in prev too, so the job's count is
+		// mapped onto all of its entries below.
+		out[baseIdx].Count = prevCounts[out[baseIdx].Name]
+		splits = append(splits, newSplitEntry(&jobPodSets[baseIdx], ps.Name, ps.Count))
+	}
+	out = append(out, splits...)
+	counts, _ := entryCountsForJob(out, workload.ExtractPodSetCounts(jobPodSets), nil)
+	for i := range out {
+		out[i].Count = counts[out[i].Name]
+		if out[i].MinCount != nil && *out[i].MinCount > out[i].Count {
+			out[i].MinCount = ptr.To(out[i].Count)
+		}
+	}
+	return out
+}
+
+// ExpandToSplitEntries gives each split entry of podSets a floor of 0 when its job PodSet has a
+// floor, so partial preemption may stop all of its pods while the job PodSet keeps its own
+// floor, and the step of its job PodSet. Without split entries it returns its arguments.
+func ExpandToSplitEntries(podSets []kueue.PodSet, floors, steps workload.PodSetsCounts) (workload.PodSetsCounts, workload.PodSetsCounts) {
+	if !HasSplitEntries(podSets) {
+		return floors, steps
+	}
+	floors, steps = maps.Clone(floors), maps.Clone(steps)
+	for i := range podSets {
+		if !IsSplitEntry(&podSets[i]) {
+			continue
+		}
+		base := SplitBase(&podSets[i])
+		if _, found := floors[base]; found {
+			floors[podSets[i].Name] = 0
+		}
+		if step, found := steps[base]; found {
+			steps[podSets[i].Name] = step
+		}
+	}
+	return floors, steps
+}
+
+// splitTriedProbe reports whether probe, a pending replacement of the admitted slice replaced,
+// should move its growth to split entries: the scheduler tried this spec of probe and could not
+// admit it, a flavor it skipped because replaced keeps a PodSet off it would take that PodSet's
+// growth (flavorassigner.GrowthFitsOtherFlavorReason), and the slices place
+// flavors on the pods, so a split entry's pods can follow its flavor. A probe refused for any
+// other reason, such as a single-flavor ClusterQueue without room or a hold while partial
+// preemption releases quota, is not split, because another flavor would not help it.
+func splitTriedProbe(probe, replaced *kueue.Workload) bool {
+	if workload.HasQuotaReservation(probe) || workloadevict.IsEvicted(probe) ||
+		!FlavorPlacementOnPods(probe) || !FlavorPlacementOnPods(replaced) ||
+		len(workload.PendingReclaimTargetCounts(replaced)) > 0 {
+		return false
+	}
+	cond := apimeta.FindStatusCondition(probe.Status.Conditions, kueue.WorkloadQuotaReserved)
+	return cond != nil && cond.Status == metav1.ConditionFalse && cond.ObservedGeneration == probe.Generation &&
+		strings.Contains(cond.Message, flavorassigner.GrowthFitsOtherFlavorReason)
+}
+
+// SplitGrowth moves the growth of each PodSet of probe over what replaced runs in its entries to
+// a new split entry, so the scheduler may place the added pods on another flavor while
+// the running pods keep theirs. The flavor assigner keeps an entry on the flavor replaced gives
+// it, and a new entry, which replaced does not have, takes the first flavor that fits in the
+// ClusterQueue's order. With partial set, a new entry may be admitted down to one pod. PodSets
+// with a topology request or a count step above 1 are not split, nor any once the Workload has
+// as many PodSets as the API allows. It reports whether it changed probe.
+func SplitGrowth(probe, replaced *kueue.Workload, partial bool) bool {
+	running := AfterReclaimBaseline(replaced)
+	steps := workload.PodSetCountSteps(probe)
+	groups := splitGroups(probe.Spec.PodSets)
+	floors := workload.ReclaimMinCounts(probe)
+	changed := false
+	for _, base := range slices.Sorted(maps.Keys(groups)) {
+		if len(probe.Spec.PodSets) >= maxWorkloadPodSets {
+			break
+		}
+		idxs := groups[base]
+		if placesByTopology(probe.Spec.PodSets[idxs[0]].TopologyRequest) || steps[base] > 1 {
+			continue
+		}
+		// Every entry that runs pods in replaced and asks for more keeps what it runs, and
+		// the rest goes to one new entry. An entry with no pods may take any flavor whole.
+		var delta int32
+		for _, idx := range idxs {
+			ps := &probe.Spec.PodSets[idx]
+			if have, found := running[ps.Name]; found && have > 0 && ps.Count > have {
+				delta += ps.Count - have
+			}
+		}
+		if delta == 0 {
+			continue
+		}
+		name, ok := nextSplitName(probe.Spec.PodSets, base)
+		if !ok {
+			continue
+		}
+		for _, idx := range idxs {
+			ps := &probe.Spec.PodSets[idx]
+			if have, found := running[ps.Name]; found && have > 0 && ps.Count > have {
+				ps.Count = have
+				if ps.MinCount != nil && *ps.MinCount > have {
+					ps.MinCount = ptr.To(have)
+				}
+			}
+		}
+		entry := newSplitEntry(&probe.Spec.PodSets[idxs[0]], name, delta)
+		if partial {
+			entry.MinCount = ptr.To[int32](1)
+		}
+		probe.Spec.PodSets = append(probe.Spec.PodSets, entry)
+		if _, found := floors[base]; found {
+			floors[name] = 0
+		}
+		changed = true
+	}
+	if changed && len(floors) > 0 {
+		workload.SetReclaimMinCounts(probe, floors)
+	}
+	if changed && len(steps) > 0 {
+		_, steps = ExpandToSplitEntries(probe.Spec.PodSets, nil, steps)
+		workload.SetPodSetCountSteps(probe, steps)
+	}
+	return changed
+}
