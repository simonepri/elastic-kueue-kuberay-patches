+func (a *FlavorAssigner) tryGreedySplit(ctx context.Context, log logr.Logger) bool {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesFlavorSplit) || a.wl == nil || a.wl.Obj == nil {
+		return false
+	}
+	if !a.isElasticWorkload() {
+		return false
+	}
+	if len(a.wl.Obj.Spec.PodSets) >= maxWorkloadPodSets {
+		return false
+	}
+
+	floors := workload.ReclaimMinCounts(a.wl.Obj)
+	steps := workload.PodSetCountSteps(a.wl.Obj)
+	changed := false
+
+	initialLen := len(a.wl.Obj.Spec.PodSets)
+	for i := 0; i < initialLen; i++ {
+		if len(a.wl.Obj.Spec.PodSets) >= maxWorkloadPodSets {
+			break
+		}
+		ps := &a.wl.Obj.Spec.PodSets[i]
+		if !isElasticWorkerPodSet(a.wl.Obj, a.replaceWorkloadSlice, ps) || ps.Count <= 0 {
+			continue
+		}
+		base := SplitBase(ps)
+		psIdx := slices.IndexFunc(a.wl.TotalRequests, func(r workload.PodSetResources) bool {
+			return r.Name == ps.Name
+		})
+		if psIdx < 0 {
+			continue
+		}
+
+		var runningCount int32
+		var currentFlavor kueue.ResourceFlavorReference
+		if a.replaceWorkloadSlice != nil {
+			if oldPS := podSetResourcesByName(a.replaceWorkloadSlice.TotalRequests, ps.Name); oldPS != nil && oldPS.Count > 0 {
+				runningCount = oldPS.Count
+				for _, f := range oldPS.Flavors {
+					currentFlavor = f
+					break
+				}
+			}
+		}
+
+		if ps.Count <= runningCount {
+			continue
+		}
+
+		rg := a.resourceGroupForPodSet(psIdx)
+		if rg == nil || len(rg.Flavors) < 2 {
+			continue
+		}
+
+		var flavorOrder []kueue.ResourceFlavorReference
+		if currentFlavor != "" {
+			flavorOrder = append(flavorOrder, currentFlavor)
+			idx := slices.Index(rg.Flavors, currentFlavor)
+			if idx >= 0 {
+				flavorOrder = append(flavorOrder, rg.Flavors[idx+1:]...)
+			} else {
+				flavorOrder = append(flavorOrder, rg.Flavors...)
+			}
+		} else {
+			flavorOrder = append(flavorOrder, rg.Flavors...)
+		}
+
+		type flavorGrant struct {
+			flavor kueue.ResourceFlavorReference
+			count  int32
+		}
+		var grants []flavorGrant
+		remaining := ps.Count
+
+		for _, fName := range flavorOrder {
+			if remaining <= 0 {
+				break
+			}
+			maxOnF := a.maxPodsForFlavor(log, psIdx, ps, rg, fName, currentFlavor, runningCount)
+			if maxOnF <= 0 {
+				continue
+			}
+			canTake := min(remaining, maxOnF)
+
+			if fName == currentFlavor || (currentFlavor == "" && len(grants) == 0) {
+				if floor, ok := floors[base]; ok && canTake < floor {
+					canTake = 0
+				}
+			}
+			if step, ok := steps[base]; ok && step > 1 {
+				if fName == currentFlavor {
+					growth := canTake - runningCount
+					if growth > 0 {
+						growth = (growth / step) * step
+						canTake = runningCount + growth
+					} else {
+						canTake = runningCount
+					}
+				} else {
+					canTake = (canTake / step) * step
+				}
+			}
+			if canTake <= 0 {
+				continue
+			}
+			if fName == currentFlavor && canTake <= runningCount {
+				grants = append(grants, flavorGrant{flavor: fName, count: runningCount})
+				remaining -= runningCount
+				continue
+			}
+			grants = append(grants, flavorGrant{flavor: fName, count: canTake})
+			remaining -= canTake
+		}
+
+		if remaining == 0 && len(grants) > 1 && len(a.wl.Obj.Spec.PodSets)-1+len(grants) <= maxWorkloadPodSets {
+			ps.Count = grants[0].count
+			if ps.MinCount != nil && *ps.MinCount > ps.Count {
+				ps.MinCount = ptr.To(ps.Count)
+			}
+			basePodSet := ps.DeepCopy()
+			if baseIdx := slices.IndexFunc(a.wl.Obj.Spec.PodSets, func(p kueue.PodSet) bool { return p.Name == base }); baseIdx >= 0 {
+				basePodSet = a.wl.Obj.Spec.PodSets[baseIdx].DeepCopy()
+			}
+			for _, g := range grants[1:] {
+				name, ok := nextSplitName(a.wl.Obj.Spec.PodSets, base)
+				if !ok {
+					break
+				}
+				entry := newSplitEntry(basePodSet, name, g.count)
+				a.wl.Obj.Spec.PodSets = append(a.wl.Obj.Spec.PodSets, entry)
+				if _, ok := floors[base]; ok {
+					floors[name] = 0
+				}
+				if step, ok := steps[base]; ok {
+					steps[name] = step
+				}
+			}
+			changed = true
+		}
+	}
+
+	if changed {
+		if len(floors) > 0 {
+			workload.SetReclaimMinCounts(a.wl.Obj, floors)
+		}
+		if len(steps) > 0 {
+			workload.SetPodSetCountSteps(a.wl.Obj, steps)
+		}
+		origCQ := a.wl.ClusterQueue
+		a.wl.Update(log, a.wl.Obj)
+		if origCQ != "" && a.wl.ClusterQueue == "" {
+			a.wl.ClusterQueue = origCQ
+		}
+	}
+	return changed
+}
+
+// GrowthFitsOtherFlavorReason ends the message the flavor assigner gives a flavor it skips because
+// the replaced slice keeps the PodSet on another flavor, when the PodSet's growth over the replaced
+// slice would fit on the skipped flavor without preemption. With
+// ElasticJobsViaWorkloadSlicesFlavorSplit, the job reconciler splits the growth of a refused slice
+// only when its message contains it (see workloadslicing.SplitGrowth), so a slice that no other
+// flavor would take keeps its PodSets.
+const GrowthFitsOtherFlavorReason = "its growth fits this flavor"
+
+// growthFits reports whether the growth of the PodSets psIDs over the slice that the workload
+// replaces fits on the flavor fName without preemption, for every resource in requests. PodSets
+// that do not grow report false, since only growth can move to a split PodSet.
+func (a *FlavorAssigner) growthFits(ctx context.Context, fName kueue.ResourceFlavorReference, psIDs []int, requests resources.Requests, assignmentUsage resources.FlavorResourceQuantities) bool {
+	fits, grows := true, false
+	requests.ForEach(func(rName corev1.ResourceName, val resources.Amount) {
+		if !fits {
+			return
+		}
+		for _, psID := range psIDs {
+			if replaced := podSetResourcesByName(a.replaceWorkloadSlice.TotalRequests, a.wl.Obj.Spec.PodSets[psID].Name); replaced != nil && replaced.Requests != nil {
+				val = val.Sub(replaced.Requests.ResourceValue(rName))
+			}
+		}
+		if val.Sign() > 0 {
+			grows = true
+		}
+		fr := resources.FlavorResource{Flavor: fName, Resource: rName}
+		mode, _, _ := a.fitsResourceQuota(ctx, fr, assignmentUsage[fr], val, a.cq.QuotaFor(fr))
+		fits = mode == fit
+	})
+	return fits && grows
+}
