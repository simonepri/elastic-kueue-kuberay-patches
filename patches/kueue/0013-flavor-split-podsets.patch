+func (w *RayJobWebhook) restampElasticTemplates(ctx context.Context, obj *rayv1.RayJob) error {
+	if !isAnElasticJob(obj) || obj.Spec.RayClusterSpec == nil {
+		return nil
+	}
+	job := fromObject(obj)
+	clusterSpec := job.Spec.RayClusterSpec
+	utilpod.GateTemplate(&clusterSpec.HeadGroupSpec.Template, kueue.ElasticJobSchedulingGate)
+	for i := range clusterSpec.WorkerGroupSpecs {
+		utilpod.GateTemplate(&clusterSpec.WorkerGroupSpecs[i].Template, kueue.ElasticJobSchedulingGate)
+	}
+	if job.IsSuspended() {
+		return nil
+	}
+	active, err := workloadslicing.FindLatestActiveWorkload(ctx, w.client, job.Object(), job.GVK())
+	if err != nil {
+		return err
+	}
+	if active == nil || !workloadslicing.IsElasticWorkload(active) {
+		return nil
+	}
+	sliceName := workloadslicing.SliceName(active)
+	templates := map[kueue.PodSetReference]*corev1.PodTemplateSpec{
+		kueue.NewPodSetReference(headGroupPodSetName): &clusterSpec.HeadGroupSpec.Template,
+	}
+	for i := range clusterSpec.WorkerGroupSpecs {
+		wgs := &clusterSpec.WorkerGroupSpecs[i]
+		templates[kueue.NewPodSetReference(wgs.GroupName)] = &wgs.Template
+	}
+	for podSet, template := range templates {
+		raycluster.StampPodSet(template, podSet, sliceName)
+		if _, found := template.Annotations[kueue.WorkloadAnnotation]; !found && raycluster.PodsScheduledTracking() {
+			template.Annotations[kueue.WorkloadAnnotation] = active.Name
+		}
+		if err := raycluster.StampAdmission(ctx, w.client, active, podSet, template); err != nil {
+			return err
+		}
+	}
 	return nil
 }
 
