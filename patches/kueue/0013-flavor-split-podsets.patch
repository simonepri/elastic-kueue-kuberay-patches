+// Picks the gated pods of a PodSet with flavor-split entries and the entry each one starts in.
+
+package elasticjobs
+
+import (
+	"context"
+	"maps"
+	"slices"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// splitGroups lists the entries of each PodSet of a Workload that has split entries.
+type splitGroups struct {
+	// entries holds, for each PodSet with split entries, its own entry and then its split
+	// entries, in spec order.
+	entries map[kueue.PodSetReference][]kueue.PodSetReference
+	// entryOf maps every entry in entries to its PodSet.
+	entryOf map[kueue.PodSetReference]kueue.PodSetReference
+}
+
+func splitGroupsOf(wl *kueue.Workload) splitGroups {
+	g := splitGroups{
+		entries: map[kueue.PodSetReference][]kueue.PodSetReference{},
+		entryOf: map[kueue.PodSetReference]kueue.PodSetReference{},
+	}
+	for i := range wl.Spec.PodSets {
+		if ps := &wl.Spec.PodSets[i]; workloadslicing.IsSplitEntry(ps) {
+			base := workloadslicing.SplitBase(ps)
+			if len(g.entries[base]) == 0 {
+				g.entries[base] = []kueue.PodSetReference{base}
+				g.entryOf[base] = base
+			}
+			g.entries[base] = append(g.entries[base], ps.Name)
+			g.entryOf[ps.Name] = base
+		}
+	}
+	return g
+}
+
+// ungateSplitGroups picks, for each PodSet with split entries, the gated pods to start and the
+// entry each starts in. The job's controller creates every pod of the PodSet with its own name
+// in the kueue.x-k8s.io/podset label, so its gated pods are shared by its entries: the PodSet's
+// own entry takes them first, then each split entry in order, each up to its granted count less
+// the pods already running in it, the lowest-named pods first. A pod goes to a split entry only
+// if it can take the entry's placement. The ungater then writes the entry in the pod's label,
+// which the pod keeps, so its running pods are counted, and stopped by partial preemption, in
+// that entry only.
+func (r *elasticJobUngater) ungateSplitGroups(
+	ctx context.Context,
+	wl *kueue.Workload,
+	groups splitGroups,
+	gated map[kueue.PodSetReference][]*corev1.Pod,
+	running, granted workload.PodSetsCounts,
+	updates map[kueue.PodSetReference]podAdmissionUpdate,
+) (map[string]kueue.PodSetReference, error) {
+	assigned := map[string]kueue.PodSetReference{}
+	byName := func(a, b *corev1.Pod) int { return strings.Compare(a.Name, b.Name) }
+	for _, base := range slices.Sorted(maps.Keys(groups.entries)) {
+		shared := slices.SortedFunc(slices.Values(gated[base]), byName)
+		for _, entry := range groups.entries[base] {
+			room := granted[entry] - running[entry]
+			if room <= 0 {
+				continue
+			}
+			update, found := updates[entry]
+			if !found {
+				var err error
+				if update, err = r.admissionUpdate(ctx, wl, entry); err != nil {
+					return nil, err
+				}
+				updates[entry] = update
+			}
+			// A gated pod that already has the entry's label goes first.
+			if entry != base {
+				for _, p := range slices.SortedFunc(slices.Values(gated[entry]), byName) {
+					if room == 0 {
+						break
+					}
+					assigned[p.Name] = entry
+					room--
+				}
+			}
+			rest := shared[:0:0]
+			for _, p := range shared {
+				if room > 0 && podAdmissionCompatible(p, update) {
+					assigned[p.Name] = entry
+					room--
+					continue
+				}
+				rest = append(rest, p)
+			}
+			shared = rest
+		}
+	}
+	return assigned, nil
+}
