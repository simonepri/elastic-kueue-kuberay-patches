+
+// Tells the job reconciler when the growth of a replacement slice would fit on a flavor that the
+// PodSet's running pods keep it off, so it can split that growth into its own PodSet.
+
+package flavorassigner
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"slices"
+
+	"github.com/go-logr/logr"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/validation"
+	"k8s.io/utils/ptr"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	resourcegroups "sigs.k8s.io/kueue/pkg/util/resourcegroups"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/resources"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// FlavorSplitOfAnnotation, on the template of a Workload PodSet, marks the PodSet as a split
+// entry of the job PodSet it names.
+const FlavorSplitOfAnnotation = "kueue.x-k8s.io/flavor-split-of"
+
+// maxWorkloadPodSets is the most PodSets the Workload API accepts.
+const maxWorkloadPodSets = 8
+
+// SplitBase returns the job PodSet whose pods ps runs: the one a split entry names, or ps itself.
+func SplitBase(ps *kueue.PodSet) kueue.PodSetReference {
+	if base := ps.Template.Annotations[FlavorSplitOfAnnotation]; base != "" {
+		return kueue.PodSetReference(base)
+	}
+	return ps.Name
+}
+
+// IsSplitEntry reports whether ps is a split entry of another PodSet.
+func IsSplitEntry(ps *kueue.PodSet) bool {
+	return ps.Template.Annotations[FlavorSplitOfAnnotation] != ""
+}
+
+// placesByTopology reports whether the topology request constrains where the pods go, which a split
+// entry cannot honor for pods spread over several entries.
+func placesByTopology(tr *kueue.PodSetTopologyRequest) bool {
+	return tr != nil && (tr.Required != nil || tr.Preferred != nil || ptr.Deref(tr.Unconstrained, false) ||
+		tr.PodSetGroupName != nil || tr.PodSetSliceRequiredTopology != nil)
+}
+
+// nextSplitName returns the first "<base>--<n>" name, from n = 2, that no PodSet uses, and false
+// when it would be longer than a PodSet name may be.
+func nextSplitName(podSets []kueue.PodSet, base kueue.PodSetReference) (kueue.PodSetReference, bool) {
+	for n := 2; ; n++ {
+		name := kueue.PodSetReference(fmt.Sprintf("%s--%d", base, n))
+		if len(name) > validation.DNS1123LabelMaxLength {
+			return "", false
+		}
+		if !slices.ContainsFunc(podSets, func(ps kueue.PodSet) bool { return ps.Name == name }) {
+			return name, true
+		}
+	}
+}
+
+// newSplitEntry returns a split entry of base named name, with base's template.
+func newSplitEntry(base *kueue.PodSet, name kueue.PodSetReference, count int32) kueue.PodSet {
+	entry := *base.DeepCopy()
+	entry.Name = name
+	entry.Count = count
+	entry.MinCount = nil
+	if !placesByTopology(entry.TopologyRequest) {
+		entry.TopologyRequest = nil
+	}
+	metav1.SetMetaDataAnnotation(&entry.Template.ObjectMeta, FlavorSplitOfAnnotation, string(SplitBase(base)))
+	return entry
+}
+
+func isElasticWorkerPodSet(wl *kueue.Workload, replaceSlice *workload.Info, ps *kueue.PodSet) bool {
+	if ps == nil || wl == nil {
+		return false
+	}
+	base := SplitBase(ps)
+	if base == "head" || ps.Name == "head" || ps.Name == "submitter" {
+		return false
+	}
+	if placesByTopology(ps.TopologyRequest) {
+		return false
+	}
+	hasMinCount := false
+	basePSIdx := slices.IndexFunc(wl.Spec.PodSets, func(p kueue.PodSet) bool { return p.Name == base })
+	if basePSIdx >= 0 && wl.Spec.PodSets[basePSIdx].MinCount != nil {
+		hasMinCount = true
+	}
+	floors := workload.ReclaimMinCounts(wl)
+	_, hasFloor := floors[base]
+	if !hasMinCount && !hasFloor && replaceSlice != nil && replaceSlice.Obj != nil {
+		if oldIdx := slices.IndexFunc(replaceSlice.Obj.Spec.PodSets, func(p kueue.PodSet) bool { return p.Name == base }); oldIdx >= 0 && replaceSlice.Obj.Spec.PodSets[oldIdx].MinCount != nil {
+			hasMinCount = true
+		}
+		oldFloors := workload.ReclaimMinCounts(replaceSlice.Obj)
+		if _, ok := oldFloors[base]; ok {
+			hasFloor = true
+		}
+	}
+	return hasMinCount || hasFloor
+}
+
+func (a *FlavorAssigner) isElasticWorkload() bool {
+	if a.wl == nil || a.wl.Obj == nil || a.wl.Obj.Annotations == nil {
+		return false
+	}
+	if a.wl.Obj.Annotations["kueue.x-k8s.io/flavor-placement-on-pods"] != "true" {
+		return false
+	}
+	if a.replaceWorkloadSlice != nil {
+		return a.replaceWorkloadSlice.Obj != nil && a.replaceWorkloadSlice.Obj.Annotations != nil &&
+			a.replaceWorkloadSlice.Obj.Annotations["kueue.x-k8s.io/flavor-placement-on-pods"] == "true"
+	}
+	return true
+}
+
+func (a *FlavorAssigner) resourceGroupForPodSet(psIdx int) *resourcegroups.ResourceGroup {
+	if psIdx < 0 || psIdx >= len(a.wl.TotalRequests) {
+		return nil
+	}
+	psr := &a.wl.TotalRequests[psIdx]
+	if psr.Requests == nil {
+		return nil
+	}
+	const gpuResource = corev1.ResourceName("nvidia.com/gpu")
+	if psr.Requests.ResourceValue(gpuResource).Sign() > 0 {
+		if rg := a.cq.RGByResource(gpuResource); rg != nil {
+			return rg
+		}
+	}
+	for resName, val := range psr.Requests.Iter() {
+		if val.Sign() <= 0 {
+			continue
+		}
+		if rg := a.cq.RGByResource(resName); rg != nil {
+			return rg
+		}
+	}
+	return nil
+}
+
+func (a *FlavorAssigner) maxPodsForFlavor(
+	log logr.Logger,
+	psIdx int,
+	ps *kueue.PodSet,
+	rg *resourcegroups.ResourceGroup,
+	fName kueue.ResourceFlavorReference,
+	currentFlavor kueue.ResourceFlavorReference,
+	runningCount int32,
+) int32 {
+	if status := a.checkFlavorForPodSets(log, fName, []int{psIdx}, []*kueue.PodSet{ps}, rg); !status.IsFit() {
+		return 0
+	}
+	psr := &a.wl.TotalRequests[psIdx]
+	if psr.Requests == nil || psr.Count <= 0 {
+		return 0
+	}
+	maxPods := int32(math.MaxInt32)
+	checked := false
+
+	for resName, val := range psr.Requests.Iter() {
+		if val.Sign() <= 0 {
+			continue
+		}
+		var perPod resources.Amount
+		if psr.PerPodRequests != nil {
+			perPod = psr.PerPodRequests.ResourceValue(resName)
+		} else {
+			perPod = val.QuoInt64(int64(psr.Count))
+		}
+		if perPod.Sign() <= 0 {
+			continue
+		}
+		fr := resources.FlavorResource{Flavor: fName, Resource: resName}
+		avail := a.cq.Available(fr)
+		if avail.Sign() <= 0 {
+			if fName == currentFlavor {
+				maxPods = min(maxPods, runningCount)
+				checked = true
+				continue
+			}
+			return 0
+		}
+		addVal, _ := avail.Quo(perPod).Int64()
+		addPods := int32(addVal)
+		if fName == currentFlavor {
+			maxPods = min(maxPods, runningCount+addPods)
+		} else {
+			maxPods = min(maxPods, addPods)
+		}
+		checked = true
+	}
+	if !checked || maxPods == math.MaxInt32 {
+		return 0
+	}
+	return max(0, maxPods)
+}
