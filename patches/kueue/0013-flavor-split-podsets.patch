+}
+
+func TestConstructWorkloadDerivesTemplatesFromPredecessor(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	gvk := batchv1.SchemeGroupVersion.WithKind("Job")
+	now := time.Now()
+	job := testingjob.MakeJob("job", "ns").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Queue("lq").
+		UID("job-uid").
+		Obj()
+
+	// Predecessor workload has the original user-defined template (ungated predecessor, admitted
+	// before the scheduling gate existed). It explicitly includes user-set toleration for nvidia.com/gpu
+	// (matching the flavor's own toleration) and user nodeSelectors, labels, and annotations.
+	origTemplate := corev1.PodTemplateSpec{
+		ObjectMeta: metav1.ObjectMeta{
+			Labels:      map[string]string{"user.label/foo": "bar"},
+			Annotations: map[string]string{"user.annotation/foo": "bar"},
+		},
+		Spec: corev1.PodSpec{
+			NodeSelector: map[string]string{
+				"instance-gpu-memory": "20000",
+				"custom-user-label":   "keep-me",
+			},
+			Tolerations: []corev1.Toleration{
+				{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule},
+			},
+		},
+	}
+	predecessor := utiltestingapi.MakeWorkload("slice", "ns").
+		PodSets(kueue.PodSet{
+			Name:     "workers",
+			Count:    8,
+			Template: origTemplate,
+		}).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(8).Assignment(corev1.ResourceCPU, "reserved", "1").Obj(),
+		).Obj(), now).
+		ControllerReference(gvk, "job", "job-uid").
+		Obj()
+
+	// The live job template was mutated by RunWithPodSetsInfo when admitting the reserved flavor
+	// on an UNGATED predecessor, injecting gpu-class: h200, capacity-type: reserved, podset label,
+	// and workload annotation. Additionally, the user edited the live template to add a custom annotation
+	// and container.
+	injectedTemplate := corev1.PodTemplateSpec{
+		ObjectMeta: metav1.ObjectMeta{
+			Labels: map[string]string{
+				"user.label/foo":        "bar",
+				"kueue.x-k8s.io/podset": "workers",
+			},
+			Annotations: map[string]string{
+				"user.annotation/foo":     "bar",
+				"user.custom/annotation":  "preserved",
+				"kueue.x-k8s.io/workload": "slice",
+			},
+		},
+		Spec: corev1.PodSpec{
+			Containers: []corev1.Container{{Name: "user-added-worker", Env: []corev1.EnvVar{}}},
+			NodeSelector: map[string]string{
+				"instance-gpu-memory": "20000",
+				"custom-user-label":   "keep-me",
+				"gpu-class":           "h200",
+				"capacity-type":       "reserved",
+			},
+			Tolerations: []corev1.Toleration{
+				{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule},
+			},
+		},
+	}
+
+	wantTemplate := corev1.PodTemplateSpec{
+		ObjectMeta: metav1.ObjectMeta{
+			Labels: map[string]string{
+				"user.label/foo": "bar",
+			},
+			Annotations: map[string]string{
+				"user.annotation/foo":    "bar",
+				"user.custom/annotation": "preserved",
+			},
+		},
+		Spec: corev1.PodSpec{
+			Containers: []corev1.Container{{Name: "user-added-worker", Env: []corev1.EnvVar{}}},
+			NodeSelector: map[string]string{
+				"instance-gpu-memory": "20000",
+				"custom-user-label":   "keep-me",
+			},
+			Tolerations: []corev1.Toleration{
+				{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule},
+			},
+		},
+	}
+
+	ctx, _ := utiltesting.ContextWithLog(t)
+	mgj := mocks.NewMockGenericJob(gomock.NewController(t))
+	mgj.EXPECT().Object().Return(job).AnyTimes()
+	mgj.EXPECT().GVK().Return(gvk).AnyTimes()
+	// JobPodSets returns podSets constructed from the live job injected template, with new count 16.
+	mgj.EXPECT().PodSets(gomock.Any(), gomock.Any()).Return([]kueue.PodSet{
+		{
+			Name:     "workers",
+			Count:    16,
+			Template: injectedTemplate,
+		},
+	}, nil).AnyTimes()
+	reservedFlavor := utiltestingapi.MakeResourceFlavor("reserved").
+		NodeLabel("gpu-class", "h200").
+		NodeLabel("capacity-type", "reserved").
+		Toleration(corev1.Toleration{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule}).
+		Obj()
+
+	cl := utiltesting.NewClientBuilder().
+		WithObjects([]client.Object{&corev1.Namespace{Name: "ns"}, job, predecessor, reservedFlavor}...).
+		WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(gvk), indexer.WorkloadOwnerIndexFunc(gvk)).
+		Build()
+
+	wl, err := ConstructWorkload(ctx, cl, mgj, nil, nil)
+	if err != nil {
+		t.Fatalf("ConstructWorkload() error: %v", err)
+	}
+
+	// The constructed workload for the scale-up probe must NOT inherit the injected flavor nodeSelector
+	// or labels/annotations, but MUST preserve user-defined tolerations (even matching the flavor),
+	// user nodeSelectors, and live user edits.
+	gotTemplate := wl.Spec.PodSets[0].Template
+	if diff := cmp.Diff(wantTemplate, gotTemplate); diff != "" {
+		t.Errorf("ConstructWorkload() template (-want,+got):\n%s", diff)
+	}
+}
+
+func TestConstructWorkloadPredecessorFlavorNotFound(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	gvk := batchv1.SchemeGroupVersion.WithKind("Job")
+	now := time.Now()
+	job := testingjob.MakeJob("job", "ns").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Queue("lq").
+		UID("job-uid").
+		Obj()
+
+	predecessor := utiltestingapi.MakeWorkload("slice", "ns").
+		PodSets(kueue.PodSet{
+			Name:  "workers",
+			Count: 8,
+		}).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(8).Assignment(corev1.ResourceCPU, "missing-flavor", "1").Obj(),
+		).Obj(), now).
+		ControllerReference(gvk, "job", "job-uid").
+		Obj()
+
+	ctx, _ := utiltesting.ContextWithLog(t)
+	mgj := mocks.NewMockGenericJob(gomock.NewController(t))
+	mgj.EXPECT().Object().Return(job).AnyTimes()
+	mgj.EXPECT().GVK().Return(gvk).AnyTimes()
+	mgj.EXPECT().PodSets(gomock.Any(), gomock.Any()).Return([]kueue.PodSet{
+		{
+			Name:  "workers",
+			Count: 16,
+		},
+	}, nil).AnyTimes()
+
+	// Flavor "missing-flavor" is deliberately omitted from client objects.
+	cl := utiltesting.NewClientBuilder().
+		WithObjects([]client.Object{&corev1.Namespace{Name: "ns"}, job, predecessor}...).
+		WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(gvk), indexer.WorkloadOwnerIndexFunc(gvk)).
+		Build()
+
+	wl, err := ConstructWorkload(ctx, cl, mgj, nil, nil)
+	if err != nil {
+		t.Fatalf("ConstructWorkload() unexpected error when flavor is missing: %v", err)
+	}
+	if wl == nil {
+		t.Fatal("ConstructWorkload() returned nil workload")
+	}
+}
