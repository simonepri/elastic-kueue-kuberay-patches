+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 12)},
+			want:       workload.PodSetsCounts{"workers": 12},
+			wantNames:  []kueue.PodSetReference{"workers"},
+		},
+		"a predecessor without split entries keeps the job's PodSets": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 12)},
+			prev:       prevWith(plainPodSet("workers", 8)),
+			want:       workload.PodSetsCounts{"workers": 12},
+			wantNames:  []kueue.PodSetReference{"workers"},
+		},
+		"growth goes to the newest entry": {
+			jobPodSets: []kueue.PodSet{plainPodSet("head", 1), plainPodSet("workers", 14)},
+			prev:       prevWith(plainPodSet("head", 1), plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)),
+			want:       workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 6},
+			wantNames:  []kueue.PodSetReference{"head", "workers", "workers--2"},
+		},
+		"an entry at 0 is dropped": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 10)},
+			prev:       prevWith(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 0), splitPodSet("workers", "workers--3", 1)),
+			want:       workload.PodSetsCounts{"workers": 8, "workers--3": 2},
+			wantNames:  []kueue.PodSetReference{"workers", "workers--3"},
+		},
+		"the job's own entry is kept at 0": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 5)},
+			prev:       prevWith(plainPodSet("workers", 0), splitPodSet("workers", "workers--2", 4)),
+			want:       workload.PodSetsCounts{"workers": 0, "workers--2": 5},
+			wantNames:  []kueue.PodSetReference{"workers", "workers--2"},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got := CarrySplitEntries(tc.jobPodSets, tc.prev)
+			if diff := cmp.Diff(tc.want, workload.ExtractPodSetCounts(got)); diff != "" {
+				t.Errorf("CarrySplitEntries() counts (-want,+got):\n%s", diff)
+			}
+			names := make([]kueue.PodSetReference, len(got))
+			for i := range got {
+				names[i] = got[i].Name
+			}
+			if diff := cmp.Diff(tc.wantNames, names); diff != "" {
+				t.Errorf("CarrySplitEntries() names (-want,+got):\n%s", diff)
+			}
+			for i := range got {
+				if IsSplitEntry(&got[i]) && SplitBase(&got[i]) != "workers" {
+					t.Errorf("Split entry %s is of %s, want workers", got[i].Name, SplitBase(&got[i]))
+				}
+			}
+		})
+	}
+}
