+func TestSplitGrowth(t *testing.T) {
+	now := time.Now()
+	admitted := func(podSets ...kueue.PodSet) *kueue.Workload {
+		var assignments []kueue.PodSetAssignment
+		for _, ps := range podSets {
+			assignments = append(assignments, utiltestingapi.MakePodSetAssignment(ps.Name).Count(ps.Count).Assignment(corev1.ResourceCPU, "reserved", "1").Obj())
+		}
+		admission := utiltestingapi.MakeAdmission("cq").PodSets(assignments...)
+		return utiltestingapi.MakeWorkload("slice", "ns").PodSets(podSets...).
+			ReserveQuotaAt(admission.Obj(), now).AdmittedAt(true, now).Obj()
+	}
+	full := func() []kueue.PodSet {
+		ps := []kueue.PodSet{plainPodSet("head", 1), plainPodSet("workers", 8)}
+		for i := 2; i <= 7; i++ {
+			ps = append(ps, splitPodSet("workers", "workers--"+string(rune('0'+i)), 1))
+		}
+		return ps
+	}
+	cases := map[string]struct {
+		probe     *kueue.Workload
+		replaced  *kueue.Workload
+		partial   bool
+		want      workload.PodSetsCounts
+		wantMin   map[kueue.PodSetReference]*int32
+		wantFloor workload.PodSetsCounts
+	}{
+		"growth of a PodSet moves to a new split entry": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("head", 1), plainPodSet("workers", 12)).Obj(),
+			replaced: admitted(plainPodSet("head", 1), plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4},
+			wantMin:  map[kueue.PodSetReference]*int32{"head": nil, "workers": nil, "workers--2": nil},
+		},
+		"partial scale-up admits a new entry down to one pod": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+				PodSets(*utiltestingapi.MakePodSet("workers", 12).SetMinimumCount(8).Request(corev1.ResourceCPU, "1").Obj()).Obj(),
+			replaced:  admitted(plainPodSet("workers", 8)),
+			partial:   true,
+			want:      workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+			wantMin:   map[kueue.PodSetReference]*int32{"workers": ptr.To[int32](8), "workers--2": ptr.To[int32](1)},
+			wantFloor: workload.PodSetsCounts{"workers": 2, "workers--2": 0},
+		},
+		"growth of a split entry moves to the next one": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 6)).Obj(),
+			replaced: admitted(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)),
+			want:     workload.PodSetsCounts{"workers": 8, "workers--2": 4, "workers--3": 2},
+			wantMin:  map[kueue.PodSetReference]*int32{"workers": nil, "workers--2": nil, "workers--3": nil},
+		},
+		"regrowth after a partial reclaim of an older entry moves to a new entry": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)).Obj(),
+			replaced: func() *kueue.Workload {
+				wl := admitted(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4))
+				workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{"workers": 2})
+				wl.Status.ReclaimablePods = []kueue.ReclaimablePod{{Name: "workers", Count: 6}}
+				return wl
+			}(),
+			want: workload.PodSetsCounts{"workers": 2, "workers--2": 4, "workers--3": 6},
+		},
+		"a newest entry the replaced slice does not run is not split again": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+		},
+		"a PodSet with no running pods may move whole, so it is not split": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 4)).Obj(),
+			replaced: admitted(plainPodSet("workers", 0)),
+			want:     workload.PodSetsCounts{"workers": 4},
+		},
+		"a PodSet with a count step above 1 is not split": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				Annotation(constants.PodSetCountStepsAnnotation, "workers=2").
+				PodSets(plainPodSet("workers", 12)).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 12},
+		},
+		"a PodSet with a topology request is not split": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				PodSets(*utiltestingapi.MakePodSet("workers", 12).RequiredTopologyRequest("rack").Request(corev1.ResourceCPU, "1").Obj()).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 12},
+		},
+		"a PodSet whose topology request only names pod index labels is split": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				PodSets(*utiltestingapi.MakePodSet("workers", 12).PodIndexLabel(ptr.To("ray.io/worker-group-replica-index")).Request(corev1.ResourceCPU, "1").Obj()).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+		},
+		"a Workload with the most PodSets the API allows is not split": {
+			probe: func() *kueue.Workload {
+				ps := full()
+				ps[len(ps)-1].Count = 3
+				return utiltestingapi.MakeWorkload("probe", "ns").PodSets(ps...).Obj()
+			}(),
+			replaced: admitted(full()...),
+			want: workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 1, "workers--3": 1, "workers--4": 1,
+				"workers--5": 1, "workers--6": 1, "workers--7": 3},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			probe := tc.probe.DeepCopy()
+			changed := SplitGrowth(probe, tc.replaced, tc.partial)
+			got := workload.ExtractPodSetCountsFromWorkload(probe)
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("SplitGrowth() counts (-want,+got):\n%s", diff)
+			}
+			if wantChanged := len(tc.want) != len(tc.probe.Spec.PodSets); changed != wantChanged {
+				t.Errorf("SplitGrowth() = %v, want %v", changed, wantChanged)
+			}
+			for i := range probe.Spec.PodSets {
+				ps := &probe.Spec.PodSets[i]
+				if want, found := tc.wantMin[ps.Name]; found {
+					if diff := cmp.Diff(want, ps.MinCount); diff != "" {
+						t.Errorf("SplitGrowth() minCount of %s (-want,+got):\n%s", ps.Name, diff)
+					}
+				}
+				if len(ps.Name) > len("workers") && SplitBase(ps) != "workers" {
+					t.Errorf("SplitGrowth() entry %s is of %q, want workers", ps.Name, SplitBase(ps))
+				}
+			}
+			if tc.wantFloor != nil {
+				if diff := cmp.Diff(tc.wantFloor, workload.ReclaimMinCounts(probe)); diff != "" {
+					t.Errorf("SplitGrowth() floors (-want,+got):\n%s", diff)
+				}
+			}
+		})
+	}
+}
