+func TestEnsureWorkloadSlicesFlavorSplit(t *testing.T) {
+	job := &batchv1.Job{ObjectMeta: metav1.ObjectMeta{Name: "job", Namespace: "ns", UID: uuid.NewUUID()}}
+	now := time.Now()
+	slice := func(podSets ...kueue.PodSet) *utiltestingapi.WorkloadWrapper {
+		var assignments []kueue.PodSetAssignment
+		for _, ps := range podSets {
+			assignments = append(assignments, utiltestingapi.MakePodSetAssignment(ps.Name).Count(ps.Count).Assignment(corev1.ResourceCPU, "reserved", "1").Obj())
+		}
+		admission := utiltestingapi.MakeAdmission("cq").PodSets(assignments...)
+		return utiltestingapi.MakeWorkload("slice", job.Namespace).
+			OwnerReference(testJobGVK, job.Name, string(job.UID)).
+			Creation(now.Add(-time.Minute)).
+			Annotation(EnabledAnnotationKey, EnabledAnnotationValue).
+			Annotation(kueue.WorkloadSliceNameAnnotation, "slice").
+			Annotation(FlavorPlacementOnPodsAnnotation, "true").
+			PodSets(podSets...).
+			ReserveQuotaAt(admission.Obj(), now).AdmittedAt(true, now)
+	}
+	refused := func(podSets ...kueue.PodSet) *kueue.Workload {
+		return utiltestingapi.MakeWorkload("probe", job.Namespace).
+			OwnerReference(testJobGVK, job.Name, string(job.UID)).
+			Creation(now).
+			Annotation(EnabledAnnotationKey, EnabledAnnotationValue).
+			Annotation(kueue.WorkloadSliceNameAnnotation, "slice").
+			Annotation(FlavorPlacementOnPodsAnnotation, "true").
+			Annotation(WorkloadSliceReplacementFor, "ns/slice").
+			PodSets(podSets...).
+			Condition(metav1.Condition{Type: kueue.WorkloadQuotaReserved, Status: metav1.ConditionFalse, Reason: "Pending",
+				Message: "couldn't assign flavors to pod set workers: could not assign spot flavor since the original workload is assigned: reserved; " + flavorassigner.GrowthFitsOtherFlavorReason}).
+			Obj()
+	}
+	worker := func(name, podSet string, gated bool) *corev1.Pod {
+		p := testingpod.MakePod(name, job.Namespace).
+			Annotation(kueue.WorkloadSliceNameAnnotation, "slice").
+			Label(constants.PodSetLabel, podSet)
+		if gated {
+			p.Gate(kueue.ElasticJobSchedulingGate)
+		}
+		return p.Obj()
+	}
+	cases := map[string]struct {
+		gate     bool
+		objs     []client.Object
+		jobCount int32
+		// wantName is the slice EnsureWorkloadSlices returns, "" for a new one.
+		wantName   string
+		wantCounts workload.PodSetsCounts
+	}{
+		"a split slice matching the job is returned unchanged": {
+			objs:       []client.Object{slice(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)).Obj()},
+			jobCount:   12,
+			wantName:   "slice",
+			wantCounts: workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+		},
+		"growth of a split slice asks for a new slice": {
+			objs:     []client.Object{slice(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)).Obj()},
+			jobCount: 14,
+		},
+		"a scale-down shrinks the entry whose pods were deleted": {
+			objs: []client.Object{
+				slice(plainPodSet("workers", 3), splitPodSet("workers", "workers--2", 2)).Obj(),
+				worker("a", "workers", false), worker("b", "workers", false), worker("c", "workers", false),
+				worker("d", "workers--2", false),
+			},
+			jobCount:   4,
+			wantName:   "slice",
+			wantCounts: workload.PodSetsCounts{"workers": 3, "workers--2": 1},
+		},
+		"a scale-down waits for the deleted pods": {
+			objs: []client.Object{
+				slice(plainPodSet("workers", 3), splitPodSet("workers", "workers--2", 2)).Obj(),
+				worker("a", "workers", false), worker("b", "workers", false), worker("c", "workers", false),
+				worker("d", "workers--2", false), worker("e", "workers--2", false),
+			},
+			jobCount:   4,
+			wantName:   "slice",
+			wantCounts: workload.PodSetsCounts{"workers": 3, "workers--2": 2},
+		},
+		"a scale-down with gated pods shrinks the newest entry first": {
+			objs: []client.Object{
+				slice(plainPodSet("workers", 3), splitPodSet("workers", "workers--2", 2)).Obj(),
+				worker("a", "workers", false), worker("b", "workers", true), worker("c", "workers", true),
+			},
+			jobCount:   4,
+			wantName:   "slice",
+			wantCounts: workload.PodSetsCounts{"workers": 3, "workers--2": 1},
+		},
+		"a refused probe is split with the gate on": {
+			gate: true,
+			objs: []client.Object{
+				slice(plainPodSet("workers", 8)).Obj(),
+				refused(plainPodSet("workers", 12)),
+			},
+			jobCount:   12,
+			wantName:   "probe",
+			wantCounts: workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+		},
+		"a refused probe is left alone with the gate off": {
+			objs: []client.Object{
+				slice(plainPodSet("workers", 8)).Obj(),
+				refused(plainPodSet("workers", 12)),
+			},
+			jobCount:   12,
+			wantName:   "probe",
+			wantCounts: workload.PodSetsCounts{"workers": 12},
+		},
+		"a probe whose growth no other flavor would take is not split": {
+			gate: true,
+			objs: []client.Object{
+				slice(plainPodSet("workers", 8)).Obj(),
+				func() *kueue.Workload {
+					wl := refused(plainPodSet("workers", 12))
+					wl.Status.Conditions[0].Message = "couldn't assign flavors to pod set workers: could not assign spot flavor since the original workload is assigned: reserved"
+					return wl
+				}(),
+			},
+			jobCount:   12,
+			wantName:   "probe",
+			wantCounts: workload.PodSetsCounts{"workers": 12},
+		},
+		"a probe the scheduler has not tried is not split": {
+			gate: true,
+			objs: []client.Object{
+				slice(plainPodSet("workers", 8)).Obj(),
+				func() *kueue.Workload {
+					wl := refused(plainPodSet("workers", 12))
+					wl.Status.Conditions = nil
+					return wl
+				}(),
+			},
+			jobCount:   12,
+			wantName:   "probe",
+			wantCounts: workload.PodSetsCounts{"workers": 12},
+		},
+		"a probe held back for a pending reclaim target is not split": {
+			gate: true,
+			objs: []client.Object{
+				slice(plainPodSet("workers", 8)).Annotation(constants.ReclaimTargetCountsAnnotation, "workers=4").Obj(),
+				refused(plainPodSet("workers", 12)),
+			},
+			jobCount:   12,
+			wantName:   "probe",
+			wantCounts: workload.PodSetsCounts{"workers": 12},
+		},
+		"a pending split probe shrinks its newest entries first": {
+			gate: true,
+			objs: []client.Object{
+				slice(plainPodSet("workers", 8)).Obj(),
+				refused(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)),
+			},
+			jobCount:   10,
+			wantName:   "probe",
+			wantCounts: workload.PodSetsCounts{"workers": 8, "workers--2": 2},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: tc.gate,
+				features.ElasticJobsViaWorkloadSlicesFlavorSplit:          tc.gate,
+			})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			clnt := utiltesting.NewClientBuilder().
+				WithObjects(tc.objs...).
+				WithStatusSubresource(&kueue.Workload{}).
+				WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(testJobGVK), indexer.WorkloadOwnerIndexFunc(testJobGVK)).
+				WithIndex(&corev1.Pod{}, indexer.WorkloadSliceNameKey, indexer.IndexPodWorkloadSliceName).
+				Build()
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(now)}
+			jobPodSets := []kueue.PodSet{plainPodSet("workers", int(tc.jobCount))}
+
+			got, compatible, err := manager.EnsureWorkloadSlices(ctx, jobPodSets, job, testJobGVK)
+			if err != nil || !compatible {
+				t.Fatalf("EnsureWorkloadSlices() compatible = %v, error = %v", compatible, err)
+			}
+			if tc.wantName == "" {
+				if got != nil {
+					t.Fatalf("EnsureWorkloadSlices() = %s, want a new slice", got.Name)
+				}
+				return
+			}
+			if got == nil || got.Name != tc.wantName {
+				t.Fatalf("EnsureWorkloadSlices() = %v, want %s", got, tc.wantName)
+			}
+			var stored kueue.Workload
+			if err := clnt.Get(ctx, types.NamespacedName{Namespace: job.Namespace, Name: tc.wantName}, &stored); err != nil {
+				t.Fatalf("Get(%s) error: %v", tc.wantName, err)
+			}
+			if diff := cmp.Diff(tc.wantCounts, workload.ExtractPodSetCountsFromWorkload(&stored)); diff != "" {
+				t.Errorf("Stored counts (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
