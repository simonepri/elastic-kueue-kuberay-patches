+func splitEntry(name string, count int32) kueue.PodSet {
+	return *utiltestingapi.MakePodSet(kueue.PodSetReference(name), int(count)).
+		Annotations(map[string]string{workloadslicing.FlavorSplitOfAnnotation: "workers"}).Obj()
+}
+
+func TestConstructWorkloadCarriesSplitEntries(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+	gvk := batchv1.SchemeGroupVersion.WithKind("Job")
+	now := time.Now()
+	job := testingjob.MakeJob("job", "ns").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Queue("lq").
+		UID("job-uid").
+		Obj()
+	predecessor := utiltestingapi.MakeWorkload("slice", "ns").
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).Obj(), splitEntry("workers--2", 4), splitEntry("workers--3", 0)).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(8).Assignment(corev1.ResourceCPU, "reserved", "1").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers--2").Count(4).Assignment(corev1.ResourceCPU, "spot", "1").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers--3").Count(0).Assignment(corev1.ResourceCPU, "spot", "1").Obj(),
+		).Obj(), now).
+		ControllerReference(gvk, "job", "job-uid").
+		Obj()
+
+	ctx, _ := utiltesting.ContextWithLog(t)
+	mgj := mocks.NewMockGenericJob(gomock.NewController(t))
+	mgj.EXPECT().Object().Return(job).AnyTimes()
+	mgj.EXPECT().GVK().Return(gvk).AnyTimes()
+	mgj.EXPECT().PodSets(gomock.Any(), gomock.Any()).Return([]kueue.PodSet{*utiltestingapi.MakePodSet("workers", 14).Obj()}, nil).AnyTimes()
+	reservedFlavor := utiltestingapi.MakeResourceFlavor("reserved").
+		NodeLabel("gpu-class", "h200").
+		NodeLabel("capacity-type", "reserved").
+		Toleration(corev1.Toleration{Key: "nvidia.com/gpu", Operator: corev1.TolerationOpExists}).
+		Obj()
+
+	cl := utiltesting.NewClientBuilder().
+		WithObjects([]client.Object{&corev1.Namespace{Name: "ns"}, job, predecessor, reservedFlavor}...).
+		WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(gvk), indexer.WorkloadOwnerIndexFunc(gvk)).
+		Build()
+
+	wl, err := ConstructWorkload(ctx, cl, mgj, nil, nil)
+	if err != nil {
+		t.Fatalf("ConstructWorkload() error: %v", err)
+	}
+	// The running entries keep their counts, the growth goes to the newest one, and the
+	// entry at 0 is dropped.
+	if diff := cmp.Diff(workload.PodSetsCounts{"workers": 8, "workers--2": 6}, workload.ExtractPodSetCountsFromWorkload(wl)); diff != "" {
+		t.Errorf("ConstructWorkload() counts (-want,+got):\n%s", diff)
+	}
+}
+
+func TestGetPodSetsInfoFromWorkloadSkipsSplitEntries(t *testing.T) {
+	wl := utiltestingapi.MakeWorkload("slice", "ns").
+		PodSets(*utiltestingapi.MakePodSet("head", 1).Obj(), *utiltestingapi.MakePodSet("workers", 8).Obj(), splitEntry("workers--2", 4)).
