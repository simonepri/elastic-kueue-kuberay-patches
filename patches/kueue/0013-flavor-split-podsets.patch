+// splitRefusedProbe moves the growth of the pending replacement probe to split entries when
+// the scheduler refused it, so the added pods may run on another flavor than the running pods
+// of their PodSet (see SplitGrowth). It needs ElasticJobsViaWorkloadSlicesFlavorSplit; the
+// rest of the flavor-split handling follows the split entries, so turning the gate off
+// strands no pod.
+func (r *Manager) splitRefusedProbe(ctx context.Context, jobObject client.Object, workloads []kueue.Workload, probe *kueue.Workload) error {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesFlavorSplit) {
+		return nil
+	}
+	replaced := admittedPredecessor(workloads, probe)
+	if replaced == nil {
+		return nil
+	}
+	// The scheduler writes the probe's status while the reconciler decides, so a conflict
+	// re-reads the probe and decides again.
+	return retry.RetryOnConflict(retry.DefaultRetry, func() error {
+		if !splitTriedProbe(probe, replaced) {
+			return nil
+		}
+		split := probe.DeepCopy()
+		if !SplitGrowth(split, replaced, partialScaleUpEnabled(jobObject)) {
+			return nil
+		}
+		ctrl.LoggerFrom(ctx).V(2).Info("Splitting the growth of a refused workload slice into PodSets that may take another flavor",
+			"workload", workload.Key(probe), "replaced", workload.Key(replaced))
+		if err := r.Client.Update(ctx, split); err != nil {
+			if apierrors.IsConflict(err) {
+				if getErr := r.Client.Get(ctx, client.ObjectKeyFromObject(probe), probe); getErr != nil {
+					return getErr
+				}
+			}
+			return fmt.Errorf("failed to split the workload slice's pod sets: %w", err)
+		}
+		*probe = *split
+		return nil
+	})
+}
