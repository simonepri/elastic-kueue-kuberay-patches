+func TestEntryCountsForJob(t *testing.T) {
+	split := []kueue.PodSet{plainPodSet("head", 1), plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4), splitPodSet("workers", "workers--3", 2)}
+	cases := map[string]struct {
+		podSets     []kueue.PodSet
+		jobCounts   workload.PodSetsCounts
+		running     workload.PodSetsCounts
+		want        workload.PodSetsCounts
+		wantSettled bool
+	}{
+		"without split entries the job's counts are returned": {
+			podSets:     []kueue.PodSet{plainPodSet("workers", 8)},
+			jobCounts:   workload.PodSetsCounts{"workers": 5},
+			want:        workload.PodSetsCounts{"workers": 5},
+			wantSettled: true,
+		},
+		"equal totals keep every entry": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 14},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 2},
+			wantSettled: true,
+		},
+		"growth goes to the newest entry": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 17},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 5},
+			wantSettled: true,
+		},
+		"a shrink without pods takes the newest entries first": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 9},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 1, "workers--3": 0},
+			wantSettled: true,
+		},
+		"a shrink with pods follows the entries that lost them": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 12},
+			running:     workload.PodSetsCounts{"head": 1, "workers": 6, "workers--2": 4, "workers--3": 2},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 6, "workers--2": 4, "workers--3": 2},
+			wantSettled: true,
+		},
+		"pods not started yet go to the oldest entries, so the newest shrink first": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 11},
+			running:     workload.PodSetsCounts{"head": 1, "workers": 6, "workers--2": 1},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 3, "workers--3": 0},
+			wantSettled: true,
+		},
+		"more running pods than the job asks for is not settled": {
+			podSets:   split,
+			jobCounts: workload.PodSetsCounts{"head": 1, "workers": 12},
+			running:   workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 2},
+		},
+		"a job PodSet without entries keeps its key": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 14, "other": 2},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 2, "other": 2},
+			wantSettled: true,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got, settled := entryCountsForJob(tc.podSets, tc.jobCounts, tc.running)
+			if settled != tc.wantSettled {
+				t.Fatalf("entryCountsForJob() settled = %v, want %v", settled, tc.wantSettled)
+			}
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("entryCountsForJob() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
