+// The job reconciler's part of regrowth after a partial preemption reclaim:
+// probe names, the after-reclaim baseline, and starting a job whose admitted slice has a
+// pending probe.
+
+package jobframework
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+	workloadfinish "sigs.k8s.io/kueue/pkg/workload/finish"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// scaleUpProbeName returns the name part of a scale-up probe for predecessor prevWl. While
+// PartialPreemption is on, or prevWl carries a reclaim target, it is the predecessor's UID,
+// which no other slice shares: a reclaim lowers a slice chain's admitted level, so a later
+// probe can reach a level an earlier probe of the chain was named after. Otherwise it is
+// upstream's admitted level.
+func scaleUpProbeName(prefix string, admitted int32, prevWl *kueue.Workload) string {
+	if features.Enabled(features.PartialPreemption) || workload.IsPartiallyPreempted(prevWl) {
+		return fmt.Sprintf("%s-%s", prefix, prevWl.UID)
+	}
+	return fmt.Sprintf("%s-%d", prefix, admitted)
+}
+
+// afterReclaimMinCount caps a scale-up slice's minCount for podSet at the count its
+// predecessor prevWl runs after a partial preemption reclaim, so the slice may be admitted
+// with fewer pods than the predecessor was granted, as long as it grows past what it runs.
+func afterReclaimMinCount(prevWl *kueue.Workload, podSet kueue.PodSetReference, minCount int32) int32 {
+	if !workload.IsPartiallyPreempted(prevWl) {
+		return minCount
+	}
+	if running, found := workloadslicing.AfterReclaimBaseline(prevWl)[podSet]; found {
+		return min(minCount, running)
+	}
+	return minCount
+}
+
+// sliceToReconcile returns the admitted slice that the pending slice wl replaces while the job
+// is suspended or that admitted slice's reclaim target is pending, and wl otherwise. A suspended
+// job whose slice was admitted with fewer pods than it asks for then starts with that slice
+// instead of waiting, suspended and holding the quota, for its scale-up probe; and the job
+// reconciler stops the pods above a pending reclaim target on the slice that holds the quota.
+// Neither depends on PartialPreemption: a Workload admitted by an older release keeps a
+// minCount that allows a partial readmission, and a target outlives the gate being turned off.
+func sliceToReconcile(ctx context.Context, c client.Client, suspended bool, wl *kueue.Workload) (*kueue.Workload, error) {
+	if wl == nil || workload.HasQuotaReservation(wl) {
+		return wl, nil
+	}
+	key := workloadslicing.ReplacementForKey(wl)
+	if key == nil {
+		return wl, nil
+	}
+	namespace, name, found := strings.Cut(string(*key), "/")
+	if !found || namespace != wl.Namespace {
+		return wl, nil
+	}
+	replaced := &kueue.Workload{}
+	if err := c.Get(ctx, client.ObjectKey{Namespace: namespace, Name: name}, replaced); err != nil {
+		if apierrors.IsNotFound(err) {
+			return wl, nil
+		}
+		return nil, err
+	}
+	if !workload.IsAdmitted(replaced) || workloadevict.IsEvicted(replaced) || workloadfinish.IsFinished(replaced) {
+		return wl, nil
+	}
+	if !suspended && len(workload.PendingReclaimTargetCounts(replaced)) == 0 {
+		return wl, nil
+	}
+	return replaced, nil
+}
