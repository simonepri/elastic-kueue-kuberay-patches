+// Tests for the scheduler's part of regrowth after a partial preemption reclaim: the hold-back
+// of a replacement slice and the after-reclaim baseline of its partial admission.
+
+package scheduler
+
+import (
+	"testing"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/component-base/featuregate"
+	testingclock "k8s.io/utils/clock/testing"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	qcache "sigs.k8s.io/kueue/pkg/cache/queue"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/controller/core/indexer"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	preemptexpectations "sigs.k8s.io/kueue/pkg/scheduler/preemption/expectations"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption/policy"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// regrowFixture is a ClusterQueue "victim" with 8 CPUs holding an elastic slice of 8 one-CPU
+// workers, admitted in full, and a ClusterQueue "other" for the preemptor.
+type regrowFixture struct {
+	scheduler *Scheduler
+	snapshot  *schdcache.Snapshot
+	slice     *kueue.Workload
+	// recheck is the delay of the last recheck the scheduler armed.
+	recheck time.Duration
+}
+
+// newRegrowFixture builds the fixture at now with slice and objects in the API, and slice and
+// cached in the scheduler cache. It records the delay of the rechecks the scheduler arms.
+func newRegrowFixture(t *testing.T, now time.Time, slice *kueue.Workload, cached []client.Object, objects ...client.Object) *regrowFixture {
+	t.Helper()
+	ctx, log := utiltesting.ContextWithLog(t)
+	f := &regrowFixture{slice: slice}
+	previous := afterFunc
+	afterFunc = func(d time.Duration, fn func()) *time.Timer {
+		f.recheck = d
+		return time.AfterFunc(time.Hour, fn)
+	}
+	t.Cleanup(func() { afterFunc = previous })
+	clientBuilder := utiltesting.NewClientBuilder().
+		WithObjects(append([]client.Object{utiltesting.MakeNamespace("default"), slice}, objects...)...).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithStatusSubresource(&kueue.Workload{})
+	cl := clientBuilder.Build()
+	cqCache := schdcache.New(cl)
+	cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	for _, cq := range []*kueue.ClusterQueue{
+		utiltestingapi.MakeClusterQueue("victim").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "8").Obj()).Obj(),
+		utiltestingapi.MakeClusterQueue("other").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "8").Obj()).Obj(),
+	} {
+		if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, obj := range append([]client.Object{slice}, cached...) {
+		if wl, ok := obj.(*kueue.Workload); ok && workload.HasQuotaReservation(wl) {
+			cqCache.AddOrUpdateWorkload(ctx, log, wl)
+		}
+	}
+	fakeClock := testingclock.NewFakeClock(now)
+	qManager := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithClock(fakeClock))
+	scheduler := New(qManager, cqCache, cl, &utiltesting.EventRecorder{}, WithClock(t, fakeClock), WithPreemptionExpectations(preemptexpectations.New()))
+	snapshot, err := cqCache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.scheduler, f.snapshot = scheduler, snapshot
+	return f
+}
+
+// probe returns the scheduling entry of a pending probe of 8 workers that replaces f.slice.
+func (f *regrowFixture) probe(t *testing.T, minCount int32) *entry {
+	t.Helper()
+	_, log := utiltesting.ContextWithLog(t)
+	wl := utiltestingapi.MakeWorkload("probe", "default").
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Annotation(workloadslicing.WorkloadSliceReplacementFor, string(workload.Key(f.slice))).
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(minCount).Request(corev1.ResourceCPU, "1").Obj()).
+		Obj()
+	info := workload.NewInfo(log, wl)
+	info.ClusterQueue = "victim"
+	return &entry{Head: qcache.Head{Info: *info}}
+}
+
+// shrunkSlice returns the victim's slice with a reclaim target of 4 workers, requested at
+// requestedAt by preemptor, and reclaimable reclaimable workers.
+func shrunkSlice(now time.Time, preemptor string, requestedAt time.Time, reclaimable int32) *kueue.Workload {
+	wl := utiltestingapi.MakeWorkload("slice", "default").
+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("victim").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(8).Assignment(corev1.ResourceCPU, "default", "8").Obj()).Obj(), now).
+		AdmittedAt(true, now).
+		Annotation(constants.ReclaimTargetCountsAnnotation, "workers=4")
+	if preemptor != "" {
+		wl.Annotation(constants.ReclaimPreemptorAnnotation, preemptor).
+			Annotation(constants.ReclaimRequestedAtAnnotation, requestedAt.UTC().Format(time.RFC3339))
+	}
+	if reclaimable > 0 {
+		wl.ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: reclaimable})
+	}
+	return wl.Obj()
+}
+
+func TestHoldBackRegrowth(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	requested := now.Add(-time.Minute)
+	preemptor := func() *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload("preemptor", "default").
+			PodSets(*utiltestingapi.MakePodSet("main", 4).Request(corev1.ResourceCPU, "1").Obj())
+	}
+	// reserved is the preemptor holding quota in cq; the cache loads it only for a known cq.
+	reserved := func(cq kueue.ClusterQueueReference) *utiltestingapi.WorkloadWrapper {
+		return preemptor().ReserveQuotaAt(utiltestingapi.MakeAdmission(cq).PodSets(
+			utiltestingapi.MakePodSetAssignment("main").Count(4).Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), now)
+	}
+	// evicted is a pending preemptor whose Evicted condition last changed at t.
+	evicted := func(t time.Time, status metav1.ConditionStatus, reason string) client.Object {
+		return preemptor().Condition(metav1.Condition{
+			Type: kueue.WorkloadEvicted, Status: status, Reason: reason,
+			LastTransitionTime: metav1.NewTime(t),
+		}).Obj()
+	}
+	evictedAt := func(t time.Time) client.Object {
+		return evicted(t, metav1.ConditionTrue, kueue.WorkloadEvictedByPreemption)
+	}
+	released := func(requestedAt time.Time) *kueue.Workload {
+		return shrunkSlice(now, "default/preemptor", requestedAt, 4)
+	}
+	cases := map[string]struct {
+		gate    bool
+		slice   *kueue.Workload
+		objects []client.Object
+		// cached are the objects the scheduler cache holds besides the slice.
+		cached      []client.Object
+		want        bool
+		wantRecheck time.Duration
+	}{
+		"a pending reclaim target holds the probe back": {
+			gate: true, slice: shrunkSlice(now, "", now, 0), want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"with the gate off a pending reclaim target written before still holds the probe back": {
+			slice: shrunkSlice(now, "", now, 0), want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"a pending preemptor holds the probe back after the release": {
+			gate: true, slice: released(requested), objects: []client.Object{preemptor().Obj()}, want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"with the gate off a pending preemptor recorded before still holds the probe back": {
+			slice: released(requested), objects: []client.Object{preemptor().Obj()}, want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"the recheck of a hold about to time out fires at the timeout": {
+			gate: true, slice: released(now.Add(-policy.ReclaimTimeout + 2*time.Second)), objects: []client.Object{preemptor().Obj()},
+			want: true, wantRecheck: 2 * time.Second,
+		},
+		"a hold ends when the reclaim request is as old as the reclaim timeout": {
+			gate: true, slice: released(now.Add(-policy.ReclaimTimeout)), objects: []client.Object{preemptor().Obj()},
+		},
+		"a preemptor without a recorded request time does not hold the probe back": {
+			gate: true, slice: func() *kueue.Workload {
+				wl := released(requested)
+				delete(wl.Annotations, constants.ReclaimRequestedAtAnnotation)
+				return wl
+			}(), objects: []client.Object{preemptor().Obj()},
+		},
+		"a preemptor holding quota in the cache releases the probe": {
+			gate: true, slice: released(requested), objects: []client.Object{reserved("other").Obj()}, cached: []client.Object{reserved("other").Obj()},
+		},
+		"a preemptor holding quota in the API only releases the probe": {
+			gate: true, slice: released(requested), objects: []client.Object{reserved("not-in-cache").Obj()},
+		},
+		"a preemptor evicted after the request went back to pending and releases the probe": {
+			gate: true, slice: released(requested), objects: []client.Object{evictedAt(requested.Add(time.Second))},
+		},
+		"a preemptor deactivated and reactivated after the request still holds the probe back": {
+			gate: true, slice: released(requested), objects: []client.Object{evicted(requested.Add(time.Second), metav1.ConditionTrue, kueue.WorkloadDeactivated)},
+			want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"a preemptor whose eviction ended after the request still holds the probe back": {
+			gate: true, slice: released(requested), objects: []client.Object{evicted(requested.Add(time.Second), metav1.ConditionFalse, kueue.WorkloadEvictedByPreemption)},
+			want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"a preemptor evicted before the request still holds the probe back": {
+			gate: true, slice: released(requested), objects: []client.Object{evictedAt(requested.Add(-time.Second))}, want: true, wantRecheck: regrowthHoldRecheck,
+		},
+		"an inactive preemptor releases the probe": {
+			gate: true, slice: released(requested), objects: []client.Object{preemptor().Active(false).Obj()},
+		},
+		"a finished preemptor releases the probe": {
+			gate: true, slice: released(requested), objects: []client.Object{preemptor().Finished().Obj()},
+		},
+		"a deleted preemptor releases the probe": {
+			gate: true, slice: released(requested),
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlices: true,
+				features.PartialPreemption:            tc.gate,
+			})
+			ctx, log := utiltesting.ContextWithLog(t)
+			f := newRegrowFixture(t, now, tc.slice, tc.cached, tc.objects...)
+			e := f.probe(t, 4)
+			got, nominated := f.scheduler.nominateWorkload(ctx, log, e.Head, f.snapshot)
+			if held := got.requeueReason == qcache.RequeueReasonRegrowthHeld; held != tc.want || held == nominated {
+				t.Fatalf("nominateWorkload() nominated = %v, requeueReason = %q, want held = %v", nominated, got.requeueReason, tc.want)
+			}
+			f.scheduler.regrowth.mu.Lock()
+			defer f.scheduler.regrowth.mu.Unlock()
+			if got := f.scheduler.regrowth.held.Has(workload.Key(e.Obj)); got != tc.want {
+				t.Errorf("held slice recorded for a retry = %v, want %v", got, tc.want)
+			}
+			if timer, armed := f.scheduler.regrowth.rechecks[workload.Key(e.Obj)]; armed != tc.want {
+				t.Errorf("recheck armed = %v, want %v", armed, tc.want)
+			} else if armed {
+				timer.Stop()
+				if f.recheck != tc.wantRecheck {
+					t.Errorf("recheck after %v, want %v", f.recheck, tc.wantRecheck)
+				}
+			}
+		})
+	}
+}
+
+func TestRegrowthStartsFromTheAfterReclaimCount(t *testing.T) {
+	now := time.Now()
+	for name, tc := range map[string]struct {
+		gate      bool
+		wantFit   bool
+		wantCount int32
+	}{
+		"the probe grows past what the shrunk slice runs": {
+			gate: true, wantFit: true, wantCount: 5,
+		},
+		"with the gate off a slice shrunk before still regrows from what it runs": {
+			wantFit: true, wantCount: 5,
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlices:                          true,
+				features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+				features.PartialPreemption:                                     tc.gate,
+			})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			// The shrunk slice is charged 4 CPUs; another workload takes 3, so the probe
+			// that replaces the slice has 5 CPUs.
+			other := utiltestingapi.MakeWorkload("other", "default").
+				PodSets(*utiltestingapi.MakePodSet("main", 3).Request(corev1.ResourceCPU, "1").Obj()).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("victim").PodSets(
+					utiltestingapi.MakePodSetAssignment("main").Count(3).Assignment(corev1.ResourceCPU, "default", "3").Obj()).Obj(), now).
+				Obj()
+			f := newRegrowFixture(t, now, shrunkSlice(now, "", now, 4), []client.Object{other}, other)
+			e := f.probe(t, 4)
+
+			assignment, _ := f.scheduler.getAssignments(ctx, &e.Info, f.snapshot)
+			if got := assignment.RepresentativeMode() == flavorassigner.Fit; got != tc.wantFit {
+				t.Errorf("getAssignments() fits = %v (mode %v), want %v", got, assignment.RepresentativeMode(), tc.wantFit)
+			}
+			if got := assignment.PodSets[0].Count; got != tc.wantCount {
+				t.Errorf("getAssignments() count = %d, want %d", got, tc.wantCount)
+			}
+		})
+	}
+}
