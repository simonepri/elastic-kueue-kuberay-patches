+
+// Tests for sliceToReconcile, which picks the admitted slice that a pending scale-up probe
+// replaces while the job is suspended or that slice's reclaim target is pending.
+
+package jobframework
+
+import (
+	"testing"
+	"time"
+
+	corev1 "k8s.io/api/core/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+func TestSliceToReconcile(t *testing.T) {
+	now := time.Now()
+	slice := func() *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload("slice", "ns").
+			PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(4).Request(corev1.ResourceCPU, "1").Obj())
+	}
+	admitted := slice().
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(6).Assignment(corev1.ResourceCPU, "default", "6").Obj()).Obj(), now).
+		AdmittedAt(true, now).Obj()
+	probe := utiltestingapi.MakeWorkload("probe", "ns").
+		Annotation(workloadslicing.WorkloadSliceReplacementFor, string(workload.Key(admitted))).
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(4).Request(corev1.ResourceCPU, "1").Obj()).
+		Obj()
+
+	// upgraded is a slice admitted by an older release, whose worker group kept
+	// minCount = minReplicas, readmitted after an eviction with 6 of its 8 workers.
+	upgraded := utiltestingapi.MakeWorkload("slice", "ns").
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(2).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(6).Assignment(corev1.ResourceCPU, "default", "6").Obj()).Obj(), now).
+		AdmittedAt(true, now).Obj()
+
+	// withTarget returns wl with a reclaim target of 4 workers and reclaimable workers released.
+	withTarget := func(wl *kueue.Workload, reclaimable int32) *kueue.Workload {
+		wl = wl.DeepCopy()
+		workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{"workers": 4})
+		if reclaimable > 0 {
+			wl.Status.ReclaimablePods = []kueue.ReclaimablePod{{Name: "workers", Count: reclaimable}}
+		}
+		return wl
+	}
+	cases := map[string]struct {
+		gate      bool
+		suspended bool
+		replaced  *kueue.Workload
+		want      string
+	}{
+		"a suspended job starts with the admitted slice its probe replaces": {
+			gate: true, suspended: true, replaced: admitted, want: "slice",
+		},
+		"a running job keeps the probe": {
+			gate: true, replaced: admitted, want: "probe",
+		},
+		"a running job acts on the admitted slice while its reclaim target is pending": {
+			gate: true, replaced: withTarget(admitted, 0), want: "slice",
+		},
+		"a running job keeps the probe once the reclaim target is released": {
+			gate: true, replaced: withTarget(admitted, 4), want: "probe",
+		},
+		"with the gate off a running job acts on the admitted slice while a target written before is pending": {
+			replaced: withTarget(admitted, 0), want: "slice",
+		},
+		"with the gate off a running job keeps the probe": {
+			replaced: admitted, want: "probe",
+		},
+		"a slice that is only pending is not started": {
+			gate: true, suspended: true, replaced: slice().Obj(), want: "probe",
+		},
+		"an evicted slice is not started": {
+			gate: true, suspended: true, replaced: slice().
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+					utiltestingapi.MakePodSetAssignment("workers").Count(6).Obj()).Obj(), now).
+				AdmittedAt(true, now).EvictedAt(now).Obj(),
+			want: "probe",
+		},
+		"a missing slice leaves the probe": {
+			gate: true, suspended: true, want: "probe",
+		},
+		"with the gate off a suspended job starts with the admitted slice its probe replaces": {
+			suspended: true, replaced: admitted, want: "slice",
+		},
+		"with the gate off a suspended job starts with an upgraded slice readmitted below its count": {
+			suspended: true, replaced: upgraded, want: "slice",
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, tc.gate)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			builder := utiltesting.NewClientBuilder()
+			if tc.replaced != nil {
+				builder = builder.WithObjects(tc.replaced.DeepCopy())
+			}
+			got, err := sliceToReconcile(ctx, builder.Build(), tc.suspended, probe.DeepCopy())
+			if err != nil {
+				t.Fatalf("sliceToReconcile() error: %v", err)
+			}
+			if got.Name != tc.want {
+				t.Errorf("sliceToReconcile() = %s, want %s", got.Name, tc.want)
+			}
+		})
+	}
+}
