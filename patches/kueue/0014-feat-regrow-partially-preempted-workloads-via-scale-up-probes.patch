+// Envtest specs for regrowth after a partial preemption reclaim of an elastic RayCluster:
+// the scale-up probe after the release, the preemptor hold-back, probe names, and scale-downs.
+
+package raycluster
+
+import (
+	"fmt"
+	"slices"
+	"time"
+
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	corev1 "k8s.io/api/core/v1"
