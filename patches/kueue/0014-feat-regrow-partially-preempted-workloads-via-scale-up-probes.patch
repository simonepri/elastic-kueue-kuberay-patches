+	"sigs.k8s.io/kueue/pkg/features"
+	utiltesting "sigs.k8s.io/kueue/pkg/util/testing"
+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadfinish "sigs.k8s.io/kueue/pkg/workload/finish"
+)
+
+func TestEnsureWorkloadSlicesRegrowAfterReclaim(t *testing.T) {
+	partialJob := &batchv1.Job{ObjectMeta: metav1.ObjectMeta{
+		Name:        "partial",
+		Namespace:   "default",
+		UID:         uuid.NewUUID(),
+		Annotations: map[string]string{constants.ElasticJobScaleUpStrategyAnnotationKey: constants.ElasticJobScaleUpStrategyPartial},
+	}}
+	atomicJob := partialJob.DeepCopy()
+	atomicJob.Annotations = nil
+
+	// admitted is a slice of the job with 8 workers, granted workers admitted, a reclaim
+	// target of target workers when target is set, and reclaimable reclaimable workers.
+	admitted := func(job *batchv1.Job, granted, target, reclaimable int32) *kueue.Workload {
+		now := time.Now()
+		wl := utiltestingapi.MakeWorkload("slice", job.Namespace).
+			OwnerReference(testJobGVK, job.Name, string(job.UID)).
+			Creation(now).
+			PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(8).Request(corev1.ResourceCPU, "1").Obj()).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+				utiltestingapi.MakePodSetAssignment("workers").Count(granted).Assignment(corev1.ResourceCPU, "default", "1").Obj()).Obj(), now).
+			AdmittedAt(true, now)
+		if target > 0 {
+			wl.Annotation(constants.ReclaimTargetCountsAnnotation, workload.FormatPodSetCounts(workload.PodSetsCounts{"workers": target})).
+				Annotation(constants.ReclaimPreemptorAnnotation, "default/preemptor")
+		}
+		if reclaimable > 0 {
+			wl.ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: reclaimable})
+		}
+		return wl.Obj()
+	}
+
+	cases := map[string]struct {
+		job      *batchv1.Job
+		slice    *kueue.Workload
+		jobCount int32
+		gate     bool
+		// wantProbe is true when EnsureWorkloadSlices asks for a new slice; otherwise it
+		// returns the slice with wantCount workers.
+		wantProbe bool
+		wantCount int32
+	}{
+		"released target regrows to the job's count": {
+			job: partialJob, slice: admitted(partialJob, 8, 4, 4), jobCount: 8, gate: true,
+			wantProbe: true,
+		},
+		"released target written before the gate was turned off still regrows": {
+			job: partialJob, slice: admitted(partialJob, 8, 4, 4), jobCount: 8,
+			wantProbe: true,
+		},
+		"slice that was never shrunk keeps upstream behavior with the gate off": {
+			job: partialJob, slice: admitted(partialJob, 8, 0, 0), jobCount: 8,
+			wantCount: 8,
+		},
+		"pending target waits for the release": {
+			job: partialJob, slice: admitted(partialJob, 8, 4, 0), jobCount: 8, gate: true,
+			wantCount: 8,
+		},
+		"atomic scale-up does not regrow": {
+			job: atomicJob, slice: admitted(atomicJob, 8, 4, 4), jobCount: 8, gate: true,
+			wantCount: 8,
+		},
+		"job above the target regrows although below the slice's count": {
+			job: partialJob, slice: admitted(partialJob, 6, 4, 4), jobCount: 6, gate: true,
+			wantProbe: true,
+		},
+		"job above the target regrows with the gate off": {
+			job: partialJob, slice: admitted(partialJob, 6, 4, 4), jobCount: 6,
+			wantProbe: true,
+		},
+		"job at the target scales the slice down in place": {
+			job: partialJob, slice: admitted(partialJob, 8, 4, 4), jobCount: 4, gate: true,
+			wantCount: 4,
+		},
+		"slice that was never shrunk keeps upstream behavior": {
+			job: partialJob, slice: admitted(partialJob, 8, 0, 0), jobCount: 8, gate: true,
+			wantCount: 8,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+				features.PartialPreemption:                                     tc.gate,
+			})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			clnt := testWorkloadClientBuilder().WithObjects(tc.slice).Build()
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(time.Now())}
+			jobPodSets := []kueue.PodSet{*utiltestingapi.MakePodSet("workers", int(tc.jobCount)).Request(corev1.ResourceCPU, "1").Obj()}
+
+			got, compatible, err := manager.EnsureWorkloadSlices(ctx, jobPodSets, tc.job, testJobGVK)
+			if err != nil || !compatible {
+				t.Fatalf("EnsureWorkloadSlices() compatible = %v, error = %v", compatible, err)
+			}
+			if tc.wantProbe {
+				if got != nil {
+					t.Fatalf("EnsureWorkloadSlices() = %s, want a new slice", got.Name)
+				}
+				return
+			}
+			if got == nil {
+				t.Fatal("EnsureWorkloadSlices() asked for a new slice, want the existing one")
+			}
+			if gotCount := got.Spec.PodSets[0].Count; gotCount != tc.wantCount {
+				t.Errorf("EnsureWorkloadSlices() count = %d, want %d", gotCount, tc.wantCount)
+			}
+		})
+	}
+}
+
+func TestEnsureWorkloadSlicesScaleDownDuringPendingProbe(t *testing.T) {
+	now := time.Now()
+	slice := utiltestingapi.MakeWorkload("slice", testJobObject.Namespace).
+		OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+		Creation(now.Add(-time.Minute)).
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(4).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(6).Assignment(corev1.ResourceCPU, "default", "6").Obj()).Obj(), now).
+		AdmittedAt(true, now).
+		Obj()
+	probe := utiltestingapi.MakeWorkload("probe", testJobObject.Namespace).
+		OwnerReference(testJobGVK, testJobObject.Name, string(testJobObject.UID)).
+		Creation(now).
+		Annotation(WorkloadSliceReplacementFor, string(workload.Key(slice))).
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(4).Request(corev1.ResourceCPU, "1").Obj()).
+		Obj()
+
+	partialJobObject := testJobObject.DeepCopy()
+	partialJobObject.Annotations = map[string]string{
+		constants.ElasticJobScaleUpStrategyAnnotationKey: constants.ElasticJobScaleUpStrategyPartial,
+	}
+	reclaimedSlice := utiltestingapi.MakeWorkload("reclaimed-slice", testJobObject.Namespace).
+		OwnerReference(testJobGVK, partialJobObject.Name, string(partialJobObject.UID)).
+		Creation(now.Add(-time.Minute)).
+		Annotation(constants.ReclaimTargetCountsAnnotation, "workers=4").
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(4).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("workers").Count(6).Assignment(corev1.ResourceCPU, "default", "6").Obj()).Obj(), now).
+		ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: 4}).
+		AdmittedAt(true, now).
+		Obj()
+	reclaimedProbe := utiltestingapi.MakeWorkload("reclaimed-probe", testJobObject.Namespace).
+		OwnerReference(testJobGVK, partialJobObject.Name, string(partialJobObject.UID)).
+		Creation(now).
+		Annotation(WorkloadSliceReplacementFor, string(workload.Key(reclaimedSlice))).
+		PodSets(*utiltestingapi.MakePodSet("workers", 8).SetMinimumCount(4).Request(corev1.ResourceCPU, "1").Obj()).
+		Obj()
+
+	cases := map[string]struct {
+		gate      bool
+		reclaimed bool
+		jobCount  int32
+		want      string
+		wantCount int32
+		// wantSliceCount and wantProbeFinished describe the stored slices afterwards.
+		wantSliceCount    int32
+		wantProbeCount    int32
+		wantProbeFinished bool
+	}{
+		"scale-down below the granted count lowers the admitted slice and drops the probe": {
+			gate: true, jobCount: 5,
+			want: "slice", wantCount: 5, wantSliceCount: 5, wantProbeCount: 8, wantProbeFinished: true,
+		},
+		"scale-down to the granted count drops the probe": {
+			gate: true, jobCount: 6,
+			want: "slice", wantCount: 6, wantSliceCount: 6, wantProbeCount: 8, wantProbeFinished: true,
+		},
+		"scale-down that still grows past the granted count updates the probe": {
+			gate: true, jobCount: 7,
+			want: "probe", wantCount: 7, wantSliceCount: 8, wantProbeCount: 7,
+		},
+		"scale-down updates the probe with the gate off": {
+			jobCount: 5,
+			want:     "probe", wantCount: 5, wantSliceCount: 8, wantProbeCount: 5,
+		},
+		"partially preempted scale-down above admitted count updates the probe": {
+			gate: true, reclaimed: true, jobCount: 7,
+			want: "reclaimed-probe", wantCount: 7, wantSliceCount: 8, wantProbeCount: 7,
+		},
+		"partially preempted scale-down between target and admitted count updates the probe": {
+			gate: true, reclaimed: true, jobCount: 6,
+			want: "reclaimed-probe", wantCount: 6, wantSliceCount: 8, wantProbeCount: 6,
+		},
+		"partially preempted scale-down to target drops the probe and lowers slice": {
+			gate: true, reclaimed: true, jobCount: 4,
+			want: "reclaimed-slice", wantCount: 4, wantSliceCount: 4, wantProbeCount: 8, wantProbeFinished: true,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+				features.PartialPreemption:                                     tc.gate,
+			})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			activeSlice := slice
+			activeProbe := probe
+			jobObj := testJobObject
+			if tc.reclaimed {
+				activeSlice = reclaimedSlice
+				activeProbe = reclaimedProbe
+				jobObj = partialJobObject
+			}
+			clnt := testWorkloadClientBuilder().WithObjects(activeSlice.DeepCopy(), activeProbe.DeepCopy()).Build()
+			manager := Manager{Client: clnt, Clock: testingclock.NewFakeClock(now)}
+			jobPodSets := []kueue.PodSet{*utiltestingapi.MakePodSet("workers", int(tc.jobCount)).Request(corev1.ResourceCPU, "1").Obj()}
+
+			got, compatible, err := manager.EnsureWorkloadSlices(ctx, jobPodSets, jobObj, testJobGVK)
+			if err != nil || !compatible || got == nil {
+				t.Fatalf("EnsureWorkloadSlices() = %v, compatible = %v, error = %v", got, compatible, err)
+			}
+			if got.Name != tc.want || got.Spec.PodSets[0].Count != tc.wantCount {
+				t.Errorf("EnsureWorkloadSlices() = %s with %d workers, want %s with %d", got.Name, got.Spec.PodSets[0].Count, tc.want, tc.wantCount)
+			}
+			var gotSlice, gotProbe kueue.Workload
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(activeSlice), &gotSlice); err != nil {
+				t.Fatal(err)
+			}
+			if err := clnt.Get(ctx, client.ObjectKeyFromObject(activeProbe), &gotProbe); err != nil {
+				t.Fatal(err)
+			}
+			gotCounts := []int32{gotSlice.Spec.PodSets[0].Count, gotProbe.Spec.PodSets[0].Count}
+			if diff := cmp.Diff([]int32{tc.wantSliceCount, tc.wantProbeCount}, gotCounts); diff != "" {
+				t.Errorf("Stored slice and probe counts (-want,+got):\n%s", diff)
+			}
+			if got := workloadfinish.IsFinished(&gotProbe); got != tc.wantProbeFinished {
+				t.Errorf("Probe finished = %v, want %v", got, tc.wantProbeFinished)
+			}
+		})
+	}
+}
+
+func TestAfterReclaimBaseline(t *testing.T) {
+	now := time.Now()
+	wl := utiltestingapi.MakeWorkload("slice", "default").
+		PodSets(
+			*utiltestingapi.MakePodSet("head", 1).Request(corev1.ResourceCPU, "1").Obj(),
+			*utiltestingapi.MakePodSet("workers", 8).Request(corev1.ResourceCPU, "1").Obj(),
+		).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("head").Count(1).Obj(),
+			utiltestingapi.MakePodSetAssignment("workers").Count(6).Obj()).Obj(), now).
+		ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: 4})
+	cases := map[string]struct {
+		gate     bool
+		reclaim  bool
+		expected workload.PodSetsCounts
+	}{
+		"partially preempted slice starts from what it runs": {
+			gate: true, reclaim: true,
+			expected: workload.PodSetsCounts{"head": 1, "workers": 4},
+		},
+		"a slice shrunk before the gate was turned off starts from what it runs": {
+			reclaim:  true,
+			expected: workload.PodSetsCounts{"head": 1, "workers": 4},
+		},
+		"gate off without a reclaim target starts from the grant": {
+			expected: workload.PodSetsCounts{"head": 1, "workers": 6},
+		},
+		"reclaimable pods without a reclaim target start from the grant": {
+			gate:     true,
+			expected: workload.PodSetsCounts{"head": 1, "workers": 6},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PartialPreemption, tc.gate)
+			obj := wl.Clone().Obj()
+			if tc.reclaim {
+				workload.SetReclaimTargetCounts(obj, workload.PodSetsCounts{"workers": 4})
+			}
+			if diff := cmp.Diff(tc.expected, AfterReclaimBaseline(obj)); diff != "" {
+				t.Errorf("AfterReclaimBaseline() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
