+// Tests for regrowth after a partial preemption reclaim in EnsureWorkloadSlices: when a probe
+// is needed, which pending probe a scale-down drops, and the after-reclaim baseline.
+
+package workloadslicing
+
+import (
+	"testing"
+	"time"
+
+	"github.com/google/go-cmp/cmp"
+	batchv1 "k8s.io/api/batch/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
