+
+// Regrowth of an elastic job after a partial preemption reclaim: when a slice
+// needs a scale-up probe, which pending probe a scale-down drops, and the after-reclaim baseline.
+
+package workloadslicing
+
+import (
+	"context"
+	"slices"
+
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+	workloadfinish "sigs.k8s.io/kueue/pkg/workload/finish"
+)
+
+// regrowsAfterReclaim reports whether the admitted slice wl needs a scale-up probe because
+// partial preemption released its quota down to a reclaim target that the job still exceeds.
+// It compares the job's count with the target, not with the slice's spec count, which a
+// scale-down after the reclaim may leave above the job's count. Only jobs that take the
+// partial scale-up path regrow, since only their probes may be admitted below the full count.
+// It follows the reclaim target rather than the PartialPreemption gate, so a slice shrunk
+// before the gate was turned off still regrows.
+func regrowsAfterReclaim(jobObject client.Object, wl *kueue.Workload, jobCounts workload.PodSetsCounts) bool {
+	if !partialScaleUpEnabled(jobObject) ||
+		!workload.IsAdmitted(wl) || workloadevict.IsEvicted(wl) {
+		return false
+	}
+	targets := workload.ReclaimTargetCounts(wl)
+	if len(targets) == 0 || len(workload.PendingReclaimTargetCounts(wl)) > 0 {
+		return false
+	}
+	for name, target := range targets {
+		if count, found := jobCounts[name]; found && count > target {
+			return true
+		}
+	}
+	return false
+}
+
+func partialScaleUpEnabled(jobObject client.Object) bool {
+	return features.Enabled(features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp) &&
+		jobObject.GetAnnotations()[constants.ElasticJobScaleUpStrategyAnnotationKey] == constants.ElasticJobScaleUpStrategyPartial
+}
+
+// dropProbeAfterScaleDown finishes the pending replacement selected for the job when the job
+// no longer asks for more pods than the admitted slice it replaces runs, and returns that
+// admitted slice, so the scale-down lowers the slice holding the quota instead of a probe that
+// can never grow past it. Otherwise it returns selected unchanged. With PartialPreemption off,
+// it acts only on a slice that partial preemption shrank before the gate was turned off.
+func (r *Manager) dropProbeAfterScaleDown(ctx context.Context, workloads []kueue.Workload, selected *kueue.Workload, jobObject client.Object, jobCounts workload.PodSetsCounts) (*kueue.Workload, error) {
+	if workload.HasQuotaReservation(selected) {
+		return selected, nil
+	}
+	replaced := admittedPredecessor(workloads, selected)
+	if replaced == nil || !features.Enabled(features.PartialPreemption) && !workload.IsPartiallyPreempted(replaced) ||
+		growsPast(jobObject, jobCounts, replaced) {
+		return selected, nil
+	}
+	ctrl.LoggerFrom(ctx).V(2).Info("Finishing the pending workload slice after a scale-down",
+		"workload", workload.Key(selected), "replaced", workload.Key(replaced))
+	if err := workloadfinish.Finish(ctx, r.Client, selected, kueue.WorkloadFinishedReasonOutOfSync,
+		"The job scaled down to at most the replaced workload slice's admitted count", r.Clock); err != nil {
+		return nil, err
+	}
+	return replaced, nil
+}
+
+// growsPast reports whether the job asks for more pods in some PodSet than wl runs after reclaim.
+func growsPast(jobObject client.Object, jobCounts workload.PodSetsCounts, wl *kueue.Workload) bool {
+	var running workload.PodSetsCounts
+	if partialScaleUpEnabled(jobObject) {
+		running = AfterReclaimBaseline(wl)
+	} else {
+		running = workload.ExtractGrantedPodSetCounts(wl)
+	}
+	for name, count := range jobCounts {
+		if granted, found := running[name]; found && count > granted {
+			return true
+		}
+	}
+	return false
+}
+
+// admittedPredecessor returns the admitted, not evicted slice among workloads that wl replaces.
+func admittedPredecessor(workloads []kueue.Workload, wl *kueue.Workload) *kueue.Workload {
+	key := ReplacementForKey(wl)
+	if key == nil {
+		return nil
+	}
+	i := slices.IndexFunc(workloads, func(candidate kueue.Workload) bool {
+		return workload.Key(&candidate) == *key
+	})
+	if i < 0 || !workload.IsAdmitted(&workloads[i]) || workloadevict.IsEvicted(&workloads[i]) {
+		return nil
+	}
+	return &workloads[i]
+}
+
+// AfterReclaimBaseline returns the counts a scale-up of wl must start from: what wl runs once
+// partial preemption released its quota, when it carries a reclaim target, and its granted
+// counts otherwise, as upstream.
+func AfterReclaimBaseline(wl *kueue.Workload) workload.PodSetsCounts {
+	if workload.IsPartiallyPreempted(wl) {
+		return workload.ExtractGrantedPodSetCountsAfterReclaim(wl)
+	}
+	return workload.ExtractGrantedPodSetCounts(wl)
+}
