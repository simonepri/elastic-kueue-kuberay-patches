+)
+
+func TestConstructWorkloadAfterReclaim(t *testing.T) {
+	gvk := batchv1.SchemeGroupVersion.WithKind("Job")
+	now := time.Now()
+	job := testingjob.MakeJob("job", "ns").
+		SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		SetAnnotation(kueueconstants.ElasticJobScaleUpStrategyAnnotationKey, kueueconstants.ElasticJobScaleUpStrategyPartial).
+		Queue("lq").
+		UID("job-uid").
+		Obj()
+	// predecessor is a slice of 8 workers, admitted with granted of them, that partial
+	// preemption shrank to 4 and released.
+	// unshrunk is such a slice that partial preemption never shrank.
+	unshrunk := func(name string, uid types.UID, granted int32) *kueue.Workload {
+		return utiltestingapi.MakeWorkload(name, "ns").
+			UID(uid).
+			PodSets(kueue.PodSet{Name: "workers", Count: 8, MinCount: new(int32(6))}).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+				utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "default", "1").Count(granted).Obj()).Obj(), now).
+			ControllerReference(gvk, "job", "job-uid").
+			Obj()
+	}
+	predecessor := func(name string, uid types.UID, granted int32) *kueue.Workload {
+		wl := utiltestingapi.MakeWorkload(name, "ns").
+			UID(uid).
+			PodSets(kueue.PodSet{Name: "workers", Count: 8, MinCount: new(int32(6))}).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+				utiltestingapi.MakePodSetAssignment("workers").Assignment(corev1.ResourceCPU, "default", "1").Count(granted).Obj()).Obj(), now).
+			ReclaimablePods(kueue.ReclaimablePod{Name: "workers", Count: 4}).
+			ControllerReference(gvk, "job", "job-uid").
+			Obj()
+		workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{"workers": 4})
+		return wl
+	}
+
+	cases := map[string]struct {
+		gate         bool
+		predecessor  *kueue.Workload
+		wantExtra    string
+		wantMinCount int32
+	}{
+		"the probe is named after the predecessor's UID and starts from what it runs": {
+			gate:         true,
+			predecessor:  predecessor("first", "first-uid", 8),
+			wantExtra:    "0-scale-up-probe-first-uid",
+			wantMinCount: 4,
+		},
+		"a predecessor at the same admitted level gets a different probe name": {
+			gate:         true,
+			predecessor:  predecessor("second", "second-uid", 8),
+			wantExtra:    "0-scale-up-probe-second-uid",
+			wantMinCount: 4,
+		},
+		"with the gate off the probe of an unshrunk slice is named after the admitted level and keeps its floor": {
+			predecessor:  unshrunk("first", "first-uid", 8),
+			wantExtra:    "0-scale-up-probe-8",
+			wantMinCount: 6,
+		},
+		"with the gate off two unshrunk predecessors at the same admitted level give the probe one name": {
+			predecessor:  unshrunk("second", "second-uid", 8),
+			wantExtra:    "0-scale-up-probe-8",
+			wantMinCount: 6,
+		},
+		"with the gate off the probe of a slice shrunk before is named after its UID and starts from what it runs": {
+			predecessor:  predecessor("first", "first-uid", 8),
+			wantExtra:    "0-scale-up-probe-first-uid",
+			wantMinCount: 4,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlices:                          true,
+				features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+				features.PartialPreemption:                                     tc.gate,
+			})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			mockctrl := gomock.NewController(t)
+			mgj := mocks.NewMockGenericJob(mockctrl)
+			mgj.EXPECT().Object().Return(job).AnyTimes()
+			mgj.EXPECT().GVK().Return(gvk).AnyTimes()
+			mgj.EXPECT().PodSets(gomock.Any(), gomock.Any()).Return([]kueue.PodSet{{Name: "workers", Count: 8, MinCount: new(int32(8))}}, nil).AnyTimes()
+			cl := utiltesting.NewClientBuilder().
+				WithObjects([]client.Object{&corev1.Namespace{Name: "ns"}, job, tc.predecessor}...).
+				WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(gvk), indexer.WorkloadOwnerIndexFunc(gvk)).
+				Build()
+
+			wl, err := ConstructWorkload(ctx, cl, mgj, nil, nil)
+			if err != nil {
+				t.Fatalf("ConstructWorkload() error: %v", err)
+			}
+			if want := GenerateWorkloadNameWithExtra(job.GetName(), job.GetUID(), gvk, tc.wantExtra); wl.Name != want {
+				t.Errorf("ConstructWorkload() name = %q, want %q", wl.Name, want)
