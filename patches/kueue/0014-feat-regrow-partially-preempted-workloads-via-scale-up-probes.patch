+// regrowthRecheck is how often the scheduler requeues a held slice.
+const regrowthRecheck = 5 * time.Second
+
+// regrowAfterReclaimSpecs registers the specs of both gate settings. A spec writes the
+// reclaim target that it would write; it also writes the reclaimable pods once no worker
+// runs above the target.
+func regrowAfterReclaimSpecs(partialPreemption bool) {
+	var (
+		ns           *corev1.Namespace
+		flavor       *kueue.ResourceFlavor
+		clusterQueue *kueue.ClusterQueue
+		localQueue   *kueue.LocalQueue
+		// otherCQ is a ClusterQueue a spec adds for its preemptor.
+		otherCQ *kueue.ClusterQueue
+	)
+
+	ginkgo.BeforeAll(func() {
+		features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+			features.ElasticJobsViaWorkloadSlices:                          true,
+			features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+			features.PartialPreemption:                                     partialPreemption,
+		})
+		fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+	})
+	ginkgo.AfterAll(func() {
+		fwk.StopManager(ctx)
+	})
+
+	// createQueuesWithStrategy creates a ClusterQueue with pods pods of quota and its LocalQueue.
+	createQueuesWithStrategy := func(pods string, strategy kueue.QueueingStrategy) {
+		ginkgo.GinkgoHelper()
+		ns = behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "regrow-")
+		flavor = utiltestingapi.MakeResourceFlavor("default").Obj()
+		behavioral.MustCreate(ctx, k8sClient, flavor)
+		clusterQueue = utiltestingapi.MakeClusterQueue("victim").
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas(flavor.Name).
+				Resource(corev1.ResourcePods, pods).
+				Resource(corev1.ResourceCPU, "100").
+				Obj()).
+			QueueingStrategy(strategy).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, clusterQueue)
+		localQueue = utiltestingapi.MakeLocalQueue("victim", ns.Name).ClusterQueue(clusterQueue.Name).Obj()
+		behavioral.MustCreate(ctx, k8sClient, localQueue)
+	}
+	createQueues := func(pods string) {
+		ginkgo.GinkgoHelper()
+		createQueuesWithStrategy(pods, kueue.BestEffortFIFO)
+	}
+	ginkgo.AfterEach(func() {
+		gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, clusterQueue, true)
+		if otherCQ != nil {
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, otherCQ, true)
+			otherCQ = nil
+		}
+		behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, flavor, true)
+	})
+
+	createCluster := func(workers int32) *rayv1.RayCluster {
+		ginkgo.GinkgoHelper()
+		rayCluster := testingraycluster.MakeCluster("elastic", ns.Name).
+			SetAnnotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			SetAnnotation(constants.ElasticJobScaleUpStrategyAnnotationKey, constants.ElasticJobScaleUpStrategyPartial).
+			Queue(localQueue.Name).
+			RequestWorkerGroup(corev1.ResourceCPU, "1").
+			FirstWorkerGroupReplicas(workers, 0, 16).
+			Obj()
+		behavioral.MustCreate(ctx, k8sClient, rayCluster)
+		return rayCluster
+	}
+	scale := func(rayCluster *rayv1.RayCluster, replicas int32) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), rayCluster)).Should(gomega.Succeed())
+			rayCluster.Spec.WorkerGroupSpecs[0].Replicas = new(replicas)
+			g.Expect(k8sClient.Update(ctx, rayCluster)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	// expectReplicas checks that Kueue never wrote the worker group's replicas.
+	expectReplicas := func(rayCluster *rayv1.RayCluster, replicas int32) {
+		ginkgo.GinkgoHelper()
+		got := &rayv1.RayCluster{}
+		gomega.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(rayCluster), got)).Should(gomega.Succeed())
+		gomega.Expect(got.Spec.WorkerGroupSpecs[0].Replicas).Should(gomega.Equal(new(replicas)))
+	}
+	// reclaim writes the reclaim target, preemptor and request time that partial preemption
+	// sets on a victim in one update.
+	reclaim := func(wl *kueue.Workload, target int32, preemptor string) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{workersGroupName: target})
+			if preemptor != "" {
+				wl.Annotations[constants.ReclaimPreemptorAnnotation] = preemptor
+				wl.Annotations[constants.ReclaimRequestedAtAnnotation] = time.Now().UTC().Format(time.RFC3339)
+			}
+			g.Expect(k8sClient.Update(ctx, wl)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	// release raises the reclaimable pods, as the ElasticJobUngater (0008) does once the
+	// workers above the target are gone.
+	release := func(wl *kueue.Workload, reclaimable int32) {
+		ginkgo.GinkgoHelper()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(wl), wl)).Should(gomega.Succeed())
+			wl.Status.ReclaimablePods = []kueue.ReclaimablePod{{Name: workersGroupName, Count: reclaimable}}
+			g.Expect(k8sClient.Status().Update(ctx, wl)).Should(gomega.Succeed())
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+	}
+	expectReplacement := func(wl *kueue.Workload) *kueue.Workload {
+		ginkgo.GinkgoHelper()
+		probe := behavioral.ExpectNewWorkloadSlice(ctx, k8sClient, wl)
