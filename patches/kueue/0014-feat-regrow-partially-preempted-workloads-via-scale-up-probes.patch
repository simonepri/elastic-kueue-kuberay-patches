+// The scheduler's part of regrowth after a partial preemption reclaim:
+// a replacement slice waits while its predecessor's reclaim target is pending or the preemptor
+// that set it is, so it cannot take the reclaimed quota.
+
+package scheduler
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	apimeta "k8s.io/apimachinery/pkg/api/meta"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/klog/v2"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	qcache "sigs.k8s.io/kueue/pkg/cache/queue"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption/policy"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadfinish "sigs.k8s.io/kueue/pkg/workload/finish"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+const (
+	// regrowthHoldRecheck is how often a held slice is requeued, so the hold ends even when
+	// the preemptor leaves through an event in another cohort, such as its deletion.
+	regrowthHoldRecheck = 5 * time.Second
+)
+
+// afterFunc is time.AfterFunc; tests replace it to observe the rechecks.
+var afterFunc = time.AfterFunc
+
+// regrowthHolds tracks the workload slices held back after a partial preemption reclaim.
+type regrowthHolds struct {
+	mu sync.Mutex
+	// held are the slices held since the last admission.
+	held sets.Set[workload.Reference]
+	// rechecks are the timers that requeue a held slice.
+	rechecks map[workload.Reference]*time.Timer
+}
+
+// regrowthHoldReason returns why the pending slice wl may not be admitted yet, or "" when it
+// may: wl replaces a slice whose reclaim target is still pending, so admitting wl would hand
+// back the quota the target is releasing, or whose recorded preemptor is still waiting for
+// that quota, so wl would race it. A held slice is requeued as inadmissible and retried after
+// the next admission and every regrowthHoldRecheck.
+//
+// Partial preemption records only the latest preemptor of a target. An earlier preemptor
+// that is still pending is not waited for, so a probe admitted ahead of it may cost it
+// another reclaim round.
+//
+// The hold follows the reclaim annotations rather than the PartialPreemption gate, so a
+// target written before the gate was turned off is still respected.
+func (s *Scheduler) regrowthHoldReason(ctx context.Context, wl *workload.Info, snapshot *schdcache.Snapshot) string {
+	_, replaced := workloadslicing.ReplacedWorkloadSlice(wl, snapshot)
+	if replaced == nil {
+		return ""
+	}
+	var msg string
+	recheck := regrowthHoldRecheck
+	if len(workload.PendingReclaimTargetCounts(replaced.Obj)) > 0 {
+		msg = fmt.Sprintf("Workload slice waits until partial preemption releases the quota of %s", workload.Key(replaced.Obj))
+	} else if preemptor, requestedAt, found := reclaimRequest(replaced.Obj); found {
+		// After the reclaim timeout, partial preemption evicts a victim whose target is still
+		// pending whole, so a preemptor still pending by then waits for other quota.
+		deadline := requestedAt.Add(policy.ReclaimTimeout)
+		if now := s.clock.Now(); now.Before(deadline) && s.reclaimPreemptorPending(ctx, preemptor, requestedAt, snapshot) {
+			msg = fmt.Sprintf("Workload slice waits until the reclaim preemptor %s of %s is admitted", preemptor, workload.Key(replaced.Obj))
+			recheck = min(recheck, deadline.Sub(now))
+		}
+	}
+	if msg == "" {
+		return ""
+	}
+	ctrl.LoggerFrom(ctx).V(3).Info("Holding back a workload slice after a partial preemption reclaim", "workload", klog.KObj(wl.Obj), "replaced", workload.Key(replaced.Obj), "reason", msg)
+	s.regrowth.hold(ctx, s.queues, workload.Key(wl.Obj), recheck)
+	return msg
+}
+
+// reclaimRequest returns the preemptor and request time recorded with the reclaim target of
+// wl; found is false when either is missing or malformed.
+func reclaimRequest(wl *kueue.Workload) (workload.Reference, time.Time, bool) {
+	preemptor := wl.Annotations[constants.ReclaimPreemptorAnnotation]
+	requestedAt, err := time.Parse(time.RFC3339, wl.Annotations[constants.ReclaimRequestedAtAnnotation])
+	if preemptor == "" || err != nil {
+		return "", time.Time{}, false
+	}
+	return workload.Reference(preemptor), requestedAt, true
+}
+
+// reclaimPreemptorPending reports whether the preemptor still waits for the quota reclaimed at
+// requestedAt: it exists, is active and unfinished, holds no quota, neither in the snapshot,
+// which includes the workloads this scheduler assumed, nor in the API, and was not evicted
+// since, which shows it was admitted after the request and went back to pending later.
+// Deactivation also marks a workload evicted, even one that never held quota, so it does not count.
+func (s *Scheduler) reclaimPreemptorPending(ctx context.Context, preemptor workload.Reference, requestedAt time.Time, snapshot *schdcache.Snapshot) bool {
+	for _, cq := range snapshot.ClusterQueues() {
+		if _, found := cq.Workloads[preemptor]; found {
+			return false
+		}
+	}
+	namespace, name, found := strings.Cut(string(preemptor), "/")
+	if !found {
+		return false
+	}
+	wl := &kueue.Workload{}
+	if err := s.client.Get(ctx, client.ObjectKey{Namespace: namespace, Name: name}, wl); err != nil {
+		if !apierrors.IsNotFound(err) {
+			ctrl.LoggerFrom(ctx).Error(err, "Could not read the reclaim preemptor; holding back the workload slice", "preemptor", preemptor)
+			return true
+		}
+		return false
+	}
+	if evicted := apimeta.FindStatusCondition(wl.Status.Conditions, kueue.WorkloadEvicted); evicted != nil &&
+		evicted.Status == metav1.ConditionTrue && evicted.LastTransitionTime.After(requestedAt) &&
+		!strings.HasPrefix(evicted.Reason, kueue.WorkloadDeactivated) {
+		return false
+	}
+	return workload.IsActive(wl) && !workloadfinish.IsFinished(wl) && !workload.HasQuotaReservation(wl)
+}
+
+// hold records the held slice key and arms a timer that requeues it after recheck.
+func (h *regrowthHolds) hold(ctx context.Context, queues *qcache.Manager, key workload.Reference, recheck time.Duration) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.held == nil {
+		h.held = sets.New[workload.Reference]()
+		h.rechecks = make(map[workload.Reference]*time.Timer)
+	}
+	h.held.Insert(key)
+	if _, armed := h.rechecks[key]; armed {
+		return
+	}
+	h.rechecks[key] = afterFunc(recheck, func() {
+		h.mu.Lock()
+		delete(h.rechecks, key)
+		h.mu.Unlock()
+		queues.QueueAssociatedInadmissibleWorkloadsAfter(ctx, key, nil)
+	})
+}
+
+// retry requeues the slices held since the last admission, once this cycle admitted a
+// workload: admitting a pending preemptor frees no quota, so no cluster event would requeue
+// the slices that waited for it.
+func (h *regrowthHolds) retry(ctx context.Context, queues *qcache.Manager, admitted bool) {
+	if !admitted {
+		return
+	}
+	h.mu.Lock()
+	keys := h.held.UnsortedList()
+	clear(h.held)
+	h.mu.Unlock()
+	for _, key := range keys {
+		queues.QueueAssociatedInadmissibleWorkloadsAfter(ctx, key, nil)
+	}
+}
