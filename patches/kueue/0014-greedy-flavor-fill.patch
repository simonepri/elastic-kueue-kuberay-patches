+func TestGreedySplit(t *testing.T) {
+	cases := map[string]struct {
+		cpuQuota    string
+		prior       int
+		running     int32
+		nominal     string
+		count       int32
+		step        int32
+		floor       int32
+		want        []FlavorFill
+		elastic     bool
+		minCount    bool
+		cohort      bool
+		tryNext     bool
+		lending     string
+		wholeFlavor kueue.ResourceFlavorReference
+	}{
+		"independent CPU flavor":                              {cpuQuota: "100", nominal: "15", count: 24, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 15}, {Flavor: "b", Count: 9}}},
+		"independent flavor boundaries":                       {cpuQuota: "12", nominal: "15", count: 24, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 12}, {Flavor: "a", Count: 3}, {Flavor: "b", Count: 9}}},
+		"running independent flavor boundaries":               {cpuQuota: "12", running: 8, nominal: "15", count: 24, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 12}, {Flavor: "a", Count: 3}, {Flavor: "b", Count: 9}}},
+		"earlier worker group consumes shared quota":          {prior: 10, nominal: "15", count: 24, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 5}, {Flavor: "b", Count: 19}}},
+		"from zero without MinCount":                          {nominal: "15", count: 24, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 15}, {Flavor: "b", Count: 9}}},
+		"grows on running flavor":                             {running: 8, nominal: "15", count: 24, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 15}, {Flavor: "b", Count: 9}}},
+		"steps":                                               {nominal: "15", count: 24, step: 2, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 14}, {Flavor: "b", Count: 10}}},
+		"MinCount is supported":                               {nominal: "15", count: 24, minCount: true, elastic: true, want: []FlavorFill{{Flavor: "a", Count: 15}, {Flavor: "b", Count: 9}}},
+		"nothing free moves whole":                            {nominal: "0", count: 24, elastic: true, wholeFlavor: "b"},
+		"running floor cannot fit":                            {running: 8, nominal: "15", count: 24, floor: 16, elastic: true},
+		"floor cannot fit":                                    {nominal: "15", count: 24, floor: 16, elastic: true},
+		"insufficient total preserves partial admission":      {nominal: "15", count: 100, elastic: true},
+		"non elastic growth":                                  {running: 8, nominal: "15", count: 24},
+		"non elastic":                                         {nominal: "15", count: 24},
+		"TryNextFlavor avoids borrowing":                      {nominal: "0", count: 24, elastic: true, cohort: true, tryNext: true, wholeFlavor: "b"},
+		"TryNextFlavor retains already borrowed running pods": {running: 8, nominal: "5", count: 24, elastic: true, cohort: true, tryNext: true, want: []FlavorFill{{Flavor: "a", Count: 8}, {Flavor: "b", Count: 16}}},
+		"lending limit":                                       {nominal: "5", count: 24, elastic: true, cohort: true, lending: "3", want: []FlavorFill{{Flavor: "a", Count: 8}, {Flavor: "b", Count: 16}}},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: true,
+				features.ElasticJobsViaWorkloadSlicesFlavorSplit:          true,
+			})
+			ctx, log := utiltesting.ContextWithLog(t)
+			cq := api.MakeClusterQueue("cq").ResourceGroup(
+				*api.MakeFlavorQuotas("a").Resource("example.com/gpu", tc.nominal).Obj(),
+				*api.MakeFlavorQuotas("b").Resource("example.com/gpu", "32").Obj())
+			if tc.cpuQuota != "" {
+				cq.ResourceGroup(*api.MakeFlavorQuotas("cpu-fast").Resource(corev1.ResourceCPU, tc.cpuQuota).Obj(), *api.MakeFlavorQuotas("cpu-slow").Resource(corev1.ResourceCPU, "32").Obj())
+			}
+			if tc.cohort {
+				cq.Cohort("cohort")
+			}
+			if tc.tryNext {
+				cq.FlavorFungibility(kueue.FlavorFungibility{WhenCanBorrow: kueue.TryNextFlavor, WhenCanPreempt: kueue.TryNextFlavor})
+			}
+			cache := schdcache.New(utiltesting.NewFakeClient())
+			flavors := map[kueue.ResourceFlavorReference]*kueue.ResourceFlavor{
+				"a": api.MakeResourceFlavor("a").Obj(), "b": api.MakeResourceFlavor("b").Obj(),
+			}
+			if tc.cpuQuota != "" {
+				for _, name := range []kueue.ResourceFlavorReference{"cpu-fast", "cpu-slow"} {
+					flavors[name] = api.MakeResourceFlavor(string(name)).Obj()
+				}
+			}
+			for _, f := range flavors {
+				cache.AddOrUpdateResourceFlavor(log, f)
+			}
+			if err := cache.AddClusterQueue(ctx, cq.Obj()); err != nil {
+				t.Fatal(err)
+			}
+			if tc.cohort {
+				lender := api.MakeClusterQueue("lender").Cohort("cohort").ResourceGroup(*api.MakeFlavorQuotas("a").Resource("example.com/gpu", "32", "0", tc.lending).Obj()).Obj()
+				if tc.lending == "" {
+					lender.Spec.ResourceGroups[0].Flavors[0].Resources[0].LendingLimit = nil
+				}
+				if err := cache.AddClusterQueue(ctx, lender); err != nil {
+					t.Fatal(err)
+				}
+			}
+			old := api.MakeWorkload("old", "default").PodSets(*api.MakePodSet("workers", int(tc.running)).Request("example.com/gpu", "1").Obj()).
+				ReserveQuotaAt(api.MakeAdmission("cq").PodSets(api.MakePodSetAssignment("workers").Count(tc.running).Assignment("example.com/gpu", "a", stringCount(tc.running)).Obj()).Obj(), time.Now()).Obj()
+			if tc.cpuQuota != "" {
+				old.Spec.PodSets[0].Template.Spec.Containers[0].Resources.Requests[corev1.ResourceCPU] = resource.MustParse("1")
+				old.Status.Admission.PodSetAssignments[0].ResourceUsage[corev1.ResourceCPU] = resource.MustParse(stringCount(tc.running))
+				old.Status.Admission.PodSetAssignments[0].Flavors[corev1.ResourceCPU] = "cpu-fast"
+			}
+			if !cache.AddOrUpdateWorkload(ctx, log, old) {
+				t.Fatal("cache rejected old workload")
+			}
+			snapshot, err := cache.Snapshot(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			probe := api.MakeWorkload("probe", "default").PodSets(*api.MakePodSet("workers", int(tc.count)).Request("example.com/gpu", "1").Obj()).Obj()
+			if tc.cpuQuota != "" {
+				probe.Spec.PodSets[0].Template.Spec.Containers[0].Resources.Requests[corev1.ResourceCPU] = resource.MustParse("1")
+			}
+			if tc.elastic {
+				probe.Annotations = map[string]string{constants.ElasticJobAnnotation: "true"}
+			}
+			if tc.minCount {
+				probe.Spec.PodSets[0].MinCount = ptr.To[int32](1)
+			}
+			if tc.step > 0 {
+				workload.SetPodSetCountSteps(probe, workload.PodSetsCounts{"workers": tc.step})
+			}
+			if tc.floor > 0 {
+				workload.SetReclaimMinCounts(probe, workload.PodSetsCounts{"workers": tc.floor})
+			}
+			if tc.prior > 0 {
+				probe.Spec.PodSets = append([]kueue.PodSet{*api.MakePodSet("earlier", tc.prior).Request("example.com/gpu", "1").Obj()}, probe.Spec.PodSets...)
+			}
+			before := probe.DeepCopy()
+			info := workload.NewInfo(log, probe)
+			assigner := New(info, snapshot.ClusterQueue("cq"), flavors, false, &testOracle{}, workload.NewInfo(log, old), configapi.QuotaCheckBlockUndeclared, resources.NewResourceFormatter(), 0)
+			assignment := assigner.AssignFlavors(ctx, log, nil)
+			split, ok := ParseGreedySplit(assignment.Message())
+			if tc.cpuQuota != "" {
+				cpuQuota := resource.MustParse(tc.cpuQuota)
+				cpuLeft := cpuQuota.Value()
+				var assigned int64
+				for i := range tc.want {
+					cpuFlavor := kueue.ResourceFlavorReference("cpu-fast")
+					if assigned >= cpuLeft {
+						cpuFlavor = "cpu-slow"
+					}
+					tc.want[i].Flavors = map[corev1.ResourceName]kueue.ResourceFlavorReference{"example.com/gpu": tc.want[i].Flavor, corev1.ResourceCPU: cpuFlavor}
+					assigned += int64(tc.want[i].Count)
+				}
+			}
+			if ok != (tc.want != nil) || !reflect.DeepEqual(split.Fills, tc.want) {
+				t.Fatalf("proposal=%+v (%v), want %v; message=%s", split, ok, tc.want, assignment.Message())
+			}
+			if tc.wholeFlavor != "" {
+				if assignment.RepresentativeMode() != Fit || assignment.PodSets[0].Flavors["example.com/gpu"].Name != tc.wholeFlavor {
+					t.Fatalf("whole assignment=%s, want flavor %s", assignment.Message(), tc.wholeFlavor)
+				}
+			}
+			if !tc.elastic && strings.Contains(assignment.Message(), GrowthFitsOtherFlavorReason) {
+				t.Fatal("non-elastic assignment proposed a split")
+			}
+			if !reflect.DeepEqual(before, probe) {
+				t.Fatal("assigner mutated input workload")
+			}
+			if ok && assignment.RepresentativeMode() != NoFit {
+				t.Fatal("proposal must refuse admission")
+			}
+		})
+	}
+}
+
+func stringCount(count int32) string { return fmt.Sprint(count) }
