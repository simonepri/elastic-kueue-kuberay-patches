+			(features.Enabled(features.ConcurrentAdmission) && !concurrentadmission.IsFlavorAllowedForVariant(a.wl.Obj, flavor)) {
+			continue
+		}
+		first := len(fills) == 0
+		baseline := int32(0)
+		if first {
+			baseline = running
+		}
+		fits := func(count int32) bool {
+			scaled := ips.podSet.ScaledTo(count)
+			for name, val := range scaled.Requests.Iter() {
+				if !rg.CoveredResources.Has(name) {
+					continue
+				}
+				fr := resources.FlavorResource{Flavor: flavor, Resource: name}
+				if first && old != nil && old.Requests != nil && old.Flavors[name] == flavor {
+					val = val.Sub(old.Requests.ResourceValue(name))
+				} else if first && running > 0 {
+					return false
+				}
+				total := usage[fr].Add(val)
+				if a.fitsMaxCapacity(fr, usage[fr], val) != nil || total.Cmp(a.cq.Available(fr)) > 0 {
+					return false
+				}
+				borrow, _ := classical.FindHeightOfLowestSubtreeThatFits(a.cq, fr, total)
+				if val.Sign() > 0 && features.Enabled(features.FlavorFungibility) && shouldTryNextFlavor(granularMode{fit, borrowingLevel(borrow)}, a.cq.FlavorFungibility) {
+					return false
+				}
+			}
+			return true
+		}
+		low, high := int32(0), (remaining-baseline)/step
+		for low < high {
+			mid := low + (high-low+1)/2
+			if fits(baseline + mid*step) {
+				low = mid
+			} else {
+				high = mid - 1
+			}
+		}
+		count := baseline + low*step
+		if first && count < floor {
+			return nil
+		}
+		if count == 0 {
+			continue
+		}
+		if !fits(count) {
+			return nil
+		}
+		fills = append(fills, FlavorFill{Flavor: flavor, Count: count})
+		remaining -= count
+		if remaining == 0 {
+			return fills
+		}
+	}
+	return nil
