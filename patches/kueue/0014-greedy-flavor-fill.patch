+
+// applyGreedySplit materializes one count proposal on the reconciler's private copy. Its caller
+// writes that copy with a resourceVersion precondition, after checking the observed generation.
+func applyGreedySplit(probe *kueue.Workload, split flavorassigner.GreedySplit, partial bool) bool {
+	idx := slices.IndexFunc(probe.Spec.PodSets, func(ps kueue.PodSet) bool { return ps.Name == split.PodSet })
+	if idx < 0 || len(probe.Spec.PodSets)+len(split.Fills)-1 > maxWorkloadPodSets {
+		return false
+	}
+	var total int32
+	for _, fill := range split.Fills {
+		if fill.Count <= 0 {
+			return false
+		}
+		total += fill.Count
+	}
+	if total != probe.Spec.PodSets[idx].Count {
+		return false
+	}
+	base := SplitBase(&probe.Spec.PodSets[idx])
+	floor := workload.ReclaimMinCounts(probe)
+	steps := workload.PodSetCountSteps(probe)
+	original := probe.Spec.PodSets[idx].DeepCopy()
+	probe.Spec.PodSets[idx].Count = split.Fills[0].Count
+	if probe.Spec.PodSets[idx].MinCount != nil && *probe.Spec.PodSets[idx].MinCount > split.Fills[0].Count {
+		probe.Spec.PodSets[idx].MinCount = ptr.To(split.Fills[0].Count)
+	}
+	for _, fill := range split.Fills[1:] {
+		name, ok := nextSplitName(probe.Spec.PodSets, base)
+		if !ok {
+			return false
+		}
+		entry := newSplitEntry(original, name, fill.Count)
+		entry.Template.Annotations[FlavorSplitOfAnnotation] = string(base)
+		if partial {
+			entry.MinCount = ptr.To(steps[original.Name])
+		}
+		probe.Spec.PodSets = append(probe.Spec.PodSets, entry)
+		steps[name] = steps[original.Name]
+		if len(floor) > 0 {
+			floor[name] = 0
+		}
+	}
+	if len(floor) > 0 {
+		workload.SetReclaimMinCounts(probe, floor)
+	}
+	workload.SetPodSetCountSteps(probe, steps)
+	return true
+}
