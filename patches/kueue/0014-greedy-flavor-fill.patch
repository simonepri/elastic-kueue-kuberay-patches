+		if amount.Sign() > 0 && a.cq.RGByResource(name) == nil && !IgnoreUndeclaredResources(a.quotaCheckStrategy) {
+			return nil
+		}
+	}
+	for i := range a.cq.ResourceGroups {
+		rg := &a.cq.ResourceGroups[i]
+		requested := false
+		for name, amount := range ips.podSet.Requests.Iter() {
+			if amount.Sign() > 0 && rg.CoveredResources.Has(name) {
+				requested = true
+				break
+			}
+		}
+		if requested {
+			groups = append(groups, rg)
+		}
+	}
+	if len(groups) == 0 {
+		return nil
+	}
+	plans := make([][]FlavorFill, len(groups))
+	boundaries := map[int32]bool{0: true}
+	primary := 0
+	for i, rg := range groups {
+		plans[i] = a.greedyGroupFills(log, ips, usage, rg, old, running, step, floor)
+		if len(plans[i]) == 0 {
+			return nil
+		}
+		if len(plans[i]) > len(plans[primary]) {
+			primary = i
+		}
+		var end int32
+		for _, fill := range plans[i] {
+			end += fill.Count
+			boundaries[end] = true
+		}
+	}
+	cuts := slices.Sorted(maps.Keys(boundaries))
+	if len(cuts) < 3 || len(a.wl.Obj.Spec.PodSets)+len(cuts)-2 > 8 {
+		return nil
+	}
+	split := &GreedySplit{PodSet: ps.Name}
+	positions := make([]int, len(plans))
+	ends := make([]int32, len(plans))
+	for i := range plans {
+		ends[i] = plans[i][0].Count
+	}
+	for i := 1; i < len(cuts); i++ {
+		fill := FlavorFill{Count: cuts[i] - cuts[i-1]}
+		if len(groups) > 1 {
+			fill.Flavors = make(map[corev1.ResourceName]kueue.ResourceFlavorReference)
+		}
+		for group, plan := range plans {
+			for cuts[i] > ends[group] {
+				positions[group]++
+				ends[group] += plan[positions[group]].Count
+			}
+			flavor := plan[positions[group]].Flavor
+			if group == primary {
+				fill.Flavor = flavor
+			}
+			if fill.Flavors != nil {
+				for name := range groups[group].CoveredResources {
+					fill.Flavors[name] = flavor
+				}
+			}
 		}
-		for _, psID := range psIDs {
-			if replaced := podSetResourcesByName(a.replaceWorkloadSlice.TotalRequests, a.wl.Obj.Spec.PodSets[psID].Name); replaced != nil && replaced.Requests != nil {
-				val = val.Sub(replaced.Requests.ResourceValue(rName))
+		split.Fills = append(split.Fills, fill)
+	}
+	return split
+}
+
+// greedyGroupFills applies the ordinary quota and eligibility rules to one resource group.
+// Resource groups have disjoint resources, so their plans share only PodSet count boundaries.
+func (a *FlavorAssigner) greedyGroupFills(log logr.Logger, ips indexedPodSet, usage resources.FlavorResourceQuantities, rg *resourcegroups.ResourceGroup, old *workload.PodSetResources, running, step, floor int32) []FlavorFill {
+	ps := &a.wl.Obj.Spec.PodSets[ips.originalIndex]
+	flavors := slices.Clone(rg.Flavors)
+	// A running entry starts on its current flavor even if an earlier flavor frees up.
+	if running > 0 {
+		var current kueue.ResourceFlavorReference
+		for name, amount := range ips.podSet.Requests.Iter() {
+			if amount.Sign() > 0 && rg.CoveredResources.Has(name) {
+				if current != "" && current != old.Flavors[name] {
+					return nil
+				}
+				current = old.Flavors[name]
+			}
+		}
+		idx := slices.Index(flavors, current)
+		if idx < 0 {
+			return nil
+		}
+		flavors = flavors[idx:]
+	}
+	remaining := ps.Count
+	var fills []FlavorFill
+	for _, flavor := range flavors {
+		if a.shouldRespectNominationMapping() {
+			skip := false
+			for name, amount := range ips.podSet.Requests.Iter() {
+				if amount.Sign() > 0 && rg.CoveredResources.Has(name) && a.shouldSkipBasedOnNominationMapping(log, flavor, []int{ips.originalIndex}, name) {
+					skip = true
+					break
+				}
+			}
+			if skip {
+				continue
+			}
+		}
+		if !a.checkFlavorForPodSets(log, flavor, []int{ips.originalIndex}, []*kueue.PodSet{ps}, rg).IsFit() ||
+			(features.Enabled(features.ConcurrentAdmission) && !concurrentadmission.IsFlavorAllowedForVariant(a.wl.Obj, flavor)) {
+			continue
+		}
+		first := len(fills) == 0
+		baseline := int32(0)
+		if first {
+			baseline = running
+		}
+		fits := func(count int32) bool {
+			scaled := ips.podSet.ScaledTo(count)
+			if rg.CoveredResources.Has(corev1.ResourcePods) {
+				if scaled.Requests == nil {
+					scaled.Requests = resources.NewRequestsFromMap(map[corev1.ResourceName]int64{corev1.ResourcePods: int64(count)})
+				} else {
+					scaled.Requests.Set(corev1.ResourcePods, resources.NewAmount(int64(count)))
+				}
+			}
+			for name, val := range scaled.Requests.Iter() {
+				if !rg.CoveredResources.Has(name) {
+					continue
+				}
+				fr := resources.FlavorResource{Flavor: flavor, Resource: name}
+				if first && old != nil && old.Requests != nil && old.Flavors[name] == flavor {
+					val = val.Sub(old.Requests.ResourceValue(name))
+				} else if first && running > 0 {
+					return false
+				}
+				total := usage[fr].Add(val)
+				if a.fitsMaxCapacity(fr, usage[fr], val) != nil || total.Cmp(a.cq.Available(fr)) > 0 {
+					return false
+				}
+				borrow, _ := classical.FindHeightOfLowestSubtreeThatFits(a.cq, fr, total)
+				if val.Sign() > 0 && features.Enabled(features.FlavorFungibility) && shouldTryNextFlavor(granularMode{fit, borrowingLevel(borrow)}, a.cq.FlavorFungibility) {
+					return false
+				}
 			}
+			return true
+		}
+		low, high := int32(0), (remaining-baseline)/step
+		for low < high {
+			mid := low + (high-low+1)/2
+			if fits(baseline + mid*step) {
+				low = mid
+			} else {
+				high = mid - 1
+			}
+		}
+		count := baseline + low*step
+		if first && count < floor {
+			return nil
 		}
-		if val.Sign() > 0 {
-			grows = true
+		if count == 0 {
+			continue
 		}
-		fr := resources.FlavorResource{Flavor: fName, Resource: rName}
-		mode, _, _ := a.fitsResourceQuota(ctx, fr, assignmentUsage[fr], val, a.cq.QuotaFor(fr))
-		fits = mode == fit
-	})
-	return fits && grows
+		if !fits(count) {
+			return nil
+		}
+		fills = append(fills, FlavorFill{Flavor: flavor, Count: count})
+		remaining -= count
+		if remaining == 0 {
+			return fills
+		}
+	}
+	return nil
+}
+
+// placesByTopology distinguishes placement requirements from worker index metadata.
+func placesByTopology(tr *kueue.PodSetTopologyRequest) bool {
+	return tr != nil && (tr.Required != nil || tr.Preferred != nil || (tr.Unconstrained != nil && *tr.Unconstrained) ||
+		tr.PodSetGroupName != nil || tr.PodSetSliceRequiredTopology != nil)
 }
