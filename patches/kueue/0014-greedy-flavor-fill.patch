+limitations under the License.
+*/
+
+package scheduler
+
+import (
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/meta"
+	"k8s.io/component-base/featuregate"
+	"k8s.io/utils/ptr"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	api "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+	"sigs.k8s.io/kueue/test/util/behavioral"
+)
+
+var _ = ginkgo.Describe("Greedy flavor fill", ginkgo.Label("area:scheduler"), func() {
+	ginkgo.DescribeTable("should record a split proposal without modifying Workload spec", func(partial, initial bool) {
+		features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+			features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero:      true,
+			features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+			features.ElasticJobsViaWorkloadSlicesFlavorSplit:               true,
+		})
+		ns := behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "greedy-fill-")
+		a := api.MakeResourceFlavor("fill-a").Obj()
+		b := api.MakeResourceFlavor("fill-b").Obj()
+		cq := api.MakeClusterQueue("greedy-fill").ResourceGroup(
+			*api.MakeFlavorQuotas(a.Name).Resource(corev1.ResourceCPU, "15").Obj(),
+			*api.MakeFlavorQuotas(b.Name).Resource(corev1.ResourceCPU, "32").Obj()).Obj()
+		ginkgo.DeferCleanup(func() {
+			gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, cq, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, a, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, b, true)
+		})
+		for _, obj := range []client.Object{a, b, cq, api.MakeLocalQueue("queue", ns.Name).ClusterQueue(cq.Name).Obj()} {
+			behavioral.MustCreate(ctx, k8sClient, obj)
+		}
+		root := api.MakeWorkload("root", ns.Name).Queue("queue").
+			Annotation(workloadslicing.EnabledAnnotationKey, "true").
+			PodSets(*api.MakePodSet("workers", 0).Request(corev1.ResourceCPU, "1").Obj()).Obj()
+		if !initial {
+			behavioral.MustCreate(ctx, k8sClient, root)
+			behavioral.ExpectWorkloadsToBeAdmitted(ctx, k8sClient, root)
+		}
+		probe := api.MakeWorkload("probe", ns.Name).Queue("queue").
+			Annotation(workloadslicing.EnabledAnnotationKey, "true").
+			Annotation(workloadslicing.WorkloadSliceReplacementFor, string(workload.Key(root))).
+			PodSets(*api.MakePodSet("workers", 24).Request(corev1.ResourceCPU, "1").Obj()).Obj()
+		if initial {
+			delete(probe.Annotations, workloadslicing.WorkloadSliceReplacementFor)
+		}
+		if partial {
+			probe.Spec.PodSets[0].MinCount = ptr.To[int32](1)
+		}
+		behavioral.MustCreate(ctx, k8sClient, probe)
+		original := probe.Spec.DeepCopy()
+		gomega.Eventually(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(probe), probe)).To(gomega.Succeed())
+			cond := meta.FindStatusCondition(probe.Status.Conditions, kueue.WorkloadQuotaReserved)
+			g.Expect(cond).NotTo(gomega.BeNil())
+			split, ok := flavorassigner.ParseGreedySplit(cond.Message)
+			g.Expect(ok).To(gomega.BeTrue())
+			g.Expect(split.Fills).To(gomega.Equal([]flavorassigner.FlavorFill{{Flavor: "fill-a", Count: 15}, {Flavor: "fill-b", Count: 9}}))
+		}, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		gomega.Consistently(func(g gomega.Gomega) {
+			g.Expect(k8sClient.Get(ctx, client.ObjectKeyFromObject(probe), probe)).To(gomega.Succeed())
+			g.Expect(&probe.Spec).To(gomega.Equal(original))
+			g.Expect(probe.Status.Admission).To(gomega.BeNil())
+		}, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+	}, ginkgo.Entry("atomic", false, false), ginkgo.Entry("partial", true, false), ginkgo.Entry("initial nonzero", false, true))
+})
