+// greedyGroupFills applies the ordinary quota and eligibility rules to one resource group.
+// Resource groups have disjoint resources, so their plans share only PodSet count boundaries.
+func (a *FlavorAssigner) greedyGroupFills(log logr.Logger, ips indexedPodSet, usage resources.FlavorResourceQuantities, rg *resourcegroups.ResourceGroup, old *workload.PodSetResources, running, step, floor int32) []FlavorFill {
