 // with a topology request or a count step above 1 are not split, nor any once the Workload has
 // as many PodSets as the API allows. It reports whether it changed probe.
 func SplitGrowth(probe, replaced *kueue.Workload, partial bool) bool {
+	if cond := apimeta.FindStatusCondition(probe.Status.Conditions, kueue.WorkloadQuotaReserved); cond != nil {
+		if split, ok := flavorassigner.ParseGreedySplit(cond.Message); ok {
