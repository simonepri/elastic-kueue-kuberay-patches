+// Verifies that a first nonzero RayJob slice consumes a greedy proposal and reaches admission through the job reconciler.
+
+package rayjob
+
+import (
+	"github.com/onsi/ginkgo/v2"
+	"github.com/onsi/gomega"
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/component-base/featuregate"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/features"
+	api "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+	testingrayjob "sigs.k8s.io/kueue/pkg/util/testingjobs/rayjob"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+	"sigs.k8s.io/kueue/test/util/behavioral"
+)
+
+var _ = ginkgo.Describe("RayJob initial greedy flavor fill", func() {
+	ginkgo.DescribeTable("admits a first nonzero slice with ordered entries", func(partial bool) {
+		features.SetFeatureGatesDuringTest(ginkgo.GinkgoTB(), map[featuregate.Feature]bool{
+			features.ElasticJobsViaWorkloadSlices:                          true,
+			features.ElasticJobsViaWorkloadSlicesWithPartialReplicaScaleUp: true,
+			features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero:      true,
+			features.ElasticJobsViaWorkloadSlicesFlavorSplit:               true,
+		})
+		fwk.StartManager(ctx, cfg, managerAndSchedulerSetup())
+		ginkgo.DeferCleanup(func() { fwk.StopManager(ctx) })
+		ns := behavioral.CreateNamespaceFromPrefixWithLog(ctx, k8sClient, "rayjob-initial-fill-")
+		a := api.MakeResourceFlavor("initial-a").Obj()
+		b := api.MakeResourceFlavor("initial-b").Obj()
+		cq := api.MakeClusterQueue("initial-fill").ResourceGroup(
+			*api.MakeFlavorQuotas(a.Name).Resource(corev1.ResourcePods, "7").Resource(corev1.ResourceCPU, "100").Obj(),
+			*api.MakeFlavorQuotas(b.Name).Resource(corev1.ResourcePods, "32").Resource(corev1.ResourceCPU, "100").Obj()).Obj()
+		ginkgo.DeferCleanup(func() {
+			gomega.Expect(behavioral.DeleteNamespace(ctx, k8sClient, ns)).To(gomega.Succeed())
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, cq, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, a, true)
+			behavioral.ExpectObjectToBeDeleted(ctx, k8sClient, b, true)
+		})
+		for _, obj := range []client.Object{a, b, cq, api.MakeLocalQueue("queue", ns.Name).ClusterQueue(cq.Name).Obj()} {
+			behavioral.MustCreate(ctx, k8sClient, obj)
+		}
+		job := testingrayjob.MakeJob("initial", ns.Name).Annotation(workloadslicing.EnabledAnnotationKey, "true").Queue("queue").WithSubmissionMode(rayv1.InteractiveMode).RequestWorkerGroup(corev1.ResourceCPU, "1").Obj()
+		job.Spec.RayClusterSpec.WorkerGroupSpecs[0].Replicas = new(int32(10))
+		job.Spec.RayClusterSpec.WorkerGroupSpecs[0].MaxReplicas = new(int32(20))
+		if partial {
+			job.Annotations[constants.ElasticJobScaleUpStrategyAnnotationKey] = constants.ElasticJobScaleUpStrategyPartial
+		}
+		behavioral.MustCreate(ctx, k8sClient, job)
+		setInitStatus(job.Name, ns.Name)
+		check := func(g gomega.Gomega) {
+			var list kueue.WorkloadList
+			g.Expect(k8sClient.List(ctx, &list, client.InNamespace(ns.Name))).To(gomega.Succeed())
+			g.Expect(list.Items).To(gomega.HaveLen(1))
+			wl := &list.Items[0]
+			g.Expect(workload.IsAdmitted(wl)).To(gomega.BeTrue())
+			g.Expect(workload.ExtractPodSetCountsFromWorkload(wl)).To(gomega.Equal(workload.PodSetsCounts{"head": 1, "workers-group-0": 6, "workers-group-0--2": 4}))
+			g.Expect(wl.Status.Admission.PodSetAssignments).To(gomega.HaveLen(3))
+			g.Expect(wl.Status.Admission.PodSetAssignments[1].Flavors[corev1.ResourcePods]).To(gomega.Equal(kueue.ResourceFlavorReference(a.Name)))
+			g.Expect(wl.Status.Admission.PodSetAssignments[2].Flavors[corev1.ResourcePods]).To(gomega.Equal(kueue.ResourceFlavorReference(b.Name)))
+		}
+		gomega.Eventually(check, behavioral.Timeout, behavioral.Interval).Should(gomega.Succeed())
+		gomega.Consistently(check, behavioral.ConsistentDuration, behavioral.ShortInterval).Should(gomega.Succeed())
+	}, ginkgo.Entry("atomic", false), ginkgo.Entry("partial strategy preserves initial minimum", true))
+})
