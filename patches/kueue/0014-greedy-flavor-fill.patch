+func TestMaterializeGreedySplit(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		probe := api.MakeWorkload("probe", "default").PodSets(*api.MakePodSet("workers", 24).Obj()).Obj()
+		workload.SetPodSetCountSteps(probe, workload.PodSetsCounts{"workers": 2})
+		payload, _ := json.Marshal(flavorassigner.GreedySplit{PodSet: "workers", Fills: []flavorassigner.FlavorFill{{Flavor: "a", Count: 14}, {Flavor: "b", Count: 10}}})
+		probe.Status.Conditions = []metav1.Condition{{Type: kueue.WorkloadQuotaReserved, Message: flavorassigner.GrowthFitsOtherFlavorReason + "; greedy fill: " + string(payload)}}
+		if !SplitGrowth(probe, nil, partial) {
+			t.Fatal("proposal was not materialized")
+		}
+		if got := workload.ExtractPodSetCountsFromWorkload(probe); !reflect.DeepEqual(got, workload.PodSetsCounts{"workers": 14, "workers--2": 10}) {
+			t.Fatalf("counts=%v", got)
+		}
+		if SplitBase(&probe.Spec.PodSets[1]) != "workers" {
+			t.Fatal("entry lost its base")
+		}
+		if got := workload.PodSetCountSteps(probe)["workers--2"]; got != 2 {
+			t.Fatalf("step=%d", got)
+		}
+	}
