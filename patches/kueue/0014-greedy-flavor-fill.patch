+				if amount.Sign() > 0 && rg.CoveredResources.Has(name) && a.shouldSkipBasedOnNominationMapping(log, flavor, []int{ips.originalIndex}, name) {
+					skip = true
+					break
+				}
+			}
+			if skip {
