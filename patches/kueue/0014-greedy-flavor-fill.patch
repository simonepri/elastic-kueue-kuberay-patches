@@ -0,0 +1,50 @@
+// RayJob worker reclaim uses the same replica boundaries and deletion policy as its RayCluster.
+
+package rayjob
+
+import (
+	"context"
+
+	rayv1 "github.com/ray-project/kuberay/ray-operator/apis/ray/v1"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/controller/jobframework"
+	"sigs.k8s.io/kueue/pkg/controller/jobs/raycluster"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+var (
+	_ jobframework.JobWithPartialStop      = (*RayJob)(nil)
+	_ jobframework.JobWithReclaimMinCounts = (*RayJob)(nil)
+	_ jobframework.JobWithPodSetCountSteps = (*RayJob)(nil)
+)
+
+func (j *RayJob) workerCluster() *raycluster.RayCluster {
+	cluster := &rayv1.RayCluster{ObjectMeta: j.ObjectMeta, Status: j.Status.RayClusterStatus}
+	if j.Spec.RayClusterSpec != nil {
+		cluster.Spec = *j.Spec.RayClusterSpec
+	}
+	return (*raycluster.RayCluster)(cluster)
+}
+
+func (j *RayJob) ReclaimMinCounts() workload.PodSetsCounts {
+	return j.workerCluster().ReclaimMinCounts()
+}
+
+func (j *RayJob) PodSetCountSteps() workload.PodSetsCounts {
+	return j.workerCluster().PodSetCountSteps()
+}
+
+// StopPartially preserves the head, submitter, and workers in other entries. Recreated
+// workers remain gated until the replacement slice has quota for them again.
+func (j *RayJob) StopPartially(ctx context.Context, c client.Client, wl *kueue.Workload, targets workload.PodSetsCounts) (bool, error) {
+	return j.workerCluster().StopPartially(ctx, c, wl, targets)
+}
+
+func (j *RayJob) readyDuringReclaim(opts ...jobframework.PodsReadyOption) bool {
+	wl := jobframework.PodsReadyWorkload(opts...)
+	return features.Enabled(features.PartialPreemption) && workloadslicing.Enabled(j) &&
+		wl != nil && len(workload.ReclaimTargetCounts(wl)) > 0
+}
