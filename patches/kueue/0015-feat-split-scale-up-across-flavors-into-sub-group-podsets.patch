+func TestStopWorkersAboveDeletesPodsOfAGroupWithoutATarget(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	now := time.Now().Truncate(time.Second)
+	wl := utiltestingapi.MakeWorkload("wl", "ns").Obj()
+	cluster := &rayv1.RayCluster{
+		ObjectMeta: metav1.ObjectMeta{Name: "job", Namespace: "ns"},
+		Spec: rayv1.RayClusterSpec{WorkerGroupSpecs: []rayv1.WorkerGroupSpec{{
+			GroupName: "workers", Replicas: ptr.To[int32](4), MaxReplicas: ptr.To[int32](10),
+		}}},
+	}
+	objs := []client.Object{cluster}
+	for i := range 4 {
+		// The Pods carry a PodSet name that is not the name of their worker group.
+		objs = append(objs, testingpod.MakePod("w-"+string(rune('0'+i)), "ns").
+			Annotation(kueue.WorkloadSliceNameAnnotation, wl.Name).
+			Label(constants.PodSetLabel, "elsewhere").
+			Label(rayutils.RayNodeGroupLabelKey, "workers").
+			Label(rayutils.RayWorkerReplicaNameKey, "replica-"+string(rune('0'+i))).
+			CreationTimestamp(now.Add(time.Duration(i)*time.Second)).
+			Obj())
+	}
+	conflicted := false
+	kClient := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(objs...).
+		WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+		WithInterceptorFuncs(interceptor.Funcs{
+			Patch: func(ctx context.Context, c client.WithWatch, obj client.Object, patch client.Patch, opts ...client.PatchOption) error {
+				if _, ok := obj.(*rayv1.RayCluster); !ok || conflicted {
+					return c.Patch(ctx, obj, patch, opts...)
+				}
+				// Another writer lowers the group between the first read and the patch,
+				// which an earlier version of the stop then lowered a second time.
+				conflicted = true
+				var latest rayv1.RayCluster
+				if err := c.Get(ctx, client.ObjectKeyFromObject(obj), &latest); err != nil {
+					return err
+				}
+				latest.Spec.WorkerGroupSpecs[0].Replicas = ptr.To[int32](2)
+				if err := c.Update(ctx, &latest); err != nil {
+					return err
+				}
+				return apierrors.NewConflict(rayv1.GroupVersion.WithResource("rayclusters").GroupResource(), obj.GetName(), nil)
+			},
+		}).Build()
+
+	if _, err := StopWorkersAbove(ctx, kClient, wl, workload.PodSetsCounts{"elsewhere": 2}, client.ObjectKeyFromObject(cluster)); err != nil {
+		t.Fatalf("StopWorkersAbove() error: %v", err)
+	}
+	var got rayv1.RayCluster
+	if err := kClient.Get(ctx, client.ObjectKeyFromObject(cluster), &got); err != nil {
+		t.Fatalf("Get() error: %v", err)
+	}
+	if replicas := ptr.Deref(got.Spec.WorkerGroupSpecs[0].Replicas, -1); replicas != 4 {
+		t.Errorf("Replicas = %d, want 4: a group without a target is not lowered, however often the patch retries", replicas)
+	}
+	var pods corev1.PodList
+	if err := kClient.List(ctx, &pods); err != nil {
+		t.Fatalf("List() error: %v", err)
+	}
+	if len(pods.Items) != 2 {
+		t.Errorf("Pods = %d, want 2 left, the others deleted directly", len(pods.Items))
+	}
+}
