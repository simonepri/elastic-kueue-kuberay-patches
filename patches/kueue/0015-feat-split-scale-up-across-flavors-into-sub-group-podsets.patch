+func TestStopWorkersAboveAGroupSplitAcrossFlavors(t *testing.T) {
+	testCases := map[string]struct {
+		numOfHosts          int32
+		targets             workload.PodSetsCounts
+		wantReplicas        int32
+		wantWorkersToDelete []string
+	}{
+		"reclaiming one entry stops only its pods and lowers the replicas by its share": {
+			targets:             workload.PodSetsCounts{"workers--1": 0},
+			wantReplicas:        4,
+			wantWorkersToDelete: []string{"b-0", "b-1", "b-2", "b-3"},
+		},
+		"reclaiming part of one entry stops only its newest pods": {
+			targets:             workload.PodSetsCounts{"workers--1": 3},
+			wantReplicas:        7,
+			wantWorkersToDelete: []string{"b-3"},
+		},
+		"reclaiming both entries stops the pods above each target": {
+			targets:             workload.PodSetsCounts{"workers": 2, "workers--1": 1},
+			wantReplicas:        3,
+			wantWorkersToDelete: []string{"a-2", "a-3", "b-1", "b-2", "b-3"},
+		},
+		"a multi-host group stops whole replicas of the reclaimed entry only": {
+			numOfHosts:          2,
+			targets:             workload.PodSetsCounts{"workers--1": 2},
+			wantReplicas:        6,
+			wantWorkersToDelete: []string{"b-2", "b-3"},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			now := time.Now().Truncate(time.Second)
+			hosts := max(tc.numOfHosts, 1)
+			// Two entries of four pods each, so a group of eight pods, or of eight
+			// replicas with a single host.
+			entry := func(name string, split bool) kueue.PodSet {
+				ps := *utiltestingapi.MakePodSet(kueue.NewPodSetReference(name), 4).Obj()
+				if split {
+					ps.Template.Annotations = map[string]string{workloadslicing.FlavorSplitOfAnnotation: "workers"}
+				}
+				return ps
+			}
+			wl := utiltestingapi.MakeWorkload("wl", "ns").PodSets(entry("workers", false), entry("workers--1", true)).Obj()
+			cluster := &rayv1.RayCluster{
+				ObjectMeta: metav1.ObjectMeta{Name: "job", Namespace: "ns"},
+				Spec: rayv1.RayClusterSpec{WorkerGroupSpecs: []rayv1.WorkerGroupSpec{{
+					GroupName:   "workers",
+					Replicas:    ptr.To(8 / hosts),
+					MaxReplicas: ptr.To[int32](10),
+					NumOfHosts:  tc.numOfHosts,
+				}}},
+			}
+			if hosts == 1 {
+				cluster.Spec.WorkerGroupSpecs[0].Replicas = ptr.To[int32](8)
+			}
+			objs := []client.Object{cluster}
+			for _, entry := range []struct{ prefix, podSet string }{{"a", "workers"}, {"b", "workers--1"}} {
+				for i := range 4 {
+					objs = append(objs, testingpod.MakePod(entry.prefix+"-"+string(rune('0'+i)), "ns").
+						Annotation(kueue.WorkloadSliceNameAnnotation, wl.Name).
+						Label(constants.PodSetLabel, entry.podSet).
+						Label(rayutils.RayNodeGroupLabelKey, "workers").
+						Label(rayutils.RayWorkerReplicaNameKey, "replica-"+entry.prefix+string(rune('0'+int32(i)/hosts))).
+						CreationTimestamp(now.Add(time.Duration(i)*time.Second)).
+						Obj())
+				}
+			}
+			kClient := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(objs...).
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).Build()
+
+			if _, err := StopWorkersAbove(ctx, kClient, wl, tc.targets, client.ObjectKeyFromObject(cluster)); err != nil {
+				t.Fatalf("StopWorkersAbove() error: %v", err)
+			}
+			var got rayv1.RayCluster
+			if err := kClient.Get(ctx, client.ObjectKeyFromObject(cluster), &got); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			group := got.Spec.WorkerGroupSpecs[0]
+			wantReplicas := tc.wantReplicas
+			if hosts > 1 {
+				wantReplicas = (tc.wantReplicas + hosts - 1) / hosts
+			}
+			if replicas := ptr.Deref(group.Replicas, -1); replicas != wantReplicas {
+				t.Errorf("Replicas = %d, want %d", replicas, wantReplicas)
+			}
+			if diff := cmp.Diff(tc.wantWorkersToDelete, group.ScaleStrategy.WorkersToDelete); diff != "" {
+				t.Errorf("WorkersToDelete (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
