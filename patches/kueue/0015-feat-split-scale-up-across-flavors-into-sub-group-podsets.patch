+	replaced := utiltestingapi.MakeWorkload("slice", "default").
+		PodSets(makeHead(), makeWorkers(8)).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("head").Count(1).
+				Assignment("cpu", "on-demand", "2").
+				Assignment("memory", "on-demand", "4Gi").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers").Count(8).
+				Assignment("cpu", "reserved-gpu", "16").
+				Assignment("memory", "reserved-gpu", "32Gi").
+				Assignment("nvidia.com/gpu", "reserved-gpu", "8").Obj(),
+		).Obj(), now).
+		Obj()
+
+	cache := schdcache.New(utiltesting.NewFakeClient())
+	for _, f := range flavors {
+		cache.AddOrUpdateResourceFlavor(log, f)
+	}
+	if err := cache.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	if !cache.AddOrUpdateWorkload(ctx, log, replaced) {
+		t.Fatal("Could not add replaced workload")
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	probe := workload.NewInfo(log, utiltestingapi.MakeWorkload("probe", "default").
+		PodSets(makeHead(), makeWorkers(12)).Obj())
+
+	assigner := New(probe, snapshot.ClusterQueue("cq"), flavors, false, &testOracle{}, workload.NewInfo(log, replaced),
+		configapi.QuotaCheckBlockUndeclared, resources.NewResourceFormatter(), 0)
+	assignment := assigner.AssignFlavors(ctx, log, nil)
+	msg := assignment.Message()
+	t.Logf("RepresentativeMode: %v", assignment.RepresentativeMode())
+	t.Logf("Message: %s", msg)
+
+	if !strings.Contains(msg, GrowthFitsOtherFlavorReason) {
+		t.Errorf("AssignFlavors() message %q does not contain %q", msg, GrowthFitsOtherFlavorReason)
+	}
+	if len(assignment.PodSets) < 2 {
+		t.Fatalf("AssignFlavors() returned %d podsets, want 2", len(assignment.PodSets))
+	}
+	if !assignment.PodSets[0].Status.IsFit() {
+		t.Errorf("PodSet[0] (head) status is not fit: %v", assignment.PodSets[0].Status.Message())
+	}
+	if f := assignment.PodSets[0].Flavors[corev1.ResourceCPU]; f == nil || f.Name != "on-demand" {
+		t.Errorf("PodSet[0] cpu flavor = %v, want on-demand", f)
+	}
+}
