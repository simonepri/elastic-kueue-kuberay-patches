+// A replacement slice refused because its PodSet's running pods keep it on a full flavor says so,
+// and says whether its growth would fit on the flavor it skipped, which is what lets the job
+// reconciler split the growth into its own PodSet.
+func TestGrowthFitsOtherFlavorReason(t *testing.T) {
+	cases := map[string]struct {
+		gate          bool
+		secondGPUs    string
+		minCount      *int32
+		podIndexLabel bool
+		wantMarker    bool
+	}{
+		"the growth fits the second flavor":                                    {gate: true, secondGPUs: "4", wantMarker: true},
+		"the growth does not fit the second flavor":                            {gate: true, secondGPUs: "2"},
+		"the gate off leaves the message as upstream":                          {secondGPUs: "4"},
+		"partial scale-up growth fits second flavor even with pod index label": {gate: true, secondGPUs: "2", minCount: ptr.To[int32](1), podIndexLabel: true, wantMarker: true},
+		"the partial growth does not fit the second flavor with zero quota":    {gate: true, secondGPUs: "0", minCount: ptr.To[int32](1), podIndexLabel: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{
+				features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: tc.gate,
+				features.ElasticJobsViaWorkloadSlicesFlavorSplit:          tc.gate,
+			})
+			ctx, log := utiltesting.ContextWithLog(t)
+			now := time.Now()
+			cq := utiltestingapi.MakeClusterQueue("cq").
+				ResourceGroup(
+					*utiltestingapi.MakeFlavorQuotas("first").Resource("nvidia.com/gpu", "8").Obj(),
+					*utiltestingapi.MakeFlavorQuotas("second").Resource("nvidia.com/gpu", tc.secondGPUs).Obj(),
+				).Obj()
+			replaced := utiltestingapi.MakeWorkload("slice", "default").
+				PodSets(*utiltestingapi.MakePodSet("workers", 8).Request("nvidia.com/gpu", "1").Obj()).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+					utiltestingapi.MakePodSetAssignment("workers").Count(8).Assignment("nvidia.com/gpu", "first", "8").Obj()).Obj(), now).
+				Obj()
+			cache := schdcache.New(utiltesting.NewFakeClient())
+			flavors := map[kueue.ResourceFlavorReference]*kueue.ResourceFlavor{
+				"first":  utiltestingapi.MakeResourceFlavor("first").Obj(),
+				"second": utiltestingapi.MakeResourceFlavor("second").Obj(),
+			}
+			for _, f := range flavors {
+				cache.AddOrUpdateResourceFlavor(log, f)
+			}
+			if err := cache.AddClusterQueue(ctx, cq); err != nil {
+				t.Fatal(err)
+			}
+			if !cache.AddOrUpdateWorkload(ctx, log, replaced) {
+				t.Fatal("Could not add the replaced slice to the cache")
+			}
+			snapshot, err := cache.Snapshot(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			psWrapper := utiltestingapi.MakePodSet("workers", 12).Request("nvidia.com/gpu", "1")
+			if tc.minCount != nil {
+				psWrapper.MinCount = tc.minCount
+			}
+			if tc.podIndexLabel {
+				psWrapper.TopologyRequest = &kueue.PodSetTopologyRequest{PodIndexLabel: ptr.To("apps.kubernetes.io/pod-index")}
+			}
+			probe := workload.NewInfo(log, utiltestingapi.MakeWorkload("probe", "default").
+				PodSets(*psWrapper.Obj()).Obj())
+			assigner := New(probe, snapshot.ClusterQueue("cq"), flavors, false, &testOracle{}, workload.NewInfo(log, replaced),
+				configapi.QuotaCheckBlockUndeclared, resources.NewResourceFormatter(), 0)
+			assignment := assigner.AssignFlavors(ctx, log, nil)
+			if mode := assignment.RepresentativeMode(); mode == Fit {
+				t.Fatalf("AssignFlavors() mode = %s, want the probe refused", mode)
+			}
+			msg := assignment.Message()
+			if !strings.Contains(msg, "since the original workload is assigned: first") {
+				t.Errorf("AssignFlavors() message %q does not name the replaced slice's flavor", msg)
+			}
+			if got := strings.Contains(msg, GrowthFitsOtherFlavorReason); got != tc.wantMarker {
+				t.Errorf("AssignFlavors() message %q has the growth marker = %v, want %v", msg, got, tc.wantMarker)
+			}
+		})
+	}
+}
