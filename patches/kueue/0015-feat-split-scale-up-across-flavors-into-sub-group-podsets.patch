+			NodeLabel("instance-gpu-memory", "40000").
+			Taint(corev1.Taint{Key: "nvidia.com/gpu", Effect: corev1.TaintEffectNoSchedule}).Obj(),
+		"cloudvm-spot-gpu": utiltestingapi.MakeResourceFlavor("cloudvm-spot-gpu").
+			NodeLabel("karpenter.sh/capacity-type", "spot").
+			NodeLabel("instance-gpu-memory", "40000").
+			Taint(corev1.Taint{Key: "nvidia.com/gpu", Effect: corev1.TaintEffectNoSchedule}).Obj(),
+		"on-demand": utiltestingapi.MakeResourceFlavor("on-demand").
+			NodeLabel("karpenter.sh/capacity-type", "on-demand").Obj(),
+		"gpu-a100-80gb-on-demand": utiltestingapi.MakeResourceFlavor("gpu-a100-80gb-on-demand").
+			NodeLabel("karpenter.sh/capacity-type", "on-demand").
+			NodeLabel("instance-gpu-memory", "80000").
+			Taint(corev1.Taint{Key: "nvidia.com/gpu", Effect: corev1.TaintEffectNoSchedule}).Obj(),
+		"gpu-t4-on-demand": utiltestingapi.MakeResourceFlavor("gpu-t4-on-demand").
+			NodeLabel("karpenter.sh/capacity-type", "on-demand").
+			NodeLabel("instance-gpu-memory", "16000").
+			Taint(corev1.Taint{Key: "nvidia.com/gpu", Effect: corev1.TaintEffectNoSchedule}).Obj(),
+	}
+
+	headAffinity := &corev1.Affinity{
+		NodeAffinity: &corev1.NodeAffinity{
+			RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{
+				NodeSelectorTerms: []corev1.NodeSelectorTerm{
+					{
+						MatchExpressions: []corev1.NodeSelectorRequirement{
+							{
+								Key:      "karpenter.sh/capacity-type",
+								Operator: corev1.NodeSelectorOpIn,
+								Values:   []string{"reserved", "on-demand"},
+							},
+						},
+					},
+				},
+			},
+		},
+	}
+
+	workerAffinity := &corev1.Affinity{
+		NodeAffinity: &corev1.NodeAffinity{
+			RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{
+				NodeSelectorTerms: []corev1.NodeSelectorTerm{
+					{
+						MatchExpressions: []corev1.NodeSelectorRequirement{
+							{
+								Key:      "instance-gpu-memory",
