+// Tells the job reconciler when the growth of a replacement slice would fit on a flavor that the
+// PodSet's running pods keep it off, so it can split that growth into its own PodSet.
+
+package flavorassigner
+
+import (
+	"context"
+
+	corev1 "k8s.io/api/core/v1"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/resources"
+	"sigs.k8s.io/kueue/pkg/util/tas"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// GrowthFitsOtherFlavorReason is the condition reason given to QuotaReserved when the flavor
+// assigner skips a flavor because the replaced slice keeps the PodSet on another flavor, but the
+// PodSet's growth over the replaced slice would fit on the skipped flavor without preemption. With
+// ElasticJobsViaWorkloadSlicesFlavorSplit, the job reconciler splits the growth of a refused slice
+// only when its QuotaReserved condition reason matches this (see workloadslicing.SplitGrowth), so
+// a slice that no other flavor would take keeps its PodSets.
+const GrowthFitsOtherFlavorReason = "GrowthFitsOtherFlavor"
+
+// growthFits reports whether the growth of the PodSets psIDs over the slice that the workload
+// replaces fits on the flavor fName without preemption, for every resource in requests. PodSets
+// that do not grow report false, since only growth can move to a split PodSet.
+func (a *FlavorAssigner) growthFits(ctx context.Context, fName kueue.ResourceFlavorReference, psIDs []int, requests resources.Requests, assignmentUsage resources.FlavorResourceQuantities) bool {
+	fits, grows := true, false
+	requests.ForEach(func(rName corev1.ResourceName, val resources.Amount) {
+		if !fits {
+			return
+		}
+		for _, psID := range psIDs {
+			if replaced := podSetResourcesByName(a.replaceWorkloadSlice.TotalRequests, a.wl.Obj.Spec.PodSets[psID].Name); replaced != nil && replaced.Requests != nil {
+				val = val.Sub(replaced.Requests.ResourceValue(rName))
+			}
+		}
+		if val.Sign() > 0 {
+			grows = true
+		}
+		if len(psIDs) == 1 && a.wl.Obj.Spec.PodSets[psIDs[0]].MinCount != nil &&
+			!tas.HasTopologyConstraint(a.wl.Obj.Spec.PodSets[psIDs[0]].TopologyRequest) &&
+			workload.PodSetCountSteps(a.wl.Obj)[a.wl.Obj.Spec.PodSets[psIDs[0]].Name] <= 1 {
+			psID := psIDs[0]
+			if psRes := podSetResourcesByName(a.wl.TotalRequests, a.wl.Obj.Spec.PodSets[psID].Name); psRes != nil && psRes.PerPodRequests != nil {
+				podVal := psRes.PerPodRequests.ResourceValue(rName)
+				if val.Cmp(podVal) >= 0 {
+					val = podVal
+				}
+			}
+		}
+		fr := resources.FlavorResource{Flavor: fName, Resource: rName}
+		mode, _, _ := a.fitsResourceQuota(ctx, fr, assignmentUsage[fr], val, a.cq.QuotaFor(fr))
+		fits = mode == fit
+	})
+	return fits && grows
+}
