+func TestReconcileAssertsTheStopWhileWorkersRunAboveTheTarget(t *testing.T) {
+	testCases := map[string]struct {
+		rewrite func(*rayv1.WorkerGroupSpec)
+	}{
+		"the autoscaler drops the workers to delete": {
+			rewrite: func(wgs *rayv1.WorkerGroupSpec) { wgs.ScaleStrategy.WorkersToDelete = nil },
+		},
+		"the autoscaler raises the replicas": {
+			rewrite: func(wgs *rayv1.WorkerGroupSpec) { wgs.Replicas = ptr.To[int32](4) },
+		},
+		"the autoscaler does both": {
+			rewrite: func(wgs *rayv1.WorkerGroupSpec) {
+				wgs.Replicas = ptr.To[int32](4)
+				wgs.ScaleStrategy.WorkersToDelete = nil
+			},
+		},
+	}
+	for name, tc := range testCases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			fixture := newPartialStopFixture(t, interceptor.Funcs{})
+			fixture.reconcile(t)
+			if got := ptr.Deref(fixture.group(t).Replicas, -1); got != 2 {
+				t.Fatalf("Replicas after the first reconcile = %d, want 2", got)
+			}
+
+			var cluster rayv1.RayCluster
+			if err := fixture.kClient.Get(ctx, client.ObjectKeyFromObject(fixture.job), &cluster); err != nil {
+				t.Fatalf("Get() error: %v", err)
+			}
+			tc.rewrite(&cluster.Spec.WorkerGroupSpecs[0])
+			if err := fixture.kClient.Update(ctx, &cluster); err != nil {
+				t.Fatalf("Update() error: %v", err)
+			}
+
+			fixture.reconcile(t)
+			group := fixture.group(t)
+			if got := ptr.Deref(group.Replicas, -1); got != 2 {
+				t.Errorf("Replicas after the next reconcile = %d, want 2", got)
+			}
+			if diff := cmp.Diff([]string{"w-2", "w-3"}, group.ScaleStrategy.WorkersToDelete); diff != "" {
+				t.Errorf("WorkersToDelete after the next reconcile (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
