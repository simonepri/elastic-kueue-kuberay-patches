+// A job started with a split admission, as after a readmission, gets one info per PodSet of
+// its own, in order, so integrations that apply the infos by position still line up.
+func TestGetPodSetsInfoFromStatusSkipsSplitEntries(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	now := time.Now()
+	cl := utiltesting.NewClientBuilder().WithObjects(
+		utiltestingapi.MakeResourceFlavor("reserved").Obj(),
+		utiltestingapi.MakeResourceFlavor("spot").Obj(),
+	).Build()
+	wl := utiltestingapi.MakeWorkload("slice", "ns").
+		PodSets(
+			*utiltestingapi.MakePodSet("head", 1).Obj(),
+			*utiltestingapi.MakePodSet("workers", 8).Obj(),
+			*utiltestingapi.MakePodSet("workers--2", 4).Annotations(map[string]string{workloadslicing.FlavorSplitOfAnnotation: "workers"}).Obj(),
+		).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment("head").Assignment(corev1.ResourceCPU, "reserved", "1").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers").Count(8).Assignment(corev1.ResourceCPU, "reserved", "1").Obj(),
+			utiltestingapi.MakePodSetAssignment("workers--2").Count(4).Assignment(corev1.ResourceCPU, "spot", "1").Obj(),
+		).Obj(), now).
+		Obj()
+	infos, err := getPodSetsInfoFromStatus(ctx, cl, wl, false)
+	if err != nil {
+		t.Fatalf("getPodSetsInfoFromStatus() error: %v", err)
+	}
+	var names, labels []string
+	for _, info := range infos {
+		names = append(names, string(info.Name))
+		labels = append(labels, info.Labels[constants.PodSetLabel])
+	}
+	if diff := cmp.Diff([]string{"head", "workers"}, names); diff != "" {
+		t.Errorf("getPodSetsInfoFromStatus() names (-want,+got):\n%s", diff)
+	}
+	if diff := cmp.Diff([]string{"head", "workers"}, labels); diff != "" {
+		t.Errorf("getPodSetsInfoFromStatus() PodSet labels (-want,+got):\n%s", diff)
+	}
+}
