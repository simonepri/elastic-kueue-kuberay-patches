+// splitPodSet returns a split entry of base with count pods.
+func splitPodSet(base, name string, count int) kueue.PodSet {
+	return *utiltestingapi.MakePodSet(kueue.PodSetReference(name), count).
+		Annotations(map[string]string{FlavorSplitOfAnnotation: base}).
+		Request(corev1.ResourceCPU, "1").Obj()
+}
+
+func plainPodSet(name string, count int) kueue.PodSet {
+	return *utiltestingapi.MakePodSet(kueue.PodSetReference(name), count).Request(corev1.ResourceCPU, "1").Obj()
+}
+
+func TestEntryCountsForJob(t *testing.T) {
+	split := []kueue.PodSet{plainPodSet("head", 1), plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4), splitPodSet("workers", "workers--3", 2)}
+	cases := map[string]struct {
+		podSets     []kueue.PodSet
+		jobCounts   workload.PodSetsCounts
+		running     workload.PodSetsCounts
+		want        workload.PodSetsCounts
+		wantSettled bool
+	}{
+		"without split entries the job's counts are returned": {
+			podSets:     []kueue.PodSet{plainPodSet("workers", 8)},
+			jobCounts:   workload.PodSetsCounts{"workers": 5},
+			want:        workload.PodSetsCounts{"workers": 5},
+			wantSettled: true,
+		},
+		"equal totals keep every entry": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 14},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 2},
+			wantSettled: true,
+		},
+		"growth goes to the newest entry": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 17},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 5},
+			wantSettled: true,
+		},
+		"a shrink without pods takes the newest entries first": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 9},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 1, "workers--3": 0},
+			wantSettled: true,
+		},
+		"a shrink with pods follows the entries that lost them": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 12},
+			running:     workload.PodSetsCounts{"head": 1, "workers": 6, "workers--2": 4, "workers--3": 2},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 6, "workers--2": 4, "workers--3": 2},
+			wantSettled: true,
+		},
+		"pods not started yet go to the oldest entries, so the newest shrink first": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 11},
+			running:     workload.PodSetsCounts{"head": 1, "workers": 6, "workers--2": 1},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 3, "workers--3": 0},
+			wantSettled: true,
+		},
+		"more running pods than the job asks for is not settled": {
+			podSets:   split,
+			jobCounts: workload.PodSetsCounts{"head": 1, "workers": 12},
+			running:   workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 2},
+		},
+		"a job PodSet without entries keeps its key": {
+			podSets:     split,
+			jobCounts:   workload.PodSetsCounts{"head": 1, "workers": 14, "other": 2},
+			want:        workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4, "workers--3": 2, "other": 2},
+			wantSettled: true,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got, settled := entryCountsForJob(tc.podSets, tc.jobCounts, tc.running)
+			if settled != tc.wantSettled {
+				t.Fatalf("entryCountsForJob() settled = %v, want %v", settled, tc.wantSettled)
+			}
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("entryCountsForJob() (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestFoldSplitCounts(t *testing.T) {
+	podSets := []kueue.PodSet{plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)}
+	got := FoldSplitCounts(podSets, workload.PodSetsCounts{"workers": 8, "workers--2": 3})
+	if diff := cmp.Diff(workload.PodSetsCounts{"workers": 11}, got); diff != "" {
+		t.Errorf("FoldSplitCounts() (-want,+got):\n%s", diff)
+	}
+}
+
+func TestCarrySplitEntries(t *testing.T) {
+	prevWith := func(podSets ...kueue.PodSet) *kueue.Workload {
+		return utiltestingapi.MakeWorkload("prev", "ns").PodSets(podSets...).Obj()
+	}
+	cases := map[string]struct {
+		jobPodSets []kueue.PodSet
+		prev       *kueue.Workload
+		want       workload.PodSetsCounts
+		wantNames  []kueue.PodSetReference
+	}{
+		"no predecessor keeps the job's PodSets": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 12)},
+			want:       workload.PodSetsCounts{"workers": 12},
+			wantNames:  []kueue.PodSetReference{"workers"},
+		},
+		"a predecessor without split entries keeps the job's PodSets": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 12)},
+			prev:       prevWith(plainPodSet("workers", 8)),
+			want:       workload.PodSetsCounts{"workers": 12},
+			wantNames:  []kueue.PodSetReference{"workers"},
+		},
+		"growth goes to the newest entry": {
+			jobPodSets: []kueue.PodSet{plainPodSet("head", 1), plainPodSet("workers", 14)},
+			prev:       prevWith(plainPodSet("head", 1), plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)),
+			want:       workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 6},
+			wantNames:  []kueue.PodSetReference{"head", "workers", "workers--2"},
+		},
+		"an entry at 0 is dropped": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 10)},
+			prev:       prevWith(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 0), splitPodSet("workers", "workers--3", 1)),
+			want:       workload.PodSetsCounts{"workers": 8, "workers--3": 2},
+			wantNames:  []kueue.PodSetReference{"workers", "workers--3"},
+		},
+		"the job's own entry is kept at 0": {
+			jobPodSets: []kueue.PodSet{plainPodSet("workers", 5)},
+			prev:       prevWith(plainPodSet("workers", 0), splitPodSet("workers", "workers--2", 4)),
+			want:       workload.PodSetsCounts{"workers": 0, "workers--2": 5},
+			wantNames:  []kueue.PodSetReference{"workers", "workers--2"},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			got := CarrySplitEntries(tc.jobPodSets, tc.prev)
+			if diff := cmp.Diff(tc.want, workload.ExtractPodSetCounts(got)); diff != "" {
+				t.Errorf("CarrySplitEntries() counts (-want,+got):\n%s", diff)
+			}
+			names := make([]kueue.PodSetReference, len(got))
+			for i := range got {
+				names[i] = got[i].Name
+			}
+			if diff := cmp.Diff(tc.wantNames, names); diff != "" {
+				t.Errorf("CarrySplitEntries() names (-want,+got):\n%s", diff)
+			}
+			for i := range got {
+				if IsSplitEntry(&got[i]) && SplitBase(&got[i]) != "workers" {
+					t.Errorf("Split entry %s is of %s, want workers", got[i].Name, SplitBase(&got[i]))
+				}
+			}
+		})
+	}
+}
+
+func TestExpandToSplitEntries(t *testing.T) {
+	podSets := []kueue.PodSet{plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)}
+	floors, steps := ExpandToSplitEntries(podSets, workload.PodSetsCounts{"workers": 2}, workload.PodSetsCounts{"workers": 1})
+	if diff := cmp.Diff(workload.PodSetsCounts{"workers": 2, "workers--2": 0}, floors); diff != "" {
+		t.Errorf("ExpandToSplitEntries() floors (-want,+got):\n%s", diff)
+	}
+	if diff := cmp.Diff(workload.PodSetsCounts{"workers": 1, "workers--2": 1}, steps); diff != "" {
+		t.Errorf("ExpandToSplitEntries() steps (-want,+got):\n%s", diff)
+	}
+}
+
+func TestSplitGrowth(t *testing.T) {
+	now := time.Now()
+	admitted := func(podSets ...kueue.PodSet) *kueue.Workload {
+		var assignments []kueue.PodSetAssignment
+		for _, ps := range podSets {
+			assignments = append(assignments, utiltestingapi.MakePodSetAssignment(ps.Name).Count(ps.Count).Assignment(corev1.ResourceCPU, "reserved", "1").Obj())
+		}
+		admission := utiltestingapi.MakeAdmission("cq").PodSets(assignments...)
+		return utiltestingapi.MakeWorkload("slice", "ns").PodSets(podSets...).
+			ReserveQuotaAt(admission.Obj(), now).AdmittedAt(true, now).Obj()
+	}
+	full := func() []kueue.PodSet {
+		ps := []kueue.PodSet{plainPodSet("head", 1), plainPodSet("workers", 8)}
+		for i := 2; i <= 7; i++ {
+			ps = append(ps, splitPodSet("workers", "workers--"+string(rune('0'+i)), 1))
+		}
+		return ps
+	}
+	cases := map[string]struct {
+		probe     *kueue.Workload
+		replaced  *kueue.Workload
+		partial   bool
+		want      workload.PodSetsCounts
+		wantMin   map[kueue.PodSetReference]*int32
+		wantFloor workload.PodSetsCounts
+	}{
+		"growth of a PodSet moves to a new split entry": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("head", 1), plainPodSet("workers", 12)).Obj(),
+			replaced: admitted(plainPodSet("head", 1), plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 4},
+			wantMin:  map[kueue.PodSetReference]*int32{"head": nil, "workers": nil, "workers--2": nil},
+		},
+		"partial scale-up admits a new entry down to one pod": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				Annotation(constants.ReclaimMinCountsAnnotation, "workers=2").
+				PodSets(*utiltestingapi.MakePodSet("workers", 12).SetMinimumCount(8).Request(corev1.ResourceCPU, "1").Obj()).Obj(),
+			replaced:  admitted(plainPodSet("workers", 8)),
+			partial:   true,
+			want:      workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+			wantMin:   map[kueue.PodSetReference]*int32{"workers": ptr.To[int32](8), "workers--2": ptr.To[int32](1)},
+			wantFloor: workload.PodSetsCounts{"workers": 2, "workers--2": 0},
+		},
+		"growth of a split entry moves to the next one": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 6)).Obj(),
+			replaced: admitted(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)),
+			want:     workload.PodSetsCounts{"workers": 8, "workers--2": 4, "workers--3": 2},
+			wantMin:  map[kueue.PodSetReference]*int32{"workers": nil, "workers--2": nil, "workers--3": nil},
+		},
+		"regrowth after a partial reclaim of an older entry moves to a new entry": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)).Obj(),
+			replaced: func() *kueue.Workload {
+				wl := admitted(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4))
+				workload.SetReclaimTargetCounts(wl, workload.PodSetsCounts{"workers": 2})
+				wl.Status.ReclaimablePods = []kueue.ReclaimablePod{{Name: "workers", Count: 6}}
+				return wl
+			}(),
+			want: workload.PodSetsCounts{"workers": 2, "workers--2": 4, "workers--3": 6},
+		},
+		"a newest entry the replaced slice does not run is not split again": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 8), splitPodSet("workers", "workers--2", 4)).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+		},
+		"a PodSet with no running pods may move whole, so it is not split": {
+			probe:    utiltestingapi.MakeWorkload("probe", "ns").PodSets(plainPodSet("workers", 4)).Obj(),
+			replaced: admitted(plainPodSet("workers", 0)),
+			want:     workload.PodSetsCounts{"workers": 4},
+		},
+		"a PodSet with a count step above 1 is not split": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				Annotation(constants.PodSetCountStepsAnnotation, "workers=2").
+				PodSets(plainPodSet("workers", 12)).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 12},
+		},
+		"a PodSet with a topology request is not split": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				PodSets(*utiltestingapi.MakePodSet("workers", 12).RequiredTopologyRequest("rack").Request(corev1.ResourceCPU, "1").Obj()).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 12},
+		},
+		"a PodSet whose topology request only names pod index labels is split": {
+			probe: utiltestingapi.MakeWorkload("probe", "ns").
+				PodSets(*utiltestingapi.MakePodSet("workers", 12).PodIndexLabel(ptr.To("ray.io/worker-group-replica-index")).Request(corev1.ResourceCPU, "1").Obj()).Obj(),
+			replaced: admitted(plainPodSet("workers", 8)),
+			want:     workload.PodSetsCounts{"workers": 8, "workers--2": 4},
+		},
+		"a Workload with the most PodSets the API allows is not split": {
+			probe: func() *kueue.Workload {
+				ps := full()
+				ps[len(ps)-1].Count = 3
+				return utiltestingapi.MakeWorkload("probe", "ns").PodSets(ps...).Obj()
+			}(),
+			replaced: admitted(full()...),
+			want: workload.PodSetsCounts{"head": 1, "workers": 8, "workers--2": 1, "workers--3": 1, "workers--4": 1,
+				"workers--5": 1, "workers--6": 1, "workers--7": 3},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			probe := tc.probe.DeepCopy()
+			changed := SplitGrowth(probe, tc.replaced, tc.partial)
+			got := workload.ExtractPodSetCountsFromWorkload(probe)
+			if diff := cmp.Diff(tc.want, got); diff != "" {
+				t.Errorf("SplitGrowth() counts (-want,+got):\n%s", diff)
+			}
+			if wantChanged := len(tc.want) != len(tc.probe.Spec.PodSets); changed != wantChanged {
+				t.Errorf("SplitGrowth() = %v, want %v", changed, wantChanged)
+			}
+			for i := range probe.Spec.PodSets {
+				ps := &probe.Spec.PodSets[i]
+				if want, found := tc.wantMin[ps.Name]; found {
+					if diff := cmp.Diff(want, ps.MinCount); diff != "" {
+						t.Errorf("SplitGrowth() minCount of %s (-want,+got):\n%s", ps.Name, diff)
+					}
+				}
+				if len(ps.Name) > len("workers") && SplitBase(ps) != "workers" {
+					t.Errorf("SplitGrowth() entry %s is of %q, want workers", ps.Name, SplitBase(ps))
+				}
+			}
+			if tc.wantFloor != nil {
+				if diff := cmp.Diff(tc.wantFloor, workload.ReclaimMinCounts(probe)); diff != "" {
+					t.Errorf("SplitGrowth() floors (-want,+got):\n%s", diff)
+				}
+			}
+		})
+	}
+}
