+func TestReconcileDoesNotMarkADeeperRequestStopped(t *testing.T) {
+	deeperAt := time.Now().Truncate(time.Second).Add(10 * time.Second).UTC().Format(time.RFC3339)
+	conflicted := false
+	var fixture *partialStopFixture
+	fixture = newPartialStopFixture(t, interceptor.Funcs{
+		Patch: func(ctx context.Context, c client.WithWatch, obj client.Object, patch client.Patch, opts ...client.PatchOption) error {
+			if _, ok := obj.(*kueue.Workload); !ok || conflicted {
+				return c.Patch(ctx, obj, patch, opts...)
+			}
+			// The scheduler deepens the target between the stop and its mark.
+			conflicted = true
+			var latest kueue.Workload
+			if err := c.Get(ctx, client.ObjectKeyFromObject(obj), &latest); err != nil {
+				return err
+			}
+			latest.Annotations[constants.ReclaimTargetCountsAnnotation] = workload.FormatPodSetCounts(workload.PodSetsCounts{fixture.workers: 1})
+			latest.Annotations[constants.ReclaimRequestedAtAnnotation] = deeperAt
+			if err := c.Update(ctx, &latest); err != nil {
+				return err
+			}
+			return apierrors.NewConflict(kueue.Resource("workloads"), obj.GetName(), nil)
+		},
+	})
+
+	result := fixture.reconcile(t)
+	if !conflicted {
+		t.Fatal("The Workload mark was never patched")
+	}
+	if !workload.ReclaimStopPending(fixture.workload(t)) {
+		t.Errorf("The deeper request is marked stopped (%s=%q) though nothing stopped for it",
+			constants.ReclaimStoppedAtAnnotation, fixture.workload(t).Annotations[constants.ReclaimStoppedAtAnnotation])
+	}
+	if !result.Requeue && result.RequeueAfter == 0 {
+		t.Error("Reconcile() did not requeue to stop for the deeper request")
+	}
+
+	fixture.reconcile(t)
+	if got := ptr.Deref(fixture.group(t).Replicas, -1); got != 1 {
+		t.Errorf("Replicas after the next reconcile = %d, want 1, the deeper target", got)
+	}
+	if got := fixture.workload(t).Annotations[constants.ReclaimStoppedAtAnnotation]; got != deeperAt {
+		t.Errorf("%s = %q, want %q once the workers are stopped for it", constants.ReclaimStoppedAtAnnotation, got, deeperAt)
+	}
+}
