+// The job reconciler's side of flavor-split PodSets: new slices keep the split entries of
+// the slice they replace, and the job's templates get the info of its own PodSets only.
+
+package jobframework
+
+import (
+	"context"
+
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	"k8s.io/klog/v2"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/podset"
+	"sigs.k8s.io/kueue/pkg/util/slices"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// carrySplitEntries returns the PodSets of a new slice for the job: its own PodSets with their
+// clean templates (cleaned by stripInjectedAdmission), plus the split entries of that active
+// slice (see workloadslicing.CarrySplitEntries).
+func carrySplitEntries(ctx context.Context, c client.Client, job GenericJob, podSets []kueue.PodSet) ([]kueue.PodSet, error) {
+	prev, err := workloadslicing.FindLatestActiveWorkload(ctx, c, job.Object(), job.GVK())
+	if err != nil {
+		return nil, err
+	}
+	return workloadslicing.CarrySplitEntries(podSets, prev), nil
+}
+
+// stripInjectedAdmission strips from the probe's templates exactly the nodeSelector,
+// tolerations, labels, and annotations that Kueue's predecessor admission injected
+// (podset.FromAssignment + deferFlavorPlacementToPods), preserving any user edits to the job templates.
+func stripInjectedAdmission(ctx context.Context, c client.Client, job GenericJob, podSets []kueue.PodSet) error {
+	prev, err := workloadslicing.FindLatestActiveWorkload(ctx, c, job.Object(), job.GVK())
+	if err != nil || prev == nil || prev.Status.Admission == nil {
+		return err
+	}
+	prevPodSets := make(map[kueue.PodSetReference]*kueue.PodSet, len(prev.Spec.PodSets))
+	for i := range prev.Spec.PodSets {
+		prevPodSets[prev.Spec.PodSets[i].Name] = &prev.Spec.PodSets[i]
+	}
+	prevPSAs := make(map[kueue.PodSetReference]*kueue.PodSetAssignment, len(prev.Status.Admission.PodSetAssignments))
+	for i := range prev.Status.Admission.PodSetAssignments {
+		prevPSAs[prev.Status.Admission.PodSetAssignments[i].Name] = &prev.Status.Admission.PodSetAssignments[i]
+	}
+
+	for i := range podSets {
+		psName := podSets[i].Name
+		psa, found := prevPSAs[psName]
+		ps := prevPodSets[psName]
+		if !found || ps == nil {
+			continue
+		}
+		info, err := podset.FromAssignment(ctx, c, psa, ps)
+		if err != nil {
+			if !apierrors.IsNotFound(err) {
+				return err
+			}
+			ctrl.LoggerFrom(ctx).V(2).Info("Predecessor ResourceFlavor not found; skipping admission info strip for podset", "workload", klog.KObj(prev), "podSet", psName, "error", err)
+			info = podset.PodSetInfo{
+				Name:         psa.Name,
+				NodeSelector: make(map[string]string),
+				Labels:       make(map[string]string),
+				Annotations:  make(map[string]string),
+			}
+		}
+		if workloadslicing.IsElasticWorkload(prev) {
+			info.Annotations[kueue.WorkloadSliceNameAnnotation] = workloadslicing.SliceName(prev)
+		}
+		info.Labels[constants.PodSetLabel] = string(psa.Name)
+		AssignQueueLabels(ctx, info.Labels, prev)
+
+		for _, check := range prev.Status.AdmissionChecks {
+			for _, psUpdate := range check.PodSetUpdates {
+				if psUpdate.Name != psa.Name {
+					continue
+				}
+				for key, value := range psUpdate.Annotations {
+					if info.Annotations == nil {
+						info.Annotations = make(map[string]string)
+					}
+					info.Annotations[key] = value
+				}
+				for key, value := range psUpdate.NodeSelector {
+					if info.NodeSelector == nil {
+						info.NodeSelector = make(map[string]string)
+					}
+					info.NodeSelector[key] = value
+				}
+				info.Tolerations = append(info.Tolerations, psUpdate.Tolerations...)
+			}
+		}
+
+		if prev.Annotations[workloadslicing.FlavorPlacementOnPodsAnnotation] == "true" && ungatedByElasticJobUngater(prev, psa.Name) {
+			baseByName, err := flavorInfoByPodSet(ctx, c, prev)
+			if err != nil && !apierrors.IsNotFound(err) {
+				return err
+			}
+			if base, found := baseByName[psa.Name]; found {
+				for key, value := range base.NodeSelector {
+					if info.NodeSelector[key] == value {
+						delete(info.NodeSelector, key)
+					}
+				}
+				info.Tolerations = slices.Pick(info.Tolerations, func(t *corev1.Toleration) bool {
+					for j := range base.Tolerations {
+						if base.Tolerations[j].MatchToleration(t) {
+							return false
+						}
+					}
+					return true
+				})
+			}
+		}
+
+		template := &podSets[i].Template
+		for k, v := range info.NodeSelector {
+			if template.Spec.NodeSelector != nil && template.Spec.NodeSelector[k] == v {
+				// Strip only when the predecessor Workload's spec.podSets original template lacked this key
+				if ps.Template.Spec.NodeSelector == nil || ps.Template.Spec.NodeSelector[k] != v {
+					delete(template.Spec.NodeSelector, k)
+				}
+			}
+		}
+		if len(template.Spec.NodeSelector) == 0 {
+			template.Spec.NodeSelector = nil
+		}
+
+		if len(template.Spec.Tolerations) > 0 && len(info.Tolerations) > 0 {
+			template.Spec.Tolerations = slices.Pick(template.Spec.Tolerations, func(t *corev1.Toleration) bool {
+				// If the predecessor Workload's original template already had this toleration, keep it (user-set).
+				for j := range ps.Template.Spec.Tolerations {
+					if ps.Template.Spec.Tolerations[j].MatchToleration(t) {
+						return true
+					}
+				}
+				// Otherwise, if it matches an injected toleration, strip it.
+				for j := range info.Tolerations {
+					if info.Tolerations[j].MatchToleration(t) {
+						return false
+					}
+				}
+				return true
+			})
+			if len(template.Spec.Tolerations) == 0 {
+				template.Spec.Tolerations = nil
+			}
+		}
+
+		if len(template.Spec.SchedulingGates) > 0 && len(info.SchedulingGates) > 0 {
+			template.Spec.SchedulingGates = slices.Pick(template.Spec.SchedulingGates, func(g *corev1.PodSchedulingGate) bool {
+				// If the predecessor Workload's original template already had this scheduling gate, keep it (user-set).
+				for j := range ps.Template.Spec.SchedulingGates {
+					if ps.Template.Spec.SchedulingGates[j].Name == g.Name {
+						return true
+					}
+				}
+				// Otherwise, if it matches an injected scheduling gate, strip it.
+				for j := range info.SchedulingGates {
+					if info.SchedulingGates[j].Name == g.Name {
+						return false
+					}
+				}
+				return true
+			})
+			if len(template.Spec.SchedulingGates) == 0 {
+				template.Spec.SchedulingGates = nil
+			}
+		}
+
+		for k, v := range info.Labels {
+			if template.Labels != nil && template.Labels[k] == v {
+				// Strip only when the predecessor Workload's spec.podSets original template lacked it
+				if ps.Template.Labels == nil || ps.Template.Labels[k] != v {
+					delete(template.Labels, k)
+				}
+			}
+		}
+		if len(template.Labels) == 0 {
+			template.Labels = nil
+		}
+
+		for k, v := range info.Annotations {
+			if template.Annotations != nil && template.Annotations[k] == v {
+				// Strip only when the predecessor Workload's spec.podSets original template lacked it
+				if ps.Template.Annotations == nil || ps.Template.Annotations[k] != v {
+					delete(template.Annotations, k)
+				}
+			}
