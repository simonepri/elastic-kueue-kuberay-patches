+func TestDeletePodGroupsAboveCountsKeepsOtherEntries(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	wl := utiltestingapi.MakeWorkload("slice", "ns").Annotation(kueue.WorkloadSliceNameAnnotation, "origin").Obj()
+	pod := func(name, podSet string) *corev1.Pod {
+		return testingpod.MakePod(name, "ns").Annotation(kueue.WorkloadSliceNameAnnotation, "origin").Label(constants.PodSetLabel, podSet).Obj()
+	}
+	objs := []client.Object{pod("r1", "workers"), pod("r2", "workers"), pod("s1", "workers--2"), pod("s2", "workers--2")}
+	clnt := utiltesting.NewClientBuilder().WithObjects(objs...).
+		WithIndex(&corev1.Pod{}, indexer.WorkloadSliceNameKey, indexer.IndexPodWorkloadSliceName).Build()
+	// Reclaiming the flavor of "workers" stops its pods only.
+	if _, err := DeletePodGroupsAboveCounts(ctx, clnt, wl, workload.PodSetsCounts{"workers": 0}, func(p *corev1.Pod) string { return p.Name }); err != nil {
+		t.Fatalf("DeletePodGroupsAboveCounts() error: %v", err)
+	}
+	var pods corev1.PodList
+	if err := clnt.List(ctx, &pods); err != nil {
+		t.Fatal(err)
+	}
+	var left []string
+	for _, p := range pods.Items {
+		left = append(left, p.Name)
+	}
+	if diff := cmp.Diff([]string{"s1", "s2"}, left); diff != "" {
+		t.Errorf("Pods left (-want,+got):\n%s", diff)
+	}
+}
