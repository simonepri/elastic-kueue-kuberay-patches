+		Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+		Annotation(constants.ReclaimTargetCountsAnnotation, workload.FormatPodSetCounts(workload.PodSetsCounts{f.workers: 2})).
+		Annotation(constants.ReclaimRequestedAtAnnotation, now.UTC().Format(time.RFC3339)).
+		ControllerReference(gvk, f.job.Name, string(f.job.UID)).
+		PodSets(podSets...).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+			utiltestingapi.MakePodSetAssignment(podSets[0].Name).Obj(),
+			utiltestingapi.MakePodSetAssignment(f.workers).Count(4).Obj(),
+		).Obj(), now).
+		AdmittedAt(true, now).
+		Obj()
+	objs := []client.Object{utiltesting.MakeNamespace("ns"), f.job, f.wl}
+	for i := range 4 {
+		objs = append(objs, testingpod.MakePod("w-"+string(rune('0'+i)), "ns").
+			Annotation(kueue.WorkloadSliceNameAnnotation, f.wl.Name).
+			Label(constants.PodSetLabel, string(f.workers)).
