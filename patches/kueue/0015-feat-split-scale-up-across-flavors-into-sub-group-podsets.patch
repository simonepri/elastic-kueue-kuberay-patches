+func TestUngateSplitEntries(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	spotToleration := corev1.Toleration{Key: "example.com/spot", Operator: corev1.TolerationOpExists, Effect: corev1.TaintEffectNoSchedule}
+	flavors := []client.Object{
+		utiltestingapi.MakeResourceFlavor("reserved").NodeLabel("example.com/pool", "reserved").Obj(),
+		utiltestingapi.MakeResourceFlavor("spot").NodeLabel("example.com/pool", "spot").Toleration(spotToleration).Obj(),
+	}
+	const split kueue.PodSetReference = "workers--2"
+	// wl runs workers on "reserved" with reserved pods granted, and the split entry on "spot"
+	// with spot pods granted.
+	wl := func(reserved, spot int32) *kueue.Workload {
+		w := utiltestingapi.MakeWorkload("wl", "ns").
+			Finalizers(kueue.ResourceInUseFinalizerName).
+			Annotation(workloadslicing.EnabledAnnotationKey, workloadslicing.EnabledAnnotationValue).
+			Annotation(workloadslicing.FlavorPlacementOnPodsAnnotation, "true").
+			ControllerReference(rayClusterGVK, "ray", "ray-uid").
+			PodSets(
+				*utiltestingapi.MakePodSet(workersPodSet, int(reserved)).Request(corev1.ResourceCPU, "1").Obj(),
+				*utiltestingapi.MakePodSet(split, int(spot)).
+					Annotations(map[string]string{workloadslicing.FlavorSplitOfAnnotation: string(workersPodSet)}).
+					Request(corev1.ResourceCPU, "1").Obj(),
+			).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(
+				utiltestingapi.MakePodSetAssignment(workersPodSet).Count(reserved).Assignment(corev1.ResourceCPU, "reserved", "1").Obj(),
+				utiltestingapi.MakePodSetAssignment(split).Count(spot).Assignment(corev1.ResourceCPU, "spot", "1").Obj(),
+			).Obj(), now).
+			AdmittedAt(true, now).
+			Obj()
+		w.CreationTimestamp = metav1.NewTime(now)
+		return w
+	}
+	gated := func(name string, podSet kueue.PodSetReference) *corev1.Pod {
+		return makeElasticPodForPodSet(name, podSet).Gate(kueue.ElasticJobSchedulingGate).CreationTimestamp(now).Obj()
+	}
+	running := func(name string, podSet kueue.PodSetReference) *corev1.Pod {
+		return makeElasticPodForPodSet(name, podSet).CreationTimestamp(now).Obj()
+	}
+	onReserved := func(name string) corev1.Pod {
+		return *makeElasticPodForPodSet(name, workersPodSet).NodeSelector("example.com/pool", "reserved").CreationTimestamp(now).Obj()
+	}
+	onSpot := func(name string) corev1.Pod {
+		p := makeElasticPodForPodSet(name, split).NodeSelector("example.com/pool", "spot").CreationTimestamp(now).Obj()
+		p.Spec.Tolerations = []corev1.Toleration{spotToleration}
+		return *p
+	}
+	cases := map[string]struct {
+		workload *kueue.Workload
+		pods     []*corev1.Pod
+		wantPods []corev1.Pod
+	}{
+		"the PodSet's own entry fills first, then the split entry takes the rest on its flavor": {
+			workload: wl(1, 2),
+			pods:     []*corev1.Pod{gated("a", workersPodSet), gated("b", workersPodSet), gated("c", workersPodSet)},
+			wantPods: []corev1.Pod{onReserved("a"), onSpot("b"), onSpot("c")},
+		},
+		"running pods keep their entry and count toward it": {
+			workload: wl(1, 2),
+			pods:     []*corev1.Pod{running("a", workersPodSet), running("b", split), gated("c", workersPodSet), gated("d", workersPodSet)},
+			wantPods: []corev1.Pod{
+				*running("a", workersPodSet), *running("b", split), onSpot("c"),
+				*gated("d", workersPodSet),
+			},
+		},
+		"a replacement pod of a stopped split pod starts in the entry with room": {
+			workload: wl(2, 1),
+			pods:     []*corev1.Pod{running("a", workersPodSet), running("b", split), gated("c", workersPodSet)},
+			wantPods: []corev1.Pod{*running("a", workersPodSet), *running("b", split), onReserved("c")},
+		},
+		"split entry gets flavor placement when flavor placement on pods is false and base pods keep template selector": {
+			workload: func() *kueue.Workload {
+				w := wl(1, 1)
+				delete(w.Annotations, workloadslicing.FlavorPlacementOnPodsAnnotation)
+				return w
+			}(),
+			pods: []*corev1.Pod{
+				makeElasticPodForPodSet("a", workersPodSet).NodeSelector("example.com/pool", "reserved").Gate(kueue.ElasticJobSchedulingGate).CreationTimestamp(now).Obj(),
+				gated("b", workersPodSet),
+			},
+			wantPods: []corev1.Pod{onReserved("a"), onSpot("b")},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.ElasticJobsViaWorkloadSlices, true)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			objs := append([]client.Object{}, flavors...)
+			for _, p := range tc.pods {
+				objs = append(objs, p)
+			}
+			kClient := utiltesting.NewClientBuilder().
+				WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+				WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(rayClusterGVK), coreindexer.WorkloadOwnerIndexFunc(rayClusterGVK)).
+				WithIndex(&kueue.Workload{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexWorkloadSliceName).
+				WithInterceptorFuncs(interceptor.Funcs{
+					Patch: func(ctx context.Context, clnt client.WithWatch, obj client.Object, _ client.Patch, _ ...client.PatchOption) error {
+						return clnt.Update(ctx, obj)
+					},
+				}).
+				WithObjects(objs...).
+				WithStatusSubresource(tc.workload).
+				Build()
+			if err := kClient.Create(ctx, tc.workload); err != nil {
+				t.Fatalf("Could not create workload: %v", err)
+			}
+			ungater := &elasticJobUngater{
+				client:            kClient,
+				clock:             testingclock.NewFakeClock(now),
+				expectationsStore: expectations.NewStore(ControllerName),
+			}
+			if _, err := ungater.Reconcile(ctx, reconcile.Request{NamespacedName: client.ObjectKeyFromObject(tc.workload)}); err != nil {
+				t.Fatalf("Reconcile returned error: %v", err)
+			}
+			var gotPods corev1.PodList
+			if err := kClient.List(ctx, &gotPods); err != nil {
+				t.Fatalf("Could not list pods: %v", err)
+			}
+			if diff := gocmp.Diff(tc.wantPods, gotPods.Items, podCmpOpts...); diff != "" {
+				t.Errorf("Pods after reconcile (-want,+got):\n%s", diff)
+			}
+			for _, p := range gotPods.Items {
+				if p.Labels[constants.PodSetLabel] == "" {
+					t.Errorf("Pod %s lost its PodSet label", p.Name)
+				}
+			}
+		})
+	}
