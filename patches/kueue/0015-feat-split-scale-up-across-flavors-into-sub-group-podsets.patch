+			GroupName: "workers", Replicas: ptr.To[int32](4), MaxReplicas: ptr.To[int32](10),
+		}}},
+	}
+	objs := []client.Object{cluster}
+	for i := range 4 {
+		objs = append(objs, testingpod.MakePod("w-"+string(rune('0'+i)), "ns").
+			Annotation(kueue.WorkloadSliceNameAnnotation, wl.Name).
+			Label(constants.PodSetLabel, "workers").
+			Label(rayutils.RayNodeGroupLabelKey, "workers").
+			Label(rayutils.RayWorkerReplicaNameKey, "replica-"+string(rune('0'+i))).
+			CreationTimestamp(now.Add(time.Duration(i)*time.Second)).
+			Obj())
+	}
+	conflicted := false
+	kClient := utiltesting.NewClientBuilder(rayv1.AddToScheme).WithObjects(objs...).
+		WithIndex(&corev1.Pod{}, coreindexer.WorkloadSliceNameKey, coreindexer.IndexPodWorkloadSliceName).
+		WithInterceptorFuncs(interceptor.Funcs{
+			Patch: func(ctx context.Context, c client.WithWatch, obj client.Object, patch client.Patch, opts ...client.PatchOption) error {
+				if _, ok := obj.(*rayv1.RayCluster); !ok || conflicted {
+					return c.Patch(ctx, obj, patch, opts...)
+				}
+				// KubeRay finishes deleting a worker, and the autoscaler lowers the
+				// group, between the first read and the patch.
+				conflicted = true
+				if err := c.Delete(ctx, &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "w-3", Namespace: "ns"}}); err != nil {
+					return err
+				}
+				var latest rayv1.RayCluster
+				if err := c.Get(ctx, client.ObjectKeyFromObject(obj), &latest); err != nil {
+					return err
+				}
+				latest.Spec.WorkerGroupSpecs[0].Replicas = ptr.To[int32](3)
+				if err := c.Update(ctx, &latest); err != nil {
+					return err
+				}
+				return apierrors.NewConflict(rayv1.GroupVersion.WithResource("rayclusters").GroupResource(), obj.GetName(), nil)
+			},
+		}).Build()
+
+	if _, err := StopWorkersAbove(ctx, kClient, wl, workload.PodSetsCounts{"workers": 2}, client.ObjectKeyFromObject(cluster)); err != nil {
+		t.Fatalf("StopWorkersAbove() error: %v", err)
+	}
+	var got rayv1.RayCluster
+	if err := kClient.Get(ctx, client.ObjectKeyFromObject(cluster), &got); err != nil {
+		t.Fatalf("Get() error: %v", err)
+	}
+	group := got.Spec.WorkerGroupSpecs[0]
+	if replicas := ptr.Deref(group.Replicas, -1); replicas != 2 {
+		t.Errorf("Replicas = %d, want 2", replicas)
+	}
+	if diff := cmp.Diff([]string{"w-2"}, group.ScaleStrategy.WorkersToDelete); diff != "" {
+		t.Errorf("WorkersToDelete, which lists the deleted worker w-3 when read before the conflict (-want,+got):\n%s", diff)
+	}
+}
