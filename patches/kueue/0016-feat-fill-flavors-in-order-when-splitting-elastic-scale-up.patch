+// FlavorFill describes a count that fits without preemption. Flavor names its representative
+// resource group; Flavors records each resource when several groups have independent flavors.
+type FlavorFill struct {
+	Flavor  kueue.ResourceFlavorReference                         `json:"flavor"`
+	Count   int32                                                 `json:"count"`
+	Flavors map[corev1.ResourceName]kueue.ResourceFlavorReference `json:"flavors,omitempty"`
+}
+
+// GreedySplit is a refusal proposal for the job reconciler, never an admission.
+type GreedySplit struct {
+	PodSet kueue.PodSetReference `json:"podSet"`
+	Fills  []FlavorFill          `json:"fills"`
+}
+
+const greedySplitPrefix = GrowthFitsOtherFlavorReason + "; greedy fill: "
+
+// ParseGreedySplit reads the structured part of a refusal without depending on other reasons.
+func ParseGreedySplit(message string) (GreedySplit, bool) {
+	_, payload, ok := strings.Cut(message, greedySplitPrefix)
+	var split GreedySplit
+	if !ok || json.NewDecoder(strings.NewReader(payload)).Decode(&split) != nil || len(split.Fills) < 2 {
+		return GreedySplit{}, false
+	}
+	return split, true
+}
