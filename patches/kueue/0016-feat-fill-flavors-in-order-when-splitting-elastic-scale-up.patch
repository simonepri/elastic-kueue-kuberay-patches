+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+	"testing"
+)
+
+func TestUngateSplitWholeReplicas(t *testing.T) {
+	const base kueue.PodSetReference = "workers"
+	const split kueue.PodSetReference = "workers--2"
+	for _, mode := range []string{"complete", "incomplete", "running in split"} {
+		t.Run(mode, func(t *testing.T) {
+			wl := api.MakeWorkload("wl", "default").PodSets(*api.MakePodSet(base, 2).Obj(), *api.MakePodSet(split, 2).Obj()).Obj()
+			wl.Spec.PodSets[1].Template.Annotations = map[string]string{workloadslicing.FlavorSplitOfAnnotation: string(base)}
+			workload.SetPodSetCountSteps(wl, workload.PodSetsCounts{base: 2, split: 2})
+			pod := func(name, replica string, entry kueue.PodSetReference, gated bool) *corev1.Pod {
+				p := &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: name, Labels: map[string]string{constants.PodSetLabel: string(entry), replicaGroupLabel: replica}}}
+				if gated {
+					p.Spec.SchedulingGates = []corev1.PodSchedulingGate{{Name: kueue.ElasticJobSchedulingGate}}
+				}
+				return p
+			}
+			pods := []*corev1.Pod{pod("a-1", "one", base, true), pod("a-2", "two", base, true), pod("z-1", "one", base, true), pod("z-2", "two", base, true)}
+			pending := map[kueue.PodSetReference][]*corev1.Pod{base: pods}
+			running := workload.PodSetsCounts{}
+			want := map[string]kueue.PodSetReference{"a-1": base, "z-1": base, "a-2": split, "z-2": split}
+			if mode == "incomplete" {
+				pods = append(pods[:2:2], pods[3])
+				pending[base] = pods
+				want = map[string]kueue.PodSetReference{"a-2": base, "z-2": base}
+			}
+			if mode == "running in split" {
+				pods[2] = pod("z-1", "one", split, false)
+				pending[base] = []*corev1.Pod{pods[0], pods[1], pods[3]}
+				running[split] = 1
+				want = map[string]kueue.PodSetReference{"a-1": split, "a-2": base, "z-2": base}
+			}
+			got, err := (&elasticJobUngater{}).ungateSplitGroups(t.Context(), wl, splitGroupsOf(wl), pending, pods, running, workload.PodSetsCounts{base: 2, split: 2}, map[kueue.PodSetReference]podAdmissionUpdate{base: {}, split: {}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("entries=%v, want %v", got, want)
+			}
+		})
+	}
+}
