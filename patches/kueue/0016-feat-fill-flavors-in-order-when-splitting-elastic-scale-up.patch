+func TestMaterializeGreedySplit(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		probe := api.MakeWorkload("probe", "default").PodSets(*api.MakePodSet("workers", 24).Obj()).Obj()
+		workload.SetPodSetCountSteps(probe, workload.PodSetsCounts{"workers": 2})
+		payload, _ := json.Marshal(flavorassigner.GreedySplit{PodSet: "workers", Fills: []flavorassigner.FlavorFill{{Flavor: "a", Count: 14}, {Flavor: "b", Count: 10}}})
+		probe.Status.Conditions = []metav1.Condition{{Type: kueue.WorkloadQuotaReserved, Message: flavorassigner.GrowthFitsOtherFlavorReason + "; greedy fill: " + string(payload)}}
+		if !SplitGrowth(probe, nil, partial) {
+			t.Fatal("proposal was not materialized")
+		}
+		if got := workload.ExtractPodSetCountsFromWorkload(probe); !reflect.DeepEqual(got, workload.PodSetsCounts{"workers": 14, "workers--2": 10}) {
+			t.Fatalf("counts=%v", got)
+		}
+		if SplitBase(&probe.Spec.PodSets[1]) != "workers" {
+			t.Fatal("entry lost its base")
+		}
+		if got := workload.PodSetCountSteps(probe)["workers--2"]; got != 2 {
+			t.Fatalf("step=%d", got)
+		}
+	}
+}
+
+// Floors and steps are annotations, so refreshing them need not change spec generation.
+func TestRejectGreedyProposalAfterPolicyRefresh(t *testing.T) {
+	for _, policy := range []string{"floor", "step"} {
+		t.Run(policy, func(t *testing.T) {
+			probe := api.MakeWorkload("probe", "default").PodSets(*api.MakePodSet("workers", 24).Obj()).Obj()
+			workload.SetPodSetCountSteps(probe, workload.PodSetsCounts{"workers": 2})
+			proposal := flavorassigner.GreedySplit{PodSet: "workers", Fills: []flavorassigner.FlavorFill{{Flavor: "a", Count: 14}, {Flavor: "b", Count: 10}}}
+			if policy == "floor" {
+				workload.SetReclaimMinCounts(probe, workload.PodSetsCounts{"workers": 16})
+			} else {
+				workload.SetPodSetCountSteps(probe, workload.PodSetsCounts{"workers": 4})
+			}
+			before := probe.DeepCopy()
+			if applyGreedySplit(probe, nil, proposal, true) {
+				t.Fatal("accepted proposal from the old policy")
+			}
+			if !reflect.DeepEqual(probe, before) {
+				t.Fatal("rejected proposal mutated probe")
+			}
+		})
+	}
+}
+
+func TestRejectGreedyProposalBelowRunningBaseline(t *testing.T) {
+	probe := api.MakeWorkload("probe", "default").PodSets(*api.MakePodSet("workers", 24).Obj()).Obj()
+	replaced := api.MakeWorkload("old", "default").PodSets(*api.MakePodSet("workers", 24).Obj()).
+		ReserveQuotaAt(api.MakeAdmission("cq").PodSets(api.MakePodSetAssignment("workers").Count(24).Obj()).Obj(), time.Now()).Obj()
+	workload.SetReclaimTargetCounts(replaced, workload.PodSetsCounts{"workers": 16})
+	proposal := flavorassigner.GreedySplit{PodSet: "workers", Fills: []flavorassigner.FlavorFill{{Flavor: "a", Count: 14}, {Flavor: "b", Count: 10}}}
+	before := probe.DeepCopy()
+	if applyGreedySplit(probe, replaced, proposal, false) || !reflect.DeepEqual(before, probe) {
+		t.Fatal("proposal below the running baseline must be rejected without mutation")
+	}
+}
+
+func TestInitialNonzeroSliceSplitsThroughManager(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		t.Run(fmt.Sprint(partial), func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{features.ElasticJobsViaWorkloadSlicesFlavorSplit: true, features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: true})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			job := &batchv1.Job{ObjectMeta: metav1.ObjectMeta{Name: "job", Namespace: "ns", UID: "job-uid"}}
+			ps := api.MakePodSet("workers", 24).Obj()
+			if partial {
+				ps.MinCount = ptr.To[int32](24)
+			}
+			probe := api.MakeWorkload("first", "ns").OwnerReference(testJobGVK, job.Name, string(job.UID)).Annotation(EnabledAnnotationKey, EnabledAnnotationValue).Annotation(FlavorPlacementOnPodsAnnotation, "true").PodSets(*ps).Obj()
+			payload, _ := json.Marshal(flavorassigner.GreedySplit{PodSet: "workers", Fills: []flavorassigner.FlavorFill{{Flavor: "a", Count: 15}, {Flavor: "b", Count: 9}}})
+			probe.Status.Conditions = []metav1.Condition{{Type: kueue.WorkloadQuotaReserved, Status: metav1.ConditionFalse, Message: flavorassigner.GrowthFitsOtherFlavorReason + "; greedy fill: " + string(payload)}}
+			c := utiltesting.NewClientBuilder().WithObjects(probe).WithStatusSubresource(probe).WithIndex(&kueue.Workload{}, coreindexer.OwnerReferenceIndexKey(testJobGVK), coreindexer.WorkloadOwnerIndexFunc(testJobGVK)).Build()
+			manager := Manager{Client: c}
+			got, compatible, err := manager.EnsureWorkloadSlices(ctx, []kueue.PodSet{*ps}, job, testJobGVK)
+			if err != nil || !compatible || got == nil {
+				t.Fatalf("compatible=%v err=%v", compatible, err)
+			}
+			if counts := workload.ExtractPodSetCountsFromWorkload(got); !reflect.DeepEqual(counts, workload.PodSetsCounts{"workers": 15, "workers--2": 9}) {
+				t.Fatalf("counts=%v", counts)
+			}
+			for _, entry := range got.Spec.PodSets {
+				if partial && (entry.MinCount == nil || *entry.MinCount != entry.Count) {
+					t.Fatalf("initial minimum=%v count=%d", entry.MinCount, entry.Count)
+				}
+			}
+			// The first slice still has no quota when the desired count changes.
+			ps.Count = 26
+			if partial {
+				ps.MinCount = ptr.To[int32](26)
+			}
+			got, compatible, err = manager.EnsureWorkloadSlices(ctx, []kueue.PodSet{*ps}, job, testJobGVK)
+			if err != nil || !compatible || got == nil {
+				t.Fatalf("resize: compatible=%v err=%v", compatible, err)
+			}
+			if counts := workload.ExtractPodSetCountsFromWorkload(got); !reflect.DeepEqual(counts, workload.PodSetsCounts{"workers": 15, "workers--2": 11}) {
+				t.Fatalf("resized counts=%v", counts)
+			}
+			for _, entry := range got.Spec.PodSets {
+				if partial && (entry.MinCount == nil || *entry.MinCount != entry.Count) {
+					t.Fatalf("resized minimum=%v count=%d", entry.MinCount, entry.Count)
+				}
+			}
+		})
+	}
+}
