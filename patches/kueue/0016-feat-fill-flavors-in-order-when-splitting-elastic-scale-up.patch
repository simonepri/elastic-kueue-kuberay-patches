+			before := probe.DeepCopy()
+			info := workload.NewInfo(log, probe)
+			replaced := workload.NewInfo(log, old)
+			if tc.initial {
+				replaced = nil
+			}
+			assigner := New(info, snapshot.ClusterQueue("cq"), flavors, false, &testOracle{}, replaced, configapi.QuotaCheckBlockUndeclared, resources.NewResourceFormatter(), 0)
+			assignment := assigner.AssignFlavors(ctx, log, nil)
+			split, ok := ParseGreedySplit(assignment.Message())
+			if tc.cpuQuota != "" {
+				cpuQuota := resource.MustParse(tc.cpuQuota)
+				cpuLeft := cpuQuota.Value()
+				var assigned int64
+				for i := range tc.want {
+					cpuFlavor := kueue.ResourceFlavorReference("cpu-fast")
+					if assigned >= cpuLeft {
+						cpuFlavor = "cpu-slow"
+					}
+					tc.want[i].Flavors = map[corev1.ResourceName]kueue.ResourceFlavorReference{"example.com/gpu": tc.want[i].Flavor, corev1.ResourceCPU: cpuFlavor}
+					assigned += int64(tc.want[i].Count)
+				}
+			}
+			if ok != (tc.want != nil) || !reflect.DeepEqual(split.Fills, tc.want) {
+				t.Fatalf("proposal=%+v (%v), want %v; message=%s", split, ok, tc.want, assignment.Message())
+			}
+			if tc.wholeFlavor != "" {
+				if assignment.RepresentativeMode() != Fit || assignment.PodSets[0].Flavors["example.com/gpu"].Name != tc.wholeFlavor {
+					t.Fatalf("whole assignment=%s, want flavor %s", assignment.Message(), tc.wholeFlavor)
+				}
+			}
+			if !tc.elastic && strings.Contains(assignment.Message(), GrowthFitsOtherFlavorReason) {
+				t.Fatal("non-elastic assignment proposed a split")
+			}
+			if !reflect.DeepEqual(before, probe) {
+				t.Fatal("assigner mutated input workload")
+			}
+			if ok && assignment.RepresentativeMode() != NoFit {
+				t.Fatal("proposal must refuse admission")
+			}
+		})
+	}
+}
+
+func stringCount(count int32) string { return fmt.Sprint(count) }
+
+// A refusal note is a count proposal, not a quota reservation. A fresh assignment must
+// refuse its stale counts and check the recomputed entries before it can admit them.
+func TestStaleGreedyQuotaProposal(t *testing.T) {
+	features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: true, features.ElasticJobsViaWorkloadSlicesFlavorSplit: true})
+	ctx, log := utiltesting.ContextWithLog(t)
+	cq := api.MakeClusterQueue("cq").ResourceGroup(*api.MakeFlavorQuotas("a").Resource("example.com/gpu", "15").Obj(), *api.MakeFlavorQuotas("b").Resource("example.com/gpu", "32").Obj()).Obj()
+	cache := schdcache.New(utiltesting.NewFakeClient())
+	flavors := map[kueue.ResourceFlavorReference]*kueue.ResourceFlavor{"a": api.MakeResourceFlavor("a").Obj(), "b": api.MakeResourceFlavor("b").Obj()}
+	for _, f := range flavors {
+		cache.AddOrUpdateResourceFlavor(log, f)
+	}
+	if err := cache.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	probe := api.MakeWorkload("probe", "ns").Annotation(constants.ElasticJobAnnotation, "true").PodSets(*api.MakePodSet("workers", 24).Request("example.com/gpu", "1").Obj()).Obj()
+	assign := func() Assignment {
+		snapshot, err := cache.Snapshot(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return New(workload.NewInfo(log, probe), snapshot.ClusterQueue("cq"), flavors, false, &testOracle{}, nil, configapi.QuotaCheckBlockUndeclared, resources.NewResourceFormatter(), 0).AssignFlavors(ctx, log, nil)
+	}
+	first := assign()
+	split, ok := ParseGreedySplit(first.Message())
+	if !ok || split.Fills[0].Count != 15 {
+		t.Fatalf("initial proposal=%s", first.Message())
+	}
+	// Quota changes after the note, without a new Workload generation. Materialize that old note.
+	cq.Spec.ResourceGroups[0].Flavors[0].Resources[0].NominalQuota = resource.MustParse("10")
+	if err := cache.UpdateClusterQueue(log, cq); err != nil {
+		t.Fatal(err)
+	}
+	probe.Spec.PodSets[0].Count = 15
+	entry := *probe.Spec.PodSets[0].DeepCopy()
+	entry.Name = "workers--2"
+	entry.Count = 9
+	probe.Spec.PodSets = append(probe.Spec.PodSets, entry)
+	stale := assign()
+	if stale.RepresentativeMode() == Fit {
+		t.Fatal("stale proposal admitted more than the current free quota")
+	}
+	next, ok := ParseGreedySplit(stale.Message())
+	if !ok || next.Fills[0].Count != 10 || next.Fills[1].Count != 5 {
+		t.Fatalf("recomputed proposal=%s", stale.Message())
+	}
+	probe.Spec.PodSets[0].Count = 10
+	entry.Name = "workers--3"
+	entry.Count = 5
+	probe.Spec.PodSets = append(probe.Spec.PodSets, entry)
+	final := assign()
+	if final.RepresentativeMode() != Fit {
+		t.Fatalf("fresh counts did not converge: %s", final.Message())
+	}
+	var onA, onB int32
+	for _, ps := range final.PodSets {
+		switch ps.Flavors["example.com/gpu"].Name {
+		case "a":
+			onA += ps.Count
+		case "b":
+			onB += ps.Count
+		}
+	}
+	if onA != 10 || onB != 14 {
+		t.Fatalf("admitted A=%d B=%d", onA, onB)
+	}
+}
+
+func TestGreedySyntheticPodQuota(t *testing.T) {
+	features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{features.ElasticJobsViaWorkloadSlicesFlavorChangeFromZero: true, features.ElasticJobsViaWorkloadSlicesFlavorSplit: true})
+	ctx, log := utiltesting.ContextWithLog(t)
+	cq := api.MakeClusterQueue("cq").ResourceGroup(
+		*api.MakeFlavorQuotas("a").Resource(corev1.ResourcePods, "7").Resource(corev1.ResourceCPU, "100").Obj(),
+		*api.MakeFlavorQuotas("b").Resource(corev1.ResourcePods, "32").Resource(corev1.ResourceCPU, "100").Obj()).Obj()
+	cache := schdcache.New(utiltesting.NewFakeClient())
+	flavors := map[kueue.ResourceFlavorReference]*kueue.ResourceFlavor{"a": api.MakeResourceFlavor("a").Obj(), "b": api.MakeResourceFlavor("b").Obj()}
+	for _, f := range flavors {
+		cache.AddOrUpdateResourceFlavor(log, f)
+	}
+	if err := cache.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := cache.Snapshot(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := api.MakeWorkload("probe", "ns").Annotation(constants.ElasticJobAnnotation, "true").PodSets(
+		*api.MakePodSet("head", 1).Request(corev1.ResourceCPU, "1").Obj(),
+		*api.MakePodSet("workers", 10).Request(corev1.ResourceCPU, "1").Obj()).Obj()
+	assign := func() Assignment {
+		info := workload.NewInfo(log, probe)
+		result := New(info, snapshot.ClusterQueue("cq"), flavors, false, &testOracle{}, nil, configapi.QuotaCheckBlockUndeclared, resources.NewResourceFormatter(), 0).AssignFlavors(ctx, log, nil)
+		for _, ps := range info.TotalRequests {
+			if ps.Requests.ResourceValue(corev1.ResourcePods).Sign() != 0 {
+				t.Fatal("synthetic pods mutated the shared workload info")
+			}
+		}
+		return result
+	}
+	first := assign()
+	split, ok := ParseGreedySplit(first.Message())
+	if !ok || !reflect.DeepEqual(split.Fills, []FlavorFill{{Flavor: "a", Count: 6}, {Flavor: "b", Count: 4}}) {
+		t.Fatalf("proposal=%s", first.Message())
+	}
+	probe.Spec.PodSets[1].Count = 6
+	entry := *probe.Spec.PodSets[1].DeepCopy()
+	entry.Name = "workers--2"
+	entry.Count = 4
+	probe.Spec.PodSets = append(probe.Spec.PodSets, entry)
+	final := assign()
+	if final.RepresentativeMode() != Fit || len(final.PodSets) != 3 {
+		t.Fatalf("materialized plan failed fit: %s", final.Message())
+	}
+	for i, want := range []kueue.ResourceFlavorReference{"a", "a", "b"} {
+		if final.PodSets[i].Flavors[corev1.ResourcePods].Name != want {
+			t.Fatalf("entry %d assigned to %v", i, final.PodSets[i].Flavors)
+		}
+	}
+}
