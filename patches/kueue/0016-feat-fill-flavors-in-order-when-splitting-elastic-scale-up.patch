+// placesByTopology distinguishes placement requirements from worker index metadata.
+func placesByTopology(tr *kueue.PodSetTopologyRequest) bool {
+	return tr != nil && (tr.Required != nil || tr.Preferred != nil || (tr.Unconstrained != nil && *tr.Unconstrained) ||
+		tr.PodSetGroupName != nil || tr.PodSetSliceRequiredTopology != nil)
+}
