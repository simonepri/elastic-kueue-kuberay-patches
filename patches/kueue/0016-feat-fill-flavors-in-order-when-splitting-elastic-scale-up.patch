+// greedyGroupFills applies the ordinary quota and eligibility rules to one resource group.
+// Resource groups have disjoint resources, so their plans share only PodSet count boundaries.
+func (a *FlavorAssigner) greedyGroupFills(log logr.Logger, ips indexedPodSet, usage resources.FlavorResourceQuantities, rg *resourcegroups.ResourceGroup, old *workload.PodSetResources, running, step, floor int32) []FlavorFill {
+	ps := &a.wl.Obj.Spec.PodSets[ips.originalIndex]
+	flavors := slices.Clone(rg.Flavors)
+	// A running entry starts on its current flavor even if an earlier flavor frees up.
+	if running > 0 {
+		var current kueue.ResourceFlavorReference
+		for name, amount := range ips.podSet.Requests.Iter() {
+			if amount.Sign() > 0 && rg.CoveredResources.Has(name) {
+				if current != "" && current != old.Flavors[name] {
+					return nil
+				}
+				current = old.Flavors[name]
+			}
+		}
+		idx := slices.Index(flavors, current)
+		if idx < 0 {
+			return nil
+		}
+		flavors = flavors[idx:]
+	}
+	remaining := ps.Count
+	var fills []FlavorFill
+	for _, flavor := range flavors {
+		if a.shouldRespectNominationMapping() {
+			skip := false
+			for name, amount := range ips.podSet.Requests.Iter() {
+				if amount.Sign() > 0 && rg.CoveredResources.Has(name) && a.shouldSkipBasedOnNominationMapping(log, flavor, []int{ips.originalIndex}, name) {
+					skip = true
+					break
+				}
+			}
+			if skip {
+				continue
+			}
+		}
+		if !a.checkFlavorForPodSets(log, flavor, []int{ips.originalIndex}, []*kueue.PodSet{ps}, rg).IsFit() ||
+			(features.Enabled(features.ConcurrentAdmission) && !concurrentadmission.IsFlavorAllowedForVariant(a.wl.Obj, flavor)) {
+			continue
+		}
+		first := len(fills) == 0
+		baseline := int32(0)
+		if first {
+			baseline = running
+		}
+		fits := func(count int32) bool {
+			scaled := ips.podSet.ScaledTo(count)
+			if rg.CoveredResources.Has(corev1.ResourcePods) {
+				if scaled.Requests == nil {
+					scaled.Requests = resources.NewRequestsFromMap(map[corev1.ResourceName]int64{corev1.ResourcePods: int64(count)})
+				} else {
+					scaled.Requests.Set(corev1.ResourcePods, resources.NewAmount(int64(count)))
+				}
+			}
+			for name, val := range scaled.Requests.Iter() {
+				if !rg.CoveredResources.Has(name) {
+					continue
+				}
+				fr := resources.FlavorResource{Flavor: flavor, Resource: name}
+				if first && old != nil && old.Requests != nil && old.Flavors[name] == flavor {
+					val = val.Sub(old.Requests.ResourceValue(name))
+				} else if first && running > 0 {
+					return false
+				}
+				total := usage[fr].Add(val)
+				if a.fitsMaxCapacity(fr, usage[fr], val) != nil || total.Cmp(a.cq.Available(fr)) > 0 {
+					return false
+				}
+				borrow, _ := classical.FindHeightOfLowestSubtreeThatFits(a.cq, fr, total)
+				if val.Sign() > 0 && features.Enabled(features.FlavorFungibility) && shouldTryNextFlavor(granularMode{fit, borrowingLevel(borrow)}, a.cq.FlavorFungibility) {
+					return false
+				}
+			}
+			return true
+		}
+		low, high := int32(0), (remaining-baseline)/step
+		for low < high {
+			mid := low + (high-low+1)/2
+			if fits(baseline + mid*step) {
+				low = mid
+			} else {
+				high = mid - 1
+			}
+		}
+		count := baseline + low*step
+		if first && count < floor {
+			return nil
+		}
+		if count == 0 {
+			continue
+		}
+		if !fits(count) {
+			return nil
+		}
+		fills = append(fills, FlavorFill{Flavor: flavor, Count: count})
+		remaining -= count
+		if remaining == 0 {
+			return fills
+		}
+	}
+	return nil
+}
