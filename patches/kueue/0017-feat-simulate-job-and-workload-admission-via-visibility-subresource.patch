+
+// TestWorkloadBuilderBuildsAsTheJobReconciler checks that the Workload that
+// Build returns for a job is the one that the job reconciler creates for that
+// job, or, for a job that has a Workload, that Workload as the reconciler
+// updates it.
+func TestWorkloadBuilderBuildsAsTheJobReconciler(t *testing.T) {
+	trainJob := func() *testingjob.JobWrapper {
+		return testingjob.MakeJob("train", builderNamespace).SetTypeMeta().UID("train-uid").Queue("lq").
+			Label("team", "ml").Label("not-copied", "x").Request(corev1.ResourceCPU, "1")
+	}
+	elasticJob := func() *testingjob.JobWrapper {
+		return trainJob().SetAnnotation(workloadslicing.EnabledAnnotationKey, "true")
+	}
+	pytorchJob := func() *testingpytorchjob.PyTorchJobWrapper {
+		return testingpytorchjob.MakePyTorchJob("train", builderNamespace).SetTypeMeta().UID("train-uid").Queue("lq").
+			PyTorchReplicaSpecs(
+				testingpytorchjob.PyTorchReplicaSpecRequirement{ReplicaType: kftraining.PyTorchJobReplicaTypeMaster, ReplicaCount: 1},
+				testingpytorchjob.PyTorchReplicaSpecRequirement{ReplicaType: kftraining.PyTorchJobReplicaTypeWorker, ReplicaCount: 2},
+			).
+			Request(kftraining.PyTorchJobReplicaTypeMaster, corev1.ResourceCPU, "1").
+			Request(kftraining.PyTorchJobReplicaTypeWorker, corev1.ResourceCPU, "2")
+	}
+	cases := map[string]struct {
+		gates map[featuregate.Feature]bool
+		// created is the job as it exists before job; the reconciler gives it a
+		// Workload. It is nil for a job that does not exist.
+		created client.Object
+		// modify changes the Workload of created before job replaces created.
+		modify func(*kueue.Workload)
+		job    client.Object
+		newJob func() GenericJob
+	}{
+		"a batch/v1 Job with a WorkloadPriorityClass and a minimum parallelism": {
+			job: trainJob().WorkloadPriorityClass("high").Parallelism(3).Completions(6).
+				SetAnnotation(job.JobMinParallelismAnnotation, "1").Obj(),
+			newJob: job.NewJob,
+		},
+		"an elastic batch/v1 Job": {
+			gates:  map[featuregate.Feature]bool{features.ElasticJobsViaWorkloadSlices: true},
+			job:    elasticJob().Parallelism(2).Obj(),
+			newJob: job.NewJob,
+		},
+		"a kubeflow.org/v1 PyTorchJob with a master, workers and a PriorityClass": {
+			job:    pytorchJob().PriorityClass("pods-high").Obj(),
+			newJob: pytorchjob.NewJob,
+		},
+		"a suspended batch/v1 Job whose Workload no longer matches it": {
+			created: trainJob().Parallelism(1).Obj(),
+			job:     trainJob().WorkloadPriorityClass("high").Parallelism(3).Obj(),
+			newJob:  job.NewJob,
+		},
+		"a pending batch/v1 Job whose pods have a PriorityClass gets a WorkloadPriorityClass": {
+			created: trainJob().PriorityClass("pods-high").Obj(),
+			job:     trainJob().PriorityClass("pods-high").WorkloadPriorityClass("high").Obj(),
+			newJob:  job.NewJob,
+		},
+		"a pending batch/v1 Job loses its admission gate": {
+			gates:   map[featuregate.Feature]bool{features.AdmissionGatedBy: true},
+			created: trainJob().SetAnnotation(constants.AdmissionGatedByAnnotation, "example.com/gate").Obj(),
+			job:     trainJob().Obj(),
+			newJob:  job.NewJob,
+		},
+		"an inactive pending slice of an elastic batch/v1 Job that grows": {
+			gates:   map[featuregate.Feature]bool{features.ElasticJobsViaWorkloadSlices: true},
+			created: elasticJob().Parallelism(2).Obj(),
+			modify:  func(wl *kueue.Workload) { wl.Spec.Active = new(false) },
+			job:     elasticJob().Parallelism(3).Obj(),
+			newJob:  job.NewJob,
+		},
+		"a pending batch/v1 Job that moves to another LocalQueue": {
+			created: trainJob().Obj(),
+			job:     trainJob().Queue("lq-b").Obj(),
+			newJob:  job.NewJob,
+		},
+		"a preempted batch/v1 Job that waits and moves to another LocalQueue": {
+			created: trainJob().Obj(),
+			modify: func(wl *kueue.Workload) {
+				apimeta.SetStatusCondition(&wl.Status.Conditions, metav1.Condition{
+					Type: kueue.WorkloadEvicted, Status: metav1.ConditionTrue, Reason: kueue.WorkloadEvictedByPreemption, Message: "Preempted",
+				})
+				apimeta.SetStatusCondition(&wl.Status.Conditions, metav1.Condition{
+					Type: kueue.WorkloadQuotaReserved, Status: metav1.ConditionFalse, Reason: "Pending", Message: "Preempted",
+				})
+			},
+			job:    trainJob().Queue("lq-b").Obj(),
+			newJob: job.NewJob,
+		},
+		"a pending kubeflow.org/v1 PyTorchJob whose priority changes": {
+			created: pytorchJob().WorkloadPriorityClass("low").Obj(),
+			job:     pytorchJob().WorkloadPriorityClass("high").Obj(),
+			newJob:  pytorchjob.NewJob,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, tc.gates)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			opts := []Option{WithIntegrationManager(builderTestIntegrations(t)), WithLabelKeysToCopy(sets.New("team"))}
+			key := client.ObjectKeyFromObject(tc.job)
+			reconcile := func(cl client.Client) {
+				t.Helper()
+				r := NewReconciler(cl, &utiltesting.EventRecorder{}, opts...)
+				if _, err := r.ReconcileGenericJob(ctx, controllerruntime.Request{NamespacedName: key}, tc.newJob()); err != nil {
+					t.Fatalf("Reconciling the job: %v", err)
+				}
+			}
+			workloads := func(cl client.Client) []kueue.Workload {
+				t.Helper()
+				var list kueue.WorkloadList
+				if err := cl.List(ctx, &list); err != nil {
+					t.Fatal(err)
+				}
+				return list.Items
+			}
+
+			reconciled := builderTestClient(builderTestObjects()...)
+			obj := tc.job.DeepCopyObject().(client.Object)
+			if tc.created != nil {
+				if err := reconciled.Create(ctx, tc.created.DeepCopyObject().(client.Object)); err != nil {
+					t.Fatal(err)
+				}
+				reconcile(reconciled)
+				if tc.modify != nil {
+					for _, wl := range workloads(reconciled) {
+						tc.modify(&wl)
+						if err := reconciled.Update(ctx, &wl); err != nil {
+							t.Fatal(err)
+						}
+					}
+				}
+				current := tc.newJob().Object()
+				if err := reconciled.Get(ctx, key, current); err != nil {
+					t.Fatal(err)
+				}
+				obj.SetResourceVersion(current.GetResourceVersion())
+			}
+			// The Workloads that the builder sees are those before job.
+			built := builderTestClient(builderTestObjects()...)
+			for _, wl := range workloads(reconciled) {
+				wl.ResourceVersion = ""
+				if err := built.Create(ctx, &wl); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tc.created != nil {
+				if err := reconciled.Update(ctx, obj); err != nil {
+					t.Fatal(err)
+				}
+			} else if err := reconciled.Create(ctx, obj); err != nil {
+				t.Fatal(err)
+			}
+			reconcile(reconciled)
+			want := workloads(reconciled)
+			if len(want) != 1 {
+				t.Fatalf("The job reconciler made %d Workloads, want 1", len(want))
+			}
+
+			got, stored, err := NewWorkloadBuilder(failWrites(t, built), opts...).Build(ctx, rawJob(t, tc.job), builderNamespace)
+			if err != nil {
+				t.Fatalf("Build() error: %v", err)
+			}
+			if wantStored := tc.created != nil; stored != wantStored {
+				t.Errorf("Build() stored = %v, want %v", stored, wantStored)
+			}
+			// The reconciler's Workload went through the API server, which stores an
+			// empty list as none.
+			if diff := cmp.Diff(&want[0], got, cmpopts.EquateEmpty(), cmpopts.IgnoreFields(metav1.ObjectMeta{}, "ResourceVersion")); diff != "" {
+				t.Errorf("Build() differs from the reconciler's Workload (-reconciler,+built):\n%s", diff)
+			}
+		})
+	}
+}
+
+// failWrites returns c, and fails the test on each write through it.
+func failWrites(t *testing.T, c client.WithWatch) client.Client {
+	fail := func(verb string, obj any) error {
+		t.Errorf("The WorkloadBuilder wrote to the API server: %s %T", verb, obj)
+		return nil
+	}
+	return interceptor.NewClient(c, interceptor.Funcs{
+		Create: func(_ context.Context, _ client.WithWatch, obj client.Object, _ ...client.CreateOption) error {
+			return fail("create", obj)
+		},
+		Update: func(_ context.Context, _ client.WithWatch, obj client.Object, _ ...client.UpdateOption) error {
+			return fail("update", obj)
+		},
+		Patch: func(_ context.Context, _ client.WithWatch, obj client.Object, _ client.Patch, _ ...client.PatchOption) error {
+			return fail("patch", obj)
+		},
+		Apply: func(_ context.Context, _ client.WithWatch, obj runtime.ApplyConfiguration, _ ...client.ApplyOption) error {
+			return fail("apply", obj)
+		},
+		Delete: func(_ context.Context, _ client.WithWatch, obj client.Object, _ ...client.DeleteOption) error {
+			return fail("delete", obj)
+		},
+		DeleteAllOf: func(_ context.Context, _ client.WithWatch, obj client.Object, _ ...client.DeleteAllOfOption) error {
+			return fail("delete all of", obj)
+		},
+		SubResourceCreate: func(_ context.Context, _ client.Client, sub string, obj client.Object, _ client.Object, _ ...client.SubResourceCreateOption) error {
+			return fail("create "+sub, obj)
+		},
+		SubResourceUpdate: func(_ context.Context, _ client.Client, sub string, obj client.Object, _ ...client.SubResourceUpdateOption) error {
+			return fail("update "+sub, obj)
+		},
+		SubResourcePatch: func(_ context.Context, _ client.Client, sub string, obj client.Object, _ client.Patch, _ ...client.SubResourcePatchOption) error {
+			return fail("patch "+sub, obj)
+		},
+		SubResourceApply: func(_ context.Context, _ client.Client, sub string, obj runtime.ApplyConfiguration, _ ...client.SubResourceApplyOption) error {
+			return fail("apply "+sub, obj)
+		},
+	})
+}
