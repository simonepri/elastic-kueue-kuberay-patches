+// TestSimulateInLQAppliesCRDDefaults checks that a PodSet sent without a name
+// or a count gets the CRD's defaults, as a created Workload would.
+func TestSimulateInLQAppliesCRDDefaults(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	ctx, _ := utiltesting.ContextWithLog(t)
+	env := newSimulationEnv(t, now, simulationSetup{
+		clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Obj()},
+		localQueues:   []*kueue.LocalQueue{utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj()},
+	})
+	got, err := env.simulate(ctx, t, "lq-a", map[string]any{
+		"apiVersion": kueue.SchemeGroupVersion.String(),
+		"kind":       "Workload",
+		"spec": map[string]any{"podSets": []any{map[string]any{"template": map[string]any{"spec": map[string]any{"containers": []any{
+			map[string]any{"name": "c", "resources": map[string]any{"requests": map[string]any{"cpu": "100"}}},
+		}}}}}},
+	})
+	if err != nil {
+		t.Fatalf("Simulating: %v", err)
+	}
+	want := visibility.WorkloadSimulationStatus{
+		ClusterQueue: "cq-a",
+		Mode:         visibility.SimulationNoFit,
+		Reason:       kueue.WorkloadQuotaReservedReasonExceedsMaxQuota,
+		Message:      "couldn't assign flavors to pod set main: insufficient quota for cpu in flavor default, previously considered podsets requests (0) + current podset request (100) > maximum capacity (4)",
+		PodSets: []visibility.SimulatedPodSetAssignment{{
+			Name: kueue.DefaultPodSetName, Count: 1,
+			Message: "insufficient quota for cpu in flavor default, previously considered podsets requests (0) + current podset request (100) > maximum capacity (4)",
+		}},
+	}
+	if diff := cmp.Diff(want, got.Status, cmpopts.EquateEmpty()); diff != "" {
+		t.Errorf("Unexpected simulation status (-want,+got):\n%s", diff)
+	}
+}
