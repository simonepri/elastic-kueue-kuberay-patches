+
+const simulatePath = "/apis/visibility.kueue.x-k8s.io/v1beta2/namespaces/default/localqueues/lq/simulate"
+
+// TestSimulateOverHTTP sends the request that
+// "kubectl create --raw <simulatePath> -f simulation.json" sends to the
+// visibility server's handler chain, with authentication and authorization
+// left out: in a cluster the kube-apiserver delegates both.
+func TestSimulateOverHTTP(t *testing.T) {
+	body := `{
+  "apiVersion": "visibility.kueue.x-k8s.io/v1beta2",
+  "kind": "WorkloadSimulation",
+  "spec": {"workload": {
+    "apiVersion": "kueue.x-k8s.io/v1beta2",
+    "kind": "Workload",
+    "metadata": {"name": "incoming"},
+    "spec": {"podSets": [{"name": "main", "count": 2, "template": {"spec": {"containers": [
+      {"name": "c", "resources": {"requests": {"cpu": "1"}}}
+    ]}}}]}
+  }}
+}`
+	// A batch/v1 Job as a server-side dry run of its create returns it.
+	jobBody := `{
+  "apiVersion": "visibility.kueue.x-k8s.io/v1beta2",
+  "kind": "WorkloadSimulation",
+  "spec": {"job": {
+    "apiVersion": "batch/v1",
+    "kind": "Job",
+    "metadata": {"name": "train", "namespace": "default", "uid": "0f3a1c52-3c55-4a8e-9d55-8a3c1b0f7e21",
+      "creationTimestamp": "2026-11-04T10:00:00Z", "labels": {"kueue.x-k8s.io/queue-name": "lq"}},
+    "spec": {"parallelism": 2, "completions": 2, "suspend": true, "template": {"spec": {
+      "restartPolicy": "Never",
+      "containers": [{"name": "c", "image": "busybox", "resources": {"requests": {"cpu": "1"}}}]
+    }}},
+    "status": {}
+  }}
+}`
+	cases := map[string]struct {
+		enabled  bool
+		unsynced bool
+		body     string
+		wantCode int
+		wantMode visibilityv1beta2.SimulationMode
+	}{
+		"simulates a Workload": {
+			enabled:  true,
+			body:     body,
+			wantCode: http.StatusCreated,
+			wantMode: visibilityv1beta2.SimulationFit,
+		},
+		"simulates a job": {
+			enabled:  true,
+			body:     jobBody,
+			wantCode: http.StatusCreated,
+			wantMode: visibilityv1beta2.SimulationFit,
+		},
+		"rejects a request with neither a job nor a Workload": {
+			enabled:  true,
+			body:     `{"apiVersion": "visibility.kueue.x-k8s.io/v1beta2", "kind": "WorkloadSimulation", "spec": {}}`,
+			wantCode: http.StatusUnprocessableEntity,
+		},
+		"rejects an unknown field of the Workload": {
+			enabled:  true,
+			body:     strings.Replace(body, `"spec": {"podSets"`, `"spec": {"podsets": [], "podSets"`, 1),
+			wantCode: http.StatusBadRequest,
+		},
+		"answers at once until the cache has synced": {
+			enabled:  true,
+			unsynced: true,
+			body:     body,
+			wantCode: http.StatusServiceUnavailable,
+		},
+		"is not served with the feature gate off": {
+			body:     body,
+			wantCode: http.StatusNotFound,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGateDuringTest(t, features.PreSubmissionSimulator, tc.enabled)
+			handler := newTestVisibilityServer(t, tc.unsynced).Handler
+
+			req := httptest.NewRequest(http.MethodPost, simulatePath, strings.NewReader(tc.body))
+			req.Header.Set("Content-Type", "application/json")
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, req)
+			if rec.Code != tc.wantCode {
+				t.Fatalf("POST %s returned %d, want %d: %s", simulatePath, rec.Code, tc.wantCode, rec.Body.String())
+			}
+			if tc.wantCode != http.StatusCreated {
+				return
+			}
+			var got visibilityv1beta2.WorkloadSimulation
+			if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+				t.Fatalf("Decoding the response %s: %v", rec.Body.String(), err)
+			}
+			if got.Kind != "WorkloadSimulation" || got.Status.Mode != tc.wantMode || got.Status.ClusterQueue != "cq" {
+				t.Errorf("Unexpected response: %s", rec.Body.String())
+			}
+			if len(got.ManagedFields) > 0 {
+				t.Errorf("The response carries managed fields: %v", got.ManagedFields)
+			}
+			// The field that the request leaves out stays out of the response.
+			for _, unset := range []string{`"job":null`, `"workload":null`} {
+				if strings.Contains(rec.Body.String(), unset) {
+					t.Errorf("The response has %s: %s", unset, rec.Body.String())
+				}
+			}
+		})
+	}
+}
+
+// TestVisibilityOpenAPIWithSimulation checks that the server builds its OpenAPI
+// documents, which fails when a type it serves has no generated definition.
+func TestVisibilityOpenAPIWithSimulation(t *testing.T) {
+	features.SetFeatureGateDuringTest(t, features.PreSubmissionSimulator, true)
+	handler := newTestVisibilityServer(t, false).PrepareRun().Handler
+	for _, path := range []string{"/openapi/v2", "/openapi/v3/apis/visibility.kueue.x-k8s.io/v1beta2"} {
+		req := httptest.NewRequest(http.MethodGet, path, nil)
+		req.Header.Set("Accept", "application/json")
+		rec := httptest.NewRecorder()
+		handler.ServeHTTP(rec, req)
+		if rec.Code != http.StatusOK {
+			t.Fatalf("GET %s returned %d: %s", path, rec.Code, rec.Body.String())
+		}
+		for _, want := range []string{"io.k8s.kueue.visibility.v1beta2.WorkloadSimulation", "/localqueues/{name}/simulate"} {
+			if !strings.Contains(rec.Body.String(), want) {
+				t.Errorf("GET %s does not mention %q", path, want)
+			}
+		}
+	}
+}
+
+// newTestVisibilityServer builds the visibility server over a ClusterQueue "cq"
+// with 4 CPUs, which LocalQueue default/lq points to. With unsynced, the cache
+// waits for an informer that never syncs.
+func newTestVisibilityServer(t *testing.T, unsynced bool) *genericapiserver.GenericAPIServer {
+	t.Helper()
+	ctx, log := utiltesting.ContextWithLog(t)
+	jobGVK := batchv1.SchemeGroupVersion.WithKind("Job")
+	cl := utiltesting.NewClientBuilder(batchv1.AddToScheme).
+		WithObjects(utiltesting.MakeNamespace("default")).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(jobGVK), indexer.WorkloadOwnerIndexFunc(jobGVK)).
+		Build()
+	cache := schdcache.New(cl)
+	if unsynced {
+		cache.TrackInitialSync(neverSynced{})
+	}
+	cache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+	expectations := preemptexpectations.New()
+	queues := qcache.NewManagerForUnitTests(cl, cache, qcache.WithPreemptionExpectations(expectations))
+	if err := queues.AddLocalQueue(ctx, utiltestingapi.MakeLocalQueue("lq", "default").ClusterQueue("cq").Obj()); err != nil {
+		t.Fatal(err)
+	}
+	cq := utiltestingapi.MakeClusterQueue("cq").
+		ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "4").Obj()).Obj()
+	if err := cache.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	if err := queues.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	simulator := scheduler.NewSimulator(queues, cache, cl, scheduler.WithPreemptionExpectations(expectations))
+	integrations := jobframework.NewIntegrationManager()
+	if err := job.RegisterIntegration(integrations); err != nil {
+		t.Fatal(err)
+	}
+	integrations.EnableIntegration(job.FrameworkName)
+	jobs := jobframework.NewWorkloadBuilder(cl, jobframework.WithIntegrationManager(integrations))
+
+	config := newVisibilityServerConfig(&rest.Config{})
+	config.LoopbackClientConfig = &rest.Config{}
+	// Without a secure port, Complete cannot derive the address from it.
+	config.ExternalAddress = "127.0.0.1:443"
+	server, err := config.Complete().New("visibility-server-test", genericapiserver.NewEmptyDelegate())
+	if err != nil {
+		t.Fatalf("Creating the visibility server: %v", err)
+	}
+	if err := install(server, queues, simulator, jobs); err != nil {
+		t.Fatalf("Installing the visibility API: %v", err)
+	}
+	return server
+}
+
+// neverSynced is an informer source that never syncs.
+type neverSynced struct {
+	source.SyncingSource
+}
