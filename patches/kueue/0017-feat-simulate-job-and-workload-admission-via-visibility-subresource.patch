+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+	workloadfinish "sigs.k8s.io/kueue/pkg/workload/finish"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+// ErrJobNotSimulatable is returned for a job that Kueue would not build a
+// Workload for, or cannot build one for from the job alone.
+var ErrJobNotSimulatable = errors.New("the job cannot be simulated")
+
+// WorkloadBuilder builds the Workload that a job reconciler would make for a
+// job that is not created or not changed yet, with the reconciler's own code. Its
+// reconciler reads through a client that drops every write and records no
+// event, so nothing it does is stored. Only a server-side dry run that an
+// integration sends, as the TrainJob integration does to default its PodSets,
+// reaches the API server.
+type WorkloadBuilder struct {
+	reconciler *JobReconciler
+}
+
+// NewWorkloadBuilder returns a WorkloadBuilder for the job reconcilers that opts
+// configure, which reads through c.
+func NewWorkloadBuilder(c client.Client, opts ...Option) *WorkloadBuilder {
+	return &WorkloadBuilder{reconciler: NewReconciler(droppedWrites{c}, noEvents{}, opts...)}
+}
+
+// Build decodes raw as a job of an enabled integration in namespace, and returns
+// the Workload that its job reconciler would have for it: for a job without a
+// Workload, the one that it would create; for a job with one, that Workload as
+// the API server stores it, updated as the reconciler would update it for raw,
+// and stored is true. The API server ignores the status of an object on create
+// and update, and the reconciler's client drops the fields that its type does
+// not have, so Build ignores both.
+func (b *WorkloadBuilder) Build(ctx context.Context, raw []byte, namespace string) (wl *kueue.Workload, stored bool, err error) {
+	ctx = ctrl.LoggerInto(ctx, ctrl.LoggerFrom(ctx).WithName("workload-builder"))
+	job, err := b.decode(raw, namespace)
+	if err != nil {
+		return nil, false, err
+	}
+	if err := b.managed(ctx, job); err != nil {
+		return nil, false, err
+	}
+	existing, err := workloadslicing.FindNotFinishedWorkloads(ctx, b.reconciler.client, job.Object(), job.GVK())
+	switch {
+	case err != nil:
+		return nil, false, err
+	case len(existing) > 1:
+		return nil, false, fmt.Errorf("%w: it has %d Workloads that are not finished", ErrJobNotSimulatable, len(existing))
+	case len(existing) == 1 && job.Object().GetUID() == "":
+		// The reconciler matches a Workload to the job by the job's UID.
+		return nil, false, fmt.Errorf("%w: it exists, but it has no uid; send the job as a server-side dry run of the change returns it", ErrJobNotSimulatable)
+	}
+	wl, stored, err = b.build(ctx, job)
+	var status apierrors.APIStatus
+	switch {
+	case errors.Is(err, ErrJobNotSimulatable):
+		return nil, false, err
+	case errors.Is(err, ErrNoMatchingWorkloads), errors.Is(err, ErrExtraWorkloads):
+		return nil, false, fmt.Errorf("%w: Kueue would delete its Workload and build another one", ErrJobNotSimulatable)
+	case apierrors.IsNotFound(err):
+		// A missing priority class or other object that the job names.
+		return nil, false, fmt.Errorf("%w: %w", ErrJobNotSimulatable, err)
+	case errors.As(err, &status), errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		return nil, false, err
+	case err != nil:
+		// The integration code rejects the job.
+		return nil, false, fmt.Errorf("%w: %w", ErrJobNotSimulatable, err)
+	case workloadfinish.IsFinished(wl):
+		return nil, false, fmt.Errorf("%w: its Workload is finished", ErrJobNotSimulatable)
+	case !wl.DeletionTimestamp.IsZero():
+		return nil, false, fmt.Errorf("%w: its Workload is being deleted", ErrJobNotSimulatable)
+	}
+	return wl, stored, nil
+}
+
+// decode returns raw as the GenericJob of its integration, in namespace.
+func (b *WorkloadBuilder) decode(raw []byte, namespace string) (GenericJob, error) {
+	u := &unstructured.Unstructured{}
+	if err := u.UnmarshalJSON(raw); err != nil {
+		return nil, fmt.Errorf("%w: %w", ErrJobNotSimulatable, err)
+	}
+	gvk := u.GroupVersionKind()
+	manager := b.reconciler.integrationManager
+	name, found := manager.gvkToName[gvk]
+	if !found || !manager.getEnabledIntegrations().Has(name) {
+		return nil, fmt.Errorf("%w: %s %s is not the job of an enabled integration", ErrJobNotSimulatable, gvk.GroupVersion(), gvk.Kind)
+	}
+	callbacks, _ := manager.get(name)
+	if callbacks.NewJob == nil {
+		return nil, fmt.Errorf("%w: Kueue builds the Workloads of a %s from its pods", ErrJobNotSimulatable, gvk.Kind)
+	}
+	job := callbacks.NewJob()
+	// The Workload of a pod group is built from all pods of the group, and the
+	// reconciler of a composable job finalizes and deletes pods while it builds.
+	if _, composable := job.(ComposableJob); composable {
+		return nil, fmt.Errorf("%w: Kueue builds the Workload of a %s from all members of its group", ErrJobNotSimulatable, gvk.Kind)
+	}
+	unstructured.RemoveNestedField(u.Object, "status")
+	if err := runtime.DefaultUnstructuredConverter.FromUnstructured(u.Object, job.Object()); err != nil {
+		return nil, fmt.Errorf("%w: %w", ErrJobNotSimulatable, err)
+	}
+	switch obj := job.Object(); obj.GetNamespace() {
+	case "":
+		obj.SetNamespace(namespace)
+	case namespace:
+	default:
+		return nil, fmt.Errorf("%w: its namespace %q is not the request's namespace %q", ErrJobNotSimulatable, obj.GetNamespace(), namespace)
+	}
+	return job, nil
+}
+
+// managed returns ErrJobNotSimulatable for a job that ReconcileGenericJob builds
+// no Workload for: one that names a prebuilt Workload, one that its
+// integration skips, one in a namespace that the managedJobsNamespaceSelector
+// does not select, and one that Kueue manages through an owner. It makes the
+// checks that ReconcileGenericJob makes before ensureOneWorkload, so a change to
+// those checks must change it too.
+func (b *WorkloadBuilder) managed(ctx context.Context, job GenericJob) error {
+	r := b.reconciler
+	obj := job.Object()
+	if name := PrebuiltWorkloadNameFor(obj); name != "" {
+		return fmt.Errorf("%w: it uses the prebuilt Workload %q", ErrJobNotSimulatable, name)
+	}
+	if skip, ok := job.(JobWithSkip); ok && skip.Skip(ctx) {
+		return fmt.Errorf("%w: Kueue does not manage it", ErrJobNotSimulatable)
+	}
+	if r.managedJobsNamespaceSelector != nil {
+		ns := &corev1.Namespace{}
+		if err := r.client.Get(ctx, client.ObjectKey{Name: obj.GetNamespace()}, ns); err != nil {
+			return err
+		}
+		if !r.managedJobsNamespaceSelector.Matches(labels.Set(ns.Labels)) {
+			return fmt.Errorf("%w: Kueue does not manage the jobs of namespace %s", ErrJobNotSimulatable, ns.Name)
+		}
+	}
+	if topLevel, ok := job.(TopLevelJob); ok && topLevel.IsTopLevel() {
+		return nil
+	}
+	ancestor, err := r.integrationManager.FindAncestorJobManagedByKueue(ctx, r.client, obj, r.manageJobsWithoutQueueName)
+	switch {
+	case errors.Is(err, ErrManagedOwnersChainLimitReached), errors.Is(err, ErrCyclicOwnership), errors.Is(err, ErrWorkloadOwnerNotFound):
+		return fmt.Errorf("%w: %w", ErrJobNotSimulatable, err)
+	case err != nil:
+		return err
+	case ancestor != nil:
+		return fmt.Errorf("%w: Kueue manages it through an owner", ErrJobNotSimulatable)
+	}
+	return nil
+}
+
+// build runs the steps of ReconcileGenericJob that give job its Workload. For a
+// job with a Workload, that is ensureOneWorkload, which returns the Workload as
+// it updates it, and the queue change of step 7 for a suspended job whose
+// Workload is not admitted; step 6 stops at an evicted Workload, so step 7 does
+// not move one. For a job without a Workload, it is constructWorkload and
+// prepareWorkload, as handleJobWithNoWorkload runs them. The integrations expect
+// a job that the API server has defaulted and validated, so a panic on another
+// job is an answer about the job.
+func (b *WorkloadBuilder) build(ctx context.Context, job GenericJob) (wl *kueue.Workload, stored bool, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			ctrl.LoggerFrom(ctx).V(2).Info("Kueue's job integration panicked on a simulated job", "panic", r, "stack", string(debug.Stack()))
+			wl, stored, err = nil, false, fmt.Errorf("%w: Kueue's integration failed on it (%v), so it is not the job as the API server stores it", ErrJobNotSimulatable, r)
+		}
+	}()
+	r := b.reconciler
+	wl, err = r.ensureOneWorkload(ctx, job, job.Object())
+	if err != nil {
+		return nil, false, err
+	}
+	if wl == nil {
+		wl, err = r.constructWorkload(ctx, job)
+		if err != nil {
+			return nil, false, err
+		}
+		return wl, false, r.prepareWorkload(ctx, job, wl, wl.Spec.Active)
+	}
+	if job.IsSuspended() && !workload.IsAdmitted(wl) && !apimeta.IsStatusConditionTrue(wl.Status.Conditions, kueue.WorkloadEvicted) {
+		return wl, true, r.handleQueueNameChange(ctx, job, wl)
+	}
+	return wl, true, nil
+}
+
+// noEvents is the event recorder of a WorkloadBuilder, which records no event.
+type noEvents struct{}
+
+func (noEvents) Eventf(runtime.Object, runtime.Object, string, string, string, string, ...any) {}
+
+// droppedWrites is the client of a WorkloadBuilder's reconciler. It reads, and
+// drops each write as if the API server had made it, so the reconciler goes on
+// with the objects it changed in memory. It sends a server-side dry run, which
+// stores nothing.
+type droppedWrites struct {
+	client.Client
+}
+
+func (c droppedWrites) Create(ctx context.Context, obj client.Object, opts ...client.CreateOption) error {
+	if len((&client.CreateOptions{}).ApplyOptions(opts).DryRun) > 0 {
+		return c.Client.Create(ctx, obj, opts...)
+	}
+	return nil
+}
+
+func (droppedWrites) Update(context.Context, client.Object, ...client.UpdateOption) error {
+	return nil
+}
+
+func (droppedWrites) Patch(context.Context, client.Object, client.Patch, ...client.PatchOption) error {
+	return nil
+}
+
+func (droppedWrites) Apply(context.Context, runtime.ApplyConfiguration, ...client.ApplyOption) error {
+	return nil
+}
+
+func (droppedWrites) Delete(context.Context, client.Object, ...client.DeleteOption) error {
+	return nil
+}
+
+func (droppedWrites) DeleteAllOf(context.Context, client.Object, ...client.DeleteAllOfOption) error {
+	return nil
+}
+
+func (droppedWrites) Status() client.SubResourceWriter {
+	return droppedSubResourceWrites{}
+}
+
+func (c droppedWrites) SubResource(subResource string) client.SubResourceClient {
+	return droppedSubResourceWrites{SubResourceReader: c.Client.SubResource(subResource)}
+}
+
+// droppedSubResourceWrites reads a subresource and drops each write to it.
+type droppedSubResourceWrites struct {
+	client.SubResourceReader
+}
+
+func (droppedSubResourceWrites) Create(context.Context, client.Object, client.Object, ...client.SubResourceCreateOption) error {
+	return nil
+}
+
+func (droppedSubResourceWrites) Update(context.Context, client.Object, ...client.SubResourceUpdateOption) error {
+	return nil
+}
+
+func (droppedSubResourceWrites) Patch(context.Context, client.Object, client.Patch, ...client.SubResourcePatchOption) error {
+	return nil
+}
+
+func (droppedSubResourceWrites) Apply(context.Context, runtime.ApplyConfiguration, ...client.SubResourceApplyOption) error {
+	return nil
+}
