+func TestSimulateInLQErrors(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	cases := map[string]struct {
+		setup simulationSetup
+		// job sends a job, which the server reads through the controller
+		// manager's cache, instead of a Workload.
+		job     bool
+		wantErr func(error) bool
+	}{
+		"the cache has not synced": {
+			setup:   simulationSetup{unsynced: true},
+			wantErr: apierrors.IsServiceUnavailable,
+		},
+		"the cache has not synced for a job": {
+			setup:   simulationSetup{unsynced: true},
+			job:     true,
+			wantErr: apierrors.IsServiceUnavailable,
+		},
+		"the namespace cannot be read": {
+			setup:   simulationSetup{failNamespaceReads: true},
+			wantErr: apierrors.IsInternalError,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			tc.setup.clusterQueues = []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Obj()}
+			tc.setup.localQueues = []*kueue.LocalQueue{utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj()}
+			env := newSimulationEnv(t, now, tc.setup)
+			var err error
+			if tc.job {
+				_, err = env.simulateJob(ctx, t, "lq-a", testingjob.MakeJob("incoming", "").SetTypeMeta().Queue("lq-a").Request(corev1.ResourceCPU, "1").Obj())
+			} else {
+				_, err = env.simulate(ctx, t, "lq-a", simulatedWorkload("incoming").Request(corev1.ResourceCPU, "1").Obj())
+			}
+			if !tc.wantErr(err) {
+				t.Errorf("Unexpected error: %v", err)
+			}
+		})
+	}
+}
