+
+package queue
+
+import (
+	"context"
+	"maps"
+	"slices"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+// WorkloadInfo returns the workload.Info that the Manager would queue for wl,
+// without queuing it.
+func (m *Manager) WorkloadInfo(ctx context.Context, wl *kueue.Workload) *workload.Info {
+	return workload.NewInfoFromClient(ctx, m.client, wl, m.workloadInfoOptions...)
+}
+
+// PendingWorkload returns the pending workload with key in the ClusterQueue, or
+// nil when it has none.
+func (m *Manager) PendingWorkload(cqName kueue.ClusterQueueReference, key workload.Reference) *workload.Info {
+	cq := m.getClusterQueue(cqName)
+	if cq == nil {
+		return nil
+	}
+	return cq.trackedInfo(key)
+}
+
+// PendingWorkloadsAhead returns, in queue order, the pending workloads that the
+// ClusterQueue would order before wl if wl were added to it now. The order is the
+// one PendingWorkloadsInfo reports. A pending workload with wl's key is left out,
+// since wl stands for it.
+func (m *Manager) PendingWorkloadsAhead(cqName kueue.ClusterQueueReference, wl *workload.Info) []*workload.Info {
+	cq := m.getClusterQueue(cqName)
+	if cq == nil {
+		return nil
+	}
+	cq.rwm.RLock()
+	elements := cq.workloads.DumpAll()
+	lqWeights := maps.Clone(cq.lqWeights)
+	cq.rwm.RUnlock()
+	key := workload.Key(wl.Obj)
+	elements = slices.DeleteFunc(elements, func(e *workload.Info) bool { return workload.Key(e.Obj) == key })
+	elements = append(elements, wl)
+	cq.snapshotSort(elements, lqWeights)
+	return elements[:slices.Index(elements, wl)]
+}
