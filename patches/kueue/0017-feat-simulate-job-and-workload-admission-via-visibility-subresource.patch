+
+// SplitAsRefused applies to wl, a first slice that is not created, the split
+// that the flavor assigner proposed in message when it refused wl, as
+// splitRefusedProbe does for a refused first slice. It reports whether it
+// changed wl.
+func SplitAsRefused(wl *kueue.Workload, message string) bool {
+	if !features.Enabled(features.ElasticJobsViaWorkloadSlicesFlavorSplit) || ReplacementForKey(wl) != nil || !FlavorPlacementOnPods(wl) {
+		return false
+	}
+	split, ok := flavorassigner.ParseGreedySplit(message)
+	return ok && applyGreedySplit(wl, nil, split, false)
+}
