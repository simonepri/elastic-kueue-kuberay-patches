+func schema_kueue_apis_visibility_v1beta2_SimulatedPodSetAssignment(ref common.ReferenceCallback) common.OpenAPIDefinition {
+	return common.OpenAPIDefinition{
+		Schema: spec.Schema{
+			SchemaProps: spec.SchemaProps{
+				Description: "SimulatedPodSetAssignment is the flavor assignment of one PodSet.",
+				Type:        []string{"object"},
+				Properties: map[string]spec.Schema{
+					"name": {
+						SchemaProps: spec.SchemaProps{
+							Description: "name is the name of the PodSet.",
+							Default:     "",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+					"count": {
+						SchemaProps: spec.SchemaProps{
+							Description: "count is the number of pods the PodSet would be admitted with. It is below the PodSet's count when only a partial admission fits.",
+							Default:     0,
+							Type:        []string{"integer"},
+							Format:      "int32",
+						},
+					},
+					"flavors": {
+						SchemaProps: spec.SchemaProps{
+							Description: "flavors maps each resource of the PodSet to its ResourceFlavor. It is empty when mode is NoFit.",
+							Type:        []string{"object"},
+							AdditionalProperties: &spec.SchemaOrBool{
+								Allows: true,
+								Schema: &spec.Schema{
+									SchemaProps: spec.SchemaProps{
+										Type:   []string{"string"},
+										Format: "",
+									},
+								},
+							},
+						},
+					},
+					"topologyAssignment": {
+						SchemaProps: spec.SchemaProps{
+							Description: "topologyAssignment holds the topology domains the pods would be placed in, for a PodSet that topology-aware scheduling places. It is empty when mode is NoFit.",
+							Ref:         ref(v1beta2.SimulatedTopologyAssignment{}.OpenAPIModelName()),
+						},
+					},
+					"message": {
+						SchemaProps: spec.SchemaProps{
+							Description: "message says why the PodSet does not fit in the unused quota as requested. It is empty when the PodSet fits.",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+				},
+				Required: []string{"name", "count"},
+			},
+		},
+		Dependencies: []string{
+			v1beta2.SimulatedTopologyAssignment{}.OpenAPIModelName()},
+	}
+}
+
+func schema_kueue_apis_visibility_v1beta2_SimulatedPreemptionTarget(ref common.ReferenceCallback) common.OpenAPIDefinition {
+	return common.OpenAPIDefinition{
+		Schema: spec.Schema{
+			SchemaProps: spec.SchemaProps{
+				Description: "SimulatedPreemptionTarget is an admitted workload that would be preempted.",
+				Type:        []string{"object"},
+				Properties: map[string]spec.Schema{
+					"name": {
+						SchemaProps: spec.SchemaProps{
+							Description: "name is the name of the Workload.",
+							Default:     "",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+					"namespace": {
+						SchemaProps: spec.SchemaProps{
+							Description: "namespace is the namespace of the Workload.",
+							Default:     "",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+					"clusterQueue": {
+						SchemaProps: spec.SchemaProps{
+							Description: "clusterQueue is the ClusterQueue the Workload is admitted to.",
+							Default:     "",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+					"localQueueName": {
+						SchemaProps: spec.SchemaProps{
+							Description: "localQueueName is the LocalQueue the Workload was submitted to.",
+							Default:     "",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+					"priority": {
+						SchemaProps: spec.SchemaProps{
+							Description: "priority is the priority of the Workload.",
+							Default:     0,
+							Type:        []string{"integer"},
+							Format:      "int32",
+						},
+					},
+					"reason": {
+						SchemaProps: spec.SchemaProps{
+							Description: "reason is why the scheduler may preempt the Workload: InClusterQueue, InCohortReclamation, InCohortFairSharing, InCohortReclaimWhileBorrowing, or ConfigurablePreemption.",
+							Default:     "",
+							Type:        []string{"string"},
+							Format:      "",
+						},
+					},
+					"reclaimTargetCounts": {
+						SchemaProps: spec.SchemaProps{
+							Description: "reclaimTargetCounts is set when partial preemption would shrink the Workload instead of evicting it. It maps each PodSet that would shrink to the number of pods it would keep, which is never more than a reclaim target that the Workload already has.",
+							Type:        []string{"object"},
+							AdditionalProperties: &spec.SchemaOrBool{
+								Allows: true,
+								Schema: &spec.Schema{
+									SchemaProps: spec.SchemaProps{
+										Type:   []string{"integer"},
+										Format: "int32",
+									},
+								},
+							},
+						},
+					},
+				},
+				Required: []string{"name", "namespace", "clusterQueue", "localQueueName", "priority", "reason"},
+			},
+		},
+	}
+}
