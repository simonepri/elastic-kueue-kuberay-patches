+// +k8s:openapi-gen=true
+// +kubebuilder:object:root=true
+
+// WorkloadSimulation asks what the scheduler would do with a Workload that is not
+// created, if it were at the head of its ClusterQueue now. It is the body and the
+// response of a create on the localqueues/simulate subresource, which changes
+// nothing in the cluster.
+type WorkloadSimulation struct {
+	metav1.TypeMeta   `json:",inline"`
+	metav1.ObjectMeta `json:"metadata,omitempty"`
+
+	// spec holds the job or the Workload to simulate.
+	Spec WorkloadSimulationSpec `json:"spec"`
+
+	// status is the answer, which the server sets.
+	// +optional
+	Status WorkloadSimulationStatus `json:"status,omitempty"`
+}
+
+// WorkloadSimulationSpec holds the job or the Workload to simulate. Exactly one
+// of job and workload must be set.
+type WorkloadSimulationSpec struct {
+	// job is the job to simulate, of a Kueue integration that is enabled, such as
+	// a batch/v1 Job or a kubeflow.org/v1 PyTorchJob, as the API server would store
+	// it: the output of a server-side dry run of its create or update. Kueue applies
+	// none of the API server's defaults, mutating webhooks or admission policies.
+	// Kueue builds the Workload from it with the job reconciler of its integration.
+	// Its namespace defaults to that of the request and must equal it when set, and
+	// its queue-name label must name the request's LocalQueue. Its status is
+	// ignored, and so are the fields that its type does not have. When a job of the
+	// same kind, namespace and name has a Workload, the simulation is of that
+	// Workload, with its creation time and status, as the job reconciler would
+	// update it for job; when that Workload is not finished, job must have the
+	// uid of that job.
+	// +optional
+	Job *runtime.RawExtension `json:"job,omitempty"`
+
+	// workload is the kueue.x-k8s.io/v1beta2 Workload to simulate, as it would be
+	// created. Its namespace and spec.queueName default to those of the request and
+	// must equal them when set. Its status is ignored, and so are its uid,
+	// resourceVersion, creationTimestamp, generation, deletion fields and managed
+	// fields. The value of the
+	// WorkloadPriorityClass or PriorityClass in spec.priorityClassRef replaces
+	// spec.priority, as the job reconciler sets it in a Workload it builds from a
+	// job.
+	// +optional
+	Workload *runtime.RawExtension `json:"workload,omitempty"`
+}
+
+// SimulationMode says whether the simulated Workload would be admitted now.
+type SimulationMode string
+
+const (
+	// SimulationFit means the Workload fits in the unused quota and would get its
+	// quota reserved without preemption. Admission checks run after that.
+	SimulationFit SimulationMode = "Fit"
+	// SimulationPreempt means the Workload would get its quota reserved once the
+	// workloads in preemptionTargets are preempted.
+	SimulationPreempt SimulationMode = "Preempt"
+	// SimulationNoFit means the Workload would not get quota now; reason and
+	// message say why.
+	SimulationNoFit SimulationMode = "NoFit"
+)
+
+// WorkloadSimulationStatus is what the scheduler would do with the simulated
+// Workload if it were at the head of its ClusterQueue now, and where the
+// ClusterQueue's order puts it among the pending workloads.
+type WorkloadSimulationStatus struct {
+	// clusterQueue is the ClusterQueue that the LocalQueue points to.
+	ClusterQueue v1beta2.ClusterQueueReference `json:"clusterQueue"`
+
+	// mode is Fit, Preempt or NoFit.
+	Mode SimulationMode `json:"mode"`
+
+	// reason is the reason of the QuotaReserved condition that Kueue would give the
+	// Workload when mode is NoFit. Like Kueue, it is Pending when the
+	// UnadmittedWorkloadsObservability feature gate is off.
+	// +optional
+	Reason string `json:"reason,omitempty"`
+
+	// message explains mode with the scheduler's message: for NoFit why the
+	// Workload is not admitted, and for Preempt why it needs preemption. When the
+	// Workload needs preemption but no workload may be preempted, mode is NoFit and
+	// the message says so.
+	// +optional
+	Message string `json:"message,omitempty"`
+
+	// borrowing is true when the admission would use quota borrowed from the cohort.
+	// +optional
+	Borrowing bool `json:"borrowing,omitempty"`
+
+	// podSets holds the flavor assignment of each PodSet. It is empty when the
+	// Workload was rejected before flavor assignment, for example because its
+	// ClusterQueue is inactive.
+	// +optional
+	// +listType=atomic
+	PodSets []SimulatedPodSetAssignment `json:"podSets,omitempty"`
+
+	// preemptionTargets lists, when mode is Preempt, the admitted workloads that
+	// would be preempted, in the order the scheduler chose them. They can be in
+	// other namespaces of the cohort; a target in a namespace where the caller may
+	// not get Workloads has no name, namespace or LocalQueue.
+	// +optional
+	// +listType=atomic
+	PreemptionTargets []SimulatedPreemptionTarget `json:"preemptionTargets,omitempty"`
+
+	// positionInClusterQueue is the number of pending workloads that the
+	// ClusterQueue orders before the simulated Workload.
+	PositionInClusterQueue int32 `json:"positionInClusterQueue"`
+
+	// positionInLocalQueue is the number of those workloads that are in the
+	// simulated Workload's LocalQueue.
+	PositionInLocalQueue int32 `json:"positionInLocalQueue"`
+
+	// workloadsAhead lists those pending workloads in queue order, at most 1000.
+	// They can be in other namespaces of the ClusterQueue; one in a namespace
+	// where the caller may not get Workloads has no name, namespace or
+	// LocalQueue. A pending Workload with
+	// the simulated Workload's namespace and name is left out, since the simulated
+	// Workload stands for it.
+	// +optional
+	// +listType=atomic
+	WorkloadsAhead []PendingWorkload `json:"workloadsAhead,omitempty"`
+}
+
+// SimulatedPodSetAssignment is the flavor assignment of one PodSet.
+type SimulatedPodSetAssignment struct {
+	// name is the name of the PodSet.
+	Name v1beta2.PodSetReference `json:"name"`
+
+	// count is the number of pods the PodSet would be admitted with. It is below
+	// the PodSet's count when only a partial admission fits.
+	Count int32 `json:"count"`
+
+	// flavors maps each resource of the PodSet to its ResourceFlavor. It is empty
+	// when mode is NoFit.
+	// +optional
+	Flavors map[corev1.ResourceName]v1beta2.ResourceFlavorReference `json:"flavors,omitempty"`
+
+	// topologyAssignment holds the topology domains the pods would be placed in,
+	// for a PodSet that topology-aware scheduling places. It is empty when mode is
+	// NoFit.
+	// +optional
+	TopologyAssignment *SimulatedTopologyAssignment `json:"topologyAssignment,omitempty"`
+
+	// message says why the PodSet does not fit in the unused quota as requested. It
+	// is empty when the PodSet fits.
+	// +optional
+	Message string `json:"message,omitempty"`
+}
+
+// SimulatedTopologyAssignment holds the topology domains of a PodSet's pods.
+type SimulatedTopologyAssignment struct {
+	// levels are the topology levels that the values of each domain refer to,
+	// from the highest to the lowest.
+	// +listType=atomic
+	Levels []string `json:"levels"`
+
+	// domains lists the domains and the number of pods in each.
+	// +listType=atomic
+	Domains []SimulatedTopologyDomain `json:"domains"`
+}
+
+// SimulatedTopologyDomain is a topology domain and the number of pods in it.
+type SimulatedTopologyDomain struct {
+	// values are the domain's values of the levels, in the order of levels.
+	// +listType=atomic
+	Values []string `json:"values"`
+
+	// count is the number of pods in the domain.
+	Count int32 `json:"count"`
+}
+
+// SimulatedPreemptionTarget is an admitted workload that would be preempted.
+type SimulatedPreemptionTarget struct {
+	// name is the name of the Workload.
+	Name string `json:"name"`
+
+	// namespace is the namespace of the Workload.
+	Namespace string `json:"namespace"`
+
+	// clusterQueue is the ClusterQueue the Workload is admitted to.
+	ClusterQueue v1beta2.ClusterQueueReference `json:"clusterQueue"`
+
+	// localQueueName is the LocalQueue the Workload was submitted to.
+	LocalQueueName v1beta2.LocalQueueName `json:"localQueueName"`
+
+	// priority is the priority of the Workload.
+	Priority int32 `json:"priority"`
+
+	// reason is why the scheduler may preempt the Workload: InClusterQueue,
+	// InCohortReclamation, InCohortFairSharing, InCohortReclaimWhileBorrowing, or
+	// ConfigurablePreemption.
+	Reason string `json:"reason"`
+
+	// reclaimTargetCounts is set when partial preemption would shrink the Workload
+	// instead of evicting it. It maps each PodSet that would shrink to the number of
+	// pods it would keep, which is never more than a reclaim target that the
+	// Workload already has.
+	// +optional
+	ReclaimTargetCounts map[v1beta2.PodSetReference]int32 `json:"reclaimTargetCounts,omitempty"`
+}
