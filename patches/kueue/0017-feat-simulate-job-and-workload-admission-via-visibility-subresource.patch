+// namespacesAuthorizer allows getting Workloads in the namespaces it lists.
+type namespacesAuthorizer []string
+
+func (n namespacesAuthorizer) Authorize(_ context.Context, a authorizer.Attributes) (authorizer.Decision, string, error) {
+	if a.GetVerb() == "get" && a.GetResource() == "workloads" && slices.Contains(n, a.GetNamespace()) {
+		return authorizer.DecisionAllow, "", nil
+	}
+	return authorizer.DecisionNoOpinion, "", nil
+}
+
+// TestSimulateInLQChangesNothing checks that simulations whose Workloads the
+// scheduler would admit or preempt for leave the API objects, the cache, the
+// queues and the preemption expectations as they were, and record no event: the
+// Simulator has no recorder to record one with.
+func TestSimulateInLQChangesNothing(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	expectations := preemptexpectations.New()
+	env := newSimulationEnv(t, now, simulationSetup{
+		clusterQueues: []*kueue.ClusterQueue{
+			cpuClusterQueue("cq-a", "4").Preemption(kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}).Obj(),
+			cpuClusterQueue("cq-b", "4").Obj(),
+		},
+		localQueues: []*kueue.LocalQueue{
+			utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj(),
+			utiltestingapi.MakeLocalQueue("lq-b", simulationNamespace).ClusterQueue("cq-b").Obj(),
+		},
+		workloads: []*kueue.Workload{
+			admittedWorkload("low", "lq-a", "cq-a", 1, "4", now).Obj(),
+			utiltestingapi.MakeWorkload("queued", simulationNamespace).Queue("lq-a").Priority(5).Request(corev1.ResourceCPU, "1").Creation(now).
+				ControllerReference(batchv1.SchemeGroupVersion.WithKind("Job"), "queued-job", "queued-job-uid").Obj(),
+		},
+		priorityClass:  []*kueue.WorkloadPriorityClass{utiltestingapi.MakeWorkloadPriorityClass("high").PriorityValue(10).Obj()},
+		preemptionsLog: expectations,
+	})
+	ctx, log := utiltesting.ContextWithLog(t)
+	type state struct {
+		Workloads []kueue.Workload
+		Admitted  map[kueue.ClusterQueueReference][]workload.Reference
+		Usage     map[kueue.ClusterQueueReference]string
+		Pending   map[kueue.ClusterQueueReference][]workload.Reference
+	}
+	capture := func() state {
+		var s state
+		var list kueue.WorkloadList
+		if err := env.client.List(ctx, &list); err != nil {
+			t.Fatal(err)
+		}
+		s.Workloads = list.Items
+		snapshot, err := env.cache.Snapshot(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		s.Admitted = make(map[kueue.ClusterQueueReference][]workload.Reference)
+		s.Usage = make(map[kueue.ClusterQueueReference]string)
+		s.Pending = make(map[kueue.ClusterQueueReference][]workload.Reference)
+		for name, cq := range snapshot.ClusterQueues() {
+			for key := range cq.Workloads {
+				s.Admitted[name] = append(s.Admitted[name], key)
+			}
+			s.Usage[name] = fmt.Sprint(cq.ResourceNode.Usage)
+			for _, info := range env.queues.PendingWorkloadsInfo(name) {
+				s.Pending[name] = append(s.Pending[name], workload.Key(info.Obj))
+			}
+		}
+		return s
+	}
+	before := capture()
+	if diff := cmp.Diff(map[kueue.ClusterQueueReference][]workload.Reference{"cq-a": {"default/low"}}, before.Admitted); diff != "" {
+		t.Fatalf("Unexpected admitted workloads before the simulations (-want,+got):\n%s", diff)
+	}
+	if diff := cmp.Diff(map[kueue.ClusterQueueReference][]workload.Reference{"cq-a": {"default/queued"}}, before.Pending); diff != "" {
+		t.Fatalf("Unexpected pending workloads before the simulations (-want,+got):\n%s", diff)
+	}
+
+	for lq, wl := range map[string]*kueue.Workload{
+		"lq-a": simulatedWorkload("preemptor").Priority(10).Request(corev1.ResourceCPU, "4").Obj(),
+		"lq-b": simulatedWorkload("fits").Request(corev1.ResourceCPU, "1").Obj(),
+	} {
+		got, err := env.simulate(ctx, t, lq, wl)
+		if err != nil {
+			t.Fatalf("Simulating in %s: %v", lq, err)
+		}
+		if got.Status.Mode == visibility.SimulationNoFit {
+			t.Fatalf("Simulation in %s did not exercise an admission or a preemption: %+v", lq, got.Status)
+		}
+	}
+	// A job of the queued Workload, which the WorkloadBuilder finds.
+	got, err := env.simulateJob(
+		ctx,
+		t,
+		"lq-a",
+		testingjob.MakeJob("queued-job", "").SetTypeMeta().UID("queued-job-uid").Queue("lq-a").WorkloadPriorityClass("high").Request(corev1.ResourceCPU, "1").Obj(),
+	)
+	if err != nil {
+		t.Fatalf("Simulating a job: %v", err)
+	}
+	if got.Status.Mode == visibility.SimulationNoFit {
+		t.Fatalf("Simulation of a job did not exercise an admission or a preemption: %+v", got.Status)
+	}
+
+	if diff := cmp.Diff(before, capture(), cmpopts.SortSlices(func(a, b workload.Reference) bool { return a < b })); diff != "" {
+		t.Errorf("The simulations changed the cluster state (-before,+after):\n%s", diff)
+	}
+	if len(env.writes) > 0 {
+		t.Errorf("The simulations wrote to the API server: %v", env.writes)
+	}
+	if !expectations.Satisfied(log, client.ObjectKey{Namespace: simulationNamespace, Name: "low"}) {
+		t.Error("The simulations recorded a preemption expectation")
+	}
+}
