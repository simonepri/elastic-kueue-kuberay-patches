+
+package scheduler
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/go-logr/logr"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/uuid"
+	"k8s.io/klog/v2"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	qcache "sigs.k8s.io/kueue/pkg/cache/queue"
+	schdcache "sigs.k8s.io/kueue/pkg/cache/scheduler"
+	"sigs.k8s.io/kueue/pkg/features"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption"
+	afs "sigs.k8s.io/kueue/pkg/util/admissionfairsharing"
+	utilpriority "sigs.k8s.io/kueue/pkg/util/priority"
+	"sigs.k8s.io/kueue/pkg/util/queue"
+	"sigs.k8s.io/kueue/pkg/workload"
+	"sigs.k8s.io/kueue/pkg/workload/concurrentadmission"
+	"sigs.k8s.io/kueue/pkg/workloadslicing"
+)
+
+const (
+	// maxConcurrentSimulations bounds how many simulations hold a snapshot of the
+	// cache at once, since each takes one of its own and the manager's memory is
+	// small.
+	maxConcurrentSimulations = 2
+	// maxSimulatedAttempts bounds the scheduling attempts that one simulation
+	// makes. Each attempt that resumes a flavor scan tries at least one flavor
+	// more, and a resource group has at most 16 flavors, so the bound is only a
+	// guard.
+	maxSimulatedAttempts = 64
+)
+
+var (
+	// ErrNotSimulatable is returned for a Workload that cannot be simulated.
+	ErrNotSimulatable = errors.New("the workload cannot be simulated")
+	// ErrSimulatorNotSynced is returned until the scheduler cache has synced.
+	ErrSimulatorNotSynced = errors.New("the scheduler cache has not synced yet")
+	// ErrSimulatorBusy is returned when every simulation slot is taken.
+	ErrSimulatorBusy = errors.New("too many simulations are running")
+)
+
+// Simulation is what the scheduler would do with a Workload at the head of its
+// ClusterQueue.
+type Simulation struct {
+	// Info is the simulated Workload as the scheduler saw it.
+	Info *workload.Info
+	// Mode is Fit, Preempt or NoFit.
+	Mode flavorassigner.FlavorAssignmentMode
+	// Reason is the reason of the QuotaReserved condition the scheduler would set
+	// when Mode is NoFit.
+	Reason string
+	// Message explains Mode with the scheduler's message, which it would write to
+	// the QuotaReserved condition when Mode is NoFit.
+	Message string
+	// Assignment is the flavor assignment. It has no PodSets when the Workload was
+	// rejected before flavor assignment.
+	Assignment flavorassigner.Assignment
+	// Targets are the workloads to preempt when Mode is Preempt.
+	Targets []*preemption.Target
+}
+
+// Simulator answers what the scheduler would do with a Workload that is not
+// created if it were at the head of its ClusterQueue now: whether it fits,
+// which flavors, pod counts and topology domains it would get, and which
+// workloads it would preempt and why. It runs the scheduler's nomination and
+// the checks of processEntry on a snapshot of its own, and never issues a
+// preemption, admits, writes to the API server, records an event, or changes a
+// workload or usage in the cache or anything in the queues. Taking a snapshot
+// can store the topology tree of a flavor in the cache, as every snapshot of the
+// scheduler can.
+//
+// It answers for the Workload as the only head of a scheduling cycle: heads of
+// other ClusterQueues that the same cycle would process first are not
+// considered, and neither are the workloads ahead of it in its own ClusterQueue.
+type Simulator struct {
+	queues *qcache.Manager
+	cache  *schdcache.Cache
+	client client.Client
+	opts   []Option
+	slots  chan struct{}
+}
+
+// NewSimulator returns a Simulator for the scheduler that New builds from the
+// same arguments.
+func NewSimulator(queues *qcache.Manager, cache *schdcache.Cache, cl client.Client, opts ...Option) *Simulator {
+	return &Simulator{
+		queues: queues,
+		cache:  cache,
+		client: cl,
+		opts:   opts,
+		slots:  make(chan struct{}, maxConcurrentSimulations),
+	}
+}
+
+// Simulate evaluates wl, which names its namespace and LocalQueue, as if it were
+// created now and were the head of its ClusterQueue. Its status and system
+// metadata are ignored. It does not wait: it fails at once when the cache has
+// not synced or every slot is taken, since a request that waits holds a seat of
+// API Priority and Fairness and times out on the API server's deadline.
+func (sim *Simulator) Simulate(ctx context.Context, wl *kueue.Workload) (*Simulation, error) {
+	return sim.run(ctx, wl, false)
+}
+
+// SimulateStored evaluates wl, a Workload as the API server stores it with the
+// changes that its job reconciler would make, as if it were the head of its
+// ClusterQueue now. Unlike Simulate, it keeps the creation time, UID and status
+// of wl, from which the queue orders it, also in a ClusterQueue that wl moves to.
+func (sim *Simulator) SimulateStored(ctx context.Context, wl *kueue.Workload) (*Simulation, error) {
+	return sim.run(ctx, wl, true)
+}
+
+// run is Simulate, or SimulateStored when stored is true.
+func (sim *Simulator) run(ctx context.Context, wl *kueue.Workload, stored bool) (*Simulation, error) {
+	// Until the cache and the queues hold every workload, a snapshot shows free
+	// quota that is in use and a LocalQueue can be missing. The scheduler waits
+	// for the same sync.
+	if !sim.Synced() {
+		return nil, ErrSimulatorNotSynced
+	}
+	// The scheduler holds a replacement workload slice back through a timer that
+	// requeues workloads in the queues, which a simulation must not arm.
+	if workloadslicing.ReplacementForKey(wl) != nil {
+		return nil, fmt.Errorf("%w: it replaces a workload slice", ErrNotSimulatable)
+	}
+	cqName, found := sim.queues.ClusterQueueFromLocalQueue(queue.KeyFromWorkload(wl))
+	if !found {
+		return nil, qcache.ErrLocalQueueDoesNotExistOrInactive
+	}
+	// Kueue creates the variants of a Workload itself, and schedules only them in
+	// a ClusterQueue with a concurrent admission policy.
+	if concurrentadmission.IsVariant(wl) {
+		return nil, fmt.Errorf("%w: it is a concurrent admission variant", ErrNotSimulatable)
+	}
+	if sim.queues.ConcurrentAdmissionEnabled(cqName) {
+		return nil, fmt.Errorf("%w: ClusterQueue %s schedules variants of a Workload, not the Workload itself", ErrNotSimulatable, cqName)
+	}
+	select {
+	case sim.slots <- struct{}{}:
+		defer func() { <-sim.slots }()
+	default:
+		return nil, ErrSimulatorBusy
+	}
+
+	log := ctrl.LoggerFrom(ctx).WithName("simulator").WithValues("workload", klog.KObj(wl), "clusterQueue", klog.KRef("", string(cqName)))
+	ctx = ctrl.LoggerInto(ctx, log)
+	// A Scheduler of its own, never started: the running one keeps state across
+	// cycles that a simulation must neither read while it is written nor change.
+	// That is the scheduling cycle count, the regrowth holds, and the Preemptor's
+	// memory of failed topology retries, which would remember the simulated
+	// Workload. Its recorder is nil, since a simulation records no event.
+	s := New(sim.queues, sim.cache, sim.client, nil, sim.opts...)
+	if holder, found := sim.cache.ClusterQueueHolding(workload.Key(wl)); found {
+		return nil, fmt.Errorf("%w: %s already holds quota in ClusterQueue %s", ErrNotSimulatable, workload.Key(wl), holder)
+	}
+	var err error
+	if stored {
+		wl, err = s.withClassPriority(ctx, wl.DeepCopy())
+	} else {
+		wl, err = s.asCreated(ctx, wl, sim.queues.PendingWorkload(cqName, workload.Key(wl)))
+	}
+	if err != nil {
+		return nil, err
+	}
+	// The queues never hold such a Workload, so the scheduler never nominates it.
+	if !workload.IsAdmissible(wl) {
+		return nil, fmt.Errorf("%w: it is inactive, gated or on hold, so Kueue would not queue it", ErrNotSimulatable)
+	}
+	snapshot, err := s.snapshot(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("taking a snapshot of the cache: %w", err)
+	}
+	// The scheduling attempts that Kueue would make back to back, each on the
+	// snapshot, which every attempt restores. The answer is the first attempt
+	// that gets quota, or the last one.
+	head := sim.head(ctx, wl, cqName)
+	for attempt := int64(1); ; attempt++ {
+		s.schedulingCycle = attempt
+		result, err := s.simulate(ctx, log, head, snapshot)
+		if err != nil || result.Mode != flavorassigner.NoFit || attempt == maxSimulatedAttempts {
+			return result, err
+		}
+		switch split := head.Obj.DeepCopy(); {
+		case workloadslicing.SplitAsRefused(split, result.Message):
+			// The job reconciler splits a first slice that the flavor assigner
+			// refuses with a split proposal, and a later cycle admits the split
+			// Workload.
+			head = sim.head(ctx, split, cqName)
+		case result.Assignment.FlavorScanState.PendingFlavors():
+			// The queues give a Workload whose flavor scan stopped before the last
+			// flavor back to the next cycle, which resumes the scan.
+			head.FlavorScanState = result.Assignment.FlavorScanState.Clone()
+		default:
+			return result, nil
+		}
+	}
+}
+
+// Synced reports whether the scheduler cache has synced. Until it has, Simulate
+// returns ErrSimulatorNotSynced.
+func (sim *Simulator) Synced() bool {
+	return sim.cache.InitialSyncDone()
+}
+
+// head returns the queue head that the scheduler would pop for wl.
+func (sim *Simulator) head(ctx context.Context, wl *kueue.Workload, cqName kueue.ClusterQueueReference) qcache.Head {
+	info := sim.queues.WorkloadInfo(ctx, wl)
+	info.ClusterQueue = cqName
+	return qcache.Head{Info: *info}
+}
+
+// asCreated returns wl as the scheduler would see it once created: without
+// status, with the system metadata that the API server would give it, and with
+// the value of the WorkloadPriorityClass or PriorityClass in
+// spec.priorityClassRef as its priority, which the job reconciler writes to
+// spec.priority of a Workload it builds and the WorkloadPriorityClass
+// controller keeps current. The queue order and preemption read the creation
+// time and the UID, so a Workload that stands for the pending workload with its
+// key keeps that workload's; any other Workload is created now.
+func (s *Scheduler) asCreated(ctx context.Context, wl *kueue.Workload, pending *workload.Info) (*kueue.Workload, error) {
+	wl = wl.DeepCopy()
+	wl.Status = kueue.WorkloadStatus{}
+	wl.ResourceVersion = ""
+	wl.ManagedFields = nil
+	wl.DeletionTimestamp = nil
+	wl.DeletionGracePeriodSeconds = nil
+	if pending != nil {
+		wl.CreationTimestamp = pending.Obj.CreationTimestamp
+		wl.UID = pending.Obj.UID
+		wl.Generation = pending.Obj.Generation
+	} else {
+		wl.CreationTimestamp = metav1.NewTime(s.clock.Now())
+		wl.UID = uuid.NewUUID()
+		wl.Generation = 1
+	}
+	return s.withClassPriority(ctx, wl)
+}
+
+// withClassPriority sets the priority of wl to the value of the
+// WorkloadPriorityClass or PriorityClass in spec.priorityClassRef.
+func (s *Scheduler) withClassPriority(ctx context.Context, wl *kueue.Workload) (*kueue.Workload, error) {
+	ref := wl.Spec.PriorityClassRef
+	if ref == nil {
+		return wl, nil
+	}
+	var value int32
+	var err error
+	switch ref.Kind {
+	case kueue.WorkloadPriorityClassKind:
+		_, value, err = utilpriority.GetPriorityFromWorkloadPriorityClass(ctx, s.client, ref.Name)
+	case kueue.PodPriorityClassKind:
+		_, value, err = utilpriority.GetPriorityFromPriorityClass(ctx, s.client, ref.Name)
+	default:
+		return nil, fmt.Errorf("%w: spec.priorityClassRef has the unknown kind %q", ErrNotSimulatable, ref.Kind)
+	}
+	if apierrors.IsNotFound(err) {
+		return nil, fmt.Errorf("%w: %s %q not found", ErrNotSimulatable, ref.Kind, ref.Name)
+	}
+	if err != nil {
+		return nil, fmt.Errorf("reading %s %q: %w", ref.Kind, ref.Name, err)
+	}
+	wl.Spec.Priority = &value
+	return wl, nil
+}
+
+// simulate makes the decisions of nominate and processEntry for h as the only
+// head of a scheduling cycle, and stops where processEntry would act on them.
+func (s *Scheduler) simulate(ctx context.Context, log logr.Logger, h qcache.Head, snapshot *schdcache.Snapshot) (*Simulation, error) {
+	e, nominated := s.nominateWorkload(ctx, log, h, snapshot)
+	result := &Simulation{Info: &e.Info, Mode: flavorassigner.NoFit, Message: e.inadmissibleMsg}
+	defer func() {
+		if result.Mode == flavorassigner.NoFit {
+			result.Reason = workload.UnadmittedWorkloadReasonWithFallback(result.Reason, "Pending")
+		}
+	}()
+	if !nominated {
+		// The scheduler requeues the Workload without a status update after an
+		// internal error, so the error is the answer.
+		if e.skipStatusUpdate {
+			return nil, fmt.Errorf("checking that the workload is admissible: %s", e.inadmissibleMsg)
+		}
+		result.Reason = e.quotaReservedReason
+		return result, nil
+	}
+	// No other entry of the cycle has booked usage or preemption targets, so this
+	// only recomputes a TAS assignment that the fit check rejects.
+	fits := s.updateAssignmentIfNeeded(ctx, log, &e, snapshot, e.clusterQueueSnapshot, make(preemption.PreemptedWorkloads))
+	result.Assignment = e.assignment
+	result.Message = e.inadmissibleMsg
+	mode := e.assignment.RepresentativeMode()
+	switch {
+	case mode == flavorassigner.NoFit:
+		result.Reason = e.assignment.NoFitReason
+	case mode == flavorassigner.Preempt && len(e.preemptionTargets) == 0:
+		result.Reason = kueue.WorkloadQuotaReservedReasonWaitingForQuota
+		result.Message += "; no workload can be preempted to make room"
+	case mode == flavorassigner.Preempt && (features.Enabled(features.ConcurrentAdmission) || features.Enabled(features.MultiKueueOrchestratedPreemption)) &&
+		workload.HasClosedPreemptionGate(e.Obj):
+		result.Reason = kueue.PreemptionGated
+		result.Message = "Workload requires preemption, but it's gated"
+		// As markPreemptionGated, which makes the next attempt start over.
+		result.Assignment.FlavorScanState = workload.FlavorScanState{}
+	case !fits:
+		result.Reason = kueue.WorkloadQuotaReservedReasonWaitingForQuota
+		result.Message = "Workload no longer fits after processing another workload"
+		if !features.Enabled(features.FlavorFungibilityPreserveScanProgress) {
+			// As markSkipped.
+			result.Assignment.FlavorScanState = workload.FlavorScanState{}
+		}
+	default:
+		result.Mode = mode
+		result.Targets = e.preemptionTargets
+	}
+	return result, nil
+}
+
+// snapshot takes the snapshot of the cache that a scheduling cycle works on.
+func (s *Scheduler) snapshot(ctx context.Context) (*schdcache.Snapshot, error) {
+	var snapshotOpts []schdcache.SnapshotOption
+	if afs.Enabled(s.admissionFairSharing) {
+		snapshotOpts = append(snapshotOpts, schdcache.WithAfsUsageLedger(s.queues.AfsUsageLedger))
+	}
+	return s.cache.Snapshot(ctx, snapshotOpts...)
+}
