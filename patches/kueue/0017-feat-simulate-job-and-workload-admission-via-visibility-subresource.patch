+// outcome is what a simulation predicts, or what the scheduler then does with
+// the same Workload: whether it gets quota, and which workloads it preempts.
+type outcome struct {
+	Mode    string
+	Targets []string
+}
+
+// TestSimulateMatchesScheduling checks each simulation against the scheduler
+// itself: after the simulation, the same Workload is queued and the scheduler
+// runs its cycles on the same state, and the Workload must get quota, or the
+// same workloads must be evicted or shrunk, as the simulation said. The
+// ClusterQueues are StrictFIFO, so the scheduler makes its attempts back to
+// back, as the simulation assumes.
+func TestSimulateMatchesScheduling(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	admitted := func(name, cq, flavor string, priority int32, cpu int, node string) *utiltestingapi.WorkloadWrapper {
+		ps := utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 1).Request(corev1.ResourceCPU, strconv.Itoa(cpu))
+		psa := utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).Assignment(corev1.ResourceCPU, kueue.ResourceFlavorReference(flavor), strconv.Itoa(cpu))
+		if node != "" {
+			ps.RequiredTopologyRequest(corev1.LabelHostname)
+			psa.TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+				Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, 1).Obj()).Obj())
+		}
+		return utiltestingapi.MakeWorkload(name, "default").Queue(kueue.LocalQueueName("lq-"+cq)).Priority(priority).PodSets(*ps.Obj()).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission(kueue.ClusterQueueReference(cq)).PodSets(psa.Obj()).Obj(), now).AdmittedAt(true, now)
+	}
+	cpuQueue := func(name, nominal string) *utiltestingapi.ClusterQueueWrapper {
+		return utiltestingapi.MakeClusterQueue(name).QueueingStrategy(kueue.StrictFIFO).
+			ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, nominal).Obj())
+	}
+	incoming := func(priority int32, cpu string) *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload("incoming", "default").Queue("lq-cq").Priority(priority).Request(corev1.ResourceCPU, cpu).Creation(now)
+	}
+	lowerPriority := kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}
+	cases := map[string]struct {
+		gates     map[featuregate.Feature]bool
+		tas       bool
+		queues    []*kueue.ClusterQueue
+		workloads []*kueue.Workload
+		incoming  *kueue.Workload
+		want      outcome
+	}{
+		"fits": {
+			queues:   []*kueue.ClusterQueue{cpuQueue("cq", "4").Obj()},
+			incoming: incoming(0, "2").Obj(),
+			want:     outcome{Mode: "Fit"},
+		},
+		"preempts in its ClusterQueue": {
+			queues:    []*kueue.ClusterQueue{cpuQueue("cq", "4").Preemption(lowerPriority).Obj()},
+			workloads: []*kueue.Workload{admitted("low", "cq", "default", 1, 4, "").Obj()},
+			incoming:  incoming(10, "2").Obj(),
+			want:      outcome{Mode: "Preempt", Targets: []string{"low"}},
+		},
+		"reclaims from the cohort": {
+			queues: []*kueue.ClusterQueue{
+				cpuQueue("cq", "4").Cohort("cohort").Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny}).Obj(),
+				cpuQueue("other", "0").Cohort("cohort").Obj(),
+			},
+			workloads: []*kueue.Workload{admitted("borrower", "other", "default", 100, 4, "").Obj()},
+			incoming:  incoming(0, "2").Obj(),
+			want:      outcome{Mode: "Preempt", Targets: []string{"borrower"}},
+		},
+		"shrinks an elastic workload": {
+			gates:  map[featuregate.Feature]bool{features.PartialPreemption: true},
+			queues: []*kueue.ClusterQueue{cpuQueue("cq", "4").Preemption(lowerPriority).Obj()},
+			workloads: []*kueue.Workload{utiltestingapi.MakeWorkload("elastic", "default").Queue("lq-cq").Priority(1).
+				Annotation(constants.ReclaimMinCountsAnnotation, "main=1").
+				PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 4).Request(corev1.ResourceCPU, "1").Obj()).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+					Count(4).Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), now).AdmittedAt(true, now).Obj()},
+			incoming: incoming(10, "2").Obj(),
+			want:     outcome{Mode: "Preempt", Targets: []string{"elastic"}},
+		},
+		"does not fit in the quota": {
+			queues:   []*kueue.ClusterQueue{cpuQueue("cq", "4").Obj()},
+			incoming: incoming(0, "8").Obj(),
+			want:     outcome{Mode: "NoFit"},
+		},
+		"may preempt no workload": {
+			queues:    []*kueue.ClusterQueue{cpuQueue("cq", "4").Preemption(lowerPriority).Obj()},
+			workloads: []*kueue.Workload{admitted("same", "cq", "default", 10, 4, "").Obj()},
+			incoming:  incoming(10, "2").Obj(),
+			want:      outcome{Mode: "NoFit"},
+		},
+		"preempts on the next flavor after finding no targets on the first": {
+			gates: map[featuregate.Feature]bool{features.TopologyAwareScheduling: true},
+			tas:   true,
+			queues: []*kueue.ClusterQueue{utiltestingapi.MakeClusterQueue("cq").QueueingStrategy(kueue.StrictFIFO).
+				ResourceGroup(
+					*utiltestingapi.MakeFlavorQuotas("a").Resource(corev1.ResourceCPU, "8").Obj(),
+					*utiltestingapi.MakeFlavorQuotas("b").Resource(corev1.ResourceCPU, "4").Obj()).
+				FlavorFungibility(kueue.FlavorFungibility{WhenCanPreempt: kueue.TryNextFlavor, WhenCanBorrow: kueue.MayStopSearch}).
+				Preemption(lowerPriority).Obj()},
+			// Each node of flavor a keeps 2 CPUs of a high-priority workload, so no
+			// preemption there frees a node of 4 CPUs.
+			workloads: []*kueue.Workload{
+				admitted("high-a1", "cq", "a", 100, 2, "a1").Obj(),
+				admitted("low-a1", "cq", "a", 1, 2, "a1").Obj(),
+				admitted("high-a2", "cq", "a", 100, 2, "a2").Obj(),
+				admitted("low-a2", "cq", "a", 1, 2, "a2").Obj(),
+				admitted("low-b1", "cq", "b", 1, 4, "b1").Obj(),
+			},
+			incoming: utiltestingapi.MakeWorkload("incoming", "default").Queue("lq-cq").Priority(10).Creation(now).
+				PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 1).Request(corev1.ResourceCPU, "4").
+					RequiredTopologyRequest(corev1.LabelHostname).Obj()).Obj(),
+			want: outcome{Mode: "Preempt", Targets: []string{"low-b1"}},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, tc.gates)
+			ctx, log := utiltesting.ContextWithLog(t)
+			var items []kueue.Workload
+			for _, wl := range tc.workloads {
+				items = append(items, *wl.DeepCopy())
+			}
+			builder := utiltesting.NewClientBuilder().
+				WithLists(&kueue.WorkloadList{Items: items}).
+				WithObjects(utiltesting.MakeNamespace("default")).
+				WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+				WithStatusSubresource(&kueue.Workload{}).
+				WithInterceptorFuncs(interceptor.Funcs{SubResourceApply: utiltesting.TreatSSAAsStrategicMergeForApplyConfiguration})
+			if tc.tas {
+				if err := tasindexer.SetupIndexes(ctx, utiltesting.AsIndexer(builder)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			cl := builder.Build()
+			cqCache := schdcache.New(cl)
+			cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+			if tc.tas {
+				cqCache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+				for _, flavor := range []string{"a", "b"} {
+					cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor(flavor).NodeLabel("pool", flavor).TopologyName("hostname").Obj())
+				}
+				for node, pool := range map[string]string{"a1": "a", "a2": "a", "b1": "b"} {
+					cqCache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", pool).Label(corev1.LabelHostname, node).
+						StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("4"), corev1.ResourcePods: resource.MustParse("10")}).
+						Ready().Obj())
+				}
+			}
+			expectations := preemptexpectations.New()
+			queues := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithPreemptionExpectations(expectations))
+			for _, cq := range tc.queues {
+				if err := queues.AddLocalQueue(ctx, utiltestingapi.MakeLocalQueue("lq-"+cq.Name, "default").ClusterQueue(cq.Name).Obj()); err != nil {
+					t.Fatal(err)
+				}
+				if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+					t.Fatal(err)
+				}
+				if err := queues.AddClusterQueue(ctx, cq); err != nil {
+					t.Fatal(err)
+				}
+			}
+			opts := []Option{WithPreemptionExpectations(expectations)}
+
+			simulation, err := NewSimulator(queues, cqCache, cl, opts...).Simulate(ctx, tc.incoming)
+			if err != nil {
+				t.Fatalf("Simulating: %v", err)
+			}
+			predicted := outcome{Mode: simulation.Mode.String()}
+			for _, target := range simulation.Targets {
+				predicted.Targets = append(predicted.Targets, target.WorkloadInfo.Obj.Name)
+			}
+			slices.Sort(predicted.Targets)
+			if diff := cmp.Diff(tc.want, predicted); diff != "" {
+				t.Errorf("Unexpected simulation (-want,+got):\n%s", diff)
+			}
+
+			if err := cl.Create(ctx, tc.incoming.DeepCopy()); err != nil {
+				t.Fatal(err)
+			}
+			if err := queues.AddOrUpdateWorkload(ctx, log, tc.incoming.DeepCopy()); err != nil {
+				t.Fatal(err)
+			}
+			sched := New(queues, cqCache, cl, &utiltesting.EventRecorder{}, opts...)
+			var admissions sync.WaitGroup
+			sched.setAdmissionRoutineWrapper(routine.NewWrapper(func() { admissions.Add(1) }, func() { admissions.Done() }))
+			ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+			defer cancel()
+			go queues.CleanUpOnContext(ctx)
+			var done outcome
+			for range 3 {
+				sched.schedule(ctx)
+				admissions.Wait()
+				if done = scheduled(ctx, t, cl); done.Mode != "NoFit" {
+					break
+				}
+			}
+			if diff := cmp.Diff(predicted, done); diff != "" {
+				t.Errorf("The scheduler did otherwise than the simulation said (-simulation,+scheduler):\n%s", diff)
+			}
+		})
+	}
+}
+
+// scheduled reads what the scheduler did with the Workload "incoming".
+func scheduled(ctx context.Context, t *testing.T, cl client.Client) outcome {
+	t.Helper()
+	var list kueue.WorkloadList
+	if err := cl.List(ctx, &list); err != nil {
+		t.Fatal(err)
+	}
+	result := outcome{Mode: "NoFit"}
+	for _, wl := range list.Items {
+		switch {
+		case wl.Name == "incoming" && wl.Status.Admission != nil:
+			return outcome{Mode: "Fit"}
+		case workloadevict.IsEvicted(&wl) || wl.Annotations[constants.ReclaimTargetCountsAnnotation] != "":
+			result.Mode = "Preempt"
+			result.Targets = append(result.Targets, wl.Name)
+		}
+	}
+	slices.Sort(result.Targets)
+	return result
+}
