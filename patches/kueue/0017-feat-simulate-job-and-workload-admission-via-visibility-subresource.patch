+	workloadevict "sigs.k8s.io/kueue/pkg/workload/evict"
+)
+
+// TestSimulateWhileScheduling runs simulations while the scheduler works on the
+// same cache and queues: it admits some workloads, and for the others it issues
+// preemptions, a partial one among them, all placed by topology-aware
+// scheduling. With the race detector on, it checks that a simulation shares no
+// state with the running scheduler that either side writes without a lock.
+func TestSimulateWhileScheduling(t *testing.T) {
+	features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{features.TopologyAwareScheduling: true, features.PartialPreemption: true})
+	const pending = 6
+	now := time.Now().Truncate(time.Second)
+	ctx, log := utiltesting.ContextWithLog(t)
+	onNode := func(name, node string, priority int32, count int32) *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload(name, "default").Queue("lq").Priority(priority).
+			PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, int(count)).Request(corev1.ResourceCPU, "1").
+				RequiredTopologyRequest(corev1.LabelHostname).Obj()).
+			ReserveQuotaAt(utiltestingapi.MakeAdmission("cq").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+				Count(count).Assignment(corev1.ResourceCPU, "tas", strconv.Itoa(int(count))).
+				TopologyAssignment(utiltestingapi.MakeTopologyAssignment([]string{corev1.LabelHostname}).
+					Domain(utiltestingapi.MakeTopologyDomainAssignment([]string{node}, count).Obj()).Obj()).Obj()).Obj(), now).
+			AdmittedAt(true, now)
+	}
+	workloads := []kueue.Workload{
+		*onNode("low-0", "x1", 1, 2).Obj(),
+		*onNode("elastic", "x2", 1, 2).Annotation(constants.ReclaimMinCountsAnnotation, "main=1").Obj(),
+	}
+	for i := range pending {
+		workloads = append(workloads, *utiltestingapi.MakeWorkload(fmt.Sprintf("pending-%d", i), "default").Queue("lq").Priority(10).
+			PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 1).Request(corev1.ResourceCPU, "1").
+				RequiredTopologyRequest(corev1.LabelHostname).Obj()).
+			Creation(now.Add(time.Duration(i) * time.Second)).Obj())
+	}
+	builder := utiltesting.NewClientBuilder().
+		WithLists(&kueue.WorkloadList{Items: workloads}).
+		WithObjects(utiltesting.MakeNamespace("default")).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithStatusSubresource(&kueue.Workload{}).
+		WithInterceptorFuncs(interceptor.Funcs{SubResourceApply: utiltesting.TreatSSAAsStrategicMergeForApplyConfiguration})
+	if err := tasindexer.SetupIndexes(ctx, utiltesting.AsIndexer(builder)); err != nil {
+		t.Fatal(err)
+	}
+	cl := builder.Build()
+	cqCache := schdcache.New(cl)
+	cqCache.AddOrUpdateTopology(log, utiltestingapi.MakeTopology("hostname").Levels(corev1.LabelHostname).Obj())
+	cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("tas").NodeLabel("pool", "tas").TopologyName("hostname").Obj())
+	for _, node := range []string{"x1", "x2"} {
+		cqCache.TASCache().SyncNode(testingnode.MakeNode(node).Label("pool", "tas").Label(corev1.LabelHostname, node).
+			StatusAllocatable(corev1.ResourceList{corev1.ResourceCPU: resource.MustParse("4"), corev1.ResourcePods: resource.MustParse("10")}).
+			Ready().Obj())
+	}
+	cq := utiltestingapi.MakeClusterQueue("cq").
+		ResourceGroup(*utiltestingapi.MakeFlavorQuotas("tas").Resource(corev1.ResourceCPU, "6").Obj()).
+		Preemption(kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}).Obj()
+	lq := utiltestingapi.MakeLocalQueue("lq", "default").ClusterQueue("cq").Obj()
+	expectations := preemptexpectations.New()
+	queues := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithPreemptionExpectations(expectations))
+	if err := queues.AddLocalQueue(ctx, lq); err != nil {
+		t.Fatal(err)
+	}
+	if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	if err := queues.AddClusterQueue(ctx, cq); err != nil {
+		t.Fatal(err)
+	}
+	for i := range workloads[2:] {
+		if err := queues.AddOrUpdateWorkload(ctx, log, workloads[2+i].DeepCopy()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	opts := []Option{WithPreemptionExpectations(expectations)}
+	sched := New(queues, cqCache, cl, &utiltesting.EventRecorder{}, opts...)
+	var admissions sync.WaitGroup
+	sched.setAdmissionRoutineWrapper(routine.NewWrapper(func() { admissions.Add(1) }, func() { admissions.Done() }))
+	simulator := NewSimulator(queues, cqCache, cl, opts...)
+
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	go queues.CleanUpOnContext(ctx)
+
+	// The simulations run until the scheduling cycles are done, so they overlap
+	// every cycle.
+	var simulations sync.WaitGroup
+	done := make(chan struct{})
+	errs := make(chan error, 4)
+	for i := range 4 {
+		simulations.Go(func() {
+			for j := 0; ; j++ {
+				select {
+				case <-done:
+					return
+				default:
+				}
+				wl := utiltestingapi.MakeWorkload(fmt.Sprintf("simulated-%d-%d", i, j), "default").Queue("lq").Priority(20).
+					PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 2).Request(corev1.ResourceCPU, "1").
+						RequiredTopologyRequest(corev1.LabelHostname).Obj()).Obj()
+				result, err := simulator.Simulate(ctx, wl)
+				if errors.Is(err, ErrSimulatorBusy) {
+					time.Sleep(time.Millisecond)
+					continue
+				}
+				if err != nil {
+					errs <- err
+					return
+				}
+				if result.Mode == flavorassigner.DeferredFit {
+					errs <- fmt.Errorf("simulation %d-%d: unexpected mode %s", i, j, result.Mode)
+					return
+				}
+			}
+		})
+	}
+	// Two cycles admit the pending workloads that fit in the 2 free CPUs; the
+	// next ones preempt the admitted workloads of priority 1.
+	for range pending {
+		sched.schedule(ctx)
+	}
+	close(done)
+	simulations.Wait()
+	admissions.Wait()
+	close(errs)
+	for err := range errs {
+		t.Error(err)
+	}
+	if ctx.Err() != nil {
+		t.Fatalf("The scheduling cycles did not finish: %v", ctx.Err())
+	}
+	// The test means something only if the scheduler preempted while the
+	// simulations ran.
+	var list kueue.WorkloadList
+	if err := cl.List(ctx, &list); err != nil {
+		t.Fatal(err)
+	}
+	var preempted []string
+	for _, wl := range list.Items {
+		if workloadevict.IsEvicted(&wl) || wl.Annotations[constants.ReclaimTargetCountsAnnotation] != "" {
+			preempted = append(preempted, wl.Name)
+		}
+	}
+	if len(preempted) == 0 {
+		t.Error("The scheduler preempted no workload while the simulations ran")
+	}
+}
+
+// TestSimulateFailsFast checks that a simulation does not wait for the cache to
+// sync or for a free slot, since a request that waits would time out on the API
+// server's deadline instead.
+func TestSimulateFailsFast(t *testing.T) {
+	cases := map[string]struct {
+		unsynced    bool
+		takenSlots  int
+		wantErr     error
+		wantNoError bool
+	}{
+		"the cache has not synced": {unsynced: true, wantErr: ErrSimulatorNotSynced},
+		"every slot is taken":      {takenSlots: maxConcurrentSimulations, wantErr: ErrSimulatorBusy},
+		"a slot is free":           {takenSlots: maxConcurrentSimulations - 1, wantNoError: true},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, log := utiltesting.ContextWithLog(t)
+			cl := utiltesting.NewClientBuilder().
+				WithObjects(utiltesting.MakeNamespace("default")).
+				WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+				Build()
+			cqCache := schdcache.New(cl)
+			if tc.unsynced {
+				cqCache.TrackInitialSync(neverSyncedSource{})
+			}
+			cqCache.AddOrUpdateResourceFlavor(log, utiltestingapi.MakeResourceFlavor("default").Obj())
+			cq := utiltestingapi.MakeClusterQueue("cq").ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, "1").Obj()).Obj()
+			queues := qcache.NewManagerForUnitTests(cl, cqCache, qcache.WithPreemptionExpectations(preemptexpectations.New()))
+			if err := queues.AddLocalQueue(ctx, utiltestingapi.MakeLocalQueue("lq", "default").ClusterQueue("cq").Obj()); err != nil {
+				t.Fatal(err)
+			}
+			if err := cqCache.AddClusterQueue(ctx, cq); err != nil {
+				t.Fatal(err)
+			}
+			if err := queues.AddClusterQueue(ctx, cq); err != nil {
+				t.Fatal(err)
+			}
+			simulator := NewSimulator(queues, cqCache, cl)
+			for range tc.takenSlots {
+				simulator.slots <- struct{}{}
+			}
+			ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+			defer cancel()
+			_, err := simulator.Simulate(ctx, utiltestingapi.MakeWorkload("incoming", "default").Queue("lq").Obj())
+			switch {
+			case tc.wantNoError && err != nil:
+				t.Errorf("Unexpected error: %v", err)
+			case !tc.wantNoError && !errors.Is(err, tc.wantErr):
+				t.Errorf("Simulate returned %v, want %v", err, tc.wantErr)
+			}
+			if ctx.Err() != nil {
+				t.Errorf("Simulate waited until the deadline")
+			}
+		})
+	}
+}
+
+// neverSyncedSource is an informer source that never syncs.
+type neverSyncedSource struct {
+	source.SyncingSource
+}
