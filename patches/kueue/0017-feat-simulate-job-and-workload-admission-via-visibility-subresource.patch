+// TestSimulatedTargetKeepsALowerReclaimTarget checks that a victim whose reclaim
+// target is already below what the search leaves it reports the target, since
+// partial preemption never raises a target.
+func TestSimulatedTargetKeepsALowerReclaimTarget(t *testing.T) {
+	now := time.Now()
+	_, log := utiltesting.ContextWithLog(t)
+	victim := workload.NewInfo(log, utiltestingapi.MakeWorkload("elastic", simulationNamespace).Queue("lq-a").
+		Annotation(constants.ReclaimTargetCountsAnnotation, "main=1").
+		PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 4).Request(corev1.ResourceCPU, "1").Obj()).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission("cq-a").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+			Count(4).Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), now).Obj())
+	victim.ClusterQueue = "cq-a"
+	got := simulatedTarget(&preemption.Target{
+		WorkloadInfo: victim,
+		Reason:       kueue.InClusterQueueReason,
+		Remaining:    policy.ShrunkTo(victim, workload.PodSetsCounts{kueue.DefaultPodSetName: 2}),
+	})
+	if diff := cmp.Diff(map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 1}, got.ReclaimTargetCounts); diff != "" {
+		t.Errorf("Unexpected reclaim target counts (-want,+got):\n%s", diff)
+	}
+}
