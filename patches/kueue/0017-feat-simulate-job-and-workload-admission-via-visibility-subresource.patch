+
+const simulationNamespace = "default"
+
+// simulationEnv is a scheduler cache and queues filled from a fake client, as
+// the Kueue controllers fill them, with the simulate storage on top, which
+// builds the Workload of a batch/v1 Job or a PyTorchJob. The client records
+// every write.
+type simulationEnv struct {
+	rest   *simulateInLqREST
+	client client.Client
+	cache  *schdcache.Cache
+	queues *qcache.Manager
+
+	mu     sync.Mutex
+	writes []string
+	// cacheNotStarted makes every read fail as the reads of the controller
+	// manager's cache do before it starts.
+	cacheNotStarted bool
+}
+
+type simulationSetup struct {
+	flavors        []*kueue.ResourceFlavor
+	topologies     []*kueue.Topology
+	nodes          []*corev1.Node
+	clusterQueues  []*kueue.ClusterQueue
+	localQueues    []*kueue.LocalQueue
+	workloads      []*kueue.Workload
+	priorityClass  []*kueue.WorkloadPriorityClass
+	objects        []client.Object
+	schedulerOpts  []scheduler.Option
+	preemptionsLog *utilexpectations.Store
+	// failNamespaceReads makes every read of a Namespace fail.
+	failNamespaceReads bool
+	// unsynced leaves the cache waiting for an informer that never syncs, and
+	// makes the client's reads fail as those of a cache that has not started.
+	unsynced bool
+}
+
+func newSimulationEnv(t *testing.T, now time.Time, setup simulationSetup) *simulationEnv {
+	t.Helper()
+	ctx, log := utiltesting.ContextWithLog(t)
+	env := &simulationEnv{}
+	record := func(verb string, obj any) {
+		env.mu.Lock()
+		defer env.mu.Unlock()
+		env.writes = append(env.writes, fmt.Sprintf("%s %T", verb, obj))
+	}
+	objects := []client.Object{utiltesting.MakeNamespace(simulationNamespace)}
+	for _, obj := range setup.workloads {
+		objects = append(objects, obj.DeepCopy())
+	}
+	for _, obj := range setup.priorityClass {
+		objects = append(objects, obj)
+	}
+	objects = append(objects, setup.objects...)
+	builder := utiltesting.NewClientBuilder(batchv1.AddToScheme, kftraining.AddToScheme).
+		WithObjects(objects...).
+		WithIndex(&corev1.LimitRange{}, indexer.LimitRangeHasContainerOrPodType, indexer.IndexLimitRangeHasContainerOrPodType).
+		WithStatusSubresource(&kueue.Workload{}).
+		WithInterceptorFuncs(interceptor.Funcs{
+			Get: func(ctx context.Context, c client.WithWatch, key client.ObjectKey, obj client.Object, opts ...client.GetOption) error {
+				if _, isNamespace := obj.(*corev1.Namespace); isNamespace && setup.failNamespaceReads {
+					return errors.New("the API server is unavailable")
+				}
+				if env.cacheNotStarted {
+					return &cache.ErrCacheNotStarted{}
+				}
+				return c.Get(ctx, key, obj, opts...)
+			},
+			List: func(ctx context.Context, c client.WithWatch, list client.ObjectList, opts ...client.ListOption) error {
+				if env.cacheNotStarted {
+					return &cache.ErrCacheNotStarted{}
+				}
+				return c.List(ctx, list, opts...)
+			},
+			Create: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.CreateOption) error {
+				record("create", obj)
+				return c.Create(ctx, obj, opts...)
+			},
+			Update: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.UpdateOption) error {
+				record("update", obj)
+				return c.Update(ctx, obj, opts...)
+			},
+			Patch: func(ctx context.Context, c client.WithWatch, obj client.Object, patch client.Patch, opts ...client.PatchOption) error {
+				record("patch", obj)
+				return c.Patch(ctx, obj, patch, opts...)
+			},
+			Apply: func(ctx context.Context, c client.WithWatch, obj runtime.ApplyConfiguration, opts ...client.ApplyOption) error {
+				record("apply", obj)
+				return c.Apply(ctx, obj, opts...)
+			},
+			Delete: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.DeleteOption) error {
+				record("delete", obj)
+				return c.Delete(ctx, obj, opts...)
+			},
+			SubResourceCreate: func(ctx context.Context, c client.Client, sub string, obj client.Object, subObj client.Object, opts ...client.SubResourceCreateOption) error {
+				record("create "+sub, obj)
+				return c.SubResource(sub).Create(ctx, obj, subObj, opts...)
+			},
+			SubResourceUpdate: func(ctx context.Context, c client.Client, sub string, obj client.Object, opts ...client.SubResourceUpdateOption) error {
+				record("update "+sub, obj)
+				return c.SubResource(sub).Update(ctx, obj, opts...)
+			},
+			SubResourcePatch: func(ctx context.Context, c client.Client, sub string, obj client.Object, patch client.Patch, opts ...client.SubResourcePatchOption) error {
+				record("patch "+sub, obj)
+				return c.SubResource(sub).Patch(ctx, obj, patch, opts...)
+			},
+			SubResourceApply: func(ctx context.Context, c client.Client, sub string, obj runtime.ApplyConfiguration, opts ...client.SubResourceApplyOption) error {
+				record("apply "+sub, obj)
+				return c.SubResource(sub).Apply(ctx, obj, opts...)
+			},
+		})
+	for _, gvk := range []schema.GroupVersionKind{batchv1.SchemeGroupVersion.WithKind("Job"), kftraining.SchemeGroupVersion.WithKind(kftraining.PyTorchJobKind)} {
+		builder = builder.WithIndex(&kueue.Workload{}, indexer.OwnerReferenceIndexKey(gvk), indexer.WorkloadOwnerIndexFunc(gvk))
+	}
+	if len(setup.topologies) > 0 {
+		if err := tasindexer.SetupIndexes(ctx, utiltesting.AsIndexer(builder)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	env.client = builder.Build()
+	env.cache = schdcache.New(env.client)
+	if setup.unsynced {
+		env.cache.TrackInitialSync(neverSynced{})
+	}
+	for _, topology := range setup.topologies {
+		env.cache.AddOrUpdateTopology(log, topology)
+	}
+	flavors := setup.flavors
+	if flavors == nil {
+		flavors = []*kueue.ResourceFlavor{utiltestingapi.MakeResourceFlavor("default").Obj()}
+	}
+	for _, flavor := range flavors {
+		env.cache.AddOrUpdateResourceFlavor(log, flavor)
+	}
+	for _, node := range setup.nodes {
+		env.cache.TASCache().SyncNode(node)
+	}
+	clock := testingclock.NewFakeClock(now)
+	expectations := setup.preemptionsLog
+	if expectations == nil {
+		expectations = preemptexpectations.New()
+	}
+	env.queues = qcache.NewManagerForUnitTests(env.client, env.cache, qcache.WithClock(clock), qcache.WithPreemptionExpectations(expectations))
+	for _, lq := range setup.localQueues {
+		if err := env.queues.AddLocalQueue(ctx, lq); err != nil {
+			t.Fatalf("Adding LocalQueue %s: %v", lq.Name, err)
+		}
+	}
+	for _, cq := range setup.clusterQueues {
+		if err := env.cache.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatalf("Adding ClusterQueue %s to the cache: %v", cq.Name, err)
+		}
+		if err := env.queues.AddClusterQueue(ctx, cq); err != nil {
+			t.Fatalf("Adding ClusterQueue %s to the queues: %v", cq.Name, err)
+		}
+	}
+	// The cache loads the admitted workloads with their ClusterQueue; the
+	// workload controller queues the pending ones.
+	for _, wl := range setup.workloads {
+		if !workload.HasQuotaReservation(wl) {
+			if err := env.queues.AddOrUpdateWorkload(ctx, log, wl.DeepCopy()); err != nil {
+				t.Fatalf("Queueing Workload %s: %v", wl.Name, err)
+			}
+		}
+	}
+	opts := append([]scheduler.Option{scheduler.WithClock(t, clock), scheduler.WithPreemptionExpectations(expectations)}, setup.schedulerOpts...)
+	integrations := jobframework.NewIntegrationManager()
+	for _, register := range []func(*jobframework.IntegrationManager) error{job.RegisterIntegration, pytorchjob.RegisterIntegration} {
+		if err := register(integrations); err != nil {
+			t.Fatal(err)
+		}
+	}
+	integrations.EnableIntegration(job.FrameworkName)
+	integrations.EnableIntegration(pytorchjob.FrameworkName)
+	jobs := jobframework.NewWorkloadBuilder(env.client, jobframework.WithIntegrationManager(integrations))
+	env.rest = NewSimulateInLqREST(env.queues, scheduler.NewSimulator(env.queues, env.cache, env.client, opts...), jobs, nil)
+	env.cacheNotStarted = setup.unsynced
+	return env
+}
+
+// neverSynced is an informer source that never syncs.
+type neverSynced struct {
+	source.SyncingSource
+}
+
+// simulate sends a create on localqueues/simulate with wl as spec.workload.
+func (env *simulationEnv) simulate(ctx context.Context, t *testing.T, localQueue string, wl any) (*visibility.WorkloadSimulation, error) {
+	t.Helper()
+	return env.create(ctx, localQueue, visibility.WorkloadSimulationSpec{Workload: rawExtension(t, wl)})
+}
+
+// simulateJob sends a create on localqueues/simulate with job as spec.job.
+func (env *simulationEnv) simulateJob(ctx context.Context, t *testing.T, localQueue string, job any) (*visibility.WorkloadSimulation, error) {
+	t.Helper()
+	return env.create(ctx, localQueue, visibility.WorkloadSimulationSpec{Job: rawExtension(t, job)})
+}
+
+func (env *simulationEnv) create(ctx context.Context, localQueue string, spec visibility.WorkloadSimulationSpec) (*visibility.WorkloadSimulation, error) {
+	ctx = genericapirequest.WithNamespace(ctx, simulationNamespace)
+	obj, err := env.rest.Create(ctx, localQueue, &visibility.WorkloadSimulation{Spec: spec}, nil, &metav1.CreateOptions{})
+	if err != nil {
+		return nil, err
+	}
+	return obj.(*visibility.WorkloadSimulation), nil
+}
+
+func rawExtension(t *testing.T, obj any) *runtime.RawExtension {
+	t.Helper()
+	raw, err := json.Marshal(obj)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &runtime.RawExtension{Raw: raw}
+}
+
+// simulatedWorkload is a Workload as a client sends it: with its kind and no
+// namespace or queue name, which the request supplies.
+func simulatedWorkload(name string) *utiltestingapi.WorkloadWrapper {
+	w := utiltestingapi.MakeWorkload(name, "")
+	w.TypeMeta = metav1.TypeMeta{APIVersion: kueue.SchemeGroupVersion.String(), Kind: "Workload"}
+	return w
+}
+
+func admittedWorkload(name, lq string, cq kueue.ClusterQueueReference, priority int32, cpu string, now time.Time) *utiltestingapi.WorkloadWrapper {
+	return utiltestingapi.MakeWorkload(name, simulationNamespace).Queue(kueue.LocalQueueName(lq)).Priority(priority).
+		Request(corev1.ResourceCPU, cpu).
+		ReserveQuotaAt(utiltestingapi.MakeAdmission(cq).PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+			Assignment(corev1.ResourceCPU, "default", cpu).Obj()).Obj(), now).
+		AdmittedAt(true, now)
+}
+
+func cpuClusterQueue(name, nominal string) *utiltestingapi.ClusterQueueWrapper {
+	return utiltestingapi.MakeClusterQueue(name).
+		ResourceGroup(*utiltestingapi.MakeFlavorQuotas("default").Resource(corev1.ResourceCPU, nominal).Obj())
+}
+
+func TestSimulateInLQ(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	lowerPriority := kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}
+	localQueues := []*kueue.LocalQueue{
+		utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj(),
+		utiltestingapi.MakeLocalQueue("lq-a2", simulationNamespace).ClusterQueue("cq-a").Obj(),
+		utiltestingapi.MakeLocalQueue("lq-b", simulationNamespace).ClusterQueue("cq-b").Obj(),
+	}
+	cpuOnDefault := map[corev1.ResourceName]kueue.ResourceFlavorReference{corev1.ResourceCPU: "default"}
+	cases := map[string]struct {
+		gates    map[featuregate.Feature]bool
+		setup    simulationSetup
+		simulate *kueue.Workload
+		want     visibility.WorkloadSimulationStatus
+	}{
+		"fits in the unused quota": {
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Obj()},
+			},
+			simulate: simulatedWorkload("incoming").Request(corev1.ResourceCPU, "2").Obj(),
+			want: visibility.WorkloadSimulationStatus{
+				ClusterQueue: "cq-a",
+				Mode:         visibility.SimulationFit,
+				PodSets:      []visibility.SimulatedPodSetAssignment{{Name: kueue.DefaultPodSetName, Count: 1, Flavors: cpuOnDefault}},
+			},
+		},
+		"preempts a lower-priority workload in its ClusterQueue": {
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Preemption(lowerPriority).Obj()},
+				workloads:     []*kueue.Workload{admittedWorkload("low", "lq-a", "cq-a", 1, "4", now).Obj()},
+			},
+			simulate: simulatedWorkload("incoming").Priority(10).Request(corev1.ResourceCPU, "2").Obj(),
+			want: visibility.WorkloadSimulationStatus{
+				ClusterQueue: "cq-a",
+				Mode:         visibility.SimulationPreempt,
+				Message:      "couldn't assign flavors to pod set main: insufficient unused quota for cpu in flavor default, 2 more needed",
+				PodSets: []visibility.SimulatedPodSetAssignment{{
+					Name: kueue.DefaultPodSetName, Count: 1, Flavors: cpuOnDefault,
+					Message: "insufficient unused quota for cpu in flavor default, 2 more needed",
+				}},
+				PreemptionTargets: []visibility.SimulatedPreemptionTarget{{
+					Name: "low", Namespace: simulationNamespace, ClusterQueue: "cq-a", LocalQueueName: "lq-a", Priority: 1,
+					Reason: kueue.InClusterQueueReason,
+				}},
+			},
+		},
+		"reclaims quota that another ClusterQueue borrowed": {
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{
+					cpuClusterQueue("cq-a", "4").Cohort("cohort").
+						Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny}).Obj(),
+					cpuClusterQueue("cq-b", "0").Cohort("cohort").Obj(),
+				},
+				workloads: []*kueue.Workload{admittedWorkload("borrower", "lq-b", "cq-b", 100, "4", now).Obj()},
+			},
+			simulate: simulatedWorkload("incoming").Request(corev1.ResourceCPU, "2").Obj(),
+			want: visibility.WorkloadSimulationStatus{
+				ClusterQueue: "cq-a",
+				Mode:         visibility.SimulationPreempt,
+				Message:      "couldn't assign flavors to pod set main: insufficient unused quota for cpu in flavor default, 2 more needed",
+				PodSets: []visibility.SimulatedPodSetAssignment{{
+					Name: kueue.DefaultPodSetName, Count: 1, Flavors: cpuOnDefault,
+					Message: "insufficient unused quota for cpu in flavor default, 2 more needed",
+				}},
+				PreemptionTargets: []visibility.SimulatedPreemptionTarget{{
+					Name: "borrower", Namespace: simulationNamespace, ClusterQueue: "cq-b", LocalQueueName: "lq-b", Priority: 100,
+					Reason: kueue.InCohortReclamationReason,
+				}},
+			},
+		},
+		"preempts a lower-priority borrower while borrowing": {
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{
+					cpuClusterQueue("cq-a", "2").Cohort("cohort").Preemption(kueue.ClusterQueuePreemption{
+						ReclaimWithinCohort: kueue.PreemptionPolicyLowerPriority,
+						BorrowWithinCohort:  &kueue.BorrowWithinCohort{Policy: kueue.BorrowWithinCohortPolicyLowerPriority},
+					}).Obj(),
+					cpuClusterQueue("cq-b", "2").Cohort("cohort").Obj(),
+				},
+				workloads: []*kueue.Workload{admittedWorkload("borrower", "lq-b", "cq-b", 1, "4", now).Obj()},
+			},
+			simulate: simulatedWorkload("incoming").Priority(10).Request(corev1.ResourceCPU, "4").Obj(),
+			want: visibility.WorkloadSimulationStatus{
+				ClusterQueue: "cq-a",
+				Mode:         visibility.SimulationPreempt,
+				Message:      "couldn't assign flavors to pod set main: insufficient unused quota for cpu in flavor default, 4 more needed",
+				Borrowing:    true,
+				PodSets: []visibility.SimulatedPodSetAssignment{{
+					Name: kueue.DefaultPodSetName, Count: 1, Flavors: cpuOnDefault,
+					Message: "insufficient unused quota for cpu in flavor default, 4 more needed",
+				}},
+				PreemptionTargets: []visibility.SimulatedPreemptionTarget{{
+					Name: "borrower", Namespace: simulationNamespace, ClusterQueue: "cq-b", LocalQueueName: "lq-b", Priority: 1,
+					Reason: kueue.InCohortReclaimWhileBorrowingReason,
+				}},
+			},
+		},
+		"preempts by fair sharing": {
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{
+					cpuClusterQueue("cq-a", "2").Cohort("cohort").
+						Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny}).Obj(),
+					cpuClusterQueue("cq-b", "2").Cohort("cohort").Obj(),
+				},
+				workloads: []*kueue.Workload{
+					admittedWorkload("borrower-1", "lq-b", "cq-b", 1, "1", now).Obj(),
+					admittedWorkload("borrower-2", "lq-b", "cq-b", 1, "1", now.Add(time.Second)).Obj(),
+					admittedWorkload("borrower-3", "lq-b", "cq-b", 1, "1", now.Add(2*time.Second)).Obj(),
+					admittedWorkload("borrower-4", "lq-b", "cq-b", 1, "1", now.Add(3*time.Second)).Obj(),
+				},
+				schedulerOpts: []scheduler.Option{scheduler.WithFairSharing(&config.FairSharing{})},
+			},
+			gates:    map[featuregate.Feature]bool{features.FairSharingPreemptWithinNominal: false},
+			simulate: simulatedWorkload("incoming").Request(corev1.ResourceCPU, "1").Obj(),
+			want: visibility.WorkloadSimulationStatus{
+				ClusterQueue: "cq-a",
+				Mode:         visibility.SimulationPreempt,
+				Message:      "couldn't assign flavors to pod set main: insufficient unused quota for cpu in flavor default, 1 more needed",
+				PodSets: []visibility.SimulatedPodSetAssignment{{
+					Name: kueue.DefaultPodSetName, Count: 1, Flavors: cpuOnDefault,
+					Message: "insufficient unused quota for cpu in flavor default, 1 more needed",
+				}},
+				PreemptionTargets: []visibility.SimulatedPreemptionTarget{{
+					Name: "borrower-4", Namespace: simulationNamespace, ClusterQueue: "cq-b", LocalQueueName: "lq-b", Priority: 1,
+					Reason: kueue.InCohortFairSharingReason,
+				}},
+			},
+		},
+		"shrinks an elastic workload instead of evicting it": {
+			gates: map[featuregate.Feature]bool{features.PartialPreemption: true},
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Preemption(lowerPriority).Obj()},
+				workloads: []*kueue.Workload{
+					utiltestingapi.MakeWorkload("elastic", simulationNamespace).Queue("lq-a").Priority(1).
+						Annotation(constants.ReclaimMinCountsAnnotation, "main=1").
+						PodSets(*utiltestingapi.MakePodSet(kueue.DefaultPodSetName, 4).Request(corev1.ResourceCPU, "1").Obj()).
+						ReserveQuotaAt(utiltestingapi.MakeAdmission("cq-a").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+							Count(4).Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), now).
+						AdmittedAt(true, now).Obj(),
+				},
+			},
+			simulate: simulatedWorkload("incoming").Priority(10).Request(corev1.ResourceCPU, "2").Obj(),
+			want: visibility.WorkloadSimulationStatus{
+				ClusterQueue: "cq-a",
+				Mode:         visibility.SimulationPreempt,
+				Message:      "couldn't assign flavors to pod set main: insufficient unused quota for cpu in flavor default, 2 more needed",
+				PodSets: []visibility.SimulatedPodSetAssignment{{
+					Name: kueue.DefaultPodSetName, Count: 1, Flavors: cpuOnDefault,
+					Message: "insufficient unused quota for cpu in flavor default, 2 more needed",
+				}},
+				PreemptionTargets: []visibility.SimulatedPreemptionTarget{{
+					Name: "elastic", Namespace: simulationNamespace, ClusterQueue: "cq-a", LocalQueueName: "lq-a", Priority: 1,
+					Reason:              kueue.InClusterQueueReason,
+					ReclaimTargetCounts: map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 2},
+				}},
+			},
+		},
+		"takes the priority of its WorkloadPriorityClass": {
+			setup: simulationSetup{
+				clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Preemption(lowerPriority).Obj()},
+				workloads:     []*kueue.Workload{admittedWorkload("low", "lq-a", "cq-a", 1, "4", now).Obj()},
+				priorityClass: []*kueue.WorkloadPriorityClass{utiltestingapi.MakeWorkloadPriorityClass("high").PriorityValue(100).Obj()},
+			},
+			// spec.priority alone would rank it below the admitted workload.
+			simulate: simulatedWorkload("incoming").WorkloadPriorityClassRef("high").Priority(0).Request(corev1.ResourceCPU, "2").Obj(),
