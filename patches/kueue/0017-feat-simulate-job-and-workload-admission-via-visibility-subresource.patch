+	utiltestingapi "sigs.k8s.io/kueue/pkg/util/testing/v1beta2"
+)
+
+// TestDroppedWritesSendOnlyDryRuns checks that the client of a WorkloadBuilder's
+// reconciler sends a server-side dry run of a create and drops every other write.
+func TestDroppedWritesSendOnlyDryRuns(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	var sent []string
+	record := func(verb string) error {
+		sent = append(sent, verb)
+		return nil
+	}
+	c := droppedWrites{interceptor.NewClient(utiltesting.NewClientBuilder().Build(), interceptor.Funcs{
+		Create: func(_ context.Context, _ client.WithWatch, _ client.Object, opts ...client.CreateOption) error {
+			return record(fmt.Sprintf("create dryRun=%v", (&client.CreateOptions{}).ApplyOptions(opts).DryRun))
+		},
+		Update: func(context.Context, client.WithWatch, client.Object, ...client.UpdateOption) error {
+			return record("update")
+		},
+		Patch: func(context.Context, client.WithWatch, client.Object, client.Patch, ...client.PatchOption) error {
+			return record("patch")
+		},
+		Delete: func(context.Context, client.WithWatch, client.Object, ...client.DeleteOption) error {
+			return record("delete")
+		},
+		SubResourceUpdate: func(context.Context, client.Client, string, client.Object, ...client.SubResourceUpdateOption) error {
+			return record("update status")
+		},
+		SubResourcePatch: func(context.Context, client.Client, string, client.Object, client.Patch, ...client.SubResourcePatchOption) error {
+			return record("patch status")
+		},
+	})}
+	wl := utiltestingapi.MakeWorkload("wl", "ns").Obj()
+	for _, write := range []func() error{
+		func() error { return c.Create(ctx, wl.DeepCopy()) },
+		func() error { return c.Create(ctx, wl.DeepCopy(), client.DryRunAll) },
+		func() error { return c.Update(ctx, wl.DeepCopy()) },
+		func() error { return c.Patch(ctx, wl.DeepCopy(), client.MergeFrom(wl)) },
+		func() error { return c.Delete(ctx, wl.DeepCopy()) },
+		func() error { return c.Status().Update(ctx, wl.DeepCopy()) },
+		func() error { return c.SubResource("status").Patch(ctx, wl.DeepCopy(), client.MergeFrom(wl)) },
+	} {
+		if err := write(); err != nil {
+			t.Fatalf("A write returned %v, want nil", err)
+		}
+	}
+	if diff := cmp.Diff([]string{"create dryRun=[All]"}, sent); diff != "" {
+		t.Errorf("Unexpected writes sent (-want,+got):\n%s", diff)
+	}
+}
