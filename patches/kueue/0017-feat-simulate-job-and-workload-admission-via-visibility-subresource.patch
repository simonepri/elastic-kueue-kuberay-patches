+
+// jobSimulation is the part of a simulation's status that depends on the
+// Workload that Kueue builds from spec.job.
+type jobSimulation struct {
+	Mode           visibility.SimulationMode
+	PodSets        map[kueue.PodSetReference]int32
+	Targets        []string
+	Position       int32
+	WorkloadsAhead []string
+}
+
+func jobSimulationOf(status visibility.WorkloadSimulationStatus) jobSimulation {
+	got := jobSimulation{Mode: status.Mode, Position: status.PositionInClusterQueue, PodSets: make(map[kueue.PodSetReference]int32)}
+	for _, ps := range status.PodSets {
+		got.PodSets[ps.Name] = ps.Count
+	}
+	for _, target := range status.PreemptionTargets {
+		got.Targets = append(got.Targets, target.Name)
+	}
+	for _, ahead := range status.WorkloadsAhead {
+		got.WorkloadsAhead = append(got.WorkloadsAhead, ahead.Name)
+	}
+	return got
+}
+
+// trainJob is a batch/v1 Job as the API server stores it, without a namespace,
+// which the request supplies.
+func trainJob() *testingjob.JobWrapper {
+	return testingjob.MakeJob("train", "").SetTypeMeta().UID("train-uid").Queue("lq-a").Request(corev1.ResourceCPU, "1")
+}
+
+// trainWorkload is the Workload that Kueue's job reconciler creates for the Job
+// train, with the given name and creation time.
+func trainWorkload(t *testing.T, name string, created time.Time) *utiltestingapi.WorkloadWrapper {
+	t.Helper()
+	ctx, _ := utiltesting.ContextWithLog(t)
+	env := newSimulationEnv(t, created, simulationSetup{})
+	wl, _, err := env.rest.jobs.Build(ctx, rawExtension(t, trainJob().Obj()).Raw, simulationNamespace)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wl.Name = name
+	wl.CreationTimestamp = metav1.NewTime(created)
+	return &utiltestingapi.WorkloadWrapper{Workload: *wl}
+}
+
+func TestSimulateInLQJob(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	lowerPriority := kueue.ClusterQueuePreemption{WithinClusterQueue: kueue.PreemptionPolicyLowerPriority}
+	baseSetup := simulationSetup{
+		clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Preemption(lowerPriority).Obj()},
+		localQueues:   []*kueue.LocalQueue{utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj()},
+		priorityClass: []*kueue.WorkloadPriorityClass{utiltestingapi.MakeWorkloadPriorityClass("low").PriorityValue(-10).Obj()},
+		objects:       []client.Object{utiltesting.MakePriorityClass("pods-high").PriorityValue(200).Obj()},
+	}
+	// A ClusterQueue that is full with a workload that a pending one cannot
+	// preempt, so that pending workloads stay pending.
+	full := admittedWorkload("full", "lq-a", "cq-a", 500, "4", now).Obj()
+	cases := map[string]struct {
+		workloads func(t *testing.T) []*kueue.Workload
+		job       runtime.Object
+		want      jobSimulation
+	}{
+		"a batch/v1 Job that fits": {
+			job: trainJob().Parallelism(3).Completions(6).Obj(),
+			want: jobSimulation{
+				Mode:    visibility.SimulationFit,
+				PodSets: map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 3},
+			},
+		},
+		"a kubeflow.org/v1 PyTorchJob with a PriorityClass that preempts a lower-priority workload": {
+			workloads: func(*testing.T) []*kueue.Workload {
+				return []*kueue.Workload{admittedWorkload("low", "lq-a", "cq-a", 1, "4", now).Obj()}
+			},
+			job: testingpytorchjob.MakePyTorchJob("train", "").SetTypeMeta().Queue("lq-a").
+				PyTorchReplicaSpecs(
+					testingpytorchjob.PyTorchReplicaSpecRequirement{ReplicaType: kftraining.PyTorchJobReplicaTypeMaster, ReplicaCount: 1},
+					testingpytorchjob.PyTorchReplicaSpecRequirement{ReplicaType: kftraining.PyTorchJobReplicaTypeWorker, ReplicaCount: 2},
+				).
+				PriorityClass("pods-high").
+				Request(kftraining.PyTorchJobReplicaTypeMaster, corev1.ResourceCPU, "1").
+				Request(kftraining.PyTorchJobReplicaTypeWorker, corev1.ResourceCPU, "1").Obj(),
+			want: jobSimulation{
+				Mode:    visibility.SimulationPreempt,
+				PodSets: map[kueue.PodSetReference]int32{"master": 1, "worker": 2},
+				Targets: []string{"low"},
+			},
+		},
+		"a new job is queued behind the pending workloads": {
+			workloads: func(*testing.T) []*kueue.Workload {
+				return []*kueue.Workload{
+					full,
+					utiltestingapi.MakeWorkload("older", simulationNamespace).Queue("lq-a").Request(corev1.ResourceCPU, "1").Creation(now.Add(-time.Hour)).Obj(),
+				}
+			},
+			job: trainJob().Obj(),
+			want: jobSimulation{
+				Mode:           visibility.SimulationNoFit,
+				PodSets:        map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 1},
+				Position:       1,
+				WorkloadsAhead: []string{"older"},
+			},
+		},
+		"a pending job whose pod count changes keeps the place of its Workload": {
+			workloads: func(t *testing.T) []*kueue.Workload {
+				return []*kueue.Workload{
+					full,
+					trainWorkload(t, "train-pending", now.Add(-time.Hour)).Obj(),
+					utiltestingapi.MakeWorkload("newer", simulationNamespace).Queue("lq-a").Request(corev1.ResourceCPU, "1").Creation(now.Add(-time.Minute)).Obj(),
+				}
+			},
+			job: trainJob().Parallelism(2).Obj(),
+			want: jobSimulation{
+				Mode:    visibility.SimulationNoFit,
+				PodSets: map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 2},
+			},
+		},
+		"a pending job whose priority drops goes behind the workloads it no longer outranks": {
+			workloads: func(t *testing.T) []*kueue.Workload {
+				return []*kueue.Workload{
+					full,
+					trainWorkload(t, "train-pending", now.Add(-time.Hour)).Obj(),
+					utiltestingapi.MakeWorkload("newer", simulationNamespace).Queue("lq-a").Request(corev1.ResourceCPU, "1").Creation(now.Add(-time.Minute)).Obj(),
+				}
+			},
+			job: trainJob().WorkloadPriorityClass("low").Obj(),
+			want: jobSimulation{
+				Mode:           visibility.SimulationNoFit,
+				PodSets:        map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 1},
+				Position:       1,
+				WorkloadsAhead: []string{"newer"},
+			},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			setup := baseSetup
+			if tc.workloads != nil {
+				setup.workloads = tc.workloads(t)
+			}
+			env := newSimulationEnv(t, now, setup)
+			got, err := env.simulateJob(ctx, t, "lq-a", tc.job)
+			if err != nil {
+				t.Fatalf("Simulating the job: %v", err)
+			}
+			if diff := cmp.Diff(tc.want, jobSimulationOf(got.Status)); diff != "" {
+				t.Errorf("Unexpected simulation (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestSimulateInLQJobRejects(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	setup := simulationSetup{
+		clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Obj()},
+		localQueues: []*kueue.LocalQueue{
+			utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj(),
+			utiltestingapi.MakeLocalQueue("lq-b", simulationNamespace).ClusterQueue("cq-a").Obj(),
+		},
+		workloads: []*kueue.Workload{
+			trainWorkload(t, "running", now).
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq-a").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+					Assignment(corev1.ResourceCPU, "default", "1").Obj()).Obj(), now).
+				AdmittedAt(true, now).Obj(),
+		},
+	}
+	otherJob := func() *testingjob.JobWrapper {
+		return testingjob.MakeJob("other", "").SetTypeMeta().Queue("lq-a").Request(corev1.ResourceCPU, "1")
+	}
+	cases := map[string]struct {
+		spec    func(t *testing.T) visibility.WorkloadSimulationSpec
+		wantErr func(error) bool
+	}{
+		"both a job and a workload": {
+			spec: func(t *testing.T) visibility.WorkloadSimulationSpec {
+				return visibility.WorkloadSimulationSpec{
+					Job:      rawExtension(t, otherJob().Obj()),
+					Workload: rawExtension(t, simulatedWorkload("incoming").Obj()),
+				}
+			},
+			wantErr: apierrors.IsInvalid,
+		},
+		"a job queued in another LocalQueue": {
+			spec: func(t *testing.T) visibility.WorkloadSimulationSpec {
+				return visibility.WorkloadSimulationSpec{Job: rawExtension(t, otherJob().Queue("lq-b").Obj())}
+			},
+			wantErr: apierrors.IsBadRequest,
+		},
+		"a job without a queue name": {
+			spec: func(t *testing.T) visibility.WorkloadSimulationSpec {
+				j := otherJob().Obj()
+				delete(j.Labels, "kueue.x-k8s.io/queue-name")
+				return visibility.WorkloadSimulationSpec{Job: rawExtension(t, j)}
+			},
+			wantErr: apierrors.IsBadRequest,
+		},
+		"the job of a Workload that holds quota": {
+			spec: func(t *testing.T) visibility.WorkloadSimulationSpec {
+				return visibility.WorkloadSimulationSpec{Job: rawExtension(t, trainJob().Obj())}
+			},
+			wantErr: apierrors.IsBadRequest,
+		},
+		"a kind of no enabled integration": {
+			spec: func(t *testing.T) visibility.WorkloadSimulationSpec {
+				return visibility.WorkloadSimulationSpec{Job: &runtime.RawExtension{Raw: []byte(`{"apiVersion": "kubeflow.org/v1", "kind": "TFJob", "metadata": {"name": "train"}}`)}}
+			},
+			wantErr: apierrors.IsBadRequest,
+		},
+		"a job without the defaults of the API server": {
+			spec: func(t *testing.T) visibility.WorkloadSimulationSpec {
+				j := otherJob().Obj()
+				j.Spec.Parallelism = nil
+				return visibility.WorkloadSimulationSpec{Job: rawExtension(t, j)}
+			},
+			wantErr: apierrors.IsBadRequest,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			env := newSimulationEnv(t, now, setup)
+			_, err := env.create(ctx, "lq-a", tc.spec(t))
+			if !tc.wantErr(err) {
+				t.Errorf("Unexpected error: %v", err)
+			}
+		})
+	}
+}
+
+// TestSimulateInLQStoredJob checks that a job with a Workload is simulated as
+// that Workload as the API server stores it: with its creation time and the
+// status from which the queue orders it.
+func TestSimulateInLQStoredJob(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	// Each ClusterQueue is full with a workload that a pending one cannot
+	// preempt, so that pending workloads stay pending.
+	setup := simulationSetup{
+		clusterQueues: []*kueue.ClusterQueue{cpuClusterQueue("cq-a", "4").Obj(), cpuClusterQueue("cq-b", "4").Obj()},
+		localQueues: []*kueue.LocalQueue{
+			utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj(),
+			utiltestingapi.MakeLocalQueue("lq-b", simulationNamespace).ClusterQueue("cq-b").Obj(),
+		},
+	}
+	pending := func(name, lq string, created time.Time) *kueue.Workload {
+		return utiltestingapi.MakeWorkload(name, simulationNamespace).Queue(kueue.LocalQueueName(lq)).Request(corev1.ResourceCPU, "1").Creation(created).Obj()
+	}
+	cases := map[string]struct {
+		workloads  func(t *testing.T) []*kueue.Workload
+		localQueue string
+		job        runtime.Object
+		want       jobSimulation
+	}{
+		"a waiting job that moves to another ClusterQueue keeps its creation time": {
+			workloads: func(t *testing.T) []*kueue.Workload {
+				return []*kueue.Workload{
+					admittedWorkload("full-b", "lq-b", "cq-b", 500, "4", now).Obj(),
+					trainWorkload(t, "train-pending", now.Add(-time.Hour)).Obj(),
+					pending("other", "lq-b", now.Add(-30*time.Minute)),
+				}
+			},
+			localQueue: "lq-b",
+			job:        trainJob().Queue("lq-b").Obj(),
+			want: jobSimulation{
+				Mode:    visibility.SimulationNoFit,
+				PodSets: map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 1},
+			},
+		},
+		"a waiting job that an admission check evicted is ordered by its eviction": {
+			workloads: func(t *testing.T) []*kueue.Workload {
+				return []*kueue.Workload{
+					admittedWorkload("full-a", "lq-a", "cq-a", 500, "4", now).Obj(),
+					trainWorkload(t, "train-pending", now.Add(-2*time.Hour)).
+						Condition(metav1.Condition{
+							Type: kueue.WorkloadEvicted, Status: metav1.ConditionTrue, Reason: kueue.WorkloadEvictedByAdmissionCheck,
+							Message: "evicted", LastTransitionTime: metav1.NewTime(now.Add(-10 * time.Minute)),
+						}).Obj(),
+					pending("newer", "lq-a", now.Add(-time.Hour)),
+				}
+			},
+			localQueue: "lq-a",
+			job:        trainJob().Obj(),
+			want: jobSimulation{
+				Mode:           visibility.SimulationNoFit,
+				PodSets:        map[kueue.PodSetReference]int32{kueue.DefaultPodSetName: 1},
+				Position:       1,
+				WorkloadsAhead: []string{"newer"},
+			},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			setup := setup
+			setup.workloads = tc.workloads(t)
+			env := newSimulationEnv(t, now, setup)
+			got, err := env.simulateJob(ctx, t, tc.localQueue, tc.job)
+			if err != nil {
+				t.Fatalf("Simulating the job: %v", err)
+			}
+			if diff := cmp.Diff(tc.want, jobSimulationOf(got.Status)); diff != "" {
+				t.Errorf("Unexpected simulation (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
