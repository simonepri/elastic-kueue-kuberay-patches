+	"k8s.io/apimachinery/pkg/util/validation/field"
+	"k8s.io/apiserver/pkg/authorization/authorizer"
+	genericapirequest "k8s.io/apiserver/pkg/endpoints/request"
+	"k8s.io/apiserver/pkg/registry/rest"
+	"k8s.io/apiserver/pkg/storage/names"
+
+	kueue "sigs.k8s.io/kueue/apis/kueue/v1beta2"
+	visibility "sigs.k8s.io/kueue/apis/visibility/v1beta2"
+	qcache "sigs.k8s.io/kueue/pkg/cache/queue"
+	"sigs.k8s.io/kueue/pkg/constants"
+	"sigs.k8s.io/kueue/pkg/controller/jobframework"
+	"sigs.k8s.io/kueue/pkg/scheduler"
+	"sigs.k8s.io/kueue/pkg/scheduler/flavorassigner"
+	"sigs.k8s.io/kueue/pkg/scheduler/preemption"
+	"sigs.k8s.io/kueue/pkg/util/priority"
+	utilqueue "sigs.k8s.io/kueue/pkg/util/queue"
+	utiltas "sigs.k8s.io/kueue/pkg/util/tas"
+	"sigs.k8s.io/kueue/pkg/webhooks"
+	"sigs.k8s.io/kueue/pkg/workload"
+)
+
+var (
+	workloadScheme = runtime.NewScheme()
+	// workloadDecoder decodes spec.workload strictly, so a misspelled field is an
+	// error rather than a field the simulation silently ignores.
+	workloadDecoder = serializer.NewCodecFactory(workloadScheme, serializer.EnableStrict).UniversalDeserializer()
+	workloadGVK     = kueue.SchemeGroupVersion.WithKind("Workload")
+	simulationGK    = visibility.SchemeGroupVersion.WithKind("WorkloadSimulation").GroupKind()
+)
+
+func init() {
+	utilruntime.Must(kueue.AddToScheme(workloadScheme))
+}
+
+// simulateInLqREST serves the localqueues/simulate subresource: a create that
+// evaluates the job or the Workload in its body against the scheduler and stores
+// nothing.
+type simulateInLqREST struct {
+	queueMgr  *qcache.Manager
+	simulator *scheduler.Simulator
+	// jobs builds the Workload of spec.job as the job reconcilers do.
+	jobs *jobframework.WorkloadBuilder
+	// authorizer decides which namespaces the caller may see Workloads in; nil
+	// when the server authorizes nothing.
+	authorizer authorizer.UnconditionalAuthorizer
+}
+
+var _ rest.Storage = &simulateInLqREST{}
+var _ rest.NamedCreater = &simulateInLqREST{}
+var _ rest.Scoper = &simulateInLqREST{}
+
+func NewSimulateInLqREST(queueMgr *qcache.Manager, simulator *scheduler.Simulator, jobs *jobframework.WorkloadBuilder, authz authorizer.UnconditionalAuthorizer) *simulateInLqREST {
+	return &simulateInLqREST{queueMgr: queueMgr, simulator: simulator, jobs: jobs, authorizer: authz}
+}
+
+// New implements rest.Storage interface
+func (m *simulateInLqREST) New() runtime.Object {
+	return &visibility.WorkloadSimulation{}
+}
+
+// Destroy implements rest.Storage interface
+func (m *simulateInLqREST) Destroy() {}
+
+// NamespaceScoped implements rest.Scoper interface
+func (m *simulateInLqREST) NamespaceScoped() bool {
+	return true
+}
+
+// Create implements rest.NamedCreater interface. It simulates spec.job or
+// spec.workload in the LocalQueue name and returns the request with its status
+// set.
+func (m *simulateInLqREST) Create(ctx context.Context, name string, obj runtime.Object, createValidation rest.ValidateObjectFunc, _ *metav1.CreateOptions) (runtime.Object, error) {
+	simulation, ok := obj.(*visibility.WorkloadSimulation)
+	if !ok {
+		return nil, apierrors.NewBadRequest(fmt.Sprintf("not a WorkloadSimulation: %T", obj))
+	}
+	if createValidation != nil {
+		if err := createValidation(ctx, simulation.DeepCopyObject()); err != nil {
+			return nil, err
+		}
+	}
+	// Building the Workload of a job reads the controller manager's cache, which
+	// starts after the visibility server and has synced once the scheduler cache
+	// has.
+	if !m.simulator.Synced() {
+		return nil, apierrors.NewServiceUnavailable(scheduler.ErrSimulatorNotSynced.Error())
+	}
+	wl, stored, err := m.workloadToSimulate(ctx, simulation, genericapirequest.NamespaceValue(ctx), kueue.LocalQueueName(name))
+	if err != nil {
+		return nil, err
+	}
+	simulate := m.simulator.Simulate
+	if stored {
+		simulate = m.simulator.SimulateStored
+	}
+	result, err := simulate(ctx, wl)
+	switch {
+	case errors.Is(err, qcache.ErrLocalQueueDoesNotExistOrInactive):
+		return nil, apierrors.NewNotFound(visibility.Resource("localqueue"), name)
+	case errors.Is(err, scheduler.ErrNotSimulatable):
+		return nil, apierrors.NewBadRequest(err.Error())
+	case errors.Is(err, scheduler.ErrSimulatorNotSynced):
+		return nil, apierrors.NewServiceUnavailable(err.Error())
+	case errors.Is(err, scheduler.ErrSimulatorBusy):
+		return nil, apierrors.NewTooManyRequests(err.Error(), 1)
+	case err != nil:
+		return nil, apierrors.NewInternalError(err)
+	}
+	// The request's managed fields describe a write that a simulation never makes.
+	simulation.ManagedFields = nil
+	simulation.Status = simulationStatus(result, m.queueMgr.PendingWorkloadsAhead(result.Info.ClusterQueue, result.Info))
+	m.redactUnreadable(ctx, &simulation.Status)
+	return simulation, nil
+}
+
+// redactUnreadable removes the name, namespace and LocalQueue of each preemption
+// target and pending workload in a namespace where the caller may not get
+// Workloads. A grant of localqueues/simulate in one namespace then shows no more
+// of other namespaces than their priorities, ClusterQueues and counts.
+func (m *simulateInLqREST) redactUnreadable(ctx context.Context, status *visibility.WorkloadSimulationStatus) {
+	if m.authorizer == nil {
+		return
+	}
+	caller, _ := genericapirequest.UserFrom(ctx)
+	readable := map[string]bool{}
+	mayRead := func(namespace string) bool {
+		if allowed, found := readable[namespace]; found {
+			return allowed
+		}
+		decision, _, err := m.authorizer.Authorize(ctx, authorizer.AttributesRecord{
+			User:            caller,
+			Verb:            "get",
+			Namespace:       namespace,
+			APIGroup:        kueue.SchemeGroupVersion.Group,
+			APIVersion:      kueue.SchemeGroupVersion.Version,
+			Resource:        "workloads",
+			ResourceRequest: true,
+		})
+		readable[namespace] = caller != nil && err == nil && decision == authorizer.DecisionAllow
+		return readable[namespace]
+	}
+	for i := range status.PreemptionTargets {
+		if target := &status.PreemptionTargets[i]; !mayRead(target.Namespace) {
+			target.Name, target.Namespace, target.LocalQueueName = "", "", ""
+		}
+	}
+	for i := range status.WorkloadsAhead {
+		if ahead := &status.WorkloadsAhead[i]; !mayRead(ahead.Namespace) {
+			ahead.ObjectMeta = metav1.ObjectMeta{CreationTimestamp: ahead.CreationTimestamp}
+			ahead.LocalQueueName = ""
+		}
+	}
+}
+
+// workloadToSimulate returns the Workload to simulate in namespace and queueName
+// for the spec of simulation, which sets exactly one of job and workload, and
+// whether it is the stored Workload of a job that exists. To the Workload, in
+// the order of the kube-apiserver, it applies the defaults of Kueue's Workload
+// webhook, the CRD rules of validateCRDRules, and the validation of the
+// webhook, as it does to a Workload that a job reconciler or a user writes. Only
+// the kube-apiserver applies the rest of the CRD.
+func (m *simulateInLqREST) workloadToSimulate(ctx context.Context, simulation *visibility.WorkloadSimulation, namespace string, queueName kueue.LocalQueueName) (*kueue.Workload, bool, error) {
+	var wl *kueue.Workload
+	var stored bool
+	var err error
+	specPath := field.NewPath("spec")
+	switch job, workload := rawBytes(simulation.Spec.Job), rawBytes(simulation.Spec.Workload); {
+	case len(job) > 0 && len(workload) > 0:
+		return nil, false, apierrors.NewInvalid(simulationGK, simulation.Name, field.ErrorList{field.Forbidden(specPath.Child("workload"), "must not be set together with spec.job")})
+	case len(job) > 0:
+		wl, stored, err = m.jobWorkload(ctx, job, namespace, queueName)
+	case len(workload) > 0:
+		wl, err = decodeWorkload(workload, namespace, queueName)
+	default:
+		return nil, false, apierrors.NewInvalid(simulationGK, simulation.Name, field.ErrorList{field.Required(specPath, "exactly one of job and workload must be set")})
+	}
+	if err != nil {
+		return nil, false, err
+	}
+	// The kube-apiserver runs the mutating webhook before it validates the CRD.
+	if err := (&webhooks.WorkloadWebhook{}).Default(ctx, wl); err != nil {
+		return nil, false, apierrors.NewInternalError(err)
+	}
+	if errs := validateCRDRules(wl); len(errs) > 0 {
+		return nil, false, apierrors.NewInvalid(workloadGVK.GroupKind(), wl.Name, errs)
+	}
+	if errs := webhooks.ValidateWorkload(wl, nil); len(errs) > 0 {
+		return nil, false, apierrors.NewInvalid(workloadGVK.GroupKind(), wl.Name, errs)
+	}
+	return wl, stored, nil
+}
+
+func rawBytes(raw *runtime.RawExtension) []byte {
+	if raw == nil {
+		return nil
+	}
+	return raw.Raw
+}
+
+// jobWorkload returns the Workload that Kueue's job reconciler would have for
+// the job in raw, which must be queued in queueName, and whether it is the
+// stored Workload of a job that exists.
+func (m *simulateInLqREST) jobWorkload(ctx context.Context, raw []byte, namespace string, queueName kueue.LocalQueueName) (*kueue.Workload, bool, error) {
+	// Building reads the cluster, so a LocalQueue that does not exist answers
+	// first, as it does for spec.workload.
+	if _, found := m.queueMgr.ClusterQueueFromLocalQueue(utilqueue.NewLocalQueueReference(namespace, queueName)); !found {
+		return nil, false, apierrors.NewNotFound(visibility.Resource("localqueue"), string(queueName))
+	}
+	wl, stored, err := m.jobs.Build(ctx, raw, namespace)
+	var status apierrors.APIStatus
+	switch {
+	case errors.Is(err, jobframework.ErrJobNotSimulatable):
+		return nil, false, apierrors.NewBadRequest(fmt.Sprintf("spec.job: %v", err))
+	case errors.As(err, &status):
+		return nil, false, err
+	case err != nil:
+		return nil, false, apierrors.NewInternalError(err)
+	}
+	switch {
+	case wl.Spec.QueueName == queueName:
+		return wl, stored, nil
+	case stored:
+		return nil, false, apierrors.NewBadRequest(fmt.Sprintf("Kueue keeps the Workload of spec.job in LocalQueue %q, not in the request's LocalQueue %q", wl.Spec.QueueName, queueName))
+	default:
+		return nil, false, apierrors.NewBadRequest(fmt.Sprintf("the queue-name label of spec.job is %q, not the request's LocalQueue %q", wl.Spec.QueueName, queueName))
+	}
+}
+
+// decodeWorkload decodes raw into the Workload to simulate in namespace and
+// queueName, with the CRD's defaults of a PodSet's name and count.
+func decodeWorkload(raw []byte, namespace string, queueName kueue.LocalQueueName) (*kueue.Workload, error) {
+	obj, gvk, err := workloadDecoder.Decode(raw, &workloadGVK, nil)
+	if err != nil {
+		return nil, apierrors.NewBadRequest(fmt.Sprintf("spec.workload: %v", err))
+	}
+	// A decoded PodSet has the zero value for a field the request leaves out,
+	// so the raw fields tell which ones the CRD would default.
+	var given struct {
+		Spec struct {
+			PodSets []map[string]json.RawMessage `json:"podSets"`
+		} `json:"spec"`
+	}
+	if err := json.Unmarshal(raw, &given); err != nil {
+		return nil, apierrors.NewBadRequest(fmt.Sprintf("spec.workload must be JSON: %v", err))
+	}
+	wl, ok := obj.(*kueue.Workload)
+	if !ok {
+		return nil, apierrors.NewBadRequest(fmt.Sprintf("spec.workload is a %s, not a %s", gvk, workloadGVK))
+	}
+	if wl.Namespace == "" {
+		wl.Namespace = namespace
+	} else if wl.Namespace != namespace {
+		return nil, apierrors.NewBadRequest(fmt.Sprintf("spec.workload.metadata.namespace %q does not match the request's namespace %q", wl.Namespace, namespace))
+	}
+	if wl.Spec.QueueName == "" {
+		wl.Spec.QueueName = queueName
+	} else if wl.Spec.QueueName != queueName {
+		return nil, apierrors.NewBadRequest(fmt.Sprintf("spec.workload.spec.queueName %q does not match the request's LocalQueue %q", wl.Spec.QueueName, queueName))
+	}
+	if wl.Name == "" {
+		wl.Name = names.SimpleNameGenerator.GenerateName(cmp.Or(wl.GenerateName, "simulation-"))
+	}
+	wl.Status = kueue.WorkloadStatus{}
+	for i, fields := range given.Spec.PodSets {
+		if !isSet(fields, "name") {
+			wl.Spec.PodSets[i].Name = kueue.DefaultPodSetName
+		}
+		if !isSet(fields, "count") {
+			wl.Spec.PodSets[i].Count = 1
+		}
+	}
+	return wl, nil
+}
+
+// isSet reports whether fields sets the field name, which a JSON null does not.
+func isSet(fields map[string]json.RawMessage, name string) bool {
+	value, found := fields[name]
+	return found && string(value) != "null"
+}
+
+// maxPreemptionGates is the CRD's maxItems for spec.preemptionGates.
+const maxPreemptionGates = 8
+
+// validateCRDRules checks the rules of the Workload CRD for the fields that the
+// scheduler reads, which only the kube-apiserver would otherwise apply: the
+// number of PodSets, their names, counts and minimum counts, the preemption
+// gates, and the priority with its class reference. It also requires the reference to name a
+// WorkloadPriorityClass or a PriorityClass in the group of that kind, since the
+// simulation reads the class by its kind.
+func validateCRDRules(wl *kueue.Workload) field.ErrorList {
+	var errs field.ErrorList
+	specPath := field.NewPath("spec")
+	podSetsPath := specPath.Child("podSets")
+	if n := len(wl.Spec.PodSets); n < 1 || n > jobframework.MaxPodSets {
+		errs = append(errs, field.Invalid(podSetsPath, n, fmt.Sprintf("must have between 1 and %d PodSets", jobframework.MaxPodSets)))
+	}
+	names := sets.New[kueue.PodSetReference]()
+	for i, ps := range wl.Spec.PodSets {
+		path := podSetsPath.Index(i)
+		for _, msg := range validation.IsDNS1123Label(string(ps.Name)) {
+			errs = append(errs, field.Invalid(path.Child("name"), ps.Name, msg))
+		}
+		if names.Has(ps.Name) {
+			errs = append(errs, field.Duplicate(path.Child("name"), ps.Name))
+		}
+		names.Insert(ps.Name)
+		if ps.Count < 0 {
+			errs = append(errs, field.Invalid(path.Child("count"), ps.Count, "must be greater than or equal to 0"))
+		}
+		if ps.MinCount != nil && (*ps.MinCount < 0 || *ps.MinCount > ps.Count) {
+			errs = append(errs, field.Invalid(path.Child("minCount"), *ps.MinCount, "must be between 0 and count"))
+		}
+	}
+	gatesPath := specPath.Child("preemptionGates")
+	if n := len(wl.Spec.PreemptionGates); n > maxPreemptionGates {
+		errs = append(errs, field.TooMany(gatesPath, n, maxPreemptionGates))
+	}
+	gates := sets.New[string]()
+	for i, gate := range wl.Spec.PreemptionGates {
+		if gates.Has(gate.Name) {
+			errs = append(errs, field.Duplicate(gatesPath.Index(i).Child("name"), gate.Name))
+		}
+		gates.Insert(gate.Name)
+	}
+	ref := wl.Spec.PriorityClassRef
+	if ref == nil {
+		return errs
+	}
+	refPath := specPath.Child("priorityClassRef")
+	if wl.Spec.Priority == nil {
+		errs = append(errs, field.Required(specPath.Child("priority"), "priority should not be nil when priorityClassRef is set"))
+	}
+	if (ref.Group != kueue.WorkloadPriorityClassGroup || ref.Kind != kueue.WorkloadPriorityClassKind) &&
+		(ref.Group != kueue.PodPriorityClassGroup || ref.Kind != kueue.PodPriorityClassKind) {
+		errs = append(errs, field.Invalid(refPath, ref, "must be a kueue.x-k8s.io WorkloadPriorityClass or a scheduling.k8s.io PriorityClass"))
+	}
+	for _, msg := range validation.IsDNS1123Subdomain(ref.Name) {
+		errs = append(errs, field.Invalid(refPath.Child("name"), ref.Name, msg))
+	}
+	return errs
+}
+
+// simulationStatus converts the scheduler's answer and the pending workloads
+// ahead of the simulated Workload into the API's terms.
+func simulationStatus(result *scheduler.Simulation, ahead []*workload.Info) visibility.WorkloadSimulationStatus {
+	status := visibility.WorkloadSimulationStatus{
+		ClusterQueue:           result.Info.ClusterQueue,
+		Mode:                   visibility.SimulationMode(result.Mode.String()),
+		Reason:                 result.Reason,
+		Message:                result.Message,
+		Borrowing:              result.Mode != flavorassigner.NoFit && result.Assignment.Borrowing > 0,
+		PositionInClusterQueue: int32(len(ahead)),
+	}
+	for i := range result.Assignment.PodSets {
+		status.PodSets = append(status.PodSets, simulatedPodSet(&result.Assignment.PodSets[i], result.Mode))
+	}
+	for _, target := range result.Targets {
+		status.PreemptionTargets = append(status.PreemptionTargets, simulatedTarget(target))
+	}
+	localQueuePositions := make(map[utilqueue.LocalQueueReference]int32)
+	for i, wlInfo := range ahead {
+		queueKey := utilqueue.KeyFromWorkload(wlInfo.Obj)
+		if i < constants.DefaultPendingWorkloadsLimit {
+			status.WorkloadsAhead = append(status.WorkloadsAhead, *newPendingWorkload(wlInfo, localQueuePositions[queueKey], i))
+		}
+		localQueuePositions[queueKey]++
+	}
+	status.PositionInLocalQueue = localQueuePositions[utilqueue.KeyFromWorkload(result.Info.Obj)]
+	return status
+}
+
+func simulatedPodSet(ps *flavorassigner.PodSetAssignment, mode flavorassigner.FlavorAssignmentMode) visibility.SimulatedPodSetAssignment {
+	simulated := visibility.SimulatedPodSetAssignment{Name: ps.Name, Count: ps.Count, Message: ps.Status.Message()}
+	// A NoFit assignment carries the flavors it tried, and a TAS placement made on
+	// an empty cluster to reserve capacity, neither of which the Workload would get.
+	if mode == flavorassigner.NoFit {
+		return simulated
+	}
+	for resource, flavor := range ps.Flavors {
+		if simulated.Flavors == nil {
+			simulated.Flavors = make(map[corev1.ResourceName]kueue.ResourceFlavorReference, len(ps.Flavors))
+		}
+		simulated.Flavors[resource] = flavor.Name
+	}
+	simulated.TopologyAssignment = simulatedTopology(ps.TopologyAssignment)
+	return simulated
+}
+
+func simulatedTopology(ta *utiltas.TopologyAssignment) *visibility.SimulatedTopologyAssignment {
+	if ta == nil {
+		return nil
+	}
+	simulated := &visibility.SimulatedTopologyAssignment{Levels: ta.Levels}
+	for _, domain := range ta.Domains {
+		simulated.Domains = append(simulated.Domains, visibility.SimulatedTopologyDomain{Values: domain.Values, Count: domain.Count})
+	}
+	return simulated
+}
+
+func simulatedTarget(target *preemption.Target) visibility.SimulatedPreemptionTarget {
+	wl := target.WorkloadInfo.Obj
+	simulated := visibility.SimulatedPreemptionTarget{
+		Name:           wl.Name,
+		Namespace:      wl.Namespace,
+		ClusterQueue:   target.WorkloadInfo.ClusterQueue,
+		LocalQueueName: wl.Spec.QueueName,
+		Priority:       priority.Priority(wl),
+		Reason:         target.Reason,
+	}
+	if target.Remaining == nil {
+		return simulated
+	}
+	// The PodSets that keep fewer pods than the victim is charged for, as partial
+	// preemption writes them to the reclaim target, which it never raises.
+	granted := workload.ExtractGrantedPodSetCountsAfterReclaim(wl)
+	existing := workload.ReclaimTargetCounts(wl)
+	kept := make(map[kueue.PodSetReference]int32)
+	for _, ps := range target.Remaining.TotalRequests {
+		if count, found := granted[ps.Name]; found && ps.Count < count {
+			kept[ps.Name] = ps.Count
+			if set, found := existing[ps.Name]; found {
+				kept[ps.Name] = min(set, ps.Count)
+			}
+		}
+	}
+	if len(kept) > 0 {
+		simulated.ReclaimTargetCounts = kept
+	}
+	return simulated
+}
