+)
+
+// InitialSyncDone reports, without waiting, whether every source passed to
+// TrackInitialSync has synced, which WaitForInitialSync waits for.
+func (c *Cache) InitialSyncDone() bool {
+	for _, ready := range c.initialSync {
+		select {
+		case <-ready:
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// ClusterQueueHolding returns the ClusterQueue in which the workload with key
+// holds quota, active or not, and whether there is one.
+func (c *Cache) ClusterQueueHolding(key workload.Reference) (kueue.ClusterQueueReference, bool) {
+	c.RLock()
+	defer c.RUnlock()
+	for name, cq := range c.hm.ClusterQueues() {
+		if _, found := cq.Workloads[key]; found {
+			return name, true
+		}
+	}
+	return "", false
+}
