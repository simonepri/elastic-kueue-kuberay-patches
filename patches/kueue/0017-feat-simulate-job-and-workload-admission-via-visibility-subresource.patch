+func TestSimulateInLQRejects(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	setup := simulationSetup{
+		clusterQueues: []*kueue.ClusterQueue{
+			cpuClusterQueue("cq-a", "4").Obj(),
+			cpuClusterQueue("cq-variants", "4").ConcurrentAdmissionPolicy(kueue.ConcurrentAdmissionTryPreferredFlavors).Obj(),
+		},
+		localQueues: []*kueue.LocalQueue{
+			utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj(),
+			utiltestingapi.MakeLocalQueue("lq-variants", simulationNamespace).ClusterQueue("cq-variants").Obj(),
+		},
+		workloads: []*kueue.Workload{admittedWorkload("running", "lq-a", "cq-a", 1, "1", now).Obj()},
+	}
+	cases := map[string]struct {
+		localQueue string
+		simulate   any
+		wantErr    func(error) bool
+	}{
+		"an unknown LocalQueue": {
+			localQueue: "missing",
+			simulate:   simulatedWorkload("incoming").Obj(),
+			wantErr:    apierrors.IsNotFound,
+		},
+		"neither a job nor a workload": {
+			localQueue: "lq-a",
+			wantErr:    apierrors.IsInvalid,
+		},
+		"another kind": {
+			localQueue: "lq-a",
+			simulate:   map[string]any{"apiVersion": kueue.SchemeGroupVersion.String(), "kind": "LocalQueue", "metadata": map[string]any{"name": "x"}},
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"an unknown field": {
+			localQueue: "lq-a",
+			simulate:   map[string]any{"apiVersion": kueue.SchemeGroupVersion.String(), "kind": "Workload", "spec": map[string]any{"podsets": []any{}}},
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"another namespace": {
+			localQueue: "lq-a",
+			simulate:   utiltestingapi.MakeWorkload("incoming", "other").Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"another LocalQueue in the Workload": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").Queue("lq-other").Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"a Workload the webhook rejects": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").Request(corev1.ResourceCPU, "-1").Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a Workload without PodSets": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").PodSets().Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a workload slice replacement": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").Annotation(workloadslicing.WorkloadSliceReplacementFor, "default/running").Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"a Workload that already holds quota": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("running").Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"a missing WorkloadPriorityClass": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").WorkloadPriorityClassRef("missing").Priority(0).Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"a priority class without a priority": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").WorkloadPriorityClassRef("high").Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a priority class of another kind": {
+			localQueue: "lq-a",
+			simulate: simulatedWorkload("incoming").Priority(0).
+				PriorityClassRef(&kueue.PriorityClassRef{Group: kueue.WorkloadPriorityClassGroup, Kind: kueue.PodPriorityClassKind, Name: "high"}).Obj(),
+			wantErr: apierrors.IsInvalid,
+		},
+		"two PodSets with one name": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").PodSets(*utiltestingapi.MakePodSet("a", 1).Obj(), *utiltestingapi.MakePodSet("a", 1).Obj()).Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a PodSet name that is not a DNS label": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").PodSets(*utiltestingapi.MakePodSet("Main", 1).Obj()).Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a negative count": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").PodSets(*utiltestingapi.MakePodSet("main", -3).Obj()).Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a minimum count above the count": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").PodSets(*utiltestingapi.MakePodSet("main", 2).SetMinimumCount(3).Obj()).Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a ClusterQueue that schedules variants": {
+			localQueue: "lq-variants",
+			simulate:   simulatedWorkload("incoming").Request(corev1.ResourceCPU, "1").Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+		"a priority class reference without a group and kind": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").Priority(0).PriorityClassRef(&kueue.PriorityClassRef{Name: "high"}).Obj(),
+			wantErr:    apierrors.IsInvalid,
+		},
+		"a concurrent admission variant": {
+			localQueue: "lq-a",
+			simulate: simulatedWorkload("incoming").OwnerReference(
+				kueue.SchemeGroupVersion.WithKind("Workload"), "parent", "parent-uid").Obj(),
+			wantErr: apierrors.IsBadRequest,
+		},
+		"an inactive Workload": {
+			localQueue: "lq-a",
+			simulate:   simulatedWorkload("incoming").Active(false).Obj(),
+			wantErr:    apierrors.IsBadRequest,
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, map[featuregate.Feature]bool{features.PartialAdmission: true, features.ConcurrentAdmission: true})
+			ctx, _ := utiltesting.ContextWithLog(t)
+			env := newSimulationEnv(t, now, setup)
+			var err error
+			if tc.simulate == nil {
+				_, err = env.create(ctx, tc.localQueue, visibility.WorkloadSimulationSpec{})
+			} else {
+				_, err = env.simulate(ctx, t, tc.localQueue, tc.simulate)
+			}
+			if !tc.wantErr(err) {
+				t.Errorf("Unexpected error: %v", err)
+			}
+		})
+	}
+}
