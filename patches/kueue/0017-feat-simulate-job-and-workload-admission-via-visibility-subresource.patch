+// TestWorkloadBuilderIgnoresWhatTheReconcilerDoesNotRead checks that Build reads
+// a job as the job reconciler does: without the status, which the API server
+// ignores on create and update, and without the fields that the job's type does
+// not have, which the reconciler's typed client drops.
+func TestWorkloadBuilderIgnoresWhatTheReconcilerDoesNotRead(t *testing.T) {
+	ctx, _ := utiltesting.ContextWithLog(t)
+	builder := NewWorkloadBuilder(builderTestClient(builderTestObjects()...), WithIntegrationManager(builderTestIntegrations(t)))
+	j := testingjob.MakeJob("train", builderNamespace).SetTypeMeta().Queue("lq").Request(corev1.ResourceCPU, "1").Obj()
+	want, _, err := builder.Build(ctx, rawJob(t, j), builderNamespace)
+	if err != nil {
+		t.Fatal(err)
+	}
+	withStatus := j.DeepCopy()
+	withStatus.Status = batchv1.JobStatus{Active: 1, Ready: new(int32(1))}
+	var withUnknownField map[string]any
+	if err := json.Unmarshal(rawJob(t, j), &withUnknownField); err != nil {
+		t.Fatal(err)
+	}
+	withUnknownField["spec"].(map[string]any)["fieldOfANewerAPIServer"] = true
+	for name, job := range map[string]any{"a status": withStatus, "an unknown field": withUnknownField} {
+		t.Run(name, func(t *testing.T) {
+			got, _, err := builder.Build(ctx, rawJob(t, job), builderNamespace)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if diff := cmp.Diff(want, got); diff != "" {
+				t.Errorf("Build() differs from the Build of the job without %s (-without,+with):\n%s", name, diff)
+			}
+		})
+	}
