+// TestSimulateInLQRedactsUnreadableNamespaces checks that the answer names
+// preemption targets and pending workloads only in namespaces where the caller
+// may get Workloads.
+func TestSimulateInLQRedactsUnreadableNamespaces(t *testing.T) {
+	now := time.Now().Truncate(time.Second)
+	setup := simulationSetup{
+		objects: []client.Object{utiltesting.MakeNamespace("other")},
+		clusterQueues: []*kueue.ClusterQueue{
+			cpuClusterQueue("cq-a", "4").Cohort("cohort").
+				Preemption(kueue.ClusterQueuePreemption{ReclaimWithinCohort: kueue.PreemptionPolicyAny}).Obj(),
+			cpuClusterQueue("cq-b", "0").Cohort("cohort").Obj(),
+		},
+		localQueues: []*kueue.LocalQueue{
+			utiltestingapi.MakeLocalQueue("lq-a", simulationNamespace).ClusterQueue("cq-a").Obj(),
+			utiltestingapi.MakeLocalQueue("lq-a", "other").ClusterQueue("cq-a").Obj(),
+			utiltestingapi.MakeLocalQueue("lq-b", "other").ClusterQueue("cq-b").Obj(),
+		},
+		workloads: []*kueue.Workload{
+			utiltestingapi.MakeWorkload("borrower", "other").Queue("lq-b").Priority(100).Request(corev1.ResourceCPU, "4").
+				ReserveQuotaAt(utiltestingapi.MakeAdmission("cq-b").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+					Assignment(corev1.ResourceCPU, "default", "4").Obj()).Obj(), now).AdmittedAt(true, now).Obj(),
+			utiltestingapi.MakeWorkload("waiting", "other").Queue("lq-a").Priority(50).Request(corev1.ResourceCPU, "8").Creation(now).Obj(),
+		},
+	}
+	cases := map[string]struct {
+		readable    string
+		wantTarget  visibility.SimulatedPreemptionTarget
+		wantWaiting visibility.PendingWorkload
+	}{
+		"the caller may read the other namespace": {
+			readable: "other",
+			wantTarget: visibility.SimulatedPreemptionTarget{
+				Name: "borrower", Namespace: "other", ClusterQueue: "cq-b", LocalQueueName: "lq-b", Priority: 100,
+				Reason: kueue.InCohortReclamationReason,
+			},
+			wantWaiting: visibility.PendingWorkload{
+				Name: "waiting", Namespace: "other", CreationTimestamp: metav1.NewTime(now), Priority: 50, LocalQueueName: "lq-a",
+			},
+		},
+		"the caller may read only its own namespace": {
+			readable: simulationNamespace,
+			wantTarget: visibility.SimulatedPreemptionTarget{
+				ClusterQueue: "cq-b", Priority: 100, Reason: kueue.InCohortReclamationReason,
+			},
+			wantWaiting: visibility.PendingWorkload{CreationTimestamp: metav1.NewTime(now), Priority: 50},
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			ctx, _ := utiltesting.ContextWithLog(t)
+			env := newSimulationEnv(t, now, setup)
+			env.rest.authorizer = namespacesAuthorizer{simulationNamespace, tc.readable}
+			ctx = genericapirequest.WithUser(ctx, &user.DefaultInfo{Name: "alice"})
+			got, err := env.simulate(ctx, t, "lq-a", simulatedWorkload("incoming").Request(corev1.ResourceCPU, "2").Obj())
+			if err != nil {
+				t.Fatalf("Simulating: %v", err)
+			}
+			if diff := cmp.Diff([]visibility.SimulatedPreemptionTarget{tc.wantTarget}, got.Status.PreemptionTargets); diff != "" {
+				t.Errorf("Unexpected preemption targets (-want,+got):\n%s", diff)
+			}
+			if diff := cmp.Diff([]visibility.PendingWorkload{tc.wantWaiting}, got.Status.WorkloadsAhead, cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("Unexpected workloads ahead (-want,+got):\n%s", diff)
+			}
+		})
+	}
+}
