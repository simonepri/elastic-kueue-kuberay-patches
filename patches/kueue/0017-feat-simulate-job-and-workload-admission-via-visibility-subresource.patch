+func TestWorkloadBuilderRejects(t *testing.T) {
+	trainJob := func() *testingjob.JobWrapper {
+		return testingjob.MakeJob("train", "").SetTypeMeta().Queue("lq").Request(corev1.ResourceCPU, "1")
+	}
+	unfinished := func(name string) *kueue.Workload {
+		return utiltestingapi.MakeWorkload(name, builderNamespace).ControllerReference(batchJobGVK, "train", "train-uid").Obj()
+	}
+	trainWorkload := func(name string) *utiltestingapi.WorkloadWrapper {
+		return utiltestingapi.MakeWorkload(name, builderNamespace).Queue("lq").
+			ControllerReference(batchJobGVK, "train", "train-uid").Request(corev1.ResourceCPU, "2")
+	}
+	cases := map[string]struct {
+		gates   map[featuregate.Feature]bool
+		raw     func(t *testing.T) []byte
+		objects []client.Object
+		opts    []Option
+		// want is a part of the error message.
+		want string
+	}{
+		"a kind of no integration": {
+			raw: func(t *testing.T) []byte {
+				return []byte(`{"apiVersion": "v1", "kind": "ConfigMap", "metadata": {"name": "train"}}`)
+			},
+			want: "v1 ConfigMap is not the job of an enabled integration",
+		},
+		"a Deployment, whose Workloads Kueue builds from its pods": {
+			raw: func(t *testing.T) []byte {
+				return []byte(`{"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": "train"}}`)
+			},
+			want: "Kueue builds the Workloads of a Deployment from its pods",
+		},
+		"a job in a namespace that Kueue does not manage": {
+			raw:  func(t *testing.T) []byte { return rawJob(t, trainJob().Obj()) },
+			opts: []Option{WithManagedJobsNamespaceSelector(labels.SelectorFromSet(labels.Set{"managed": "true"}))},
+			want: "Kueue does not manage the jobs of namespace ns",
+		},
+		"a job that its integration rejects": {
+			gates: map[featuregate.Feature]bool{features.TopologyAwareScheduling: true},
+			raw: func(t *testing.T) []byte {
+				return rawJob(t, trainJob().PodAnnotation(kueue.PodSetUnconstrainedTopologyAnnotation, "maybe").Obj())
+			},
+			want: "invalid syntax",
+		},
+		"a job of an owner that Kueue manages": {
+			raw:     func(t *testing.T) []byte { return rawJob(t, trainJob().OwnerReference("parent", batchJobGVK).Obj()) },
+			objects: []client.Object{testingjob.MakeJob("parent", builderNamespace).UID("parent").Queue("lq").Obj()},
+			want:    "Kueue manages it through an owner",
+		},
+		"a job whose Workload is finished": {
+			raw:     func(t *testing.T) []byte { return rawJob(t, trainJob().Obj()) },
+			objects: []client.Object{trainWorkload("done").Finished().Obj()},
+			want:    "its Workload is finished",
+		},
+		"a manifest of a job that has a Workload, without the uid that a dry run gives it": {
+			raw:     func(t *testing.T) []byte { return rawJob(t, trainJob().Obj()) },
+			objects: []client.Object{unfinished("pending")},
+			want:    "it exists, but it has no uid",
+		},
+		"a job that no longer matches a Workload that holds quota": {
+			raw: func(t *testing.T) []byte { return rawJob(t, trainJob().UID("train-uid").Obj()) },
+			objects: []client.Object{trainWorkload("admitted").ReserveQuotaAt(
+				utiltestingapi.MakeAdmission("cq").PodSets(utiltestingapi.MakePodSetAssignment(kueue.DefaultPodSetName).
+					Assignment(corev1.ResourceCPU, "default", "2").Obj()).Obj(), time.Now()).Obj()},
+			want: "Kueue would delete its Workload and build another one",
+		},
+		"a kind of an integration that is not enabled": {
+			raw: func(t *testing.T) []byte {
+				return []byte(`{"apiVersion": "kubeflow.org/v1", "kind": "TFJob", "metadata": {"name": "train"}}`)
+			},
+			want: "kubeflow.org/v1 TFJob is not the job of an enabled integration",
+		},
+		"a Pod, whose Workload Kueue builds from its group": {
+			raw: func(t *testing.T) []byte {
+				p := testingpod.MakePod("train", "").Queue("lq").Obj()
+				p.TypeMeta = metav1.TypeMeta{APIVersion: "v1", Kind: "Pod"}
+				return rawJob(t, p)
+			},
+			want: "from all members of its group",
+		},
+		"no kind": {
+			raw:  func(t *testing.T) []byte { return []byte(`{"metadata": {"name": "train"}}`) },
+			want: "Object 'Kind' is missing",
+		},
+		"another namespace": {
+			raw: func(t *testing.T) []byte {
+				j := trainJob().Obj()
+				j.Namespace = "other"
+				return rawJob(t, j)
+			},
+			want: "its namespace \"other\" is not the request's namespace",
+		},
+		"a prebuilt Workload": {
+			raw:  func(t *testing.T) []byte { return rawJob(t, trainJob().PrebuiltWorkloadLabel("prebuilt").Obj()) },
+			want: "uses the prebuilt Workload",
+		},
+		"a missing WorkloadPriorityClass": {
+			raw:  func(t *testing.T) []byte { return rawJob(t, trainJob().WorkloadPriorityClass("missing").Obj()) },
+			want: "\"missing\" not found",
+		},
+		"a job without the defaults of the API server": {
+			raw: func(t *testing.T) []byte {
+				j := trainJob().Obj()
+				j.Spec.Parallelism = nil
+				return rawJob(t, j)
+			},
+			want: "Kueue's integration failed on it",
+		},
+		"a job with two Workloads that are not finished": {
+			raw:     func(t *testing.T) []byte { return rawJob(t, trainJob().Obj()) },
+			objects: []client.Object{unfinished("first"), unfinished("second")},
+			want:    "it has 2 Workloads that are not finished",
+		},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			features.SetFeatureGatesDuringTest(t, tc.gates)
+			ctx, _ := utiltesting.ContextWithLog(t)
+			opts := append([]Option{WithIntegrationManager(builderTestIntegrations(t))}, tc.opts...)
+			builder := NewWorkloadBuilder(builderTestClient(append(builderTestObjects(), tc.objects...)...), opts...)
+			if _, _, err := builder.Build(ctx, tc.raw(t), builderNamespace); !errors.Is(err, ErrJobNotSimulatable) {
+				t.Errorf("Build() error = %v, want %v", err, ErrJobNotSimulatable)
+			} else if !strings.Contains(err.Error(), tc.want) {
+				t.Errorf("Build() error = %v, want it to say %q", err, tc.want)
+			}
+		})
+	}
+}
