@@ -699,6 +699,76 @@ TEST_F(SyncerTest, Reconnect) {
       5));
 }
 
+TEST_F(SyncerTest, MessagesAboutDeadNodesAreNeitherStoredNorForwarded) {
+  auto &s1 = MakeServer("19982");
+  auto &s2 = MakeServer("19983");
+  const auto dead_node_id = NodeID::FromRandom();
+  const auto alive_node_id = NodeID::FromRandom();
+  s1.syncer->SetDeadNodeFilter([dead_node_id](const std::string &node_id) {
+    return node_id == dead_node_id.Binary();
+  });
+
+  s2.syncer->Connect(s1.syncer->GetLocalNodeID(), MakeChannel("19982"));
+  ASSERT_TRUE(s2.WaitUntil([&s2]() { return s2.syncer->sync_reactors_.size() == 1; }, 5));
+
+  // The stream keeps the order, so the live node's message arriving proves the dead
+  // node's earlier one was already handled.
+  s2.syncer->BroadcastMessage(
+      std::make_shared<RaySyncMessage>(MakeMessage(MessageType::RESOURCE_VIEW, 1, dead_node_id)));
+  s2.WaitSendingFlush();
+  s2.syncer->BroadcastMessage(std::make_shared<RaySyncMessage>(
+      MakeMessage(MessageType::RESOURCE_VIEW, 1, alive_node_id)));
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &alive_node_id]() {
+        return s1.received_versions.count(alive_node_id.Binary()) == 1;
+      },
+      5));
+
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &dead_node_id]() {
+        const auto &view = s1.syncer->node_state_->GetClusterView();
+        return view.count(dead_node_id.Binary()) == 0 &&
+               s1.received_versions.count(dead_node_id.Binary()) == 0;
+      },
+      5));
+}
+
+TEST_F(SyncerTest, RemovedNodeIsNotSentToNewPeers) {
+  auto &s1 = MakeServer("19984");
+  auto &s2 = MakeServer("19985");
+  auto &s3 = MakeServer("19986");
+  const auto gone_node_id = NodeID::FromRandom();
+
+  s2.syncer->Connect(s1.syncer->GetLocalNodeID(), MakeChannel("19984"));
+  s2.syncer->BroadcastMessage(std::make_shared<RaySyncMessage>(
+      MakeMessage(MessageType::RESOURCE_VIEW, 1, gone_node_id)));
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &gone_node_id]() {
+        return s1.syncer->node_state_->GetClusterView().count(gone_node_id.Binary()) == 1;
+      },
+      5));
+
+  // The node dies; s1 forgets it, then a new peer connects and must not learn about it.
+  s1.syncer->RemoveNode(gone_node_id.Binary());
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &gone_node_id]() {
+        return s1.syncer->node_state_->GetClusterView().count(gone_node_id.Binary()) == 0;
+      },
+      5));
+
+  s1.syncer->Connect(s3.syncer->GetLocalNodeID(), MakeChannel("19986"));
+  ASSERT_TRUE(s3.WaitUntil(
+      [&s3, &s1]() {
+        return s3.received_versions.count(s1.syncer->GetLocalNodeID()) == 1;
+      },
+      5));
+  ASSERT_TRUE(s3.WaitUntil(
+      [&s3, &gone_node_id]() {
+        return s3.received_versions.count(gone_node_id.Binary()) == 0;
+      },
+      2));
+}
+
 TEST_F(SyncerTest, Broadcast) {
   // This test covers the broadcast feature of ray syncer.
   auto &s1 = MakeServer("19990");
diff --git a/src/ray/raylet/tests/node_manager_test.cc b/src/ray/raylet/tests/node_manager_test.cc
index 897029a..c9c909a 100644
--- a/src/ray/raylet/tests/node_manager_test.cc
+++ b/src/ray/raylet/tests/node_manager_test.cc
@@ -747,6 +747,48 @@ TEST_F(NodeManagerTest, TestDetachedWorkerIsKilledByFailedNode) {
   EXPECT_FALSE(worker->IsKilled());
 }
 
+TEST_F(NodeManagerTest, TestNodeRemovedDropsSyncerClusterView) {
+  const auto dead_node_id = NodeID::FromRandom();
+  const auto alive_node_id = NodeID::FromRandom();
+  EXPECT_CALL(*mock_object_directory_, HandleNodeRemoved(dead_node_id)).Times(1);
+  EXPECT_CALL(*mock_object_manager_, HandleNodeRemoved(dead_node_id)).Times(1);
+
+  // The syncer runs on io_service_, which no thread runs in this test.
+  auto drain = [this]() {
+    io_service_.restart();
+    io_service_.poll();
+  };
+  auto syncer_knows = [&](const NodeID &node_id) {
+    bool known = false;
+    io_service_.post(
+        [&]() {
+          known = node_manager_->ray_syncer_.GetSyncMessage(
+                      node_id.Binary(), syncer::MessageType::RESOURCE_VIEW) != nullptr;
+        },
+        "TEST");
+    drain();
+    return known;
+  };
+
+  for (const auto &node_id : {dead_node_id, alive_node_id}) {
+    syncer::RaySyncMessage msg;
+    msg.set_node_id(node_id.Binary());
+    msg.set_message_type(syncer::MessageType::RESOURCE_VIEW);
+    msg.set_version(1);
+    node_manager_->ray_syncer_.BroadcastMessage(
+        std::make_shared<syncer::RaySyncMessage>(msg));
+  }
+  drain();
+  ASSERT_TRUE(syncer_knows(dead_node_id));
+  ASSERT_TRUE(syncer_knows(alive_node_id));
+
+  node_manager_->NodeRemoved(dead_node_id);
+  drain();
+
+  EXPECT_FALSE(syncer_knows(dead_node_id));
+  EXPECT_TRUE(syncer_knows(alive_node_id));
+}
