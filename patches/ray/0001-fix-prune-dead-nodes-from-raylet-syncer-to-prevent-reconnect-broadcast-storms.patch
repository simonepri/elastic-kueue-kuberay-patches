@@ -210,6 +220,11 @@ bool RaySyncer::BroadcastMessageIfNewVersion(MessageType message_type) {
 void RaySyncer::BroadcastMessage(std::shared_ptr<const RaySyncMessage> message) {
   io_context_.dispatch(
       [this, message] {
+        if (is_node_dead_ && is_node_dead_(message->node_id())) {
+          RAY_LOG(DEBUG).WithField(NodeID::FromBinary(message->node_id()))
