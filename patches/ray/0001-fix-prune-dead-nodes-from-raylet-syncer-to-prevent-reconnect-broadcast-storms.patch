diff --git a/src/ray/ray_syncer/tests/ray_syncer_test.cc b/src/ray/ray_syncer/tests/ray_syncer_test.cc
index b2c0fc2..88289fc 100644
--- a/src/ray/ray_syncer/tests/ray_syncer_test.cc
