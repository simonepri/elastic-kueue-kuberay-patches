From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <simone.primarosa@gmail.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] fix: add exponential backoff and jitter to syncer reconnect to prevent thundering herd storms

A syncer client that loses its connection reconnects after a fixed 2 seconds, with
no backoff or jitter. When many raylets lose the GCS at once they all retry in
lockstep, and every retry makes the GCS send each of them the full cluster view
again, which can keep the connections breaking.

The delay is now exponential backoff with full jitter: uniform between zero and a
ceiling computed by ray::ExponentialBackoff::GetBackoffMs, starting at
RAY_ray_syncer_reconnect_base_delay_ms (2000 ms) and doubling per failure up to
RAY_ray_syncer_reconnect_max_delay_ms (60000 ms). The attempt count resets directly
in the message processor upon receiving a message.

Upstream status: not yet reported to ray-project/ray.
---
 src/ray/common/ray_config_def.h             |  9 ++++++++
 src/ray/ray_syncer/BUILD.bazel              |  2 ++
 src/ray/ray_syncer/ray_syncer.cc            | 21 ++++++++++++++----
 src/ray/ray_syncer/ray_syncer.h             |  9 ++++++++
 src/ray/ray_syncer/tests/ray_syncer_test.cc | 34 +++++++++++++++++++++++++++++
 5 files changed, 71 insertions(+), 4 deletions(-)

diff --git a/src/ray/common/ray_config_def.h b/src/ray/common/ray_config_def.h
index ed640d1..c66fcd5 100644
--- a/src/ray/common/ray_config_def.h
+++ b/src/ray/common/ray_config_def.h
@@ -596,6 +596,15 @@ RAY_CONFIG(int32_t, grpc_client_check_connection_status_interval_milliseconds, 1
 /// Refer to https://tinyurl.com/n6kvsp87 for more details
 RAY_CONFIG(int64_t, ray_syncer_message_refresh_interval_ms, 3000)
 
+/// Base delay before a ray syncer client reconnects after its connection breaks. Each
+/// further consecutive failure doubles the upper bound of the randomized delay until it
+/// reaches `ray_syncer_reconnect_max_delay_ms`; a connection that receives a message
+/// resets it.
+RAY_CONFIG(uint64_t, ray_syncer_reconnect_base_delay_ms, 2000)
+
+/// Upper bound of the randomized delay before a ray syncer client reconnects.
+RAY_CONFIG(uint64_t, ray_syncer_reconnect_max_delay_ms, 60000)
+
 /// The batch size for metrics export.
 /// Normally each time-series << 1Kb. Batch size of 10_000 means expected payload
 /// will be under 10Mb.
diff --git a/src/ray/ray_syncer/BUILD.bazel b/src/ray/ray_syncer/BUILD.bazel
index 0b6f733..336b1ef 100644
--- a/src/ray/ray_syncer/BUILD.bazel
+++ b/src/ray/ray_syncer/BUILD.bazel
@@ -27,7 +27,9 @@ ray_cc_library(
         "//src/ray/rpc/authentication:authentication_token",
         "//src/ray/rpc/authentication:authentication_token_loader",
         "//src/ray/rpc/authentication:authentication_token_validator",
+        "//src/ray/util:exponential_backoff",
         "@com_github_grpc_grpc//:grpc++",
         "@com_google_absl//absl/container:flat_hash_map",
+        "@com_google_absl//absl/random",
     ],
 )
diff --git a/src/ray/ray_syncer/ray_syncer.cc b/src/ray/ray_syncer/ray_syncer.cc
index bf9b1aa..3363335 100644
--- a/src/ray/ray_syncer/ray_syncer.cc
+++ b/src/ray/ray_syncer/ray_syncer.cc
@@ -25,6 +25,7 @@
 #include "ray/ray_syncer/node_state.h"
 #include "ray/ray_syncer/ray_syncer_client.h"
 #include "ray/ray_syncer/ray_syncer_server.h"
+#include "ray/util/exponential_backoff.h"
 
 namespace ray::syncer {
 
@@ -89,7 +90,10 @@ void RaySyncer::Connect(const std::string &node_id,
             /* local_node_id */ GetLocalNodeID(),
             /* io_context */ io_context_,
             /* message_processor */
-            [this](auto msg) { BroadcastMessage(std::move(msg)); },
+            [this, node_id](auto msg) {
+              reconnect_attempts_.erase(node_id);
+              BroadcastMessage(std::move(msg));
+            },
             /* cleanup_cb */
             [this, channel](RaySyncerBidiReactor *bidi_reactor, bool restart) {
               const std::string &remote_node_id = bidi_reactor->GetRemoteNodeID();
@@ -102,15 +106,24 @@ void RaySyncer::Connect(const std::string &node_id,
                 sync_reactors_.erase(iter);
               }
               if (restart) {
+                const auto attempt = reconnect_attempts_[remote_node_id]++;
+                const auto max_delay_ms = ray::ExponentialBackoff::GetBackoffMs(
+                    attempt,
+                    RayConfig::instance().ray_syncer_reconnect_base_delay_ms(),
+                    RayConfig::instance().ray_syncer_reconnect_max_delay_ms());
+                const auto delay_ms = static_cast<uint64_t>(
+                    absl::Uniform(bitgen_, 0.0, 1.0) * static_cast<double>(max_delay_ms));
                 execute_after(
                     io_context_,
-                    [this, remote_node_id, channel]() {
+                    [this, remote_node_id, channel, attempt, delay_ms]() {
                       RAY_LOG(INFO).WithField(NodeID::FromBinary(remote_node_id))
-                          << "Connection to the node was broken, reconnecting.";
+                          << "Connection to the node was broken, reconnecting after "
+                          << delay_ms << " ms (attempt " << attempt + 1 << ").";
                       Connect(remote_node_id, channel);
                     },
-                    /* delay_microseconds = */ std::chrono::milliseconds(2000));
+                    /* delay_microseconds = */ std::chrono::milliseconds(delay_ms));
               } else {
+                reconnect_attempts_.erase(remote_node_id);
                 node_state_->RemoveNode(remote_node_id);
               }
             },
diff --git a/src/ray/ray_syncer/ray_syncer.h b/src/ray/ray_syncer/ray_syncer.h
index 06da1f3..5a425ea 100644
--- a/src/ray/ray_syncer/ray_syncer.h
+++ b/src/ray/ray_syncer/ray_syncer.h
@@ -24,6 +24,7 @@
 
 #include "absl/container/flat_hash_map.h"
 #include "absl/container/flat_hash_set.h"
+#include "absl/random/random.h"
 #include "boost/functional/hash.hpp"
 #include "ray/asio/instrumented_io_context.h"
 #include "ray/asio/periodical_runner_interface.h"
@@ -211,6 +212,13 @@ class RaySyncer {
   /// Tells whether a node is known to be dead; empty if the syncer has no such source.
   std::function<bool(const std::string &)> is_node_dead_;
 
+  /// Consecutive failed connection attempts per remote node, driving the reconnect
+  /// backoff. An entry is removed once the connection to the node works again.
+  absl::flat_hash_map<std::string, uint32_t> reconnect_attempts_;
+
+  /// Bit generator for randomized backoff jitter.
+  absl::BitGen bitgen_;
+
   friend class RaySyncerService;
   /// Test purpose
   friend struct SyncerServerTest;
@@ -220,6 +228,7 @@ class RaySyncer {
   FRIEND_TEST(SyncerTest, Test1ToN);
   FRIEND_TEST(SyncerTest, TestMToN);
   FRIEND_TEST(SyncerTest, Reconnect);
+  FRIEND_TEST(SyncerTest, ReconnectBackoffResetsAfterConnection);
   FRIEND_TEST(SyncerTest, MessagesAboutDeadNodesAreNeitherStoredNorForwarded);
   FRIEND_TEST(SyncerTest, RemovedNodeIsNotSentToNewPeers);
 };
diff --git a/src/ray/ray_syncer/tests/ray_syncer_test.cc b/src/ray/ray_syncer/tests/ray_syncer_test.cc
index 88289fc..34d3994 100644
--- a/src/ray/ray_syncer/tests/ray_syncer_test.cc
+++ b/src/ray/ray_syncer/tests/ray_syncer_test.cc
@@ -34,6 +34,7 @@
 #include <vector>
 
 #include "ray/asio/periodical_runner.h"
+#include "ray/common/ray_config.h"
 #include "ray/common/test_utils.h"
 #include "ray/ray_syncer/node_state.h"
 #include "ray/ray_syncer/ray_syncer.h"
@@ -699,6 +700,39 @@ TEST_F(SyncerTest, Reconnect) {
       5));
 }
 
+TEST_F(SyncerTest, ReconnectBackoffResetsAfterConnection) {
+  const auto orig_base = RayConfig::instance().ray_syncer_reconnect_base_delay_ms();
+  const auto orig_max = RayConfig::instance().ray_syncer_reconnect_max_delay_ms();
+  RayConfig::instance().initialize(R"({
+    "ray_syncer_reconnect_base_delay_ms": 20,
+    "ray_syncer_reconnect_max_delay_ms": 80
+  })");
+  auto &s1 = MakeServer("19980");
+  const auto s2_node_id = NodeID::FromRandom();
+
+  // Nothing listens yet, so every attempt fails and the attempt count grows.
+  s1.syncer->Connect(s2_node_id.Binary(), MakeChannel("19981"));
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &s2_node_id]() {
+        auto it = s1.syncer->reconnect_attempts_.find(s2_node_id.Binary());
+        return it != s1.syncer->reconnect_attempts_.end() && it->second >= 3;
+      },
+      10));
+
+  // Once the server is up, the next attempt connects and receives a message.
+  auto &s2 = MakeServer("19981", s2_node_id, /*on_rpc_completion=*/{});
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &s2_node_id]() {
+        return s1.syncer->sync_reactors_.size() == 1 &&
+               s1.syncer->reconnect_attempts_.count(s2_node_id.Binary()) == 0 &&
+               s1.received_versions.count(s2_node_id.Binary()) == 1;
+      },
+      10));
+  (void)s2;
+  RayConfig::instance().ray_syncer_reconnect_base_delay_ms() = orig_base;
+  RayConfig::instance().ray_syncer_reconnect_max_delay_ms() = orig_max;
+}
+
 TEST_F(SyncerTest, MessagesAboutDeadNodesAreNeitherStoredNorForwarded) {
   auto &s1 = MakeServer("19982");
   auto &s2 = MakeServer("19983");
