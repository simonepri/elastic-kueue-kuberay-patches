+    unschedulable_status_timeout_s: int = env_integer(
+        "RAY_AUTOSCALER_RECONCILE_UNSCHEDULABLE_TIMEOUT_S", 2 * 60
+    )
+    # The timeout for waiting for an ALLOCATED instance that the cloud provider
