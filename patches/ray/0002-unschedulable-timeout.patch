             node_type=type,
             node_kind=kind,
             is_running=KubeRayProvider._is_running(pod),
+            is_unschedulable=KubeRayProvider._is_unschedulable(pod),
         )
 
+    @staticmethod
+    def _is_unschedulable(pod) -> bool:
+        """Whether the pod can't be placed on a node yet.
+
+        A pod is unschedulable while it has no node and either still has
+        scheduling gates (e.g. it waits for a queue to admit it) or the scheduler
+        reported it as Unschedulable. A pod bound to a node is never unschedulable,
+        even while it pulls its image or its node is still starting.
+        """
+        if pod.get("spec", {}).get("nodeName"):
+            return False
+        if pod.get("spec", {}).get("schedulingGates"):
+            return True
+        for condition in pod.get("status", {}).get("conditions") or []:
+            if (
+                condition.get("type") == "PodScheduled"
+                and condition.get("status") == "False"
+                and condition.get("reason") == "Unschedulable"
+            ):
+                return True
+        return False
+
