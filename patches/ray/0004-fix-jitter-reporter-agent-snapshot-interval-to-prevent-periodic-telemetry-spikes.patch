From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <simone.primarosa@gmail.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] fix: jitter reporter agent snapshot interval to prevent periodic telemetry spikes

The reporter agent publishes a node stats snapshot every REPORTER_UPDATE_INTERVAL_MS
(5000 by default) with a fixed sleep, so after a cluster start every node publishes in
lockstep and the GCS receives the reports in bursts.

The first report now waits a random part of the interval, and every later wait varies
by up to REPORTER_UPDATE_INTERVAL_JITTER_FRACTION (0.2 by default) of the interval in
either direction. REPORTER_UPDATE_INTERVAL_MS stays the base interval.

Upstream status: not yet reported to ray-project/ray.
---
 .../dashboard/modules/reporter/reporter_agent.py   | 18 +++++-
 .../dashboard/modules/reporter/reporter_consts.py  |  6 ++
 .../tests/test_reporter_interval_jitter.py         | 67 ++++++++++++++++++++++
 3 files changed, 90 insertions(+), 1 deletion(-)

diff --git a/python/ray/dashboard/modules/reporter/reporter_agent.py b/python/ray/dashboard/modules/reporter/reporter_agent.py
index 8919451..e97d7ba 100644
--- a/python/ray/dashboard/modules/reporter/reporter_agent.py
+++ b/python/ray/dashboard/modules/reporter/reporter_agent.py
@@ -3,6 +3,7 @@ import datetime
 import json
 import logging
 import os
+import random
 import socket
 import sys
 import traceback
@@ -85,6 +86,11 @@ import psutil
 
 logger = logging.getLogger(__name__)
 
+
+def _jittered_interval_s(interval_ms: float, jitter_fraction: float) -> float:
+    """Return the update interval in seconds, varied by up to `jitter_fraction`."""
+    return interval_ms / 1000 * (1 + random.uniform(-jitter_fraction, jitter_fraction))
+
 enable_tpu_usage_check = True
 
 # Are we in a K8s pod?
@@ -2050,6 +2056,11 @@ class ReporterAgent(
         """Get any changes to the log files and push updates to kv."""
         loop = get_or_create_event_loop()
 
+        # Spread the first report of all nodes over one interval.
+        await asyncio.sleep(
+            random.uniform(0, reporter_consts.REPORTER_UPDATE_INTERVAL_MS / 1000)
+        )
+
         while True:
             try:
                 # Fetch autoscaler debug status
@@ -2096,7 +2107,12 @@ class ReporterAgent(
             except Exception:
                 logger.exception("Error publishing node physical stats.")
 
-            await asyncio.sleep(reporter_consts.REPORTER_UPDATE_INTERVAL_MS / 1000)
+            await asyncio.sleep(
+                _jittered_interval_s(
+                    reporter_consts.REPORTER_UPDATE_INTERVAL_MS,
+                    reporter_consts.REPORTER_UPDATE_INTERVAL_JITTER_FRACTION,
+                )
+            )
 
     def _run_in_executor(
         self,
diff --git a/python/ray/dashboard/modules/reporter/reporter_consts.py b/python/ray/dashboard/modules/reporter/reporter_consts.py
index b3254fd..3430eb6 100644
--- a/python/ray/dashboard/modules/reporter/reporter_consts.py
+++ b/python/ray/dashboard/modules/reporter/reporter_consts.py
@@ -5,3 +5,9 @@ REPORTER_PREFIX = "RAY_REPORTER:"
 REPORTER_UPDATE_INTERVAL_MS = ray_constants.env_integer(
     "REPORTER_UPDATE_INTERVAL_MS", 5000
 )
+# Each wait between reports varies by up to this fraction of the update interval in either
+# direction, and the first report waits a random part of the interval, so the nodes of a
+# large cluster do not report in lockstep.
+REPORTER_UPDATE_INTERVAL_JITTER_FRACTION = ray_constants.env_float(
+    "REPORTER_UPDATE_INTERVAL_JITTER_FRACTION", 0.2
+)
diff --git a/python/ray/dashboard/tests/test_reporter_interval_jitter.py b/python/ray/dashboard/tests/test_reporter_interval_jitter.py
new file mode 100644
index 0000000..75bccb2
--- /dev/null
+++ b/python/ray/dashboard/tests/test_reporter_interval_jitter.py
@@ -0,0 +1,67 @@
+"""Check that the reporter agent spreads its node stats reports over time."""
+
+import asyncio
+import sys
+import unittest
+from unittest import mock
+
+import ray.dashboard.modules.reporter.reporter_consts as reporter_consts
+from ray.dashboard.modules.reporter.reporter_agent import (
+    ReporterAgent,
+    _jittered_interval_s,
+)
+
+
+class ReporterIntervalJitterTest(unittest.TestCase):
+    def test_interval_stays_within_bounds_and_varies(self):
+        waits = [_jittered_interval_s(5000, 0.2) for _ in range(1000)]
+        self.assertTrue(all(4.0 <= wait <= 6.0 for wait in waits))
+        # A fixed interval would put every node in lockstep.
+        self.assertGreater(max(waits) - min(waits), 1.0)
+
+    def test_interval_without_jitter_is_the_base_interval(self):
+        self.assertEqual(_jittered_interval_s(5000, 0), 5.0)
+
+    def test_run_loop_staggers_first_report_and_jitters_waits(self):
+        sleeps = []
+        published = []
+
+        async def fake_sleep(seconds):
+            sleeps.append(seconds)
+            if len(sleeps) == 20:
+                raise asyncio.CancelledError
+
+        async def publish(key, payload):
+            published.append(payload)
+
+        agent = mock.MagicMock()
+        agent._is_head_node = False
+        agent._executor = None
+        agent._run_in_executor = lambda *_: "payload"
+        agent._gcs_client.async_publish_node_resource_usage = publish
+
+        with mock.patch.object(
+            reporter_consts, "REPORTER_UPDATE_INTERVAL_MS", 5000
+        ), mock.patch.object(
+            reporter_consts, "REPORTER_UPDATE_INTERVAL_JITTER_FRACTION", 0.2
+        ), mock.patch(
+            "ray.dashboard.modules.reporter.reporter_agent.asyncio.sleep", fake_sleep
+        ):
+            with self.assertRaises(asyncio.CancelledError):
+                asyncio.run(ReporterAgent._run_loop(agent))
+
+        initial_offset, waits = sleeps[0], sleeps[1:]
+        self.assertTrue(0 <= initial_offset <= 5.0)
+        # The agent publishes only after its initial offset.
+        self.assertEqual(len(published), len(waits))
+        self.assertTrue(all(4.0 <= wait <= 6.0 for wait in waits))
+        self.assertGreater(len(set(waits)), 1)
+
+
+if __name__ == "__main__":
+    try:
+        import pytest
+
+        sys.exit(pytest.main(["-v", __file__]))
+    except ImportError:
+        unittest.main()
