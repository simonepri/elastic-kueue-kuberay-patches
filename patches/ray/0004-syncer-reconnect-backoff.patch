+TEST(ReconnectBackoffTest, CeilingDoublesFromBaseUpToCap) {
+  // A random fraction just below 1 makes the delay equal to the ceiling.
+  const double almost_one = 0.999999;
+  auto ceiling = [&](uint32_t attempt) {
+    return ComputeReconnectDelayMs(attempt, 2000, 60000, almost_one);
+  };
+  EXPECT_EQ(ceiling(0), 1999);
+  EXPECT_EQ(ceiling(1), 3999);
+  EXPECT_EQ(ceiling(2), 7999);
+  EXPECT_EQ(ceiling(4), 31999);
+  EXPECT_EQ(ceiling(5), 59999);
+  EXPECT_EQ(ceiling(6), 59999);
+  EXPECT_EQ(ceiling(1000000), 59999);
+}
+
+TEST(ReconnectBackoffTest, FullJitterSpansZeroToCeiling) {
+  EXPECT_EQ(ComputeReconnectDelayMs(3, 2000, 60000, 0.0), 0);
+  EXPECT_EQ(ComputeReconnectDelayMs(3, 2000, 60000, 0.5), 8000);
+  EXPECT_EQ(ComputeReconnectDelayMs(0, 2000, 60000, 0.5), 1000);
+}
+
+TEST(ReconnectBackoffTest, BaseAboveCapIsClampedToCap) {
+  EXPECT_EQ(ComputeReconnectDelayMs(0, 90000, 60000, 0.5), 30000);
+}
+
+TEST(ReconnectBackoffTest, RandomUnitIntervalStaysInRange) {
+  for (int i = 0; i < 1000; ++i) {
+    const double value = RandomUnitInterval();
+    EXPECT_GE(value, 0.0);
+    EXPECT_LT(value, 1.0);
+  }
+}
+
+TEST_F(SyncerTest, ReconnectBackoffResetsAfterConnection) {
+  RayConfig::instance().initialize(R"({
+    "ray_syncer_reconnect_base_delay_ms": 20,
+    "ray_syncer_reconnect_max_delay_ms": 80
+  })");
+  auto &s1 = MakeServer("19980");
+  const auto s2_node_id = NodeID::FromRandom();
+
+  // Nothing listens yet, so every attempt fails and the attempt count grows.
+  s1.syncer->Connect(s2_node_id.Binary(), MakeChannel("19981"));
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &s2_node_id]() {
+        auto it = s1.syncer->reconnect_attempts_.find(s2_node_id.Binary());
+        return it != s1.syncer->reconnect_attempts_.end() && it->second >= 3;
+      },
+      10));
+
+  // Once the server is up, the next attempt connects and receives a message.
+  auto &s2 = MakeServer("19981", s2_node_id, /*on_rpc_completion=*/{});
+  ASSERT_TRUE(s1.WaitUntil(
+      [&s1, &s2_node_id]() {
+        return s1.syncer->sync_reactors_.size() == 1 &&
+               s1.syncer->reconnect_attempts_.count(s2_node_id.Binary()) == 0 &&
+               s1.received_versions.count(s2_node_id.Binary()) == 1;
+      },
+      10));
+  (void)s2;
+}
