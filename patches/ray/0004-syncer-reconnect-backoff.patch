+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+#include "absl/random/random.h"
+
+namespace ray::syncer {
+
+/// Compute how long to wait before the next reconnect attempt, using exponential
+/// backoff with full jitter: the delay is uniform in [0, ceiling), where the ceiling is
+/// `base_delay_ms` doubled once per earlier failed attempt and capped at `max_delay_ms`.
+///
+/// \param attempt The number of consecutive failed attempts so far (0 for the first).
+/// \param base_delay_ms The ceiling of the first delay.
+/// \param max_delay_ms The largest ceiling.
+/// \param unit_random A random number in [0, 1).
+/// \return The delay in milliseconds.
+inline uint64_t ComputeReconnectDelayMs(uint32_t attempt,
+                                        uint64_t base_delay_ms,
+                                        uint64_t max_delay_ms,
+                                        double unit_random) {
+  uint64_t ceiling = std::min(base_delay_ms, max_delay_ms);
+  for (uint32_t i = 0; i < attempt && ceiling < max_delay_ms; ++i) {
+    ceiling = ceiling > max_delay_ms / 2 ? max_delay_ms : ceiling * 2;
+  }
+  return static_cast<uint64_t>(unit_random * static_cast<double>(ceiling));
+}
+
+/// Return a random number in [0, 1).
+inline double RandomUnitInterval() {
+  thread_local absl::BitGen generator;
+  return absl::Uniform<double>(generator, 0.0, 1.0);
+}
+
+}  // namespace ray::syncer
