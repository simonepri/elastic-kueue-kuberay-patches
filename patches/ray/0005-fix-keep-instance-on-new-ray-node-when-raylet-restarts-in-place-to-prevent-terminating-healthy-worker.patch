From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simone Primarosa <simone.primarosa@gmail.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] fix: keep the instance on the new ray node when a raylet restarts in place

When a worker raylet restarts inside the same Kubernetes pod, the pod keeps its cloud
instance id but the raylet gets a new ray node id. The autoscaler v2 reconciler only
treats instances without a ray node id as already managed, so it creates a second
instance for the same pod. The autoscaler then counts two workers of the type, exceeds
max_workers and terminates the healthy restarted pod.

The reconciler now moves the existing RAY_RUNNING instance to the new ray node, through
a RAY_RUNNING to RAY_RUNNING transition that only updates the ray node id, and creates no
second instance. The dead old ray node no longer stops an instance that has moved away
from it.

Upstream status: not yet reported to ray-project/ray; related to ray-project/ray#65416.
---
 .../ray/autoscaler/v2/instance_manager/common.py   |    3 
 .../autoscaler/v2/instance_manager/reconciler.py   |   48 +++++++
 python/ray/autoscaler/v2/tests/test_reconciler.py  |  136 ++++++++++++++++++--
 3 files changed, 169 insertions(+), 18 deletions(-)

diff --git a/python/ray/autoscaler/v2/instance_manager/common.py b/python/ray/autoscaler/v2/instance_manager/common.py
index 82de2b6..77f90c9 100644
--- a/python/ray/autoscaler/v2/instance_manager/common.py
+++ b/python/ray/autoscaler/v2/instance_manager/common.py
@@ -272,6 +272,9 @@ class InstanceUtil:
             # Ray process is installed and running on the cloud instance. When in this
             # status, a ray node must be present in the ray cluster.
             Instance.RAY_RUNNING: {
+                # The ray node restarted in place on the same cloud instance and
+                # re-registered under a new ray node id.
+                Instance.RAY_RUNNING,
                 # Ray is requested to be stopped.
                 Instance.RAY_STOP_REQUESTED,
                 # Ray is stopping (currently draining),
diff --git a/python/ray/autoscaler/v2/instance_manager/reconciler.py b/python/ray/autoscaler/v2/instance_manager/reconciler.py
index 92ee0a3..1c9a65b 100644
--- a/python/ray/autoscaler/v2/instance_manager/reconciler.py
+++ b/python/ray/autoscaler/v2/instance_manager/reconciler.py
@@ -745,9 +745,17 @@ class Reconciler:
                     # provider.
                     im_instance = im_instances_by_cloud_instance_id[ray_node_id]
                 elif ray_node.instance_id:
-                    im_instance = im_instances_by_cloud_instance_id[
+                    im_instance = im_instances_by_cloud_instance_id.get(
                         ray_node.instance_id
-                    ]
+                    )
+                    if ray_node.status == NodeStatus.DEAD and (
+                        im_instance is None
+                        or (im_instance.node_id and im_instance.node_id != ray_node_id)
+                    ):
+                        # A dead ray node that a restarted raylet replaced. The
+                        # instance follows its current ray node, so the stale one
+                        # must not stop it.
+                        continue
                 else:
                     # This should only happen to a ray node that's not managed by us.
                     logger.warning(
@@ -1754,6 +1762,17 @@ class Reconciler:
         ray_node_ids_managed_by_im = {
             instance.node_id for instance in instances if instance.node_id
         }
+        # Instances bound to a ray node, which may restart in place under a new
+        # ray node id on the same cloud instance.
+        im_instances_with_ray_node_by_cloud_instance_id = {
+            instance.cloud_instance_id: instance
+            for instance in instances
+            if instance.cloud_instance_id
+            and instance.node_id
+            and instance.status
+            not in [IMInstance.TERMINATED, IMInstance.ALLOCATION_FAILED]
+        }
+        moved_instance_ids = set()
 
         for ray_node in ray_nodes:
             if not ray_node.instance_id:
@@ -1767,6 +1786,31 @@ class Reconciler:
             if cloud_instance_id in cloud_instance_ids_managed_by_im:
                 continue
 
+            im_instance = im_instances_with_ray_node_by_cloud_instance_id.get(
+                cloud_instance_id
+            )
+            if im_instance is not None:
+                # The raylet restarted in place: attribute the new ray node to the
+                # existing instance instead of creating a second instance for the
+                # same cloud instance, which counts against max_workers.
+                if (
+                    im_instance.status == IMInstance.RAY_RUNNING
+                    and ray_node.status != NodeStatus.DEAD
+                    and im_instance.instance_id not in moved_instance_ids
+                ):
+                    moved_instance_ids.add(im_instance.instance_id)
+                    updates[ray_node_id] = IMInstanceUpdateEvent(
+                        instance_id=im_instance.instance_id,
+                        new_instance_status=IMInstance.RAY_RUNNING,
+                        details=(
+                            "ray node restarted on the same cloud instance: "
+                            f"{im_instance.node_id} -> {ray_node_id}"
+                        ),
+                        ray_node_id=ray_node_id,
+                        instance_type=im_instance.instance_type,
+                    )
+                continue
+
             is_head = is_head_node(ray_node)
             updates[ray_node_id] = IMInstanceUpdateEvent(
                 instance_id=InstanceUtil.random_instance_id(),  # Assign a new id.
diff --git a/python/ray/autoscaler/v2/tests/test_reconciler.py b/python/ray/autoscaler/v2/tests/test_reconciler.py
