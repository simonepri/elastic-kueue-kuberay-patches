+                ),
+            ],
+        )
+        ray_nodes = [
+            NodeState(
+                node_id=b"r-1",
+                status=NodeStatus.RUNNING,
+                instance_id="c-1",
+                ray_node_type_name="type-1",
+            ),
+            NodeState(
+                node_id=b"r-2",
+                status=NodeStatus.RUNNING,
+                instance_id="c-2",
+                ray_node_type_name="type-1",
+            ),
+        ]
+
+        TestReconciler._reconcile_ray_nodes(setup, ray_nodes, ["c-1", "c-2"])
 
         instances, _ = instance_storage.get_instances()
         assert len(instances) == 2
-        statuses = {instance.status for instance in instances.values()}
-        assert statuses == {Instance.RAY_RUNNING, Instance.TERMINATED}
+        assert instances["i-1"].status == Instance.RAY_RUNNING
+        assert instances["i-1"].node_id == binary_to_hex(b"r-1")
+        (new_instance,) = [i for i in instances.values() if i.instance_id != "i-1"]
+        assert new_instance.cloud_instance_id == "c-2"
+        assert new_instance.node_id == binary_to_hex(b"r-2")
+        assert new_instance.status == Instance.RAY_RUNNING
 
