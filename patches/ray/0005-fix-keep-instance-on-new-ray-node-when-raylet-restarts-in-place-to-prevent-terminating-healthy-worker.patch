-        assert events[3].new_instance_status == Instance.TERMINATED
-        assert events[3].instance_id == "i-1"
+    @staticmethod
+    def _reconcile_ray_nodes(setup, ray_nodes, cloud_instance_ids):
+        instance_manager, _, _, cloud_resource_monitor = setup
+        Reconciler.reconcile(
+            instance_manager,
+            scheduler=MockScheduler(),
+            cloud_provider=MagicMock(),
+            cloud_resource_monitor=cloud_resource_monitor,
+            ray_cluster_resource_state=ClusterResourceState(node_states=ray_nodes),
+            non_terminated_cloud_instances={
+                cloud_instance_id: CloudInstance(
+                    cloud_instance_id, "type-1", True, NodeKind.WORKER
+                )
+                for cloud_instance_id in cloud_instance_ids
+            },
+            cloud_provider_errors=[],
+            ray_install_errors=[],
+            autoscaling_config=MockAutoscalingConfig(),
+        )
+
+    @staticmethod
+    def test_restarted_raylet_keeps_its_instance(setup):
+        """
+        Test that a raylet restarting in place moves its running instance to the new
+        ray node, keeps a single instance, and is not stopped by the dead old node.
+        """
+        _, instance_storage, subscriber, _ = setup
+        TestReconciler._add_instances(
+            instance_storage,
+            [
+                create_instance(
+                    "i-1",
+                    status=Instance.RAY_RUNNING,
+                    cloud_instance_id="c-1",
+                    ray_node_id=binary_to_hex(b"r-1"),
+                ),
+            ],
+        )
+        ray_nodes = [
+            NodeState(
+                node_id=b"r-1",
+                status=NodeStatus.DEAD,
+                instance_id="c-1",
+                ray_node_type_name="type-1",
+            ),
+            NodeState(
+                node_id=b"r-2",
+                status=NodeStatus.RUNNING,
+                instance_id="c-1",
+                ray_node_type_name="type-1",
+            ),
+        ]
+
+        # The old dead node stays listed, so reconcile repeatedly.
+        for _ in range(3):
+            subscriber.clear()
+            TestReconciler._reconcile_ray_nodes(setup, ray_nodes, ["c-1"])
+
+            instances, _ = instance_storage.get_instances()
+            assert list(instances) == ["i-1"]
+            assert instances["i-1"].status == Instance.RAY_RUNNING
+            assert instances["i-1"].node_id == binary_to_hex(b"r-2")
+            assert instances["i-1"].cloud_instance_id == "c-1"
+            for event in subscriber.events:
+                assert event.new_instance_status == Instance.RAY_RUNNING
+
+        # Once the pod goes away, the leftover dead node must not break reconcile.
+        TestReconciler._reconcile_ray_nodes(setup, ray_nodes[:1], [])
+        instances, _ = instance_storage.get_instances()
+        assert instances["i-1"].status == Instance.TERMINATED
+
+    @staticmethod
+    def test_restarted_raylet_does_not_claim_other_cloud_instance(setup):
+        """
+        Test that a ray node on a different cloud instance still gets its own
+        unmanaged instance and leaves the existing instance untouched.
+        """
