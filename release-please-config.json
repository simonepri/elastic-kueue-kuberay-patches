{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "patches/kueue": {
      "component": "kueue",
      "release-type": "simple",
      "skip-changelog": true,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "/mise.toml",
          "jsonpath": "$.env.KUEUE_PATCH_VERSION"
        }
      ]
    },
    "patches/kuberay": {
      "component": "kuberay",
      "release-type": "simple",
      "skip-changelog": true,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "/mise.toml",
          "jsonpath": "$.env.KUBERAY_PATCH_VERSION"
        }
      ]
    },
    "patches/interlink": {
      "component": "interlink",
      "release-type": "simple",
      "skip-changelog": true,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "/mise.toml",
          "jsonpath": "$.env.INTERLINK_PATCH_VERSION"
        }
      ]
    },
    "patches/ray": {
      "component": "ray",
      "release-type": "simple",
      "draft": true,
      "force-tag-creation": true,
      "skip-changelog": true,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "/mise.toml",
          "jsonpath": "$.env.RAY_PATCH_VERSION"
        }
      ]
    }
  }
}
