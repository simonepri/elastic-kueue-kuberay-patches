{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    ":enablePreCommit"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates when CI checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge upstream Kueue, KubeRay, and Karpenter updates when CI passes",
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^Makefile$",
        "^\\.mise\\.toml$",
        "^README\\.md$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\n.*?=\\s*\"?(?<currentValue>v?[0-9.]+)\"?"
      ]
    }
  ]
}
