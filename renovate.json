{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    ":enablePreCommit"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates when CI checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge upstream Kueue, KubeRay, and Karpenter minor/patch updates when CI passes",
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Extract version from ray- tag prefix for Ray upstream releases",
      "matchPackageNames": [
        "ray-project/ray"
      ],
      "extractVersion": "^ray-(?<version>.+)$"
    },
    {
      "description": "Use unscoped feat commit type for upstream updates",
      "matchPackageNames": [
        "kubernetes-sigs/kueue",
        "ray-project/kuberay",
        "kubernetes-sigs/karpenter",
        "interlink-hq/interLink",
        "ray-project/ray"
      ],
      "semanticCommitType": "feat",
      "semanticCommitScope": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^mise\\.toml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\n.*?=\\s*\"?(?<currentValue>v?[0-9.]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^readme\\.md$"
      ],
      "matchStrings": [
        "<!--\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\s*-->\\n\\[!\\[.*?\\]\\(https://img\\.shields\\.io/badge/.*-(?<currentValue>v?[0-9.]+)-[^)]*\\)\\]\\(https://github\\.com/.*?/releases/tag/.*?\\)"
      ]
    }
  ]
}
